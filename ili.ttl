	dc:source	pwn30:06165823-n .

<i68958>	a	<Concept> ;
	skos:definition	"the modal logic of necessity and possibility and contingency"@en ;
	dc:source	pwn30:06166046-n .

<i68959>	a	<Concept> ;
	skos:definition	"the modal logic of obligation and permissibility"@en ;
	dc:source	pwn30:06166166-n .

<i68960>	a	<Concept> ;
