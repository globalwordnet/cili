	dc:source	pwn30:05468523-n .

<i65692>	a	<Concept> ;
	skos:definition	"a cell of the oligodendroglia"@en ;
	dc:source	pwn30:05468739-n .

<i65693>	a	<Concept> ;
	skos:definition	"long nerve fiber that conducts away from the cell body of the neuron"@en ;
	dc:source	pwn30:05468849-n .

<i65694>	a	<Concept> ;
	skos:definition	"the terminal structure of an axon that does not end at a synapse"@en ;
	dc:source	pwn30:05469032-n .

<i65695>	a	<Concept> ;
	skos:definition	"microscopic sensory nerve endings in the skin that are not connected to any specific sensory receptor"@en ;
	dc:source	pwn30:05469240-n .

<i65696>	a	<Concept> ;
	skos:definition	"a specialized bulblike nerve ending located in the subcutaneous tissue of the skin; occurs abundantly in the skin of palms and soles and joints and genitals"@en ;
	dc:source	pwn30:05469424-n .

<i65697>	a	<Concept> ;
	skos:definition	"special nerve endings in the muscles and tendons and other organs that respond to stimuli regarding the position and movement of the body"@en ;
	dc:source	pwn30:05469664-n .

<i65698>	a	<Concept> ;
	skos:definition	"short fiber that conducts toward the cell body of the neuron"@en ;
	dc:source	pwn30:05469861-n .

<i65699>	a	<Concept> ;
	skos:definition	"a hybrid cell resulting from the fusion of a lymphocyte and a tumor cell; used to culture a specific monoclonal antibody"@en ;
	dc:source	pwn30:05470013-n .

<i65700>	a	<Concept> ;
	skos:definition	"a natural prolongation or projection from a part of an organism either animal or plant"@en ;
	dc:source	pwn30:05470189-n .

<i65701>	a	<Concept> ;
	skos:definition	"an outgrowth on a plant or animal such as a fowl's wattle or a protuberance near the hilum of certain seeds"@en ;
	dc:source	pwn30:05471181-n .

<i65702>	a	<Concept> ;
	skos:definition	"a fleshy wrinkled and often brightly colored fold of skin hanging from the neck or throat of certain birds (chickens and turkeys) or lizards"@en ;
	dc:source	pwn30:05471427-n .

<i65703>	a	<Concept> ;
	skos:definition	"a round bump on a bone where it forms a joint with another bone"@en ;
	dc:source	pwn30:05471629-n .

<i65704>	a	<Concept> ;
