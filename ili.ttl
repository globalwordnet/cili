<i113878>	a	<Concept> ;
	skos:definition	"the series of inert gases"@en ;
	dc:source	pwn30:14624659-n .

<i113879>	a	<Concept> ;
	skos:definition	"any element of the lanthanide series (atomic numbers 57 through 71)"@en ;
	dc:source	pwn30:14624743-n .

<i113880>	a	<Concept> ;
