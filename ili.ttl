	dc:source	pwn30:05368444-n .

<i65174>	a	<Concept> ;
	skos:definition	"the conical mass of erectile tissue that forms the head of the penis"@en ;
	dc:source	pwn30:05368594-n .

<i65175>	a	<Concept> ;
	skos:definition	"veins draining the gluteal muscles on either side of the body"@en ;
	dc:source	pwn30:05368739-n .

