	dc:source	pwn30:06551627-n .

<i70895>	a	<Concept> ;
	skos:definition	"the legal document stating the reasons for a judicial decision"@en ;
	dc:source	pwn30:06551784-n .

<i70896>	a	<Concept> ;
	skos:definition	"an opinion that agrees with the court's disposition of the case but is written to express a particular judge's reasoning"@en ;
	dc:source	pwn30:06552116-n .

