	dc:source	pwn30:12061104-n .

<i100552>	a	<Concept> ;
	skos:definition	"orchid of Florida and the Bahamas having showy brightly colored flowers; sometimes placed in genus Epidendrum"@en ;
	dc:source	pwn30:12061380-n .

<i100553>	a	<Concept> ;
	skos:definition	"Mexican epiphytic orchid having pale green or yellow-green flowers with white purple-veined lip"@en ;
	dc:source	pwn30:12061614-n .

<i100554>	a	<Concept> ;
	skos:definition	"large and variable genus of terrestrial or epiphytic or lithophytic orchids of tropical and subtropical Americas; some native to United States"@en ;
	dc:source	pwn30:12061849-n .

<i100555>	a	<Concept> ;
	skos:definition	"any of various orchids of the genus Epidendrum"@en ;
	dc:source	pwn30:12062105-n .

<i100556>	a	<Concept> ;
	skos:definition	"genus of hardy orchids with leafy-bracted racemes of greenish or purplish irregular flowers"@en ;
	dc:source	pwn30:12062227-n .

<i100557>	a	<Concept> ;
	skos:definition	"any of various orchids of the genus Epipactis"@en ;
	dc:source	pwn30:12062468-n .

<i100558>	a	<Concept> ;
	skos:definition	"European orchid with spikes of green and pinkish or purplish flowers"@en ;
	dc:source	pwn30:12062626-n .

<i100559>	a	<Concept> ;
	skos:definition	"orchid growing along streams or ponds of western North America having leafy stems and 1 greenish-brown and pinkish flower in the axil of each upper leaf"@en ;
	dc:source	pwn30:12062781-n .

<i100560>	a	<Concept> ;
	skos:definition	"small genus of Australian orchids"@en ;
	dc:source	pwn30:12063066-n .

<i100561>	a	<Concept> ;
	skos:definition	"orchid having blue to purple flowers with tongue-shaped or strap-shaped protuberances (calli) at the lip base"@en ;
	dc:source	pwn30:12063211-n .

<i100562>	a	<Concept> ;
	skos:definition	"genus of small orchids of the northern hemisphere with creeping rhizomes and stalked ovate leaves and small flowers"@en ;
	dc:source	pwn30:12063414-n .

<i100563>	a	<Concept> ;
	skos:definition	"any of several small temperate and tropical orchids having mottled or striped leaves and spikes of small yellowish-white flowers in a twisted raceme"@en ;
	dc:source	pwn30:12063639-n .

<i100564>	a	<Concept> ;
	skos:definition	"small genus of large epiphytic or terrestrial orchids of southeastern Asia to Polynesia; the giants of the Orchidaceae having long narrow leaves and drooping flower clusters often 6 feet long"@en ;
	dc:source	pwn30:12063887-n .

<i100565>	a	<Concept> ;
	skos:definition	"small genus of terrestrial orchids of North America and temperate Eurasia"@en ;
	dc:source	pwn30:12064183-n .

<i100566>	a	<Concept> ;
	skos:definition	"European orchid having dense spikes of fragrant pink or lilac or red flowers with conspicuous spurs"@en ;
	dc:source	pwn30:12064389-n .

<i100567>	a	<Concept> ;
	skos:definition	"similar to Gymnadenia conopsea but with smaller flowers on shorter stems and having much shorter spurs"@en ;
	dc:source	pwn30:12064591-n .

<i100568>	a	<Concept> ;
	skos:definition	"genus of North American terrestrial orchids usually included in genus Habenaria"@en ;
	dc:source	pwn30:12064814-n .

<i100569>	a	<Concept> ;
	skos:definition	"chiefly terrestrial orchids with tubers or fleshy roots often having long slender spurs and petals and lip lobes; includes species formerly placed in genus Gymnadeniopsis"@en ;
	dc:source	pwn30:12064996-n .

<i100570>	a	<Concept> ;
	skos:definition	"any of several summer-flowering American orchids distinguished by a fringed or lacerated lip"@en ;
	dc:source	pwn30:12065316-n .

<i100571>	a	<Concept> ;
	skos:definition	"any of several green orchids of the genus Habenaria"@en ;
	dc:source	pwn30:12065649-n .

<i100572>	a	<Concept> ;
	skos:definition	"any of several American wildflowers with a kidney-shaped lip"@en ;
	dc:source	pwn30:12065777-n .

<i100573>	a	<Concept> ;
	skos:definition	"orchid with spikes of many fragrant white flowers on erect leafy stems; of wet or boggy ground through most of the West and northern North America"@en ;
	dc:source	pwn30:12066018-n .

<i100574>	a	<Concept> ;
	skos:definition	"bog orchid of eastern North America with a spike of pure white fringed flowers"@en ;
	dc:source	pwn30:12066261-n .

<i100575>	a	<Concept> ;
	skos:definition	"slender inland rein orchid similar to coastal rein orchid but with pale greenish-yellow flowers"@en ;
	dc:source	pwn30:12066451-n .

<i100576>	a	<Concept> ;
	skos:definition	"North American orchid similar to Habenaria psycodes with larger paler flowers"@en ;
	dc:source	pwn30:12066630-n .

<i100577>	a	<Concept> ;
	skos:definition	"stout orchid of central California to northern Washington having racemes of white fragrant bilaterally symmetrical flowers"@en ;
	dc:source	pwn30:12066821-n .

<i100578>	a	<Concept> ;
	skos:definition	"a long-spurred orchid with base leaves and petals converging under the upper sepal"@en ;
	dc:source	pwn30:12067029-n .

<i100579>	a	<Concept> ;
	skos:definition	"fringed orchid of the eastern United States having a greenish flower with the lip deeply lacerated"@en ;
	dc:source	pwn30:12067193-n .

<i100580>	a	<Concept> ;
	skos:definition	"orchid of boggy or wet lands of north central United States having racemes of very fragrant creamy or greenish white flowers"@en ;
	dc:source	pwn30:12067433-n .

<i100581>	a	<Concept> ;
	skos:definition	"slender fringed orchid of eastern North America having white flowers"@en ;
	dc:source	pwn30:12067672-n .

<i100582>	a	<Concept> ;
	skos:definition	"orchid having a raceme of large greenish-white flowers on a single flower stalk growing between two elliptic or round basal leaves lying on the ground; from northern Oregon and Montana across Canada to the eastern United States"@en ;
	dc:source	pwn30:12067817-n .

<i100583>	a	<Concept> ;
	skos:definition	"orchid of northeastern and alpine eastern North America closely related to the purple fringed orchids but having rosy-purple or violet flowers with denticulate leaf divisions"@en ;
	dc:source	pwn30:12068138-n .

<i100584>	a	<Concept> ;
	skos:definition	"North American orchid with clusters of fragrant purple fringed flowers"@en ;
	dc:source	pwn30:12068432-n .

<i100585>	a	<Concept> ;
	skos:definition	"similar to coastal rein orchid but with smaller flowers; Alaska to Baja California and east to the Dakotas and Colorado"@en ;
	dc:source	pwn30:12068615-n .

<i100586>	a	<Concept> ;
	skos:definition	"a monocotyledonous genus of the family Orchidaceae"@en ;
	dc:source	pwn30:12068824-n .

<i100587>	a	<Concept> ;
	skos:definition	"orchid with yellowish-brown flowers with dark veins; southeastern Arizona to the eastern United States"@en ;
	dc:source	pwn30:12069009-n .

<i100588>	a	<Concept> ;
	skos:definition	"orchid with slender nearly leafless reddish-brown stems with loose racemes of reddish-brown flowers; of open brushy woods of southeastern Arizona and central Texas"@en ;
	dc:source	pwn30:12069217-n .

<i100589>	a	<Concept> ;
	skos:definition	"small genus of terrestrial orchids of Europe and Mediterranean region"@en ;
	dc:source	pwn30:12069488-n .

<i100590>	a	<Concept> ;
	skos:definition	"an orchid of the genus Himantoglossum"@en ;
	dc:source	pwn30:12069679-n .

<i100591>	a	<Concept> ;
	skos:definition	"large genus of mostly epiphytic or lithophytic Central and South American orchids of various sizes"@en ;
	dc:source	pwn30:12069821-n .

<i100592>	a	<Concept> ;
	skos:definition	"any of various spectacular plants of the genus Laelia having showy flowers in many colors"@en ;
	dc:source	pwn30:12070016-n .

<i100593>	a	<Concept> ;
	skos:definition	"genus of terrestrial and epiphytic orchids; pantropical to temperate"@en ;
	dc:source	pwn30:12070177-n .

<i100594>	a	<Concept> ;
	skos:definition	"an orchid of the genus Liparis having few leaves and usually fairly small yellow-green or dull purple flowers in terminal racemes"@en ;
	dc:source	pwn30:12070381-n .

<i100595>	a	<Concept> ;
	skos:definition	"an orchid of the genus Liparis having a pair of leaves"@en ;
	dc:source	pwn30:12070583-n .

<i100596>	a	<Concept> ;
	skos:definition	"small terrestrial orchid of eastern North America and Europe having two nearly basal leaves and dull yellow-green racemose flowers"@en ;
	dc:source	pwn30:12070712-n .

<i100597>	a	<Concept> ;
	skos:definition	"genus of terrestrial orchids having usually a single pair of broad shining leaves near the middle of the stem; found in temperate Asia and North America and Europe"@en ;
	dc:source	pwn30:12070950-n .

<i100598>	a	<Concept> ;
	skos:definition	"small orchid with two elliptic leaves and a slender raceme of small green flowers; western North America"@en ;
	dc:source	pwn30:12071259-n .

<i100599>	a	<Concept> ;
	skos:definition	"orchid having two triangular leaves and a short lax raceme of green to rust-colored flowers with the lip flushed mauve; Europe and Asia and North America and Greenland"@en ;
	dc:source	pwn30:12071477-n .

<i100600>	a	<Concept> ;
