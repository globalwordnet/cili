	skos:definition	"terminal branches of the abdominal aorta"@en ;
	dc:source	pwn30:05347359-n .

<i65055>	a	<Concept> ;
	skos:definition	"the outer branch of the common iliac artery on either side of the body; becomes the femoral artery"@en ;
	dc:source	pwn30:05347465-n .

<i65056>	a	<Concept> ;
