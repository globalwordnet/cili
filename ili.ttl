	dc:source	pwn30:05472846-n .

<i65711>	a	<Concept> ;
	skos:definition	"thin projections forming a fringe (especially around the ovarian end of the Fallopian tube)"@en ;
	dc:source	pwn30:05472959-n .

<i65712>	a	<Concept> ;
	skos:definition	"(anatomy) a natural outgrowth or projection on an organ or body part such as the process of a vertebra"@en ;
	dc:source	pwn30:05473104-n .

<i65713>	a	<Concept> ;
	skos:definition	"small pointed structure serving as a skeletal element in various marine and freshwater invertebrates e.g. sponges and corals"@en ;
	dc:source	pwn30:05473318-n .

<i65714>	a	<Concept> ;
	skos:definition	"small abnormal bony outgrowth"@en ;
	dc:source	pwn30:05473507-n .

<i65715>	a	<Concept> ;
	skos:definition	"a small projection of tissue at the base of a hair or tooth or feather"@en ;
	dc:source	pwn30:05473593-n .

<i65716>	a	<Concept> ;
	skos:definition	"a small nipple-shaped protuberance concerned with taste, touch, or smell"@en ;
	dc:source	pwn30:05473735-n .

<i65717>	a	<Concept> ;
	skos:definition	"the junction between two neurons (axon-to-dendrite) or between a neuron and a muscle"@en ;
	dc:source	pwn30:05473928-n .

<i65718>	a	<Concept> ;
	skos:definition	"the junction between a nerve fiber and the muscle it supplies"@en ;
	dc:source	pwn30:05474195-n .

<i65719>	a	<Concept> ;
	skos:definition	"any bundle of nerve fibers running to various organs and tissues of the body"@en ;
	dc:source	pwn30:05474346-n .

<i65720>	a	<Concept> ;
	skos:definition	"a nerve that conveys impulses toward or to muscles or glands"@en ;
	dc:source	pwn30:05474738-n .

<i65721>	a	<Concept> ;
	skos:definition	"a nerve fiber that carries impulses toward the muscles or glands"@en ;
	dc:source	pwn30:05474976-n .

<i65722>	a	<Concept> ;
	skos:definition	"a nerve that passes impulses from receptors toward or to the central nervous system"@en ;
	dc:source	pwn30:05475134-n .

<i65723>	a	<Concept> ;
	skos:definition	"a nerve fiber that carries impulses toward the central nervous system"@en ;
	dc:source	pwn30:05475397-n .

<i65724>	a	<Concept> ;
	skos:definition	"a bundle of sensory nerve fibers going to the thalamus"@en ;
	dc:source	pwn30:05475562-n .

<i65725>	a	<Concept> ;
	skos:definition	"a bundle of fibers (especially nerve fibers)"@en ;
	dc:source	pwn30:05475681-n .

<i65726>	a	<Concept> ;
	skos:definition	"a bundle of myelinated nerve fibers following a path through the brain"@en ;
	dc:source	pwn30:05475878-n .

<i65727>	a	<Concept> ;
	skos:definition	"a bundle of nerve fibers passing from one side to the other of the brain or spinal cord"@en ;
	dc:source	pwn30:05476094-n .

<i65728>	a	<Concept> ;
	skos:definition	"any of the 12 paired nerves that originate in the brain stem"@en ;
	dc:source	pwn30:05476256-n .

<i65729>	a	<Concept> ;
