	dc:source	pwn30:00965895-n .

<i40462>	a	<Concept> ;
	skos:definition	"the practice of plundering in gangs"@en ;
	dc:source	pwn30:00966294-n .

<i40463>	a	<Concept> ;
	skos:definition	"the act of despoiling a country in warfare"@en ;
	dc:source	pwn30:00966384-n .

<i40464>	a	<Concept> ;
	skos:definition	"the stealing of cattle"@en ;
	dc:source	pwn30:00966504-n .

<i40465>	a	<Concept> ;
	skos:definition	"plundering during riots or in wartime"@en ;
	dc:source	pwn30:00966599-n .

<i40466>	a	<Concept> ;
	skos:definition	"an act that despoils the innocence or beauty of something"@en ;
	dc:source	pwn30:00966718-n .

<i40467>	a	<Concept> ;
	skos:definition	"the act of stripping and taking by force"@en ;
	dc:source	pwn30:00966869-n .

<i40468>	a	<Concept> ;
	skos:definition	"plundering with excessive damage and destruction"@en ;
	dc:source	pwn30:00967157-n .

<i40469>	a	<Concept> ;
	skos:definition	"an act of plundering and pillaging and marauding"@en ;
	dc:source	pwn30:00967310-n .

<i40470>	a	<Concept> ;
	skos:definition	"the plundering of a place by an army or mob; usually involves destruction and slaughter"@en ;
	dc:source	pwn30:00967446-n .

<i40471>	a	<Concept> ;
	skos:definition	"warfare using chemical agents to kill or injure or incapacitate the enemy"@en ;
	dc:source	pwn30:00967622-n .

<i40472>	a	<Concept> ;
	skos:definition	"the use of bacteria or viruses or toxins to destroy men and animals or food"@en ;
	dc:source	pwn30:00967780-n .

<i40473>	a	<Concept> ;
	skos:definition	"defense against biological warfare"@en ;
	dc:source	pwn30:00967993-n .

<i40474>	a	<Concept> ;
	skos:definition	"several related operations aimed at achieving a particular goal (usually within geographical and temporal constraints)"@en ;
	dc:source	pwn30:00968155-n .

<i40475>	a	<Concept> ;
	skos:definition	"a military campaign designed to achieve a specific objective in a foreign country"@en ;
	dc:source	pwn30:00968479-n .

<i40476>	a	<Concept> ;
	skos:definition	"any of the more or less continuous military expeditions in the 11th to 13th centuries when Christian powers of Europe tried to recapture the Holy Land from the Muslims"@en ;
	dc:source	pwn30:00968715-n .

<i40477>	a	<Instance> ;
	skos:definition	"a Crusade from 1096 to 1099; captured Jerusalem and created a theocracy there"@en ;
	dc:source	pwn30:00969087-n .

<i40478>	a	<Instance> ;
	skos:definition	"a Crusade from 1145 to 1147 that failed because of internal disagreements among the crusaders and led to the loss of Jerusalem in 1187"@en ;
	dc:source	pwn30:00969225-n .

<i40479>	a	<Instance> ;
	skos:definition	"a Crusade from 1189 to 1192 led by Richard I and the king of France that failed because an army torn by dissensions and fighting on foreign soil could not succeed against forces united by religious zeal"@en ;
	dc:source	pwn30:00969421-n .

<i40480>	a	<Instance> ;
	skos:definition	"a Crusade from 1202 to 1204 that was diverted into a battle for Constantinople and failed to recapture Jerusalem"@en ;
	dc:source	pwn30:00969684-n .

<i40481>	a	<Instance> ;
	skos:definition	"a Crusade under papal control from 1218 to 1221 that achieved military victories but failed when dissension arose over accepting the terms they had been offered"@en ;
	dc:source	pwn30:00969858-n .

<i40482>	a	<Instance> ;
	skos:definition	"a Crusade from 1228 to 1229 led by the Holy Roman Emperor Frederick II who fell ill and was excommunicated by the Pope; by negotiation Frederick II was able to crown himself king of Jerusalem"@en ;
	dc:source	pwn30:00970079-n .

<i40483>	a	<Instance> ;
	skos:definition	"a Crusade initiated in 1248 after the loss of Jerusalem in 1244 and defeated in 1249"@en ;
	dc:source	pwn30:00970331-n .

<i40484>	a	<Concept> ;
	skos:definition	"an operation conducted primarily by naval forces in order to gain or extend or maintain control of the sea"@en ;
	dc:source	pwn30:00970478-n .

<i40485>	a	<Concept> ;
	skos:definition	"an operation that is assigned by a higher headquarters"@en ;
	dc:source	pwn30:00970645-n .

<i40486>	a	<Concept> ;
	skos:definition	"a mission to capture or defend something"@en ;
	dc:source	pwn30:00970903-n .

<i40487>	a	<Concept> ;
	skos:definition	"a mission to discover something"@en ;
	dc:source	pwn30:00971004-n .

<i40488>	a	<Concept> ;
	skos:definition	"an operation developed for United States troops in Vietnam; troops would move through a designated area destroying troops as they found them"@en ;
	dc:source	pwn30:00971096-n .

<i40489>	a	<Concept> ;
	skos:definition	"a military action in which besieged troops burst forth from their position"@en ;
	dc:source	pwn30:00971309-n .

<i40490>	a	<Concept> ;
	skos:definition	"a military operation (often involving new supplies of men and materiel) to strengthen a military force or aid in the performance of its mission"@en ;
	dc:source	pwn30:00971463-n .

<i40491>	a	<Concept> ;
	skos:definition	"a violent fight between dogs (sometimes organized illegally for entertainment and gambling)"@en ;
	dc:source	pwn30:00971802-n .

<i40492>	a	<Concept> ;
	skos:definition	"close-in firing by one unit against an enemy engaged by another unit"@en ;
	dc:source	pwn30:00971984-n .

<i40493>	a	<Concept> ;
	skos:definition	"a mission requiring one force to support another specific force and authorizing it to answer directly the supported force's request for assistance"@en ;
	dc:source	pwn30:00972112-n .

<i40494>	a	<Concept> ;
	skos:definition	"an amphibious operation conducted for the purpose of deceiving the enemy and leading him into a course of action unfavorable to him"@en ;
	dc:source	pwn30:00972319-n .

<i40495>	a	<Concept> ;
	skos:definition	"an amphibious diversionary attack"@en ;
	dc:source	pwn30:00972521-n .

<i40496>	a	<Concept> ;
	skos:definition	"(military) an offensive against an enemy (using weapons)"@en ;
	dc:source	pwn30:00972621-n .

<i40497>	a	<Concept> ;
	skos:definition	"the waging of armed conflict against an enemy"@en ;
	dc:source	pwn30:00973077-n .

<i40498>	a	<Concept> ;
	skos:definition	"an attack by armed planes on a surface target"@en ;
	dc:source	pwn30:00974111-n .

<i40499>	a	<Concept> ;
	skos:definition	"an aerial engagement between fighter planes"@en ;
	dc:source	pwn30:00974224-n .

<i40500>	a	<Concept> ;
	skos:definition	"an attack by ground troops"@en ;
	dc:source	pwn30:00974358-n .

<i40501>	a	<Concept> ;
	skos:definition	"close fighting during the culmination of a military attack"@en ;
	dc:source	pwn30:00974444-n .

<i40502>	a	<Concept> ;
	skos:definition	"a direct and violent assault on a stronghold"@en ;
	dc:source	pwn30:00974630-n .

<i40503>	a	<Concept> ;
	skos:definition	"an impetuous rush toward someone or something"@en ;
	dc:source	pwn30:00974762-n .

<i40504>	a	<Concept> ;
	skos:definition	"a retaliatory charge"@en ;
	dc:source	pwn30:00974994-n .

<i40505>	a	<Concept> ;
	skos:definition	"a mass attack of troops without concern for casualties; originated by Japanese who accompanied it with yells of `banzai'"@en ;
	dc:source	pwn30:00975074-n .

<i40506>	a	<Concept> ;
	skos:definition	"an attack calculated to draw enemy defense away from the point of the principal attack"@en ;
	dc:source	pwn30:00975270-n .

<i40507>	a	<Concept> ;
	skos:definition	"an attack that penetrates into enemy territory"@en ;
	dc:source	pwn30:00975452-n .

<i40508>	a	<Concept> ;
	skos:definition	"the action of penetrating between or among"@en ;
	dc:source	pwn30:00975658-n .

<i40509>	a	<Concept> ;
	skos:definition	"a swift and violent military offensive with intensive aerial bombardment"@en ;
	dc:source	pwn30:00975781-n .

<i40510>	a	<Concept> ;
	skos:definition	"a penetration of a barrier such as an enemy's defense"@en ;
	dc:source	pwn30:00975955-n .

<i40511>	a	<Concept> ;
	skos:definition	"(American football) defensive players try to break through the offensive line"@en ;
	dc:source	pwn30:00976085-n .

<i40512>	a	<Concept> ;
	skos:definition	"(American football) a play in which a defensive player is allowed to cross the line of scrimmage and then blocked off as the runner goes through the place the lineman vacated"@en ;
	dc:source	pwn30:00976270-n .

<i40513>	a	<Concept> ;
	skos:definition	"the act of invading; the act of an army that invades for conquest or plunder"@en ;
	dc:source	pwn30:00976531-n .

<i40514>	a	<Concept> ;
	skos:definition	"a process in which individuals (or small groups) penetrate an area (especially the military penetration of enemy positions without detection)"@en ;
	dc:source	pwn30:00976698-n .

<i40515>	a	<Concept> ;
	skos:definition	"a sudden short attack"@en ;
	dc:source	pwn30:00976953-n .

<i40516>	a	<Concept> ;
	skos:definition	"an invasion or hostile attack"@en ;
	dc:source	pwn30:00977132-n .

<i40517>	a	<Concept> ;
	skos:definition	"a very rapid raid"@en ;
	dc:source	pwn30:00977214-n .

<i40518>	a	<Concept> ;
	skos:definition	"an attack that is intended to seize or inflict damage on or destroy an objective"@en ;
	dc:source	pwn30:00977301-n .

<i40519>	a	<Concept> ;
	skos:definition	"the initial use of nuclear weapons to attack a country that also has nuclear weapons; considered feasible only when the attacker can destroy the other country's ability to retaliate"@en ;
	dc:source	pwn30:00977551-n .

<i40520>	a	<Concept> ;
	skos:definition	"an attack (usually without prior warning) intended to deal only with a specific target"@en ;
	dc:source	pwn30:00977857-n .

<i40521>	a	<Concept> ;
	skos:definition	"a strike that is carried out in order to deter expected aggression by hostile forces"@en ;
	dc:source	pwn30:00978005-n .

<i40522>	a	<Concept> ;
	skos:definition	"an attack by a defending force against an attacking enemy force in order to regain lost ground or cut off enemy advance units etc."@en ;
	dc:source	pwn30:00978173-n .

<i40523>	a	<Concept> ;
	skos:definition	"an attack by dropping bombs"@en ;
	dc:source	pwn30:00978413-n .

<i40524>	a	<Concept> ;
	skos:definition	"the act (or an instance) of subjecting a body or substance to the impact of high-energy particles (as electrons or alpha rays)"@en ;
	dc:source	pwn30:00978580-n .

<i40525>	a	<Concept> ;
	skos:definition	"that part of the flight that begins with the approach to the target; includes target acquisition and ends with the release of the bombs"@en ;
	dc:source	pwn30:00978764-n .

<i40526>	a	<Concept> ;
	skos:definition	"an extensive and systematic bombing intended to devastate a large target"@en ;
	dc:source	pwn30:00978993-n .

<i40527>	a	<Concept> ;
	skos:definition	"a bombing run in which the bomber releases the bomb while flying straight toward the target"@en ;
	dc:source	pwn30:00979180-n .

<i40528>	a	<Concept> ;
	skos:definition	"a bombing run in which the bomber approaches the target at a low altitude and pulls up just before releasing the bomb"@en ;
	dc:source	pwn30:00979348-n .

<i40529>	a	<Concept> ;
	skos:definition	"a special case of loft bombing in which the bomb is released past the vertical so it is tossed back to the target"@en ;
	dc:source	pwn30:00979557-n .

<i40530>	a	<Concept> ;
	skos:definition	"the use of bombs for sabotage; a tactic frequently used by terrorists"@en ;
	dc:source	pwn30:00979742-n .

<i40531>	a	<Concept> ;
	skos:definition	"a terrorist bombing carried out by someone who does not hope to survive it"@en ;
	dc:source	pwn30:00979902-n .

<i40532>	a	<Concept> ;
	skos:definition	"the action of attacking an enemy"@en ;
	dc:source	pwn30:00980038-n .

<i40533>	a	<Concept> ;
	skos:definition	"a large scale offensive (more than a counterattack) undertaken by a defending force to seize the initiative from an attacking force"@en ;
	dc:source	pwn30:00980200-n .

<i40534>	a	<Concept> ;
	skos:definition	"an offensive conducted by secret police or the military of a regime against revolutionary and terrorist insurgents and marked by the use of kidnapping and torture and murder with civilians often being the victims"@en ;
	dc:source	pwn30:00980394-n .

<i40535>	a	<Concept> ;
	skos:definition	"the act of forcing the enemy to withdraw"@en ;
	dc:source	pwn30:00980779-n .

<i40536>	a	<Concept> ;
	skos:definition	"the activity of keeping the peace by military forces (especially when international military forces enforce a truce between hostile groups or nations)"@en ;
	dc:source	pwn30:00980904-n .

<i40537>	a	<Concept> ;
	skos:definition	"a military operation by both land and sea forces"@en ;
	dc:source	pwn30:00981180-n .

<i40538>	a	<Concept> ;
	skos:definition	"an amphibious operation attacking a land base that is carried out by troops that are landed by naval ships"@en ;
	dc:source	pwn30:00981369-n .

<i40539>	a	<Concept> ;
	skos:definition	"the act of collecting information"@en ;
	dc:source	pwn30:00981711-n .

<i40540>	a	<Concept> ;
	skos:definition	"the operation of gathering information about an enemy"@en ;
	dc:source	pwn30:00981830-n .

<i40541>	a	<Concept> ;
	skos:definition	"intelligence of all types and forms of immediate interest; usually disseminated without delays for evaluation or interpretation"@en ;
	dc:source	pwn30:00982153-n .

<i40542>	a	<Concept> ;
	skos:definition	"intelligence that is required for the planning and conduct of tactical operations"@en ;
	dc:source	pwn30:00982347-n .

<i40543>	a	<Concept> ;
	skos:definition	"tactical intelligence on the natural and man-made characteristics of an area"@en ;
	dc:source	pwn30:00982536-n .

<i40544>	a	<Concept> ;
	skos:definition	"intelligence that is required for forming policy and military plans at national and international levels"@en ;
	dc:source	pwn30:00982679-n .

<i40545>	a	<Concept> ;
	skos:definition	"intelligence information gathered from communications intelligence or electronics intelligence or telemetry intelligence"@en ;
	dc:source	pwn30:00982852-n .

<i40546>	a	<Concept> ;
	skos:definition	"intelligence derived from electromagnetic radiations from foreign sources (other than radioactive sources)"@en ;
	dc:source	pwn30:00983102-n .

<i40547>	a	<Concept> ;
	skos:definition	"technical and intelligence information derived from foreign communications by other than the intended recipients"@en ;
	dc:source	pwn30:00983287-n .

<i40548>	a	<Concept> ;
	skos:definition	"intelligence derived from the interception and processing and analysis of foreign telemetry"@en ;
	dc:source	pwn30:00983482-n .

<i40549>	a	<Concept> ;
	skos:definition	"an intelligence operation so planned and executed as to insure concealment"@en ;
	dc:source	pwn30:00983651-n .

<i40550>	a	<Concept> ;
	skos:definition	"a clandestine rescue operation to bring a defector or refugee or an operative and family out of danger"@en ;
	dc:source	pwn30:00983811-n .

<i40551>	a	<Concept> ;
	skos:definition	"military actions designed to influence the perceptions and attitudes of individuals, groups, and foreign governments"@en ;
	dc:source	pwn30:00983982-n .

<i40552>	a	<Concept> ;
	skos:definition	"an intelligence operation so planned as to permit plausible denial by the sponsor"@en ;
	dc:source	pwn30:00984195-n .

<i40553>	a	<Concept> ;
	skos:definition	"a covert operation not attributable to the organization carrying it out"@en ;
	dc:source	pwn30:00984357-n .

<i40554>	a	<Concept> ;
	skos:definition	"the collection of intelligence openly without concealment"@en ;
	dc:source	pwn30:00984490-n .

<i40555>	a	<Concept> ;
	skos:definition	"the act of reconnoitring (especially to gain information about an enemy or potential enemy)"@en ;
	dc:source	pwn30:00984609-n .

<i40556>	a	<Concept> ;
	skos:definition	"reconnaissance (by shortening)"@en ;
	dc:source	pwn30:00985008-n .

<i40557>	a	<Concept> ;
	skos:definition	"exploring in order to gain information"@en ;
	dc:source	pwn30:00985106-n .

<i40558>	a	<Concept> ;
	skos:definition	"reconnaissance either by visual observation from the air or through the use of airborne sensors"@en ;
	dc:source	pwn30:00985356-n .

<i40559>	a	<Concept> ;
	skos:definition	"a method of reconnaissance in which fire is placed on a suspected enemy position in order to cause the enemy to disclose his presence by moving or returning fire"@en ;
	dc:source	pwn30:00985516-n .

<i40560>	a	<Concept> ;
	skos:definition	"an offensive operation designed to discover or test the enemy's strength (or to obtain other information)"@en ;
	dc:source	pwn30:00985746-n .

<i40561>	a	<Concept> ;
	skos:definition	"a quick look around (originally military slang)"@en ;
	dc:source	pwn30:00985921-n .

<i40562>	a	<Concept> ;
	skos:definition	"the detection and identification and evaluation and location of foreign electromagnetic radiations (other than radioactive)"@en ;
	dc:source	pwn30:00986080-n .

<i40563>	a	<Concept> ;
	skos:definition	"intelligence activities concerned with identifying and counteracting the threat to security posed by hostile intelligence organizations or by individuals engaged in espionage or sabotage or subversion or terrorism"@en ;
	dc:source	pwn30:00986275-n .

<i40564>	a	<Concept> ;
	skos:definition	"the aspect of counterintelligence designed to detect and prevent subversive activities"@en ;
	dc:source	pwn30:00986663-n .

<i40565>	a	<Concept> ;
	skos:definition	"counterintelligence designed to detect and counteract sabotage"@en ;
	dc:source	pwn30:00986813-n .

<i40566>	a	<Concept> ;
	skos:definition	"the act of firing weapons or artillery at an enemy"@en ;
	dc:source	pwn30:00986938-n .

<i40567>	a	<Concept> ;
	skos:definition	"firing at enemy aircraft"@en ;
	dc:source	pwn30:00987775-n .

<i40568>	a	<Concept> ;
	skos:definition	"the heavy fire of artillery to saturate an area rather than hit a specific target"@en ;
	dc:source	pwn30:00987863-n .

<i40569>	a	<Concept> ;
	skos:definition	"the simultaneous firing of all the armament on one side of a warship"@en ;
	dc:source	pwn30:00988177-n .

<i40570>	a	<Concept> ;
	skos:definition	"rapid simultaneous discharge of firearms"@en ;
	dc:source	pwn30:00988320-n .

<i40571>	a	<Concept> ;
	skos:definition	"fire delivered on a specific target in response to a request from the supported unit"@en ;
	dc:source	pwn30:00988556-n .

<i40572>	a	<Concept> ;
	skos:definition	"fire on enemy troops or weapons or positions that are near the supported unit and are the most immediate and serious threat to it"@en ;
	dc:source	pwn30:00988696-n .

<i40573>	a	<Concept> ;
	skos:definition	"fire that makes it difficult for the enemy to fire on your own individuals or formations"@en ;
	dc:source	pwn30:00988893-n .

<i40574>	a	<Concept> ;
	skos:definition	"fire on objectives not in the immediate vicinity of your forces but with the objective of destroying enemy reserves and weapons and interfering with the enemy command and supply and communications"@en ;
	dc:source	pwn30:00989122-n .

<i40575>	a	<Concept> ;
	skos:definition	"fire delivered in support of part of a force (as opposed to general supporting fire delivered in support of the force as a whole)"@en ;
	dc:source	pwn30:00989385-n .

<i40576>	a	<Concept> ;
	skos:definition	"fire from two or more weapons directed at a single target or area (as fire by batteries of two or more warships)"@en ;
	dc:source	pwn30:00989583-n .

<i40577>	a	<Concept> ;
	skos:definition	"fire intended to neutralize or destroy enemy weapons"@en ;
	dc:source	pwn30:00989773-n .

<i40578>	a	<Concept> ;
	skos:definition	"fire delivered to neutralize or destroy indirect fire weapon systems"@en ;
	dc:source	pwn30:00989937-n .

<i40579>	a	<Concept> ;
	skos:definition	"bombardment intended to destroy or neutralize enemy weapons"@en ;
	dc:source	pwn30:00990071-n .

<i40580>	a	<Concept> ;
	skos:definition	"mortar fire intended to destroy or neutralize enemy weapons"@en ;
	dc:source	pwn30:00990195-n .

<i40581>	a	<Concept> ;
	skos:definition	"intensive prearranged fire delivered when the immanence of enemy attack is discovered"@en ;
	dc:source	pwn30:00990319-n .

<i40582>	a	<Concept> ;
	skos:definition	"fire from two or more points so that the lines of fire cross"@en ;
	dc:source	pwn30:00990474-n .

<i40583>	a	<Concept> ;
	skos:definition	"fire delivered for the sole purpose of destroying material objects"@en ;
	dc:source	pwn30:00990590-n .

<i40584>	a	<Concept> ;
	skos:definition	"fire delivered on a target that is visible to the person aiming it"@en ;
	dc:source	pwn30:00990719-n .

<i40585>	a	<Concept> ;
	skos:definition	"fire dispersed so as to engage effectively an area target"@en ;
	dc:source	pwn30:00990843-n .

<i40586>	a	<Concept> ;
	skos:definition	"fire that injures or kills an ally"@en ;
	dc:source	pwn30:00990963-n .

<i40587>	a	<Concept> ;
	skos:definition	"fire that injures or kills an enemy"@en ;
	dc:source	pwn30:00991070-n .

<i40588>	a	<Concept> ;
	skos:definition	"fire approximately parallel to the ground; the center of the cone of fire does rise above 1 meter from the ground"@en ;
	dc:source	pwn30:00991164-n .

<i40589>	a	<Concept> ;
	skos:definition	"fire designed to disturb the rest of enemy troops and to curtail movement and to lower enemy morale"@en ;
	dc:source	pwn30:00991336-n .

<i40590>	a	<Concept> ;
	skos:definition	"fire delivered on a target that is not itself used as the point of aim for the weapons"@en ;
	dc:source	pwn30:00991496-n .

<i40591>	a	<Concept> ;
	skos:definition	"fire directed to an area to prevent the enemy from using that area"@en ;
	dc:source	pwn30:00991642-n .

<i40592>	a	<Concept> ;
	skos:definition	"fire that is delivered in order to render the target ineffective or unusable"@en ;
	dc:source	pwn30:00991772-n .

<i40593>	a	<Concept> ;
	skos:definition	"fire for which the point of impact (the burst) can be seen by an observer; fire can be adjusted on the basis of the observations"@en ;
	dc:source	pwn30:00991914-n .

<i40594>	a	<Concept> ;
	skos:definition	"fire delivered on a target in preparation for an assault"@en ;
	dc:source	pwn30:00992102-n .

<i40595>	a	<Concept> ;
