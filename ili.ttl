	dc:source	pwn30:06555341-n .

<i70912>	a	<Concept> ;
	skos:definition	"a writ that authorizes the seizure of property"@en ;
	dc:source	pwn30:06555570-n .

<i70913>	a	<Concept> ;
	skos:definition	"a writ ordering the release of goods that have been unlawfully detained"@en ;
	dc:source	pwn30:06555695-n .

<i70914>	a	<Concept> ;
