	dc:source	pwn30:13014581-n .

<i105134>	a	<Concept> ;
	skos:definition	"an agaric with a ragged stalk and a soft floccose cap"@en ;
	dc:source	pwn30:13014741-n .

<i105135>	a	<Concept> ;
	skos:definition	"a white agaric that tends to cluster and has a club-shaped base"@en ;
	dc:source	pwn30:13014879-n .

<i105136>	a	<Concept> ;
	skos:definition	"fungi having leathery or membranous sporophores"@en ;
	dc:source	pwn30:13015040-n .

<i105137>	a	<Concept> ;
	skos:definition	"genus of fungi having simple smooth sporophores; some are parasitic on wood or economic crops; some species formerly placed in form genus Rhizoctinia"@en ;
	dc:source	pwn30:13015229-n .

<i105138>	a	<Concept> ;
	skos:definition	"fungus causing pink disease in citrus and coffee and rubber trees etc"@en ;
	dc:source	pwn30:13015509-n .

<i105139>	a	<Concept> ;
	skos:definition	"fungus causing bottom rot in lettuce"@en ;
	dc:source	pwn30:13015688-n .

<i105140>	a	<Concept> ;
	skos:definition	"genus of fungi having the hymenium in the form of a crust; some species formerly placed in form genus Rhizoctinia"@en ;
	dc:source	pwn30:13015826-n .

<i105141>	a	<Concept> ;
	skos:definition	"fungus causing a disease in potatoes characterized by black scurfy spots on the tubers"@en ;
	dc:source	pwn30:13016076-n .

<i105142>	a	<Concept> ;
	skos:definition	"fungus causing a disease in coffee and some other tropical plants"@en ;
	dc:source	pwn30:13016289-n .

<i105143>	a	<Concept> ;
	skos:definition	"a family of fungi belonging to the order Agaricales"@en ;
	dc:source	pwn30:13016457-n .

<i105144>	a	<Concept> ;
	skos:definition	"agarics with white spores and a fleshy stalk and notched gills; of various colors both edible and inedible"@en ;
	dc:source	pwn30:13016749-n .

<i105145>	a	<Concept> ;
	skos:definition	"edible agaric that is pale lilac when young; has a smooth moist cap"@en ;
	dc:source	pwn30:13017102-n .

<i105146>	a	<Concept> ;
	skos:definition	"an edible agaric that fruits in great clusters (especially in sandy soil under cottonwood trees)"@en ;
	dc:source	pwn30:13017240-n .

<i105147>	a	<Concept> ;
	skos:definition	"a mildly poisonous agaric with a viscid reddish brown cap and white gills and stalk"@en ;
	dc:source	pwn30:13017439-n .

<i105148>	a	<Concept> ;
	skos:definition	"an agaric with a cap that is coated with dark fibrils in the center and has yellowish margins"@en ;
	dc:source	pwn30:13017610-n .

<i105149>	a	<Concept> ;
	skos:definition	"an edible agaric with yellow gills and a viscid yellow cap that has a brownish center"@en ;
	dc:source	pwn30:13017789-n .

<i105150>	a	<Concept> ;
	skos:definition	"a poisonous white agaric"@en ;
	dc:source	pwn30:13017979-n .

<i105151>	a	<Concept> ;
	skos:definition	"a poisonous agaric having a pale cap with fine grey fibrils"@en ;
	dc:source	pwn30:13018088-n .

<i105152>	a	<Concept> ;
	skos:definition	"an agaric with a cap that is densely covered with reddish fibrils and pale gills and stalk"@en ;
	dc:source	pwn30:13018232-n .

<i105153>	a	<Concept> ;
	skos:definition	"an orange tan agaric whose gills become brown by maturity; has a strong odor and taste"@en ;
	dc:source	pwn30:13018407-n .

<i105154>	a	<Concept> ;
	skos:definition	"a family of fungi belonging to the order Agaricales"@en ;
	dc:source	pwn30:13018579-n .

<i105155>	a	<Concept> ;
	skos:definition	"agarics having pink spores and a distinct volva"@en ;
	dc:source	pwn30:13018749-n .

<i105156>	a	<Concept> ;
	skos:definition	"a parasite on various trees"@en ;
	dc:source	pwn30:13018906-n .

<i105157>	a	<Concept> ;
	skos:definition	"a family of fungi belonging to the order Agaricales"@en ;
	dc:source	pwn30:13019017-n .

<i105158>	a	<Concept> ;
	skos:definition	"a large genus of fungi belonging to the family Pluteaceae; the shape of the cap resembles a roof; often abundant early in the summer"@en ;
	dc:source	pwn30:13019202-n .

<i105159>	a	<Concept> ;
	skos:definition	"an agaric with a brilliant scarlet cap and a slender stalk"@en ;
	dc:source	pwn30:13019496-n .

<i105160>	a	<Concept> ;
	skos:definition	"an edible agaric found in piles of hardwood sawdust; the caps are black and coarsely wrinkled"@en ;
	dc:source	pwn30:13019643-n .

<i105161>	a	<Concept> ;
	skos:definition	"a small edible agaric with a slender stalk; usually found on rotting hardwoods"@en ;
	dc:source	pwn30:13019835-n .

<i105162>	a	<Concept> ;
	skos:definition	"an important genus of mushrooms in the Orient"@en ;
	dc:source	pwn30:13020011-n .

<i105163>	a	<Concept> ;
	skos:definition	"small tropical and subtropical edible mushroom having a white cap and long stem; an expensive delicacy in China and other Asian countries where it is grown commercially"@en ;
	dc:source	pwn30:13020191-n .

<i105164>	a	<Concept> ;
	skos:definition	"a mushroom with a dry yellowish to white fibrillose cap"@en ;
	dc:source	pwn30:13020481-n .

<i105165>	a	<Concept> ;
	skos:definition	"a genus of agarics with white to pale yellow spore deposits and fleshy stalks centrally attached to the cap and closely attached gills"@en ;
	dc:source	pwn30:13020623-n .

<i105166>	a	<Concept> ;
	skos:definition	"an agaric with a flat cap that is greyish or yellowish brown with pallid gills and a stalk that bulges toward the base"@en ;
	dc:source	pwn30:13020964-n .

<i105167>	a	<Concept> ;
	skos:definition	"a small poisonous agaric; has a dry white cap with crowded gills and a short stalk"@en ;
	dc:source	pwn30:13021166-n .

<i105168>	a	<Concept> ;
	skos:definition	"a fungus with a cap that is creamy grey when young and turns brown with age and a whitish stalk that stains yellow when handled"@en ;
	dc:source	pwn30:13021332-n .

<i105169>	a	<Concept> ;
	skos:definition	"a large white agaric; edible but not palatable"@en ;
	dc:source	pwn30:13021543-n .

<i105170>	a	<Concept> ;
	skos:definition	"an edible agaric with large silky white caps and thick stalks"@en ;
	dc:source	pwn30:13021689-n .

<i105171>	a	<Concept> ;
	skos:definition	"an edible white agaric that fruits in dense clusters; the gills are narrow and crowded and the stalk is fleshy and unpolished"@en ;
	dc:source	pwn30:13021867-n .

<i105172>	a	<Concept> ;
	skos:definition	"a genus of agarics"@en ;
	dc:source	pwn30:13022078-n .

<i105173>	a	<Concept> ;
	skos:definition	"an edible agaric that is available in early spring or late fall when few other mushrooms are; has a viscid smooth orange to brown cap and a velvety stalk that turns black in maturity and pallid gills; often occur in clusters"@en ;
	dc:source	pwn30:13022210-n .

<i105174>	a	<Concept> ;
	skos:definition	"any of the threadlike filaments forming the mycelium of a fungus"@en ;
	dc:source	pwn30:13022538-n .

<i105175>	a	<Concept> ;
	skos:definition	"the vegetative part of a fungus consisting of a mass of branching threadlike hyphae"@en ;
	dc:source	pwn30:13022709-n .

<i105176>	a	<Concept> ;
	skos:definition	"compact usually dark-colored mass of hardened mycelium constituting a vegetative food-storage body in various true fungi; detaches when mature and can give rise to new growth"@en ;
	dc:source	pwn30:13022903-n .

<i105177>	a	<Concept> ;
	skos:definition	"any of various ascomycetous fungi in which the spores are formed in a sac or ascus"@en ;
	dc:source	pwn30:13023134-n .

<i105178>	a	<Concept> ;
	skos:definition	"a large subdivision of Eumycota including Hemiascomycetes and Plectomycetes and Pyrenomycetes and Discomycetes; sac fungi; in some classification systems considered a division of the kingdom Fungi"@en ;
	dc:source	pwn30:13023292-n .

<i105179>	a	<Concept> ;
	skos:definition	"large class of higher fungi coextensive with division Ascomycota: sac fungi"@en ;
	dc:source	pwn30:13023783-n .

<i105180>	a	<Concept> ;
	skos:definition	"any fungus of the class Ascomycetes (or subdivision Ascomycota) in which the spores are formed inside an ascus"@en ;
	dc:source	pwn30:13024012-n .

<i105181>	a	<Concept> ;
	skos:definition	"category not used in many classification systems"@en ;
	dc:source	pwn30:13024348-n .

<i105182>	a	<Concept> ;
	skos:definition	"any of various mushrooms of the class Ascomycetes"@en ;
	dc:source	pwn30:13024500-n .

<i105183>	a	<Concept> ;
	skos:definition	"a variety of grainy club mushrooms"@en ;
	dc:source	pwn30:13024653-n .

<i105184>	a	<Concept> ;
	skos:definition	"class of fungi in which no ascocarps are formed: yeasts and some plant parasites"@en ;
	dc:source	pwn30:13024763-n .

<i105185>	a	<Concept> ;
	skos:definition	"fungi having a zygote or a single cell developing directly into an ascus"@en ;
	dc:source	pwn30:13024967-n .

<i105186>	a	<Concept> ;
	skos:definition	"family of fungi comprising the typical yeasts: reproduce by budding and ferment carbohydrates"@en ;
	dc:source	pwn30:13025197-n .

<i105187>	a	<Concept> ;
	skos:definition	"single-celled yeasts that reproduce asexually by budding; used to ferment carbohydrates"@en ;
	dc:source	pwn30:13025421-n .

<i105188>	a	<Concept> ;
	skos:definition	"any of various single-celled fungi that reproduce asexually by budding or division"@en ;
	dc:source	pwn30:13025647-n .

<i105189>	a	<Concept> ;
	skos:definition	"used as a leaven in baking and brewing"@en ;
	dc:source	pwn30:13025854-n .

<i105190>	a	<Concept> ;
	skos:definition	"used in making wine"@en ;
	dc:source	pwn30:13026015-n .

<i105191>	a	<Concept> ;
	skos:definition	"a family of fungi belonging to order Endomycetales"@en ;
	dc:source	pwn30:13026146-n .

<i105192>	a	<Concept> ;
	skos:definition	"type and only genus of Schizosaccharomycetaceae; comprises the fission yeasts"@en ;
	dc:source	pwn30:13026339-n .

<i105193>	a	<Concept> ;
	skos:definition	"class of fungi in which the fruiting body is a cleistothecium (it releases spores only on decay or disintegration)"@en ;
	dc:source	pwn30:13026529-n .

<i105194>	a	<Concept> ;
	skos:definition	"order of fungi having a closed ascocarp (cleistothecium) with the asci scattered rather than gathered in a hymenium"@en ;
	dc:source	pwn30:13026763-n .

<i105195>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the order Eurotiales"@en ;
	dc:source	pwn30:13027049-n .

<i105196>	a	<Concept> ;
	skos:definition	"family of fungi including some common molds"@en ;
	dc:source	pwn30:13027190-n .

<i105197>	a	<Concept> ;
	skos:definition	"genus of common molds causing food spoilage and some pathogenic to plants and animals"@en ;
	dc:source	pwn30:13027375-n .

<i105198>	a	<Concept> ;
	skos:definition	"a mold causing aspergillosis in birds and man"@en ;
	dc:source	pwn30:13027557-n .

<i105199>	a	<Concept> ;
	skos:definition	"genus of fungi having spherical brown perithecia and some conidia borne in chains; cause root rot"@en ;
	dc:source	pwn30:13027670-n .

<i105200>	a	<Concept> ;
	skos:definition	"fungus causing brown root rot in plants of the pea and potato and cucumber families"@en ;
	dc:source	pwn30:13027879-n .

<i105201>	a	<Concept> ;
	skos:definition	"class of fungi in which the fruiting body is a perithecium; includes powdery mildews and ergot and Neurospora"@en ;
	dc:source	pwn30:13028070-n .

<i105202>	a	<Concept> ;
	skos:definition	"a large and taxonomically difficult group of Ascomycetes in which the fleshy fruiting body is disklike or cup-shaped"@en ;
	dc:source	pwn30:13028337-n .

<i105203>	a	<Concept> ;
	skos:definition	"any fungus that is a member of the subclass Discomycetes"@en ;
	dc:source	pwn30:13028611-n .

<i105204>	a	<Concept> ;
	skos:definition	"a discomycete that develops in clusters of slippery rubbery gelatinous fruiting bodies that are dingy yellow to tan in color"@en ;
	dc:source	pwn30:13028937-n .

<i105205>	a	<Concept> ;
	skos:definition	"a discomycete that is 3-8 cm high with an orange to yellow fertile portion and white or pinkish stalks often half in and half out of the water"@en ;
	dc:source	pwn30:13029122-n .

<i105206>	a	<Concept> ;
	skos:definition	"a discomycete that is a harbinger of spring; the fruiting body is thin and tough and saucer-shaped (about the size of quarter to a half dollar) with a deep bright red upper surface and a whitish exterior"@en ;
	dc:source	pwn30:13029326-n .

<i105207>	a	<Concept> ;
	skos:definition	"an early spring variety of discomycete with yellow to orange yellow lining of the cup"@en ;
	dc:source	pwn30:13029610-n .

<i105208>	a	<Concept> ;
	skos:definition	"a discomycete with bright orange cup-shaped or saucer-shaped fruiting bodies and pale orange exteriors"@en ;
	dc:source	pwn30:13029760-n .

<i105209>	a	<Concept> ;
	skos:definition	"order of mostly saprophytic fungi having cup-shaped ascocarps"@en ;
	dc:source	pwn30:13029946-n .

<i105210>	a	<Concept> ;
	skos:definition	"large family comprising many typical cup fungi"@en ;
	dc:source	pwn30:13030157-n .

<i105211>	a	<Concept> ;
	skos:definition	"apothecium of a fungus of the family Pezizaceae"@en ;
	dc:source	pwn30:13030337-n .

<i105212>	a	<Concept> ;
	skos:definition	"type genus of the Pezizaceae: a variety of cup fungus"@en ;
	dc:source	pwn30:13030438-n .

<i105213>	a	<Concept> ;
	skos:definition	"a discomycetous fungus of the genus Peziza; the fragile fruiting body is a ghostly white but stains yellow when broken; favors strongly alkaline habitats"@en ;
	dc:source	pwn30:13030616-n .

<i105214>	a	<Concept> ;
	skos:definition	"a scarlet European fungus with cup-shaped ascocarp"@en ;
	dc:source	pwn30:13030852-n .

<i105215>	a	<Concept> ;
	skos:definition	"genus of fungi in the family Pezizaceae closely related to and often included in genus Peziza"@en ;
	dc:source	pwn30:13031007-n .

<i105216>	a	<Concept> ;
	skos:definition	"an urn-shaped discomycete with a nearly black interior"@en ;
	dc:source	pwn30:13031193-n .

<i105217>	a	<Concept> ;
	skos:definition	"the cup-shaped fruiting body of this discomycete has a jellylike interior and a short stalk"@en ;
	dc:source	pwn30:13031323-n .

<i105218>	a	<Concept> ;
	skos:definition	"the fruiting bodies of this discomycete have a firm texture and long retain their cup shape; the pale brown interior blends with the color of dead leaves"@en ;
	dc:source	pwn30:13031474-n .

<i105219>	a	<Concept> ;
	skos:definition	"a family of edible fungi including the true morels"@en ;
	dc:source	pwn30:13031690-n .

<i105220>	a	<Concept> ;
	skos:definition	"genus of edible fungi: morel"@en ;
	dc:source	pwn30:13031956-n .

<i105221>	a	<Concept> ;
	skos:definition	"any of various edible mushrooms of the genus Morchella having a brownish spongelike cap"@en ;
	dc:source	pwn30:13032115-n .

<i105222>	a	<Concept> ;
	skos:definition	"an edible and choice morel with a globular to elongate head with an irregular pattern of pits and ridges"@en ;
	dc:source	pwn30:13032381-n .

<i105223>	a	<Concept> ;
	skos:definition	"an edible morel with a cup-shaped or saucer-shaped fruiting body can be up to 20 cm wide; the fertile surface inside the cup has wrinkles radiating from the center; can be easily confused with inedible mushrooms"@en ;
	dc:source	pwn30:13032618-n .

<i105224>	a	<Concept> ;
	skos:definition	"a morel whose fertile portion resembles a bell and is attached to the stipe only at the top"@en ;
	dc:source	pwn30:13032923-n .

<i105225>	a	<Concept> ;
	skos:definition	"resembles a thimble on a finger; the surface of the fertile portion is folded into wrinkles that extend from the top down; fruiting begins in spring before the leaves are out on the trees"@en ;
	dc:source	pwn30:13033134-n .

<i105226>	a	<Concept> ;
	skos:definition	"a morel with a fertile portion that has a relatively smooth surface; the stalk is fragile"@en ;
	dc:source	pwn30:13033396-n .

<i105227>	a	<Concept> ;
	skos:definition	"a morel whose pitted fertile body is attached to the stalk with little free skirt around it; the fertile body is grey when young and black in old age"@en ;
	dc:source	pwn30:13033577-n .

<i105228>	a	<Concept> ;
	skos:definition	"a delicious morel with a conic fertile portion having deep and irregular pits"@en ;
	dc:source	pwn30:13033879-n .

<i105229>	a	<Concept> ;
	skos:definition	"a morel with the ridged and pitted fertile portion attached to the stipe for about half its length"@en ;
	dc:source	pwn30:13034062-n .

<i105230>	a	<Concept> ;
	skos:definition	"family of fungi belonging to the order Pezizales"@en ;
	dc:source	pwn30:13034277-n .

<i105231>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Sarcoscyphaceae"@en ;
	dc:source	pwn30:13034431-n .

<i105232>	a	<Concept> ;
	skos:definition	"a fungus composed of several apothecia that look like elongated rabbit ears; the sterile surface is dark brown and warty; the fertile surface is smooth and pinkish orange"@en ;
	dc:source	pwn30:13034555-n .

<i105233>	a	<Concept> ;
	skos:definition	"a fungus with a long solid stalk embedded in soil and a yellow-brown head shaped like a cauliflower"@en ;
	dc:source	pwn30:13034788-n .

<i105234>	a	<Concept> ;
	skos:definition	"family of false morels or lorchels; some are edible and some are poisonous"@en ;
	dc:source	pwn30:13034953-n .

<i105235>	a	<Concept> ;
	skos:definition	"a fungus of the family Helvellaceae"@en ;
	dc:source	pwn30:13035241-n .

<i105236>	a	<Concept> ;
	skos:definition	"a large fungus of the family Helvellaceae"@en ;
	dc:source	pwn30:13035389-n .

<i105237>	a	<Concept> ;
	skos:definition	"type genus of the Helvellaceae"@en ;
	dc:source	pwn30:13035521-n .

<i105238>	a	<Concept> ;
	skos:definition	"any fungus of the genus Helvella having the ascocarps stalked or pleated or often in folds"@en ;
	dc:source	pwn30:13035707-n .

<i105239>	a	<Concept> ;
	skos:definition	"a helvella with a saddle-shaped fertile part and creamy color; the stalk is fluted and pitted"@en ;
	dc:source	pwn30:13035925-n .

<i105240>	a	<Concept> ;
	skos:definition	"a helvella with a cup-shaped fertile body having a brown interior; the stalk is creamy white and heavily ribbed"@en ;
	dc:source	pwn30:13036116-n .

<i105241>	a	<Concept> ;
	skos:definition	"a helvella with an irregularly convoluted cap that is dark brown when young and becomes dull grey with age; the lower surface of the cap is smooth and pale grey; the stalk is thick and deeply fluted"@en ;
	dc:source	pwn30:13036312-n .

<i105242>	a	<Concept> ;
	skos:definition	"a genus of fungi of the family Helvellaceae with a cup-shaped or saucer-shaped fruiting body and ornamented spores"@en ;
	dc:source	pwn30:13036592-n .

<i105243>	a	<Concept> ;
	skos:definition	"any fungus of the genus Discina"@en ;
	dc:source	pwn30:13036804-n .

<i105244>	a	<Concept> ;
	skos:definition	"a discina with a flat or saucer-shaped fertile body that is brown on the upper surface; has a short stalk; not recommended for eating"@en ;
	dc:source	pwn30:13036907-n .

<i105245>	a	<Concept> ;
	skos:definition	"a genus of fungi of the family Helvellaceae with a fertile portion that is tan to brown"@en ;
	dc:source	pwn30:13037124-n .

<i105246>	a	<Concept> ;
	skos:definition	"any fungus of the genus Gyromitra"@en ;
	dc:source	pwn30:13037406-n .

<i105247>	a	<Concept> ;
	skos:definition	"a gyromitra with a brown puffed up fertile part and a thick fluted stalk; found under conifers in California"@en ;
	dc:source	pwn30:13037585-n .

<i105248>	a	<Concept> ;
	skos:definition	"a gyromitra with a brown puffed up fertile part and a rosy pink fluted stalk and smooth round spores; found on hardwood slash east of the Great Plains"@en ;
	dc:source	pwn30:13037805-n .

<i105249>	a	<Concept> ;
	skos:definition	"a poisonous gyromitra; the surface of the fertile body is smooth at first and becomes progressively undulating and wrinkled (but never truly pitted); color varies from dull yellow to brown"@en ;
	dc:source	pwn30:13038068-n .

<i105250>	a	<Concept> ;
	skos:definition	"a poisonous fungus; saddle-shaped and dull yellow to brown fertile part is relatively even"@en ;
	dc:source	pwn30:13038376-n .

<i105251>	a	<Concept> ;
	skos:definition	"a lorchel with deep brownish red fertile part and white stalk"@en ;
	dc:source	pwn30:13038577-n .

<i105252>	a	<Concept> ;
	skos:definition	"a gyromitra with a large irregular stalk and fertile part that is yellow to brown and wrinkled; has early fruiting time"@en ;
	dc:source	pwn30:13038744-n .

<i105253>	a	<Concept> ;
	skos:definition	"fungi in which the hymenium is enclosed until after spores have matured: puffballs; earth stars; stinkhorn fungi"@en ;
	dc:source	pwn30:13038944-n .

<i105254>	a	<Concept> ;
	skos:definition	"any fungus of the class Gasteromycetes"@en ;
	dc:source	pwn30:13039349-n .

<i105255>	a	<Concept> ;
	skos:definition	"order of fungi comprising the stinkhorns and related forms whose mature hymenium is slimy and fetid; sometimes placed in subclass Homobasidiomycetes"@en ;
	dc:source	pwn30:13039553-n .

<i105256>	a	<Concept> ;
	skos:definition	"a family of fungi belonging to the order Phallales and comprising the true stinkhorns"@en ;
	dc:source	pwn30:13039870-n .

<i105257>	a	<Concept> ;
	skos:definition	"genus of fungi having the cap or pileus hanging free around the stem"@en ;
	dc:source	pwn30:13040108-n .

<i105258>	a	<Concept> ;
	skos:definition	"any of various ill-smelling brown-capped fungi of the order Phallales"@en ;
	dc:source	pwn30:13040303-n .

<i105259>	a	<Concept> ;
	skos:definition	"a common fungus formerly used in preparing a salve for rheumatism"@en ;
	dc:source	pwn30:13040629-n .

<i105260>	a	<Concept> ;
	skos:definition	"this stinkhorn has a cap with a granulose surface at the apex and smells like decaying flesh"@en ;
	dc:source	pwn30:13040796-n .

<i105261>	a	<Concept> ;
	skos:definition	"closely related to genus Phallus distinguished by an indusium hanging like a skirt from below the pileus"@en ;
	dc:source	pwn30:13040971-n .

<i105262>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Phallaceae"@en ;
	dc:source	pwn30:13041172-n .

<i105263>	a	<Concept> ;
	skos:definition	"a stinkhorn having a stalk without a cap; the slimy gleba is simply plastered on its surface near the apex where winged insects can find it"@en ;
	dc:source	pwn30:13041312-n .

<i105264>	a	<Concept> ;
	skos:definition	"an order of fungi belonging to the class Gasteromycetes"@en ;
	dc:source	pwn30:13041548-n .

<i105265>	a	<Concept> ;
	skos:definition	"a family of fungi belonging to the order Tulostomatales"@en ;
	dc:source	pwn30:13041725-n .

<i105266>	a	<Concept> ;
	skos:definition	"a gasteromycete with a leathery stalk and a fruiting body that is globose and has a pale yellow spore case"@en ;
	dc:source	pwn30:13041943-n .

<i105267>	a	<Concept> ;
	skos:definition	"a gasteromycete with a leathery stalk and a fruiting body this globose and has a red spore case"@en ;
	dc:source	pwn30:13042134-n .

<i105268>	a	<Concept> ;
	skos:definition	"a gasteromycete with a leathery stalk and a fruiting body with a thin gelatinous spore case and elliptical spores"@en ;
	dc:source	pwn30:13042316-n .

<i105269>	a	<Concept> ;
	skos:definition	"family of fleshy fungi resembling stinkhorns"@en ;
	dc:source	pwn30:13042514-n .

<i105270>	a	<Concept> ;
	skos:definition	"type genus of the Clathraceae"@en ;
	dc:source	pwn30:13042694-n .

<i105271>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Clathraceae"@en ;
	dc:source	pwn30:13042814-n .

<i105272>	a	<Concept> ;
	skos:definition	"a stinkhorn of genus Pseudocolus; the fruiting body first resembles a small puffball that soon splits open to form a stalk with tapering arms that arch and taper to a common point"@en ;
	dc:source	pwn30:13042982-n .

<i105273>	a	<Concept> ;
	skos:definition	"small order of basidiomycetous fungi having fleshy often globose fruiting bodies; includes puffballs and earthstars"@en ;
	dc:source	pwn30:13043264-n .

<i105274>	a	<Concept> ;
	skos:definition	"a fungus family belonging to the order Lycoperdales; includes puffballs"@en ;
	dc:source	pwn30:13043516-n .

<i105275>	a	<Concept> ;
	skos:definition	"genus of fungi whose fruiting body tapers toward a base consisting of spongy mycelium"@en ;
	dc:source	pwn30:13043746-n .

<i105276>	a	<Concept> ;
	skos:definition	"any of various fungi of the family Lycoperdaceae whose round fruiting body discharges a cloud of spores when mature"@en ;
	dc:source	pwn30:13043926-n .

<i105277>	a	<Concept> ;
	skos:definition	"genus of puffballs having outer casings whose upper parts break at maturity into angular pieces to expose the spores"@en ;
	dc:source	pwn30:13044149-n .

<i105278>	a	<Concept> ;
	skos:definition	"huge edible puffball up to 2 feet diameter and 25 pounds in weight"@en ;
	dc:source	pwn30:13044375-n .

<i105279>	a	<Concept> ;
	skos:definition	"a family of earthstar fungi belonging to the order Lycoperdales"@en ;
	dc:source	pwn30:13044541-n .

<i105280>	a	<Concept> ;
	skos:definition	"any fungus of the family Geastraceae; in form suggesting a puffball whose outer peridium splits into the shape of a star"@en ;
	dc:source	pwn30:13044778-n .

<i105281>	a	<Concept> ;
	skos:definition	"type genus of Geastraceae; fungi whose outer peridium when dry splits into starlike segments"@en ;
	dc:source	pwn30:13045027-n .

<i105282>	a	<Concept> ;
	skos:definition	"an earthstar with a bluish spore sac and a purplish brown gleba; at maturity the outer layer splits into rays that bend backward and elevate the spore sac"@en ;
	dc:source	pwn30:13045210-n .

<i105283>	a	<Concept> ;
	skos:definition	"a genus of fungus belonging to the family Geastraceae"@en ;
	dc:source	pwn30:13045429-n .

<i105284>	a	<Concept> ;
	skos:definition	"a fungus similar to an earthstar except that it does not open up; the spore mass is brown at maturity with a column of sterile tissue extending up into it"@en ;
	dc:source	pwn30:13045594-n .

<i105285>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Geastraceae"@en ;
	dc:source	pwn30:13045834-n .

<i105286>	a	<Concept> ;
	skos:definition	"the largest earthstar; the fruiting body can measure 15 cm across when the rays are expanded"@en ;
	dc:source	pwn30:13045975-n .

<i105287>	a	<Concept> ;
	skos:definition	"a common species of earthstar widely distributed in sandy soil; the gleba is a pale tan"@en ;
	dc:source	pwn30:13046130-n .

<i105288>	a	<Concept> ;
	skos:definition	"small order of basidiomycetous fungi comprising families Nidulariaceae and Sphaerobolaceae"@en ;
	dc:source	pwn30:13046285-n .

<i105289>	a	<Concept> ;
	skos:definition	"bird's-nest fungi"@en ;
	dc:source	pwn30:13046512-n .

<i105290>	a	<Concept> ;
	skos:definition	"any of various fungi of the family Nidulariaceae having a cup-shaped body containing several egg-shaped structure enclosing the spores"@en ;
	dc:source	pwn30:13046669-n .

<i105291>	a	<Concept> ;
	skos:definition	"type genus of the Nidulariaceae"@en ;
	dc:source	pwn30:13046887-n .

<i105292>	a	<Concept> ;
	skos:definition	"monotypic family of fungi in which the more or less spherical gleba is forcibly ejected at maturity"@en ;
	dc:source	pwn30:13047011-n .

<i105293>	a	<Concept> ;
	skos:definition	"an order of fungi belonging to the class Gasteromycetes"@en ;
	dc:source	pwn30:13047216-n .

<i105294>	a	<Concept> ;
	skos:definition	"a family of fungi that have a stalk and cap and a wrinkled mass of tissue (the gleba) where spores are produced; are often dismissed as misshapen forms of other fungi"@en ;
	dc:source	pwn30:13047385-n .

<i105295>	a	<Concept> ;
	skos:definition	"a genus of fungi of the family Secotiaceae"@en ;
	dc:source	pwn30:13047706-n .

<i105296>	a	<Concept> ;
	skos:definition	"a species of Gastrocybe fungus that has a conic cap and a thin stalk; at first the stalk is upright but as it matures the stalk bends over and then downward; the cap then gelatinizes and a slimy mass containing the spores falls to the ground as the stalk collapses"@en ;
	dc:source	pwn30:13047862-n .

<i105297>	a	<Concept> ;
	skos:definition	"a stout-stemmed genus of fungus belonging to the family Secotiaceae having fruiting bodies that never expand completely"@en ;
	dc:source	pwn30:13048212-n .

<i105298>	a	<Concept> ;
	skos:definition	"a small fungus with a fragile cap that cracks to expose the white context and a white stalk that is practically enclosed by the cap"@en ;
	dc:source	pwn30:13048447-n .

<i105299>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Secotiaceae; they resemble boletes but the spores are not discharged from the basidium"@en ;
	dc:source	pwn30:13048666-n .

<i105300>	a	<Concept> ;
	skos:definition	"a dingy yellow brown fungus with a rough stalk that superficially resembles a bolete"@en ;
	dc:source	pwn30:13048932-n .

<i105301>	a	<Concept> ;
	skos:definition	"a fungus with a cap that can vary from red to dark brown; superficially resembles a bolete"@en ;
	dc:source	pwn30:13049105-n .

<i105302>	a	<Concept> ;
	skos:definition	"includes chiefly saprophytic fungi typically with shelflike bodies; sometimes placed in class Hymenomycetes or included in Agaricales"@en ;
	dc:source	pwn30:13049285-n .

<i105303>	a	<Concept> ;
	skos:definition	"fungi that become corky or woody with age, often forming shelflike growths on trees"@en ;
	dc:source	pwn30:13049561-n .

<i105304>	a	<Concept> ;
	skos:definition	"woody pore fungi; any fungus of the family Polyporaceae or family Boletaceae having the spore-bearing surface within tubes or pores; the fruiting bodies are usually woody at maturity and persistent"@en ;
	dc:source	pwn30:13049953-n .

<i105305>	a	<Concept> ;
	skos:definition	"a woody fungus that forms shelflike sporophores on tree trunks and wood structures"@en ;
	dc:source	pwn30:13050397-n .

<i105306>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Polyporaceae"@en ;
	dc:source	pwn30:13050555-n .

<i105307>	a	<Concept> ;
	skos:definition	"a rare fungus having a large (up to 14 inches wide) yellow fruiting body with multiple individual caps and a broad central stalk and a fragrant odor"@en ;
	dc:source	pwn30:13050705-n .

<i105308>	a	<Concept> ;
	skos:definition	"a fungus with a whitish often circular cap and a white pore surface and small pores and a white central stalk; found under conifers; edible but not popular"@en ;
	dc:source	pwn30:13050940-n .

<i105309>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Polyporaceae"@en ;
	dc:source	pwn30:13051196-n .

<i105310>	a	<Concept> ;
	skos:definition	"a gilled polypore with a large cap (up to 15 inches in diameter) and a broad stalk; edible when young and tender"@en ;
	dc:source	pwn30:13051346-n .

<i105311>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Polyporaceae"@en ;
	dc:source	pwn30:13051546-n .

<i105312>	a	<Concept> ;
	skos:definition	"a woody pore fungus with a dark brown to red brown cap and spore surface and small pores"@en ;
	dc:source	pwn30:13051694-n .

<i105313>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Polyporaceae"@en ;
	dc:source	pwn30:13051866-n .

<i105314>	a	<Concept> ;
	skos:definition	"a pore fungus with a whitish cottony soft cap found on conifer logs in forests at high elevation in the western United States and adjacent Canada"@en ;
	dc:source	pwn30:13052014-n .

<i105315>	a	<Concept> ;
	skos:definition	"a fungus with a whitish kidney-shaped cap and elongated pores; causes white rot in dead hardwoods"@en ;
	dc:source	pwn30:13052248-n .

<i105316>	a	<Concept> ;
	skos:definition	"type genus of the Polyporaceae; includes important pathogens of e.g. birches and conifers"@en ;
	dc:source	pwn30:13052431-n .

<i105317>	a	<Concept> ;
	skos:definition	"large greyish-brown edible fungus forming a mass of overlapping caps that somewhat resembles a hen at the base of trees"@en ;
	dc:source	pwn30:13052670-n .

<i105318>	a	<Concept> ;
	skos:definition	"a fungus with a lateral stalk (when there is a stalk) and a scaly cap that becomes nearly black in maturity; widely distributed in the northern hemisphere"@en ;
	dc:source	pwn30:13052931-n .

<i105319>	a	<Concept> ;
	skos:definition	"a family of fungi closely related to the family Polyporaceae except that the tubes on the undersurface of the cap are separate from each other"@en ;
	dc:source	pwn30:13053187-n .

<i105320>	a	<Concept> ;
	skos:definition	"fungi having each pore separate though crowded"@en ;
	dc:source	pwn30:13053450-n .

<i105321>	a	<Concept> ;
	skos:definition	"a popular edible fungus with a cap the color of liver or raw meat; abundant in southeastern United States"@en ;
	dc:source	pwn30:13053608-n .

<i105322>	a	<Concept> ;
	skos:definition	"genus of bracket fungi forming corky or woody perennial shelflike sporophores often of large size; includes some that cause destructive heartrot in trees"@en ;
	dc:source	pwn30:13053816-n .

<i105323>	a	<Concept> ;
	skos:definition	"fungus used in the preparation of punk for fuses"@en ;
	dc:source	pwn30:13054073-n .

<i105324>	a	<Concept> ;
	skos:definition	"family of fleshy fungi having the germ pores easily separating from the cup and often from each other"@en ;
	dc:source	pwn30:13054211-n .

<i105325>	a	<Concept> ;
	skos:definition	"any fungus of the family Boletaceae"@en ;
	dc:source	pwn30:13054560-n .

<i105326>	a	<Concept> ;
	skos:definition	"type genus of Boletaceae; genus of soft early-decaying pore fungi; some poisonous and some edible"@en ;
	dc:source	pwn30:13055009-n .

<i105327>	a	<Concept> ;
	skos:definition	"a fungus convex cap and a dingy yellow under surface and a dry stalk"@en ;
	dc:source	pwn30:13055423-n .

<i105328>	a	<Concept> ;
	skos:definition	"an edible and choice fungus; has a convex cap that is slightly viscid when fresh and moist but soon dries and a thick bulbous tan stalk"@en ;
	dc:source	pwn30:13055577-n .

<i105329>	a	<Concept> ;
	skos:definition	"a fungus with a red cap and a red coarsely reticulate stalk"@en ;
	dc:source	pwn30:13055792-n .

<i105330>	a	<Concept> ;
	skos:definition	"a poisonous fungus with a dingy yellow cap and orange red undersurface and a cylindrical reticulate stalk"@en ;
	dc:source	pwn30:13055949-n .

<i105331>	a	<Concept> ;
	skos:definition	"a fungus that is edible when young and fresh; has a dark brown convex cap with a yellow to greenish under surface and reddish stalk"@en ;
	dc:source	pwn30:13056135-n .

<i105332>	a	<Concept> ;
	skos:definition	"a fungus that has an off-white cap when it is young but later becomes dingy brown and a stalk of the same color; the under surface of the cap (the tubes) a pale greenish yellow"@en ;
	dc:source	pwn30:13056349-n .

<i105333>	a	<Concept> ;
	skos:definition	"a beautiful but poisonous bolete; has a brown cap with a scarlet pore surface and a thick reticulate stalk"@en ;
	dc:source	pwn30:13056607-n .

<i105334>	a	<Concept> ;
	skos:definition	"an edible fungus with a broadly convex blackish brown cap and a pore surface that is yellow when young and darkens with age; stalk is thick and enlarges toward the base"@en ;
	dc:source	pwn30:13056799-n .

<i105335>	a	<Concept> ;
	skos:definition	"a fungus with a rusty red cap and a white pore surface that becomes yellow with age and a pale yellow stalk"@en ;
	dc:source	pwn30:13057054-n .

<i105336>	a	<Concept> ;
	skos:definition	"a fungus with a velvety stalk and usually a dingy brown cap; injured areas turn blue instantly"@en ;
	dc:source	pwn30:13057242-n .

<i105337>	a	<Concept> ;
	skos:definition	"an edible (but not choice) fungus found on soil under hardwoods; has a dry convex cap with whitish under surface and a reticulate stalk"@en ;
	dc:source	pwn30:13057422-n .

<i105338>	a	<Concept> ;
	skos:definition	"an edible and choice fungus that has a brown cap with greenish yellow under surface and a stalk that become dull red with age"@en ;
	dc:source	pwn30:13057639-n .

<i105339>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Boletaceae"@en ;
	dc:source	pwn30:13057845-n .

<i105340>	a	<Concept> ;
	skos:definition	"an edible fungus with a pinkish purple cap and stalk and a pore surface that is yellow with large angular pores that become like gills in maturity"@en ;
	dc:source	pwn30:13058037-n .

<i105341>	a	<Concept> ;
	skos:definition	"an edible fungus with a broadly convex brown cap and a whitish pore surface and stalk"@en ;
	dc:source	pwn30:13058272-n .

<i105342>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Boletaceae"@en ;
	dc:source	pwn30:13058447-n .

<i105343>	a	<Concept> ;
	skos:definition	"an edible fungus with a dark reddish brown cap and a wide light tan stalk that expands toward the base"@en ;
	dc:source	pwn30:13058608-n .

<i105344>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Boletaceae"@en ;
	dc:source	pwn30:13058796-n .

<i105345>	a	<Concept> ;
	skos:definition	"a fungus with a broadly convex brown cap and pores that extend part way down the stalk"@en ;
	dc:source	pwn30:13058963-n .

<i105346>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Boletaceae"@en ;
	dc:source	pwn30:13059139-n .

<i105347>	a	<Concept> ;
	skos:definition	"a short squat edible fungus with a reddish brown cap and white stalk; fruits under pines in the spring"@en ;
	dc:source	pwn30:13059298-n .

<i105348>	a	<Concept> ;
	skos:definition	"fungi similar to Boletus but with a shaggy scaly cap"@en ;
	dc:source	pwn30:13059485-n .

<i105349>	a	<Concept> ;
	skos:definition	"edible mild-tasting mushroom found in coniferous woodlands of eastern North America"@en ;
	dc:source	pwn30:13059657-n .

<i105350>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Boletaceae"@en ;
	dc:source	pwn30:13059852-n .

<i105351>	a	<Concept> ;
	skos:definition	"a fungus with a long coarsely shaggy reticulate stalk and a rimose areolate cap surface"@en ;
	dc:source	pwn30:13060017-n .

<i105352>	a	<Concept> ;
	skos:definition	"any fungus of the order Tremellales or Auriculariales whose fruiting body is jellylike in consistency when fresh"@en ;
	dc:source	pwn30:13060190-n .

<i105353>	a	<Concept> ;
	skos:definition	"fungi varying from gelatinous to waxy or even horny in texture; most are saprophytic"@en ;
	dc:source	pwn30:13060451-n .

<i105354>	a	<Concept> ;
	skos:definition	"a family of basidiomycetous fungi of the order Tremellales that have the basidium divided longitudinally"@en ;
	dc:source	pwn30:13060689-n .

<i105355>	a	<Concept> ;
	skos:definition	"fungi with yellowish gelatinous sporophores having convolutions resembling those of the brain"@en ;
	dc:source	pwn30:13060912-n .

<i105356>	a	<Concept> ;
	skos:definition	"popular in China and Japan and Taiwan; gelatinous mushrooms; most are dried"@en ;
	dc:source	pwn30:13061172-n .

<i105357>	a	<Concept> ;
	skos:definition	"a yellow jelly fungus"@en ;
	dc:source	pwn30:13061348-n .

<i105358>	a	<Concept> ;
	skos:definition	"a jelly fungus with a fruiting body 5-15 cm broad and gelatinous in consistency; resembles a bunch of leaf lettuce; mostly water and brownish in color"@en ;
	dc:source	pwn30:13061471-n .

<i105359>	a	<Concept> ;
	skos:definition	"a jelly fungus with an erect whitish fruiting body and a highly variable shape (sometimes resembling coral fungi)"@en ;
	dc:source	pwn30:13061704-n .

<i105360>	a	<Concept> ;
	skos:definition	"coextensive with the family Auriculariaceae; sometimes included in the order Tremellales"@en ;
	dc:source	pwn30:13061921-n .

<i105361>	a	<Concept> ;
	skos:definition	"fungi having gelatinous sporophores"@en ;
	dc:source	pwn30:13062112-n .

<i105362>	a	<Concept> ;
	skos:definition	"type genus of the Auriculariaceae"@en ;
	dc:source	pwn30:13062272-n .

<i105363>	a	<Concept> ;
	skos:definition	"widely distributed edible fungus shaped like a human ear and growing on decaying wood"@en ;
	dc:source	pwn30:13062421-n .

<i105364>	a	<Concept> ;
	skos:definition	"a family of basidiomycetous fungi belonging to the order Tremellales having a bifurcate basidium that lacks septa"@en ;
	dc:source	pwn30:13062630-n .

<i105365>	a	<Concept> ;
	skos:definition	"type genus of the Dacrymycetaceae: fungi with a bifurcate basidium that lacks septa"@en ;
	dc:source	pwn30:13062868-n .

<i105366>	a	<Concept> ;
	skos:definition	"rust fungi: parasitic fungi causing rust in plants; sometimes placed in"@en ;
	dc:source	pwn30:13063046-n .

<i105367>	a	<Concept> ;
	skos:definition	"any of various fungi causing rust disease in plants"@en ;
	dc:source	pwn30:13063269-n .

<i105368>	a	<Concept> ;
	skos:definition	"fruiting body of some rust fungi bearing chains of aeciospores"@en ;
	dc:source	pwn30:13063514-n .

<i105369>	a	<Concept> ;
	skos:definition	"spore of a rust fungus formed in an aecium"@en ;
	dc:source	pwn30:13063666-n .

<i105370>	a	<Concept> ;
	skos:definition	"rust fungi"@en ;
	dc:source	pwn30:13063784-n .

<i105371>	a	<Concept> ;
	skos:definition	"rusts having sessile one-celled teliospores in a single layer"@en ;
	dc:source	pwn30:13063936-n .

<i105372>	a	<Concept> ;
	skos:definition	"fungus causing flax rust"@en ;
	dc:source	pwn30:13064111-n .

<i105373>	a	<Concept> ;
	skos:definition	"rust fungi having aecia produced in raised or swollen sori and teliospores borne in waxy columns"@en ;
	dc:source	pwn30:13064247-n .

<i105374>	a	<Concept> ;
	skos:definition	"fungus causing white pine blister rust and having a complex life cycle requiring a plant of genus Ribes as alternate host"@en ;
	dc:source	pwn30:13064457-n .

<i105375>	a	<Concept> ;
	skos:definition	"large important family of rust fungi"@en ;
	dc:source	pwn30:13064678-n .

<i105376>	a	<Concept> ;
	skos:definition	"type genus of the Pucciniaceae; a large genus of parasitic fungi including many that are destructive to various economic plants"@en ;
	dc:source	pwn30:13064852-n .

<i105377>	a	<Concept> ;
	skos:definition	"rust fungus that attacks wheat"@en ;
	dc:source	pwn30:13065089-n .

<i105378>	a	<Concept> ;
	skos:definition	"genus of fungi that produce galls on cedars and other conifers of genera Juniperus and Libocedrus and causes rust spots on apples and pears and other plants of family Rosaceae"@en ;
	dc:source	pwn30:13065215-n .

<i105379>	a	<Concept> ;
	skos:definition	"rust fungus causing rust spots on apples and pears etc"@en ;
	dc:source	pwn30:13065514-n .

<i105380>	a	<Concept> ;
	skos:definition	"category used in some systems to comprise the two orders Ustilaginales (smuts) and Uredinales (rusts)"@en ;
	dc:source	pwn30:13065702-n .

