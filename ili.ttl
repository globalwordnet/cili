	dc:source	pwn30:05478336-n .

<i65739>	a	<Concept> ;
	skos:definition	"supplies extrinsic muscles of the eye"@en ;
	dc:source	pwn30:05478526-n .

<i65740>	a	<Concept> ;
	skos:definition	"either of the two cranial nerves on either side that control the superior oblique muscles of the eyes"@en ;
	dc:source	pwn30:05478684-n .

<i65741>	a	<Concept> ;
	skos:definition	"the main sensory nerve of the face and motor nerve for the muscles of mastication"@en ;
	dc:source	pwn30:05478896-n .

<i65742>	a	<Concept> ;
	skos:definition	"a small motor nerve supplying the lateral rectus muscle of the eye"@en ;
	dc:source	pwn30:05479108-n .

<i65743>	a	<Concept> ;
	skos:definition	"cranial nerve that supplies facial muscles"@en ;
	dc:source	pwn30:05479314-n .

<i65744>	a	<Concept> ;
	skos:definition	"a composite sensory nerve supplying the hair cells of the vestibular organ and the hair cells of the cochlea"@en ;
	dc:source	pwn30:05479503-n .

<i65745>	a	<Concept> ;
	skos:definition	"sensory nerve to the pharynx and back of the tongue; motor fibers innervate muscles that elevate the pharynx and larynx; includes parasympathetic fibers to the otic ganglion"@en ;
	dc:source	pwn30:05479786-n .

<i65746>	a	<Concept> ;
	skos:definition	"a mixed nerve that supplies the pharynx and larynx and lungs and heart and esophagus and stomach and most of the abdominal viscera"@en ;
	dc:source	pwn30:05480076-n .

<i65747>	a	<Concept> ;
	skos:definition	"arises from two sets of roots (cranial and spinal) that unite to form the nerve"@en ;
	dc:source	pwn30:05480401-n .

<i65748>	a	<Concept> ;
	skos:definition	"supplies intrinsic muscles of the tongue and other tongue muscles"@en ;
	dc:source	pwn30:05480607-n .

<i65749>	a	<Concept> ;
	skos:definition	"the portion of the vertebrate nervous system consisting of the brain and spinal cord"@en ;
	dc:source	pwn30:05480794-n .

<i65750>	a	<Concept> ;
	skos:definition	"that part of the central nervous system that includes all the higher nervous centers; enclosed within the skull; continuous with the spinal cord"@en ;
	dc:source	pwn30:05481095-n .

<i65751>	a	<Concept> ;
	skos:definition	"the part of the brain having the most recent phylogenetic origin; the cerebral cortex and related parts"@en ;
	dc:source	pwn30:05481549-n .

<i65752>	a	<Concept> ;
	skos:definition	"the cortical part of the neencephalon"@en ;
	dc:source	pwn30:05481746-n .

<i65753>	a	<Concept> ;
	skos:definition	"the olfactory cortex of the cerebrum"@en ;
	dc:source	pwn30:05481870-n .

<i65754>	a	<Concept> ;
	skos:definition	"the part of the hindbrain that develops into the pons and the cerebellum"@en ;
	dc:source	pwn30:05481997-n .

<i65755>	a	<Concept> ;
	skos:definition	"the more primitive parts of the brain phylogenetically; most structures other than the cerebral cortex"@en ;
	dc:source	pwn30:05482129-n .

<i65756>	a	<Concept> ;
	skos:definition	"the two innermost layers of the meninges; cerebrospinal fluid circulates between these innermost layers"@en ;
	dc:source	pwn30:05482328-n .

<i65757>	a	<Concept> ;
	skos:definition	"the outermost (and toughest) of the 3 meninges"@en ;
	dc:source	pwn30:05482529-n .

<i65758>	a	<Concept> ;
	skos:definition	"the middle of the 3 meninges"@en ;
	dc:source	pwn30:05482676-n .

<i65759>	a	<Concept> ;
	skos:definition	"the highly vascular innermost of the 3 meninges"@en ;
	dc:source	pwn30:05482800-n .

<i65760>	a	<Concept> ;
	skos:definition	"a space in the meninges beneath the arachnoid membrane and above the pia mater that contains the cerebrospinal fluid"@en ;
	dc:source	pwn30:05482922-n .

<i65761>	a	<Concept> ;
	skos:definition	"the complex network of unmyelinated axones, dendrites, and glial branches that form the bulk of the central nervous system's grey matter and in which nerve cell bodies are embedded"@en ;
	dc:source	pwn30:05483122-n .

<i65762>	a	<Concept> ;
	skos:definition	"greyish nervous tissue containing cell bodies as well as fibers; forms the cerebral cortex consisting of unmyelinated neurons"@en ;
	dc:source	pwn30:05483388-n .

<i65763>	a	<Concept> ;
	skos:definition	"whitish nervous tissue of the CNS consisting of neurons and their myelin sheaths"@en ;
	dc:source	pwn30:05483677-n .

<i65764>	a	<Concept> ;
	skos:definition	"the master gland of the endocrine system; located at the base of the brain"@en ;
	dc:source	pwn30:05483890-n .

<i65765>	a	<Concept> ;
	skos:definition	"the funnel-shaped stalk connecting the pituitary gland to the hypothalamus"@en ;
	dc:source	pwn30:05484198-n .

<i65766>	a	<Concept> ;
	skos:definition	"the anterior lobe of the pituitary body; primarily glandular in nature"@en ;
	dc:source	pwn30:05484355-n .

<i65767>	a	<Concept> ;
	skos:definition	"the anterior part of the anterior pituitary"@en ;
	dc:source	pwn30:05484573-n .

<i65768>	a	<Concept> ;
	skos:definition	"a thin piece of tissue that has become part of the posterior pituitary"@en ;
	dc:source	pwn30:05484711-n .

<i65769>	a	<Concept> ;
	skos:definition	"the posterior lobe of the pituitary body; primarily glandular in nature"@en ;
	dc:source	pwn30:05484862-n .

<i65770>	a	<Concept> ;
	skos:definition	"a small endocrine gland in the brain; situated beneath the back part of the corpus callosum; secretes melatonin"@en ;
	dc:source	pwn30:05485098-n .

<i65771>	a	<Concept> ;
	skos:definition	"cell clusters in the pancreas that form the endocrine part of that organ; secrete insulin and other hormones"@en ;
	dc:source	pwn30:05485314-n .

<i65772>	a	<Concept> ;
	skos:definition	"a major division of the vertebrate brain; situated above the medulla oblongata and beneath the cerebrum in humans"@en ;
	dc:source	pwn30:05485554-n .

<i65773>	a	<Concept> ;
	skos:definition	"either of two lateral lobes of the cerebellum"@en ;
	dc:source	pwn30:05485856-n .

<i65774>	a	<Concept> ;
	skos:definition	"a large laminar nucleus of grey matter within the white matter of each cerebral hemisphere"@en ;
	dc:source	pwn30:05485988-n .

<i65775>	a	<Concept> ;
	skos:definition	"the narrow central part of the cerebellum between the two hemispheres"@en ;
	dc:source	pwn30:05486159-n .

<i65776>	a	<Concept> ;
	skos:definition	"the anterior lobe of the cerebellum which was one of the earliest parts of the hindbrain to develop in mammals"@en ;
	dc:source	pwn30:05486319-n .

<i65777>	a	<Concept> ;
	skos:definition	"the layer of unmyelinated neurons (the grey matter) forming the cortex of the cerebrum"@en ;
	dc:source	pwn30:05486510-n .

<i65778>	a	<Concept> ;
	skos:definition	"any of various regions of the cerebral cortex"@en ;
	dc:source	pwn30:05486920-n .

<i65779>	a	<Concept> ;
	skos:definition	"cortical areas that are neither motor or sensory but are thought to be involved in higher processing of information"@en ;
	dc:source	pwn30:05487224-n .

<i65780>	a	<Concept> ;
	skos:definition	"one of four small oval masses that protrude slightly from the underside of the thalamus and function as synaptic centers on the way to the cerebral cortex"@en ;
	dc:source	pwn30:05487423-n .

<i65781>	a	<Concept> ;
	skos:definition	"a neural structure that serves as a processing station on the way from the retina to the occipital lobe of the cerebral cortex"@en ;
	dc:source	pwn30:05487694-n .

<i65782>	a	<Concept> ;
	skos:definition	"a neural structure that serves as the last of a series of processing centers along the auditory pathway from the cochlea to the temporal lobe of the cerebral cortex"@en ;
	dc:source	pwn30:05487941-n .

<i65783>	a	<Concept> ;
	skos:definition	"the cortical area that receives auditory information from the medial geniculate body"@en ;
	dc:source	pwn30:05488223-n .

<i65784>	a	<Concept> ;
	skos:definition	"the motor speech center in the left hemisphere of the brain in most people"@en ;
	dc:source	pwn30:05488385-n .

<i65785>	a	<Concept> ;
	skos:definition	"one of the cortical areas mapped out on the basis of its cytoarchitecture"@en ;
	dc:source	pwn30:05488615-n .

<i65786>	a	<Concept> ;
	skos:definition	"any of the convolutions of the outer surface of the frontal lobe of the cerebrum"@en ;
	dc:source	pwn30:05488750-n .

<i65787>	a	<Concept> ;
	skos:definition	"any of the convolutions of the outer surface of the temporal lobe of the cerebrum"@en ;
	dc:source	pwn30:05488909-n .

<i65788>	a	<Concept> ;
	skos:definition	"any of the convolutions of the outer surface of the parietal lobe of the cerebrum"@en ;
	dc:source	pwn30:05489070-n .

<i65789>	a	<Concept> ;
	skos:definition	"any of the convolutions of the outer surface of the occipital lobe of the cerebrum"@en ;
	dc:source	pwn30:05489231-n .

<i65790>	a	<Concept> ;
	skos:definition	"a large cortical area (in the left hemisphere in most people) containing all the centers associated with language"@en ;
	dc:source	pwn30:05489394-n .

<i65791>	a	<Concept> ;
	skos:definition	"the cortical area that influences motor movements"@en ;
	dc:source	pwn30:05489640-n .

<i65792>	a	<Concept> ;
	skos:definition	"the areas of the brain that process and register incoming sensory information and make possible the conscious awareness of the world"@en ;
	dc:source	pwn30:05489810-n .

<i65793>	a	<Concept> ;
	skos:definition	"an area of the cortex including the precentral gyrus and the postcentral gyrus and combining sensory and motor functions"@en ;
	dc:source	pwn30:05489998-n .

<i65794>	a	<Concept> ;
	skos:definition	"the cortical area that receives information from the lateral geniculate body of the thalamus"@en ;
	dc:source	pwn30:05490204-n .

<i65795>	a	<Concept> ;
	skos:definition	"the auditory word center; located in the posterior part of the superior temporal convolution in most people"@en ;
	dc:source	pwn30:05490370-n .

<i65796>	a	<Concept> ;
	skos:definition	"the tissue forming the outer layer of an organ or structure in plant or animal"@en ;
	dc:source	pwn30:05490578-n .

<i65797>	a	<Concept> ;
	skos:definition	"the inner part of an organ or structure in plant or animal"@en ;
	dc:source	pwn30:05490799-n .

<i65798>	a	<Concept> ;
	skos:definition	"the cortex of the adrenal gland; secretes corticosterone and sex hormones"@en ;
	dc:source	pwn30:05490983-n .

<i65799>	a	<Concept> ;
	skos:definition	"the cortex of the kidney containing the glomeruli and the convoluted tubules"@en ;
	dc:source	pwn30:05491154-n .

<i65800>	a	<Concept> ;
	skos:definition	"the medulla of the adrenal gland; secretes epinephrine"@en ;
	dc:source	pwn30:05491308-n .

<i65801>	a	<Concept> ;
	skos:definition	"a broad transverse nerve tract connecting the two cerebral hemispheres"@en ;
	dc:source	pwn30:05491461-n .

<i65802>	a	<Concept> ;
	skos:definition	"any of the important motor nerves on each side of the central nervous system that run from the sensorimotor areas of the cortex through the brainstem to motor neurons of the cranial nerve nuclei and the ventral root of the spinal cord"@en ;
	dc:source	pwn30:05491612-n .

<i65803>	a	<Concept> ;
	skos:definition	"anterior portion of the brain consisting of two hemispheres; dominant part of the brain in humans"@en ;
	dc:source	pwn30:05491993-n .

<i65804>	a	<Concept> ;
	skos:definition	"a folded part (as in skin or muscle)"@en ;
	dc:source	pwn30:05492259-n .

<i65805>	a	<Concept> ;
	skos:definition	"a convex fold or elevation in the surface of the brain"@en ;
	dc:source	pwn30:05492426-n .

<i65806>	a	<Concept> ;
	skos:definition	"either of two gyri on either side of the central sulcus"@en ;
	dc:source	pwn30:05492655-n .

<i65807>	a	<Concept> ;
	skos:definition	"the convolution of the frontal lobe that is bounded in back by the central sulcus and that contains the motor area"@en ;
	dc:source	pwn30:05492806-n .

<i65808>	a	<Concept> ;
	skos:definition	"the external surface of the body overlying the heart and stomach"@en ;
	dc:source	pwn30:05493002-n .

<i65809>	a	<Concept> ;
	skos:definition	"the convolution of parietal lobe that is bounded in front by the central sulcus"@en ;
	dc:source	pwn30:05493141-n .

<i65810>	a	<Concept> ;
	skos:definition	"(anatomy) a somewhat rounded subdivision of a bodily organ or part"@en ;
	dc:source	pwn30:05493303-n .

<i65811>	a	<Concept> ;
	skos:definition	"a small lobe or subdivision of a lobe"@en ;
	dc:source	pwn30:05493650-n .

<i65812>	a	<Concept> ;
	skos:definition	"that part of the cerebral cortex in either hemisphere of the brain lying directly behind the forehead"@en ;
	dc:source	pwn30:05493758-n .

<i65813>	a	<Concept> ;
	skos:definition	"the anterior part of the frontal lobe"@en ;
	dc:source	pwn30:05493992-n .

<i65814>	a	<Concept> ;
	skos:definition	"that part of the cerebral cortex in either hemisphere of the brain lying below the crown of the head"@en ;
	dc:source	pwn30:05494130-n .

<i65815>	a	<Concept> ;
	skos:definition	"that part of the cerebral cortex in either hemisphere of the brain lying in the back of the head"@en ;
	dc:source	pwn30:05494365-n .

<i65816>	a	<Concept> ;
	skos:definition	"the part of the occipital cortex that receives the fibers of the optic radiation from the lateral geniculate body and is the primary receptive area for vision"@en ;
	dc:source	pwn30:05494617-n .

<i65817>	a	<Concept> ;
	skos:definition	"that part of the cerebral cortex in either hemisphere of the brain lying inside the temples of the head"@en ;
	dc:source	pwn30:05494933-n .

<i65818>	a	<Concept> ;
	skos:definition	"lower or hindmost part of the brain; continuous with spinal cord; (`bulb' is an old term for medulla oblongata)"@en ;
	dc:source	pwn30:05495172-n .

<i65819>	a	<Concept> ;
	skos:definition	"an almond-shaped neural structure in the anterior part of the temporal lobe of the cerebrum; intimately connected with the hypothalamus and the hippocampus and the cingulate gyrus; as part of the limbic system it plays an important role in motivation and emotional behavior"@en ;
	dc:source	pwn30:05495571-n .

<i65820>	a	<Concept> ;
	skos:definition	"the anterior portion of the brain; the part of the brain that develops from the anterior part of the neural tube"@en ;
	dc:source	pwn30:05495981-n .

<i65821>	a	<Concept> ;
	skos:definition	"a complex neural structure (shaped like a sea horse) consisting of grey matter and located on the floor of each lateral ventricle; intimately involved in motivation and emotion as part of the limbic system; has a central role in the formation of memories"@en ;
	dc:source	pwn30:05496261-n .

<i65822>	a	<Concept> ;
	skos:definition	"a long curved structure on the medial surface of the cerebral hemispheres; the cortical part of the limbic system"@en ;
	dc:source	pwn30:05496592-n .

<i65823>	a	<Concept> ;
	skos:definition	"the anterior division of the forebrain; the cerebrum and related parts of the hypothalamus"@en ;
	dc:source	pwn30:05496802-n .

<i65824>	a	<Concept> ;
	skos:definition	"the posterior division of the forebrain; connects the cerebral hemispheres with the mesencephalon"@en ;
	dc:source	pwn30:05496990-n .

<i65825>	a	<Concept> ;
	skos:definition	"any of several masses of subcortical grey matter at the base of each cerebral hemisphere that seem to be involved in the regulation of voluntary movement"@en ;
	dc:source	pwn30:05497363-n .

<i65826>	a	<Concept> ;
	skos:definition	"a tail-shaped basal ganglion located in a lateral ventricle of the brain"@en ;
	dc:source	pwn30:05497741-n .

<i65827>	a	<Concept> ;
	skos:definition	"a layer of grey matter in the brain adjacent to the lenticular nucleus"@en ;
	dc:source	pwn30:05497922-n .

<i65828>	a	<Concept> ;
	skos:definition	"a basal ganglion shaped like a lens and including the outer reddish putamen and the inner pale yellow pallidum"@en ;
	dc:source	pwn30:05498048-n .

<i65829>	a	<Concept> ;
	skos:definition	"the inner pale yellow part of the lenticular nucleus"@en ;
	dc:source	pwn30:05498300-n .

<i65830>	a	<Concept> ;
	skos:definition	"the outer reddish part of the lenticular nucleus"@en ;
	dc:source	pwn30:05498460-n .

<i65831>	a	<Concept> ;
	skos:definition	"an oval mass of grey matter located in the caudal part of the subthalamus; associated with the striate body"@en ;
	dc:source	pwn30:05498581-n .

<i65832>	a	<Concept> ;
	skos:definition	"a system of functionally related neural structures in the brain that are involved in emotional behavior"@en ;
	dc:source	pwn30:05498773-n .

<i65833>	a	<Concept> ;
	skos:definition	"the ventral part of the thalamus"@en ;
	dc:source	pwn30:05499044-n .

<i65834>	a	<Concept> ;
	skos:definition	"large egg-shaped structures of grey matter that form the dorsal subdivision of the diencephalon"@en ;
	dc:source	pwn30:05499172-n .

<i65835>	a	<Concept> ;
	skos:definition	"a basal part of the diencephalon governing autonomic nervous system"@en ;
	dc:source	pwn30:05499379-n .

<i65836>	a	<Concept> ;
	skos:definition	"a striped mass of white and grey matter located in front of the thalamus in each cerebral hemisphere; consists of the caudate nucleus and the lenticular nucleus"@en ;
	dc:source	pwn30:05499542-n .

<i65837>	a	<Concept> ;
	skos:definition	"the middle portion of the brain"@en ;
	dc:source	pwn30:05499828-n .

<i65838>	a	<Concept> ;
	skos:definition	"a layer of deeply pigmented grey matter in the midbrain; associated with the striate body; is involved in metabolic disturbances associated with Parkinson's disease and with Huntington's disease"@en ;
	dc:source	pwn30:05500006-n .

<i65839>	a	<Concept> ;
	skos:definition	"an essential visual center between the retina and the striate cortex"@en ;
	dc:source	pwn30:05500312-n .

<i65840>	a	<Concept> ;
	skos:definition	"an essential auditory center in the midbrain"@en ;
	dc:source	pwn30:05500465-n .

<i65841>	a	<Concept> ;
	skos:definition	"the posterior portion of the brain including cerebellum and brainstem"@en ;
	dc:source	pwn30:05500594-n .

<i65842>	a	<Concept> ;
	skos:definition	"the posterior part of the hindbrain in developing vertebrates; forms the medulla oblongata in adults"@en ;
	dc:source	pwn30:05500812-n .

<i65843>	a	<Concept> ;
	skos:definition	"a band of nerve fibers linking the medulla oblongata and the cerebellum with the midbrain"@en ;
	dc:source	pwn30:05500992-n .

<i65844>	a	<Concept> ;
	skos:definition	"the part of the brain continuous with the spinal cord and comprising the medulla oblongata and pons and midbrain and parts of the hypothalamus"@en ;
	dc:source	pwn30:05501185-n .

<i65845>	a	<Concept> ;
	skos:definition	"any fine network (especially one in the body composed of cells or blood vessels)"@en ;
	dc:source	pwn30:05501485-n .

<i65846>	a	<Concept> ;
	skos:definition	"any network of neurons or nuclei that function together to perform some function in the body"@en ;
	dc:source	pwn30:05501711-n .

<i65847>	a	<Concept> ;
	skos:definition	"any histologically identifiable mass of neural cell bodies in the brain or spinal cord"@en ;
	dc:source	pwn30:05501932-n .

<i65848>	a	<Concept> ;
	skos:definition	"a complex neural network in the central core of the brainstem; monitors the state of the body and functions in such processes as arousal and sleep and attention and muscle tone"@en ;
	dc:source	pwn30:05502090-n .

<i65849>	a	<Concept> ;
	skos:definition	"the network in the reticular formation that serves an alerting or arousal function"@en ;
	dc:source	pwn30:05502375-n .

<i65850>	a	<Concept> ;
	skos:definition	"one of four connected cavities in the brain; is continuous with the central canal of the spinal cord and contains cerebrospinal fluid"@en ;
	dc:source	pwn30:05502556-n .

<i65851>	a	<Concept> ;
	skos:definition	"an irregular ventricle between the third ventricle and the central canal of the spinal cord"@en ;
	dc:source	pwn30:05502855-n .

<i65852>	a	<Concept> ;
	skos:definition	"a narrow ventricle in the midplane below the corpus callosum; communicates with the fourth ventricle via the Sylvian aqueduct"@en ;
	dc:source	pwn30:05503009-n .

<i65853>	a	<Concept> ;
	skos:definition	"either of two horseshoe-shaped ventricles one in each cerebral hemisphere; they communicate with the third ventricle via the foramen of Monro"@en ;
	dc:source	pwn30:05503196-n .

<i65854>	a	<Concept> ;
	skos:definition	"a canal connecting the third and fourth ventricles"@en ;
	dc:source	pwn30:05503401-n .

<i65855>	a	<Concept> ;
	skos:definition	"a radial arrangement of nerve fibers connecting different parts of the brain"@en ;
	dc:source	pwn30:05503555-n .

<i65856>	a	<Concept> ;
	skos:definition	"a major part of the central nervous system which conducts sensory and motor nerve impulses to and from the brain; a long tubelike structure extending from the base of the brain through the vertebral canal to the upper lumbar region"@en ;
	dc:source	pwn30:05503705-n .

<i65857>	a	<Concept> ;
	skos:definition	"clear liquid produced in the ventricles of the brain; fills and protects cavities in the brain and spinal cord"@en ;
	dc:source	pwn30:05504107-n .

<i65858>	a	<Concept> ;
	skos:definition	"the section of the nervous system lying outside the brain and spinal cord"@en ;
	dc:source	pwn30:05504336-n .

<i65859>	a	<Concept> ;
	skos:definition	"the part of the nervous system of vertebrates that controls involuntary actions of the smooth muscles and heart and glands"@en ;
	dc:source	pwn30:05504532-n .

<i65860>	a	<Concept> ;
	skos:definition	"largest branch of the brachial plexus; extends down the humerus to the lateral epicondyle where it divides into one branch that goes to the skin on the back of the hand and another that goes to the underlying extensor muscles"@en ;
	dc:source	pwn30:05504807-n .

<i65861>	a	<Concept> ;
	skos:definition	"originates in the thoracic regions of the spinal cord; opposes physiological effects of the parasympathetic: reduces digestive secretions; speeds the heart; contracts blood vessels"@en ;
	dc:source	pwn30:05505131-n .

<i65862>	a	<Concept> ;
	skos:definition	"any of several nerves of the sympathetic part of the autonomic nervous system that innervate viscera and blood vessels"@en ;
	dc:source	pwn30:05505479-n .

<i65863>	a	<Concept> ;
	skos:definition	"originates in the brain stem and lower part of the spinal cord; opposes physiological effects of the sympathetic nervous system: stimulates digestive secretions; slows the heart; constricts the pupils; dilates blood vessels"@en ;
	dc:source	pwn30:05505679-n .

<i65864>	a	<Concept> ;
	skos:definition	"a network of nerves formed by cervical and thoracic spinal nerves and supplying the arm and parts of the shoulder"@en ;
	dc:source	pwn30:05506034-n .

<i65865>	a	<Concept> ;
	skos:definition	"a plexus of nerves supplying the heart and nearby structures"@en ;
	dc:source	pwn30:05506229-n .

<i65866>	a	<Concept> ;
