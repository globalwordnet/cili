	dc:source	pwn30:06556150-n .

<i70917>	a	<Concept> ;
	skos:definition	"a writ ordering that land be restored to its rightful owner"@en ;
	dc:source	pwn30:06556343-n .

<i70918>	a	<Concept> ;
	skos:definition	"a document giving an official instruction or command"@en ;
	dc:source	pwn30:06556481-n .

<i70919>	a	<Concept> ;
	skos:definition	"a writ issued by authority of law; usually compels the defendant's attendance in a civil suit; failure to appear results in a default judgment against the defendant"@en ;
	dc:source	pwn30:06556692-n .

<i70920>	a	<Concept> ;
