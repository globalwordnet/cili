	dc:source	pwn30:00791527-n .

<i39569>	a	<Concept> ;
	skos:definition	"an assay that relies on an enzymatic conversion reaction and is used to detect the presence of specific substances (such as enzymes or viruses or antibodies or bacteria)"@en ;
	dc:source	pwn30:00791875-n .

<i39570>	a	<Concept> ;
