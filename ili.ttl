	dc:source	pwn30:05908520-n .

<i67889>	a	<Concept> ;
	skos:definition	"a derogatory reference to priests who use their influence to control secular or political affairs"@en ;
	dc:source	pwn30:05908727-n .

<i67890>	a	<Concept> ;
	skos:definition	"a plot to carry out some harmful or illegal act (especially a political plot)"@en ;
	dc:source	pwn30:05908882-n .

