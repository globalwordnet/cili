	dc:source	pwn30:06470922-n .

<i70463>	a	<Concept> ;
	skos:definition	"a document entitling a commissioned officer to hold a higher rank temporarily (but without higher pay)"@en ;
	dc:source	pwn30:06471069-n .

<i70464>	a	<Concept> ;
