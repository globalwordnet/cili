	skos:definition	"the science of analyzing and deciphering codes and ciphers and cryptograms"@en ;
	dc:source	pwn30:06172502-n .

<i68991>	a	<Concept> ;
	skos:definition	"the scientific study of language"@en ;
	dc:source	pwn30:06172789-n .

<i68992>	a	<Concept> ;
	skos:definition	"the branch of linguistics that deals with syntax and morphology (and sometimes also deals with semantics)"@en ;
	dc:source	pwn30:06174404-n .

<i68993>	a	<Concept> ;
