	dc:source	pwn30:14196543-n .

<i111499>	a	<Concept> ;
	skos:definition	"neutropenia that occurs periodically"@en ;
	dc:source	pwn30:14196722-n .

<i111500>	a	<Concept> ;
	skos:definition	"an abnormally small number of lymphocytes in the circulating blood"@en ;
	dc:source	pwn30:14196823-n .

<i111501>	a	<Concept> ;
	skos:definition	"an abnormal increase in the number of lymphocytes in the circulating blood"@en ;
	dc:source	pwn30:14196965-n .

<i111502>	a	<Concept> ;
	skos:definition	"a blood disorder characterized by the presence of microcytes (abnormally small red blood cells) in the blood; often associated with anemia"@en ;
	dc:source	pwn30:14197099-n .

<i111503>	a	<Concept> ;
	skos:definition	"a disorder characterized by an abnormal increase in the number of red blood cells in the blood"@en ;
	dc:source	pwn30:14197315-n .

<i111504>	a	<Concept> ;
	skos:definition	"any of several blood diseases causing subcutaneous bleeding"@en ;
	dc:source	pwn30:14197468-n .

<i111505>	a	<Concept> ;
	skos:definition	"purpura resulting from a defect in the capillaries caused by bacteria or drugs"@en ;
	dc:source	pwn30:14197628-n .

<i111506>	a	<Concept> ;
	skos:definition	"the primary form of thrombocytopenia (rather than a shortage of platelets caused by other conditions such as tuberculosis or chemical suppression of bone marrow etc.)"@en ;
	dc:source	pwn30:14197780-n .

<i111507>	a	<Concept> ;
	skos:definition	"a blood disease characterized by an abnormally small number of platelets in the blood"@en ;
	dc:source	pwn30:14198019-n .

<i111508>	a	<Concept> ;
	skos:definition	"any disease caused by a lack of an essential nutrient (as a vitamin or mineral)"@en ;
	dc:source	pwn30:14198200-n .

<i111509>	a	<Concept> ;
	skos:definition	"the presence of one or more cysts in a breast"@en ;
	dc:source	pwn30:14198380-n .

<i111510>	a	<Concept> ;
	skos:definition	"any of several diseases caused by deficiency of one or more vitamins"@en ;
	dc:source	pwn30:14198576-n .

