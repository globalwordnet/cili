	skos:definition	"brain surgery on human patients intended to relieve severe and otherwise intractable mental or behavioral problems"@en ;
	dc:source	pwn30:00667384-n .

<i38936>	a	<Concept> ;
	skos:definition	"brain surgery on animals in which the corpus callosum (and sometimes the optic chiasm) is severed so that communication between the cerebral hemispheres is interrupted"@en ;
	dc:source	pwn30:00667612-n .

<i38937>	a	<Concept> ;
	skos:definition	"surgical removal of the testes or ovaries (usually to inhibit hormone secretion in cases of breast cancer in women or prostate cancer in men)"@en ;
	dc:source	pwn30:00667847-n .

<i38938>	a	<Concept> ;
	skos:definition	"the act of coagulating blood and destroying tissue with a hot iron or caustic agent or by freezing"@en ;
	dc:source	pwn30:00668112-n .

<i38939>	a	<Concept> ;
	skos:definition	"use of chemical to destroy diseased or malignant tissue; used in treatment of skin cancer"@en ;
	dc:source	pwn30:00668404-n .

<i38940>	a	<Concept> ;
	skos:definition	"a surgical operation that creates an opening from the colon to the surface of the body to function as an anus"@en ;
	dc:source	pwn30:00668552-n .

<i38941>	a	<Concept> ;
	skos:definition	"a surgical opening through the skull"@en ;
	dc:source	pwn30:00668736-n .

<i38942>	a	<Concept> ;
	skos:definition	"the use of extreme cold (usually liquid nitrogen) to destroy unwanted tissue (warts or cataracts or skin cancers)"@en ;
	dc:source	pwn30:00668829-n .

<i38943>	a	<Concept> ;
	skos:definition	"surgical removal of the gall bladder (usually for relief of gallstone pain)"@en ;
	dc:source	pwn30:00669000-n .

<i38944>	a	<Concept> ;
	skos:definition	"excision of the clitoris"@en ;
	dc:source	pwn30:00669155-n .

<i38945>	a	<Concept> ;
	skos:definition	"removal of the gall bladder through small punctures in the abdomen to permit the insertion of a laparoscope and surgical instruments"@en ;
	dc:source	pwn30:00669262-n .

<i38946>	a	<Concept> ;
	skos:definition	"surgery to remove tissue or growths from a bodily cavity (as the uterus) by scraping with a curette"@en ;
	dc:source	pwn30:00669481-n .

<i38947>	a	<Concept> ;
	skos:definition	"a method of induced abortion; prior to the 14th week of gestation the embryo and placenta are removed by applying suction to the dilated cervix"@en ;
	dc:source	pwn30:00669687-n .

<i38948>	a	<Concept> ;
	skos:definition	"surgical removal of foreign material and dead tissue from a wound in order to prevent infection and promote healing"@en ;
	dc:source	pwn30:00669932-n .

<i38949>	a	<Concept> ;
	skos:definition	"removal of the outer covering of an organ or part"@en ;
	dc:source	pwn30:00670105-n .

<i38950>	a	<Concept> ;
	skos:definition	"a surgical procedure usually performed under local anesthesia in which the cervix is dilated and the endometrial lining of the uterus is scraped with a curet; performed to obtain tissue samples or to stop prolonged bleeding or to remove small tumors or to remove fragments of placenta after childbirth or as a method of abortion"@en ;
	dc:source	pwn30:00670250-n .

<i38951>	a	<Concept> ;
	skos:definition	"the act of removing the bowels or viscera; the act of cutting so as to cause the viscera to protrude"@en ;
	dc:source	pwn30:00670703-n .

<i38952>	a	<Concept> ;
	skos:definition	"surgery performed with electrical devices (as in electrocautery)"@en ;
	dc:source	pwn30:00670897-n .

<i38953>	a	<Concept> ;
	skos:definition	"surgical operation that creates a permanent opening through the abdominal wall into the intestine"@en ;
	dc:source	pwn30:00671022-n .

<i38954>	a	<Concept> ;
	skos:definition	"surgical removal of something without cutting into it"@en ;
	dc:source	pwn30:00671190-n .

<i38955>	a	<Concept> ;
	skos:definition	"a medical procedure involving an incision with instruments; performed to repair damage or arrest disease in a living body"@en ;
	dc:source	pwn30:00671351-n .

<i38956>	a	<Concept> ;
	skos:definition	"a surgical operation performed on the wrong part of the body"@en ;
	dc:source	pwn30:00673109-n .

<i38957>	a	<Concept> ;
	skos:definition	"surgical removal of an embolus (usually from an artery)"@en ;
	dc:source	pwn30:00673234-n .

<i38958>	a	<Concept> ;
	skos:definition	"surgical removal of the inner lining of an artery that is clogged with atherosclerosis"@en ;
	dc:source	pwn30:00673347-n .

<i38959>	a	<Concept> ;
	skos:definition	"surgical removal of a nerve"@en ;
	dc:source	pwn30:00673494-n .

<i38960>	a	<Concept> ;
	skos:definition	"surgical removal of an organ (or the contents of an organ) from a patient"@en ;
	dc:source	pwn30:00673578-n .

<i38961>	a	<Concept> ;
	skos:definition	"surgical removal of the organs within a body cavity (as those of the pelvis)"@en ;
	dc:source	pwn30:00673710-n .

<i38962>	a	<Concept> ;
	skos:definition	"any surgical procedure involving the eyes"@en ;
	dc:source	pwn30:00673863-n .

<i38963>	a	<Concept> ;
	skos:definition	"plastic surgery to remove wrinkles and other signs of aging from your face; an incision is made near the hair line and skin is pulled back and excess tissue is excised"@en ;
	dc:source	pwn30:00674158-n .

<i38964>	a	<Concept> ;
	skos:definition	"surgical procedure that creates a new fenestra to the cochlea in order to restore hearing lost because of osteosclerosis"@en ;
	dc:source	pwn30:00674562-n .

<i38965>	a	<Concept> ;
	skos:definition	"surgical removal of all or part of the stomach"@en ;
	dc:source	pwn30:00674760-n .

<i38966>	a	<Concept> ;
	skos:definition	"surgical creation of an opening between the stomach wall and the small intestines; performed when the normal opening has been eliminated"@en ;
	dc:source	pwn30:00674864-n .

<i38967>	a	<Concept> ;
	skos:definition	"surgical creation of an opening through the abdominal wall into the stomach (as for gastrogavage)"@en ;
	dc:source	pwn30:00675064-n .

<i38968>	a	<Concept> ;
	skos:definition	"any surgical procedure involving the heart"@en ;
	dc:source	pwn30:00675219-n .

<i38969>	a	<Concept> ;
	skos:definition	"heart surgery in which a small incision is made (the chest cavity is not opened)"@en ;
	dc:source	pwn30:00675357-n .

<i38970>	a	<Concept> ;
	skos:definition	"heart surgery in which the rib cage is spread open, the heart is stopped and blood is detoured through a heart-lung machine while a heart valve or coronary artery is surgically repaired"@en ;
	dc:source	pwn30:00675540-n .

<i38971>	a	<Concept> ;
	skos:definition	"open-heart surgery in which the rib cage is opened and a section of a blood vessel is grafted from the aorta to the coronary artery to bypass the blocked section of the coronary artery and improve the blood supply to the heart"@en ;
	dc:source	pwn30:00675808-n .

<i38972>	a	<Concept> ;
	skos:definition	"heart surgery in which a coronary bypass is performed by the use of small instruments and tiny cameras threaded through small incisions while the heart is stopped and blood is pumped through a heart-lung machine"@en ;
	dc:source	pwn30:00676160-n .

<i38973>	a	<Concept> ;
	skos:definition	"heart surgery in which a coronary bypass is performed on the beating heart by the use of small instruments and cameras threaded through small incisions"@en ;
	dc:source	pwn30:00676453-n .

<i38974>	a	<Concept> ;
	skos:definition	"surgical procedure for tying hemorrhoids and excising them"@en ;
	dc:source	pwn30:00676693-n .

<i38975>	a	<Concept> ;
	skos:definition	"surgical procedure of stopping the flow of blood (as with a hemostat)"@en ;
	dc:source	pwn30:00676834-n .

<i38976>	a	<Concept> ;
	skos:definition	"surgical removal of the pituitary gland"@en ;
	dc:source	pwn30:00677038-n .

<i38977>	a	<Concept> ;
	skos:definition	"surgical removal of the uterus"@en ;
	dc:source	pwn30:00677174-n .

<i38978>	a	<Concept> ;
	skos:definition	"surgical incision into the uterus (as in cesarean section)"@en ;
	dc:source	pwn30:00677299-n .

<i38979>	a	<Concept> ;
	skos:definition	"surgical removal of the uterus and the ovaries and oviducts and cervix and related lymph nodes"@en ;
	dc:source	pwn30:00677434-n .

<i38980>	a	<Concept> ;
	skos:definition	"surgical removal of the uterus and cervix"@en ;
	dc:source	pwn30:00677613-n .

<i38981>	a	<Concept> ;
	skos:definition	"surgical incision into the stomach"@en ;
	dc:source	pwn30:00677719-n .

<i38982>	a	<Concept> ;
	skos:definition	"a surgical procedure that places something in the human body"@en ;
	dc:source	pwn30:00677808-n .

<i38983>	a	<Concept> ;
	skos:definition	"the cutting of or into body tissues or organs (especially by a surgeon as part of an operation)"@en ;
	dc:source	pwn30:00678010-n .

<i38984>	a	<Concept> ;
	skos:definition	"eye surgery that involves removing all or part of the lens and replacing it with an intraocular lens implant"@en ;
	dc:source	pwn30:00678425-n .

<i38985>	a	<Concept> ;
	skos:definition	"cataract surgery in which the entire lens is removed"@en ;
	dc:source	pwn30:00678632-n .

<i38986>	a	<Concept> ;
	skos:definition	"cataract surgery in which only the front of the lens is removed; the back of the lens capsule remains intact and provides support for the lens implant"@en ;
	dc:source	pwn30:00678752-n .

<i38987>	a	<Concept> ;
	skos:definition	"an eye operation that treats glaucoma by destroying the ciliary body with a laser"@en ;
	dc:source	pwn30:00678988-n .

<i38988>	a	<Concept> ;
	skos:definition	"extracapsular surgery for cataracts in which ultrasonic sound breaks the cortex and nucleus of the lens into small fragments that are then vacuumed away through a small tube"@en ;
	dc:source	pwn30:00679140-n .

<i38989>	a	<Concept> ;
	skos:definition	"eye surgery that opens a passage allowing excess aqueous humor to drain into surrounding tissues; a treatment for glaucoma"@en ;
	dc:source	pwn30:00679379-n .

<i38990>	a	<Concept> ;
	skos:definition	"an eye operation that treats closed-angle glaucoma by surgical removal of part of the iris of the eye"@en ;
	dc:source	pwn30:00679566-n .

<i38991>	a	<Concept> ;
	skos:definition	"a surgical procedure that makes an incision in the iris of the eye in order to enlarge the pupil or to treat closed-angle glaucoma"@en ;
	dc:source	pwn30:00679724-n .

<i38992>	a	<Concept> ;
	skos:definition	"surgical incision into the cornea"@en ;
	dc:source	pwn30:00679910-n .

<i38993>	a	<Concept> ;
	skos:definition	"radial pattern of incisions in the cornea that cause the cornea to bulge; performed to correct myopia"@en ;
	dc:source	pwn30:00680018-n .

<i38994>	a	<Concept> ;
	skos:definition	"a refractive surgery procedure that reshapes the cornea"@en ;
	dc:source	pwn30:00680183-n .

<i38995>	a	<Concept> ;
	skos:definition	"eye surgery that makes many tiny laser burns in an area that will increase the drainage of aqueous humor"@en ;
	dc:source	pwn30:00680336-n .

<i38996>	a	<Concept> ;
	skos:definition	"a refractive surgery procedure that reshapes the cornea"@en ;
	dc:source	pwn30:00680511-n .

<i38997>	a	<Concept> ;
	skos:definition	"a surgical procedure that removes the vitreous humor and replace it with saline solution"@en ;
	dc:source	pwn30:00680658-n .

<i38998>	a	<Concept> ;
	skos:definition	"surgical incision into the perineum"@en ;
	dc:source	pwn30:00680803-n .

<i38999>	a	<Concept> ;
	skos:definition	"surgical incision of the perineum to enlarge the vagina and so facilitate delivery during childbirth"@en ;
	dc:source	pwn30:00680914-n .

<i39000>	a	<Concept> ;
