	dc:source	pwn30:06212302-n .

<i69180>	a	<Concept> ;
	skos:definition	"any opinions or doctrines at variance with the official or orthodox position"@en ;
	dc:source	pwn30:06212422-n .

<i69181>	a	<Concept> ;
	skos:definition	"a lack of orthodoxy in thoughts or beliefs"@en ;
	dc:source	pwn30:06212650-n .

<i69182>	a	<Concept> ;
	skos:definition	"an orientation that characterizes the thinking of a group or nation"@en ;
	dc:source	pwn30:06212839-n .

<i69183>	a	<Concept> ;
	skos:definition	"the principle of complete and unrestricted power in government"@en ;
	dc:source	pwn30:06213688-n .

<i69184>	a	<Concept> ;
	skos:definition	"a political theory favoring the abolition of governments"@en ;
	dc:source	pwn30:06213890-n .

<i69185>	a	<Concept> ;
	skos:definition	"a political theory favoring unlimited authority by a single individual"@en ;
	dc:source	pwn30:06214020-n .

<i69186>	a	<Concept> ;
	skos:definition	"the political doctrine of Machiavelli: any means (however unscrupulous) can be used by a ruler in order to create and maintain his autocratic government"@en ;
	dc:source	pwn30:06214164-n .

<i69187>	a	<Concept> ;
	skos:definition	"a political philosophy of avoiding the extremes of left and right by taking a moderate position or course of action"@en ;
	dc:source	pwn30:06214379-n .

<i69188>	a	<Concept> ;
	skos:definition	"a political theory that the people should own the means of production"@en ;
	dc:source	pwn30:06214580-n .

<i69189>	a	<Concept> ;
	skos:definition	"a political theory favoring collectivism in a classless society"@en ;
	dc:source	pwn30:06214744-n .

<i69190>	a	<Concept> ;
	skos:definition	"a form of communism developed in Cuba by Fidel Castro"@en ;
	dc:source	pwn30:06215043-n .

<i69191>	a	<Concept> ;
	skos:definition	"the political and economic theories of Lenin which provided the guiding doctrine of the Soviet Union; the modification of Marxism by Lenin stressed that imperialism is the highest form of capitalism (which shifts the struggle from developed to underdeveloped countries)"@en ;
	dc:source	pwn30:06215152-n .

<i69192>	a	<Concept> ;
	skos:definition	"a form of communism developed in China by Mao Zedong"@en ;
	dc:source	pwn30:06215495-n .

<i69193>	a	<Concept> ;
	skos:definition	"the economic and political theories of Karl Marx and Friedrich Engels that hold that human actions and institutions are economically determined and that class struggle is needed to create historical change and that capitalism will ultimately be superseded by communism"@en ;
	dc:source	pwn30:06215618-n .

<i69194>	a	<Concept> ;
	skos:definition	"the form of communism advocated by Leon Trotsky; calls for immediate worldwide revolution by the proletariat"@en ;
	dc:source	pwn30:06215977-n .

<i69195>	a	<Concept> ;
	skos:definition	"a political or theological orientation advocating the preservation of the best in society and opposing radical changes"@en ;
	dc:source	pwn30:06216160-n .

<i69196>	a	<Concept> ;
	skos:definition	"an approach to politics or theology that represents a return to a traditional point of view (in contrast to more liberal or radical schools of thought of the 1960s)"@en ;
	dc:source	pwn30:06216408-n .

<i69197>	a	<Concept> ;
	skos:definition	"extreme conservatism in political or social matters"@en ;
	dc:source	pwn30:06216634-n .

<i69198>	a	<Concept> ;
	skos:definition	"a political orientation favoring political or racial segregation"@en ;
	dc:source	pwn30:06216805-n .

<i69199>	a	<Concept> ;
	skos:definition	"advocacy of a system of government according to constitutional principles"@en ;
	dc:source	pwn30:06216948-n .

<i69200>	a	<Concept> ;
	skos:definition	"the political orientation of those who favor government by the people or by their elected representatives"@en ;
	dc:source	pwn30:06217103-n .

<i69201>	a	<Concept> ;
	skos:definition	"the belief in a gradual transition from capitalism to socialism by democratic means"@en ;
	dc:source	pwn30:06217318-n .

<i69202>	a	<Concept> ;
	skos:definition	"the political theory that if one nation comes under communist control then neighboring nations will also come under communist control"@en ;
	dc:source	pwn30:06217464-n .

<i69203>	a	<Concept> ;
	skos:definition	"the attitude that society should be governed by an elite group of individuals"@en ;
	dc:source	pwn30:06217657-n .

<i69204>	a	<Concept> ;
	skos:definition	"any political theory favoring immoderate uncompromising policies"@en ;
	dc:source	pwn30:06217806-n .

<i69205>	a	<Concept> ;
	skos:definition	"a political theory advocating an authoritarian hierarchical government (as opposed to democracy or liberalism)"@en ;
	dc:source	pwn30:06217944-n .

<i69206>	a	<Concept> ;
	skos:definition	"the idea of a federal organization of more or less self-governing units"@en ;
	dc:source	pwn30:06218162-n .

<i69207>	a	<Concept> ;
	skos:definition	"a political orientation that advocates imperial interests"@en ;
	dc:source	pwn30:06218308-n .

<i69208>	a	<Concept> ;
	skos:definition	"the ideology of the political left; belief in or support of the tenets of the political left"@en ;
	dc:source	pwn30:06218459-n .

<i69209>	a	<Concept> ;
	skos:definition	"a political orientation that favors social progress by reform and by changing laws rather than by revolution"@en ;
	dc:source	pwn30:06218623-n .

<i69210>	a	<Concept> ;
	skos:definition	"the belief that rulers should be chosen for their superior abilities and not because of their wealth or birth"@en ;
	dc:source	pwn30:06218824-n .

<i69211>	a	<Concept> ;
	skos:definition	"a political orientation originating in the 1960s; blends liberal political views with an emphasis on economic growth"@en ;
	dc:source	pwn30:06219009-n .

<i69212>	a	<Concept> ;
	skos:definition	"an ideological belief in freedom of thought and speech"@en ;
	dc:source	pwn30:06219185-n .

<i69213>	a	<Concept> ;
	skos:definition	"a belief in and advocacy of monarchy as a political system"@en ;
	dc:source	pwn30:06219300-n .

<i69214>	a	<Concept> ;
	skos:definition	"an ideological position that holds Black culture to be independent and valid on its own terms; an affirmation of the African cultural heritage"@en ;
	dc:source	pwn30:06219415-n .

<i69215>	a	<Concept> ;
	skos:definition	"the political philosophy of the Orleanists"@en ;
	dc:source	pwn30:06219613-n .

<i69216>	a	<Concept> ;
	skos:definition	"the political orientation of those who favor progress toward better conditions in government and society"@en ;
	dc:source	pwn30:06219711-n .

<i69217>	a	<Concept> ;
	skos:definition	"the political orientation of those who favor revolutionary change in government and society"@en ;
	dc:source	pwn30:06219875-n .

<i69218>	a	<Concept> ;
	skos:definition	"the ideology of the most radical element of the French Revolution that instituted the Reign of Terror"@en ;
	dc:source	pwn30:06220041-n .

<i69219>	a	<Concept> ;
	skos:definition	"the political orientation of reactionaries"@en ;
	dc:source	pwn30:06220199-n .

<i69220>	a	<Concept> ;
	skos:definition	"the political orientation of those who hold that a republic is the best form of government"@en ;
	dc:source	pwn30:06220299-n .

<i69221>	a	<Concept> ;
	skos:definition	"the ideology of the political right; belief in or support of the tenets of the political right"@en ;
	dc:source	pwn30:06220449-n .

<i69222>	a	<Concept> ;
	skos:definition	"a political theory advocating state ownership of industry"@en ;
	dc:source	pwn30:06220616-n .

<i69223>	a	<Concept> ;
	skos:definition	"socialism to be established by gradual reforms within the law"@en ;
	dc:source	pwn30:06220819-n .

<i69224>	a	<Concept> ;
	skos:definition	"a form of socialist theory advocating state ownership of industry but managements by guilds of workers"@en ;
	dc:source	pwn30:06220955-n .

<i69225>	a	<Concept> ;
	skos:definition	"socialism achieved by voluntary sacrifice"@en ;
	dc:source	pwn30:06221119-n .

<i69226>	a	<Concept> ;
	skos:definition	"the belief in government by divine guidance"@en ;
	dc:source	pwn30:06221224-n .

<i69227>	a	<Concept> ;
	skos:definition	"the political orientation of a Utopian who believes in impossibly idealistic schemes of social perfection"@en ;
	dc:source	pwn30:06221323-n .

<i69228>	a	<Concept> ;
	skos:definition	"any political orientation favoring compromise to avoid conflict"@en ;
	dc:source	pwn30:06221485-n .

<i69229>	a	<Concept> ;
	skos:definition	"any policy that advocates maintaining peaceful international relations"@en ;
	dc:source	pwn30:06221659-n .

<i69230>	a	<Concept> ;
	skos:definition	"any political orientation favoring aggressive policies"@en ;
	dc:source	pwn30:06221790-n .

<i69231>	a	<Concept> ;
	skos:definition	"a political orientation of a people or a government to maintain a strong military force and to be prepared to use it aggressively to defend or promote national interests"@en ;
	dc:source	pwn30:06221974-n .

<i69232>	a	<Concept> ;
	skos:definition	"a policy of advocating war"@en ;
	dc:source	pwn30:06222236-n .

<i69233>	a	<Concept> ;
	skos:definition	"an attitude toward religion or religious practices"@en ;
	dc:source	pwn30:06222336-n .

<i69234>	a	<Concept> ;
	skos:definition	"a religious orientation of doubt; a denial of ultimate knowledge of the existence of God"@en ;
	dc:source	pwn30:06222508-n .

<i69235>	a	<Concept> ;
	skos:definition	"the heretical doctrine (associated with the Gnostics) that Jesus had no human body and his sufferings and death on the cross were apparent rather than real"@en ;
	dc:source	pwn30:06222731-n .

<i69236>	a	<Concept> ;
	skos:definition	"a religious orientation advocating gnosis as the way to release a person's spiritual element; considered heresy by Christian churches"@en ;
	dc:source	pwn30:06222959-n .

<i69237>	a	<Concept> ;
	skos:definition	"a Gnostic religion originating the 2nd and 3rd centuries that believes John the Baptist was the Messiah and that incorporates Jewish and Christian elements into a framework of dualistic beliefs"@en ;
	dc:source	pwn30:06223204-n .

<i69238>	a	<Concept> ;
	skos:definition	"the doctrine or belief that there is no God"@en ;
	dc:source	pwn30:06223468-n .

<i69239>	a	<Concept> ;
	skos:definition	"the doctrine or belief in the existence of a God or gods"@en ;
	dc:source	pwn30:06223669-n .

<i69240>	a	<Concept> ;
	skos:definition	"the form of theological rationalism that believes in God on the basis of reason without reference to revelation"@en ;
	dc:source	pwn30:06223922-n .

<i69241>	a	<Concept> ;
	skos:definition	"belief in a single God"@en ;
	dc:source	pwn30:06224136-n .

<i69242>	a	<Concept> ;
	skos:definition	"belief in multiple Gods"@en ;
	dc:source	pwn30:06224305-n .

<i69243>	a	<Concept> ;
	skos:definition	"(Christianity) the heretical belief that the Father and the Son and the Holy Spirit are three separate gods"@en ;
	dc:source	pwn30:06224439-n .

<i69244>	a	<Concept> ;
	skos:definition	"any of various religions other than Christianity or Judaism or Islamism"@en ;
	dc:source	pwn30:06224657-n .

<i69245>	a	<Concept> ;
	skos:definition	"the system of religion and philosophy taught by the Druids and their rites and ceremonies"@en ;
	dc:source	pwn30:06224831-n .

<i69246>	a	<Concept> ;
	skos:definition	"the doctrine or belief that God is the universe and its phenomena (taken or conceived of as a whole) or the doctrine that regards the universe as a manifestation of God"@en ;
	dc:source	pwn30:06224975-n .

<i69247>	a	<Concept> ;
	skos:definition	"(rare) worship that admits or tolerates all gods"@en ;
	dc:source	pwn30:06225235-n .

<i69248>	a	<Concept> ;
	skos:definition	"a religious cult that anticipates a time of joy, serenity, and justice when salvation comes"@en ;
	dc:source	pwn30:06225357-n .

<i69249>	a	<Concept> ;
	skos:definition	"a Brazilian religious cult of African origin; combines voodoo elements with singing and chanting and dancing"@en ;
	dc:source	pwn30:06225505-n .

<i69250>	a	<Concept> ;
	skos:definition	"a religious belief of African origin involving witchcraft and sorcery; practiced in parts of the West Indies and tropical Americas"@en ;
	dc:source	pwn30:06225667-n .

<i69251>	a	<Concept> ;
	skos:definition	"a religious cult based on a belief that Ras Tafari (Haile Selassie) is the Messiah and that Africa (especially Ethiopia) is the Promised Land"@en ;
	dc:source	pwn30:06225855-n .

<i69252>	a	<Concept> ;
	skos:definition	"a monotheistic system of beliefs and practices based on the Old Testament and the teachings of Jesus as embodied in the New Testament and emphasizing the role of Jesus as savior"@en ;
	dc:source	pwn30:06226057-n .

<i69253>	a	<Concept> ;
	skos:definition	"any Christian religion that believes the second coming of Christ is imminent"@en ;
	dc:source	pwn30:06226934-n .

<i69254>	a	<Concept> ;
	skos:definition	"Adventism that is strongly Protestant and observes Saturday as the Sabbath"@en ;
	dc:source	pwn30:06227121-n .

<i69255>	a	<Concept> ;
	skos:definition	"the beliefs and practices of a Catholic Church"@en ;
	dc:source	pwn30:06227263-n .

<i69256>	a	<Concept> ;
	skos:definition	"a religious orientation opposed to Catholicism"@en ;
	dc:source	pwn30:06227453-n .

<i69257>	a	<Concept> ;
	skos:definition	"the beliefs and practices of the Catholic Church based in Rome"@en ;
	dc:source	pwn30:06227562-n .

<i69258>	a	<Concept> ;
	skos:definition	"a Christian movement considered to be a medieval descendant of Manichaeism in southern France in the 12th and 13th centuries; characterized by dualism (asserted the coexistence of two mutually opposed principles, one good and one evil); was exterminated for heresy during the Inquisition"@en ;
	dc:source	pwn30:06227708-n .

<i69259>	a	<Concept> ;
	skos:definition	"a schismatic Christian religion in northern Africa from the 4th to the 7th century; held that only those who led a blameless life belonged in the church or could administer the sacraments"@en ;
	dc:source	pwn30:06228086-n .

<i69260>	a	<Concept> ;
	skos:definition	"the beliefs and practices of any of the eastern Catholic Churches based in Constantinople or Antioch or Alexandria or Moscow or Jerusalem"@en ;
	dc:source	pwn30:06228346-n .

<i69261>	a	<Concept> ;
	skos:definition	"the theological system of any of the churches of western Christendom that separated from the Roman Catholic Church during the Reformation"@en ;
	dc:source	pwn30:06228549-n .

<i69262>	a	<Concept> ;
	skos:definition	"the faith and doctrine and practice of the Anglican Church"@en ;
	dc:source	pwn30:06229106-n .

<i69263>	a	<Concept> ;
	skos:definition	"a doctrine and practice within the Church of England emphasizing the Catholic tradition"@en ;
	dc:source	pwn30:06229240-n .

<i69264>	a	<Concept> ;
	skos:definition	"principles of the founders of the Oxford movement as expounded in pamphlets called `Tracts for the Times'"@en ;
	dc:source	pwn30:06229410-n .

<i69265>	a	<Concept> ;
	skos:definition	"17th century theology (named after its founder Jacobus Arminius) that opposes the absolute predestinarianism of John Calvin and holds that human free will is compatible with God's sovereignty"@en ;
	dc:source	pwn30:06229586-n .

<i69266>	a	<Concept> ;
	skos:definition	"the theological system of John Calvin and his followers emphasizing omnipotence of God and salvation by grace alone"@en ;
	dc:source	pwn30:06229853-n .

<i69267>	a	<Concept> ;
	skos:definition	"religious system based on teachings of Mary Baker Eddy emphasizing spiritual healing"@en ;
	dc:source	pwn30:06230060-n .

<i69268>	a	<Concept> ;
	skos:definition	"teachings of Martin Luther emphasizing the cardinal doctrine of justification by faith alone"@en ;
	dc:source	pwn30:06230208-n .

<i69269>	a	<Concept> ;
	skos:definition	"Christian doctrine that stresses individual freedom of belief and rejects the Trinity"@en ;
	dc:source	pwn30:06230358-n .

<i69270>	a	<Concept> ;
	skos:definition	"Christian doctrine stressing belief in the Trinity"@en ;
	dc:source	pwn30:06230502-n .

<i69271>	a	<Concept> ;
	skos:definition	"system of beliefs and church government of a Protestant denomination in which each member church is self-governing"@en ;
	dc:source	pwn30:06230613-n .

<i69272>	a	<Concept> ;
	skos:definition	"system of beliefs and practices including belief in scriptural authority; plain dress; adult baptism; foot washing; restriction of marriage to members of the group"@en ;
	dc:source	pwn30:06230809-n .

<i69273>	a	<Concept> ;
	skos:definition	"stresses the importance of personal conversion and faith as the means of salvation"@en ;
	dc:source	pwn30:06231030-n .

<i69274>	a	<Concept> ;
	skos:definition	"an attempt to reawaken the evangelical faith"@en ;
	dc:source	pwn30:06231191-n .

<i69275>	a	<Concept> ;
	skos:definition	"the interpretation of every word in the sacred texts as literal truth"@en ;
	dc:source	pwn30:06231328-n .

<i69276>	a	<Concept> ;
	skos:definition	"the religious beliefs and practices of Methodists characterized by concern with social welfare and public morals"@en ;
	dc:source	pwn30:06231494-n .

<i69277>	a	<Concept> ;
	skos:definition	"evangelical principles taught by John Wesley"@en ;
	dc:source	pwn30:06231680-n .

<i69278>	a	<Concept> ;
	skos:definition	"a Protestant movement in the 16th century that believed in the primacy of the Bible, baptised only believers, not infants, and believed in complete separation of church and state"@en ;
	dc:source	pwn30:06231794-n .

<i69279>	a	<Concept> ;
	skos:definition	"any of various doctrines closely related to Anabaptism"@en ;
	dc:source	pwn30:06232047-n .

<i69280>	a	<Concept> ;
	skos:definition	"the doctrines and practices of the Mormon Church based on the Book of Mormon"@en ;
	dc:source	pwn30:06232166-n .

<i69281>	a	<Concept> ;
	skos:definition	"the principles and practices of Pentecostal religious groups; characterized by religious excitement and talking in tongues"@en ;
	dc:source	pwn30:06232298-n .

<i69282>	a	<Concept> ;
	skos:definition	"the doctrines and practices of the Presbyterian Church: based in Calvinism"@en ;
	dc:source	pwn30:06232499-n .

<i69283>	a	<Concept> ;
	skos:definition	"the beliefs and practices characteristic of Puritans (most of whom were Calvinists who wished to purify the Church of England of its Catholic aspects)"@en ;
	dc:source	pwn30:06232635-n .

<i69284>	a	<Concept> ;
	skos:definition	"the monotheistic religion of the Jews having its spiritual and ethical principles embodied chiefly in the Torah and in the Talmud"@en ;
	dc:source	pwn30:06232880-n .

<i69285>	a	<Concept> ;
	skos:definition	"beliefs and practices of a Judaic sect that strictly observes Mosaic law"@en ;
	dc:source	pwn30:06234104-n .

<i69286>	a	<Concept> ;
	skos:definition	"beliefs and practices of a sect of Orthodox Jews"@en ;
	dc:source	pwn30:06234257-n .

<i69287>	a	<Concept> ;
	skos:definition	"a form of Hasidism practiced by Lithuanian and Russian Jews under communist rule; the beliefs and practices of the Lubavitch movement"@en ;
	dc:source	pwn30:06234415-n .

<i69288>	a	<Concept> ;
	skos:definition	"beliefs and practices of Conservative Jews"@en ;
	dc:source	pwn30:06234619-n .

<i69289>	a	<Concept> ;
	skos:definition	"beliefs and practices of Reform Jews"@en ;
	dc:source	pwn30:06234728-n .

<i69290>	a	<Concept> ;
	skos:definition	"the monotheistic religious system of Muslims founded in Arabia in the 7th century and based on the teachings of Muhammad as laid down in the Koran"@en ;
	dc:source	pwn30:06234825-n .

<i69291>	a	<Concept> ;
	skos:definition	"belief in the appearance of the Mahdi; devotion to a Mahdi"@en ;
	dc:source	pwn30:06235829-n .

<i69292>	a	<Concept> ;
	skos:definition	"a militant group of extremist Sunnis who believe themselves the only correct interpreters of the Koran and consider moderate Muslims to be infidels; seek to convert all Muslims and to insure that its own fundamentalist version of Islam will dominate the world"@en ;
	dc:source	pwn30:06235977-n .

<i69293>	a	<Concept> ;
	skos:definition	"the branch of Islam that regards Ali as the legitimate successor to Mohammed and rejects the first three caliphs"@en ;
	dc:source	pwn30:06236309-n .

<i69294>	a	<Concept> ;
	skos:definition	"the branch of Shiism noted for its esoteric philosophy"@en ;
	dc:source	pwn30:06236492-n .

<i69295>	a	<Concept> ;
	skos:definition	"a conservative and intolerant form of Islam that is practiced in Saudi Arabia"@en ;
	dc:source	pwn30:06236602-n .

<i69296>	a	<Concept> ;
	skos:definition	"a body of religious and philosophical beliefs and cultural practices native to India and based on a caste system; it is characterized by a belief in reincarnation, by a belief in a supreme being of many forms and natures, by the view that opposing theories are aspects of one eternal truth, and by a desire for liberation from earthly evils"@en ;
	dc:source	pwn30:06236802-n .

<i69297>	a	<Concept> ;
	skos:definition	"the religious beliefs of ancient India as prescribed in the sacred Vedas and Brahmanas and Upanishads"@en ;
	dc:source	pwn30:06237865-n .

<i69298>	a	<Concept> ;
	skos:definition	"(from the Sanskrit word for `to see') one of six orthodox philosophical systems or viewpoints on the nature of reality and the release from bondage to karma"@en ;
	dc:source	pwn30:06238036-n .

<i69299>	a	<Concept> ;
	skos:definition	"(from the Sanskrit word for `reflection' or `interpretation') one of six orthodox philosophical systems or viewpoints on ritual traditions rooted in the Vedas and the Brahmanas as opposed to Vedanta which relies mostly on the Upanishads"@en ;
	dc:source	pwn30:06238265-n .

<i69300>	a	<Concept> ;
	skos:definition	"(from the Sanskrit for `end of the Veda') one of six orthodox philosophical systems or viewpoints rooted in the Upanishads as opposed to Mimamsa which relies on the Vedas and Brahmanas"@en ;
	dc:source	pwn30:06238574-n .

<i69301>	a	<Concept> ;
	skos:definition	"worship of Krishna the 8th avatar of Vishnu"@en ;
	dc:source	pwn30:06238831-n .

<i69302>	a	<Concept> ;
	skos:definition	"worship of Shiva one of the 3 chief gods of the Hindu pantheon"@en ;
	dc:source	pwn30:06238931-n .

<i69303>	a	<Concept> ;
	skos:definition	"worship of Shakti as the wife of Shiva"@en ;
	dc:source	pwn30:06239076-n .

<i69304>	a	<Concept> ;
	skos:definition	"worship of Vishnu one of the 3 chief gods of the Hindu pantheon"@en ;
	dc:source	pwn30:06239215-n .

<i69305>	a	<Concept> ;
	skos:definition	"Hindu discipline aimed at training the consciousness for a state of perfect spiritual insight and tranquility that is achieved through the three paths of actions and knowledge and devotion"@en ;
	dc:source	pwn30:06239361-n .

<i69306>	a	<Concept> ;
	skos:definition	"religion founded in the 6th century BC as a revolt against Hinduism; emphasizes asceticism and immortality and transmigration of the soul; denies existence of a perfect or supreme being"@en ;
	dc:source	pwn30:06239655-n .

<i69307>	a	<Concept> ;
	skos:definition	"the doctrines of a monotheistic religion founded in northern India in the 16th century by Guru Nanak and combining elements of Hinduism and Islam"@en ;
	dc:source	pwn30:06239931-n .

<i69308>	a	<Concept> ;
	skos:definition	"the teaching of Buddha that life is permeated with suffering caused by desire, that suffering ceases when desire ceases, and that enlightenment obtained through right conduct and wisdom and meditation releases one from desire and suffering and rebirth"@en ;
	dc:source	pwn30:06240244-n .

<i69309>	a	<Concept> ;
	skos:definition	"one of two great schools of Buddhist doctrine emphasizing a common search for universal salvation especially through faith alone; the dominant religion of China and Tibet and Japan"@en ;
	dc:source	pwn30:06240865-n .

<i69310>	a	<Concept> ;
	skos:definition	"one of two great schools of Buddhist doctrine emphasizing personal salvation through your own efforts; a conservative form of Buddhism that adheres to Pali scriptures and the non-theistic ideal of self purification to nirvana; the dominant religion of Sri Lanka (Ceylon) and Myanmar (Burma) and Thailand and Laos and Cambodia"@en ;
	dc:source	pwn30:06241156-n .

<i69311>	a	<Concept> ;
	skos:definition	"an offensive name for the early conservative Theravada Buddhism; it died out in India but survived in Sri Lanka and was taken from there to other regions of southwestern Asia"@en ;
	dc:source	pwn30:06241576-n .

<i69312>	a	<Concept> ;
	skos:definition	"a Buddhist doctrine that includes elements from India that are not Buddhist and elements of preexisting shamanism"@en ;
	dc:source	pwn30:06241825-n .

<i69313>	a	<Concept> ;
	skos:definition	"a Buddhist doctrine that enlightenment can be attained through direct intuitive insight"@en ;
	dc:source	pwn30:06242048-n .

<i69314>	a	<Concept> ;
	skos:definition	"a form of Buddhism emphasizing mystical symbolism of mantras and mudras and the Buddha's ideal which is inexpressible"@en ;
	dc:source	pwn30:06242237-n .

<i69315>	a	<Concept> ;
	skos:definition	"doctrine of enlightenment as the realization of the oneness of one's self and the visible world; combines elements of Hinduism and paganism including magical and mystical elements like mantras and mudras and erotic rites; especially influential in Tibet"@en ;
	dc:source	pwn30:06242427-n .

<i69316>	a	<Concept> ;
	skos:definition	"one of the main traditions of Mahayana Buddhism; holds that the mind is real but that objects are just ideas or states of consciousness"@en ;
	dc:source	pwn30:06242780-n .

<i69317>	a	<Concept> ;
	skos:definition	"the ultimate principle of the universe"@en ;
	dc:source	pwn30:06242970-n .

<i69318>	a	<Concept> ;
	skos:definition	"popular Chinese philosophical system based in teachings of Lao-tzu but characterized by a pantheism of many gods and the practices of alchemy and divination and magic"@en ;
	dc:source	pwn30:06243096-n .

<i69319>	a	<Concept> ;
	skos:definition	"the ancient indigenous religion of Japan lacking formal dogma; characterized by a veneration of nature spirits and of ancestors"@en ;
	dc:source	pwn30:06243347-n .

<i69320>	a	<Concept> ;
	skos:definition	"a religion founded by Manes in the third century; a synthesis of Zoroastrian dualism between light and dark and Babylonian folklore and Buddhist ethics and superficial elements of Christianity; spread widely in the Roman Empire but had largely died out by 1000"@en ;
	dc:source	pwn30:06243575-n .

<i69321>	a	<Concept> ;
	skos:definition	"ancient Persian religion; popular among Romans during first three centuries a.d."@en ;
	dc:source	pwn30:06243963-n .

<i69322>	a	<Concept> ;
	skos:definition	"system of religion founded in Persia in the 6th century BC by Zoroaster; set forth in the Zend-Avesta; based on concept of struggle between light (good) and dark (evil)"@en ;
	dc:source	pwn30:06244149-n .

<i69323>	a	<Concept> ;
	skos:definition	"the faith of a Zoroastrian sect in India"@en ;
	dc:source	pwn30:06244445-n .

<i69324>	a	<Concept> ;
	skos:definition	"a religion founded in Iran in 1863; emphasizes the spiritual unity of all humankind; incorporates Christian and Islamic tenets; many adherents live in the United States"@en ;
	dc:source	pwn30:06244552-n .

<i69325>	a	<Concept> ;
	skos:definition	"an animistic religion of northern Asia having the belief that the mediation between the visible and the spirit worlds is effected by shamans"@en ;
	dc:source	pwn30:06244852-n .

<i69326>	a	<Concept> ;
	skos:definition	"any animistic religion similar to Asian shamanism (especially as practiced by certain Native American tribes)"@en ;
	dc:source	pwn30:06245084-n .

<i69327>	a	<Concept> ;
	skos:definition	"the form of Hinduism that revolves primarily around the mythic version and ritual ideologies in the Vedas"@en ;
	dc:source	pwn30:06245286-n .

<i69328>	a	<Concept> ;
	skos:definition	"the polytheistic nature religion of modern witchcraft whose central deity is a mother goddess; claims origins in pre-Christian pagan religions of western Europe"@en ;
	dc:source	pwn30:06245462-n .

<i69329>	a	<Concept> ;
	skos:definition	"belief in a kind of sorcery that originated in Africa and is practiced in the West Indies"@en ;
	dc:source	pwn30:06245674-n .

<i69330>	a	<Concept> ;
	skos:definition	"a religious cult practiced chiefly in Caribbean countries (especially Haiti); involves witchcraft and animistic deities"@en ;
	dc:source	pwn30:06245816-n .

<i69331>	a	<Concept> ;
	skos:definition	"the conviction that people should participate in sports as a hobby (for the fun of it) rather than for money"@en ;
	dc:source	pwn30:06246076-n .

<i69332>	a	<Concept> ;
	skos:definition	"a mystical or allegorical interpretation (especially of Scripture)"@en ;
	dc:source	pwn30:06246241-n .

<i69333>	a	<Concept> ;
	skos:definition	"(physics) a phase space together with a transformation of that space"@en ;
	dc:source	pwn30:06246361-n .

<i69334>	a	<Concept> ;
	skos:definition	"(physics) a dynamical system that is extremely sensitive to its initial conditions"@en ;
	dc:source	pwn30:06246529-n .

<i69335>	a	<Concept> ;
	skos:definition	"(psychoanalysis) an unconscious process whereby two ideas or images combine into a single symbol; especially in dreams"@en ;
	dc:source	pwn30:06246700-n .

<i69336>	a	<Concept> ;
	skos:definition	"an abstract place usually conceived as having depth"@en ;
	dc:source	pwn30:06246896-n .

<i69337>	a	<Concept> ;
	skos:definition	"(psychoanalysis) the process whereby emotions are passed on or displaced from one person to another; during psychoanalysis the displacement of feelings toward others (usually the parents) is onto the analyst"@en ;
	dc:source	pwn30:06247181-n .

<i69338>	a	<Concept> ;
	skos:definition	"the psychoanalyst's displacement of emotion onto the patient or more generally the psychoanalyst's emotional involvement in the therapeutic interaction"@en ;
	dc:source	pwn30:06247484-n .

<i69339>	a	<Concept> ;
	skos:definition	"a rule or condition that limits freedom"@en ;
	dc:source	pwn30:06247701-n .

<i69340>	a	<Concept> ;
	skos:definition	"something that restrains a flood or outpouring"@en ;
	dc:source	pwn30:06247867-n .

<i69341>	a	<Concept> ;
	skos:definition	"the discipline dealing with the principles of warfare"@en ;
	dc:source	pwn30:06248043-n .

