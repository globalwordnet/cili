	dc:source	pwn30:11608055-n .

<i98384>	a	<Concept> ;
	skos:definition	"a coniferous tree"@en ;
	dc:source	pwn30:11608250-n .

<i98385>	a	<Concept> ;
	skos:definition	"straight-grained durable and often resinous white to yellowish timber of any of numerous trees of the genus Pinus"@en ;
	dc:source	pwn30:11608885-n .

