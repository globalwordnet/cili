	dc:source	pwn30:06162979-n .

<i68948>	a	<Concept> ;
	skos:definition	"the metaphysical study of the origin and nature of the universe"@en ;
	dc:source	pwn30:06163223-n .

<i68949>	a	<Concept> ;
	skos:definition	"a rationale for dialectical materialism based on change through the conflict of opposing forces"@en ;
	dc:source	pwn30:06163396-n .

<i68950>	a	<Concept> ;
