	dc:source	pwn30:07083246-n .

<i73873>	a	<Concept> ;
	skos:definition	"the rapid and continuous delivery of linguistic communication (spoken or written)"@en ;
	dc:source	pwn30:07083441-n .

<i73874>	a	<Concept> ;
