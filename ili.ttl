	dc:source	pwn30:05476592-n .

<i65730>	a	<Concept> ;
	skos:definition	"a bundle of myelinated neurons joining different parts of the brain"@en ;
	dc:source	pwn30:05476754-n .

<i65731>	a	<Concept> ;
	skos:definition	"either half of the cerebrum"@en ;
	dc:source	pwn30:05476915-n .

<i65732>	a	<Concept> ;
