<i111520>	a	<Concept> ;
	skos:definition	"any abnormality of mental function"@en ;
	dc:source	pwn30:14200301-n .

<i111521>	a	<Concept> ;
	skos:definition	"condition in which both eyes are abnormally small but otherwise normal"@en ;
	dc:source	pwn30:14200418-n .

<i111522>	a	<Concept> ;
