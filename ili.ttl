	skos:definition	"a small informal social gathering"@en ;
	dc:source	pwn30:08310389-n .

<i80809>	a	<Concept> ;
	skos:definition	"a council consisting of permanent representatives of all the member countries of NATO; has political authority and powers of decision"@en ;
	dc:source	pwn30:08310722-n .

