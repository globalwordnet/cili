	dc:source	pwn30:15113050-n .

<i116632>	a	<Concept> ;
	skos:definition	"an amount of time"@en ;
	dc:source	pwn30:15113229-n .

<i116633>	a	<Concept> ;
	skos:definition	"a period of time during which someone or something is tested"@en ;
	dc:source	pwn30:15115926-n .

<i116634>	a	<Concept> ;
