	dc:source	pwn30:05341641-n .

<i65022>	a	<Concept> ;
	skos:definition	"arises from the basilar artery; divides into three branches"@en ;
	dc:source	pwn30:05341789-n .

<i65023>	a	<Concept> ;
	skos:definition	"an artery that supplies the muscles of the neck"@en ;
	dc:source	pwn30:05341920-n .

<i65024>	a	<Concept> ;
	skos:definition	"an artery that supplies the choroid plexus"@en ;
	dc:source	pwn30:05342070-n .

<i65025>	a	<Concept> ;
	skos:definition	"one of several arteries supplying the choroid coat of the eye"@en ;
	dc:source	pwn30:05342214-n .

<i65026>	a	<Concept> ;
	skos:definition	"a ring of arteries at the base of the brain"@en ;
	dc:source	pwn30:05342374-n .

<i65027>	a	<Concept> ;
	skos:definition	"any of several paired curving arteries"@en ;
	dc:source	pwn30:05342499-n .

<i65028>	a	<Concept> ;
	skos:definition	"an artery that supplies the hip joint and thigh muscles"@en ;
	dc:source	pwn30:05342673-n .

<i65029>	a	<Concept> ;
