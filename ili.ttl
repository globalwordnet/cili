	dc:source	pwn30:09557632-n .

<i86886>	a	<Instance> ;
	skos:definition	"(Greek mythology) the most ancient of gods; the personification of the infinity of space preceding creation of the universe"@en ;
	dc:source	pwn30:09557770-n .

<i86887>	a	<Instance> ;
	skos:definition	"(Greek mythology) the supreme god until Zeus dethroned him; son of Uranus and Gaea in ancient Greek mythology; identified with Roman Saturn"@en ;
	dc:source	pwn30:09557965-n .

<i86888>	a	<Instance> ;
