	dc:source	pwn30:13857804-n .

<i109750>	a	<Concept> ;
	skos:definition	"the relation between propositions that cannot both be true at the same time"@en ;
	dc:source	pwn30:13858045-n .

<i109751>	a	<Concept> ;
	skos:definition	"exact opposition"@en ;
	dc:source	pwn30:13858270-n .

<i109752>	a	<Concept> ;
	skos:definition	"the relation between contraries"@en ;
	dc:source	pwn30:13858392-n .

<i109753>	a	<Concept> ;
