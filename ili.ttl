<i65001>	a	<Concept> ;
	skos:definition	"the branch of the ileocolic artery that supplies the ascending colon"@en ;
	dc:source	pwn30:05337855-n .

<i65002>	a	<Concept> ;
	skos:definition	"artery that supplies blood to the ear"@en ;
	dc:source	pwn30:05338025-n .

<i65003>	a	<Concept> ;
	skos:definition	"the part of the main artery of the arm that lies in the armpit and is continuous with the subclavian artery above and the brachial artery below"@en ;
	dc:source	pwn30:05338166-n .

<i65004>	a	<Concept> ;
	skos:definition	"an unpaired artery; supplies the pons and cerebellum and the back part of the cerebrum and the inner ear"@en ;
	dc:source	pwn30:05338410-n .

<i65005>	a	<Concept> ;
	skos:definition	"the main artery of the upper arm; a continuation of the axillary artery; bifurcates into the radial and ulnar arteries at the elbow"@en ;
	dc:source	pwn30:05338614-n .

<i65006>	a	<Concept> ;
	skos:definition	"branch of the brachial artery beginning below the elbow and extending down the forearm around the wrist and into the palm"@en ;
