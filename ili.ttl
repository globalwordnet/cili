	skos:definition	"a viral disease (usually fatal) of rabbits"@en ;
	dc:source	pwn30:14274701-n .

<i111956>	a	<Concept> ;
	skos:definition	"disease of domestic fowl and other birds"@en ;
	dc:source	pwn30:14274801-n .

