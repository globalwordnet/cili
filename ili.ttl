	dc:source	pwn30:06478734-n .

<i70504>	a	<Concept> ;
	skos:definition	"an official document issued by a government and conferring on the recipient the rank of an officer in the armed forces"@en ;
	dc:source	pwn30:06478988-n .

<i70505>	a	<Concept> ;
	skos:definition	"a certificate saying that a departing ship's company is healthy (to be presented at the next port of arrival)"@en ;
	dc:source	pwn30:06479204-n .

<i70506>	a	<Concept> ;
