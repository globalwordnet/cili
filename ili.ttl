	dc:source	pwn30:06552470-n .

<i70899>	a	<Concept> ;
	skos:definition	"a warrant granting release from punishment for an offense"@en ;
	dc:source	pwn30:06552639-n .

<i70900>	a	<Concept> ;
	skos:definition	"a legal document evidencing the discharge of a debt or obligation"@en ;
	dc:source	pwn30:06552814-n .

<i70901>	a	<Concept> ;
	skos:definition	"(law) a legal document issued by a court or judicial officer"@en ;
	dc:source	pwn30:06552984-n .

<i70902>	a	<Concept> ;
	skos:definition	"an ancient writ issued by a court of assize to the sheriff for the recovery of property"@en ;
	dc:source	pwn30:06553472-n .

<i70903>	a	<Concept> ;
