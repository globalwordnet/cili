<i109744>	a	<Concept> ;
	skos:definition	"the character of the negative electric pole"@en ;
	dc:source	pwn30:13857008-n .

<i109745>	a	<Concept> ;
	skos:definition	"an opposition that has no intermediate grade; either one or the other"@en ;
	dc:source	pwn30:13857159-n .

<i109746>	a	<Concept> ;
	skos:definition	"a relation between two opposite states or principles that together exhaust the possibilities"@en ;
	dc:source	pwn30:13857314-n .

<i109747>	a	<Concept> ;
	skos:definition	"the relation that exists when opposites cannot coexist"@en ;
	dc:source	pwn30:13857486-n .

<i109748>	a	<Concept> ;
	skos:definition	"opposition between two conflicting forces or ideas"@en ;
	dc:source	pwn30:13857676-n .

<i109749>	a	<Concept> ;
