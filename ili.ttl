	skos:definition	"last 2 million years"@en ;
	dc:source	pwn30:15124545-n .

<i116679>	a	<Instance> ;
	skos:definition	"approximately the last 10,000 years"@en ;
	dc:source	pwn30:15124713-n .

<i116680>	a	<Instance> ;
	skos:definition	"from two million to 11 thousand years ago; extensive glaciation of the northern hemisphere; the time of human evolution"@en ;
	dc:source	pwn30:15124864-n .

<i116681>	a	<Instance> ;
	skos:definition	"from 63 million to 2 million years ago"@en ;
	dc:source	pwn30:15125097-n .

<i116682>	a	<Instance> ;
	skos:definition	"from 13 million to 2 million years ago; growth of mountains; cooling of climate; more and larger mammals"@en ;
	dc:source	pwn30:15125323-n .

<i116683>	a	<Instance> ;
	skos:definition	"from 25 million to 13 million years ago; appearance of grazing mammals"@en ;
	dc:source	pwn30:15125519-n .

<i116684>	a	<Instance> ;
	skos:definition	"from 40 million to 25 million years ago; appearance of sabertoothed cats"@en ;
	dc:source	pwn30:15125679-n .

<i116685>	a	<Instance> ;
	skos:definition	"from 58 million to 40 million years ago; presence of modern mammals"@en ;
	dc:source	pwn30:15125845-n .

<i116686>	a	<Instance> ;
	skos:definition	"from 63 million to 58 million years ago; appearance of birds and earliest mammals"@en ;
	dc:source	pwn30:15126000-n .

<i116687>	a	<Instance> ;
	skos:definition	"from 230 million to 63 million years ago"@en ;
	dc:source	pwn30:15126175-n .

<i116688>	a	<Instance> ;
	skos:definition	"from 135 million to 63 million years ago; end of the age of reptiles; appearance of modern insects and flowering plants"@en ;
	dc:source	pwn30:15126361-n .

<i116689>	a	<Instance> ;
	skos:definition	"from 190 million to 135 million years ago; dinosaurs; conifers"@en ;
	dc:source	pwn30:15126595-n .

<i116690>	a	<Instance> ;
	skos:definition	"from 230 million to 190 million years ago; dinosaurs, marine reptiles; volcanic activity"@en ;
	dc:source	pwn30:15126750-n .

<i116691>	a	<Instance> ;
	skos:definition	"from 544 million to about 230 million years ago"@en ;
	dc:source	pwn30:15126931-n .

<i116692>	a	<Instance> ;
	skos:definition	"from 280 million to 230 million years ago; reptiles"@en ;
	dc:source	pwn30:15127165-n .

<i116693>	a	<Instance> ;
	skos:definition	"from 345 million to 280 million years ago"@en ;
	dc:source	pwn30:15127307-n .

<i116694>	a	<Instance> ;
	skos:definition	"from 310 million to 280 million years ago; warm climate; swampy land"@en ;
	dc:source	pwn30:15127507-n .

<i116695>	a	<Instance> ;
	skos:definition	"from 345 million to 310 million years ago; increase of land areas; primitive ammonites; winged insects"@en ;
	dc:source	pwn30:15127729-n .

<i116696>	a	<Instance> ;
	skos:definition	"from 405 million to 345 million years ago; preponderance of fishes and appearance of amphibians and ammonites"@en ;
	dc:source	pwn30:15127982-n .

<i116697>	a	<Instance> ;
	skos:definition	"from 425 million to 405 million years ago; first air-breathing animals"@en ;
	dc:source	pwn30:15128200-n .

<i116698>	a	<Instance> ;
	skos:definition	"from 500 million to 425 million years ago; conodonts and ostracods and algae and seaweeds"@en ;
	dc:source	pwn30:15128363-n .

<i116699>	a	<Instance> ;
	skos:definition	"from 544 million to about 500 million years ago; marine invertebrates"@en ;
	dc:source	pwn30:15128549-n .

<i116700>	a	<Instance> ;
	skos:definition	"the eon following the Hadean time and preceding the Phanerozoic eon; from about 3,800 million years ago until 544 million years ago"@en ;
	dc:source	pwn30:15128711-n .

<i116701>	a	<Instance> ;
	skos:definition	"from 2,500 to 544 million years ago; bacteria and fungi; primitive multicellular organisms"@en ;
	dc:source	pwn30:15128997-n .

<i116702>	a	<Instance> ;
	skos:definition	"the time from 3,800 million years to 2,500 million years ago; earth's crust formed; unicellular organisms are earliest forms of life"@en ;
	dc:source	pwn30:15129220-n .

<i116703>	a	<Instance> ;
	skos:definition	"the earliest eon in the history of the Earth from the first accretion of planetary material (around 4,600 million years ago) until the date of the oldest known rocks (about 3,800 million years ago); no evidence of life"@en ;
	dc:source	pwn30:15129572-n .

<i116704>	a	<Concept> ;
	skos:definition	"a reading of a point in time as given by a clock"@en ;
	dc:source	pwn30:15129927-n .

<i116705>	a	<Concept> ;
	skos:definition	"the local time at the 0 meridian passing through Greenwich, England; it is the same everywhere"@en ;
	dc:source	pwn30:15130205-n .

<i116706>	a	<Concept> ;
	skos:definition	"Greenwich Mean Time updated with leap seconds"@en ;
	dc:source	pwn30:15130434-n .

<i116707>	a	<Concept> ;
	skos:definition	"the coordinated universal time when an event is received on Earth"@en ;
	dc:source	pwn30:15130612-n .

<i116708>	a	<Concept> ;
	skos:definition	"the elapsed time it takes for light (or radio signals) to travel between the Earth and a celestial object"@en ;
	dc:source	pwn30:15130749-n .

<i116709>	a	<Concept> ;
	skos:definition	"the elapsed time it takes for a signal to travel from Earth to a spacecraft (or other body) and back to the starting point"@en ;
	dc:source	pwn30:15130926-n .

<i116710>	a	<Concept> ;
	skos:definition	"the time that elapses while some event is occurring"@en ;
	dc:source	pwn30:15131123-n .

<i116711>	a	<Concept> ;
	skos:definition	"the coordinated universal time when a transmission is sent from Earth to a spacecraft or other celestial body"@en ;
	dc:source	pwn30:15131269-n .

<i116712>	a	<Concept> ;
	skos:definition	"the coordinated universal time on board the spacecraft"@en ;
	dc:source	pwn30:15131448-n .

<i116713>	a	<Concept> ;
	skos:definition	"the clock time given by a clock carried on board a spacecraft"@en ;
	dc:source	pwn30:15131598-n .

<i116714>	a	<Concept> ;
	skos:definition	"standard time in the 4th time zone west of Greenwich, reckoned at the 60th meridian; used in Puerto Rico and the Virgin Islands and Bermuda and the Canadian Maritime Provinces"@en ;
	dc:source	pwn30:15131734-n .

<i116715>	a	<Concept> ;
	skos:definition	"standard time in the 5th time zone west of Greenwich, reckoned at the 75th meridian; used in the eastern United States"@en ;
	dc:source	pwn30:15131994-n .

<i116716>	a	<Concept> ;
	skos:definition	"standard time in the 6th time zone west of Greenwich, reckoned at the 90th meridian; used in the central United States"@en ;
	dc:source	pwn30:15132201-n .

<i116717>	a	<Concept> ;
	skos:definition	"standard time in the 7th time zone west of Greenwich, reckoned at the 105th meridian west; used in the mountain states of the United States"@en ;
