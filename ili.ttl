	dc:source	pwn30:15121406-n .

<i116664>	a	<Concept> ;
	skos:definition	"the time yet to come"@en ;
	dc:source	pwn30:15121625-n .

<i116665>	a	<Concept> ;
	skos:definition	"the end of time"@en ;
	dc:source	pwn30:15121880-n .

<i116666>	a	<Concept> ;
	skos:definition	"(music) the beat of musical rhythm"@en ;
	dc:source	pwn30:15122011-n .

<i116667>	a	<Concept> ;
	skos:definition	"an indefinite period (usually marked by specific attributes or activities)"@en ;
	dc:source	pwn30:15122231-n .

<i116668>	a	<Instance> ;
	skos:definition	"a period in British history during the reign of Elizabeth I in the 16th century; an age marked by literary achievement and domestic prosperity"@en ;
	dc:source	pwn30:15122648-n .

<i116669>	a	<Instance> ;
	skos:definition	"a period in British history during the reign of Queen Victoria in the 19th century; her character and moral standards restored the prestige of the British monarchy but gave the era a prudish reputation"@en ;
	dc:source	pwn30:15122853-n .

<i116670>	a	<Concept> ;
	skos:definition	"some point or period in time"@en ;
	dc:source	pwn30:15123115-n .

<i116671>	a	<Concept> ;
	skos:definition	"a time when coldness (or some other quality associated with death) is intense"@en ;
	dc:source	pwn30:15123362-n .

<i116672>	a	<Concept> ;
	skos:definition	"a time of difficulty"@en ;
	dc:source	pwn30:15123512-n .

<i116673>	a	<Concept> ;
	skos:definition	"time passed in a particular bodily form"@en ;
	dc:source	pwn30:15123589-n .

<i116674>	a	<Concept> ;
	skos:definition	"a continuous nonspatial whole or extent or succession in which no part or portion is distinct or distinguishable from adjacent parts"@en ;
	dc:source	pwn30:15123754-n .

<i116675>	a	<Concept> ;
	skos:definition	"the continuum of events occurring in succession leading from the past to the present and even into the future"@en ;
	dc:source	pwn30:15123996-n .

