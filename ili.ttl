	dc:source	pwn30:13815449-n .

<i109507>	a	<Concept> ;
	skos:definition	"the quotient obtained when the magnitude of a part is divided by the magnitude of the whole"@en ;
	dc:source	pwn30:13815742-n .

<i109508>	a	<Concept> ;
