	dc:source	pwn30:06479374-n .

<i70507>	a	<Concept> ;
	skos:definition	"a certificate saying that the holder is qualified to teach in the public schools"@en ;
	dc:source	pwn30:06479494-n .

<i70508>	a	<Concept> ;
