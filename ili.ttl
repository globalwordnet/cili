	dc:source	pwn30:15110666-n .

<i116618>	a	<Concept> ;
	skos:definition	"any substance involved in metabolism (either as a product of metabolism or as necessary for metabolism)"@en ;
	dc:source	pwn30:15110796-n .

<i116619>	a	<Concept> ;
	skos:definition	"matter produced by plants or growing in the manner of a plant"@en ;
	dc:source	pwn30:15110956-n .

<i116620>	a	<Concept> ;
