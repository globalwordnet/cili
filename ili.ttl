	dc:source	pwn30:01193044-n .

<i41641>	a	<Concept> ;
	skos:definition	"an ordinary verdict declaring which party prevails without any special findings of fact"@en ;
	dc:source	pwn30:01193176-n .

<i41642>	a	<Concept> ;
	skos:definition	"(criminal law) a finding that the defendant is guilty of some charges but innocent of others"@en ;
	dc:source	pwn30:01193362-n .

<i41643>	a	<Concept> ;
	skos:definition	"an improper and unacceptable kind of compromise verdict"@en ;
	dc:source	pwn30:01193535-n .

<i41644>	a	<Concept> ;
	skos:definition	"a verdict rendered on certain specific factual issues posed by the court without finding for one party or the other"@en ;
