	skos:definition	"a fungus having an acutely conic cap and dry stalks"@en ;
	dc:source	pwn30:13070875-n .

<i105406>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Hygrophoraceae"@en ;
	dc:source	pwn30:13071029-n .

<i105407>	a	<Concept> ;
	skos:definition	"a fungus with a white convex cap and arcuate white gills and a stalk that tapers toward the base"@en ;
	dc:source	pwn30:13071371-n .

<i105408>	a	<Concept> ;
