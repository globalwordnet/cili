<i66000>	a	<Concept> ;
	skos:definition	"a salivary gland inside the lower jaw on either side that produces most of the nocturnal saliva; discharges saliva into the mouth under the tongue"@en ;
	dc:source	pwn30:05533635-n .

<i66001>	a	<Concept> ;
	skos:definition	"the passage between the pharynx and the stomach"@en ;
	dc:source	pwn30:05533948-n .

<i66002>	a	<Concept> ;
	skos:definition	"the short part of the esophagus extending downward from the diaphragm to the stomach"@en ;
	dc:source	pwn30:05534174-n .

<i66003>	a	<Concept> ;
	skos:definition	"the part of the alimentary canal between the stomach and the anus"@en ;
	dc:source	pwn30:05534333-n .

<i66004>	a	<Concept> ;
	skos:definition	"the caudal part of the alimentary canal in vertebrate embryos"@en ;
	dc:source	pwn30:05534578-n .

<i66005>	a	<Concept> ;
	skos:definition	"the longest part of the alimentary canal; where digestion is completed"@en ;
	dc:source	pwn30:05534712-n .

<i66006>	a	<Concept> ;
	skos:definition	"the part of the small intestine between the stomach and the jejunum"@en ;
	dc:source	pwn30:05534955-n .

<i66007>	a	<Concept> ;
	skos:definition	"a small circular opening between the stomach and the duodenum"@en ;
	dc:source	pwn30:05535095-n .

<i66008>	a	<Concept> ;
	skos:definition	"the part of the small intestine between the duodenum and the ileum"@en ;
	dc:source	pwn30:05535247-n .

<i66009>	a	<Concept> ;
	skos:definition	"the part of the small intestine between the jejunum and the cecum"@en ;
	dc:source	pwn30:05535367-n .

<i66010>	a	<Concept> ;
	skos:definition	"beginning with the cecum and ending with the rectum; includes the cecum and the colon and the rectum; extracts moisture from food residues which are later excreted as feces"@en ;
	dc:source	pwn30:05535484-n .

<i66011>	a	<Concept> ;
	skos:definition	"the part of the large intestine between the cecum and the rectum; it extracts moisture from food residues before they are excreted"@en ;
	dc:source	pwn30:05535869-n .

<i66012>	a	<Concept> ;
	skos:definition	"an abnormal enlargement of the colon; can be congenital (as in Hirschsprung's disease) or acquired (as when children refuse to defecate)"@en ;
	dc:source	pwn30:05536178-n .

<i66013>	a	<Concept> ;
	skos:definition	"the cavity in which the large intestine begins and into which the ileum opens"@en ;
	dc:source	pwn30:05536370-n .

<i66014>	a	<Concept> ;
	skos:definition	"valve between the ileum of the small intestine and the cecum of the large intestine; prevents material from flowing back from the large to the small intestine"@en ;
	dc:source	pwn30:05536638-n .

<i66015>	a	<Concept> ;
	skos:definition	"the part of the large intestine that extends across the abdominal cavity and joins the ascending to the descending colon"@en ;
	dc:source	pwn30:05536858-n .

<i66016>	a	<Concept> ;
	skos:definition	"the part of the large intestine that ascends from the cecum to the transverse colon"@en ;
	dc:source	pwn30:05537060-n .

<i66017>	a	<Concept> ;
	skos:definition	"the part of the large intestine that descends from the transverse colon to the sigmoid colon"@en ;
	dc:source	pwn30:05537243-n .

<i66018>	a	<Concept> ;
	skos:definition	"the s-shaped curve between the descending colon and the rectum"@en ;
	dc:source	pwn30:05537417-n .

<i66019>	a	<Concept> ;
	skos:definition	"a vestigial process that extends from the lower end of the cecum and that resembles a small pouch"@en ;
	dc:source	pwn30:05537576-n .

<i66020>	a	<Concept> ;
	skos:definition	"the terminal section of the alimentary canal; from the sigmoid flexure to the anus"@en ;
	dc:source	pwn30:05537806-n .

<i66021>	a	<Concept> ;
	skos:definition	"the excretory opening at the end of the alimentary canal"@en ;
	dc:source	pwn30:05538016-n .

<i66022>	a	<Concept> ;
	skos:definition	"vulgar slang for anus"@en ;
	dc:source	pwn30:05538215-n .

<i66023>	a	<Concept> ;
	skos:definition	"a congenital defect of the anus; there is partial or complete obstruction of the anal opening"@en ;
	dc:source	pwn30:05538338-n .

<i66024>	a	<Concept> ;
	skos:definition	"the general region between the anus and the genital organs"@en ;
	dc:source	pwn30:05538494-n .

<i66025>	a	<Concept> ;
	skos:definition	"the upper part of the human body or the front part of the body in animals; contains the face and brains"@en ;
	dc:source	pwn30:05538625-n .

<i66026>	a	<Concept> ;
	skos:definition	"the part of the head between the ears"@en ;
	dc:source	pwn30:05539012-n .

<i66027>	a	<Concept> ;
	skos:definition	"the head of a human being"@en ;
	dc:source	pwn30:05539138-n .

<i66028>	a	<Concept> ;
	skos:definition	"a head shaped like a bullet"@en ;
	dc:source	pwn30:05539370-n .

<i66029>	a	<Concept> ;
	skos:definition	"informal terms for a human head"@en ;
	dc:source	pwn30:05539454-n .

<i66030>	a	<Concept> ;
	skos:definition	"the top of the head"@en ;
	dc:source	pwn30:05539595-n .

<i66031>	a	<Concept> ;
	skos:definition	"the shaved crown of a monk's or priest's head"@en ;
	dc:source	pwn30:05539717-n .

<i66032>	a	<Concept> ;
	skos:definition	"the muscle and aponeurosis and skin covering the cranium"@en ;
	dc:source	pwn30:05539834-n .

<i66033>	a	<Concept> ;
	skos:definition	"the skin that covers the top of the head"@en ;
	dc:source	pwn30:05539947-n .

<i66034>	a	<Concept> ;
	skos:definition	"the bony skeleton of the head of vertebrates"@en ;
	dc:source	pwn30:05540121-n .

<i66035>	a	<Concept> ;
	skos:definition	"the dome of the skull"@en ;
	dc:source	pwn30:05540407-n .

<i66036>	a	<Concept> ;
	skos:definition	"the part of the skull that encloses the brain"@en ;
	dc:source	pwn30:05540513-n .

<i66037>	a	<Concept> ;
	skos:definition	"back part of the head or skull"@en ;
	dc:source	pwn30:05540976-n .

<i66038>	a	<Concept> ;
	skos:definition	"the front part of the head or skull (including the forehead)"@en ;
	dc:source	pwn30:05541097-n .

<i66039>	a	<Concept> ;
	skos:definition	"the large cranial bone forming the front part of the cranium: includes the upper part of the orbits"@en ;
	dc:source	pwn30:05541231-n .

<i66040>	a	<Concept> ;
	skos:definition	"either prominence of the frontal bone above each orbit"@en ;
	dc:source	pwn30:05541509-n .

<i66041>	a	<Concept> ;
	skos:definition	"either of two skull bones between the frontal and occipital bones and forming the top and sides of the cranium"@en ;
	dc:source	pwn30:05541645-n .

<i66042>	a	<Concept> ;
	skos:definition	"a saucer-shaped membrane bone that forms the back of the skull"@en ;
	dc:source	pwn30:05541872-n .

<i66043>	a	<Concept> ;
	skos:definition	"prominence on the outer surface of the occipital bone"@en ;
	dc:source	pwn30:05542052-n .

<i66044>	a	<Concept> ;
	skos:definition	"process of the temporal bone behind the ear at the base of the skull"@en ;
	dc:source	pwn30:05542193-n .

<i66045>	a	<Concept> ;
	skos:definition	"extends from the base of the temporal bone"@en ;
	dc:source	pwn30:05542416-n .

<i66046>	a	<Concept> ;
	skos:definition	"two bony processes descending from the body of the sphenoid bone"@en ;
	dc:source	pwn30:05542539-n .

<i66047>	a	<Concept> ;
	skos:definition	"a protuberance on a bone especially for attachment of a muscle or ligament"@en ;
	dc:source	pwn30:05542686-n .

<i66048>	a	<Concept> ;
	skos:definition	"an immovable joint (especially between the bones of the skull)"@en ;
	dc:source	pwn30:05542893-n .

<i66049>	a	<Concept> ;
	skos:definition	"a joint so articulated as to move freely"@en ;
	dc:source	pwn30:05543177-n .

<i66050>	a	<Concept> ;
	skos:definition	"corresponds to the bregma when bones have ossified"@en ;
	dc:source	pwn30:05543425-n .

<i66051>	a	<Concept> ;
	skos:definition	"the irregularly shaped area on either side of the cranium where the frontal bone and the anterior tip of the parietal bone and the temporal bone and the greater wing of the sphenoid bone meet; corresponds to the pterion when bones have ossified"@en ;
	dc:source	pwn30:05543541-n .

<i66052>	a	<Concept> ;
	skos:definition	"the suture between the parietal and frontal bones of the skull"@en ;
	dc:source	pwn30:05543917-n .

<i66053>	a	<Concept> ;
	skos:definition	"the suture between two halves of the frontal bone (usually obliterated by the age of 6)"@en ;
	dc:source	pwn30:05544078-n .

<i66054>	a	<Concept> ;
	skos:definition	"the suture between the two maxillae of the upper jawbone"@en ;
	dc:source	pwn30:05544264-n .

<i66055>	a	<Concept> ;
	skos:definition	"the suture between the two nasal bones"@en ;
	dc:source	pwn30:05544432-n .

<i66056>	a	<Concept> ;
	skos:definition	"the suture between the occipital and parietal bones"@en ;
	dc:source	pwn30:05544575-n .

<i66057>	a	<Concept> ;
	skos:definition	"the suture between the occipital and the temporal bones; a continuation of the lamboid suture"@en ;
	dc:source	pwn30:05544725-n .

<i66058>	a	<Concept> ;
	skos:definition	"the suture between the parietal and the temporal bones"@en ;
	dc:source	pwn30:05544906-n .

<i66059>	a	<Concept> ;
	skos:definition	"the suture uniting the two parietal bones"@en ;
	dc:source	pwn30:05545047-n .

<i66060>	a	<Concept> ;
	skos:definition	"any membranous gap between the bones of the cranium in an infant or fetus"@en ;
	dc:source	pwn30:05545212-n .

<i66061>	a	<Concept> ;
	skos:definition	"a natural opening or perforation through a bone or a membranous structure"@en ;
	dc:source	pwn30:05545439-n .

<i66062>	a	<Concept> ;
	skos:definition	"the small opening (on both the right and left sides) that connects the third ventricle in the diencephalon with the lateral ventricle in the cerebral hemisphere"@en ;
	dc:source	pwn30:05545611-n .

<i66063>	a	<Concept> ;
	skos:definition	"the large opening at the base of the cranium through which the spinal cord passes"@en ;
	dc:source	pwn30:05545879-n .

<i66064>	a	<Concept> ;
	skos:definition	"the part of the skull of a vertebrate that frames the mouth and holds the teeth"@en ;
	dc:source	pwn30:05546040-n .

<i66065>	a	<Concept> ;
	skos:definition	"a jaw"@en ;
	dc:source	pwn30:05546298-n .

<i66066>	a	<Concept> ;
	skos:definition	"a slender process of the temporal bone that strengthens the zygomatic arch"@en ;
	dc:source	pwn30:05546383-n .

<i66067>	a	<Concept> ;
	skos:definition	"the part of an organism (human or animal) that connects the head to the rest of the body"@en ;
	dc:source	pwn30:05546540-n .

<i66068>	a	<Concept> ;
	skos:definition	"an external body part consisting of feathers or hair about the neck of a bird or other animal"@en ;
	dc:source	pwn30:05546997-n .

<i66069>	a	<Concept> ;
	skos:definition	"(paleontology) a bony plate that curves upward behind the skull of many ceratopsian dinosaurs"@en ;
	dc:source	pwn30:05547149-n .

<i66070>	a	<Concept> ;
	skos:definition	"a thick short powerful neck"@en ;
	dc:source	pwn30:05547313-n .

<i66071>	a	<Concept> ;
	skos:definition	"the back side of the neck"@en ;
	dc:source	pwn30:05547396-n .

<i66072>	a	<Concept> ;
	skos:definition	"the passage to the stomach and lungs; in the front part of the neck below the chin and above the collarbone"@en ;
	dc:source	pwn30:05547508-n .

<i66073>	a	<Concept> ;
	skos:definition	"the passage between the back of the mouth and the pharynx"@en ;
	dc:source	pwn30:05547904-n .

<i66074>	a	<Concept> ;
	skos:definition	"an abnormal passage leading from a suppurating cavity to the body surface"@en ;
	dc:source	pwn30:05548032-n .

<i66075>	a	<Concept> ;
	skos:definition	"a surgically created shunt (usually around a damaged part)"@en ;
	dc:source	pwn30:05548203-n .

<i66076>	a	<Concept> ;
	skos:definition	"shunt that is created surgically between the portal vein and the inferior vena cava so that blood from the abdominal organs can bypass the liver"@en ;
	dc:source	pwn30:05548314-n .

<i66077>	a	<Concept> ;
	skos:definition	"a passage by which a bodily fluid (especially blood) is diverted from one channel to another"@en ;
	dc:source	pwn30:05548521-n .

<i66078>	a	<Concept> ;
	skos:definition	"a cavity having the shape of a tube"@en ;
	dc:source	pwn30:05548726-n .

<i66079>	a	<Concept> ;
	skos:definition	"the part of the body between the neck and the upper arm"@en ;
	dc:source	pwn30:05548840-n .

<i66080>	a	<Concept> ;
	skos:definition	"a ball-and-socket joint between the head of the humerus and a cavity of the scapula"@en ;
	dc:source	pwn30:05549061-n .

<i66081>	a	<Concept> ;
	skos:definition	"a large triangular muscle covering the shoulder joint and serving to abduct and flex and extend and rotate the arm"@en ;
	dc:source	pwn30:05549350-n .

<i66082>	a	<Concept> ;
	skos:definition	"the hollow under the arm where it is joined to the shoulder"@en ;
	dc:source	pwn30:05549576-n .

<i66083>	a	<Concept> ;
	skos:definition	"the body excluding the head and neck and limbs"@en ;
	dc:source	pwn30:05549830-n .

<i66084>	a	<Concept> ;
	skos:definition	"any of several muscles of the trunk"@en ;
	dc:source	pwn30:05550330-n .

<i66085>	a	<Concept> ;
	skos:definition	"muscles that rotate the scapula and elevate the rib cage"@en ;
	dc:source	pwn30:05550494-n .

<i66086>	a	<Concept> ;
	skos:definition	"skeletal muscle that draws the rib cage backward and downward"@en ;
	dc:source	pwn30:05550688-n .

<i66087>	a	<Concept> ;
	skos:definition	"a thin quadrilateral muscle at the junction of the thoracic and lumbar regions; acts to counteract the pull of the diaphragm on the ribs to which it is attached"@en ;
	dc:source	pwn30:05550908-n .

<i66088>	a	<Concept> ;
	skos:definition	"a thin quadrilateral muscle of the upper and dorsal part of the thorax; acts to elevate the upper ribs"@en ;
	dc:source	pwn30:05551142-n .

<i66089>	a	<Concept> ;
	skos:definition	"either the left or right half of a body"@en ;
	dc:source	pwn30:05551318-n .

<i66090>	a	<Concept> ;
	skos:definition	"the chest of a woman"@en ;
	dc:source	pwn30:05551494-n .

<i66091>	a	<Concept> ;
	skos:definition	"the chest of a man"@en ;
	dc:source	pwn30:05551617-n .

<i66092>	a	<Concept> ;
	skos:definition	"either of two large muscles of the chest"@en ;
	dc:source	pwn30:05551711-n .

<i66093>	a	<Concept> ;
	skos:definition	"a skeletal muscle that adducts and rotates the arm"@en ;
	dc:source	pwn30:05551939-n .

<i66094>	a	<Concept> ;
	skos:definition	"a skeletal muscle that draws down the scapula or raises the ribs"@en ;
	dc:source	pwn30:05552106-n .

<i66095>	a	<Concept> ;
	skos:definition	"muscles between the ribs; they contract during inspiration"@en ;
	dc:source	pwn30:05552287-n .

<i66096>	a	<Concept> ;
	skos:definition	"any skeletal muscle that draws a body part down"@en ;
	dc:source	pwn30:05552467-n .

<i66097>	a	<Concept> ;
	skos:definition	"the part of the human torso between the neck and the diaphragm or the corresponding part in other vertebrates"@en ;
	dc:source	pwn30:05552607-n .

<i66098>	a	<Concept> ;
	skos:definition	"the cavity in the vertebrate body enclosed by the ribs between the diaphragm and the neck and containing the lungs and heart"@en ;
	dc:source	pwn30:05553049-n .

<i66099>	a	<Concept> ;
	skos:definition	"the front of the trunk from the neck to the abdomen"@en ;
	dc:source	pwn30:05553288-n .

<i66100>	a	<Concept> ;
	skos:definition	"a person's breast or chest"@en ;
	dc:source	pwn30:05553486-n .

<i66101>	a	<Concept> ;
	skos:definition	"the middle region of the body of an arthropod between the head and the abdomen"@en ;
	dc:source	pwn30:05553618-n .

<i66102>	a	<Concept> ;
	skos:definition	"the bony enclosing wall of the chest"@en ;
	dc:source	pwn30:05553768-n .

<i66103>	a	<Concept> ;
	skos:definition	"the line formed by a groove between two parts (especially the separation between a woman's breasts)"@en ;
	dc:source	pwn30:05553897-n .

<i66104>	a	<Concept> ;
	skos:definition	"ducts of the mammary gland that carry milk to the nipple"@en ;
	dc:source	pwn30:05554051-n .

<i66105>	a	<Concept> ;
