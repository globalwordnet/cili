	dc:source	pwn30:05307521-n .

<i64849>	a	<Concept> ;
	skos:definition	"a tooth for cutting or gnawing; located in the front of the mouth in both jaws"@en ;
	dc:source	pwn30:05307641-n .

<i64850>	a	<Concept> ;
