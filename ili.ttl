	dc:source	pwn30:06183745-n .

<i69036>	a	<Concept> ;
	skos:definition	"a particular system or school of religious beliefs and teachings"@en ;
	dc:source	pwn30:06183899-n .

<i69037>	a	<Concept> ;
	skos:definition	"the teachings of Christian churches"@en ;
	dc:source	pwn30:06184270-n .

<i69038>	a	<Concept> ;
	skos:definition	"the branch of theology concerned with the person and attributes and deeds of Christ"@en ;
	dc:source	pwn30:06184574-n .

<i69039>	a	<Concept> ;
	skos:definition	"a form of Christian theology (developed by South American Roman Catholics) that emphasizes social and political liberation as the anticipation of ultimate salvation"@en ;
	dc:source	pwn30:06184733-n .

<i69040>	a	<Concept> ;
