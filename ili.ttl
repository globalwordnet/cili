<i86591>	a	<Concept> ;
	skos:definition	"one of a group of Celtic sea demons sometimes associated with the hostile power of nature"@en ;
	dc:source	pwn30:09509375-n .

<i86592>	a	<Instance> ;
	skos:definition	"Celtic sky god; a magician; giver of arts and civilization"@en ;
	dc:source	pwn30:09509546-n .

<i86593>	a	<Instance> ;
	skos:definition	"Celtic underworld god"@en ;
	dc:source	pwn30:09509678-n .

<i86594>	a	<Concept> ;
	skos:definition	"the sea personified; father of Manannan; corresponds to Welsh Llyr"@en ;
	dc:source	pwn30:09509770-n .

<i86595>	a	<Concept> ;
	skos:definition	"son of Gwydion and Arianrhod; supported by magic of Gwydion; cursed by Arianrhod"@en ;
	dc:source	pwn30:09509911-n .

<i86596>	a	<Instance> ;
	skos:definition	"a Celtic warrior god"@en ;
	dc:source	pwn30:09510073-n .

<i86597>	a	<Instance> ;
	skos:definition	"Celtic deity who was the father of Manawydan; corresponds to Irish Lir"@en ;
	dc:source	pwn30:09510164-n .

<i86598>	a	<Instance> ;
	skos:definition	"ancient Celtic god"@en ;
	dc:source	pwn30:09510305-n .

<i86599>	a	<Instance> ;
	skos:definition	"Celtic god of the sea; son of Ler"@en ;
	dc:source	pwn30:09510419-n .

<i86600>	a	<Instance> ;
	skos:definition	"Celtic sea god; son of Llyr"@en ;
	dc:source	pwn30:09510527-n .

<i86601>	a	<Instance> ;
	skos:definition	"Celtic war goddess"@en ;
	dc:source	pwn30:09510643-n .

<i86602>	a	<Concept> ;
	skos:definition	"race of Celtic gods or demigods; ruled Ireland in the Golden Age"@en ;
	dc:source	pwn30:09510746-n .

<i86603>	a	<Concept> ;
	skos:definition	"a deity worshipped by the ancient Egyptians"@en ;
	dc:source	pwn30:09510904-n .

<i86604>	a	<Concept> ;
	skos:definition	"a primeval Egyptian personification of air and breath; worshipped especially at Thebes"@en ;
	dc:source	pwn30:09511368-n .

<i86605>	a	<Instance> ;
	skos:definition	"Egyptian sun god; supreme god of the universe in whom Amen and Ra were merged; principal deity during Theban supremacy"@en ;
	dc:source	pwn30:09511519-n .

<i86606>	a	<Instance> ;
	skos:definition	"Egyptian god of tombs and ruler of the underworld; usually depicted as a man with the head of a jackal"@en ;
	dc:source	pwn30:09511712-n .

<i86607>	a	<Instance> ;
	skos:definition	"the sun (or solar disc) which was the deity of a monotheistic cult under the Pharaoh Akhenaten"@en ;
	dc:source	pwn30:09511875-n .

<i86608>	a	<Instance> ;
	skos:definition	"cat- or lion-headed Egyptian goddess; represents life-giving power of the sun"@en ;
	dc:source	pwn30:09512028-n .

<i86609>	a	<Instance> ;
	skos:definition	"Egyptian god of the earth; father of Osiris and Isis"@en ;
	dc:source	pwn30:09512157-n .

<i86610>	a	<Instance> ;
	skos:definition	"Egyptian solar god with the head of a falcon; the son of Osiris and Isis"@en ;
	dc:source	pwn30:09512266-n .

<i86611>	a	<Instance> ;
	skos:definition	"Egyptian goddess of fertility; daughter of Geb; sister and wife of Osiris"@en ;
	dc:source	pwn30:09512391-n .

<i86612>	a	<Instance> ;
	skos:definition	"Egyptian god of the morning sun; creator"@en ;
	dc:source	pwn30:09512516-n .

<i86613>	a	<Instance> ;
	skos:definition	"an Egyptian god of procreation"@en ;
	dc:source	pwn30:09512611-n .

<i86614>	a	<Instance> ;
	skos:definition	"Egyptian goddess associated with ritual of the dead; sister of Geb and Nut; wife of Set"@en ;
	dc:source	pwn30:09512692-n .

<i86615>	a	<Instance> ;
	skos:definition	"Egyptian goddess of the sky"@en ;
	dc:source	pwn30:09512835-n .

<i86616>	a	<Instance> ;
	skos:definition	"Egyptian god of the underworld and judge of the dead; husband and brother of Isis; father of Horus"@en ;
	dc:source	pwn30:09512913-n .

<i86617>	a	<Instance> ;
	skos:definition	"a major Egyptian god; shaper of the world; father of gods and men; worshipped especially at Memphis"@en ;
	dc:source	pwn30:09513065-n .

<i86618>	a	<Instance> ;
	skos:definition	"ancient Egyptian sun god with the head of a hawk; a universal creator; he merged with the god Amen as Amen-Ra to become the king of the gods"@en ;
	dc:source	pwn30:09513216-n .

<i86619>	a	<Instance> ;
	skos:definition	"a lion-headed Egyptian goddess; typifies life-destroying power of the sun"@en ;
	dc:source	pwn30:09513430-n .

<i86620>	a	<Instance> ;
	skos:definition	"evil Egyptian god with the head of a beast that has high square ears and a long snout; brother and murderer of Osiris"@en ;
	dc:source	pwn30:09513569-n .

<i86621>	a	<Instance> ;
	skos:definition	"Egyptian Moon deity with the head of an ibis; god of wisdom and learning and the arts; scribe of the gods"@en ;
	dc:source	pwn30:09513744-n .

<i86622>	a	<Concept> ;
	skos:definition	"a deity worshipped by the ancient Semites"@en ;
	dc:source	pwn30:09513902-n .

<i86623>	a	<Instance> ;
	skos:definition	"Babylonian god of storms and wind"@en ;
	dc:source	pwn30:09515027-n .

<i86624>	a	<Instance> ;
	skos:definition	"a Babylonian demigod or first man (sometimes identified with Adam)"@en ;
	dc:source	pwn30:09515131-n .

<i86625>	a	<Instance> ;
	skos:definition	"the Babylonian father of the gods; identified with Assyrian Ashur; in Sumerian the name signifies `the totality of the upper world'"@en ;
	dc:source	pwn30:09515269-n .

<i86626>	a	<Instance> ;
	skos:definition	"Babylonian consort of Anu"@en ;
	dc:source	pwn30:09515473-n .

<i86627>	a	<Instance> ;
	skos:definition	"Babylonian god of the sky; one of the supreme triad including Bel and Ea"@en ;
	dc:source	pwn30:09515570-n .

<i86628>	a	<Concept> ;
	skos:definition	"any of a group of powerful Babylonian earth spirits or genii; servitors of the gods"@en ;
	dc:source	pwn30:09515712-n .

<i86629>	a	<Instance> ;
	skos:definition	"father of the gods and consort of Tiamat"@en ;
	dc:source	pwn30:09515877-n .

<i86630>	a	<Instance> ;
	skos:definition	"mother and earth goddess in Gilgamish epic; identified with Sumerian Ki and Ninkhursag"@en ;
	dc:source	pwn30:09515988-n .

<i86631>	a	<Instance> ;
	skos:definition	"chief god of the Assyrians; god of military prowess and empire; identified with Babylonian Anshar"@en ;
	dc:source	pwn30:09516146-n .

<i86632>	a	<Instance> ;
	skos:definition	"an ancient Phoenician goddess of love and fertility; the Phoenician counterpart to Ishtar"@en ;
	dc:source	pwn30:09516323-n .

<i86633>	a	<Instance> ;
	skos:definition	"Babylonian and Assyrian goddess of love and fertility and war; counterpart to the Phoenician Astarte"@en ;
	dc:source	pwn30:09516498-n .

<i86634>	a	<Instance> ;
	skos:definition	"any of numerous local fertility and nature deities worshipped by ancient Semitic peoples; the Hebrews considered Baal a false god"@en ;
	dc:source	pwn30:09516700-n .

<i86635>	a	<Instance> ;
	skos:definition	"Babylonian god of the earth; one of the supreme triad including Anu and Ea; earlier identified with En-lil"@en ;
	dc:source	pwn30:09516881-n .

<i86636>	a	<Instance> ;
	skos:definition	"god of agriculture and the earth; national god of Philistines"@en ;
	dc:source	pwn30:09517057-n .

<i86637>	a	<Instance> ;
	skos:definition	"god of agriculture and earth; counterpart of Phoenician Dagon"@en ;
	dc:source	pwn30:09517209-n .

<i86638>	a	<Instance> ;
	skos:definition	"(Babylonian) earth goddess; consort of Ea and mother of Marduk"@en ;
	dc:source	pwn30:09517342-n .

<i86639>	a	<Instance> ;
	skos:definition	"Sumerian and Babylonian god of pastures and vegetation; consort of Inanna"@en ;
	dc:source	pwn30:09517492-n .

<i86640>	a	<Instance> ;
	skos:definition	"the Babylonian god of wisdom; son of Apsu and father of Marduk; counterpart of the Sumerian Enki; as one of the supreme triad including Anu and Bel he was assigned control of the watery element"@en ;
	dc:source	pwn30:09517628-n .

<i86641>	a	<Instance> ;
	skos:definition	"water god and god of wisdom; counterpart of the Akkadian Ea"@en ;
	dc:source	pwn30:09517890-n .

<i86642>	a	<Instance> ;
	skos:definition	"god of the air and king of the Sumerian gods"@en ;
	dc:source	pwn30:09518020-n .

<i86643>	a	<Instance> ;
	skos:definition	"goddess of death and consort of Nergal"@en ;
	dc:source	pwn30:09518145-n .

<i86644>	a	<Instance> ;
	skos:definition	"the Babylonian god of fire; often invoked in incantations against sorcery"@en ;
	dc:source	pwn30:09518306-n .

<i86645>	a	<Instance> ;
	skos:definition	"the Babylonian goddess of healing and consort of Ninurta"@en ;
	dc:source	pwn30:09518451-n .

<i86646>	a	<Instance> ;
	skos:definition	"any of a group of heavenly spirits under the god Anu"@en ;
	dc:source	pwn30:09518578-n .

<i86647>	a	<Instance> ;
	skos:definition	"consort of Dumuzi (Tammuz)"@en ;
	dc:source	pwn30:09518683-n .

<i86648>	a	<Instance> ;
	skos:definition	"goddess personifying earth; counterpart of Akkadian Aruru"@en ;
	dc:source	pwn30:09518782-n .

<i86649>	a	<Instance> ;
	skos:definition	"Babylonian consort of Anshar; in Sumerian the name signifies `the totality of the lower world'"@en ;
	dc:source	pwn30:09518908-n .

<i86650>	a	<Concept> ;
	skos:definition	"in ancient Semitic folklore: a female demon who attacks children"@en ;
	dc:source	pwn30:09519075-n .

<i86651>	a	<Instance> ;
	skos:definition	"a name under which Ninkhursag was worshipped"@en ;
	dc:source	pwn30:09519192-n .

<i86652>	a	<Instance> ;
	skos:definition	"the chief Babylonian god; his consort was Sarpanitu"@en ;
	dc:source	pwn30:09519288-n .

<i86653>	a	<Instance> ;
	skos:definition	"god of the Canaanites and Phoenicians to whom parents sacrificed their children"@en ;
	dc:source	pwn30:09519454-n .

<i86654>	a	<Instance> ;
	skos:definition	"Babylonian god of wisdom and agriculture and patron of scribes and schools"@en ;
	dc:source	pwn30:09519596-n .

<i86655>	a	<Instance> ;
	skos:definition	"goddess personifying the primeval sea; mother of the gods and of heaven and earth"@en ;
	dc:source	pwn30:09519748-n .

<i86656>	a	<Instance> ;
	skos:definition	"a demon personifying death; messenger of the underworld goddess Ereshkigal bringing death to mankind"@en ;
	dc:source	pwn30:09519901-n .

<i86657>	a	<Instance> ;
	skos:definition	"god of the Moon; counterpart of the Akkadian Sin"@en ;
	dc:source	pwn30:09520103-n .

<i86658>	a	<Instance> ;
	skos:definition	"(Akkadian) god ruling with his consort Ereshkigal the world of the dead"@en ;
	dc:source	pwn30:09520223-n .

<i86659>	a	<Instance> ;
	skos:definition	"the Babylonian goddess of the watery deep and daughter of Ea"@en ;
	dc:source	pwn30:09520367-n .

<i86660>	a	<Instance> ;
	skos:definition	"(Akkadian) a goddess; wife of the Moon god Sin"@en ;
	dc:source	pwn30:09520498-n .

<i86661>	a	<Instance> ;
	skos:definition	"Babylonian god in older pantheon: god of war and agriculture"@en ;
	dc:source	pwn30:09520617-n .

<i86662>	a	<Instance> ;
	skos:definition	"an underworld Babylonian deity; patron of medicine"@en ;
	dc:source	pwn30:09520752-n .

<i86663>	a	<Instance> ;
	skos:definition	"the great mother goddess; worshipped also as Aruru and Mama and Nintu"@en ;
	dc:source	pwn30:09520880-n .

<i86664>	a	<Instance> ;
	skos:definition	"a name under which Ninkhursag was worshipped"@en ;
	dc:source	pwn30:09521051-n .

<i86665>	a	<Instance> ;
	skos:definition	"a solar deity; firstborn of Bel and consort was Gula; god of war and the chase and agriculture; sometimes identified with biblical Nimrod"@en ;
	dc:source	pwn30:09521157-n .

<i86666>	a	<Instance> ;
	skos:definition	"god of fire and light; corresponds to Babylonian Girru"@en ;
	dc:source	pwn30:09521395-n .

<i86667>	a	<Instance> ;
	skos:definition	"god of storms and wind; corresponds to Babylonian Adad"@en ;
	dc:source	pwn30:09521521-n .

<i86668>	a	<Instance> ;
	skos:definition	"consort of Marduk"@en ;
	dc:source	pwn30:09521648-n .

<i86669>	a	<Instance> ;
	skos:definition	"the chief sun god; drives away winter and storms and brightens the earth with greenery; drives away evil and brings justice and compassion"@en ;
	dc:source	pwn30:09521763-n .

<i86670>	a	<Instance> ;
	skos:definition	"(Akkadian) god of the Moon; counterpart of Sumerian Nanna"@en ;
	dc:source	pwn30:09521994-n .

<i86671>	a	<Instance> ;
	skos:definition	"consort of Nabu"@en ;
	dc:source	pwn30:09522121-n .

<i86672>	a	<Instance> ;
	skos:definition	"(Akkadian) mother of the gods and consort of Apsu"@en ;
	dc:source	pwn30:09522222-n .

<i86673>	a	<Instance> ;
	skos:definition	"favorite of the gods and grandfather of Gilgamish; survived the great flood and became immortal"@en ;
	dc:source	pwn30:09522344-n .

<i86674>	a	<Instance> ;
	skos:definition	"sun god; counterpart of Akkadian Shamash"@en ;
	dc:source	pwn30:09522498-n .

<i86675>	a	<Instance> ;
	skos:definition	"evil storm god represented as a black bird"@en ;
	dc:source	pwn30:09522615-n .

<i86676>	a	<Instance> ;
	skos:definition	"legendary friend of Gilgamish"@en ;
	dc:source	pwn30:09522735-n .

<i86677>	a	<Instance> ;
	skos:definition	"legendary Sumerian king and hero of Sumerian and Babylonian epics"@en ;
	dc:source	pwn30:09522837-n .

<i86678>	a	<Concept> ;
	skos:definition	"a deity worshipped by the Hindus"@en ;
	dc:source	pwn30:09522978-n .

<i86679>	a	<Instance> ;
	skos:definition	"a Hindu goddess who releases from sin or disease; mother of the Adityas"@en ;
	dc:source	pwn30:09524027-n .

<i86680>	a	<Concept> ;
	skos:definition	"one of 7 to 12 sons of Aditi; Hindu gods of celestial light"@en ;
	dc:source	pwn30:09524151-n .

<i86681>	a	<Instance> ;
	skos:definition	"(Sanskrit) Hindu god of fire in ancient and traditional India; one of the three chief deities of the Vedas"@en ;
	dc:source	pwn30:09524263-n .

<i86682>	a	<Instance> ;
	skos:definition	"earlier a god; later a demon; counterpart of Zoroastrian Ahura"@en ;
	dc:source	pwn30:09524440-n .

<i86683>	a	<Concept> ;
	skos:definition	"(Zoroastrianism) title for benevolent deities"@en ;
	dc:source	pwn30:09524555-n .

<i86684>	a	<Concept> ;
	skos:definition	"(literally `possessing horses' in Sanskrit) in Hinduism the twin chariot warriors conveying Surya"@en ;
	dc:source	pwn30:09524671-n .

<i86685>	a	<Instance> ;
	skos:definition	"Hindu god of wealth and love"@en ;
	dc:source	pwn30:09524840-n .

<i86686>	a	<Instance> ;
	skos:definition	"the Creator; one of the three major deities in the later Hindu pantheon"@en ;
	dc:source	pwn30:09524921-n .

<i86687>	a	<Instance> ;
	skos:definition	"personification of the power of ritual devotion"@en ;
	dc:source	pwn30:09525065-n .

<i86688>	a	<Instance> ;
	skos:definition	"Hindu earth goddess; one of the two wives of Vishnu"@en ;
	dc:source	pwn30:09525170-n .

<i86689>	a	<Instance> ;
	skos:definition	"Hindu mother goddess; supreme power in the universe; wife or embodiment of the female energy of Siva having both beneficent and malevolent forms or aspects"@en ;
	dc:source	pwn30:09525279-n .

<i86690>	a	<Instance> ;
	skos:definition	"malevolent aspect of Devi"@en ;
	dc:source	pwn30:09525486-n .

<i86691>	a	<Concept> ;
	skos:definition	"basic principles of the cosmos; also: an ancient sage in Hindu mythology worshipped as a god by some lower castes; "@en ;
	dc:source	pwn30:09525579-n .

<i86692>	a	<Instance> ;
	skos:definition	"Hindu goddess of war; a malevolent aspect of Devi"@en ;
	dc:source	pwn30:09525746-n .

<i86693>	a	<Instance> ;
	skos:definition	"Hindu god of the sky"@en ;
	dc:source	pwn30:09525874-n .

<i86694>	a	<Instance> ;
	skos:definition	"Hindu god of wisdom or prophecy; the god who removes obstacles"@en ;
	dc:source	pwn30:09525961-n .

<i86695>	a	<Concept> ;
	skos:definition	"a supernatural eagle-like being that serves as Vishnu's mount"@en ;
	dc:source	pwn30:09526107-n .

<i86696>	a	<Instance> ;
	skos:definition	"in Hinduism, goddess of purity and posterity and a benevolent aspect of Devi; the `brilliant'"@en ;
	dc:source	pwn30:09526221-n .

<i86697>	a	<Instance> ;
	skos:definition	"in Hinduism, the monkey god and helper of Rama; god of devotion and courage"@en ;
	dc:source	pwn30:09526367-n .

<i86698>	a	<Instance> ;
	skos:definition	"chief Hindu god of the Rig-Veda; god of rain and thunder"@en ;
	dc:source	pwn30:09526497-n .

<i86699>	a	<Instance> ;
	skos:definition	"unknown god; an epithet of Prajapati and Brahma"@en ;
	dc:source	pwn30:09526606-n .

<i86700>	a	<Instance> ;
	skos:definition	"wife of Siva and malevolent form of Devi"@en ;
	dc:source	pwn30:09526703-n .

<i86701>	a	<Instance> ;
	skos:definition	"Hindu god of love and erotic desire; opposite of Mara"@en ;
	dc:source	pwn30:09526808-n .

<i86702>	a	<Instance> ;
	skos:definition	"Hindu god of death; opposite of Kama"@en ;
	dc:source	pwn30:09526913-n .

<i86703>	a	<Instance> ;
	skos:definition	"Hindu god of bravery"@en ;
	dc:source	pwn30:09527001-n .

<i86704>	a	<Instance> ;
	skos:definition	"Hindu goddess of fortune and prosperity"@en ;
	dc:source	pwn30:09527091-n .

<i86705>	a	<Concept> ;
	skos:definition	"any of a group of Hindu storm gods; offspring of Rudra"@en ;
	dc:source	pwn30:09527185-n .

<i86706>	a	<Instance> ;
	skos:definition	"Hindu god of friendship and alliances; usually invoked together with Varuna as a supporter of heaven and earth"@en ;
	dc:source	pwn30:09527291-n .

<i86707>	a	<Instance> ;
	skos:definition	"Hindu god of rain; sometimes identified with Indra"@en ;
	dc:source	pwn30:09527454-n .

<i86708>	a	<Instance> ;
	skos:definition	"wife of Siva and a benevolent aspect of Devi: Hindu goddess of plenty"@en ;
	dc:source	pwn30:09527560-n .

<i86709>	a	<Instance> ;
	skos:definition	"Hindu god personifying a creative force; equivalent to Brahma"@en ;
	dc:source	pwn30:09527707-n .

<i86710>	a	<Instance> ;
	skos:definition	"ancient Greek sculptor (circa 370-330 BC)"@en ;
	dc:source	pwn30:09527825-n .

<i86711>	a	<Instance> ;
	skos:definition	"celestial shepherd god; conductor of souls of the dead"@en ;
	dc:source	pwn30:09527924-n .

<i86712>	a	<Instance> ;
	skos:definition	"a Hindu demon who swallows the sun causing eclipses"@en ;
	dc:source	pwn30:09528032-n .

<i86713>	a	<Concept> ;
	skos:definition	"one of three artisans of the Hindu gods"@en ;
	dc:source	pwn30:09528135-n .

<i86714>	a	<Instance> ;
	skos:definition	"father of the Hindu storm gods Marut; controller of nature; sometimes identified with Siva"@en ;
	dc:source	pwn30:09528237-n .

<i86715>	a	<Instance> ;
	skos:definition	"Hindu goddess of learning and the arts"@en ;
	dc:source	pwn30:09528380-n .

<i86716>	a	<Instance> ;
	skos:definition	"an important Hindu god; the sun in its life-giving aspect"@en ;
	dc:source	pwn30:09528475-n .

<i86717>	a	<Instance> ;
	skos:definition	"the female or generative principle; wife of Siva and a benevolent form of Devi"@en ;
	dc:source	pwn30:09528587-n .

<i86718>	a	<Instance> ;
	skos:definition	"the destroyer; one of the three major divinities in the later Hindu pantheon"@en ;
	dc:source	pwn30:09528727-n .

<i86719>	a	<Instance> ;
	skos:definition	"epithet of Siva"@en ;
	dc:source	pwn30:09528919-n .

<i86720>	a	<Instance> ;
	skos:definition	"Hindu god of war"@en ;
	dc:source	pwn30:09529013-n .

<i86721>	a	<Concept> ;
	skos:definition	"personification of a sacred intoxicating drink used in Vedic ritual"@en ;
	dc:source	pwn30:09529083-n .

<i86722>	a	<Instance> ;
	skos:definition	"an important god of later Hinduism; the sun god or the sun itself worshipped as the source of warmth and light"@en ;
	dc:source	pwn30:09529201-n .

<i86723>	a	<Instance> ;
	skos:definition	"a benevolent aspect of Devi; `splendor'"@en ;
	dc:source	pwn30:09529364-n .

<i86724>	a	<Instance> ;
	skos:definition	"Hindu goddess of dawn; daughter of the sky and sister of the night"@en ;
	dc:source	pwn30:09529454-n .

<i86725>	a	<Concept> ;
	skos:definition	"Indra's thunderbolt"@en ;
