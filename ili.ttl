<i110618>	a	<Concept> ;
	skos:definition	"alkalosis resulting from increased gas exchange in the lungs (as in hyperventilation associated with extreme anxiety or aspirin intoxication or metabolic acidosis)"@en ;
	dc:source	pwn30:14021622-n .

