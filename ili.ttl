	dc:source	pwn30:13820239-n .

<i109528>	a	<Concept> ;
	skos:definition	"the ratio of reflected to incident light"@en ;
	dc:source	pwn30:13820432-n .

<i109529>	a	<Concept> ;
	skos:definition	"the ratio of the width to the height of a tv picture"@en ;
