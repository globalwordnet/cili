	dc:source	pwn30:06163548-n .

<i68951>	a	<Concept> ;
	skos:definition	"the branch of philosophy that analyzes inference"@en ;
	dc:source	pwn30:06163751-n .

<i68952>	a	<Concept> ;
	skos:definition	"any logical system that abstracts the form of statements away from their content in order to establish abstract criteria of consistency and validity"@en ;
	dc:source	pwn30:06164665-n .

<i68953>	a	<Concept> ;
	skos:definition	"a system of symbolic logic devised by George Boole; used in computers"@en ;
	dc:source	pwn30:06165000-n .

<i68954>	a	<Concept> ;
	skos:definition	"a branch of symbolic logic dealing with propositions as units and with their combinations and the connectives that relate them"@en ;
	dc:source	pwn30:06165147-n .

