	skos:definition	"a statistical technique used in glottochronology; used to estimate how long ago different languages evolved from a common source language"@en ;
	dc:source	pwn30:06179574-n .

<i69014>	a	<Concept> ;
	skos:definition	"the study of language meaning"@en ;
	dc:source	pwn30:06179792-n .

<i69015>	a	<Concept> ;
	skos:definition	"the function of pointing or specifying from the perspective of a participant in an act of speech or writing; aspects of a communication whose interpretation depends on knowledge of the context in which the communication occurs"@en ;
	dc:source	pwn30:06179985-n .

<i69016>	a	<Concept> ;
	skos:definition	"the branch of semantics that studies the logical aspects of meaning"@en ;
	dc:source	pwn30:06180282-n .

<i69017>	a	<Concept> ;
	skos:definition	"the branch of semantics that studies the meanings and relations of words"@en ;
	dc:source	pwn30:06180412-n .

<i69018>	a	<Concept> ;
	skos:definition	"the branch of semantics that studies the cognitive aspects of meaning"@en ;
	dc:source	pwn30:06180548-n .

<i69019>	a	<Concept> ;
	skos:definition	"a law describing sound changes in the history of a language"@en ;
	dc:source	pwn30:06180720-n .

<i69020>	a	<Concept> ;
	skos:definition	"a sound law relating German consonants and consonants in other Indo-European languages"@en ;
	dc:source	pwn30:06180890-n .

<i69021>	a	<Concept> ;
	skos:definition	"a qualification of Grimm's law"@en ;
	dc:source	pwn30:06181034-n .

<i69022>	a	<Concept> ;
	skos:definition	"the study of language in relation to its sociocultural context"@en ;
	dc:source	pwn30:06181123-n .

<i69023>	a	<Concept> ;
	skos:definition	"linguistics defined as the analysis of formal structures in a text or discourse"@en ;
	dc:source	pwn30:06181284-n .

<i69024>	a	<Concept> ;
	skos:definition	"the study of a language without reference to its historical context"@en ;
	dc:source	pwn30:06181448-n .

<i69025>	a	<Concept> ;
	skos:definition	"a description (at a given point in time) of a language with respect to its phonology and morphology and syntax and semantics without value judgments"@en ;
	dc:source	pwn30:06181584-n .

<i69026>	a	<Concept> ;
	skos:definition	"an account of how a language should be used instead of how it is actually used; a prescription for the `correct' phonology and morphology and syntax and semantics"@en ;
	dc:source	pwn30:06181893-n .

<i69027>	a	<Concept> ;
	skos:definition	"the rational and systematic study of religion and its influences and of the nature of religious truth"@en ;
	dc:source	pwn30:06182144-n .

<i69028>	a	<Concept> ;
	skos:definition	"the branch of theology that is concerned with angels"@en ;
	dc:source	pwn30:06182757-n .

<i69029>	a	<Concept> ;
	skos:definition	"the branch of theology that is concerned with the defense of Christian doctrines"@en ;
	dc:source	pwn30:06182866-n .

<i69030>	a	<Concept> ;
	skos:definition	"the branch of theology concerned with the nature and the constitution and the functions of a church"@en ;
	dc:source	pwn30:06183004-n .

<i69031>	a	<Concept> ;
