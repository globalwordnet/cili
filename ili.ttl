	dc:source	pwn30:14272915-n .

<i111944>	a	<Concept> ;
	skos:definition	"spavin caused by distension of the veins"@en ;
	dc:source	pwn30:14273084-n .

<i111945>	a	<Concept> ;
	skos:definition	"spavin caused by collection of fluids"@en ;
	dc:source	pwn30:14273183-n .

<i111946>	a	<Concept> ;
	skos:definition	"spavin caused by a bony growth"@en ;
	dc:source	pwn30:14273277-n .

<i111947>	a	<Concept> ;
	skos:definition	"an infectious disease cause by leptospira and transmitted to humans from domestic animals; characterized by jaundice and fever"@en ;
	dc:source	pwn30:14273365-n .

<i111948>	a	<Concept> ;
