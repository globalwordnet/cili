	dc:source	pwn30:06166274-n .

<i68961>	a	<Concept> ;
	skos:definition	"the modal logic of belief and disbelief"@en ;
	dc:source	pwn30:06166394-n .

<i68962>	a	<Concept> ;
	skos:definition	"a form of mathematical logic in which truth can assume a continuum of values between 0 and 1"@en ;
	dc:source	pwn30:06166494-n .

<i68963>	a	<Concept> ;
	skos:definition	"the logical study of necessity and possibility"@en ;
	dc:source	pwn30:06166644-n .

<i68964>	a	<Concept> ;
	skos:definition	"the philosophical theory of knowledge"@en ;
	dc:source	pwn30:06166748-n .

<i68965>	a	<Concept> ;
	skos:definition	"the branch of philosophy that analyzes the principles and procedures of inquiry in a particular discipline"@en ;
	dc:source	pwn30:06166898-n .

<i68966>	a	<Concept> ;
	skos:definition	"a philosophical doctrine proposed by Edmund Husserl based on the study of human experience in which considerations of objective reality are not taken into account"@en ;
	dc:source	pwn30:06167106-n .

<i68967>	a	<Concept> ;
	skos:definition	"a doctrine accepted by adherents to a philosophy"@en ;
	dc:source	pwn30:06167328-n .

<i68968>	a	<Concept> ;
