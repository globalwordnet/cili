	skos:definition	"2 species of small evergreen shrubs of Australia and Tasmania"@en ;
	dc:source	pwn30:11656974-n .

<i98625>	a	<Concept> ;
	skos:definition	"small shrub or Tasmania having short stiff branches"@en ;
	dc:source	pwn30:11657153-n .

<i98626>	a	<Concept> ;
	skos:definition	"small genus of Asian evergreen trees having columnar crowns and distinguished by leaves lacking a midrib; eastern Asia including India and Philippines and New Guinea"@en ;
	dc:source	pwn30:11657314-n .

<i98627>	a	<Concept> ;
	skos:definition	"medium-sized tree having glossy lanceolate leaves; southern China to Taiwan and southern Japan"@en ;
	dc:source	pwn30:11657585-n .

<i98628>	a	<Concept> ;
	skos:definition	"one species: parasite yew"@en ;
	dc:source	pwn30:11657763-n .

<i98629>	a	<Concept> ;
	skos:definition	"rare and endangered monoecious parasitic conifer of New Caledonia; parasitic on Falcatifolium taxoides"@en ;
	dc:source	pwn30:11657904-n .

<i98630>	a	<Concept> ;
	skos:definition	"mostly dioecious evergreen conifers; leaves are softer than in Podocarpus"@en ;
	dc:source	pwn30:11658104-n .

<i98631>	a	<Concept> ;
	skos:definition	"New Zealand conifer used for lumber; the dark wood is used for interior carpentry"@en ;
	dc:source	pwn30:11658331-n .

<i98632>	a	<Concept> ;
	skos:definition	"conifer of Australia and New Zealand"@en ;
	dc:source	pwn30:11658544-n .

<i98633>	a	<Concept> ;
	skos:definition	"South American evergreen tree or shrub"@en ;
	dc:source	pwn30:11658709-n .

<i98634>	a	<Concept> ;
	skos:definition	"small genus of tropical evergreen dioecious shrubs or trees of Oceania and tropical South America"@en ;
	dc:source	pwn30:11658872-n .

<i98635>	a	<Concept> ;
	skos:definition	"one species: Prince Albert's yew"@en ;
	dc:source	pwn30:11659068-n .

<i98636>	a	<Concept> ;
	skos:definition	"small yew having attractive foliage and partially weeping branches cultivated as an ornamental; mountains of southern Chile"@en ;
	dc:source	pwn30:11659248-n .

<i98637>	a	<Concept> ;
	skos:definition	"one species"@en ;
	dc:source	pwn30:11659500-n .

<i98638>	a	<Concept> ;
	skos:definition	"a large fast-growing monoecious tropical evergreen tree having large glossy lanceolate leaves; of rain forests of Sumatra and Philippines to northern Queensland"@en ;
	dc:source	pwn30:11659627-n .

<i98639>	a	<Concept> ;
	skos:definition	"family comprising a single genus that until recently was considered part of Taxodiaceae"@en ;
	dc:source	pwn30:11659909-n .

<i98640>	a	<Concept> ;
	skos:definition	"type and sole genus of Sciadopityaceae; Japanese umbrella pines"@en ;
	dc:source	pwn30:11660121-n .

<i98641>	a	<Concept> ;
	skos:definition	"tall evergreen having a symmetrical spreading crown and needles growing in whorls that resemble umbrellas at ends of twigs"@en ;
	dc:source	pwn30:11660300-n .

<i98642>	a	<Concept> ;
	skos:definition	"yews: in some systems classified as a class (Taxopsida) and in others as a subdivision (Taxophytina) used in some classifications for one of five subdivisions of Gymnospermophyta"@en ;
	dc:source	pwn30:11660537-n .

<i98643>	a	<Concept> ;
	skos:definition	"coextensive with the family Taxaceae: yews"@en ;
	dc:source	pwn30:11660848-n .

<i98644>	a	<Concept> ;
	skos:definition	"sometimes classified as member of order Taxales"@en ;
	dc:source	pwn30:11660979-n .

<i98645>	a	<Concept> ;
	skos:definition	"yews"@en ;
	dc:source	pwn30:11661207-n .

<i98646>	a	<Concept> ;
	skos:definition	"any of numerous evergreen trees or shrubs having red cup-shaped berries and flattened needlelike leaves"@en ;
	dc:source	pwn30:11661372-n .

<i98647>	a	<Concept> ;
	skos:definition	"wood of a yew; especially the durable fine-grained light brown or red wood of the English yew valued for cabinetwork and archery bows"@en ;
	dc:source	pwn30:11661707-n .

<i98648>	a	<Concept> ;
	skos:definition	"predominant yew in Europe; extraordinarily long-lived and slow growing; one of the oldest species in the world"@en ;
	dc:source	pwn30:11661909-n .

<i98649>	a	<Concept> ;
	skos:definition	"small or medium irregularly branched tree of the Pacific coast of North America; yields fine hard close-grained wood"@en ;
	dc:source	pwn30:11662128-n .

<i98650>	a	<Concept> ;
	skos:definition	"shrubby hardy evergreen of China and Japan having lustrous dark green foliage; cultivated in the eastern United States"@en ;
	dc:source	pwn30:11662371-n .

<i98651>	a	<Concept> ;
	skos:definition	"small bushy yew of northern Florida having spreading branches and very narrow leaves"@en ;
	dc:source	pwn30:11662585-n .

<i98652>	a	<Concept> ;
	skos:definition	"a gymnosperm genus having one species: New Caledonian yew"@en ;
	dc:source	pwn30:11662764-n .

<i98653>	a	<Concept> ;
	skos:definition	"large yew native to New Caledonia; cultivated in eastern Australia and New Zealand and Hawaii"@en ;
	dc:source	pwn30:11662937-n .

<i98654>	a	<Concept> ;
	skos:definition	"one species"@en ;
	dc:source	pwn30:11663136-n .

<i98655>	a	<Concept> ;
	skos:definition	"yew of southeastern China, differing from the Old World yew in having white berries"@en ;
	dc:source	pwn30:11663263-n .

<i98656>	a	<Concept> ;
	skos:definition	"ginkgos: in some systems classified as a class and in others as a subdivision; used in some classifications for one of five subdivisions of Gymnospermophyta"@en ;
	dc:source	pwn30:11663449-n .

<i98657>	a	<Concept> ;
	skos:definition	"coextensive with the family Ginkgoaceae: plants that first appeared in the Permian and now represented by a single surviving species; often included in Coniferales"@en ;
	dc:source	pwn30:11663813-n .

<i98658>	a	<Concept> ;
	skos:definition	"constituting the order Ginkgoales; includes the genus Ginkgo and extinct forms"@en ;
	dc:source	pwn30:11664090-n .

<i98659>	a	<Concept> ;
	skos:definition	"sole surviving genus of the Ginkgoaceae"@en ;
	dc:source	pwn30:11664301-n .

<i98660>	a	<Concept> ;
	skos:definition	"deciduous dioecious Chinese tree having fan-shaped leaves and fleshy yellow seeds; exists almost exclusively in cultivation especially as an ornamental street tree"@en ;
	dc:source	pwn30:11664418-n .

<i98661>	a	<Concept> ;
	skos:definition	"used in former classifications to include all ferns and flowering plants and divided into the three classes Filicinae and Gymnospermae and Angiospermae"@en ;
	dc:source	pwn30:11664677-n .

<i98662>	a	<Concept> ;
	skos:definition	"comprising flowering plants that produce seeds enclosed in an ovary; in some systems considered a class (Angiospermae) and in others a division (Magnoliophyta or Anthophyta)"@en ;
	dc:source	pwn30:11664929-n .

<i98663>	a	<Concept> ;
	skos:definition	"plants having seeds in a closed ovary"@en ;
	dc:source	pwn30:11665372-n .

<i98664>	a	<Concept> ;
	skos:definition	"tree bearing fruit enclosed in a shell or involucre or husk"@en ;
	dc:source	pwn30:11665648-n .

<i98665>	a	<Concept> ;
	skos:definition	"comprising seed plants that produce an embryo with paired cotyledons and net-veined leaves; divided into six (not always well distinguished) subclasses (or superorders): Magnoliidae and Hamamelidae (considered primitive); Caryophyllidae (an early and distinctive offshoot); and three more or less advanced groups: Dilleniidae; Rosidae; Asteridae"@en ;
	dc:source	pwn30:11665781-n .

<i98666>	a	<Concept> ;
	skos:definition	"flowering plant with two cotyledons; the stem grows by deposit on its outside"@en ;
	dc:source	pwn30:11666854-n .

<i98667>	a	<Concept> ;
	skos:definition	"a group of families of trees and shrubs and herbs having well-developed perianths and apocarpous ovaries and generally regarded as the most primitive extant flowering plants; contains 36 families including Magnoliaceae and Ranunculaceae; sometimes classified as a superorder"@en ;
	dc:source	pwn30:11667112-n .

<i98668>	a	<Concept> ;
	skos:definition	"comprising seed plants that produce an embryo with a single cotyledon and parallel-veined leaves: includes grasses and lilies and palms and orchids; divided into four subclasses or superorders: Alismatidae; Arecidae; Commelinidae; and Liliidae"@en ;
	dc:source	pwn30:11667562-n .

<i98669>	a	<Concept> ;
	skos:definition	"a monocotyledonous flowering plant; the stem grows by deposits on its inside"@en ;
	dc:source	pwn30:11668117-n .

<i98670>	a	<Concept> ;
	skos:definition	"one of four subclasses or superorders of Monocotyledones; comprises about 500 species in 14 families of aquatic and semiaquatic herbs"@en ;
	dc:source	pwn30:11668340-n .

<i98671>	a	<Concept> ;
	skos:definition	"one of four subclasses or superorder of Monocotyledones; comprises about 6400 species in 5 families of trees and shrubs and terrestrial herbs and a few free-floating aquatics including: Palmae; Araceae; Pandanaceae and Lemnaceae"@en ;
	dc:source	pwn30:11668573-n .

<i98672>	a	<Concept> ;
	skos:definition	"one of four subclasses or superorders of Monocotyledones; comprises about 19,000 species in 25 families of mostly terrestrial herbs especially of moist places including: Cyperaceae; Gramineae; Bromeliaceae; and Zingiberaceae"@en ;
	dc:source	pwn30:11668952-n .

<i98673>	a	<Concept> ;
	skos:definition	"reproductive organ of angiosperm plants especially one having showy or colorful parts"@en ;
	dc:source	pwn30:11669335-n .

<i98674>	a	<Concept> ;
	skos:definition	"a diminutive flower (especially one that is part of a composite flower)"@en ;
	dc:source	pwn30:11669786-n .

<i98675>	a	<Concept> ;
	skos:definition	"a plant cultivated for its blooms or blossoms"@en ;
	dc:source	pwn30:11669921-n .

<i98676>	a	<Concept> ;
	skos:definition	"a flower that blooms in a particular way"@en ;
	dc:source	pwn30:11672269-n .

<i98677>	a	<Concept> ;
	skos:definition	"wild or uncultivated flowering plant"@en ;
	dc:source	pwn30:11672400-n .

<i98678>	a	<Concept> ;
	skos:definition	"flower having no petals"@en ;
	dc:source	pwn30:11674019-n .

<i98679>	a	<Concept> ;
	skos:definition	"a shortened compact cluster of flowers so arranged that the whole gives the effect of a single flower as in clover or members of the family Compositae"@en ;
	dc:source	pwn30:11674105-n .

<i98680>	a	<Concept> ;
	skos:definition	"the flowering part of a plant or arrangement of flowers on a stalk"@en ;
	dc:source	pwn30:11674332-n .

<i98681>	a	<Concept> ;
	skos:definition	"small flower with a flat strap-shaped corolla usually occupying the peripheral rings of a composite flower"@en ;
	dc:source	pwn30:11674603-n .

<i98682>	a	<Concept> ;
	skos:definition	"a cylindrical spikelike inflorescence"@en ;
	dc:source	pwn30:11674798-n .

<i98683>	a	<Concept> ;
	skos:definition	"a partially opened flower"@en ;
	dc:source	pwn30:11674914-n .

<i98684>	a	<Concept> ;
	skos:definition	"the bud of a rose"@en ;
	dc:source	pwn30:11675025-n .

<i98685>	a	<Concept> ;
	skos:definition	"the male reproductive organ of a flower"@en ;
	dc:source	pwn30:11675096-n .

<i98686>	a	<Concept> ;
	skos:definition	"the part of the stamen that contains pollen; usually borne on a stalk"@en ;
	dc:source	pwn30:11675245-n .

<i98687>	a	<Concept> ;
	skos:definition	"the crown of the stamen in plants of the genus Asclepias"@en ;
	dc:source	pwn30:11675404-n .

<i98688>	a	<Concept> ;
	skos:definition	"the fine spores that contain male gametes and that are borne by an anther in a flowering plant"@en ;
	dc:source	pwn30:11675537-n .

<i98689>	a	<Concept> ;
	skos:definition	"a coherent mass of pollen grains (as in orchids)"@en ;
	dc:source	pwn30:11675738-n .

<i98690>	a	<Concept> ;
	skos:definition	"the parts of a plant involved in its reproduction"@en ;
	dc:source	pwn30:11675842-n .

<i98691>	a	<Concept> ;
	skos:definition	"the female ovule-bearing part of a flower composed of ovary and style and stigma"@en ;
	dc:source	pwn30:11676500-n .

<i98692>	a	<Concept> ;
	skos:definition	"the enlarged receptacle in which the pistil is borne"@en ;
	dc:source	pwn30:11676743-n .

<i98693>	a	<Concept> ;
	skos:definition	"the stalk of a pistil that raises it above the receptacle"@en ;
	dc:source	pwn30:11676850-n .

<i98694>	a	<Concept> ;
	skos:definition	"consists of one carpel"@en ;
	dc:source	pwn30:11676963-n .

<i98695>	a	<Concept> ;
	skos:definition	"consists of two or more fused carpels"@en ;
	dc:source	pwn30:11677045-n .

<i98696>	a	<Concept> ;
	skos:definition	"a sterile vestigial pistil remaining in a staminate flower"@en ;
	dc:source	pwn30:11677144-n .

<i98697>	a	<Concept> ;
	skos:definition	"(botany) the narrow elongated part of the pistil between the ovary and the stigma"@en ;
	dc:source	pwn30:11677259-n .

<i98698>	a	<Concept> ;
	skos:definition	"an enlargement at the base of the style in some Umbelliferae"@en ;
	dc:source	pwn30:11677485-n .

<i98699>	a	<Concept> ;
	skos:definition	"the apical end of the style where deposited pollen enters the pistil"@en ;
	dc:source	pwn30:11677603-n .

<i98700>	a	<Concept> ;
	skos:definition	"a simple pistil or one element of a compound pistil"@en ;
	dc:source	pwn30:11677743-n .

<i98701>	a	<Concept> ;
	skos:definition	"a slender stalk that furnishes an axis for a carpel"@en ;
	dc:source	pwn30:11677902-n .

<i98702>	a	<Concept> ;
	skos:definition	"the stalk of a corn plant"@en ;
	dc:source	pwn30:11678010-n .

<i98703>	a	<Concept> ;
	skos:definition	"the stalk of a stamen"@en ;
	dc:source	pwn30:11678123-n .

<i98704>	a	<Concept> ;
	skos:definition	"the stalk of a plant ovule or seed"@en ;
	dc:source	pwn30:11678199-n .

<i98705>	a	<Concept> ;
	skos:definition	"the stalk of a leaflet"@en ;
	dc:source	pwn30:11678299-n .

<i98706>	a	<Concept> ;
	skos:definition	"a carpel with one seed; one of a pair split apart at maturity"@en ;
	dc:source	pwn30:11678377-n .

<i98707>	a	<Concept> ;
	skos:definition	"the scar on certain seeds marking its point of attachment to the funicle"@en ;
	dc:source	pwn30:11678493-n .

<i98708>	a	<Concept> ;
	skos:definition	"the organ that bears the ovules of a flower"@en ;
	dc:source	pwn30:11678635-n .

<i98709>	a	<Concept> ;
	skos:definition	"a small body that contains the female germ cell of a plant; develops into a seed after fertilization"@en ;
	dc:source	pwn30:11678768-n .

<i98710>	a	<Concept> ;
	skos:definition	"basal part of a plant ovule opposite the micropyle; where integument and nucellus are joined"@en ;
	dc:source	pwn30:11679085-n .

<i98711>	a	<Concept> ;
	skos:definition	"central part of a plant ovule; contains the embryo sac"@en ;
	dc:source	pwn30:11679250-n .

<i98712>	a	<Concept> ;
	skos:definition	"minute opening in the wall of an ovule through which the pollen tube enters"@en ;
	dc:source	pwn30:11679378-n .

<i98713>	a	<Concept> ;
	skos:definition	"a partly inverted ovule turned back 90 degrees on its stalk"@en ;
	dc:source	pwn30:11679528-n .

<i98714>	a	<Concept> ;
	skos:definition	"a completely inverted ovule turned back 180 degrees on its stalk"@en ;
	dc:source	pwn30:11679652-n .

<i98715>	a	<Concept> ;
	skos:definition	"a curved ovule with the micropyle almost touching the funiculus"@en ;
	dc:source	pwn30:11679779-n .

<i98716>	a	<Concept> ;
	skos:definition	"a completely straight ovule with the micropyle at the apex"@en ;
	dc:source	pwn30:11679909-n .

<i98717>	a	<Concept> ;
	skos:definition	"a minute epidermal pore in a leaf or stem through which gases and water vapor can pass"@en ;
	dc:source	pwn30:11680032-n .

<i98718>	a	<Concept> ;
	skos:definition	"a pore in the outer wall of a spore or pollen grain through which the germ tube or pollen tube makes its exit on germination"@en ;
	dc:source	pwn30:11680277-n .

<i98719>	a	<Concept> ;
	skos:definition	"(botany) a slender tubular outgrowth from a spore in germination"@en ;
	dc:source	pwn30:11680457-n .

<i98720>	a	<Concept> ;
	skos:definition	"(botany) a slender tubular outgrowth from a pollen grain when deposited on the stigma for a flower; it penetrates the style and conveys the male gametes to the ovule"@en ;
	dc:source	pwn30:11680596-n .

<i98721>	a	<Concept> ;
	skos:definition	"that part of the ovary of a flowering plant where the ovules form"@en ;
	dc:source	pwn30:11680838-n .

<i98722>	a	<Concept> ;
	skos:definition	"arrangement of the ovules in the placenta and of the placentas in the ovary"@en ;
	dc:source	pwn30:11680995-n .

<i98723>	a	<Concept> ;
	skos:definition	"where one or few ovules develop at the top of a simple or compound ovary"@en ;
	dc:source	pwn30:11681255-n .

<i98724>	a	<Concept> ;
	skos:definition	"ovules are borne at or around the center of a compound ovary on an axis formed from joined septa"@en ;
	dc:source	pwn30:11681393-n .

<i98725>	a	<Concept> ;
	skos:definition	"where one or few ovules develop at the base of a simple or compound ovary"@en ;
	dc:source	pwn30:11681554-n .

<i98726>	a	<Concept> ;
	skos:definition	"where ovules develop on a central column in a compound ovary lacking septa or with septa at base only"@en ;
	dc:source	pwn30:11681692-n .

<i98727>	a	<Concept> ;
	skos:definition	"with ovules on thin extensions of the placentae into a compound ovary"@en ;
	dc:source	pwn30:11681865-n .

<i98728>	a	<Concept> ;
	skos:definition	"with ovules borne on the wall along the ventral suture of a simple ovary"@en ;
	dc:source	pwn30:11682003-n .

<i98729>	a	<Concept> ;
	skos:definition	"where ovules develop on the wall or slight outgrowths of the wall forming broken partitions within a compound ovary"@en ;
	dc:source	pwn30:11682166-n .

<i98730>	a	<Concept> ;
	skos:definition	"protective outer layer of seeds of flowering plants"@en ;
	dc:source	pwn30:11682349-n .

<i98731>	a	<Concept> ;
	skos:definition	"nutritive tissue surrounding the embryo within seeds of flowering plants"@en ;
	dc:source	pwn30:11682512-n .

<i98732>	a	<Concept> ;
	skos:definition	"small asexual reproductive structure in e.g. liverworts and mosses that detaches from the parent and develops into a new individual"@en ;
	dc:source	pwn30:11682659-n .

<i98733>	a	<Concept> ;
	skos:definition	"cone-shaped mass of ovule- or spore-bearing scales or bracts"@en ;
	dc:source	pwn30:11682842-n .

<i98734>	a	<Concept> ;
	skos:definition	"the seed-producing cone of a fir tree"@en ;
	dc:source	pwn30:11683105-n .

<i98735>	a	<Concept> ;
	skos:definition	"the seed-producing cone of a cypress tree"@en ;
	dc:source	pwn30:11683216-n .

<i98736>	a	<Concept> ;
	skos:definition	"the seed-producing cone of a pine tree"@en ;
	dc:source	pwn30:11683331-n .

<i98737>	a	<Concept> ;
	skos:definition	"a partition or wall especially in an ovary"@en ;
	dc:source	pwn30:11683443-n .

<i98738>	a	<Concept> ;
	skos:definition	"the hard usually fibrous outer layer of some fruits especially nuts"@en ;
	dc:source	pwn30:11683556-n .

<i98739>	a	<Concept> ;
	skos:definition	"the shell around the kernel of a nut"@en ;
	dc:source	pwn30:11683747-n .

<i98740>	a	<Concept> ;
	skos:definition	"a gland (often a protuberance or depression) that secretes nectar"@en ;
	dc:source	pwn30:11683838-n .

<i98741>	a	<Concept> ;
	skos:definition	"a mature fertilized plant ovule consisting of an embryo and its food source and having a protective coat or testa"@en ;
	dc:source	pwn30:11683989-n .

<i98742>	a	<Concept> ;
	skos:definition	"the ripened and variously modified walls of a plant ovary"@en ;
	dc:source	pwn30:11684264-n .

<i98743>	a	<Concept> ;
	skos:definition	"outermost layer of the pericarp of fruits as the skin of a peach or grape"@en ;
	dc:source	pwn30:11684499-n .

<i98744>	a	<Concept> ;
	skos:definition	"the middle layer of a pericarp"@en ;
	dc:source	pwn30:11684654-n .

<i98745>	a	<Concept> ;
	skos:definition	"the hard inner (usually woody) layer of the pericarp of some fruits (as peaches or plums or cherries or olives) that contains the seed"@en ;
	dc:source	pwn30:11684739-n .

<i98746>	a	<Concept> ;
	skos:definition	"a small hard seed found in some fruits"@en ;
	dc:source	pwn30:11685091-n .

<i98747>	a	<Concept> ;
	skos:definition	"a dry dehiscent seed vessel or the spore-containing structure of e.g. mosses"@en ;
	dc:source	pwn30:11685179-n .

<i98748>	a	<Concept> ;
	skos:definition	"a capsule divided into two cells or compartments"@en ;
	dc:source	pwn30:11685400-n .

<i98749>	a	<Concept> ;
	skos:definition	"the rounded seed-bearing capsule of a cotton or flax plant"@en ;
	dc:source	pwn30:11685512-n .

<i98750>	a	<Concept> ;
	skos:definition	"narrow elongated seed capsule peculiar to the family Cruciferae"@en ;
	dc:source	pwn30:11685621-n .

<i98751>	a	<Concept> ;
	skos:definition	"short broad silique occurring in some cruciferous plants"@en ;
