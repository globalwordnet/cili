	dc:source	pwn30:05554189-n .

<i66106>	a	<Concept> ;
	skos:definition	"either of two soft fleshy milk-secreting glandular organs on the chest of a woman"@en ;
	dc:source	pwn30:05554405-n .

<i66107>	a	<Concept> ;
	skos:definition	"the small projection of a mammary gland"@en ;
	dc:source	pwn30:05554653-n .

<i66108>	a	<Concept> ;
	skos:definition	"small circular area such as that around the human nipple or an inflamed area around a pimple or insect bite"@en ;
	dc:source	pwn30:05554804-n .

<i66109>	a	<Concept> ;
	skos:definition	"small space in a tissue or body part such as the area between veins on a leaf or an insect's wing"@en ;
	dc:source	pwn30:05555017-n .

<i66110>	a	<Concept> ;
	skos:definition	"one of many small glands of the uterine cervix that secrete mucus"@en ;
	dc:source	pwn30:05555167-n .

<i66111>	a	<Concept> ;
	skos:definition	"a gland that opens into the vestibule of the vagina; secretions lubricate the vagina during coitus"@en ;
	dc:source	pwn30:05555294-n .

<i66112>	a	<Concept> ;
	skos:definition	"the middle area of the human torso (usually in front)"@en ;
	dc:source	pwn30:05555473-n .

<i66113>	a	<Concept> ;
	skos:definition	"the narrowing of the body between the ribs and hips"@en ;
	dc:source	pwn30:05555688-n .

<i66114>	a	<Concept> ;
	skos:definition	"a very slender waist"@en ;
	dc:source	pwn30:05555840-n .

<i66115>	a	<Concept> ;
	skos:definition	"a protruding abdomen"@en ;
	dc:source	pwn30:05555917-n .

<i66116>	a	<Concept> ;
	skos:definition	"slang for a paunch"@en ;
	dc:source	pwn30:05556071-n .

<i66117>	a	<Concept> ;
