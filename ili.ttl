<i65212>	a	<Concept> ;
	skos:definition	"either of two veins that serve the eye; empties into the cavernous sinus"@en ;
	dc:source	pwn30:05374980-n .

<i65213>	a	<Concept> ;
	skos:definition	"a vein that drains a venous network in the floor and medial wall of the eye socket"@en ;
	dc:source	pwn30:05375169-n .

<i65214>	a	<Concept> ;
	skos:definition	"a vein that begins at the inner angle of the eye socket and passes through the superior orbital fissure to empty into the cavernous sinus"@en ;
	dc:source	pwn30:05375322-n .

<i65215>	a	<Concept> ;
	skos:definition	"one of the veins that drain the ovaries; the right opens into the inferior vena cava; the left opens into the left renal vein"@en ;
	dc:source	pwn30:05375530-n .

<i65216>	a	<Concept> ;
	skos:definition	"a vein that drains the region of the palate and empties into the facial vein"@en ;
	dc:source	pwn30:05375729-n .

<i65217>	a	<Concept> ;
	skos:definition	"veins draining the pancreas and emptying into the superior mesenteric and splenic veins"@en ;
	dc:source	pwn30:05375881-n .

<i65218>	a	<Concept> ;
	skos:definition	"small veins arising in skin around the navel; terminate as accessory portal veins"@en ;
	dc:source	pwn30:05376050-n .

<i65219>	a	<Concept> ;
	skos:definition	"parotid branches of the facial vein; they drain part of the parotid gland and empty into the retromandibular vein"@en ;
	dc:source	pwn30:05376219-n .

<i65220>	a	<Concept> ;
	skos:definition	"veins that drain the pectoral muscles and empty into the subclavian vein"@en ;
	dc:source	pwn30:05376391-n .

<i65221>	a	<Concept> ;
	skos:definition	"veins that accompany the perforating arteries; drain leg muscles; empty into the deep femoral vein"@en ;
	dc:source	pwn30:05376541-n .

<i65222>	a	<Concept> ;
	skos:definition	"several small veins from the pericardium"@en ;
	dc:source	pwn30:05376721-n .

<i65223>	a	<Concept> ;
	skos:definition	"accompany the peroneal arteries; arising in the heel and running up the back of the leg to join the posterior tibial veins of the popliteal vein"@en ;
	dc:source	pwn30:05376844-n .

<i65224>	a	<Concept> ;
	skos:definition	"veins from the pharyngeal plexus that empty into the internal jugular vein"@en ;
	dc:source	pwn30:05377098-n .

<i65225>	a	<Concept> ;
	skos:definition	"either of two veins that drain the diaphragm"@en ;
	dc:source	pwn30:05377252-n .

<i65226>	a	<Concept> ;
	skos:definition	"a vein arising in the knee and ascending to become the femoral vein"@en ;
	dc:source	pwn30:05377371-n .

<i65227>	a	<Concept> ;
	skos:definition	"system of veins that carry blood from the abdominal organs to the liver"@en ;
	dc:source	pwn30:05377515-n .

<i65228>	a	<Concept> ;
	skos:definition	"a short vein that carries blood into the liver"@en ;
	dc:source	pwn30:05377665-n .

<i65229>	a	<Concept> ;
	skos:definition	"arises near the apex of the heart and empties into the coronary sinus"@en ;
	dc:source	pwn30:05377833-n .

<i65230>	a	<Concept> ;
	skos:definition	"a tributary of the right gastric vein"@en ;
	dc:source	pwn30:05378022-n .

<i65231>	a	<Concept> ;
	skos:definition	"vein of the pudendum"@en ;
	dc:source	pwn30:05378137-n .

<i65232>	a	<Concept> ;
	skos:definition	"any of four veins that carry arterial blood from the lungs to the left atrium of the heart"@en ;
	dc:source	pwn30:05378234-n .

<i65233>	a	<Concept> ;
	skos:definition	"either of two pulmonary veins (left and right) returning blood from the inferior lobes of the lungs"@en ;
	dc:source	pwn30:05378458-n .

<i65234>	a	<Concept> ;
	skos:definition	"either of two pulmonary veins (left and right) returning blood from the superior lobes of the lungs"@en ;
	dc:source	pwn30:05378654-n .

<i65235>	a	<Concept> ;
	skos:definition	"receives veins from the upper surfaces of the stomach and empties into the portal vein"@en ;
	dc:source	pwn30:05378850-n .

<i65236>	a	<Concept> ;
	skos:definition	"superficial veins ascending the radial side of the forearm; combines with the ulnar veins to form the brachial vein"@en ;
	dc:source	pwn30:05379039-n .

<i65237>	a	<Concept> ;
	skos:definition	"veins that accompany renal arteries; open into the vena cava at the level of the 2nd lumbar vertebra"@en ;
	dc:source	pwn30:05379247-n .

<i65238>	a	<Concept> ;
	skos:definition	"posterior branch of the facial vein; formed by temporal veins in front of the ear"@en ;
	dc:source	pwn30:05379438-n .

<i65239>	a	<Concept> ;
	skos:definition	"vein of the sacral region"@en ;
	dc:source	pwn30:05379635-n .

<i65240>	a	<Concept> ;
	skos:definition	"either of two chief superficial veins of the leg that drain blood from the foot"@en ;
	dc:source	pwn30:05379734-n .

<i65241>	a	<Concept> ;
	skos:definition	"the longest vein in the body; runs from foot to the groin where it joins the femoral vein"@en ;
	dc:source	pwn30:05379944-n .

<i65242>	a	<Concept> ;
	skos:definition	"a vein running from the foot up the back of the leg to the knee"@en ;
	dc:source	pwn30:05380122-n .

<i65243>	a	<Concept> ;
	skos:definition	"tributaries of the anterior ciliary veins that drain the sclera of the eye"@en ;
	dc:source	pwn30:05380252-n .

<i65244>	a	<Concept> ;
	skos:definition	"veins passing from the scrotum to the pudendal veins"@en ;
	dc:source	pwn30:05380404-n .

<i65245>	a	<Concept> ;
	skos:definition	"tributaries of the inferior mesenteric vein; drains the sigmoid colon"@en ;
	dc:source	pwn30:05380532-n .

<i65246>	a	<Concept> ;
	skos:definition	"veins that drain the spinal cord"@en ;
	dc:source	pwn30:05380697-n .

<i65247>	a	<Concept> ;
	skos:definition	"a vein formed by several small veins on the surface of the spleen; joins the superior mesenteric to form the portal vein"@en ;
	dc:source	pwn30:05380822-n .

<i65248>	a	<Concept> ;
	skos:definition	"a star-shaped group of venules in the renal cortex"@en ;
	dc:source	pwn30:05381036-n .

<i65249>	a	<Concept> ;
	skos:definition	"drains the sternocleidomastoid muscle; empties into the internal jugular vein"@en ;
	dc:source	pwn30:05381148-n .

<i65250>	a	<Concept> ;
	skos:definition	"a vein that drains the tympanic cavity and empties into the retromandibular vein"@en ;
	dc:source	pwn30:05381325-n .

<i65251>	a	<Concept> ;
	skos:definition	"a continuation of the axillary vein; joins the internal jugular to form the brachiocephalic vein"@en ;
	dc:source	pwn30:05381491-n .

<i65252>	a	<Concept> ;
	skos:definition	"a tributary of the lingual vein"@en ;
	dc:source	pwn30:05381666-n .

<i65253>	a	<Concept> ;
	skos:definition	"drains the front of the scalp; unites with the supratrochlear vein to form the angular vein"@en ;
	dc:source	pwn30:05381779-n .

<i65254>	a	<Concept> ;
	skos:definition	"drains the front of the scalp; unites with the supraorbital vein to form the angular vein"@en ;
	dc:source	pwn30:05381956-n .

<i65255>	a	<Concept> ;
	skos:definition	"any of several veins draining the temporal region"@en ;
	dc:source	pwn30:05382135-n .

<i65256>	a	<Concept> ;
	skos:definition	"temporal veins that empty into the pterygoid plexus"@en ;
	dc:source	pwn30:05382316-n .

<i65257>	a	<Concept> ;
	skos:definition	"arises near the eye; joins the superficial temporal veins to form the retromandibular vein"@en ;
	dc:source	pwn30:05382432-n .

<i65258>	a	<Concept> ;
	skos:definition	"join the middle temporal vein to empty into the retromandibular vein"@en ;
	dc:source	pwn30:05382589-n .

<i65259>	a	<Concept> ;
	skos:definition	"a vein from the testicles"@en ;
	dc:source	pwn30:05382729-n .

<i65260>	a	<Concept> ;
	skos:definition	"a vein serving the thalamus and corpus striatum"@en ;
	dc:source	pwn30:05382855-n .

<i65261>	a	<Concept> ;
	skos:definition	"a vein arising from the region of the superficial epigastric vein and opening into the axillary vein or thoracic vein"@en ;
	dc:source	pwn30:05383004-n .

<i65262>	a	<Concept> ;
	skos:definition	"a long vein that helps to form the internal cerebral vein"@en ;
	dc:source	pwn30:05383216-n .

<i65263>	a	<Concept> ;
	skos:definition	"tributaries to the basal vein"@en ;
	dc:source	pwn30:05383348-n .

<i65264>	a	<Concept> ;
	skos:definition	"veins that drain the thoracic walls"@en ;
	dc:source	pwn30:05383467-n .

<i65265>	a	<Concept> ;
	skos:definition	"any of several small veins draining blood from the thyroid area"@en ;
	dc:source	pwn30:05383598-n .

<i65266>	a	<Concept> ;
	skos:definition	"any of several veins on each side that drain the thyroid gland and empty into the innominate vein"@en ;
	dc:source	pwn30:05383791-n .

<i65267>	a	<Concept> ;
	skos:definition	"a vein on each side that drains the lateral part of the thyroid and empties into the internal jugular vein"@en ;
	dc:source	pwn30:05383956-n .

<i65268>	a	<Concept> ;
	skos:definition	"a vein on each side that drains the upper part of the thyroid and empties into the internal jugular vein"@en ;
	dc:source	pwn30:05384128-n .

<i65269>	a	<Concept> ;
	skos:definition	"veins of the lower leg; empty into the popliteal vein"@en ;
	dc:source	pwn30:05384300-n .

<i65270>	a	<Concept> ;
	skos:definition	"several small veins from the trachea"@en ;
	dc:source	pwn30:05384446-n .

<i65271>	a	<Concept> ;
	skos:definition	"veins from the tympanic cavity that empty into the retromandibular vein"@en ;
	dc:source	pwn30:05384560-n .

<i65272>	a	<Concept> ;
	skos:definition	"any of several veins of the forearm"@en ;
	dc:source	pwn30:05384691-n .

<i65273>	a	<Concept> ;
	skos:definition	"a vein in the umbilical cord; returns nutrient blood from the placenta to the fetus"@en ;
	dc:source	pwn30:05384817-n .

<i65274>	a	<Concept> ;
	skos:definition	"one of two veins on each side that arise from the uterine plexus and empty into the internal iliac vein"@en ;
	dc:source	pwn30:05384999-n .

<i65275>	a	<Concept> ;
	skos:definition	"a muscular sac attached to the liver that stores bile (secreted by the liver) until it is needed for digestion"@en ;
	dc:source	pwn30:05385161-n .

<i65276>	a	<Concept> ;
	skos:definition	"the upper region of the abdomen just below the lowest ribs on either side of the epigastrium"@en ;
	dc:source	pwn30:05385363-n .

<i65277>	a	<Concept> ;
	skos:definition	"large and complicated reddish-brown glandular organ located in the upper right portion of the abdominal cavity; secretes bile and functions in metabolism of protein and carbohydrate and fat; synthesizes substances involved in the clotting of the blood; synthesizes vitamin A; detoxifies poisonous substances and breaks down worn-out erythrocytes"@en ;
	dc:source	pwn30:05385534-n .

<i65278>	a	<Concept> ;
	skos:definition	"any of the many tiny canals that contain blood vessels and connective tissue and that form a network in bone"@en ;
	dc:source	pwn30:05386139-n .

<i65279>	a	<Concept> ;
	skos:definition	"any of the five lobes forming the liver"@en ;
	dc:source	pwn30:05386309-n .

<i65280>	a	<Concept> ;
	skos:definition	"the duct that drains bile from the liver"@en ;
	dc:source	pwn30:05386426-n .

<i65281>	a	<Concept> ;
	skos:definition	"oblique passage through the lower abdominal wall; in males it is the passage through which the testes descend into the scrotum and it contains the spermatic cord; in females it transmits the round ligament of the uterus"@en ;
	dc:source	pwn30:05386544-n .

<i65282>	a	<Concept> ;
	skos:definition	"a duct formed by the hepatic and cystic ducts; opens into the duodenum"@en ;
	dc:source	pwn30:05386845-n .

<i65283>	a	<Concept> ;
	skos:definition	"excretory ducts of the liver; empty into the hepatic ducts"@en ;
	dc:source	pwn30:05387028-n .

<i65284>	a	<Concept> ;
	skos:definition	"a large elongated exocrine gland located behind the stomach; secretes pancreatic juice and insulin"@en ;
	dc:source	pwn30:05387167-n .

<i65285>	a	<Concept> ;
	skos:definition	"a duct connecting the pancreas with the intestine"@en ;
	dc:source	pwn30:05387395-n .

<i65286>	a	<Concept> ;
	skos:definition	"either of two saclike respiratory organs in the chest of vertebrates; serves to remove carbon dioxide and provide oxygen to the blood"@en ;
	dc:source	pwn30:05387544-n .

<i65287>	a	<Concept> ;
	skos:definition	"lung tissue densely packed with alveoli"@en ;
	dc:source	pwn30:05387842-n .

<i65288>	a	<Concept> ;
	skos:definition	"any of the three lobes of the right lung or the two lobes of the left lung"@en ;
	dc:source	pwn30:05387959-n .

<i65289>	a	<Concept> ;
	skos:definition	"the thin serous membrane around the lungs and inner walls of the chest"@en ;
	dc:source	pwn30:05388115-n .

<i65290>	a	<Concept> ;
	skos:definition	"pleura that lines the inner chest walls and covers the diaphragm"@en ;
	dc:source	pwn30:05388311-n .

<i65291>	a	<Concept> ;
	skos:definition	"pleura that covers the lungs"@en ;
	dc:source	pwn30:05388437-n .

<i65292>	a	<Concept> ;
	skos:definition	"the cavity in the thorax that contains the lungs and heart"@en ;
	dc:source	pwn30:05388527-n .

<i65293>	a	<Concept> ;
	skos:definition	"the small potential space between the parietal and visceral layers of the pleura"@en ;
	dc:source	pwn30:05388665-n .

<i65294>	a	<Concept> ;
	skos:definition	"the hollow muscular organ located behind the sternum and between the lungs; its rhythmic contractions move the blood through the body"@en ;
	dc:source	pwn30:05388805-n .

<i65295>	a	<Concept> ;
	skos:definition	"enlarged heart commonly found among athletes trained for endurance"@en ;
	dc:source	pwn30:05389182-n .

<i65296>	a	<Concept> ;
	skos:definition	"a heart (as of mammals and birds and reptiles) having two auricles"@en ;
	dc:source	pwn30:05389310-n .

<i65297>	a	<Concept> ;
	skos:definition	"a specialized bit of heart tissue that controls the heartbeat"@en ;
	dc:source	pwn30:05389460-n .

<i65298>	a	<Concept> ;
	skos:definition	"a thin triangular flap of a heart valve"@en ;
	dc:source	pwn30:05389625-n .

<i65299>	a	<Concept> ;
	skos:definition	"a movable piece of tissue partly connected to the body"@en ;
	dc:source	pwn30:05389762-n .

<i65300>	a	<Concept> ;
	skos:definition	"the muscle tissue of the heart; adapted to continued rhythmic contraction"@en ;
	dc:source	pwn30:05389939-n .

<i65301>	a	<Concept> ;
	skos:definition	"any of several muscles associated with the atrioventricular valves"@en ;
	dc:source	pwn30:05390233-n .

<i65302>	a	<Concept> ;
	skos:definition	"a bundle of modified heart muscle that transmits the cardiac impulse from the atrioventricular node to the ventricles causing them to contract"@en ;
	dc:source	pwn30:05390479-n .

<i65303>	a	<Concept> ;
	skos:definition	"a node of specialized heart muscle located in the septal wall of the right atrium; receives impulses from the sinoatrial node and transmits them to atrioventricular bundle"@en ;
	dc:source	pwn30:05390761-n .

<i65304>	a	<Concept> ;
	skos:definition	"the middle muscular layer of the heart wall"@en ;
	dc:source	pwn30:05391000-n .

<i65305>	a	<Concept> ;
	skos:definition	"a specialized cardiac muscle fiber that is part of the Purkinje network"@en ;
	dc:source	pwn30:05391118-n .

<i65306>	a	<Concept> ;
	skos:definition	"a network of Purkinje fibers that carry the cardiac impulse from the atrioventricular node to the ventricles of the heart and causes them to contract"@en ;
	dc:source	pwn30:05391269-n .

<i65307>	a	<Concept> ;
	skos:definition	"a triangular area of the front of the chest (determined by percussion); corresponds to the part of the heart not covered by the lungs"@en ;
	dc:source	pwn30:05391540-n .

<i65308>	a	<Concept> ;
	skos:definition	"a chamber of the heart that receives blood from an atrium and pumps it to the arteries"@en ;
	dc:source	pwn30:05391763-n .

<i65309>	a	<Concept> ;
	skos:definition	"the chamber on the left side of the heart that receives arterial blood from the left atrium and pumps it into the aorta"@en ;
	dc:source	pwn30:05391977-n .

<i65310>	a	<Concept> ;
	skos:definition	"the chamber on the right side of the heart that receives venous blood from the right atrium and pumps it into the pulmonary trunk"@en ;
	dc:source	pwn30:05392157-n .

<i65311>	a	<Concept> ;
	skos:definition	"a small conical pouch projecting from the upper anterior part of each atrium of the heart"@en ;
	dc:source	pwn30:05392348-n .

<i65312>	a	<Concept> ;
	skos:definition	"a pouch projecting from the top front of each atrium of the heart"@en ;
	dc:source	pwn30:05392562-n .

<i65313>	a	<Concept> ;
	skos:definition	"an enclosed volume in the body"@en ;
	dc:source	pwn30:05392744-n .

<i65314>	a	<Concept> ;
	skos:definition	"the cavity enclosed by the cranium"@en ;
	dc:source	pwn30:05392906-n .

<i65315>	a	<Concept> ;
	skos:definition	"any chamber that is connected to other chambers or passageways (especially one of the two upper chambers of the heart)"@en ;
	dc:source	pwn30:05393023-n .

<i65316>	a	<Concept> ;
	skos:definition	"the upper chamber of each half of the heart"@en ;
	dc:source	pwn30:05393230-n .

<i65317>	a	<Concept> ;
	skos:definition	"the right upper chamber of the heart that receives blood from the venae cavae and coronary sinus"@en ;
	dc:source	pwn30:05393429-n .

<i65318>	a	<Concept> ;
	skos:definition	"the left upper chamber of the heart that receives blood from the pulmonary veins"@en ;
	dc:source	pwn30:05393629-n .

<i65319>	a	<Concept> ;
	skos:definition	"valve with two cusps; situated between the left atrium and the left ventricle"@en ;
	dc:source	pwn30:05393813-n .

<i65320>	a	<Concept> ;
	skos:definition	"valve with three cusps; situated between the right atrium and the right ventricle; allows blood to pass from atrium to ventricle and closes to prevent backflow when the ventricle contracts"@en ;
	dc:source	pwn30:05393996-n .

<i65321>	a	<Concept> ;
	skos:definition	"either of two heart valves through which blood flows from the atria to the ventricles; prevents return of blood to the atrium"@en ;
	dc:source	pwn30:05394277-n .

<i65322>	a	<Concept> ;
	skos:definition	"a semilunar valve between the left ventricle and the aorta; prevents blood from flowing from the aorta back into the heart"@en ;
	dc:source	pwn30:05394526-n .

<i65323>	a	<Concept> ;
	skos:definition	"a semilunar valve between the right ventricle and the pulmonary artery; prevents blood from flowing from the artery back into the heart"@en ;
	dc:source	pwn30:05394707-n .

<i65324>	a	<Concept> ;
	skos:definition	"a heart valve with cusps shaped like half-moons; prevents blood from flowing back into the heart"@en ;
	dc:source	pwn30:05394904-n .

<i65325>	a	<Concept> ;
	skos:definition	"a valve to control one-way flow of blood"@en ;
	dc:source	pwn30:05395098-n .

<i65326>	a	<Concept> ;
	skos:definition	"a structure in a hollow organ (like the heart) with a flap to insure one-way flow of fluid through it"@en ;
	dc:source	pwn30:05395286-n .

<i65327>	a	<Concept> ;
	skos:definition	"a small valve"@en ;
	dc:source	pwn30:05395548-n .

<i65328>	a	<Concept> ;
	skos:definition	"an enlarged and muscular saclike organ of the alimentary canal; the principal organ of digestion"@en ;
	dc:source	pwn30:05395690-n .

<i65329>	a	<Concept> ;
	skos:definition	"the region lying on or over the stomach (just below the sternum)"@en ;
	dc:source	pwn30:05396071-n .

<i65330>	a	<Concept> ;
	skos:definition	"the opening into the stomach and that part of the stomach connected to the esophagus"@en ;
	dc:source	pwn30:05396229-n .

<i65331>	a	<Concept> ;
	skos:definition	"the interconnected system of spaces and vessels between body tissues and organs by which lymph circulates throughout the body"@en ;
	dc:source	pwn30:05396366-n .

<i65332>	a	<Concept> ;
	skos:definition	"the major duct of the lymphatic system"@en ;
	dc:source	pwn30:05396690-n .

<i65333>	a	<Concept> ;
	skos:definition	"a vascular duct that carries lymph which is eventually added to the venous blood circulation"@en ;
	dc:source	pwn30:05396807-n .

<i65334>	a	<Concept> ;
	skos:definition	"any of the lymphatic vessels that convey chyle from the small intestine to the thoracic duct"@en ;
	dc:source	pwn30:05397032-n .

<i65335>	a	<Concept> ;
	skos:definition	"a structure composed of or provided with blood vessels"@en ;
	dc:source	pwn30:05397178-n .

<i65336>	a	<Concept> ;
	skos:definition	"a tube in which a body fluid circulates"@en ;
	dc:source	pwn30:05397333-n .

<i65337>	a	<Concept> ;
	skos:definition	"the liquid parts of the body"@en ;
	dc:source	pwn30:05397468-n .

<i65338>	a	<Concept> ;
	skos:definition	"liquid containing proteins and electrolytes including the liquid in blood plasma and interstitial fluid"@en ;
	dc:source	pwn30:05398023-n .

<i65339>	a	<Concept> ;
	skos:definition	"liquid found between the cells of the body that provides much of the liquid environment of the body"@en ;
	dc:source	pwn30:05398298-n .

<i65340>	a	<Concept> ;
	skos:definition	"liquid contained inside the cell membranes (usually containing dissolved solutes)"@en ;
	dc:source	pwn30:05398462-n .

<i65341>	a	<Concept> ;
	skos:definition	"any of several liquids of the body"@en ;
	dc:source	pwn30:05398609-n .

<i65342>	a	<Concept> ;
	skos:definition	"a milky substance found in certain cancerous growths"@en ;
	dc:source	pwn30:05398760-n .

<i65343>	a	<Concept> ;
	skos:definition	"a clear liquid in the cell nucleus in which the nucleolus and chromatin and other structures are dispersed"@en ;
	dc:source	pwn30:05398871-n .

<i65344>	a	<Concept> ;
	skos:definition	"produced by mammary glands of female mammals for feeding their young"@en ;
	dc:source	pwn30:05399034-n .

<i65345>	a	<Concept> ;
	skos:definition	"milk secreted by a woman who has recently given birth"@en ;
	dc:source	pwn30:05399243-n .

<i65346>	a	<Concept> ;
	skos:definition	"milky fluid secreted for the first day or two after parturition"@en ;
	dc:source	pwn30:05399356-n .

<i65347>	a	<Concept> ;
	skos:definition	"the fluid-filled cavity that surrounds the developing embryo"@en ;
	dc:source	pwn30:05399486-n .

<i65348>	a	<Concept> ;
	skos:definition	"the serous fluid in which the embryo is suspended inside the amnion"@en ;
	dc:source	pwn30:05399627-n .

<i65349>	a	<Concept> ;
	skos:definition	"the fluid (red in vertebrates) that is pumped through the body by the heart and contains plasma, blood cells, and platelets"@en ;
	dc:source	pwn30:05399847-n .

<i65350>	a	<Concept> ;
	skos:definition	"blood found in arteries"@en ;
	dc:source	pwn30:05400445-n .

<i65351>	a	<Concept> ;
	skos:definition	"human blood cells (usually just the red blood cells) that have the same antigens"@en ;
	dc:source	pwn30:05400601-n .

<i65352>	a	<Concept> ;
	skos:definition	"the blood group whose red cells carry the A antigen"@en ;
	dc:source	pwn30:05400860-n .

<i65353>	a	<Concept> ;
	skos:definition	"the blood group whose red cells carry the B antigen"@en ;
	dc:source	pwn30:05400978-n .

<i65354>	a	<Concept> ;
	skos:definition	"the blood group whose red cells carry both the A and B antigens"@en ;
	dc:source	pwn30:05401096-n .

<i65355>	a	<Concept> ;
	skos:definition	"the blood group whose red cells carry neither the A nor B antigens"@en ;
	dc:source	pwn30:05401229-n .

<i65356>	a	<Concept> ;
	skos:definition	"the blood group (approximately 85% of people) whose red cells have the Rh factor (Rh antigen)"@en ;
	dc:source	pwn30:05401411-n .

<i65357>	a	<Concept> ;
	skos:definition	"the blood group whose red cells lack the Rh factor (Rh antigen)"@en ;
	dc:source	pwn30:05401587-n .

<i65358>	a	<Concept> ;
	skos:definition	"coagulated blood from a wound"@en ;
	dc:source	pwn30:05401753-n .

<i65359>	a	<Concept> ;
	skos:definition	"the blood considered as the seat of vitality"@en ;
	dc:source	pwn30:05401851-n .

<i65360>	a	<Concept> ;
	skos:definition	"the blood flowing through the circulatory system"@en ;
	dc:source	pwn30:05401951-n .

<i65361>	a	<Concept> ;
	skos:definition	"a lump of material formed from the content of a liquid"@en ;
	dc:source	pwn30:05402091-n .

<i65362>	a	<Concept> ;
	skos:definition	"a semisolid mass of coagulated red and white blood cells"@en ;
	dc:source	pwn30:05402333-n .

<i65363>	a	<Concept> ;
	skos:definition	"blood obtained from the umbilical cord at birth"@en ;
	dc:source	pwn30:05402472-n .

<i65364>	a	<Concept> ;
	skos:definition	"flow of blood from the uterus; occurs at roughly monthly intervals during a woman's reproductive years"@en ;
	dc:source	pwn30:05402576-n .

<i65365>	a	<Concept> ;
	skos:definition	"blood found in the veins"@en ;
	dc:source	pwn30:05402788-n .

<i65366>	a	<Concept> ;
	skos:definition	"blood that has not been modified except for the addition of an anticoagulant"@en ;
	dc:source	pwn30:05402961-n .

<i65367>	a	<Concept> ;
	skos:definition	"an amber, watery fluid, rich in proteins, that separates out when blood coagulates"@en ;
	dc:source	pwn30:05403149-n .

<i65368>	a	<Concept> ;
	skos:definition	"the colorless watery fluid of the blood and lymph that contains no cells, but in which the blood cells (erythrocytes, leukocytes, and thrombocytes) are suspended"@en ;
	dc:source	pwn30:05403427-n .

<i65369>	a	<Concept> ;
	skos:definition	"blood serum containing antibodies against specific antigens; provides immunity to a disease"@en ;
	dc:source	pwn30:05403702-n .

<i65370>	a	<Concept> ;
	skos:definition	"a milky fluid consisting of lymph and emulsified fats; formed in the small intestine during digestion of ingested fats"@en ;
	dc:source	pwn30:05403849-n .

<i65371>	a	<Concept> ;
	skos:definition	"a thin coagulable fluid (similar to plasma but) containing white blood cells (lymphocytes) and chyle; is conveyed to the blood stream by lymphatic vessels"@en ;
	dc:source	pwn30:05404074-n .

<i65372>	a	<Concept> ;
	skos:definition	"the thick white fluid containing spermatozoa that is ejaculated by the male genital tract"@en ;
	dc:source	pwn30:05404336-n .

<i65373>	a	<Concept> ;
	skos:definition	"dark protective fluid ejected into the water by cuttlefish and other cephalopods"@en ;
	dc:source	pwn30:05404598-n .

<i65374>	a	<Concept> ;
	skos:definition	"a functionally specialized substance (especially one that is not a waste) released from a gland or cell"@en ;
	dc:source	pwn30:05404728-n .

<i65375>	a	<Concept> ;
	skos:definition	"saline fluid secreted by lacrimal glands; lubricates the surface of the eyeball"@en ;
	dc:source	pwn30:05405139-n .

<i65376>	a	<Concept> ;
	skos:definition	"a drop of the clear salty saline solution secreted by the lacrimal glands"@en ;
	dc:source	pwn30:05405324-n .

<i65377>	a	<Concept> ;
	skos:definition	"the structures that secrete and drain tears from the eye"@en ;
	dc:source	pwn30:05405554-n .

<i65378>	a	<Concept> ;
	skos:definition	"salty fluid secreted by sweat glands"@en ;
	dc:source	pwn30:05405751-n .

<i65379>	a	<Concept> ;
	skos:definition	"secretions that aid digestion"@en ;
	dc:source	pwn30:05405946-n .

<i65380>	a	<Concept> ;
	skos:definition	"digestive secretions of the stomach glands consisting chiefly of hydrochloric acid and mucin and the enzymes pepsin and rennin and lipase"@en ;
	dc:source	pwn30:05406128-n .

<i65381>	a	<Concept> ;
	skos:definition	"a fluid secreted into the duodenum by the pancreas; important for breaking down starches and proteins and fats"@en ;
	dc:source	pwn30:05406397-n .

<i65382>	a	<Concept> ;
	skos:definition	"a digestive juice secreted by the liver and stored in the gallbladder; aids in the digestion of fats"@en ;
	dc:source	pwn30:05406570-n .

<i65383>	a	<Concept> ;
	skos:definition	"a humor that was once believed to be secreted by the kidneys or spleen and to cause sadness and melancholy"@en ;
	dc:source	pwn30:05406782-n .

<i65384>	a	<Concept> ;
	skos:definition	"a humor that was once believed to be secreted by the liver and to cause irritability and anger"@en ;
	dc:source	pwn30:05406958-n .

<i65385>	a	<Concept> ;
	skos:definition	"the secretion of an endocrine gland that is transmitted by the blood to the tissue on which it has a specific effect"@en ;
	dc:source	pwn30:05407119-n .

<i65386>	a	<Concept> ;
	skos:definition	"secretions by glands lining the walls of the intestines"@en ;
	dc:source	pwn30:05407772-n .

<i65387>	a	<Concept> ;
	skos:definition	"a catecholamine precursor of epinephrine that is secreted by the adrenal medulla and also released at synapses"@en ;
	dc:source	pwn30:05407890-n .

<i65388>	a	<Concept> ;
	skos:definition	"a hormone produced by the anterior pituitary gland that stimulates the adrenal cortex"@en ;
	dc:source	pwn30:05408113-n .

<i65389>	a	<Concept> ;
	skos:definition	"a catecholamine secreted by the adrenal medulla in response to stress (trade name Adrenalin); stimulates autonomic nerve action"@en ;
	dc:source	pwn30:05408388-n .

<i65390>	a	<Concept> ;
	skos:definition	"hormones that affect gastrointestinal functioning"@en ;
	dc:source	pwn30:05408684-n .

<i65391>	a	<Concept> ;
	skos:definition	"polypeptide hormone secreted by the mucous lining of the stomach; when peptides and amino acids are present in the small intestine the secretion of gastric acid is stimulated"@en ;
	dc:source	pwn30:05408908-n .

<i65392>	a	<Concept> ;
	skos:definition	"a gastrointestinal hormone that stimulates the secretion of pancreatic enzymes and the contraction and emptying of the gall bladder; its release is stimulated by the presence of fatty acids and amino acids in the small intestine"@en ;
	dc:source	pwn30:05409136-n .

<i65393>	a	<Concept> ;
	skos:definition	"a gastrointestinal hormone that stimulates the secretion of water and bicarbonate from the pancreas and bile ducts whenever the stomach empties too much acid into the small intestine"@en ;
	dc:source	pwn30:05409426-n .

<i65394>	a	<Concept> ;
	skos:definition	"a gastrointestinal hormone produced by epithelial cells lining the fundus of the stomach; appears to be a stimulant for appetite and feeding, but is also a strong stimulant of growth hormone secretion from the anterior pituitary"@en ;
	dc:source	pwn30:05409663-n .

<i65395>	a	<Concept> ;
	skos:definition	"a gastrointestinal hormone that apparently participates in controlling smooth muscle contractions in the stomach and small intestine"@en ;
	dc:source	pwn30:05409945-n .

<i65396>	a	<Concept> ;
	skos:definition	"a hormone secreted by the pancreas; stimulates increases in blood sugar levels in the blood (thus opposing the action of insulin)"@en ;
	dc:source	pwn30:05410131-n .

<i65397>	a	<Concept> ;
	skos:definition	"hormone secreted by the anterior pituitary gland and placenta; stimulates the gonads and controls reproductive activity"@en ;
	dc:source	pwn30:05410315-n .

<i65398>	a	<Concept> ;
	skos:definition	"hormone secreted by the isles of Langerhans in the pancreas; regulates storage of glycogen in the liver and accelerates oxidation of sugar in cells"@en ;
	dc:source	pwn30:05410646-n .

<i65399>	a	<Concept> ;
	skos:definition	"trade names for forms of insulin that are used to treat diabetes mellitus"@en ;
	dc:source	pwn30:05410901-n .

<i65400>	a	<Concept> ;
	skos:definition	"a form of insulin (trade name Humulin) made from recombinant DNA that is identical to human insulin; used to treat diabetics who are allergic to preparations made from beef or pork insulin"@en ;
	dc:source	pwn30:05411049-n .

<i65401>	a	<Concept> ;
	skos:definition	"hormone secreted by the pineal gland"@en ;
	dc:source	pwn30:05411338-n .

<i65402>	a	<Concept> ;
	skos:definition	"a hormone that is released by nerve impulses (e.g., norepinephrine or vasopressin)"@en ;
	dc:source	pwn30:05411430-n .

<i65403>	a	<Concept> ;
	skos:definition	"hormone secreted by the posterior pituitary gland (trade name Pitocin); stimulates contractions of the uterus and ejection of milk"@en ;
	dc:source	pwn30:05411571-n .

<i65404>	a	<Concept> ;
	skos:definition	"hormone synthesized and released into the blood stream by the parathyroid glands; regulates phosphorus and calcium in the body and functions in neuromuscular excitation and blood clotting"@en ;
	dc:source	pwn30:05411785-n .

<i65405>	a	<Concept> ;
	skos:definition	"hormone secreted by the corpus luteum during the last days of pregnancy; relaxes the pelvic ligaments and prepares the uterus for labor"@en ;
	dc:source	pwn30:05412053-n .

<i65406>	a	<Concept> ;
	skos:definition	"any of several hormones produced in the hypothalamus and carried by a vein to the anterior pituitary gland where they stimulate the release of anterior pituitary hormones; each of these hormones causes the anterior pituitary to secrete a specific hormone"@en ;
	dc:source	pwn30:05412242-n .

<i65407>	a	<Concept> ;
	skos:definition	"a hormone produced by the anterior pituitary gland; promotes growth in humans"@en ;
	dc:source	pwn30:05412649-n .

<i65408>	a	<Concept> ;
	skos:definition	"trade name of a synthetic human growth hormone given to children deficient in the hormone; use by athletes and weightlifters is banned"@en ;
	dc:source	pwn30:05412912-n .

<i65409>	a	<Concept> ;
	skos:definition	"hormone secreted by the thymus; stimulates immunological activity of lymphoid tissue"@en ;
	dc:source	pwn30:05413102-n .

<i65410>	a	<Concept> ;
	skos:definition	"any of several closely related compounds that are produced by the thyroid gland and are active metabolically"@en ;
	dc:source	pwn30:05413241-n .

<i65411>	a	<Concept> ;
	skos:definition	"thyroid hormone that tends to lower the level of calcium in the blood plasma and inhibit resorption of bone"@en ;
	dc:source	pwn30:05413465-n .

<i65412>	a	<Concept> ;
	skos:definition	"hormone produced by the thyroid glands to regulate metabolism by controlling the rate of oxidation in cells"@en ;
	dc:source	pwn30:05413647-n .

<i65413>	a	<Concept> ;
	skos:definition	"thyroid hormone similar to thyroxine but with one less iodine atom per molecule and produced in smaller quantity; exerts the same biological effects as thyroxine but is more potent and briefer"@en ;
	dc:source	pwn30:05413873-n .

<i65414>	a	<Concept> ;
	skos:definition	"hormone secreted by the posterior pituitary gland (trade name Pitressin) and also by nerve endings in the hypothalamus; affects blood pressure by stimulating capillary muscles and reduces urine flow by affecting reabsorption of water by kidney tubules"@en ;
	dc:source	pwn30:05414147-n .

<i65415>	a	<Concept> ;
	skos:definition	"any physiologically active internal secretion especially one of uncertain classification"@en ;
	dc:source	pwn30:05414534-n .

<i65416>	a	<Concept> ;
	skos:definition	"amine formed from histidine that stimulates gastric secretions and dilates blood vessels; released by the human immune system during allergic reactions"@en ;
	dc:source	pwn30:05414724-n .

<i65417>	a	<Concept> ;
	skos:definition	"a potent substance that acts like a hormone and is found in many bodily tissues (and especially in semen); produced in response to trauma and may affect blood pressure and metabolism and smooth muscle activity"@en ;
	dc:source	pwn30:05414931-n .

<i65418>	a	<Concept> ;
	skos:definition	"viscid lubricating fluid secreted by the membrane lining joints and tendon sheaths etc."@en ;
	dc:source	pwn30:05415200-n .

<i65419>	a	<Concept> ;
	skos:definition	"protective secretion of the mucus membranes; in the gut it lubricates the passage of food and protects the epithelial cells; in the nose and throat and lungs it can make it difficult for bacteria to penetrate the body through the epithelium"@en ;
	dc:source	pwn30:05415395-n .

<i65420>	a	<Concept> ;
	skos:definition	"expectorated matter; saliva mixed with discharges from the respiratory passages; in ancient and medieval physiology it was believed to cause sluggishness"@en ;
	dc:source	pwn30:05415815-n .

<i65421>	a	<Concept> ;
	skos:definition	"nasal mucus"@en ;
	dc:source	pwn30:05416048-n .

<i65422>	a	<Concept> ;
	skos:definition	"dried nasal mucus"@en ;
	dc:source	pwn30:05416128-n .

<i65423>	a	<Concept> ;
	skos:definition	"a clear liquid secreted into the mouth by the salivary glands and mucous glands of the mouth; moistens the mouth and starts the digestion of starches"@en ;
	dc:source	pwn30:05416198-n .

<i65424>	a	<Concept> ;
	skos:definition	"a duct through which saliva passes from the salivary gland into the mouth"@en ;
	dc:source	pwn30:05416545-n .

<i65425>	a	<Concept> ;
	skos:definition	"saliva spilling from the mouth"@en ;
	dc:source	pwn30:05416678-n .

<i65426>	a	<Concept> ;
	skos:definition	"saliva colored brown by tobacco (snuff or chewing tobacco)"@en ;
	dc:source	pwn30:05416861-n .

<i65427>	a	<Concept> ;
	skos:definition	"the oily secretion of the sebaceous glands; with perspiration it moistens and protects the skin"@en ;
	dc:source	pwn30:05416979-n .

<i65428>	a	<Concept> ;
	skos:definition	"a white secretion of the sebaceous glands of the foreskin"@en ;
	dc:source	pwn30:05417162-n .

<i65429>	a	<Concept> ;
	skos:definition	"substance discharged from the vagina (cellular debris and mucus and blood) that gradually decreases in amount during the weeks following childbirth"@en ;
	dc:source	pwn30:05417272-n .

<i65430>	a	<Concept> ;
	skos:definition	"a fluid product of inflammation"@en ;
	dc:source	pwn30:05417472-n .

<i65431>	a	<Concept> ;
	skos:definition	"a thin morbid discharge as from a wound or especially chronic gonorrhea"@en ;
	dc:source	pwn30:05417698-n .

<i65432>	a	<Concept> ;
	skos:definition	"discharge of white mucous material from the vagina; often an indication of infection"@en ;
	dc:source	pwn30:05417821-n .

<i65433>	a	<Concept> ;
	skos:definition	"a vessel in which blood circulates"@en ;
	dc:source	pwn30:05417975-n .

<i65434>	a	<Concept> ;
	skos:definition	"a blood vessel in a fetus that bypasses pulmonary circulation by connecting the pulmonary artery directly to the ascending aorta; normally closes at birth"@en ;
	dc:source	pwn30:05418177-n .

<i65435>	a	<Concept> ;
	skos:definition	"a ductus arteriosus that failed to close at birth; may require surgical correction"@en ;
	dc:source	pwn30:05418432-n .

<i65436>	a	<Concept> ;
	skos:definition	"any small blood vessel ramifying on the outside of a major artery or vein"@en ;
	dc:source	pwn30:05418585-n .

<i65437>	a	<Concept> ;
	skos:definition	"a blood vessel that carries blood from the capillaries toward the heart"@en ;
	dc:source	pwn30:05418717-n .

<i65438>	a	<Concept> ;
	skos:definition	"(zoology) the system of venous blood vessels in an animal"@en ;
	dc:source	pwn30:05421414-n .

<i65439>	a	<Concept> ;
	skos:definition	"a vein that is permanently dilated; most common in the legs"@en ;
	dc:source	pwn30:05421586-n .

<i65440>	a	<Concept> ;
	skos:definition	"vein of the head of the penis; tributary of the internal pudendal vein that drains the perineum"@en ;
	dc:source	pwn30:05421723-n .

<i65441>	a	<Concept> ;
	skos:definition	"vein of the cochlear canal"@en ;
	dc:source	pwn30:05421900-n .

<i65442>	a	<Concept> ;
	skos:definition	"a vein serving the penis"@en ;
	dc:source	pwn30:05421997-n .

<i65443>	a	<Concept> ;
	skos:definition	"superficial dorsal veins of the penis; paired tributaries of the external pudendal veins on each side"@en ;
	dc:source	pwn30:05422135-n .

<i65444>	a	<Concept> ;
	skos:definition	"deep dorsal vein of the penis; tributary of the prostatic plexus"@en ;
	dc:source	pwn30:05422317-n .

<i65445>	a	<Concept> ;
	skos:definition	"deep vein of the penis; enters the prostatic plexus"@en ;
	dc:source	pwn30:05422457-n .

<i65446>	a	<Concept> ;
	skos:definition	"vein of the vestibular bulb"@en ;
	dc:source	pwn30:05422574-n .

<i65447>	a	<Concept> ;
	skos:definition	"either of two large veins that return oxygen-depleted blood to the right atrium of the heart"@en ;
	dc:source	pwn30:05422668-n .

<i65448>	a	<Concept> ;
	skos:definition	"receives blood from lower limbs and abdominal organs and empties into the posterior part of the right atrium of the heart; formed from the union of the two iliac veins"@en ;
	dc:source	pwn30:05422852-n .

<i65449>	a	<Concept> ;
	skos:definition	"receives blood from the head and arms and chest and empties into the right atrium of the heart; formed from the azygos and both brachiocephalic veins"@en ;
	dc:source	pwn30:05423095-n .

<i65450>	a	<Concept> ;
	skos:definition	"deep veins of the clitoris; join the vesical plexus"@en ;
	dc:source	pwn30:05423319-n .

<i65451>	a	<Concept> ;
	skos:definition	"deep dorsal vein of the clitoris; tributary of the vesical venous plexus"@en ;
	dc:source	pwn30:05423443-n .

<i65452>	a	<Concept> ;
	skos:definition	"superficial dorsal veins of the clitoris; tributaries of the external pudendal vein on either side"@en ;
	dc:source	pwn30:05423595-n .

<i65453>	a	<Concept> ;
	skos:definition	"veins of the eyelids"@en ;
	dc:source	pwn30:05423779-n .

<i65454>	a	<Concept> ;
	skos:definition	"interlobular veins of the kidney; receive blood from the arcuate vein and empty into the renal veins"@en ;
	dc:source	pwn30:05423882-n .

<i65455>	a	<Concept> ;
	skos:definition	"interlobular veins of the liver"@en ;
	dc:source	pwn30:05424074-n .

<i65456>	a	<Concept> ;
	skos:definition	"veins of the kidney; drain the kidney into the renal vein"@en ;
	dc:source	pwn30:05424199-n .

<i65457>	a	<Concept> ;
	skos:definition	"veins from the labia majora to the external pudendal vein"@en ;
	dc:source	pwn30:05424351-n .

<i65458>	a	<Concept> ;
	skos:definition	"veins that pass posterior from the labia majora to the internal pudendal vein"@en ;
	dc:source	pwn30:05424504-n .

<i65459>	a	<Concept> ;
	skos:definition	"a bulging body part (as the belly of a muscle)"@en ;
	dc:source	pwn30:05424679-n .

<i65460>	a	<Concept> ;
	skos:definition	"the womb"@en ;
	dc:source	pwn30:05424796-n .

<i65461>	a	<Concept> ;
	skos:definition	"one of two the two roots of a spinal nerve that passes ventrally from the spinal cord and that consists of motor fibers"@en ;
	dc:source	pwn30:05424963-n .

<i65462>	a	<Concept> ;
	skos:definition	"a vein that goes through the foramina of the cervical vertebrae and forms a plexus around the vertebral artery; empties into the brachiocephalic vein"@en ;
	dc:source	pwn30:05425207-n .

<i65463>	a	<Concept> ;
	skos:definition	"veins that drain the vesical plexus and join the internal iliac veins"@en ;
	dc:source	pwn30:05425436-n .

<i65464>	a	<Concept> ;
	skos:definition	"veins that drain the saccule and utricle"@en ;
	dc:source	pwn30:05425581-n .

<i65465>	a	<Concept> ;
	skos:definition	"a vein formed by branches from the back surface of the eye and the ciliary body; empties into the ophthalmic veins"@en ;
	dc:source	pwn30:05425703-n .

<i65466>	a	<Concept> ;
	skos:definition	"any of the minute blood vessels connecting arterioles with venules"@en ;
	dc:source	pwn30:05425910-n .

<i65467>	a	<Concept> ;
	skos:definition	"a minute vein continuous with a capillary"@en ;
	dc:source	pwn30:05426087-n .

<i65468>	a	<Concept> ;
	skos:definition	"a pliable sheet of tissue that covers or lines or connects the organs or cells of animals or plants"@en ;
	dc:source	pwn30:05426243-n .

<i65469>	a	<Concept> ;
	skos:definition	"the innermost light-sensitive membrane covering the back wall of the eyeball; it is continuous with the optic nerve"@en ;
	dc:source	pwn30:05426989-n .

<i65470>	a	<Concept> ;
	skos:definition	"a nerve cell whose body is outside the central nervous system"@en ;
	dc:source	pwn30:05427346-n .

<i65471>	a	<Concept> ;
	skos:definition	"an extensible membrane enclosing the contractile substance of a muscle fiber"@en ;
	dc:source	pwn30:05427570-n .

<i65472>	a	<Concept> ;
	skos:definition	"a transparent membrane that lines the abdominal cavity in mammals and covers most of the viscera"@en ;
	dc:source	pwn30:05427739-n .

<i65473>	a	<Concept> ;
	skos:definition	"the interior of the peritoneum; a potential space between layers of the peritoneum"@en ;
	dc:source	pwn30:05427946-n .

<i65474>	a	<Concept> ;
	skos:definition	"an isolated part of the peritoneal cavity that is dorsal to the stomach"@en ;
	dc:source	pwn30:05428136-n .

<i65475>	a	<Concept> ;
	skos:definition	"the membrane that lines the cavities of the heart and forms part of the heart valves"@en ;
	dc:source	pwn30:05428331-n .

<i65476>	a	<Concept> ;
	skos:definition	"a serous membrane with two layers that surrounds the heart"@en ;
	dc:source	pwn30:05428473-n .

<i65477>	a	<Concept> ;
	skos:definition	"the innermost of the two layers of the pericardium"@en ;
	dc:source	pwn30:05428645-n .

<i65478>	a	<Concept> ;
	skos:definition	"the tough outermost layer of the pericardium that is attached to the diaphragm and the sternum"@en ;
	dc:source	pwn30:05428794-n .

<i65479>	a	<Concept> ;
	skos:definition	"the space between the layers of the pericardium that contains fluid that lubricates the membrane surfaces and allows easy heart movement"@en ;
	dc:source	pwn30:05428974-n .

<i65480>	a	<Concept> ;
	skos:definition	"a double layer of peritoneum that attaches to the back wall of the abdominal cavity and supports the small intestines"@en ;
	dc:source	pwn30:05429195-n .

<i65481>	a	<Concept> ;
	skos:definition	"mesentery that holds the lower colon to the dorsal abdominal wall"@en ;
	dc:source	pwn30:05429404-n .

<i65482>	a	<Concept> ;
	skos:definition	"a fold of peritoneum supporting the viscera"@en ;
	dc:source	pwn30:05429525-n .

<i65483>	a	<Concept> ;
	skos:definition	"part of the peritoneum attached to the stomach and to the colon and covering the intestines"@en ;
	dc:source	pwn30:05429658-n .

<i65484>	a	<Concept> ;
	skos:definition	"a part of the peritoneum attached to the stomach and liver and supporting the hepatic vessels"@en ;
	dc:source	pwn30:05429840-n .

<i65485>	a	<Concept> ;
	skos:definition	"the connective tissue beneath mucous membrane"@en ;
	dc:source	pwn30:05429994-n .

<i65486>	a	<Concept> ;
	skos:definition	"the source of lymph and lymphocytes"@en ;
	dc:source	pwn30:05430095-n .

<i65487>	a	<Concept> ;
	skos:definition	"any of the lymph glands of the armpit; fights infections in the neck and chest and arm regions"@en ;
	dc:source	pwn30:05430300-n .

<i65488>	a	<Concept> ;
	skos:definition	"any of several lymph nodes in the walls of the intestines near the junction of the ileum and colon"@en ;
	dc:source	pwn30:05430454-n .

<i65489>	a	<Concept> ;
	skos:definition	"any of the cells of a plant or animal except the reproductive cells; a cell that does not participate in the production of gametes; "@en ;
	dc:source	pwn30:05430628-n .

<i65490>	a	<Concept> ;
	skos:definition	"a cell that is part of tumor"@en ;
	dc:source	pwn30:05431177-n .

<i65491>	a	<Concept> ;
	skos:definition	"a cell that is part of a malignant tumor"@en ;
	dc:source	pwn30:05431285-n .

<i65492>	a	<Concept> ;
	skos:definition	"a mass of undifferentiated cells from which an organ or body part develops"@en ;
	dc:source	pwn30:05431402-n .

<i65493>	a	<Concept> ;
	skos:definition	"a biological unit consisting of a nucleus and the body of cytoplasm with which it interacts"@en ;
	dc:source	pwn30:05431585-n .

<i65494>	a	<Concept> ;
	skos:definition	"the nucleus of the ovum or sperm after fertilization but before they fuse to form the nucleus of the zygote"@en ;
	dc:source	pwn30:05431762-n .

<i65495>	a	<Concept> ;
	skos:definition	"(genetics) the diploid cell resulting from the union of a haploid spermatozoon and ovum (including the organism that develops from that cell)"@en ;
	dc:source	pwn30:05431926-n .

<i65496>	a	<Concept> ;
	skos:definition	"(genetics) an organism having two different alleles of a particular gene and so giving rise to varying offspring"@en ;
	dc:source	pwn30:05432230-n .

<i65497>	a	<Concept> ;
	skos:definition	"(genetics) an organism having two identical alleles of a particular gene and so breeding true for the particular characteristic"@en ;
	dc:source	pwn30:05432420-n .

<i65498>	a	<Concept> ;
	skos:definition	"a cell resulting from parthenogenesis"@en ;
	dc:source	pwn30:05432623-n .

<i65499>	a	<Concept> ;
	skos:definition	"the substance of a living cell (including cytoplasm and nucleus)"@en ;
	dc:source	pwn30:05432736-n .

<i65500>	a	<Concept> ;
	skos:definition	"the protoplasm of a cell excluding the nucleus; is full of proteins that control cell metabolism"@en ;
	dc:source	pwn30:05432948-n .

<i65501>	a	<Concept> ;
	skos:definition	"the intact cytoplasmic content of a cell"@en ;
	dc:source	pwn30:05433400-n .

<i65502>	a	<Concept> ;
	skos:definition	"a microscopic network of actin filaments and microtubules in the cytoplasm of many living cells that gives the cell shape and coherence"@en ;
	dc:source	pwn30:05433496-n .

<i65503>	a	<Concept> ;
	skos:definition	"the aqueous part of the cytoplasm within which various particles and organelles are suspended"@en ;
	dc:source	pwn30:05433709-n .

<i65504>	a	<Concept> ;
	skos:definition	"the outer granule-free layer of cytoplasm"@en ;
	dc:source	pwn30:05433856-n .

<i65505>	a	<Concept> ;
	skos:definition	"the inner portion of the cytoplasm of a cell"@en ;
	dc:source	pwn30:05433953-n .

<i65506>	a	<Concept> ;
	skos:definition	"the clear nongranular portion of the cytoplasm of a cell"@en ;
	dc:source	pwn30:05434053-n .

<i65507>	a	<Concept> ;
	skos:definition	"an organelle found in the cytoplasm of most cells (especially in leukocytes and liver and kidney cells)"@en ;
	dc:source	pwn30:05434203-n .

<i65508>	a	<Concept> ;
	skos:definition	"a tiny granule in the cytoplasm that is where protein synthesis takes place under the direction of mRNA"@en ;
	dc:source	pwn30:05434361-n .

<i65509>	a	<Concept> ;
	skos:definition	"a netlike structure in the cytoplasm of animal cells (especially in those cells that produce secretions)"@en ;
	dc:source	pwn30:05434557-n .

<i65510>	a	<Concept> ;
	skos:definition	"the protoplasm that constitutes the nucleus of a cell"@en ;
	dc:source	pwn30:05434784-n .

<i65511>	a	<Concept> ;
	skos:definition	"a part of the cell containing DNA and RNA and responsible for growth and reproduction"@en ;
	dc:source	pwn30:05434927-n .

<i65512>	a	<Concept> ;
	skos:definition	"a small round body of protein in a cell nucleus; such organelles contain RNA and are involved in protein synthesis"@en ;
	dc:source	pwn30:05435277-n .

<i65513>	a	<Concept> ;
	skos:definition	"the particular part of a chromosome that is associated with a nucleolus after nuclear division"@en ;
	dc:source	pwn30:05435477-n .

<i65514>	a	<Concept> ;
	skos:definition	"the protoplasm of the germ cells that contains chromosomes and genes"@en ;
	dc:source	pwn30:05435722-n .

<i65515>	a	<Concept> ;
	skos:definition	"chromatin found only in female cells"@en ;
	dc:source	pwn30:05435855-n .

<i65516>	a	<Concept> ;
	skos:definition	"the readily stainable substance of a cell nucleus consisting of DNA and RNA and various proteins; during mitotic division it condenses into chromosomes"@en ;
	dc:source	pwn30:05436080-n .

<i65517>	a	<Concept> ;
	skos:definition	"the part of a cell nucleus that is relatively uncolored by stains or dyes"@en ;
	dc:source	pwn30:05436381-n .

<i65518>	a	<Concept> ;
	skos:definition	"an obsolete term for the network of viscous material in the cell nucleus on which the chromatin granules were thought to be suspended"@en ;
	dc:source	pwn30:05436548-n .

<i65519>	a	<Concept> ;
	skos:definition	"(genetics) a segment of DNA that is involved in producing a polypeptide chain; it can include regions preceding and following the coding DNA as well as introns between the exons; it is considered a unit of heredity"@en ;
	dc:source	pwn30:05436752-n .

<i65520>	a	<Concept> ;
	skos:definition	"gene that produces the same phenotype in the organism whether or not its allele identical"@en ;
	dc:source	pwn30:05437600-n .

<i65521>	a	<Concept> ;
	skos:definition	"(genetics) either of a pair (or series) of alternative forms of a gene that can occupy the same locus on a particular chromosome and that control the same character"@en ;
	dc:source	pwn30:05437785-n .

<i65522>	a	<Concept> ;
	skos:definition	"an allele that produces the same phenotype whether its paired allele is identical or different"@en ;
	dc:source	pwn30:05438130-n .

<i65523>	a	<Concept> ;
	skos:definition	"an allele that produces its characteristic phenotype only when its paired allele is identical"@en ;
	dc:source	pwn30:05438315-n .

<i65524>	a	<Concept> ;
	skos:definition	"a specific gene that produces a recognizable trait and can be used in family or population studies"@en ;
	dc:source	pwn30:05438483-n .

<i65525>	a	<Concept> ;
	skos:definition	"one the genes that are involved in embryologic development"@en ;
	dc:source	pwn30:05438642-n .

<i65526>	a	<Concept> ;
	skos:definition	"one of various similar homeotic genes that are involved in bodily segmentation during embryonic development"@en ;
	dc:source	pwn30:05438778-n .

<i65527>	a	<Concept> ;
	skos:definition	"any gene that has an effect that causes the death of the organism at any stage of life"@en ;
	dc:source	pwn30:05438956-n .

<i65528>	a	<Concept> ;
	skos:definition	"any pair of genes that tend to be transmitted together"@en ;
	dc:source	pwn30:05439100-n .

<i65529>	a	<Concept> ;
	skos:definition	"a gene that modifies the effect produced by another gene"@en ;
	dc:source	pwn30:05439286-n .

<i65530>	a	<Concept> ;
	skos:definition	"a gene that has changed so that the normal transmission and expression of a trait is affected"@en ;
	dc:source	pwn30:05439413-n .

<i65531>	a	<Concept> ;
	skos:definition	"(genetics) a combination of alleles (for different genes) that are located closely together on the same chromosome and that tend to be inherited together"@en ;
	dc:source	pwn30:05439582-n .

<i65532>	a	<Concept> ;
	skos:definition	"the gene that is mutated in cystic fibrosis"@en ;
	dc:source	pwn30:05439810-n .

<i65533>	a	<Concept> ;
	skos:definition	"genes that are not competitors at the same locus"@en ;
	dc:source	pwn30:05439942-n .

<i65534>	a	<Concept> ;
	skos:definition	"a gene that activates the production of messenger RNA by adjacent structural genes"@en ;
	dc:source	pwn30:05440046-n .

<i65535>	a	<Concept> ;
	skos:definition	"a segment of DNA containing adjacent genes including structural genes and an operator gene and a regulatory gene"@en ;
	dc:source	pwn30:05440207-n .

<i65536>	a	<Concept> ;
	skos:definition	"a gene that disposes normal cells to change into cancerous tumor cells"@en ;
	dc:source	pwn30:05440410-n .

<i65537>	a	<Concept> ;
	skos:definition	"a gene that by itself has little effect on the phenotype but which can act together with others to produce observable variations"@en ;
	dc:source	pwn30:05440555-n .

<i65538>	a	<Concept> ;
	skos:definition	"a normal gene that has the potential to become an oncogene"@en ;
	dc:source	pwn30:05440756-n .

<i65539>	a	<Concept> ;
	skos:definition	"gene that produces its characteristic phenotype only when its allele is identical"@en ;
	dc:source	pwn30:05440875-n .

<i65540>	a	<Concept> ;
	skos:definition	"a gene that produces a repressor substance that inhibits an operator gene"@en ;
	dc:source	pwn30:05441053-n .

<i65541>	a	<Concept> ;
	skos:definition	"gene that prevents a nonallele from being transcribed"@en ;
	dc:source	pwn30:05441224-n .

<i65542>	a	<Concept> ;
	skos:definition	"a gene that controls the production of a specific protein or peptide"@en ;
	dc:source	pwn30:05441338-n .

<i65543>	a	<Concept> ;
	skos:definition	"a gene that suppresses the phenotypic expression of another gene (especially of a mutant gene)"@en ;
	dc:source	pwn30:05441468-n .

<i65544>	a	<Concept> ;
	skos:definition	"an exogenous gene introduced into the genome of another organism"@en ;
	dc:source	pwn30:05441686-n .

<i65545>	a	<Concept> ;
	skos:definition	"a suppressor gene that blocks unscheduled cell division"@en ;
	dc:source	pwn30:05441806-n .

<i65546>	a	<Concept> ;
	skos:definition	"a gene located on an X chromosome"@en ;
	dc:source	pwn30:05441929-n .

<i65547>	a	<Concept> ;
	skos:definition	"a gene located on a Y chromosome"@en ;
	dc:source	pwn30:05442022-n .

<i65548>	a	<Concept> ;
	skos:definition	"a threadlike strand of DNA in the cell nucleus that carries the genes in a linear order"@en ;
	dc:source	pwn30:05442131-n .

<i65549>	a	<Concept> ;
	skos:definition	"the sex chromosome that is present in both sexes: singly in males and doubly in females"@en ;
	dc:source	pwn30:05442594-n .

<i65550>	a	<Concept> ;
	skos:definition	"(genetics) normal complement of sex chromosomes in a female"@en ;
	dc:source	pwn30:05442789-n .

<i65551>	a	<Concept> ;
	skos:definition	"(genetics) abnormal complement of three X chromosomes in a female"@en ;
	dc:source	pwn30:05442916-n .

<i65552>	a	<Concept> ;
	skos:definition	"(genetics) abnormal complement of sex hormones in a male resulting in Klinefelter's syndrome"@en ;
	dc:source	pwn30:05443050-n .

<i65553>	a	<Concept> ;
	skos:definition	"(genetics) normal complement of sex hormones in a male"@en ;
	dc:source	pwn30:05443211-n .

<i65554>	a	<Concept> ;
	skos:definition	"(genetics) abnormal complement of sex hormones in a male who has two Y chromosomes"@en ;
	dc:source	pwn30:05443333-n .

<i65555>	a	<Concept> ;
	skos:definition	"the sex chromosome that is carried by men"@en ;
	dc:source	pwn30:05443484-n .

<i65556>	a	<Concept> ;
	skos:definition	"(genetics) a chromosome that determines the sex of an individual"@en ;
	dc:source	pwn30:05443651-n .

<i65557>	a	<Concept> ;
	skos:definition	"any chromosome that is not a sex chromosome; appear in pairs in body cells but as single chromosomes in spermatozoa"@en ;
	dc:source	pwn30:05443966-n .

<i65558>	a	<Concept> ;
	skos:definition	"one of two identical strands into which a chromosome splits during mitosis"@en ;
	dc:source	pwn30:05444175-n .

<i65559>	a	<Concept> ;
	skos:definition	"a specialized condensed region of each chromosome that appears during mitosis where the chromatids are held together to form an X shape"@en ;
	dc:source	pwn30:05444324-n .

<i65560>	a	<Concept> ;
	skos:definition	"a chromosome lacking a centromere"@en ;
	dc:source	pwn30:05444610-n .

<i65561>	a	<Concept> ;
	skos:definition	"a chromosome with the centromere near one end so that one chromosomal arm is short and one is long"@en ;
	dc:source	pwn30:05444709-n .

<i65562>	a	<Concept> ;
	skos:definition	"the appearance of the chromosomal makeup of a somatic cell in an individual or species (including the number and arrangement and size and structure of the chromosomes)"@en ;
	dc:source	pwn30:05444876-n .

<i65563>	a	<Concept> ;
	skos:definition	"a chromosome having two equal arms because the centromere is in median position"@en ;
	dc:source	pwn30:05445099-n .

<i65564>	a	<Concept> ;
	skos:definition	"a chromosome like a straight rod with the centromere in terminal position"@en ;
	dc:source	pwn30:05445247-n .

<i65565>	a	<Concept> ;
	skos:definition	"an organelle containing enzymes responsible for producing energy"@en ;
	dc:source	pwn30:05445389-n .

<i65566>	a	<Concept> ;
	skos:definition	"a large mitochondrion in a striated muscle fiber"@en ;
	dc:source	pwn30:05445546-n .

<i65567>	a	<Concept> ;
	skos:definition	"a specialized part of a cell; analogous to an organ"@en ;
	dc:source	pwn30:05445668-n .

<i65568>	a	<Concept> ;
	skos:definition	"star-shaped structure formed in the cytoplasm of a cell having fibers like rays that surround the centrosome during mitosis"@en ;
	dc:source	pwn30:05446006-n .

<i65569>	a	<Concept> ;
	skos:definition	"one of a pair of small cylindrical cell organelles near the nucleus in animal cells; composed of nine triplet microtubules and form the asters during mitosis"@en ;
	dc:source	pwn30:05446181-n .

<i65570>	a	<Concept> ;
	skos:definition	"an organelle in the cytoplasm of a living cell; they attach to mRNA and move down it one codon at a time and then stop until tRNA brings the required amino acid; when it reaches a stop codon it falls apart and releases the completed protein molecule for use by the cell"@en ;
	dc:source	pwn30:05446394-n .

<i65571>	a	<Concept> ;
	skos:definition	"small region of cytoplasm adjacent to the nucleus; contains the centrioles and serves to organize the microtubules"@en ;
	dc:source	pwn30:05446767-n .

<i65572>	a	<Concept> ;
	skos:definition	"the cytoplasm of a striated muscle fiber"@en ;
	dc:source	pwn30:05446971-n .

<i65573>	a	<Concept> ;
	skos:definition	"a tiny cavity filled with fluid in the cytoplasm of a cell"@en ;
	dc:source	pwn30:05447087-n .

<i65574>	a	<Concept> ;
	skos:definition	"the whitish fibrous membrane (albuginea) that with the cornea forms the outer covering and protection of the eyeball"@en ;
	dc:source	pwn30:05447218-n .

<i65575>	a	<Concept> ;
	skos:definition	"a membrane (as a cell membrane) that allows some molecules to pass through but not others"@en ;
	dc:source	pwn30:05447423-n .

<i65576>	a	<Concept> ;
	skos:definition	"a cell that is part of a bone"@en ;
	dc:source	pwn30:05447599-n .

<i65577>	a	<Concept> ;
	skos:definition	"a cell of an embryo"@en ;
	dc:source	pwn30:05447757-n .

<i65578>	a	<Concept> ;
	skos:definition	"an undifferentiated embryonic cell"@en ;
	dc:source	pwn30:05447962-n .

<i65579>	a	<Concept> ;
	skos:definition	"a cell from which tooth enamel develops"@en ;
	dc:source	pwn30:05448053-n .

<i65580>	a	<Concept> ;
	skos:definition	"a cell from which bone develops"@en ;
	dc:source	pwn30:05448149-n .

<i65581>	a	<Concept> ;
	skos:definition	"a nucleated cell in bone marrow from which red blood cells develop"@en ;
	dc:source	pwn30:05448257-n .

<i65582>	a	<Concept> ;
	skos:definition	"a cell from which connective tissue develops"@en ;
	dc:source	pwn30:05448400-n .

<i65583>	a	<Concept> ;
	skos:definition	"a cell from which a nerve cell develops"@en ;
	dc:source	pwn30:05448501-n .

<i65584>	a	<Concept> ;
	skos:definition	"an immature leukocyte normally found in bone marrow"@en ;
	dc:source	pwn30:05448597-n .

<i65585>	a	<Concept> ;
	skos:definition	"a precursor of leukocytes that normally occurs only in bone marrow"@en ;
	dc:source	pwn30:05448704-n .

<i65586>	a	<Concept> ;
	skos:definition	"an erythroblast having granules of ferritin"@en ;
	dc:source	pwn30:05448827-n .

<i65587>	a	<Concept> ;
	skos:definition	"a large bone marrow cell; regarded as the source of blood platelets"@en ;
	dc:source	pwn30:05448928-n .

<i65588>	a	<Concept> ;
	skos:definition	"cell that functions in the breakdown and resorption of bone tissue"@en ;
	dc:source	pwn30:05449073-n .

<i65589>	a	<Concept> ;
	skos:definition	"mature bone cell"@en ;
	dc:source	pwn30:05449196-n .

<i65590>	a	<Concept> ;
	skos:definition	"either of two types of cells (erythrocytes and leukocytes) and sometimes including platelets"@en ;
	dc:source	pwn30:05449268-n .

<i65591>	a	<Concept> ;
	skos:definition	"a cell without a nucleus (as an erythrocyte)"@en ;
	dc:source	pwn30:05449538-n .

<i65592>	a	<Concept> ;
	skos:definition	"abnormally large red blood cell (associated with pernicious anemia)"@en ;
	dc:source	pwn30:05449661-n .

<i65593>	a	<Concept> ;
	skos:definition	"abnormally large red blood cell present in pernicious anemia and folic acid deficiency"@en ;
	dc:source	pwn30:05449797-n .

<i65594>	a	<Concept> ;
	skos:definition	"blood cells that engulf and digest bacteria and fungi; an important part of the body's defense system"@en ;
	dc:source	pwn30:05449959-n .

<i65595>	a	<Concept> ;
	skos:definition	"a preparation of blood cells separated from the liquid plasma"@en ;
	dc:source	pwn30:05450370-n .

<i65596>	a	<Concept> ;
	skos:definition	"a macrophage that is found in connective tissue"@en ;
	dc:source	pwn30:05450617-n .

<i65597>	a	<Concept> ;
	skos:definition	"a large phagocyte; some are fixed and other circulate in the blood stream"@en ;
	dc:source	pwn30:05450740-n .

<i65598>	a	<Concept> ;
	skos:definition	"a cell that engulfs and digests debris and invading microorganisms"@en ;
	dc:source	pwn30:05450888-n .

<i65599>	a	<Concept> ;
	skos:definition	"a phagocyte that does not circulate in the blood but is fixed in the liver or spleen or bone marrow etc."@en ;
	dc:source	pwn30:05451099-n .

<i65600>	a	<Concept> ;
	skos:definition	"a phagocyte that circulates in the blood"@en ;
	dc:source	pwn30:05451265-n .

<i65601>	a	<Concept> ;
	skos:definition	"an agranulocytic leukocyte that normally makes up a quarter of the white blood cell count but increases in the presence of infection"@en ;
	dc:source	pwn30:05451384-n .

<i65602>	a	<Concept> ;
	skos:definition	"a lymphocyte derived from bone marrow that provides humoral immunity; it recognizes free antigen molecules in solution and matures into plasma cells that secrete immunoglobulin (antibodies) that inactivate the antigens"@en ;
	dc:source	pwn30:05451695-n .

<i65603>	a	<Concept> ;
	skos:definition	"a small lymphocyte developed in the thymus; it orchestrates the immune system's response to infected or malignant cells"@en ;
	dc:source	pwn30:05451981-n .

<i65604>	a	<Concept> ;
	skos:definition	"T cell with CD4 receptor that recognizes antigens on the surface of a virus-infected cell and secretes lymphokines that stimulate B cells and killer T cells; helper T cells are infected and killed by the AIDS virus"@en ;
	dc:source	pwn30:05452204-n .

<i65605>	a	<Concept> ;
	skos:definition	"T cell with CD8 receptor that recognizes antigens on the surface of a virus-infected cell and binds to the infected cell and kill it"@en ;
	dc:source	pwn30:05452516-n .

<i65606>	a	<Concept> ;
	skos:definition	"an immature lymphocyte"@en ;
	dc:source	pwn30:05452765-n .

<i65607>	a	<Concept> ;
	skos:definition	"a cell that develops from a B lymphocyte in reaction to a specific antigen; found in bone marrow and sometimes in the blood"@en ;
	dc:source	pwn30:05452845-n .

<i65608>	a	<Concept> ;
	skos:definition	"the precursor of a plasma cell"@en ;
	dc:source	pwn30:05453057-n .

<i65609>	a	<Concept> ;
	skos:definition	"a leukocyte that has granules in its cytoplasm"@en ;
	dc:source	pwn30:05453145-n .

<i65610>	a	<Concept> ;
	skos:definition	"a type of granular leukocyte that functions in the ingestion of bacteria"@en ;
	dc:source	pwn30:05453267-n .

<i65611>	a	<Concept> ;
	skos:definition	"a large immature monocyte normally found in bone marrow"@en ;
	dc:source	pwn30:05453412-n .

<i65612>	a	<Concept> ;
	skos:definition	"a leukocyte with basophilic granules easily stained by basic stains"@en ;
	dc:source	pwn30:05453523-n .

<i65613>	a	<Concept> ;
	skos:definition	"the chief phagocytic leukocyte; stains with either basic or acid dyes"@en ;
	dc:source	pwn30:05453657-n .

<i65614>	a	<Concept> ;
	skos:definition	"a neutrophil that ingests small things (as bacteria)"@en ;
	dc:source	pwn30:05453815-n .

<i65615>	a	<Concept> ;
	skos:definition	"a leukocyte readily stained with eosin"@en ;
	dc:source	pwn30:05453943-n .

<i65616>	a	<Concept> ;
	skos:definition	"a mature blood cell that contains hemoglobin to carry oxygen to the bodily tissues; a biconcave disc that has no nucleus"@en ;
	dc:source	pwn30:05454070-n .

<i65617>	a	<Concept> ;
	skos:definition	"an abnormal red blood cell that has thorny projections of protoplasm"@en ;
	dc:source	pwn30:05454452-n .

<i65618>	a	<Concept> ;
	skos:definition	"an abnormally small red blood cell (less than 5 microns in diameter)"@en ;
	dc:source	pwn30:05454578-n .

<i65619>	a	<Concept> ;
	skos:definition	"an immature red blood cell containing a network of filaments or granules"@en ;
	dc:source	pwn30:05454702-n .

<i65620>	a	<Concept> ;
	skos:definition	"an abnormal red blood cell that has a crescent shape and an abnormal form of hemoglobin"@en ;
	dc:source	pwn30:05454833-n .

<i65621>	a	<Concept> ;
	skos:definition	"an abnormal red blood cell containing granules of iron not bound in hemoglobin"@en ;
	dc:source	pwn30:05454978-n .

<i65622>	a	<Concept> ;
	skos:definition	"an abnormal spherical red blood cell"@en ;
	dc:source	pwn30:05455113-n .

<i65623>	a	<Concept> ;
	skos:definition	"an abnormal red blood cell with the appearance of a dark ring surrounding a dark center; associated with anemia"@en ;
	dc:source	pwn30:05455206-n .

<i65624>	a	<Concept> ;
	skos:definition	"area consisting of a small depression in the retina containing cones and where vision is most acute"@en ;
	dc:source	pwn30:05455375-n .

<i65625>	a	<Concept> ;
	skos:definition	"area of the retina immediately surrounding the fovea"@en ;
	dc:source	pwn30:05455563-n .

<i65626>	a	<Concept> ;
	skos:definition	"a small yellowish central area of the retina that is rich in cones and that mediates clear detailed vision"@en ;
	dc:source	pwn30:05455690-n .

<i65627>	a	<Concept> ;
	skos:definition	"one of the cells of the retina that is sensitive to light"@en ;
	dc:source	pwn30:05455912-n .

<i65628>	a	<Concept> ;
	skos:definition	"the point where the optic nerve enters the retina; not sensitive to light"@en ;
	dc:source	pwn30:05456082-n .

<i65629>	a	<Concept> ;
	skos:definition	"a visual receptor cell in the retina that is sensitive to bright light and to color"@en ;
	dc:source	pwn30:05456257-n .

<i65630>	a	<Concept> ;
	skos:definition	"a visual receptor cell that is sensitive to dim light"@en ;
	dc:source	pwn30:05456456-n .

<i65631>	a	<Concept> ;
	skos:definition	"cells composed of fat"@en ;
	dc:source	pwn30:05456622-n .

<i65632>	a	<Concept> ;
	skos:definition	"a spermatozoon or an ovum; a cell responsible for transmitting DNA to the next generation"@en ;
	dc:source	pwn30:05456732-n .

<i65633>	a	<Concept> ;
	skos:definition	"a mature sexual reproductive cell having a single set of unpaired chromosomes"@en ;
	dc:source	pwn30:05456945-n .

<i65634>	a	<Concept> ;
	skos:definition	"either of a pair of unlike gametes especially those unlike in size"@en ;
	dc:source	pwn30:05457201-n .

<i65635>	a	<Concept> ;
	skos:definition	"either of a pair of conjugating gametes of the same size and structure"@en ;
	dc:source	pwn30:05457343-n .

<i65636>	a	<Concept> ;
	skos:definition	"the male reproductive cell; the male gamete"@en ;
	dc:source	pwn30:05457469-n .

<i65637>	a	<Concept> ;
	skos:definition	"a process at the anterior end of a sperm cell that produces enzymes to facilitate penetration of the egg"@en ;
	dc:source	pwn30:05457795-n .

<i65638>	a	<Concept> ;
	skos:definition	"the female reproductive cell; the female gamete"@en ;
	dc:source	pwn30:05457973-n .

<i65639>	a	<Concept> ;
	skos:definition	"mature ovum after penetration by sperm but before the formation of a zygote"@en ;
	dc:source	pwn30:05458173-n .

<i65640>	a	<Concept> ;
	skos:definition	"a small or immature ovum"@en ;
	dc:source	pwn30:05458300-n .

<i65641>	a	<Concept> ;
	skos:definition	"an immature animal or plant cell that develops into a gamete by meiosis"@en ;
	dc:source	pwn30:05458412-n .

<i65642>	a	<Concept> ;
	skos:definition	"a female gametocyte that develops into an ovum after two meiotic divisions"@en ;
	dc:source	pwn30:05458576-n .

<i65643>	a	<Concept> ;
	skos:definition	"a small cell containing little cytoplasm that is produced along with the oocyte and later discarded"@en ;
	dc:source	pwn30:05458703-n .

<i65644>	a	<Concept> ;
	skos:definition	"a swelling on the epididymis or the testis; usually contains spermatozoa"@en ;
	dc:source	pwn30:05458859-n .

<i65645>	a	<Concept> ;
	skos:definition	"a male gametocyte that develops into four spermatids"@en ;
	dc:source	pwn30:05458990-n .

<i65646>	a	<Concept> ;
	skos:definition	"an immature gamete produced by a spermatocyte; develops into a spermatozoon"@en ;
	dc:source	pwn30:05459101-n .

<i65647>	a	<Concept> ;
	skos:definition	"an elongated contractile cell that forms the muscles of the body"@en ;
	dc:source	pwn30:05459232-n .

<i65648>	a	<Concept> ;
	skos:definition	"a cell in the testes that secretes the hormone testosterone"@en ;
	dc:source	pwn30:05459457-n .

<i65649>	a	<Concept> ;
	skos:definition	"elongated cells found in the seminiferous tubules of the testis; apparently they nourish the spermatids"@en ;
	dc:source	pwn30:05459590-n .

<i65650>	a	<Concept> ;
	skos:definition	"an elongated contractile cell in striated muscle tissue"@en ;
	dc:source	pwn30:05459769-n .

<i65651>	a	<Concept> ;
	skos:definition	"one of many contractile filaments that make up a striated muscle fiber"@en ;
	dc:source	pwn30:05459953-n .

<i65652>	a	<Concept> ;
	skos:definition	"one of the segments into which a myofibril is divided"@en ;
	dc:source	pwn30:05460163-n .

<i65653>	a	<Concept> ;
	skos:definition	"muscle tissue that does not appear striated under the microscope; has the form of thin layers or sheets"@en ;
	dc:source	pwn30:05460291-n .

<i65654>	a	<Concept> ;
	skos:definition	"a muscle that contracts without conscious control and found in walls of internal organs such as stomach and intestine and bladder and blood vessels (excluding the heart)"@en ;
	dc:source	pwn30:05460473-n .

<i65655>	a	<Concept> ;
	skos:definition	"cells of the smooth muscles"@en ;
	dc:source	pwn30:05460759-n .

<i65656>	a	<Concept> ;
	skos:definition	"a system (including the thymus and bone marrow and lymphoid tissues) that protects the body from foreign substances and pathogenic organisms by producing the immune response"@en ;
	dc:source	pwn30:05460870-n .

<i65657>	a	<Concept> ;
	skos:definition	"the skin and its appendages"@en ;
	dc:source	pwn30:05461179-n .

<i65658>	a	<Concept> ;
	skos:definition	"a widely distributed system consisting of all the cells able to ingest bacteria or colloidal particles etc, except for certain white blood cells"@en ;
	dc:source	pwn30:05461349-n .

<i65659>	a	<Concept> ;
	skos:definition	"a widely distributed system of free and fixed macrophages derived from bone marrow"@en ;
	dc:source	pwn30:05461610-n .

<i65660>	a	<Concept> ;
	skos:definition	"the muscular system of an organism"@en ;
	dc:source	pwn30:05461816-n .

<i65661>	a	<Concept> ;
	skos:definition	"the system of muscles and tendons and ligaments and bones and joints and associated tissues that move the body and maintain its form"@en ;
	dc:source	pwn30:05462057-n .

<i65662>	a	<Concept> ;
	skos:definition	"the sensory and control apparatus consisting of a network of nerve cells"@en ;
	dc:source	pwn30:05462315-n .

<i65663>	a	<Concept> ;
	skos:definition	"a structure that is part of the nervous system"@en ;
	dc:source	pwn30:05462674-n .

<i65664>	a	<Concept> ;
	skos:definition	"the neural path of a reflex"@en ;
	dc:source	pwn30:05463449-n .

<i65665>	a	<Concept> ;
	skos:definition	"a cluster of nerve cells governing a specific bodily process"@en ;
	dc:source	pwn30:05463533-n .

<i65666>	a	<Concept> ;
	skos:definition	"the part of the brain (in a fold of the cerebral cortex of the temporal lobe on both sides of the brain) that receives impulses from the ear by way of the auditory nerve"@en ;
	dc:source	pwn30:05463873-n .

<i65667>	a	<Concept> ;
	skos:definition	"a threadlike extension of a nerve cell"@en ;
	dc:source	pwn30:05464104-n .

<i65668>	a	<Concept> ;
	skos:definition	"a nerve fiber encased in a sheath of myelin"@en ;
	dc:source	pwn30:05464378-n .

<i65669>	a	<Concept> ;
	skos:definition	"small gaps in the myelin sheath of medullated axons"@en ;
	dc:source	pwn30:05464534-n .

<i65670>	a	<Concept> ;
	skos:definition	"a layer of myelin encasing (and insulating) the axons of medullated nerve fibers"@en ;
	dc:source	pwn30:05464685-n .

<i65671>	a	<Concept> ;
	skos:definition	"thin membranous sheath around a nerve fiber"@en ;
	dc:source	pwn30:05464939-n .

<i65672>	a	<Concept> ;
	skos:definition	"any cell that covers the nerve fibers in the peripheral nervous system and forms the myelin sheath"@en ;
	dc:source	pwn30:05465071-n .

<i65673>	a	<Concept> ;
	skos:definition	"a nerve fiber that terminates on a muscle or gland and stimulates contraction or secretion"@en ;
	dc:source	pwn30:05465228-n .

<i65674>	a	<Concept> ;
	skos:definition	"a specialized structure at the peripheral end of some motor or sensory nerve fibers"@en ;
	dc:source	pwn30:05465392-n .

<i65675>	a	<Concept> ;
	skos:definition	"a cell that is specialized to conduct nerve impulses"@en ;
	dc:source	pwn30:05465567-n .

<i65676>	a	<Concept> ;
	skos:definition	"a nerve cell in the brain"@en ;
	dc:source	pwn30:05465868-n .

<i65677>	a	<Concept> ;
	skos:definition	"a neuron in the cerebral cortex with short dendrites and with either a long axon or a short axon that ramifies in the grey matter"@en ;
	dc:source	pwn30:05466005-n .

<i65678>	a	<Concept> ;
