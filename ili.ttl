<i98248>	a	<Concept> ;
	skos:definition	"type genus of the Bryaceae: mosses distinguished by mostly erect and tufted gametophytes and symmetrical short-necked capsules"@en ;
	dc:source	pwn30:11541111-n .

<i98249>	a	<Concept> ;
	skos:definition	"family of erect mosses with club-shaped paraphyses and the hexagonal cells of the upper leaf surface; sometimes treated as a subfamily of Bryaceae"@en ;
	dc:source	pwn30:11541322-n .

<i98250>	a	<Concept> ;
	skos:definition	"mosses similar to those of genus Bryum but larger"@en ;
	dc:source	pwn30:11541579-n .

<i98251>	a	<Concept> ;
	skos:definition	"coextensive with the genus Sphagnum; in some classifications isolated in a separate subclass"@en ;
	dc:source	pwn30:11541713-n .

<i98252>	a	<Concept> ;
	skos:definition	"a large genus constituting the order Sphagnales: atypical mosses of temperate bogs with leaves that can hold much water"@en ;
	dc:source	pwn30:11541919-n .

<i98253>	a	<Concept> ;
	skos:definition	"any of various pale or ashy mosses of the genus Sphagnum whose decomposed remains form peat"@en ;
	dc:source	pwn30:11542137-n .

<i98254>	a	<Concept> ;
	skos:definition	"liverworts: comprises orders Anthocerotales; Jungermanniales; Marchantiales; Sphaerocarpales"@en ;
	dc:source	pwn30:11542341-n .

<i98255>	a	<Concept> ;
	skos:definition	"any of numerous small green nonvascular plants of the class Hepaticopsida growing in wet places and resembling green seaweeds or leafy mosses"@en ;
	dc:source	pwn30:11542640-n .

<i98256>	a	<Concept> ;
	skos:definition	"large order of chiefly tropical liverworts"@en ;
	dc:source	pwn30:11542920-n .

<i98257>	a	<Concept> ;
	skos:definition	"moss-like liverwort with tiny scalelike leaves; usually epiphytic"@en ;
	dc:source	pwn30:11543105-n .

<i98258>	a	<Concept> ;
	skos:definition	"comprising the leafy members of the order Jungermanniales"@en ;
	dc:source	pwn30:11543264-n .

<i98259>	a	<Concept> ;
	skos:definition	"liverworts with gametophyte differentiated internally"@en ;
	dc:source	pwn30:11543429-n .

<i98260>	a	<Concept> ;
	skos:definition	"liverworts with prostrate and usually dichotomously branched thalli"@en ;
	dc:source	pwn30:11543602-n .

<i98261>	a	<Concept> ;
	skos:definition	"type genus of Marchantiaceae; liverworts that reproduce asexually by gemmae and have stalked antheridiophores"@en ;
	dc:source	pwn30:11543792-n .

<i98262>	a	<Concept> ;
	skos:definition	"a common liverwort"@en ;
	dc:source	pwn30:11544015-n .

<i98263>	a	<Concept> ;
	skos:definition	"small order sometimes included in the order Jungermanniales"@en ;
	dc:source	pwn30:11544131-n .

<i98264>	a	<Concept> ;
	skos:definition	"liverworts with bilaterally symmetrical gametophytes; sometimes placed in the order Jungermanniales"@en ;
	dc:source	pwn30:11544314-n .

<i98265>	a	<Concept> ;
	skos:definition	"type genus of Sphaerocarpaceae; liverworts with small many-lobed usually orbicular thallus"@en ;
	dc:source	pwn30:11544540-n .

<i98266>	a	<Concept> ;
	skos:definition	"containing all the vascular plants that do not bear seeds: ferns, horsetails, club mosses, and whisk ferns; in some classifications considered a subdivision of Tracheophyta"@en ;
	dc:source	pwn30:11544769-n .

<i98267>	a	<Concept> ;
	skos:definition	"genus of Carboniferous fossil ferns"@en ;
	dc:source	pwn30:11545214-n .

<i98268>	a	<Concept> ;
	skos:definition	"Carboniferous fossil fern characterized by a regular arrangement of the leaflets resembling a comb"@en ;
	dc:source	pwn30:11545350-n .

<i98269>	a	<Concept> ;
	skos:definition	"plants having vascular tissue and reproducing by spores"@en ;
	dc:source	pwn30:11545524-n .

<i98270>	a	<Concept> ;
	skos:definition	"any of numerous flowerless and seedless vascular plants having true roots from a rhizome and fronds that uncurl upward; reproduce by spores"@en ;
	dc:source	pwn30:11545714-n .

<i98271>	a	<Concept> ;
	skos:definition	"pteridophytes of other classes than Filicopsida"@en ;
	dc:source	pwn30:11547562-n .

<i98272>	a	<Concept> ;
	skos:definition	"an asexual reproductive cell"@en ;
	dc:source	pwn30:11547737-n .

<i98273>	a	<Concept> ;
	skos:definition	"a small usually single-celled asexual reproductive body produced by many nonflowering plants and fungi and some bacteria and protozoans and that are capable of developing into a new individual without sexual fusion"@en ;
	dc:source	pwn30:11547855-n .

<i98274>	a	<Concept> ;
	skos:definition	"a sexually produced fungal spore borne on a basidium"@en ;
	dc:source	pwn30:11548465-n .

<i98275>	a	<Concept> ;
	skos:definition	"a small asexual spore that develops inside the cell of some bacteria and algae"@en ;
	dc:source	pwn30:11548594-n .

<i98276>	a	<Concept> ;
	skos:definition	"a nonmotile spore of red algae"@en ;
	dc:source	pwn30:11548728-n .

<i98277>	a	<Concept> ;
	skos:definition	"thick-walled asexual resting spore of certain fungi and algae"@en ;
	dc:source	pwn30:11548870-n .

<i98278>	a	<Concept> ;
	skos:definition	"an asexually produced fungal spore formed on a conidiophore"@en ;
	dc:source	pwn30:11549009-n .

<i98279>	a	<Concept> ;
	skos:definition	"a specialized fungal hypha that produces conidia"@en ;
	dc:source	pwn30:11549138-n .

<i98280>	a	<Concept> ;
	skos:definition	"a thick-walled sexual spore that develops from a fertilized oosphere in some algae and fungi"@en ;
	dc:source	pwn30:11549245-n .

<i98281>	a	<Concept> ;
	skos:definition	"a gamete; used especially of lower plants"@en ;
	dc:source	pwn30:11549391-n .

<i98282>	a	<Concept> ;
	skos:definition	"a spore of certain algae or fungi that lies dormant; may germinate after a prolonged period"@en ;
	dc:source	pwn30:11549487-n .

<i98283>	a	<Concept> ;
	skos:definition	"a chlamydospore that develops in the last stage of the life cycle of the rust fungus"@en ;
	dc:source	pwn30:11549638-n .

<i98284>	a	<Concept> ;
	skos:definition	"one of the four asexual spores produced within a sporangium"@en ;
	dc:source	pwn30:11549779-n .

<i98285>	a	<Concept> ;
	skos:definition	"an asexual spore of some algae and fungi that moves by means of flagella"@en ;
	dc:source	pwn30:11549895-n .

<i98286>	a	<Concept> ;
	skos:definition	"the asexual spore of ferns that resembles dust; once thought to be seeds and to make the possessor invisible"@en ;
	dc:source	pwn30:11550022-n .

<i98287>	a	<Concept> ;
	skos:definition	"organs of fruiting (especially the reproductive parts of ferns and mosses)"@en ;
	dc:source	pwn30:11550205-n .

<i98288>	a	<Concept> ;
	skos:definition	"fleshy spore-bearing inner mass of e.g. a puffball or stinkhorn"@en ;
	dc:source	pwn30:11550340-n .

<i98289>	a	<Concept> ;
	skos:definition	"spore-bearing layer of cells in certain fungi containing asci or basidia"@en ;
	dc:source	pwn30:11550474-n .

<i98290>	a	<Concept> ;
	skos:definition	"flask-shaped asexual structure containing conidia"@en ;
	dc:source	pwn30:11550620-n .

<i98291>	a	<Concept> ;
	skos:definition	"specialized leaf branch in certain aquatic ferns that encloses the sori or clusters of sporangia"@en ;
	dc:source	pwn30:11550725-n .

<i98292>	a	<Concept> ;
	skos:definition	"a small leafy outgrowth at the base of a leaf or its stalk; usually occurring in pairs and soon shed"@en ;
	dc:source	pwn30:11550890-n .

<i98293>	a	<Concept> ;
	skos:definition	"an undifferentiated part of a perianth that cannot be distinguished as a sepal or a petal (as in lilies and tulips)"@en ;
	dc:source	pwn30:11551044-n .

<i98294>	a	<Concept> ;
	skos:definition	"seed plants; comprises the Angiospermae (or Magnoliophyta) and Gymnospermae (or Gymnospermophyta); in some classification systems Spermatophyta is coordinate with Pteridophyta (spore producing plants having vascular tissue and roots) and Bryophyta (spore producing plants lacking vascular tissue and roots)"@en ;
	dc:source	pwn30:11551211-n .

<i98295>	a	<Concept> ;
	skos:definition	"in former classification systems: one of two major plant divisions, including all seed-bearing plants; superseded by the division Spermatophyta"@en ;
	dc:source	pwn30:11551659-n .

<i98296>	a	<Concept> ;
	skos:definition	"in former classification systems: one of two major plant divisions, including all plants that do not bear seeds: ferns, mosses, algae, fungi"@en ;
	dc:source	pwn30:11551898-n .

<i98297>	a	<Concept> ;
	skos:definition	"formerly recognized taxonomic group including all flowerless and seedless plants that reproduce by means of spores: ferns, mosses, algae, fungi"@en ;
	dc:source	pwn30:11552133-n .

<i98298>	a	<Concept> ;
	skos:definition	"plant that reproduces by means of seeds not spores"@en ;
	dc:source	pwn30:11552386-n .

<i98299>	a	<Concept> ;
	skos:definition	"young plant or tree grown from a seed"@en ;
	dc:source	pwn30:11552594-n .

<i98300>	a	<Concept> ;
	skos:definition	"any seed plant yielding balsam"@en ;
	dc:source	pwn30:11552686-n .

<i98301>	a	<Concept> ;
	skos:definition	"(botany) a plant that completes its entire life cycle within the space of a year"@en ;
	dc:source	pwn30:11552806-n .

<i98302>	a	<Concept> ;
	skos:definition	"(botany) a plant having a life cycle that normally takes two seasons from germination to death to complete; flowering biennials usually bloom and fruit in the second season"@en ;
	dc:source	pwn30:11552976-n .

<i98303>	a	<Concept> ;
	skos:definition	"(botany) a plant lasting for three seasons or more"@en ;
	dc:source	pwn30:11553240-n .

<i98304>	a	<Concept> ;
	skos:definition	"a plant originally cultivated but now growing wild"@en ;
	dc:source	pwn30:11553419-n .

<i98305>	a	<Concept> ;
	skos:definition	"a plant that grows in a moist habitat"@en ;
	dc:source	pwn30:11553522-n .

<i98306>	a	<Concept> ;
	skos:definition	"a plant that is found in an area where it had not been recorded previously"@en ;
	dc:source	pwn30:11553634-n .

<i98307>	a	<Concept> ;
	skos:definition	"a family of gymnosperms"@en ;
	dc:source	pwn30:11553763-n .

<i98308>	a	<Concept> ;
	skos:definition	"a genus of gymnosperms"@en ;
	dc:source	pwn30:11554175-n .

<i98309>	a	<Concept> ;
	skos:definition	"family of flowering plants having a single cotyledon (embryonic leaf) in the seed"@en ;
	dc:source	pwn30:11555413-n .

<i98310>	a	<Concept> ;
	skos:definition	"family of monocotyledonous plants of the subclass Liliidae; mostly herbs usually with petaloid sepals and petals and compound pistils"@en ;
	dc:source	pwn30:11556187-n .

<i98311>	a	<Concept> ;
	skos:definition	"genus of flowering plants having a single cotyledon (embryonic leaf) in the seed"@en ;
	dc:source	pwn30:11556857-n .

<i98312>	a	<Concept> ;
	skos:definition	"genus of monocotyledonous plants comprising mostly herbs having usually petaloid sepals and petals and compound pistils"@en ;
	dc:source	pwn30:11561228-n .

<i98313>	a	<Concept> ;
	skos:definition	"family of flowering plants having two cotyledons (embryonic leaves) in the seed which usually appear at germination"@en ;
	dc:source	pwn30:11562747-n .

<i98314>	a	<Concept> ;
	skos:definition	"family of dicotyledonous flowering plants regarded as among the most primitive of extant angiosperms"@en ;
	dc:source	pwn30:11564258-n .

<i98315>	a	<Concept> ;
	skos:definition	"family of mostly woody dicotyledonous flowering plants with flowers often unisexual and often borne in catkins"@en ;
	dc:source	pwn30:11564734-n .

<i98316>	a	<Concept> ;
	skos:definition	"family of relatively early dicotyledonous plants including mostly flowers"@en ;
	dc:source	pwn30:11565040-n .

<i98317>	a	<Concept> ;
	skos:definition	"family of more or less advanced dicotyledonous trees and shrubs and herbs"@en ;
	dc:source	pwn30:11565385-n .

<i98318>	a	<Concept> ;
	skos:definition	"family of more or less advanced dicotyledonous herbs and some trees and shrubs"@en ;
	dc:source	pwn30:11566230-n .

<i98319>	a	<Concept> ;
	skos:definition	"a family of dicotyledonous plants"@en ;
	dc:source	pwn30:11566682-n .

<i98320>	a	<Concept> ;
	skos:definition	"genus of flowering plants having two cotyledons (embryonic leaves) in the seed which usually appear at germination"@en ;
	dc:source	pwn30:11567411-n .

<i98321>	a	<Concept> ;
	skos:definition	"genus of dicotyledonous flowering plants regarded as among the most primitive of extant angiosperms"@en ;
	dc:source	pwn30:11571907-n .

<i98322>	a	<Concept> ;
	skos:definition	"genus of mostly woody relatively primitive dicotyledonous flowering plants with flowers often unisexual and often borne in catkins"@en ;
	dc:source	pwn30:11573173-n .

<i98323>	a	<Concept> ;
	skos:definition	"genus of relatively early dicotyledonous plants including mostly flowers"@en ;
	dc:source	pwn30:11573660-n .

<i98324>	a	<Concept> ;
	skos:definition	"genus of more or less advanced dicotyledonous trees and shrubs and herbs"@en ;
	dc:source	pwn30:11575425-n .

<i98325>	a	<Concept> ;
	skos:definition	"genus of more or less advanced dicotyledonous herbs and some trees and shrubs"@en ;
	dc:source	pwn30:11579418-n .

<i98326>	a	<Concept> ;
	skos:definition	"a genus of dicotyledonous plants"@en ;
	dc:source	pwn30:11585340-n .

<i98327>	a	<Concept> ;
	skos:definition	"includes lichen families"@en ;
	dc:source	pwn30:11590783-n .

<i98328>	a	<Concept> ;
	skos:definition	"includes lichen genera"@en ;
	dc:source	pwn30:11592146-n .

<i98329>	a	<Concept> ;
	skos:definition	"the order of fungi"@en ;
	dc:source	pwn30:11594676-n .

<i98330>	a	<Concept> ;
	skos:definition	"plants having naked seeds not enclosed in an ovary; in some systems considered a class (Gymnospermae) and in others a division (Gymnospermophyta); comprises three subdivisions (or classes): Cycadophytina (class Cycadopsida) and Gnetophytina (class Gnetopsida) and Coniferophytina (class Coniferopsida); in some classifications the Coniferophytina are divided into three groups: Pinophytina (class Pinopsida) and Ginkgophytina (class Ginkgopsida) and Taxophytina (class Taxopsida)"@en ;
	dc:source	pwn30:11595312-n .

<i98331>	a	<Concept> ;
	skos:definition	"plants of the class Gymnospermae having seeds not enclosed in an ovary"@en ;
	dc:source	pwn30:11596108-n .

<i98332>	a	<Concept> ;
	skos:definition	"an ancestral fossil type from which modern gymnosperms are thought to have derived"@en ;
	dc:source	pwn30:11596344-n .

<i98333>	a	<Concept> ;
	skos:definition	"gymnospermous flowering plants; supposed link between conifers and angiosperms; in some systems classified as a class (Gnetopsida) and in others as a subdivision (Gnetophytina or Gnetophyta)"@en ;
	dc:source	pwn30:11596486-n .

<i98334>	a	<Concept> ;
	skos:definition	"chiefly tropical or xerophytic woody plants; practically unknown as fossils but considered close to the ancestral line of angiosperms"@en ;
	dc:source	pwn30:11596845-n .

<i98335>	a	<Concept> ;
	skos:definition	"plants having small unisexual flowers and fleshy or winged fruit: in some classifications includes the genera Ephedra and Welwitschia as well as genus Gnetum"@en ;
	dc:source	pwn30:11597126-n .

<i98336>	a	<Concept> ;
	skos:definition	"type genus of the Gnetaceae; small trees or shrubs usually with climbing jointed stems and terminal spikes of flowers with orange-red seeds clustered in rough cones"@en ;
	dc:source	pwn30:11597396-n .

<i98337>	a	<Concept> ;
	skos:definition	"small tropical tree with tiered branches and divaricate branchlets having broad glossy dark green leaves; exploited for its edible young leaves and seeds that provide a fine flour"@en ;
	dc:source	pwn30:11597657-n .

<i98338>	a	<Concept> ;
	skos:definition	"ephedras: in some classifications included in the Gnetaceae"@en ;
	dc:source	pwn30:11597924-n .

<i98339>	a	<Concept> ;
	skos:definition	"a genus of African evergreen shrubs characterized by thick leaves and white flowers"@en ;
	dc:source	pwn30:11598100-n .

<i98340>	a	<Concept> ;
	skos:definition	"a shrub that is cultivated by Arabs for its leaves which are chewed or used to make tea"@en ;
	dc:source	pwn30:11598287-n .

<i98341>	a	<Concept> ;
	skos:definition	"type and sole genus of Ephedraceae: tropical and subtropical evergreen shrubby or creeping plants native to dry and inhospitable regions"@en ;
	dc:source	pwn30:11598452-n .

<i98342>	a	<Concept> ;
	skos:definition	"jointed and nearly leafless desert shrub having reduced scalelike leaves and reddish fleshy seeds"@en ;
	dc:source	pwn30:11598686-n .

<i98343>	a	<Concept> ;
	skos:definition	"Chinese ephedra yielding ephedrine"@en ;
	dc:source	pwn30:11598886-n .

<i98344>	a	<Concept> ;
	skos:definition	"in some classifications included in the Gnetaceae"@en ;
	dc:source	pwn30:11598991-n .

<i98345>	a	<Concept> ;
	skos:definition	"type and sole genus of Welwitschiaceae"@en ;
	dc:source	pwn30:11599165-n .

<i98346>	a	<Concept> ;
	skos:definition	"curious plant of arid regions of southwestern Africa having a yard-high and yard-wide trunk like a turnip with a deep taproot and two large persistent woody straplike leaves growing from the base; living relic of a flora long disappeared; some may be 700-5000 years old"@en ;
	dc:source	pwn30:11599324-n .

<i98347>	a	<Concept> ;
	skos:definition	"palmlike gymnosperms: includes the surviving order Cycadales and several extinct orders; possibly not a natural group; in some systems considered a class (Cycadopsida) and in others a subdivision (Cycadophytina or Cycadophyta)"@en ;
	dc:source	pwn30:11599694-n .

<i98348>	a	<Concept> ;
	skos:definition	"primitive tropical gymnosperms abundant in the Mesozoic, now reduced to a few scattered tropical forms"@en ;
	dc:source	pwn30:11600139-n .

<i98349>	a	<Concept> ;
	skos:definition	"any tropical gymnosperm of the order Cycadales; having unbranched stems with a crown of fernlike leaves"@en ;
	dc:source	pwn30:11600372-n .

<i98350>	a	<Concept> ;
	skos:definition	"ancient palmlike plants closely related to ferns in that fertilization is by means of spermatozoids"@en ;
	dc:source	pwn30:11600671-n .

<i98351>	a	<Concept> ;
	skos:definition	"type genus of Cycadaceae: genus of widely distributed Old World evergreen tropical trees having pinnate leaves and columnar stems covered with persistent bases of old leaves"@en ;
	dc:source	pwn30:11600900-n .

<i98352>	a	<Concept> ;
	skos:definition	"dwarf palmlike cycad of Japan that yields sago"@en ;
	dc:source	pwn30:11601177-n .

<i98353>	a	<Concept> ;
	skos:definition	"southeastern Indian cycad with palmlike foliage"@en ;
	dc:source	pwn30:11601333-n .

<i98354>	a	<Concept> ;
	skos:definition	"a family of cycads often included in the family Cycadaceae: zamias"@en ;
	dc:source	pwn30:11601487-n .

<i98355>	a	<Concept> ;
	skos:definition	"genus of small evergreen tropical and subtropical American cycads"@en ;
	dc:source	pwn30:11601757-n .

<i98356>	a	<Concept> ;
	skos:definition	"any of various cycads of the genus Zamia; among the smallest and most verdant cycads"@en ;
	dc:source	pwn30:11601918-n .

<i98357>	a	<Concept> ;
	skos:definition	"small tough woody zamia of Florida and West Indies and Cuba; roots and half-buried stems yield an arrowroot"@en ;
	dc:source	pwn30:11602091-n .

<i98358>	a	<Concept> ;
	skos:definition	"small genus of Mexican cycads; sometimes classified in family Cycadaceae"@en ;
	dc:source	pwn30:11602304-n .

<i98359>	a	<Concept> ;
	skos:definition	"a small cycad of the genus Ceratozamia having a short scaly woody trunk and fernlike foliage and woody cones; Mexico"@en ;
	dc:source	pwn30:11602478-n .

<i98360>	a	<Concept> ;
	skos:definition	"small genus of arborescent cycads of Mexico and Central America; sometimes classified in family Cycadaceae"@en ;
	dc:source	pwn30:11602671-n .

<i98361>	a	<Concept> ;
	skos:definition	"any cycad of the genus Dioon; handsome palmlike cycads with robust crowns of leaves and rugged trunks"@en ;
	dc:source	pwn30:11602873-n .

<i98362>	a	<Concept> ;
	skos:definition	"genus of arborescent African cycads; sometimes classified in family Cycadaceae"@en ;
	dc:source	pwn30:11603045-n .

<i98363>	a	<Concept> ;
	skos:definition	"any of numerous cycads of the genus Encephalartos having stout cylindrical trunks and a terminal crown of long often spiny pinnate leaves"@en ;
	dc:source	pwn30:11603246-n .

<i98364>	a	<Concept> ;
	skos:definition	"South African cycad; the farinaceous pith of the fruit used as food"@en ;
	dc:source	pwn30:11603462-n .

<i98365>	a	<Concept> ;
	skos:definition	"genus of large evergreen Australian cycads; sometimes classified in family Cycadaceae"@en ;
	dc:source	pwn30:11603630-n .

<i98366>	a	<Concept> ;
	skos:definition	"any treelike cycad of the genus Macrozamia having erect trunks and pinnate leaves and large cones with sometimes edible nuts; Australia"@en ;
	dc:source	pwn30:11603835-n .

<i98367>	a	<Concept> ;
	skos:definition	"large attractive palmlike evergreen cycad of New South Wales"@en ;
	dc:source	pwn30:11604046-n .

<i98368>	a	<Concept> ;
	skos:definition	"fossil gymnospermous plants of the Carboniferous"@en ;
	dc:source	pwn30:11604225-n .

<i98369>	a	<Concept> ;
	skos:definition	"a family of fossil gymnospermous plants of the Carboniferous"@en ;
	dc:source	pwn30:11604393-n .

<i98370>	a	<Concept> ;
	skos:definition	"type of the Bennettitales"@en ;
	dc:source	pwn30:11604576-n .

<i98371>	a	<Concept> ;
	skos:definition	"extinct gymnosperms most of Carboniferous to Jurassic: seed ferns and allies"@en ;
	dc:source	pwn30:11604698-n .

<i98372>	a	<Concept> ;
	skos:definition	"fossil gymnospermous trees or climbing plants from the Devonian: seed ferns"@en ;
	dc:source	pwn30:11604904-n .

<i98373>	a	<Concept> ;
	skos:definition	"used in some classification systems: a group of extinct fossil gymnosperms coextensive with the order Cycadofilicales"@en ;
	dc:source	pwn30:11605147-n .

<i98374>	a	<Concept> ;
	skos:definition	"genus of fossil seed ferns of the Carboniferous"@en ;
	dc:source	pwn30:11605396-n .

<i98375>	a	<Concept> ;
	skos:definition	"an extinct seed-producing fernlike plant of the order Cycadofilicales (or group Pteridospermae)"@en ;
	dc:source	pwn30:11605542-n .

<i98376>	a	<Concept> ;
	skos:definition	"cone-bearing gymnosperms dating from the Carboniferous period; most are substantial trees; includes the classes Pinopsida (subdivision Pinophytina) and Ginkgopsida (subdivision Ginkgophytina) and Taxopsida (subdivision Taxophytina) which in turn include the surviving orders Coniferales and Taxales (yews) and sometimes Ginkgoales as well as extinct orders such as Cordaitales (of the Carboniferous and Permian)"@en ;
	dc:source	pwn30:11605708-n .

<i98377>	a	<Concept> ;
	skos:definition	"extinct plants having tall arborescent trunks comparable to or more advanced than cycads; known from the Pennsylvanian period; probably extinct since the Mesozoic era"@en ;
	dc:source	pwn30:11606379-n .

<i98378>	a	<Concept> ;
	skos:definition	"chiefly Paleozoic plants; Cordaites is the chief and typical genus"@en ;
	dc:source	pwn30:11606661-n .

<i98379>	a	<Concept> ;
	skos:definition	"tall Paleozoic trees superficially resembling modern screw pines; structurally intermediate in some ways between cycads and conifers"@en ;
	dc:source	pwn30:11606846-n .

<i98380>	a	<Concept> ;
	skos:definition	"most conifers: in some systems classified as a class (Pinopsida) and in others as a subdivision (Pinophytina); used in some classifications for one of five subdivisions of Gymnospermophyta"@en ;
	dc:source	pwn30:11607071-n .

<i98381>	a	<Concept> ;
	skos:definition	"profusely branching and chiefly evergreen trees and some shrubs having narrow or needlelike leaves"@en ;
	dc:source	pwn30:11607392-n .

<i98382>	a	<Concept> ;
	skos:definition	"a family of Pinaceae"@en ;
	dc:source	pwn30:11607739-n .

<i98383>	a	<Concept> ;
