	skos:definition	"a species whose numbers are so small that the species is at risk of extinction"@en ;
	dc:source	pwn30:08110866-n .

<i79807>	a	<Concept> ;
	skos:definition	"a species of fish"@en ;
	dc:source	pwn30:08111027-n .

<i79808>	a	<Concept> ;
