	skos:definition	"doctrine that the useful is the good; especially as elaborated by Jeremy Bentham and James Mill; the aim was said to be the greatest happiness for the greatest number"@en ;
	dc:source	pwn30:06187529-n .

<i69053>	a	<Concept> ;
