	dc:source	pwn30:14199477-n .

<i111517>	a	<Concept> ;
	skos:definition	"a state of poor nutrition; can result from insufficient or excessive or unbalanced diet or from inability to absorb foods"@en ;
	dc:source	pwn30:14199700-n .

<i111518>	a	<Concept> ;
