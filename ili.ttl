	dc:source	pwn30:05471837-n .

<i65705>	a	<Concept> ;
	skos:definition	"a sharp triangular process projecting from a bone"@en ;
	dc:source	pwn30:05472032-n .

<i65706>	a	<Concept> ;
	skos:definition	"the coronoid process that provides an attachment for the temporal muscle"@en ;
	dc:source	pwn30:05472205-n .

<i65707>	a	<Concept> ;
	skos:definition	"a condyle on the outer side of the lower extremity of the femur"@en ;
	dc:source	pwn30:05472394-n .

<i65708>	a	<Concept> ;
	skos:definition	"a condyle on the inner side of the lower extremity of the femur"@en ;
	dc:source	pwn30:05472538-n .

<i65709>	a	<Concept> ;
	skos:definition	"a projection on a bone above a condyle serving for the attachment of muscles and ligaments"@en ;
	dc:source	pwn30:05472681-n .

<i65710>	a	<Concept> ;
