	dc:source	pwn30:05348540-n .

<i65061>	a	<Concept> ;
	skos:definition	"an artery that is a branch of the superior mesenteric artery that supplies the jejunum"@en ;
	dc:source	pwn30:05348698-n .

<i65062>	a	<Concept> ;
