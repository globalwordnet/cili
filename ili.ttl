<i109321>	a	<Concept> ;
	skos:definition	"a relative amount"@en ;
	dc:source	pwn30:13779244-n .

<i109322>	a	<Concept> ;
	skos:definition	"the amount that can be contained"@en ;
	dc:source	pwn30:13779374-n .

<i109323>	a	<Concept> ;
	skos:definition	"the maximum amount of air that can be exhaled after a maximum inhalation (usually tested with a spirometer); used to determine the condition of lung tissue"@en ;
	dc:source	pwn30:13779570-n .

<i109324>	a	<Concept> ;
	skos:definition	"the number of inhabitants (either the total number or the number of a particular race or class) in a given place (country or city etc.)"@en ;
	dc:source	pwn30:13779804-n .

<i109325>	a	<Concept> ;
	skos:definition	"a measure of alcoholic strength expressed as an integer twice the percentage of alcohol present (by volume)"@en ;
	dc:source	pwn30:13780180-n .

<i109326>	a	<Concept> ;
	skos:definition	"standard temperature and pressure"@en ;
	dc:source	pwn30:13780339-n .

<i109327>	a	<Concept> ;
	skos:definition	"mutual dealings or connections or communications among persons or groups"@en ;
	dc:source	pwn30:13780449-n .

<i109328>	a	<Concept> ;
	skos:definition	"the relation between causes and effects"@en ;
	dc:source	pwn30:13780606-n .

<i109329>	a	<Concept> ;
	skos:definition	"a relation between people; (`relationship' is often used where `relation' would serve, as in `the relationship between inflation and unemployment', but the preferred usage of `relationship' is for human relations or states of relatedness)"@en ;
	dc:source	pwn30:13780719-n .

<i109330>	a	<Concept> ;
	skos:definition	"a relation such that one thing is dependent on another"@en ;
	dc:source	pwn30:13781164-n .

<i109331>	a	<Concept> ;
	skos:definition	"a cooperative relationship between people or groups who agree to share responsibility for achieving some specific goal"@en ;
	dc:source	pwn30:13781348-n .

<i109332>	a	<Concept> ;
	skos:definition	"a relation between persons"@en ;
	dc:source	pwn30:13781670-n .

<i109333>	a	<Concept> ;
	skos:definition	"a close personal relationship that forms between people (as between husband and wife or parent and child)"@en ;
	dc:source	pwn30:13781820-n .

<i109334>	a	<Concept> ;
	skos:definition	"a personal relation in which one is indebted for a service or favor"@en ;
	dc:source	pwn30:13782033-n .

<i109335>	a	<Concept> ;
	skos:definition	"the formation of a close personal relationship between women"@en ;
	dc:source	pwn30:13782208-n .

<i109336>	a	<Concept> ;
	skos:definition	"the formation of a close personal relationship between men"@en ;
	dc:source	pwn30:13782329-n .

<i109337>	a	<Concept> ;
	skos:definition	"the attachment that forms between an infant and its mother beginning at birth"@en ;
	dc:source	pwn30:13782533-n .

<i109338>	a	<Concept> ;
	skos:definition	"a relation resulting from interaction or dependence"@en ;
	dc:source	pwn30:13782769-n .

<i109339>	a	<Concept> ;
	skos:definition	"a relation between propositions"@en ;
	dc:source	pwn30:13783038-n .

<i109340>	a	<Concept> ;
	skos:definition	"two propositions are contradictories if both cannot be true (or both cannot be false) at the same time"@en ;
	dc:source	pwn30:13783259-n .

<i109341>	a	<Concept> ;
	skos:definition	"a logical relation such that two propositions are contraries if both cannot be true but both can be false"@en ;
	dc:source	pwn30:13783421-n .

<i109342>	a	<Concept> ;
	skos:definition	"a relation between mathematical expressions (such as equality or inequality)"@en ;
	dc:source	pwn30:13783581-n .

<i109343>	a	<Concept> ;
	skos:definition	"(mathematics) a mathematical relation such that each element of a given set (the domain of the function) is associated with an element of another set (the range of the function)"@en ;
	dc:source	pwn30:13783816-n .

<i109344>	a	<Concept> ;
	skos:definition	"a function expressed as a sum or product of terms"@en ;
	dc:source	pwn30:13784366-n .

<i109345>	a	<Concept> ;
	skos:definition	"a function obtained by expressing the dependent variable of one function as the independent variable of another; f and g are inverse functions if f(x)=y and g(y)=x"@en ;
	dc:source	pwn30:13784537-n .

<i109346>	a	<Concept> ;
	skos:definition	"a function of two variables i and j that equals 1 when i=j and equals 0 otherwise"@en ;
	dc:source	pwn30:13784763-n .

<i109347>	a	<Concept> ;
	skos:definition	"a function of a topological space that gives, for any two points in the space, a value equal to the distance between them"@en ;
	dc:source	pwn30:13784906-n .

<i109348>	a	<Concept> ;
	skos:definition	"(mathematics) a function that changes the position or direction of the axes of a coordinate system"@en ;
	dc:source	pwn30:13785136-n .

<i109349>	a	<Concept> ;
	skos:definition	"(mathematics) a transformation in which the direction of one axis is reversed"@en ;
	dc:source	pwn30:13785404-n .

<i109350>	a	<Concept> ;
	skos:definition	"(mathematics) a transformation in which the coordinate axes are rotated by a fixed angle about the origin"@en ;
	dc:source	pwn30:13785557-n .

<i109351>	a	<Concept> ;
	skos:definition	"(mathematics) a transformation in which the origin of the coordinate system is moved to another position but the direction of each axis remains the same"@en ;
	dc:source	pwn30:13785736-n .

<i109352>	a	<Concept> ;
	skos:definition	"(mathematics) a transformation that is a combination of single transformations such as translation or rotation or reflection on an axis"@en ;
	dc:source	pwn30:13785965-n .

<i109353>	a	<Concept> ;
	skos:definition	"a one-to-one mapping of one metric space into another metric space that preserves the distances between each pair of points"@en ;
	dc:source	pwn30:13786187-n .

<i109354>	a	<Concept> ;
	skos:definition	"(mathematics) a symbol or function representing a mathematical operation"@en ;
	dc:source	pwn30:13786413-n .

<i109355>	a	<Concept> ;
	skos:definition	"an operator that obeys the distributive law: A(f+g) = Af + Ag (where f and g are functions)"@en ;
	dc:source	pwn30:13786595-n .

<i109356>	a	<Concept> ;
	skos:definition	"an operator that leaves unchanged the element on which it operates"@en ;
	dc:source	pwn30:13786748-n .

<i109357>	a	<Concept> ;
	skos:definition	"function of an angle expressed as a ratio of the length of the sides of right-angled triangle containing the angle"@en ;
	dc:source	pwn30:13786960-n .

<i109358>	a	<Concept> ;
	skos:definition	"ratio of the length of the side opposite the given angle to the length of the hypotenuse of a right-angled triangle"@en ;
	dc:source	pwn30:13787379-n .

<i109359>	a	<Concept> ;
	skos:definition	"the inverse function of the sine; the angle that has a sine equal to a given number"@en ;
	dc:source	pwn30:13787551-n .

<i109360>	a	<Concept> ;
	skos:definition	"ratio of the adjacent side to the hypotenuse of a right-angled triangle"@en ;
	dc:source	pwn30:13787723-n .

<i109361>	a	<Concept> ;
	skos:definition	"the inverse function of the cosine; the angle that has a cosine equal to a given number"@en ;
	dc:source	pwn30:13787853-n .

<i109362>	a	<Concept> ;
	skos:definition	"ratio of the opposite to the adjacent side of a right-angled triangle"@en ;
	dc:source	pwn30:13788035-n .

<i109363>	a	<Concept> ;
	skos:definition	"the inverse function of the tangent; the angle that has a tangent equal to a given number"@en ;
	dc:source	pwn30:13788182-n .

<i109364>	a	<Concept> ;
	skos:definition	"ratio of the adjacent to the opposite side of a right-angled triangle"@en ;
	dc:source	pwn30:13788369-n .

<i109365>	a	<Concept> ;
	skos:definition	"the inverse function of the cotangent; the angle that has a cotangent equal to a given number"@en ;
	dc:source	pwn30:13788502-n .

<i109366>	a	<Concept> ;
	skos:definition	"ratio of the hypotenuse to the adjacent side of a right-angled triangle"@en ;
	dc:source	pwn30:13788690-n .

<i109367>	a	<Concept> ;
	skos:definition	"the inverse function of the secant; the angle that has a secant equal to a given number"@en ;
	dc:source	pwn30:13788820-n .

<i109368>	a	<Concept> ;
	skos:definition	"ratio of the hypotenuse to the opposite side of a right-angled triangle"@en ;
	dc:source	pwn30:13789002-n .

<i109369>	a	<Concept> ;
	skos:definition	"the angle that has a cosecant equal to a given number"@en ;
	dc:source	pwn30:13789136-n .

<i109370>	a	<Concept> ;
	skos:definition	"a function that takes the value 1 if a specified function of the arguments exceeds a given threshold and 0 otherwise"@en ;
	dc:source	pwn30:13789281-n .

<i109371>	a	<Concept> ;
	skos:definition	"a function in which an independent variable appears as an exponent"@en ;
	dc:source	pwn30:13789462-n .

<i109372>	a	<Concept> ;
	skos:definition	"an equation involving exponential functions of a variable"@en ;
	dc:source	pwn30:13789627-n .

<i109373>	a	<Concept> ;
	skos:definition	"a graph of an exponential function"@en ;
	dc:source	pwn30:13789751-n .

<i109374>	a	<Concept> ;
	skos:definition	"a mathematical expression consisting of a constant (especially e) raised to some power"@en ;
	dc:source	pwn30:13789849-n .

<i109375>	a	<Concept> ;
	skos:definition	"a series derived from the expansion of an exponential expression"@en ;
	dc:source	pwn30:13790004-n .

<i109376>	a	<Concept> ;
	skos:definition	"(mathematics) a relation between a pair of integers: if both integers are odd or both are even they have the same parity; if one is odd and the other is even they have different parity"@en ;
	dc:source	pwn30:13790133-n .

<i109377>	a	<Concept> ;
	skos:definition	"the parity of even numbers (divisible by two)"@en ;
	dc:source	pwn30:13790492-n .

<i109378>	a	<Concept> ;
	skos:definition	"the parity of odd numbers (not divisible by two)"@en ;
	dc:source	pwn30:13790592-n .

<i109379>	a	<Concept> ;
	skos:definition	"the basis on which something is grounded"@en ;
	dc:source	pwn30:13790712-n .

<i109380>	a	<Concept> ;
	skos:definition	"a relation that provides the foundation for something"@en ;
	dc:source	pwn30:13790912-n .

<i109381>	a	<Concept> ;
	skos:definition	"a basis agreed to by all parties for reaching a mutual understanding"@en ;
	dc:source	pwn30:13791122-n .

<i109382>	a	<Concept> ;
	skos:definition	"the essential foundation or source"@en ;
	dc:source	pwn30:13791250-n .

<i109383>	a	<Concept> ;
	skos:definition	"a relation between things or events (as in the case of one causing the other or sharing features with it)"@en ;
	dc:source	pwn30:13791389-n .

<i109384>	a	<Concept> ;
	skos:definition	"(electronics) connection of components in such a manner that current flows first through one and then through the other"@en ;
	dc:source	pwn30:13791910-n .

<i109385>	a	<Concept> ;
	skos:definition	"a connection based on kinship or marriage or common interest"@en ;
	dc:source	pwn30:13792183-n .

<i109386>	a	<Concept> ;
	skos:definition	"the emotional bond between a mother and her offspring"@en ;
	dc:source	pwn30:13792468-n .

<i109387>	a	<Concept> ;
	skos:definition	"an associative relation"@en ;
	dc:source	pwn30:13792579-n .

<i109388>	a	<Concept> ;
	skos:definition	"the means of connection between things linked in series"@en ;
	dc:source	pwn30:13792692-n .

<i109389>	a	<Concept> ;
	skos:definition	"a connection allowing access between persons or places"@en ;
	dc:source	pwn30:13792842-n .

<i109390>	a	<Concept> ;
	skos:definition	"the linking together of a consecutive series of symbols or events or ideas etc"@en ;
	dc:source	pwn30:13793127-n .

<i109391>	a	<Concept> ;
	skos:definition	"something resembling a bridge in form or function"@en ;
	dc:source	pwn30:13793330-n .

<i109392>	a	<Concept> ;
	skos:definition	"a connection of inclusion or containment"@en ;
	dc:source	pwn30:13793504-n .

<i109393>	a	<Concept> ;
	skos:definition	"a relation implicated by virtue of involvement or close connection (especially an incriminating involvement)"@en ;
	dc:source	pwn30:13793776-n .

<i109394>	a	<Concept> ;
	skos:definition	"the relation of comprising something"@en ;
	dc:source	pwn30:13794034-n .

<i109395>	a	<Concept> ;
	skos:definition	"the lack of a connection between things"@en ;
	dc:source	pwn30:13794226-n .

<i109396>	a	<Concept> ;
	skos:definition	"the relation of something to the matter at hand"@en ;
	dc:source	pwn30:13794417-n .

<i109397>	a	<Concept> ;
	skos:definition	"relevance requiring careful consideration"@en ;
	dc:source	pwn30:13794658-n .

<i109398>	a	<Concept> ;
	skos:definition	"persuasive relevance"@en ;
	dc:source	pwn30:13794793-n .

<i109399>	a	<Concept> ;
	skos:definition	"a style in speech or writing that arrests attention and has a penetrating or convincing quality or effect"@en ;
	dc:source	pwn30:13794885-n .

<i109400>	a	<Concept> ;
	skos:definition	"pertinence by virtue of a close relation to the matter at hand"@en ;
	dc:source	pwn30:13795042-n .

<i109401>	a	<Concept> ;
	skos:definition	"relevance by virtue of being applicable to the matter at hand"@en ;
	dc:source	pwn30:13795180-n .

<i109402>	a	<Concept> ;
	skos:definition	"a particular manner of connectedness"@en ;
	dc:source	pwn30:13795489-n .

<i109403>	a	<Concept> ;
	skos:definition	"relevant relation or interconnection"@en ;
	dc:source	pwn30:13795695-n .

<i109404>	a	<Concept> ;
	skos:definition	"the lack of a relation of something to the matter at hand"@en ;
	dc:source	pwn30:13795834-n .

<i109405>	a	<Concept> ;
	skos:definition	"irrelevance by virtue of being inapplicable to the matter at hand"@en ;
	dc:source	pwn30:13796053-n .

<i109406>	a	<Concept> ;
	skos:definition	"complete irrelevance requiring no further consideration"@en ;
	dc:source	pwn30:13796216-n .

<i109407>	a	<Concept> ;
	skos:definition	"the lack of any particular manner of connectedness"@en ;
	dc:source	pwn30:13796403-n .

<i109408>	a	<Concept> ;
	skos:definition	"unrelatedness by virtue of falling outside the matter at hand"@en ;
	dc:source	pwn30:13796585-n .

<i109409>	a	<Concept> ;
	skos:definition	"a linguistic relation established by grammar"@en ;
	dc:source	pwn30:13796779-n .

<i109410>	a	<Concept> ;
	skos:definition	"a relation between linguistic forms or constituents"@en ;
	dc:source	pwn30:13797142-n .

<i109411>	a	<Concept> ;
	skos:definition	"the determination of grammatical inflection on the basis of word relations"@en ;
	dc:source	pwn30:13797313-n .

<i109412>	a	<Concept> ;
	skos:definition	"agreement in number between words in the same grammatical construction (e.g., between adjectives and the nouns they modify)"@en ;
	dc:source	pwn30:13797561-n .

<i109413>	a	<Concept> ;
	skos:definition	"agreement in person between pronouns and verbs"@en ;
	dc:source	pwn30:13797747-n .

<i109414>	a	<Concept> ;
	skos:definition	"agreement in grammatical case between words in the same construction"@en ;
	dc:source	pwn30:13797856-n .

<i109415>	a	<Concept> ;
	skos:definition	"agreement in grammatical gender between words in the same construction"@en ;
	dc:source	pwn30:13797985-n .

<i109416>	a	<Concept> ;
	skos:definition	"the grammatical relation created by a transitive verb"@en ;
	dc:source	pwn30:13798118-n .

<i109417>	a	<Concept> ;
	skos:definition	"the grammatical relation created by an intransitive verb"@en ;
	dc:source	pwn30:13798301-n .

<i109418>	a	<Concept> ;
	skos:definition	"(logic and mathematics) a relation between three elements such that if it holds between the first and second and it also holds between the second and third it must necessarily hold between the first and third"@en ;
	dc:source	pwn30:13798491-n .

<i109419>	a	<Concept> ;
	skos:definition	"(logic and mathematics) a relation such that it holds between an element and itself"@en ;
	dc:source	pwn30:13798814-n .

<i109420>	a	<Concept> ;
	skos:definition	"the grammatical relation between two words that have a common referent"@en ;
	dc:source	pwn30:13799063-n .

<i109421>	a	<Concept> ;
	skos:definition	"the coreferential relation between a reflexive pronoun and its antecedent"@en ;
	dc:source	pwn30:13799245-n .

<i109422>	a	<Concept> ;
	skos:definition	"the grammatical relation between linguistic units (words or phrases or clauses) that are connected by a conjunction"@en ;
	dc:source	pwn30:13799392-n .

<i109423>	a	<Concept> ;
	skos:definition	"the coordination by conjunction of linguistic units of the same status"@en ;
	dc:source	pwn30:13799655-n .

<i109424>	a	<Concept> ;
	skos:definition	"the subordination that occurs when a conjunction makes one linguistic unit a constituent of another"@en ;
	dc:source	pwn30:13799796-n .

<i109425>	a	<Concept> ;
	skos:definition	"the conjunctive relation of units that expresses the addition of their meanings"@en ;
	dc:source	pwn30:13799967-n .

<i109426>	a	<Concept> ;
	skos:definition	"the conjunctive relation of units that expresses the disjunction of their meanings"@en ;
	dc:source	pwn30:13800115-n .

<i109427>	a	<Concept> ;
	skos:definition	"the conjunctive relation of units that expresses the opposition of their meanings"@en ;
	dc:source	pwn30:13800267-n .

<i109428>	a	<Concept> ;
	skos:definition	"the grammatical relation of a word or phrase to a predicate"@en ;
	dc:source	pwn30:13800418-n .

<i109429>	a	<Concept> ;
	skos:definition	"the grammatical relation of two constituents having the same grammatical form"@en ;
	dc:source	pwn30:13800539-n .

<i109430>	a	<Concept> ;
	skos:definition	"the grammatical relation of a modifying word or phrase to its head"@en ;
	dc:source	pwn30:13800675-n .

<i109431>	a	<Concept> ;
	skos:definition	"the grammatical relation that exists when a word qualifies the meaning of the phrase"@en ;
	dc:source	pwn30:13800801-n .

<i109432>	a	<Concept> ;
	skos:definition	"a grammatical qualification that makes the meaning more specific (`red hat' has a more specific meaning than `hat')"@en ;
	dc:source	pwn30:13801040-n .

<i109433>	a	<Concept> ;
	skos:definition	"a grammatical relation between a word and a noun phrase that follows"@en ;
	dc:source	pwn30:13801217-n .

<i109434>	a	<Concept> ;
	skos:definition	"verb inflections that express how the action or state is conceived by the speaker"@en ;
	dc:source	pwn30:13801424-n .

<i109435>	a	<Concept> ;
	skos:definition	"a mood (grammatically unmarked) that represents the act or state as an objective fact"@en ;
	dc:source	pwn30:13801700-n .

<i109436>	a	<Concept> ;
	skos:definition	"a mood that represents an act or state (not as a fact but) as contingent or possible"@en ;
	dc:source	pwn30:13801937-n .

<i109437>	a	<Concept> ;
	skos:definition	"a mood (as in Greek or Sanskrit) that expresses a wish or hope; expressed in English by modal verbs"@en ;
	dc:source	pwn30:13802098-n .

<i109438>	a	<Concept> ;
	skos:definition	"a mood that expresses an intention to influence the listener's behavior"@en ;
	dc:source	pwn30:13802306-n .

<i109439>	a	<Concept> ;
	skos:definition	"some linguists consider interrogative sentences to constitute a mood"@en ;
	dc:source	pwn30:13802485-n .

<i109440>	a	<Concept> ;
	skos:definition	"a classification of propositions on the basis of whether they claim necessity or possibility or impossibility"@en ;
	dc:source	pwn30:13802634-n .

<i109441>	a	<Concept> ;
	skos:definition	"the relation between an anaphor and its antecedent"@en ;
	dc:source	pwn30:13802805-n .

<i109442>	a	<Concept> ;
	skos:definition	"(linguistics) the grammatical relation (active or passive) of the grammatical subject of a verb to the action that the verb denotes"@en ;
	dc:source	pwn30:13802920-n .

<i109443>	a	<Concept> ;
	skos:definition	"the voice used to indicate that the grammatical subject of the verb is performing the action or causing the happening denoted by the verb"@en ;
	dc:source	pwn30:13803158-n .

<i109444>	a	<Concept> ;
	skos:definition	"the voice used to indicate that the grammatical subject of the verb is the recipient (not the source) of the action denoted by the verb"@en ;
	dc:source	pwn30:13803431-n .

<i109445>	a	<Concept> ;
	skos:definition	"a change in the form of a word (usually by adding a suffix) to indicate a change in its grammatical function"@en ;
	dc:source	pwn30:13803782-n .

<i109446>	a	<Concept> ;
	skos:definition	"the inflection of verbs"@en ;
	dc:source	pwn30:13804085-n .

<i109447>	a	<Concept> ;
	skos:definition	"the inflection of nouns and pronouns and adjectives in Indo-European languages"@en ;
	dc:source	pwn30:13804203-n .

<i109448>	a	<Concept> ;
	skos:definition	"systematic arrangement of all the inflected forms of a word"@en ;
	dc:source	pwn30:13804375-n .

<i109449>	a	<Concept> ;
	skos:definition	"the act of pluralizing or attributing plurality to"@en ;
	dc:source	pwn30:13804507-n .

<i109450>	a	<Concept> ;
	skos:definition	"the beginning or duration or completion or repetition of the action of a verb"@en ;
	dc:source	pwn30:13804669-n .

<i109451>	a	<Concept> ;
	skos:definition	"the aspect of a verb that expresses a completed action"@en ;
	dc:source	pwn30:13804889-n .

<i109452>	a	<Concept> ;
	skos:definition	"aspect without regard to the beginning or completion of the action of the verb"@en ;
	dc:source	pwn30:13805020-n .

<i109453>	a	<Concept> ;
	skos:definition	"the aspect of a verb that expresses its duration"@en ;
	dc:source	pwn30:13805179-n .

<i109454>	a	<Concept> ;
	skos:definition	"the aspect of a verb that expresses its on-going action"@en ;
	dc:source	pwn30:13805336-n .

<i109455>	a	<Concept> ;
	skos:definition	"aspect with regard to the beginning of the action of the verb"@en ;
	dc:source	pwn30:13805456-n .

<i109456>	a	<Concept> ;
	skos:definition	"the aspect of the verb that expresses the repetition of an action"@en ;
	dc:source	pwn30:13805594-n .

<i109457>	a	<Concept> ;
	skos:definition	"a tense of verbs used in describing action that is on-going"@en ;
	dc:source	pwn30:13805734-n .

<i109458>	a	<Concept> ;
	skos:definition	"a tense used to express action that is on-going at the time of utterance"@en ;
	dc:source	pwn30:13805974-n .

<i109459>	a	<Concept> ;
	skos:definition	"a tense of verbs used in describing action that has been completed (sometimes regarded as perfective aspect)"@en ;
	dc:source	pwn30:13806140-n .

<i109460>	a	<Concept> ;
	skos:definition	"a perfective tense used to express action completed in the present"@en ;
	dc:source	pwn30:13806404-n .

<i109461>	a	<Concept> ;
	skos:definition	"a term formerly used to refer to the simple past tense"@en ;
	dc:source	pwn30:13806614-n .

<i109462>	a	<Concept> ;
	skos:definition	"a perfective tense used to express action completed in the past"@en ;
	dc:source	pwn30:13806735-n .

<i109463>	a	<Concept> ;
	skos:definition	"a progressive tense used to describe on-going action in the past"@en ;
	dc:source	pwn30:13806964-n .

<i109464>	a	<Concept> ;
	skos:definition	"a perfective tense used to describe action that will be completed in the future"@en ;
	dc:source	pwn30:13807178-n .

<i109465>	a	<Concept> ;
	skos:definition	"a progressive tense used to express action that will be on-going in the future"@en ;
	dc:source	pwn30:13807403-n .

<i109466>	a	<Concept> ;
	skos:definition	"a relation between meanings"@en ;
	dc:source	pwn30:13807636-n .

<i109467>	a	<Concept> ;
	skos:definition	"the semantic relation of being subordinate or belonging to a lower rank or class"@en ;
	dc:source	pwn30:13807853-n .

<i109468>	a	<Concept> ;
	skos:definition	"the semantic relation of being superordinate or belonging to a higher rank or class"@en ;
	dc:source	pwn30:13808004-n .

<i109469>	a	<Concept> ;
	skos:definition	"the semantic relation that holds between two words that can (in a given context) express the same meaning"@en ;
	dc:source	pwn30:13808161-n .

<i109470>	a	<Concept> ;
	skos:definition	"the semantic relation that holds between two words that can (in a given context) express opposite meanings"@en ;
	dc:source	pwn30:13808405-n .

<i109471>	a	<Concept> ;
	skos:definition	"the semantic relation that holds between a whole and its parts"@en ;
	dc:source	pwn30:13808566-n .

<i109472>	a	<Concept> ;
	skos:definition	"the semantic relation that holds between a part and the whole"@en ;
	dc:source	pwn30:13808708-n .

<i109473>	a	<Concept> ;
	skos:definition	"the semantic relation of being a manner of does something"@en ;
	dc:source	pwn30:13808868-n .

<i109474>	a	<Concept> ;
	skos:definition	"the relation between two words that are spelled the same way but differ in meaning or the relation between two words that are pronounced the same way but differ in meaning"@en ;
	dc:source	pwn30:13808981-n .

<i109475>	a	<Concept> ;
	skos:definition	"something determined in relation to something that includes it"@en ;
	dc:source	pwn30:13809207-n .

<i109476>	a	<Concept> ;
	skos:definition	"the most important or necessary part of something"@en ;
	dc:source	pwn30:13809769-n .

<i109477>	a	<Concept> ;
	skos:definition	"a small part that can be considered separately from the whole"@en ;
	dc:source	pwn30:13809920-n .

<i109478>	a	<Concept> ;
	skos:definition	"the most interesting or memorable part"@en ;
	dc:source	pwn30:13810141-n .

<i109479>	a	<Concept> ;
	skos:definition	"an individual or group or structure or other entity regarded as a structural or functional constituent of a whole"@en ;
	dc:source	pwn30:13810323-n .

<i109480>	a	<Concept> ;
	skos:definition	"anything that belongs to a set or class"@en ;
	dc:source	pwn30:13810615-n .

<i109481>	a	<Concept> ;
	skos:definition	"something left after other parts have been taken away"@en ;
	dc:source	pwn30:13810818-n .

<i109482>	a	<Concept> ;
	skos:definition	"a small part or portion that remains after the main part no longer exists"@en ;
	dc:source	pwn30:13811184-n .

<i109483>	a	<Concept> ;
	skos:definition	"a part of a part"@en ;
	dc:source	pwn30:13811340-n .

<i109484>	a	<Concept> ;
	skos:definition	"a close connection marked by community of interests or similarity in nature or character"@en ;
	dc:source	pwn30:13811410-n .

<i109485>	a	<Concept> ;
	skos:definition	"a relationship of mutual understanding or trust and agreement between people"@en ;
	dc:source	pwn30:13811740-n .

<i109486>	a	<Concept> ;
	skos:definition	"a relation of affinity or harmony between people; whatever affects one correspondingly affects the other"@en ;
	dc:source	pwn30:13811900-n .

<i109487>	a	<Concept> ;
	skos:definition	"sympathy of each person for the other"@en ;
	dc:source	pwn30:13812173-n .

<i109488>	a	<Concept> ;
	skos:definition	"(biology) state of relationship between organisms or groups of organisms resulting in resemblance in structure or structural parts"@en ;
	dc:source	pwn30:13812296-n .

<i109489>	a	<Concept> ;
	skos:definition	"(anthropology) relatedness or connection by blood or marriage or adoption"@en ;
	dc:source	pwn30:13812607-n .

<i109490>	a	<Concept> ;
	skos:definition	"the kinship relation between an individual and the individual's progenitors"@en ;
	dc:source	pwn30:13813042-n .

<i109491>	a	<Concept> ;
	skos:definition	"(anthropology) kinship by marriage or adoption; not a blood relationship"@en ;
	dc:source	pwn30:13813283-n .

<i109492>	a	<Concept> ;
	skos:definition	"a family relationship by virtue of remarriage"@en ;
	dc:source	pwn30:13813483-n .

<i109493>	a	<Concept> ;
	skos:definition	"(anthropology) related by blood"@en ;
	dc:source	pwn30:13813591-n .

<i109494>	a	<Concept> ;
	skos:definition	"the kinship relation of an offspring to the parents"@en ;
	dc:source	pwn30:13813765-n .

<i109495>	a	<Concept> ;
	skos:definition	"the kinship relation between an offspring and the father"@en ;
	dc:source	pwn30:13813898-n .

<i109496>	a	<Concept> ;
	skos:definition	"the kinship relation between an offspring and the mother"@en ;
	dc:source	pwn30:13814041-n .

<i109497>	a	<Concept> ;
	skos:definition	"the kinship relation between a female offspring and the siblings"@en ;
	dc:source	pwn30:13814184-n .

<i109498>	a	<Concept> ;
	skos:definition	"the kinship relation between a male offspring and the siblings"@en ;
	dc:source	pwn30:13814336-n .

<i109499>	a	<Concept> ;
	skos:definition	"line of descent traced through both the maternal and paternal sides of the family"@en ;
	dc:source	pwn30:13814456-n .

<i109500>	a	<Concept> ;
	skos:definition	"line of descent traced through one side of the family"@en ;
	dc:source	pwn30:13814601-n .

<i109501>	a	<Concept> ;
	skos:definition	"line of descent traced through the maternal side of the family"@en ;
	dc:source	pwn30:13814755-n .

<i109502>	a	<Concept> ;
	skos:definition	"line of descent traced through the paternal side of the family"@en ;
	dc:source	pwn30:13814898-n .

<i109503>	a	<Concept> ;
	skos:definition	"the relationship between wife and husband"@en ;
	dc:source	pwn30:13815030-n .

<i109504>	a	<Concept> ;
	skos:definition	"a relation between magnitudes"@en ;
	dc:source	pwn30:13815152-n .

<i109505>	a	<Concept> ;
	skos:definition	"relative magnitude"@en ;
	dc:source	pwn30:13815342-n .

<i109506>	a	<Concept> ;
