	dc:source	pwn30:15108324-n .

<i116605>	a	<Concept> ;
	skos:definition	"a yellow to white crystalline fluorescent compound that occurs naturally as sphalerite or wurtzite and is used as a luminous pigment"@en ;
	dc:source	pwn30:15108538-n .

<i116606>	a	<Concept> ;
