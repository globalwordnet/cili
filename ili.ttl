<i69055>	a	<Concept> ;
	skos:definition	"the mystical theological doctrine of Jakob Boehme that influenced the Quakers"@en ;
	dc:source	pwn30:06188146-n .

<i69056>	a	<Concept> ;
	skos:definition	"the doctrine of the High Anglican Church that after the consecration of the Eucharist the substance of the body and blood of Christ coexists with the substance of the consecrated bread and wine"@en ;
	dc:source	pwn30:06188292-n .

