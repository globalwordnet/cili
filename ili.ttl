	dc:source	pwn30:05309591-n .

<i64862>	a	<Concept> ;
	skos:definition	"the upper surface of the mouth that separates the oral and nasal cavities"@en ;
	dc:source	pwn30:05309725-n .

<i64863>	a	<Concept> ;
