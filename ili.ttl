	dc:source	pwn30:13579287-n .

<i108065>	a	<Concept> ;
	skos:definition	"a data transmission rate; the maximum amount of information (bits/second) that can be transmitted along a channel"@en ;
	dc:source	pwn30:13579510-n .

<i108066>	a	<Concept> ;
	skos:definition	"(computer science) a data transmission rate (bits/second) for modems"@en ;
	dc:source	pwn30:13579679-n .

<i108067>	a	<Concept> ;
