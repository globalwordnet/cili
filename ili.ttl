	dc:source	pwn30:12986084-n .

<i105008>	a	<Concept> ;
	skos:definition	"a fungus of the family Hydnaceae"@en ;
	dc:source	pwn30:12986227-n .

<i105009>	a	<Concept> ;
	skos:definition	"type genus of Hydnaceae"@en ;
	dc:source	pwn30:12986337-n .

<i105010>	a	<Concept> ;
	skos:definition	"comprising the lichens which grow symbiotically with algae; sometimes treated as an independent group more or less coordinate with algae and fungi"@en ;
	dc:source	pwn30:12986447-n .

<i105011>	a	<Concept> ;
	skos:definition	"category used especially in former classifications for organisms now constituting the division Lichenes"@en ;
	dc:source	pwn30:12986858-n .

<i105012>	a	<Concept> ;
	skos:definition	"any thallophytic plant of the division Lichenes; occur as crusty patches or bushy growths on tree trunks or rocks or bare ground etc."@en ;
	dc:source	pwn30:12987056-n .

<i105013>	a	<Concept> ;
	skos:definition	"a lichen in which the fungus component is an ascomycete"@en ;
	dc:source	pwn30:12987423-n .

<i105014>	a	<Concept> ;
	skos:definition	"a lichen in which the fungus component is a basidiomycete"@en ;
	dc:source	pwn30:12987535-n .

<i105015>	a	<Concept> ;
	skos:definition	"category used in some classification systems for all lichens that produce apothecia"@en ;
	dc:source	pwn30:12987652-n .

<i105016>	a	<Concept> ;
	skos:definition	"a fungus family of the division Lichenes"@en ;
	dc:source	pwn30:12987834-n .

<i105017>	a	<Concept> ;
	skos:definition	"type genus of Lecanoraceae; crustaceous lichens"@en ;
	dc:source	pwn30:12987993-n .

<i105018>	a	<Concept> ;
	skos:definition	"any lichen of the genus Lecanora; some used in dyeing; some used for food"@en ;
	dc:source	pwn30:12988158-n .

<i105019>	a	<Concept> ;
	skos:definition	"any of several Old World partially crustaceous or shrubby lecanoras that roll up and are blown about over African and Arabian deserts and used as food by people and animals"@en ;
	dc:source	pwn30:12988341-n .

<i105020>	a	<Concept> ;
	skos:definition	"any of various lecanoras that yield the dye archil"@en ;
	dc:source	pwn30:12988572-n .

<i105021>	a	<Concept> ;
	skos:definition	"a fungus family of division Lichenes"@en ;
	dc:source	pwn30:12988703-n .

<i105022>	a	<Concept> ;
	skos:definition	"chiefly fruticose maritime rock-inhabiting lichens"@en ;
	dc:source	pwn30:12988858-n .

<i105023>	a	<Concept> ;
	skos:definition	"a source of the dye archil and of litmus"@en ;
	dc:source	pwn30:12989007-n .

<i105024>	a	<Concept> ;
	skos:definition	"a fungus family of division Lichenes"@en ;
	dc:source	pwn30:12989142-n .

<i105025>	a	<Concept> ;
	skos:definition	"crustose lichens that are a source of the dye archil and of litmus"@en ;
	dc:source	pwn30:12989301-n .

<i105026>	a	<Concept> ;
	skos:definition	"fruticose lichens having prostrate or erect or pendulous thalli: genera Usnea, Evernia, Ramalina, Alectoria"@en ;
	dc:source	pwn30:12989462-n .

<i105027>	a	<Concept> ;
	skos:definition	"widely distributed lichens usually having a greyish or yellow pendulous freely branched thallus"@en ;
	dc:source	pwn30:12989739-n .

<i105028>	a	<Concept> ;
	skos:definition	"greenish grey pendulous lichen growing on trees"@en ;
	dc:source	pwn30:12989938-n .

<i105029>	a	<Concept> ;
	skos:definition	"lichens of the family Usneaceae having a pendulous or shrubby thallus"@en ;
	dc:source	pwn30:12990092-n .

<i105030>	a	<Concept> ;
	skos:definition	"shrubby lichens of the family Usneaceae having a flattened thallus"@en ;
	dc:source	pwn30:12990250-n .

<i105031>	a	<Concept> ;
	skos:definition	"lichens having dark brown erect or pendulous much-branched cylindrical thallus"@en ;
	dc:source	pwn30:12990407-n .

<i105032>	a	<Concept> ;
	skos:definition	"any of several lichens of the genus Alectoria having a thallus consisting of filaments resembling hair"@en ;
	dc:source	pwn30:12990597-n .

<i105033>	a	<Concept> ;
	skos:definition	"a family of lichens"@en ;
	dc:source	pwn30:12990800-n .

<i105034>	a	<Concept> ;
	skos:definition	"type genus of Cladoniaceae; lichens characterized by a crustose thallus and capitate fruiting bodies borne on simple or branched podetia"@en ;
	dc:source	pwn30:12990938-n .

<i105035>	a	<Concept> ;
	skos:definition	"an erect greyish branching lichen of Arctic and even some north temperate regions constituting the chief food for reindeer and caribou and sometimes being eaten by humans"@en ;
	dc:source	pwn30:12991184-n .

<i105036>	a	<Concept> ;
	skos:definition	"a family of lichens"@en ;
	dc:source	pwn30:12991488-n .

<i105037>	a	<Concept> ;
	skos:definition	"type genus of the Parmeliaceae; a large genus of chiefly alpine foliaceous lichens"@en ;
	dc:source	pwn30:12991645-n .

<i105038>	a	<Concept> ;
	skos:definition	"any of several lichens of the genus Parmelia from which reddish brown or purple dyes are made"@en ;
	dc:source	pwn30:12991837-n .

<i105039>	a	<Concept> ;
	skos:definition	"foliose lichens chiefly of northern latitudes"@en ;
	dc:source	pwn30:12992022-n .

<i105040>	a	<Concept> ;
	skos:definition	"lichen with branched flattened partly erect thallus that grows in mountainous and Arctic regions; used as a medicine or food for humans and livestock; a source of glycerol"@en ;
	dc:source	pwn30:12992177-n .

<i105041>	a	<Concept> ;
	skos:definition	"the taxonomic kingdom including yeast, molds, smuts, mushrooms, and toadstools; distinct from the green plants"@en ;
	dc:source	pwn30:12992464-n .

<i105042>	a	<Concept> ;
	skos:definition	"an organism of the kingdom Fungi lacking chlorophyll and feeding on organic matter; ranging from unicellular or multicellular organisms to spore-bearing syncytia"@en ;
	dc:source	pwn30:12992868-n .

<i105043>	a	<Concept> ;
	skos:definition	"a small club-shaped structure typically bearing four basidiospores at the ends of minute projections; unique to basidiomycetes"@en ;
	dc:source	pwn30:12994475-n .

<i105044>	a	<Concept> ;
	skos:definition	"special cell constituting the base of the basidium in various fungi especially of the order Tremellales"@en ;
	dc:source	pwn30:12994711-n .

<i105045>	a	<Concept> ;
	skos:definition	"the basidium of various fungi"@en ;
	dc:source	pwn30:12994892-n .

<i105046>	a	<Concept> ;
	skos:definition	"true fungi; eukaryotic heterotrophic walled organisms; distinguished from Myxomycota (funguslike slime molds): comprises subdivisions Mastigomycotina; Zygomycotina; Ascomycotina; Basidiomycotina; Deuteromycotina (imperfect fungi)"@en ;
	dc:source	pwn30:12994979-n .

<i105047>	a	<Concept> ;
	skos:definition	"category used in some classifications: coextensive with division Eumycota"@en ;
	dc:source	pwn30:12995435-n .

<i105048>	a	<Concept> ;
	skos:definition	"any of numerous fungi of the division Eumycota"@en ;
	dc:source	pwn30:12995601-n .

<i105049>	a	<Concept> ;
	skos:definition	"large and heterogeneous form division of fungi comprising forms for which no sexually reproductive stage is known"@en ;
	dc:source	pwn30:12995724-n .

<i105050>	a	<Concept> ;
	skos:definition	"form class; coextensive with subdivision Deuteromycota"@en ;
	dc:source	pwn30:12996068-n .

<i105051>	a	<Concept> ;
	skos:definition	"comprises fungi bearing the spores on a basidium; includes Gasteromycetes (puffballs) and Tiliomycetes comprising the orders Ustilaginales (smuts) and Uredinales (rusts) and Hymenomycetes (mushrooms, toadstools, agarics and bracket fungi); in some classification systems considered a division of kingdom Fungi"@en ;
	dc:source	pwn30:12996225-n .

<i105052>	a	<Concept> ;
	skos:definition	"large class of higher fungi coextensive with subdivision Basidiomycota"@en ;
	dc:source	pwn30:12996841-n .

<i105053>	a	<Concept> ;
	skos:definition	"category used in some classification systems for various basidiomycetous fungi including e.g. mushrooms and puffballs which are usually placed in the classes Gasteromycetes and Hymenomycetes"@en ;
	dc:source	pwn30:12997128-n .

<i105054>	a	<Concept> ;
	skos:definition	"category used in some classification systems for various basidiomycetous fungi including rusts and smuts"@en ;
	dc:source	pwn30:12997432-n .

<i105055>	a	<Concept> ;
	skos:definition	"any of various fungi of the subdivision Basidiomycota"@en ;
	dc:source	pwn30:12997654-n .

<i105056>	a	<Concept> ;
	skos:definition	"any of various fleshy fungi of the subdivision Basidiomycota consisting of a cap at the end of a stem arising from an underground mycelium"@en ;
	dc:source	pwn30:12997919-n .

<i105057>	a	<Concept> ;
	skos:definition	"used in some classifications; usually coextensive with order Agaricales: mushrooms; toadstools; agarics; bracket fungi"@en ;
	dc:source	pwn30:12998130-n .

<i105058>	a	<Concept> ;
	skos:definition	"typical gilled mushrooms belonging to the subdivision Basidiomycota"@en ;
	dc:source	pwn30:12998349-n .

<i105059>	a	<Concept> ;
	skos:definition	"a saprophytic fungus of the order Agaricales having an umbrellalike cap with gills on the underside"@en ;
	dc:source	pwn30:12998815-n .

<i105060>	a	<Concept> ;
	skos:definition	"large family including many familiar mushrooms"@en ;
	dc:source	pwn30:13000372-n .

<i105061>	a	<Concept> ;
	skos:definition	"type genus of Agaricaceae; gill fungi having brown spores and including several edible species"@en ;
	dc:source	pwn30:13000668-n .

<i105062>	a	<Concept> ;
	skos:definition	"mushrooms and related fleshy fungi (including toadstools, puffballs, morels, coral fungi, etc.)"@en ;
	dc:source	pwn30:13000891-n .

<i105063>	a	<Concept> ;
	skos:definition	"common name for an edible agaric (contrasting with the inedible toadstool)"@en ;
	dc:source	pwn30:13001041-n .

<i105064>	a	<Concept> ;
	skos:definition	"common name for an inedible or poisonous agaric (contrasting with the edible mushroom)"@en ;
	dc:source	pwn30:13001206-n .

<i105065>	a	<Concept> ;
	skos:definition	"coarse edible mushroom with a hollow stem and a broad white cap"@en ;
	dc:source	pwn30:13001366-n .

<i105066>	a	<Concept> ;
	skos:definition	"common edible mushroom found naturally in moist open soil; the cultivated mushroom of commerce"@en ;
	dc:source	pwn30:13001529-n .

<i105067>	a	<Concept> ;
	skos:definition	"a genus of fungus belonging to the family Tricholomataceae"@en ;
	dc:source	pwn30:13001743-n .

<i105068>	a	<Concept> ;
	skos:definition	"edible east Asian mushroom having a golden or dark brown to blackish cap and an inedible stipe"@en ;
	dc:source	pwn30:13001930-n .

<i105069>	a	<Concept> ;
	skos:definition	"a fungus with a scaly cap and white flesh and a ring on the stalk (with scales below the ring); odor reminiscent of licorice"@en ;
	dc:source	pwn30:13002209-n .

<i105070>	a	<Concept> ;
	skos:definition	"genus of widely distributed agarics that have white spores and are poisonous with few exceptions"@en ;
	dc:source	pwn30:13002433-n .

<i105071>	a	<Concept> ;
	skos:definition	"widely distributed edible mushroom resembling the fly agaric"@en ;
	dc:source	pwn30:13002750-n .

<i105072>	a	<Concept> ;
	skos:definition	"agaric often confused with the death cup"@en ;
	dc:source	pwn30:13002925-n .

<i105073>	a	<Concept> ;
	skos:definition	"poisonous (but rarely fatal) woodland fungus having a scarlet cap with white warts and white gills"@en ;
	dc:source	pwn30:13003061-n .

<i105074>	a	<Concept> ;
	skos:definition	"extremely poisonous usually white fungus with a prominent cup-shaped base; differs from edible Agaricus only in its white gills"@en ;
	dc:source	pwn30:13003254-n .

<i105075>	a	<Concept> ;
	skos:definition	"yellowish edible agaric that usually turns red when touched"@en ;
	dc:source	pwn30:13003522-n .

<i105076>	a	<Concept> ;
	skos:definition	"fungus similar to Amanita phalloides"@en ;
	dc:source	pwn30:13003712-n .

<i105077>	a	<Concept> ;
	skos:definition	"a mushroom of the genus Amanita"@en ;
	dc:source	pwn30:13003846-n .

<i105078>	a	<Concept> ;
	skos:definition	"a type of slime mushroom"@en ;
	dc:source	pwn30:13003974-n .

<i105079>	a	<Concept> ;
	skos:definition	"a type of slime mushroom"@en ;
	dc:source	pwn30:13004065-n .

<i105080>	a	<Concept> ;
	skos:definition	"a well-known genus of fungus; has funnel-shaped fruiting body; includes the chanterelles"@en ;
	dc:source	pwn30:13004160-n .

<i105081>	a	<Concept> ;
	skos:definition	"widely distributed edible mushroom rich yellow in color with a smooth cap and a pleasant apricot aroma"@en ;
	dc:source	pwn30:13004423-n .

<i105082>	a	<Concept> ;
	skos:definition	"a mildly poisonous fungus with a fruiting body shaped like a hollow trumpet"@en ;
	dc:source	pwn30:13004640-n .

<i105083>	a	<Concept> ;
	skos:definition	"an edible agaric with a brown fruiting body that is often compound"@en ;
	dc:source	pwn30:13004826-n .

<i105084>	a	<Concept> ;
	skos:definition	"mushroom with a distinctive pink to vermillion fruiting body"@en ;
	dc:source	pwn30:13004992-n .

<i105085>	a	<Concept> ;
	skos:definition	"a genus of fungi with a depressed disc in the cap"@en ;
	dc:source	pwn30:13005166-n .

<i105086>	a	<Concept> ;
	skos:definition	"a large poisonous agaric with orange caps and narrow clustered stalks; the gills are luminescent"@en ;
	dc:source	pwn30:13005329-n .

<i105087>	a	<Concept> ;
	skos:definition	"genus of black-spotted agarics in which the cap breaks down at maturity into an inky fluid; sometimes placed in its own family Coprinaceae"@en ;
	dc:source	pwn30:13005568-n .

<i105088>	a	<Concept> ;
	skos:definition	"used in some classifications for the genus Coprinus"@en ;
	dc:source	pwn30:13005835-n .

<i105089>	a	<Concept> ;
	skos:definition	"having a cap that melts into an inky fluid after spores have matured"@en ;
	dc:source	pwn30:13005984-n .

<i105090>	a	<Concept> ;
	skos:definition	"common edible mushroom having an elongated shaggy white cap and black spores"@en ;
	dc:source	pwn30:13006171-n .

<i105091>	a	<Concept> ;
	skos:definition	"large genus of agarics that have white spore and contain a white or milky juice when cut or broken; includes both edible and poisonous species"@en ;
	dc:source	pwn30:13006377-n .

<i105092>	a	<Concept> ;
	skos:definition	"edible mushroom"@en ;
	dc:source	pwn30:13006631-n .

<i105093>	a	<Concept> ;
	skos:definition	"chiefly small mushrooms with white spores"@en ;
	dc:source	pwn30:13006741-n .

<i105094>	a	<Concept> ;
	skos:definition	"mushroom that grows in a fairy ring"@en ;
	dc:source	pwn30:13006894-n .

<i105095>	a	<Concept> ;
	skos:definition	"a ring of fungi marking the periphery of the perennial underground growth of the mycelium"@en ;
	dc:source	pwn30:13007034-n .

<i105096>	a	<Concept> ;
	skos:definition	"agarics with white spores and caps having an eccentric stem; an important mushroom of Japan"@en ;
	dc:source	pwn30:13007195-n .

<i105097>	a	<Concept> ;
	skos:definition	"edible agaric with a soft greyish cap growing in shelving masses on dead wood"@en ;
	dc:source	pwn30:13007417-n .

<i105098>	a	<Concept> ;
	skos:definition	"red luminescent mushroom of Europe"@en ;
	dc:source	pwn30:13007629-n .

<i105099>	a	<Concept> ;
	skos:definition	"genus of gilled agarics of Europe and North America having brown spores and an annulus; grows on open ground or decaying wood"@en ;
	dc:source	pwn30:13007770-n .

<i105100>	a	<Concept> ;
	skos:definition	"a fungus with a smooth orange cap and yellow gills and pale yellow stalk"@en ;
	dc:source	pwn30:13008157-n .

<i105101>	a	<Concept> ;
	skos:definition	"a beautiful yellow gilled fungus found from Alaska south along the coast"@en ;
	dc:source	pwn30:13008315-n .

<i105102>	a	<Concept> ;
	skos:definition	"a large fungus with whitish scales on the cap and remnants of the veil hanging from the cap; the stalk is thick and hard"@en ;
	dc:source	pwn30:13008485-n .

<i105103>	a	<Concept> ;
	skos:definition	"a fungus with a yellow cap covered with fine scales as is the stalk"@en ;
	dc:source	pwn30:13008689-n .

<i105104>	a	<Concept> ;
	skos:definition	"a fungus that grows in clusters on the ground; cap is brownish orange with a surface that is smooth and slightly sticky; whitish gills and a cylindrical brown stalk"@en ;
	dc:source	pwn30:13008839-n .

<i105105>	a	<Concept> ;
	skos:definition	"one of the most important fungi cultivated in Japan"@en ;
	dc:source	pwn30:13009085-n .

<i105106>	a	<Concept> ;
	skos:definition	"a gilled fungus having yellow slimy caps with conspicuous tawny scales on the caps and stalks"@en ;
	dc:source	pwn30:13009244-n .

<i105107>	a	<Concept> ;
	skos:definition	"a gilled fungus with a cap and stalk that are conspicuously scaly with upright scales; gills develop a greenish tinge with age"@en ;
	dc:source	pwn30:13009429-n .

<i105108>	a	<Concept> ;
	skos:definition	"a pale buff fungus with tawny scales"@en ;
	dc:source	pwn30:13009656-n .

<i105109>	a	<Concept> ;
	skos:definition	"large genus of fungi with stout stems and white spores and neither annulus nor volva; brittle caps of red or purple or yellow or green or blue; differs from genus Lactarius in lacking milky juice"@en ;
	dc:source	pwn30:13009780-n .

<i105110>	a	<Concept> ;
	skos:definition	"used in some classification systems for the genus Russula"@en ;
	dc:source	pwn30:13010064-n .

<i105111>	a	<Concept> ;
	skos:definition	"sometimes included in family Agaricaceae"@en ;
	dc:source	pwn30:13010219-n .

<i105112>	a	<Concept> ;
	skos:definition	"genus of gill fungi with brown spores that is closely related to Agaricus; here placed in its own family Strophariaceae"@en ;
	dc:source	pwn30:13010401-n .

<i105113>	a	<Concept> ;
	skos:definition	"a gilled fungus with a long stalk and a yellow slimy cap from which fragments of the broken veil hang; gills are initially white but become dark brown as spores are released"@en ;
	dc:source	pwn30:13010694-n .

<i105114>	a	<Concept> ;
	skos:definition	"a gilled fungus with a large slimy purple or olive cap; gills become purple with age; the stalk is long and richly decorated with pieces of the white sheath that extends up to a ring"@en ;
	dc:source	pwn30:13010951-n .

<i105115>	a	<Concept> ;
	skos:definition	"a large gilled fungus with a broad cap and a long stalk; the cap is dark brown; the white gills turn dark purplish brown with age; edible and choice"@en ;
	dc:source	pwn30:13011221-n .

<i105116>	a	<Concept> ;
	skos:definition	"an organ shaped like a helmet; usually a vaulted and enlarged petal as in Aconitum"@en ;
	dc:source	pwn30:13011461-n .

<i105117>	a	<Concept> ;
	skos:definition	"a basidiomycete with gills"@en ;
	dc:source	pwn30:13011595-n .

<i105118>	a	<Concept> ;
	skos:definition	"any of the radiating leaflike spore-producing structures on the underside of the cap of a mushroom or similar fungus"@en ;
	dc:source	pwn30:13011679-n .

<i105119>	a	<Concept> ;
	skos:definition	"a family of fungi belonging to the order Agaricales"@en ;
	dc:source	pwn30:13011856-n .

<i105120>	a	<Concept> ;
	skos:definition	"agarics with pink spores but lacking both volva and annulus (includes some that are poisonous)"@en ;
	dc:source	pwn30:13012030-n .

<i105121>	a	<Concept> ;
	skos:definition	"a deadly poisonous agaric; a large cap that is first white (livid or lead-colored) and then turns yellowish or tan"@en ;
	dc:source	pwn30:13012253-n .

<i105122>	a	<Concept> ;
	skos:definition	"an agaric with a dark brown conical cap; fruits in early spring"@en ;
	dc:source	pwn30:13012469-n .

<i105123>	a	<Concept> ;
	skos:definition	"a family of fungi having free gills and a cap that is cleanly separable from the stalk"@en ;
	dc:source	pwn30:13012613-n .

<i105124>	a	<Concept> ;
	skos:definition	"a genus of fungus belonging to the family Lepiotaceae"@en ;
	dc:source	pwn30:13012835-n .

<i105125>	a	<Concept> ;
	skos:definition	"a poisonous agaric with a fibrillose cap and brown scales on a white ground color; cap can reach a diameter of 30 cm; often forms `fairy rings'"@en ;
	dc:source	pwn30:13012973-n .

<i105126>	a	<Concept> ;
	skos:definition	"agarics with white spores that includes several edible and poisonous mushrooms: parasol mushrooms"@en ;
	dc:source	pwn30:13013187-n .

<i105127>	a	<Concept> ;
	skos:definition	"any fungus of the genus Lepiota"@en ;
	dc:source	pwn30:13013534-n .

<i105128>	a	<Concept> ;
	skos:definition	"edible long-stalked mushroom with white flesh and gills and spores; found in open woodlands in autumn"@en ;
	dc:source	pwn30:13013764-n .

<i105129>	a	<Concept> ;
	skos:definition	"an agaric regarded as poisonous"@en ;
	dc:source	pwn30:13013965-n .

<i105130>	a	<Concept> ;
	skos:definition	"an agaric with greyish white fruiting body and gills that change from pink to dingy red"@en ;
	dc:source	pwn30:13014097-n .

<i105131>	a	<Concept> ;
	skos:definition	"an agaric with a large cap with brown scales and a thick stalk"@en ;
	dc:source	pwn30:13014265-n .

<i105132>	a	<Concept> ;
	skos:definition	"an agaric with a pallid cap and a stalk that is enlarged near the base"@en ;
	dc:source	pwn30:13014409-n .

<i105133>	a	<Concept> ;
