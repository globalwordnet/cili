	dc:source	pwn30:14641223-n .

<i113951>	a	<Concept> ;
	skos:definition	"a nonmetallic element belonging to the halogens; used especially in medicine and photography and in dyes; occurs naturally only in combination in small quantities (as in sea water or rocks)"@en ;
	dc:source	pwn30:14641397-n .

<i113952>	a	<Concept> ;
	skos:definition	"heavy radioactive isotope of iodine with a half-life of 8 days; used in a sodium salt to diagnose thyroid disease and to treat goiter"@en ;
	dc:source	pwn30:14641797-n .

<i113953>	a	<Concept> ;
	skos:definition	"light radioactive isotope of iodine with a half-life of 60 days; used as a tracer in thyroid studies and as a treatment for hyperthyroidism"@en ;
	dc:source	pwn30:14642005-n .

<i113954>	a	<Concept> ;
	skos:definition	"a heavy brittle metallic element of the platinum group; used in alloys; occurs in natural alloys with platinum or osmium"@en ;
	dc:source	pwn30:14642219-n .

<i113955>	a	<Concept> ;
	skos:definition	"a heavy ductile magnetic metallic element; is silver-white in pure form but readily rusts; used in construction and tools and armament; plays a role in the transport of oxygen by the blood"@en ;
	dc:source	pwn30:14642417-n .

<i113956>	a	<Concept> ;
	skos:definition	"a colorless element that is one of the six inert gasses; occurs in trace amounts in air"@en ;
	dc:source	pwn30:14642916-n .

<i113957>	a	<Concept> ;
	skos:definition	"a white soft metallic element that tarnishes readily; occurs in rare earth minerals and is usually classified as a rare earth"@en ;
	dc:source	pwn30:14643118-n .

<i113958>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element synthesized from californium"@en ;
	dc:source	pwn30:14643323-n .

<i113959>	a	<Concept> ;
	skos:definition	"a soft heavy toxic malleable metallic element; bluish white when freshly cut but tarnishes readily to dull grey"@en ;
	dc:source	pwn30:14643467-n .

<i113960>	a	<Concept> ;
	skos:definition	"a soft silver-white univalent element of the alkali metal group; the lightest metal known; occurs in several minerals"@en ;
	dc:source	pwn30:14643793-n .

<i113961>	a	<Concept> ;
	skos:definition	"a trivalent metallic element of the rare earth group; usually occurs in association with yttrium"@en ;
	dc:source	pwn30:14644063-n .

<i113962>	a	<Concept> ;
	skos:definition	"a light silver-white ductile bivalent metallic element; in pure form it burns with brilliant white flame; occurs naturally only in combination (as in magnesite and dolomite and carnallite and spinel and olivine)"@en ;
	dc:source	pwn30:14644249-n .

<i113963>	a	<Concept> ;
	skos:definition	"a hard brittle grey polyvalent metallic element that resembles iron but is not magnetic; used in making steel; occurs in many minerals"@en ;
	dc:source	pwn30:14644654-n .

<i113964>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element"@en ;
	dc:source	pwn30:14644963-n .

<i113965>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element synthesized by bombarding einsteinium with alpha particles (Md is the current symbol for mendelevium but Mv was formerly the symbol)"@en ;
	dc:source	pwn30:14645092-n .

<i113966>	a	<Concept> ;
	skos:definition	"a heavy silvery toxic univalent and bivalent metallic element; the only metal that is liquid at ordinary temperatures"@en ;
	dc:source	pwn30:14645346-n .

<i113967>	a	<Concept> ;
	skos:definition	"a polyvalent metallic element that resembles chromium and tungsten in its properties; used to strengthen and harden steel"@en ;
	dc:source	pwn30:14645661-n .

<i113968>	a	<Concept> ;
	skos:definition	"a yellow trivalent metallic element of the rare earth group; occurs in monazite and bastnasite in association with cerium and lanthanum and praseodymium"@en ;
	dc:source	pwn30:14645882-n .

<i113969>	a	<Concept> ;
	skos:definition	"a colorless odorless gaseous element that give a red glow in a vacuum tube; one of the six inert gasses; occurs in the air in small amounts"@en ;
	dc:source	pwn30:14646152-n .

<i113970>	a	<Concept> ;
	skos:definition	"a radioactive transuranic metallic element; found in trace amounts in uranium ores; a by-product of the production of plutonium"@en ;
	dc:source	pwn30:14646403-n .

<i113971>	a	<Concept> ;
	skos:definition	"a hard malleable ductile silvery metallic element that is resistant to corrosion; used in alloys; occurs in pentlandite and smaltite and garnierite and millerite"@en ;
	dc:source	pwn30:14646610-n .

<i113972>	a	<Concept> ;
	skos:definition	"a soft grey ductile metallic element used in alloys; occurs in niobite; formerly called columbium"@en ;
	dc:source	pwn30:14646942-n .

<i113973>	a	<Concept> ;
	skos:definition	"a former name for niobium"@en ;
	dc:source	pwn30:14647154-n .

<i113974>	a	<Concept> ;
	skos:definition	"a common nonmetallic element that is normally a colorless odorless tasteless inert diatomic gas; constitutes 78 percent of the atmosphere by volume; a constituent of all living tissues"@en ;
	dc:source	pwn30:14647235-n .

<i113975>	a	<Concept> ;
	skos:definition	"an obsolete name for nitrogen"@en ;
	dc:source	pwn30:14647623-n .

<i113976>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element synthesized by bombarding curium with carbon ions; 7 isotopes are known"@en ;
	dc:source	pwn30:14647722-n .

<i113977>	a	<Concept> ;
	skos:definition	"a hard brittle blue-grey or blue-black metallic element that is one of the platinum metals; the heaviest metal known"@en ;
	dc:source	pwn30:14647907-n .

<i113978>	a	<Concept> ;
	skos:definition	"a nonmetallic bivalent element that is normally a colorless odorless tasteless nonflammable diatomic gas; constitutes 21 percent of the atmosphere by volume; the most abundant element in the earth's crust"@en ;
	dc:source	pwn30:14648100-n .

<i113979>	a	<Concept> ;
	skos:definition	"a bluish translucent magnetic liquid obtained by compressing gaseous oxygen and then cooling it below its boiling point; used as an oxidizer in rocket propellants"@en ;
	dc:source	pwn30:14648526-n .

<i113980>	a	<Concept> ;
	skos:definition	"a silver-white metallic element of the platinum group that resembles platinum; occurs in some copper and nickel ores; does not tarnish at ordinary temperatures and is used (alloyed with gold) in jewelry"@en ;
	dc:source	pwn30:14648754-n .

<i113981>	a	<Concept> ;
	skos:definition	"a synthetic substance that is fluorescent or phosphorescent; used to coat the screens of cathode ray tubes"@en ;
	dc:source	pwn30:14649036-n .

<i113982>	a	<Concept> ;
	skos:definition	"a multivalent nonmetallic element of the nitrogen family that occurs commonly in inorganic phosphate rocks and as organic phosphates in all living cells; is highly reactive and occurs in several allotropic forms"@en ;
	dc:source	pwn30:14649197-n .

<i113983>	a	<Concept> ;
	skos:definition	"a heavy precious metallic element; grey-white and resistant to corroding; occurs in some nickel and copper ores and is also found native in some deposits"@en ;
	dc:source	pwn30:14649543-n .

<i113984>	a	<Concept> ;
	skos:definition	"a solid silvery grey radioactive transuranic element whose atoms can be split when bombarded with neutrons; found in minute quantities in uranium ores but is usually synthesized in nuclear reactors; 13 isotopes are known with the most important being plutonium 239"@en ;
	dc:source	pwn30:14649775-n .

<i113985>	a	<Concept> ;
	skos:definition	"a highly fissionable isotope of plutonium that is used in atomic weapons and as a reactor fuel; produced by irradiating uranium 238 with slow electrons"@en ;
	dc:source	pwn30:14650137-n .

<i113986>	a	<Concept> ;
	skos:definition	"plutonium 239 that is recovered when nuclear weapons are disassembled; it is stored in plutonium pits"@en ;
	dc:source	pwn30:14650366-n .

<i113987>	a	<Concept> ;
	skos:definition	"a radioactive metallic element that is similar to tellurium and bismuth; occurs in uranium ores but can be produced by bombarding bismuth with neutrons in a nuclear reactor"@en ;
	dc:source	pwn30:14650556-n .

<i113988>	a	<Concept> ;
	skos:definition	"a light soft silver-white metallic element of the alkali metal group; oxidizes rapidly in air and reacts violently with water; is abundant in nature in combined forms occurring in sea water and in carnallite and kainite and sylvite"@en ;
	dc:source	pwn30:14650807-n .

<i113989>	a	<Concept> ;
	skos:definition	"a soft yellowish-white trivalent metallic element of the rare earth group; can be recovered from bastnasite or monazite by an ion-exchange process"@en ;
	dc:source	pwn30:14651212-n .

<i113990>	a	<Concept> ;
	skos:definition	"a soft silvery metallic element of the rare earth group having no stable isotope; was discovered in radioactive form as a fission product of uranium"@en ;
	dc:source	pwn30:14651479-n .

<i113991>	a	<Concept> ;
	skos:definition	"a short-lived radioactive metallic element formed from uranium and disintegrating into actinium and then into lead"@en ;
	dc:source	pwn30:14651708-n .

<i113992>	a	<Concept> ;
	skos:definition	"an intensely radioactive metallic element that occurs in minute amounts in uranium ores"@en ;
	dc:source	pwn30:14651921-n .

<i113993>	a	<Concept> ;
	skos:definition	"a radioactive gaseous element formed by the disintegration of radium; the heaviest of the inert gasses; occurs naturally (especially in areas over granite) and is considered a hazard to health"@en ;
	dc:source	pwn30:14652104-n .

<i113994>	a	<Concept> ;
	skos:definition	"a rare heavy polyvalent metallic element that resembles manganese chemically and is used in some alloys; is obtained as a by-product in refining molybdenum"@en ;
	dc:source	pwn30:14652390-n .

<i113995>	a	<Concept> ;
	skos:definition	"a white hard metallic element that is one of the platinum group and is found in platinum ores; used in alloys with platinum"@en ;
	dc:source	pwn30:14652623-n .

<i113996>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element"@en ;
	dc:source	pwn30:14652824-n .

<i113997>	a	<Concept> ;
	skos:definition	"a soft silvery metallic element of the alkali metal group; burns in air and reacts violently in water; occurs in carnallite and lepidolite and pollucite"@en ;
	dc:source	pwn30:14652954-n .

<i113998>	a	<Concept> ;
	skos:definition	"a rare polyvalent metallic element of the platinum group; it is found associated with platinum"@en ;
	dc:source	pwn30:14653242-n .

<i113999>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element which has been synthesized"@en ;
	dc:source	pwn30:14653416-n .

<i114000>	a	<Concept> ;
	skos:definition	"a grey lustrous metallic element of the rare earth group; is used in special alloys; occurs in monazite and bastnasite"@en ;
	dc:source	pwn30:14653596-n .

<i114001>	a	<Concept> ;
	skos:definition	"a white trivalent metallic element; sometimes classified in the rare earth group; occurs in the Scandinavian mineral thortveitite"@en ;
	dc:source	pwn30:14653831-n .

<i114002>	a	<Concept> ;
	skos:definition	"a transuranic element"@en ;
	dc:source	pwn30:14654058-n .

<i114003>	a	<Concept> ;
	skos:definition	"a toxic nonmetallic element related to sulfur and tellurium; occurs in several allotropic forms; a stable grey metallike allotrope conducts electricity better in the light than in the dark and is used in photocells; occurs in sulfide ores (as pyrite)"@en ;
	dc:source	pwn30:14654175-n .

<i114004>	a	<Concept> ;
	skos:definition	"a tetravalent nonmetallic element; next to oxygen it is the most abundant element in the earth's crust; occurs in clay and feldspar and granite and quartz and sand; used as a semiconductor in transistors"@en ;
	dc:source	pwn30:14654541-n .

<i114005>	a	<Concept> ;
	skos:definition	"a soft white precious univalent metallic element having the highest electrical and thermal conductivity of any metal; occurs in argentite and in free form; used in coins and jewelry and tableware and photography"@en ;
	dc:source	pwn30:14654954-n .

<i114006>	a	<Concept> ;
	skos:definition	"a silvery soft waxy metallic element of the alkali metal group; occurs abundantly in natural compounds (especially in salt water); burns with a yellow flame and reacts violently in water; occurs in sea water and in the mineral halite (rock salt)"@en ;
	dc:source	pwn30:14655371-n .

<i114007>	a	<Concept> ;
	skos:definition	"a soft silver-white or yellowish metallic element of the alkali metal group; turns yellow in air; occurs in celestite and strontianite"@en ;
	dc:source	pwn30:14655731-n .

<i114008>	a	<Concept> ;
	skos:definition	"a radioactive isotope of strontium (with the mass number 90) that is present in the fallout from nuclear explosions; can be assimilated like calcium into bones"@en ;
	dc:source	pwn30:14656001-n .

<i114009>	a	<Concept> ;
	skos:definition	"an abundant tasteless odorless multivalent nonmetallic element; best known in yellow crystals; occurs in many sulphide and sulphate minerals and even in native form (especially in volcanic regions)"@en ;
	dc:source	pwn30:14656219-n .

<i114010>	a	<Concept> ;
	skos:definition	"a hard grey lustrous metallic element that is highly resistant to corrosion; occurs in niobite and fergusonite and tantalite"@en ;
	dc:source	pwn30:14656666-n .

<i114011>	a	<Concept> ;
	skos:definition	"a colorless crystalline substance obtained from the bile of mammals"@en ;
	dc:source	pwn30:14656926-n .

<i114012>	a	<Concept> ;
	skos:definition	"a crystalline metallic element not found in nature; occurs as one of the fission products of uranium"@en ;
	dc:source	pwn30:14657047-n .

<i114013>	a	<Concept> ;
	skos:definition	"a brittle silver-white metalloid element that is related to selenium and sulfur; it is used in alloys and as a semiconductor; occurs mainly as tellurides in ores of copper and nickel and silver and gold"@en ;
	dc:source	pwn30:14657228-n .

<i114014>	a	<Concept> ;
	skos:definition	"a metallic element of the rare earth group; used in lasers; occurs in apatite and monazite and xenotime and ytterbite"@en ;
	dc:source	pwn30:14657566-n .

<i114015>	a	<Concept> ;
	skos:definition	"a soft grey malleable metallic element that resembles tin but discolors on exposure to air; it is highly toxic and is used in rodent and insect poisons; occurs in zinc blende and some iron ores"@en ;
	dc:source	pwn30:14657818-n .

<i114016>	a	<Concept> ;
	skos:definition	"a soft silvery-white tetravalent radioactive metallic element; isotope 232 is used as a power source in nuclear reactors; occurs in thorite and in monazite sands"@en ;
	dc:source	pwn30:14658109-n .

<i114017>	a	<Concept> ;
	skos:definition	"radioactive isotope of thorium with mass number 228"@en ;
	dc:source	pwn30:14658422-n .

<i114018>	a	<Concept> ;
	skos:definition	"a soft silvery metallic element of the rare earth group; isotope 170 emits X-rays and is used in small portable X-ray machines; it occurs in monazite and apatite and xenotime"@en ;
	dc:source	pwn30:14658546-n .

<i114019>	a	<Concept> ;
	skos:definition	"a silvery malleable metallic element that resists corrosion; used in many alloys and to coat other metals to prevent corrosion; obtained chiefly from cassiterite where it occurs as tin oxide"@en ;
	dc:source	pwn30:14658855-n .

<i114020>	a	<Concept> ;
	skos:definition	"a light strong grey lustrous corrosion-resistant metallic element used in strong lightweight alloys (as for airplane parts); the main sources are rutile and ilmenite"@en ;
	dc:source	pwn30:14659211-n .

<i114021>	a	<Concept> ;
	skos:definition	"a heavy grey-white metallic element; the pure form is used mainly in electrical applications; it is found in several ores including wolframite and scheelite"@en ;
	dc:source	pwn30:14659512-n .

<i114022>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element"@en ;
	dc:source	pwn30:14659794-n .

<i114023>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element"@en ;
	dc:source	pwn30:14659922-n .

<i114024>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element"@en ;
	dc:source	pwn30:14660052-n .

<i114025>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element"@en ;
	dc:source	pwn30:14660183-n .

<i114026>	a	<Concept> ;
	skos:definition	"a radioactive transuranic element"@en ;
	dc:source	pwn30:14660314-n .

<i114027>	a	<Concept> ;
	skos:definition	"a heavy toxic silvery-white radioactive metallic element; occurs in many isotopes; used for nuclear fuels and nuclear weapons"@en ;
	dc:source	pwn30:14660443-n .

<i114028>	a	<Concept> ;
	skos:definition	"a uranium isotope with mass number 235; capable of sustaining chain reactions"@en ;
	dc:source	pwn30:14660700-n .

<i114029>	a	<Concept> ;
	skos:definition	"the commonest isotope of uranium; it is not fissionable but when irradiated with neutrons it produces fissionable plutonium 239"@en ;
	dc:source	pwn30:14660835-n .

<i114030>	a	<Concept> ;
	skos:definition	"a soft silvery white toxic metallic element used in steel alloys; it occurs in several complex minerals including carnotite and vanadinite"@en ;
	dc:source	pwn30:14661020-n .

<i114031>	a	<Concept> ;
	skos:definition	"a colorless odorless inert gaseous element occurring in the earth's atmosphere in trace amounts"@en ;
	dc:source	pwn30:14661274-n .

<i114032>	a	<Concept> ;
	skos:definition	"a soft silvery metallic element; a rare earth of the lanthanide series; it occurs in gadolinite and monazite and xenotime"@en ;
	dc:source	pwn30:14661482-n .

<i114033>	a	<Concept> ;
	skos:definition	"a silvery metallic element that is common in rare-earth minerals; used in magnesium and aluminum alloys"@en ;
	dc:source	pwn30:14661740-n .

<i114034>	a	<Concept> ;
	skos:definition	"a bluish-white lustrous metallic element; brittle at ordinary temperatures but malleable when heated; used in a wide variety of alloys and in galvanizing iron; it occurs naturally as zinc sulphide in zinc blende"@en ;
	dc:source	pwn30:14661977-n .

<i114035>	a	<Concept> ;
	skos:definition	"a lustrous grey strong metallic element resembling titanium; it is used in nuclear reactors as a neutron absorber; it occurs in baddeleyite but is obtained chiefly from zircon"@en ;
	dc:source	pwn30:14662281-n .

<i114036>	a	<Concept> ;
	skos:definition	"solid homogeneous inorganic substances occurring in nature having a definite chemical composition"@en ;
	dc:source	pwn30:14662574-n .

<i114037>	a	<Concept> ;
	skos:definition	"a waxy mineral that is a mixture of hydrocarbons and occurs in association with petroleum; some varieties are used in making ceresin and candles"@en ;
	dc:source	pwn30:14665102-n .

<i114038>	a	<Concept> ;
	skos:definition	"a compact fine-textured, usually white gypsum used for carving"@en ;
	dc:source	pwn30:14665351-n .

<i114039>	a	<Concept> ;
	skos:definition	"a hard compact kind of calcite"@en ;
	dc:source	pwn30:14665469-n .

<i114040>	a	<Concept> ;
	skos:definition	"a white or grey mineral consisting of lithium aluminum phosphate; a source of lithium"@en ;
	dc:source	pwn30:14665605-n .

<i114041>	a	<Concept> ;
	skos:definition	"a mineral or mineral variety belonging to the amphibole group"@en ;
	dc:source	pwn30:14665767-n .

<i114042>	a	<Concept> ;
	skos:definition	"a group of minerals with similar crystal structures containing a silicate chain and combinations of chiefly sodium and calcium and magnesium and iron and aluminum"@en ;
	dc:source	pwn30:14666012-n .

<i114043>	a	<Concept> ;
	skos:definition	"a metamorphic rock composed chiefly of amphibole and plagioclase"@en ;
	dc:source	pwn30:14666369-n .

<i114044>	a	<Concept> ;
	skos:definition	"a common complex mineral consisting of calcium fluoride phosphate or calcium chloride phosphate; a source of phosphorus"@en ;
	dc:source	pwn30:14666510-n .

<i114045>	a	<Concept> ;
	skos:definition	"a mineral form of crystalline calcium carbonate; dimorphic with calcite"@en ;
	dc:source	pwn30:14666758-n .

<i114046>	a	<Concept> ;
	skos:definition	"a valuable silver ore consisting of silver sulfide (Ag2S)"@en ;
	dc:source	pwn30:14666885-n .

<i114047>	a	<Concept> ;
	skos:definition	"a sedimentary rock differing from shale in being bound by silica and from slate in having no slate cleavages"@en ;
	dc:source	pwn30:14667017-n .

<i114048>	a	<Concept> ;
	skos:definition	"a rare steel-grey mineral consisting of silver and germanium and sulfur"@en ;
	dc:source	pwn30:14667181-n .

<i114049>	a	<Concept> ;
	skos:definition	"a silver-white or grey ore of arsenic"@en ;
	dc:source	pwn30:14667328-n .

<i114050>	a	<Concept> ;
	skos:definition	"a dark bituminous substance found in natural beds and as residue from petroleum distillation; consists mainly of hydrocarbons"@en ;
	dc:source	pwn30:14667455-n .

<i114051>	a	<Concept> ;
	skos:definition	"dark-green to black glassy mineral of the pyroxene group containing large amounts of aluminum and iron and magnesium"@en ;
	dc:source	pwn30:14667668-n .

<i114052>	a	<Concept> ;
	skos:definition	"blue carbonate of copper; blue malachite"@en ;
	dc:source	pwn30:14667855-n .

<i114053>	a	<Concept> ;
	skos:definition	"a mineral consisting of zirconium oxide"@en ;
	dc:source	pwn30:14667949-n .

<i114054>	a	<Concept> ;
	skos:definition	"a yellow-to-brown mineral that is a source of rare earth elements"@en ;
	dc:source	pwn30:14668065-n .

<i114055>	a	<Concept> ;
	skos:definition	"a clay-like mineral; the chief ore of aluminum; composed of aluminum oxides and aluminum hydroxides; used as an abrasive and catalyst"@en ;
	dc:source	pwn30:14668277-n .

<i114056>	a	<Concept> ;
	skos:definition	"the chief source of beryllium; colored transparent varieties are valued as gems"@en ;
	dc:source	pwn30:14668539-n .

<i114057>	a	<Concept> ;
	skos:definition	"dark brown to black mica found in igneous and metamorphic rock"@en ;
	dc:source	pwn30:14668743-n .

<i114058>	a	<Concept> ;
	skos:definition	"black substance containing char in the form of carbonized bone; used as a black pigment"@en ;
	dc:source	pwn30:14668895-n .

<i114059>	a	<Concept> ;
	skos:definition	"an ore of boron consisting of hydrated sodium borate; used as a flux or cleansing agent"@en ;
	dc:source	pwn30:14669084-n .

<i114060>	a	<Concept> ;
	skos:definition	"a mineral consisting of sulfides of copper and iron that is found in copper deposits"@en ;
	dc:source	pwn30:14669242-n .

<i114061>	a	<Concept> ;
	skos:definition	"a white or reddish mineral consisting of hydrous chlorides of potassium and magnesium; used as a fertilizer and as a source of potassium and magnesium"@en ;
	dc:source	pwn30:14669413-n .

<i114062>	a	<Concept> ;
	skos:definition	"a yellow radioactive mineral; an ore of uranium and radium and vanadium"@en ;
	dc:source	pwn30:14669677-n .

<i114063>	a	<Concept> ;
	skos:definition	"any of a group of proteases that mediate apoptosis"@en ;
	dc:source	pwn30:14669823-n .

<i114064>	a	<Concept> ;
	skos:definition	"a hard heavy dark mineral that is the chief source of tin"@en ;
	dc:source	pwn30:14669927-n .

<i114065>	a	<Concept> ;
	skos:definition	"a mineral consisting of strontium sulphate"@en ;
	dc:source	pwn30:14670061-n .

<i114066>	a	<Concept> ;
