	skos:definition	"uptime is 24 hours a day 7 days a week"@en ;
	dc:source	pwn30:15118011-n .

<i116644>	a	<Concept> ;
	skos:definition	"a period of time assigned for work"@en ;
	dc:source	pwn30:15118100-n .

<i116645>	a	<Concept> ;
	skos:definition	"a time period when you are required to work"@en ;
	dc:source	pwn30:15118228-n .

<i116646>	a	<Concept> ;
	skos:definition	"a time period when you are not required to work"@en ;
	dc:source	pwn30:15118453-n .

