<i110650>	a	<Concept> ;
	skos:definition	"a state of total unconsciousness resulting from anesthetic drugs (as for a major surgical operation)"@en ;
	dc:source	pwn30:14026981-n .

<i110651>	a	<Concept> ;
	skos:definition	"loss of sensation in a small area of the body (as when a local anesthetic is injected for a tooth extraction)"@en ;
	dc:source	pwn30:14027204-n .

<i110652>	a	<Concept> ;
	skos:definition	"anesthesia of an area supplied by a nerve; produced by an anesthetic agent applied to the nerve"@en ;
	dc:source	pwn30:14027396-n .

<i110653>	a	<Concept> ;
	skos:definition	"loss of sensation in a region of the body produced by application of an anesthetic agent to all the nerves supplying that region (as when an epidural anesthetic is administered to the pelvic region during childbirth)"@en ;
	dc:source	pwn30:14027674-n .

<i110654>	a	<Concept> ;
	skos:definition	"loss of sensation confined to the skin or mucous surfaces (as when benzocaine or Lidocaine is applied to the surface)"@en ;
	dc:source	pwn30:14028087-n .

<i110655>	a	<Concept> ;
	skos:definition	"loss of sensation in the extremities"@en ;
	dc:source	pwn30:14028291-n .

<i110656>	a	<Concept> ;
	skos:definition	"regional anesthesia resulting from injection of an anesthetic into the caudal end of the spinal canal; now largely replaced by epidural anesthesia"@en ;
	dc:source	pwn30:14028406-n .

<i110657>	a	<Concept> ;
	skos:definition	"regional anesthesia resulting from injection of an anesthetic into the epidural space of the spinal cord; sensation is lost in the abdominal and genital and pelvic areas; used in childbirth and gynecological surgery"@en ;
	dc:source	pwn30:14028652-n .

<i110658>	a	<Concept> ;
	skos:definition	"regional anesthesia resulting from the injection of a local anesthetic on each side of the cervix; used during labor and childbirth"@en ;
	dc:source	pwn30:14028967-n .

<i110659>	a	<Concept> ;
	skos:definition	"regional anesthesia resulting from the use of a local anesthetic to deaden the pudendal nerves in the region of the vulva and labia majora; used to ease discomfort during childbirth"@en ;
	dc:source	pwn30:14029163-n .

<i110660>	a	<Concept> ;
	skos:definition	"anesthesia of the lower half of the body; caused by injury to the spinal cord or by injecting an anesthetic beneath the arachnoid membrane that surrounds the spinal cord"@en ;
	dc:source	pwn30:14029405-n .

<i110661>	a	<Concept> ;
	skos:definition	"the parts of a patient's body that would touch a saddle if the patient were sitting in one are anesthetized by injecting a local anesthetic into the spinal cord"@en ;
	dc:source	pwn30:14029686-n .

<i110662>	a	<Concept> ;
	skos:definition	"general anesthesia achieved by administration of an inhalation anesthetic"@en ;
	dc:source	pwn30:14029943-n .

<i110663>	a	<Concept> ;
