	dc:source	pwn30:12031927-n .

<i100428>	a	<Concept> ;
	skos:definition	"coarse leafy perennial plants resembling sunflowers found especially in the western United States"@en ;
	dc:source	pwn30:12032215-n .

<i100429>	a	<Concept> ;
	skos:definition	"balsamic-resinous herb with clumps of lanceolate leaves and stout leafy stems ending in large deep yellow flowers on long stalks; northwestern United States"@en ;
	dc:source	pwn30:12032429-n .

<i100430>	a	<Concept> ;
	skos:definition	"herb with basal leaves and leafy hairy stems bearing solitary flower heads with white or pale cream-colored rays; northwestern United States"@en ;
	dc:source	pwn30:12032686-n .

<i100431>	a	<Concept> ;
	skos:definition	"coarse herbs having small heads of greenish flowers followed by burrs with hooked bristles"@en ;
	dc:source	pwn30:12032939-n .

<i100432>	a	<Concept> ;
	skos:definition	"any coarse weed of the genus Xanthium having spiny burrs"@en ;
	dc:source	pwn30:12033139-n .

<i100433>	a	<Concept> ;
	skos:definition	"genus of annual densely hairy herbs of Mediterranean to southwestern Asia"@en ;
	dc:source	pwn30:12033310-n .

<i100434>	a	<Concept> ;
	skos:definition	"any plant of the genus Xeranthemum native to southern Europe having chaffy or silvery flower heads with purplish tubular flowers"@en ;
	dc:source	pwn30:12033504-n .

<i100435>	a	<Concept> ;
	skos:definition	"mostly widely cultivated species of everlasting flowers having usually purple flowers; southern Europe to Iran; naturalized elsewhere"@en ;
	dc:source	pwn30:12033709-n .

<i100436>	a	<Concept> ;
	skos:definition	"genus of annual or perennial plants of tropical America having solitary heads of brightly colored flowers"@en ;
	dc:source	pwn30:12033939-n .

<i100437>	a	<Concept> ;
	skos:definition	"any of various plants of the genus Zinnia cultivated for their variously and brightly colored flower heads"@en ;
	dc:source	pwn30:12034141-n .

<i100438>	a	<Concept> ;
	skos:definition	"subshrub with slender woolly stems and long narrow leaves and flower heads with white rays; southern United States and northern Mexico"@en ;
	dc:source	pwn30:12034384-n .

<i100439>	a	<Concept> ;
	skos:definition	"subshrub having short leafy stems and numerous small flower heads with nearly round yellow-orange rays; Arizona south to Mexico and east to Kansas"@en ;
	dc:source	pwn30:12034594-n .

<i100440>	a	<Concept> ;
	skos:definition	"family of bristly hairy sometimes climbing plants; America and Africa and southern Arabia"@en ;
	dc:source	pwn30:12034828-n .

<i100441>	a	<Concept> ;
	skos:definition	"genus of tropical American prickly herbs or subshrubs"@en ;
	dc:source	pwn30:12035064-n .

<i100442>	a	<Concept> ;
	skos:definition	"any of various perennial South American plants of the genus Loasa having stinging hairs and showy white or yellow or reddish-orange flowers"@en ;
	dc:source	pwn30:12035213-n .

<i100443>	a	<Concept> ;
	skos:definition	"genus of bristly herbs or subshrubs of western America lacking stinging hairs"@en ;
	dc:source	pwn30:12035423-n .

<i100444>	a	<Concept> ;
	skos:definition	"biennial of southwestern United States having white stems and toothed leaves that is grown for its large pale yellow flowers that open in early morning"@en ;
	dc:source	pwn30:12035631-n .

<i100445>	a	<Concept> ;
	skos:definition	"annual grown especially for its fragrant golden nocturnal flowers"@en ;
	dc:source	pwn30:12035907-n .

<i100446>	a	<Concept> ;
	skos:definition	"small dry indehiscent fruit with the seed distinct from the fruit wall"@en ;
	dc:source	pwn30:12036067-n .

<i100447>	a	<Concept> ;
	skos:definition	"a winged often one-seed indehiscent fruit as of the ash or elm or maple"@en ;
	dc:source	pwn30:12036226-n .

<i100448>	a	<Concept> ;
	skos:definition	"seed vessel having hooks or prickles"@en ;
	dc:source	pwn30:12036368-n .

<i100449>	a	<Concept> ;
	skos:definition	"family of plants of the order Campanulales; in some classifications includes Lobeliaceae"@en ;
	dc:source	pwn30:12036533-n .

<i100450>	a	<Concept> ;
	skos:definition	"large genus of herbs grown for their blossoms: bellflowers"@en ;
	dc:source	pwn30:12036781-n .

<i100451>	a	<Concept> ;
	skos:definition	"any of various plants of the genus Campanula having blue or white bell-shaped flowers"@en ;
	dc:source	pwn30:12036939-n .

<i100452>	a	<Concept> ;
	skos:definition	"perennial of northern hemisphere with slender stems and bell-shaped blue flowers"@en ;
	dc:source	pwn30:12037328-n .

<i100453>	a	<Concept> ;
	skos:definition	"erect European herb with creeping rootstocks and nodding spikelike racemes of blue to violet flowers"@en ;
	dc:source	pwn30:12037499-n .

<i100454>	a	<Concept> ;
	skos:definition	"European biennial widely cultivated for its blue or violet or white flowers"@en ;
	dc:source	pwn30:12037691-n .

<i100455>	a	<Concept> ;
	skos:definition	"bellflower of southeastern United States (Maryland to Georgia) having pale blue flowers"@en ;
	dc:source	pwn30:12037864-n .

<i100456>	a	<Concept> ;
	skos:definition	"annual or perennial of eastern North America with long spikes of blue or white flowers"@en ;
	dc:source	pwn30:12038038-n .

<i100457>	a	<Concept> ;
	skos:definition	"bellflower common in marshes of eastern North America having lanceolate linear leaves and small whitish flowers"@en ;
	dc:source	pwn30:12038208-n .

<i100458>	a	<Concept> ;
	skos:definition	"bellflower of Europe to temperate Asia having dense spikes of violet-blue to white flowers"@en ;
	dc:source	pwn30:12038406-n .

<i100459>	a	<Concept> ;
	skos:definition	"perennial European bellflower with racemose white or blue flowers"@en ;
	dc:source	pwn30:12038585-n .

<i100460>	a	<Concept> ;
	skos:definition	"bellflower of southeastern Europe"@en ;
	dc:source	pwn30:12038760-n .

<i100461>	a	<Concept> ;
	skos:definition	"bellflower of Europe and Asia and North Africa having bluish flowers and an edible tuberous root used with the leaves in salad"@en ;
	dc:source	pwn30:12038898-n .

<i100462>	a	<Concept> ;
	skos:definition	"European bellflower with blue-purple to lilac flowers formerly used to treat sore throat"@en ;
	dc:source	pwn30:12039122-n .

<i100463>	a	<Concept> ;
	skos:definition	"European perennial bellflower that grows in clumps with spreading stems and blue or white flowers"@en ;
	dc:source	pwn30:12039317-n .

<i100464>	a	<Concept> ;
	skos:definition	"order of plants with irregular flowers having minute seeds: Orchidaceae; Burmanniaceae"@en ;
	dc:source	pwn30:12039524-n .

<i100465>	a	<Concept> ;
	skos:definition	"enormous cosmopolitan family of perennial terrestrial or epiphytic plants with fleshy tubers or rootstocks and unusual flowers"@en ;
	dc:source	pwn30:12039743-n .

<i100466>	a	<Concept> ;
	skos:definition	"any of numerous plants of the orchid family usually having flowers of unusual shapes and beautiful colors"@en ;
	dc:source	pwn30:12041446-n .

<i100467>	a	<Concept> ;
	skos:definition	"type genus of the orchid family; hardy terrestrial orchids of the temperate the northern hemisphere"@en ;
	dc:source	pwn30:12043248-n .

<i100468>	a	<Concept> ;
	skos:definition	"any of various deciduous terrestrial orchids having fleshy tubers and flowers in erect terminal racemes"@en ;
	dc:source	pwn30:12043444-n .

<i100469>	a	<Concept> ;
	skos:definition	"Eurasian orchid with showy pink or purple flowers in a loose spike"@en ;
	dc:source	pwn30:12043673-n .

<i100470>	a	<Concept> ;
	skos:definition	"Mediterranean orchid having usually purple flowers with a fan-shaped spotted or striped rose-red lip"@en ;
	dc:source	pwn30:12043836-n .

<i100471>	a	<Concept> ;
	skos:definition	"North American orchid having a spike of violet-purple flowers mixed with white; sepals and petals form a hood"@en ;
	dc:source	pwn30:12044041-n .

<i100472>	a	<Concept> ;
	skos:definition	"epiphytic orchids of tropical Asia having stiff leaves and fragrant white flowers in arching racemes"@en ;
	dc:source	pwn30:12044269-n .

<i100473>	a	<Concept> ;
	skos:definition	"any orchid of the genus Aerides"@en ;
	dc:source	pwn30:12044467-n .

<i100474>	a	<Concept> ;
	skos:definition	"genus of tropical Old World epiphytic orchids with showy flowers sometimes grotesque"@en ;
	dc:source	pwn30:12044571-n .

<i100475>	a	<Concept> ;
	skos:definition	"any of various spectacular orchids of the genus Angraecum having dark green leathery leaves and usually nocturnally scented white or ivory flowers"@en ;
	dc:source	pwn30:12044784-n .

<i100476>	a	<Concept> ;
	skos:definition	"genus of delicate Asiatic orchids"@en ;
	dc:source	pwn30:12045004-n .

<i100477>	a	<Concept> ;
	skos:definition	"any of several delicate Asiatic orchids grown especially for their velvety leaves with metallic white or gold veining"@en ;
	dc:source	pwn30:12045157-n .

<i100478>	a	<Concept> ;
	skos:definition	"a monocotyledonous genus of the family Orchidaceae"@en ;
	dc:source	pwn30:12045352-n .

<i100479>	a	<Concept> ;
	skos:definition	"North American orchid bearing a single leaf and yellowish-brown flowers"@en ;
	dc:source	pwn30:12045514-n .

<i100480>	a	<Concept> ;
	skos:definition	"genus of bog orchids of North America and Japan"@en ;
	dc:source	pwn30:12045695-n .

<i100481>	a	<Concept> ;
	skos:definition	"any of several bog orchids of the genus Arethusa having 1 or 2 showy flowers"@en ;
	dc:source	pwn30:12045860-n .

<i100482>	a	<Concept> ;
	skos:definition	"a bog orchid with usually a solitary fragrant magenta pink blossom with a wide gaping corolla; Canada"@en ;
	dc:source	pwn30:12046028-n .

<i100483>	a	<Concept> ;
	skos:definition	"genus of tropical American terrestrial orchids with large purple or pink flowers"@en ;
	dc:source	pwn30:12046251-n .

<i100484>	a	<Concept> ;
	skos:definition	"any of various orchids of the genus Bletia having pseudobulbs and erect leafless racemes of large purple or pink flowers"@en ;
	dc:source	pwn30:12046428-n .

<i100485>	a	<Concept> ;
	skos:definition	"small genus of chiefly east Asiatic hardy terrestrial orchids similar to genus Bletia"@en ;
	dc:source	pwn30:12046620-n .

<i100486>	a	<Concept> ;
	skos:definition	"Japanese orchid with white-striped leaves and slender erect racemes of rose to magenta flowers; often cultivated; sometimes placed in genus Bletia"@en ;
	dc:source	pwn30:12046815-n .

<i100487>	a	<Concept> ;
	skos:definition	"a solid bulblike enlargement of the stem of some orchids"@en ;
	dc:source	pwn30:12047060-n .

<i100488>	a	<Concept> ;
	skos:definition	"genus of tropical American epiphytic or lithophytic rhizomatous orchids"@en ;
	dc:source	pwn30:12047173-n .

<i100489>	a	<Concept> ;
	skos:definition	"any of various tropical American orchids with usually solitary fleshy leaves and showy white to green nocturnally fragrant blossoms solitary or in racemes of up to 7"@en ;
	dc:source	pwn30:12047345-n .

<i100490>	a	<Concept> ;
	skos:definition	"genus of tropical American epiphytic orchids having striking axillary racemes of yellow to green spiderlike flowers with long slender sepals and warty lips: spider orchids"@en ;
	dc:source	pwn30:12047586-n .

<i100491>	a	<Concept> ;
	skos:definition	"South American orchid with spiderlike pale-yellow to pale-green flowers"@en ;
	dc:source	pwn30:12047884-n .

<i100492>	a	<Concept> ;
	skos:definition	"Central American orchid having spiderlike flowers with prominent green warts"@en ;
	dc:source	pwn30:12048056-n .

<i100493>	a	<Concept> ;
	skos:definition	"terrestrial orchids of Australia to New Caledonia"@en ;
	dc:source	pwn30:12048231-n .

<i100494>	a	<Concept> ;
	skos:definition	"any of various orchids of the genus Caladenia"@en ;
	dc:source	pwn30:12048399-n .

<i100495>	a	<Concept> ;
	skos:definition	"orchid with reddish linear leaves and panicle of purple-marked pale-yellow flowers with deep red or purple lip; southwestern Australia"@en ;
	dc:source	pwn30:12048537-n .

<i100496>	a	<Concept> ;
	skos:definition	"large and widely distributed genus of terrestrial orchids"@en ;
	dc:source	pwn30:12048772-n .

<i100497>	a	<Concept> ;
	skos:definition	"any of various showy orchids of the genus Calanthe having white or yellow or rose-colored flowers and broad leaves folded lengthwise"@en ;
	dc:source	pwn30:12048928-n .

<i100498>	a	<Concept> ;
	skos:definition	"terrestrial orchids of North America"@en ;
	dc:source	pwn30:12049134-n .

<i100499>	a	<Concept> ;
	skos:definition	"an orchid"@en ;
	dc:source	pwn30:12049282-n .

<i100500>	a	<Concept> ;
	skos:definition	"one species found throughout much of northern North America and Eurasia"@en ;
	dc:source	pwn30:12049412-n .

<i100501>	a	<Concept> ;
	skos:definition	"rare north temperate bog orchid bearing a solitary white to pink flower marked with purple at the tip of an erect reddish stalk above 1 basal leaf"@en ;
	dc:source	pwn30:12049562-n .

<i100502>	a	<Concept> ;
	skos:definition	"genus of tropical American orchids having showy male and female flowers usually on separate inflorescences"@en ;
	dc:source	pwn30:12049796-n .

<i100503>	a	<Concept> ;
	skos:definition	"orchid having both male and female flowers in the same raceme; when a sensitive projection at the base of the column of the male flower is touched the pollen is suddenly ejected"@en ;
	dc:source	pwn30:12050014-n .

<i100504>	a	<Concept> ;
	skos:definition	"large and highly valued genus of beautiful tropical American epiphytic or lithophytic orchids; the typical orchids; known in many varieties"@en ;
	dc:source	pwn30:12050295-n .

<i100505>	a	<Concept> ;
	skos:definition	"any orchid of the genus Cattleya characterized by a three-lobed lip enclosing the column; among the most popular and most extravagantly beautiful orchids known"@en ;
	dc:source	pwn30:12050533-n .

<i100506>	a	<Concept> ;
	skos:definition	"small genus of temperate Old World terrestrial orchids"@en ;
	dc:source	pwn30:12050766-n .

<i100507>	a	<Concept> ;
	skos:definition	"any of several orchids of the genus Cephalanthera"@en ;
	dc:source	pwn30:12050959-n .

<i100508>	a	<Concept> ;
	skos:definition	"orchid of Mediterranean and Asia having a lax spike of bright rose-pink flowers"@en ;
	dc:source	pwn30:12051103-n .

<i100509>	a	<Concept> ;
	skos:definition	"terrestrial orchids of North and South America having slender fibrous roots; allied to genus Pogonia"@en ;
	dc:source	pwn30:12051285-n .

<i100510>	a	<Concept> ;
	skos:definition	"orchid of northeastern United States with magenta-pink flowers having funnel-shaped lip; sometimes placed in genus Pogonia"@en ;
	dc:source	pwn30:12051514-n .

<i100511>	a	<Concept> ;
	skos:definition	"orchid of central and northern South America having 1- to 3-blossomed racemes of large showy rose-colored flowers; sometimes placed in genus Pogonia"@en ;
	dc:source	pwn30:12051792-n .

<i100512>	a	<Concept> ;
	skos:definition	"terrestrial orchids of cooler parts of North America and Europe: satyr orchid"@en ;
	dc:source	pwn30:12052053-n .

<i100513>	a	<Concept> ;
	skos:definition	"orchid with broad ovate leaves and long-bracted green very irregular flowers"@en ;
	dc:source	pwn30:12052267-n .

<i100514>	a	<Concept> ;
	skos:definition	"orchid having hooded long-bracted green to yellow-green flowers suffused with purple"@en ;
	dc:source	pwn30:12052447-n .

<i100515>	a	<Concept> ;
	skos:definition	"large diverse genus of tropical Asiatic epiphytic orchids"@en ;
	dc:source	pwn30:12052630-n .

<i100516>	a	<Concept> ;
	skos:definition	"any of various orchids of the genus Coelogyne with: clusters of fragrant lacy snow-white flowers; salmon-pink solitary flowers; chainlike racemes of topaz and chocolate brown flowers; spikes of delicate white spice-scented flowers; emerald green flowers marked with blue-black"@en ;
	dc:source	pwn30:12052787-n .

<i100517>	a	<Concept> ;
	skos:definition	"genus of leafless root-parasitic orchids having small purplish or yellowish racemose flowers with lobed lips; widely distributed in temperate regions"@en ;
	dc:source	pwn30:12053138-n .

<i100518>	a	<Concept> ;
	skos:definition	"a wildflower of the genus Corallorhiza growing from a hard mass of rhizomes associated with a fungus that aids in absorbing nutrients from the forest floor"@en ;
	dc:source	pwn30:12053405-n .

<i100519>	a	<Concept> ;
	skos:definition	"common coral root having yellowish- or reddish- or purplish-brown leafless stems bearing loose racemes of similarly colored flowers with white purple-spotted lips; Guatemala to Canada"@en ;
	dc:source	pwn30:12053690-n .

<i100520>	a	<Concept> ;
	skos:definition	"nearly leafless wildflower with erect reddish-purple stems bearing racemes of pale pinkish and brownish-striped flowers; western Canada to Mexico"@en ;
	dc:source	pwn30:12053962-n .

<i100521>	a	<Concept> ;
	skos:definition	"plant having clumps of nearly leafless pale yellowish to greenish stems bearing similarly colored flowers with white lower lips; northern New Mexico north through South Dakota and Washington to Alaska"@en ;
	dc:source	pwn30:12054195-n .

<i100522>	a	<Concept> ;
	skos:definition	"small genus of tropical American epiphytic or lithophytic orchids"@en ;
	dc:source	pwn30:12054499-n .

<i100523>	a	<Concept> ;
	skos:definition	"any of several orchids of the genus Coryanthes having racemes of a few musky-scented waxy flowers with a helmet-shaped lip process"@en ;
	dc:source	pwn30:12054678-n .

<i100524>	a	<Concept> ;
	skos:definition	"genus of epiphytic or terrestrial tropical American orchids"@en ;
	dc:source	pwn30:12054902-n .

<i100525>	a	<Concept> ;
	skos:definition	"any of several orchids of the genus Cycnoches having slender arching columns of flowers suggesting the neck of a swan"@en ;
	dc:source	pwn30:12055073-n .

<i100526>	a	<Concept> ;
	skos:definition	"genus of tropical epiphytic or terrestrial Old World orchids; one of the most popular orchid genera"@en ;
	dc:source	pwn30:12055317-n .

<i100527>	a	<Concept> ;
	skos:definition	"any of various plants of the genus Cymbidium having narrow leaves and a long drooping cluster of numerous showy and variously colored boat-shaped flowers; extensively hybridized and cultivated as houseplants and important florists' flowers"@en ;
	dc:source	pwn30:12055516-n .

<i100528>	a	<Concept> ;
	skos:definition	"genus of chiefly American perennial leafy-stemmed orchids: lady's slippers; sometimes includes species of genus Paphiopedilum"@en ;
	dc:source	pwn30:12055839-n .

<i100529>	a	<Concept> ;
	skos:definition	"a plant or flower of the genus Cypripedium"@en ;
	dc:source	pwn30:12056099-n .

<i100530>	a	<Concept> ;
	skos:definition	"any of several chiefly American wildflowers having an inflated pouchlike lip; difficult or impossible to cultivate in the garden"@en ;
	dc:source	pwn30:12056217-n .

<i100531>	a	<Concept> ;
	skos:definition	"once common rose pink woodland orchid of eastern North America"@en ;
	dc:source	pwn30:12056601-n .

<i100532>	a	<Concept> ;
	skos:definition	"pale pink wild orchid of northeastern America having an inflated pouchlike lip"@en ;
	dc:source	pwn30:12056758-n .

<i100533>	a	<Concept> ;
	skos:definition	"orchid of northern North America having a brownish-green flower and red-and-white lip suggestive of a ram's head"@en ;
	dc:source	pwn30:12056990-n .

<i100534>	a	<Concept> ;
	skos:definition	"maroon to purple-brown orchid with yellow lip; Europe, North America and Japan"@en ;
	dc:source	pwn30:12057211-n .

<i100535>	a	<Concept> ;
	skos:definition	"plant of eastern and central North America having slightly fragrant purple-marked greenish-yellow flowers"@en ;
	dc:source	pwn30:12057447-n .

<i100536>	a	<Concept> ;
	skos:definition	"often having many yellow-green orchids with white pouches growing along streams and seeps of southwestern Oregon and northern California"@en ;
	dc:source	pwn30:12057660-n .

<i100537>	a	<Concept> ;
	skos:definition	"clusters of several short stems each having 2 broad leaves and 2-4 drooping brownish to greenish flowers with pouches mottled with purple; British Columbia to central California and northern Colorado"@en ;
	dc:source	pwn30:12057895-n .

<i100538>	a	<Concept> ;
	skos:definition	"leafy plant having a few stems in a clump with 1 white and dull purple flower in each upper leaf axil; Alaska to northern California and Wyoming"@en ;
	dc:source	pwn30:12058192-n .

<i100539>	a	<Concept> ;
	skos:definition	"genus of terrestrial orchids of Europe and Asia and North Africa"@en ;
	dc:source	pwn30:12058429-n .

<i100540>	a	<Concept> ;
	skos:definition	"any of several orchids of the genus Dactylorhiza having fingerlike tuberous roots; Europe and Mediterranean region"@en ;
	dc:source	pwn30:12058630-n .

<i100541>	a	<Concept> ;
	skos:definition	"European orchid having lanceolate leaves spotted purple and pink to white or mauve flowers spotted or lined deep red or purple"@en ;
	dc:source	pwn30:12058822-n .

<i100542>	a	<Concept> ;
	skos:definition	"large genus and variable genus of chiefly epiphytic or lithophytic orchids of tropical and subtropical Asia and Australasia"@en ;
	dc:source	pwn30:12059090-n .

<i100543>	a	<Concept> ;
	skos:definition	"a plant of the genus Dendrobium having stems like cane and usually showy racemose flowers"@en ;
	dc:source	pwn30:12059314-n .

<i100544>	a	<Concept> ;
	skos:definition	"genus of showy tropical African terrestrial orchids"@en ;
	dc:source	pwn30:12059479-n .

<i100545>	a	<Concept> ;
	skos:definition	"any orchid of the genus Disa; beautiful orchids with dark green leaves and usually hooded flowers; much prized as emblematic flowers in their native regions"@en ;
	dc:source	pwn30:12059625-n .

<i100546>	a	<Concept> ;
	skos:definition	"comprises tropical American species usually placed in genus Masdevallia: diminutive plants having bizarre and often sinister-looking flowers with pendulous scapes and motile lips"@en ;
	dc:source	pwn30:12059851-n .

<i100547>	a	<Concept> ;
	skos:definition	"comprises tropical American species usually placed in genus Masdevallia: very dwarf plants having short tufted and usually unifoliate stems with usually solitary flowers"@en ;
	dc:source	pwn30:12060118-n .

<i100548>	a	<Concept> ;
	skos:definition	"a monocotyledonous genus of the family Orchidaceae"@en ;
	dc:source	pwn30:12060380-n .

<i100549>	a	<Concept> ;
	skos:definition	"waxy white nearly leafless plant with stems in clusters and racemes of white flowers; northwestern United States to northern California and east to Idaho"@en ;
	dc:source	pwn30:12060546-n .

<i100550>	a	<Concept> ;
	skos:definition	"large genus of epiphytic and lithophytic orchids of tropical and subtropical Americas and West Indies; formerly included in genus Epidendrum"@en ;
	dc:source	pwn30:12060816-n .

<i100551>	a	<Concept> ;
