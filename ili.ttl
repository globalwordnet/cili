	skos:definition	"(anatomy) a long narrow slit or groove that divides an organ into lobes"@en ;
	dc:source	pwn30:05223370-n .

<i64410>	a	<Concept> ;
	skos:definition	"(anatomy) any of the narrow grooves in an organ or tissue especially those that mark the convolutions on the surface of the brain"@en ;
	dc:source	pwn30:05223550-n .

<i64411>	a	<Concept> ;
	skos:definition	"a brain fissure extending upward on the lateral surface of both hemispheres; separates the frontal and parietal lobes"@en ;
	dc:source	pwn30:05223823-n .

<i64412>	a	<Concept> ;
	skos:definition	"the deepest and most prominent of the cortical fissures; separates the frontal lobes and temporal lobes in both hemispheres"@en ;
	dc:source	pwn30:05224080-n .

<i64413>	a	<Concept> ;
	skos:definition	"a sulcus near the posterior end of each hemisphere that separates the parietal lobes and the occipital lobes in both hemispheres"@en ;
	dc:source	pwn30:05224358-n .

<i64414>	a	<Concept> ;
	skos:definition	"a sulcus in the mesial surface of the occipital lobe of the cerebrum"@en ;
	dc:source	pwn30:05224585-n .

<i64415>	a	<Concept> ;
	skos:definition	"(anatomy) a depression or fissure where vessels or nerves or ducts enter a bodily organ"@en ;
	dc:source	pwn30:05224755-n .

<i64416>	a	<Concept> ;
	skos:definition	"any area of the body especially sensitive to sexual stimulation"@en ;
	dc:source	pwn30:05224966-n .

<i64417>	a	<Concept> ;
	skos:definition	"any body part visible externally"@en ;
	dc:source	pwn30:05225090-n .

<i64418>	a	<Concept> ;
	skos:definition	"any of the segments in the body of a jointed animal like an arthropod"@en ;
	dc:source	pwn30:05225439-n .

<i64419>	a	<Concept> ;
	skos:definition	"a particular complex anatomical part of a living thing"@en ;
	dc:source	pwn30:05225602-n .

<i64420>	a	<Concept> ;
	skos:definition	"a passage in the uterus and vagina through which a fetus passes during vaginal birth"@en ;
	dc:source	pwn30:05226937-n .

<i64421>	a	<Concept> ;
	skos:definition	"a rounded dilation or expansion in a canal or vessel or organ"@en ;
	dc:source	pwn30:05227079-n .

<i64422>	a	<Concept> ;
	skos:definition	"any of various keel-shaped structures or ridges such as that on the breastbone of a bird or that formed by the fused petals of a pea blossom"@en ;
	dc:source	pwn30:05227209-n .

<i64423>	a	<Concept> ;
	skos:definition	"ridge on the lower surface of the fornix of the brain"@en ;
	dc:source	pwn30:05227438-n .

<i64424>	a	<Concept> ;
	skos:definition	"an arched bundle of white fibers at the base of the brain by which the hippocampus of each hemisphere projects to the contralateral hippocampus and to the thalamus and mamillary bodies"@en ;
	dc:source	pwn30:05227572-n .

<i64425>	a	<Concept> ;
	skos:definition	"generally any arch shaped structure (but often it refers to the arched roof of an anatomical space)"@en ;
	dc:source	pwn30:05227868-n .

<i64426>	a	<Concept> ;
	skos:definition	"one of two small round structures on the undersurface of the brain that form the terminals of the anterior arches of the fornix"@en ;
	dc:source	pwn30:05228020-n .

<i64427>	a	<Concept> ;
	skos:definition	"any taillike structure"@en ;
	dc:source	pwn30:05228264-n .

<i64428>	a	<Concept> ;
	skos:definition	"the median ridge on the breastbone of birds that fly"@en ;
	dc:source	pwn30:05228374-n .

<i64429>	a	<Concept> ;
	skos:definition	"an intersection or crossing of two tracts in the form of the letter X"@en ;
	dc:source	pwn30:05228496-n .

<i64430>	a	<Concept> ;
	skos:definition	"(anatomy) an encircling structure (as the ridge around the base of a tooth)"@en ;
	dc:source	pwn30:05228732-n .

<i64431>	a	<Concept> ;
	skos:definition	"the crossing of the optic nerves from the two eyes at the base of the brain"@en ;
	dc:source	pwn30:05228881-n .

<i64432>	a	<Concept> ;
	skos:definition	"a nerve pathway from the lateral geniculate body to the visual cortex"@en ;
	dc:source	pwn30:05229049-n .

<i64433>	a	<Concept> ;
	skos:definition	"(anatomy) a structure that resembles a shell in shape"@en ;
	dc:source	pwn30:05229198-n .

<i64434>	a	<Concept> ;
	skos:definition	"one of several turbinate bones in the nasal cavity"@en ;
	dc:source	pwn30:05229341-n .

<i64435>	a	<Concept> ;
	skos:definition	"a threadlike structure (as a chainlike series of cells)"@en ;
	dc:source	pwn30:05229468-n .

<i64436>	a	<Concept> ;
	skos:definition	"any of several elongated, threadlike cells (especially a muscle fiber or a nerve fiber)"@en ;
	dc:source	pwn30:05229622-n .

<i64437>	a	<Concept> ;
	skos:definition	"a small apparently simple structure (as a fertilized egg) from which new tissue can develop into a complete organism"@en ;
	dc:source	pwn30:05229805-n .

<i64438>	a	<Concept> ;
	skos:definition	"any of various funnel-shaped parts of the body (but especially the hypophyseal stalk)"@en ;
	dc:source	pwn30:05229990-n .

<i64439>	a	<Concept> ;
	skos:definition	"a small structural space between tissues or parts of an organ"@en ;
	dc:source	pwn30:05230171-n .

<i64440>	a	<Concept> ;
	skos:definition	"an anatomical structure used as a point of origin in locating other anatomical structures (as in surgery) or as point from which measurements can be taken"@en ;
	dc:source	pwn30:05230357-n .

<i64441>	a	<Concept> ;
	skos:definition	"a landmark on the skull from which craniometric measurements can be taken"@en ;
	dc:source	pwn30:05230603-n .

<i64442>	a	<Concept> ;
	skos:definition	"the craniometric point at the anterior extremity of the intermaxillary suture"@en ;
	dc:source	pwn30:05231264-n .

<i64443>	a	<Concept> ;
	skos:definition	"the craniometric point at the junction of the lamboid suture and the occipitomastoid suture and the parietomastoid suture"@en ;
	dc:source	pwn30:05231397-n .

<i64444>	a	<Concept> ;
	skos:definition	"the craniometric point at the center of the opening of the external acoustic meatus"@en ;
	dc:source	pwn30:05231592-n .

<i64445>	a	<Concept> ;
	skos:definition	"the craniometric point at the junction of the sagittal and coronal sutures at the top of the cranium"@en ;
	dc:source	pwn30:05231769-n .

<i64446>	a	<Concept> ;
	skos:definition	"the craniometric point at the tip of the mandibular condyle"@en ;
	dc:source	pwn30:05231940-n .

<i64447>	a	<Concept> ;
	skos:definition	"the craniometric point at the tip of the coronoid process of the mandible"@en ;
	dc:source	pwn30:05232074-n .

<i64448>	a	<Concept> ;
	skos:definition	"the tip of the greater wing of the sphenoid bone"@en ;
	dc:source	pwn30:05232221-n .

<i64449>	a	<Concept> ;
	skos:definition	"the craniometric point at the junction of the anterior border of the lacrimal bone with the frontal bone"@en ;
	dc:source	pwn30:05232345-n .

<i64450>	a	<Concept> ;
	skos:definition	"the craniometric point at the tip of the angular part of the parietal bone that articulates with the temporal bone"@en ;
	dc:source	pwn30:05232503-n .

<i64451>	a	<Concept> ;
	skos:definition	"a smooth prominence of the frontal bone between and above the eyebrows; the most forward projecting point of the forehead in the midline at the level of the supraorbital ridges"@en ;
	dc:source	pwn30:05232691-n .

<i64452>	a	<Concept> ;
	skos:definition	"the most inferior point of the mandible in the midline"@en ;
	dc:source	pwn30:05232972-n .

<i64453>	a	<Concept> ;
	skos:definition	"the craniometric point on either side at the apex of the lower jaw"@en ;
	dc:source	pwn30:05233100-n .

<i64454>	a	<Concept> ;
	skos:definition	"the craniometric point that is the most prominent point at the back of the head (at the occipital protuberance)"@en ;
	dc:source	pwn30:05233238-n .

<i64455>	a	<Concept> ;
	skos:definition	"the craniometric point at the union of the frontal and temporal processes of the zygomatic bone"@en ;
	dc:source	pwn30:05233420-n .

<i64456>	a	<Concept> ;
	skos:definition	"the craniometric point at the junction of the sagittal and lamboid sutures of the skull"@en ;
	dc:source	pwn30:05233601-n .

<i64457>	a	<Concept> ;
	skos:definition	"small indentation in the middle of the lower jawbone"@en ;
	dc:source	pwn30:05233741-n .

<i64458>	a	<Concept> ;
	skos:definition	"the craniometric point at the lowest point of the mastoid process"@en ;
	dc:source	pwn30:05233875-n .

<i64459>	a	<Concept> ;
	skos:definition	"the craniometric point midway between the frontal eminences of the skull"@en ;
	dc:source	pwn30:05234016-n .

<i64460>	a	<Concept> ;
	skos:definition	"the craniometric point at the bridge of the nose where the frontal and nasal bones of the skull meet"@en ;
	dc:source	pwn30:05234162-n .

<i64461>	a	<Concept> ;
	skos:definition	"the craniometric point on the sagittal suture near the lamboid suture"@en ;
	dc:source	pwn30:05234315-n .

<i64462>	a	<Concept> ;
	skos:definition	"the craniometric point in the midline of the forehead immediately above the orbits"@en ;
	dc:source	pwn30:05234438-n .

<i64463>	a	<Concept> ;
	skos:definition	"the craniometric point at the lowest point on the lower edge of the orbit"@en ;
	dc:source	pwn30:05234593-n .

<i64464>	a	<Concept> ;
	skos:definition	"the craniometric point that is the most forward-projecting point on the anterior surface of the chin"@en ;
	dc:source	pwn30:05234737-n .

<i64465>	a	<Concept> ;
	skos:definition	"craniometric point that is the most anterior point in the midline on the alveolar process of the maxilla"@en ;
	dc:source	pwn30:05234911-n .

<i64466>	a	<Concept> ;
	skos:definition	"the craniometric point in the region of the sphenoid fontanelle"@en ;
	dc:source	pwn30:05235100-n .

<i64467>	a	<Concept> ;
	skos:definition	"the anterior tip at the end of the suture of the nasal bones"@en ;
	dc:source	pwn30:05235217-n .

<i64468>	a	<Concept> ;
	skos:definition	"the anterior tip of the parietal bone"@en ;
	dc:source	pwn30:05235350-n .

<i64469>	a	<Concept> ;
	skos:definition	"the craniometric point on the coronal suture above the acoustic meatus"@en ;
	dc:source	pwn30:05235461-n .

<i64470>	a	<Concept> ;
	skos:definition	"the most forward point of the alveolar process of the mandible"@en ;
	dc:source	pwn30:05235607-n .

<i64471>	a	<Concept> ;
	skos:definition	"a border or edge of any of various body parts distinguished by color or structure"@en ;
	dc:source	pwn30:05235745-n .

<i64472>	a	<Concept> ;
	skos:definition	"a riblike supporting or strengthening part of an animal or plant"@en ;
	dc:source	pwn30:05235879-n .

<i64473>	a	<Concept> ;
	skos:definition	"a broad flat body part (as of the shoulder or tongue)"@en ;
	dc:source	pwn30:05236029-n .

<i64474>	a	<Concept> ;
	skos:definition	"(anatomy) a small structure resembling a rootlet (such as a fibril of a nerve)"@en ;
	dc:source	pwn30:05236152-n .

<i64475>	a	<Concept> ;
	skos:definition	"a network of intersecting blood vessels or intersecting nerves or intersecting lymph vessels"@en ;
	dc:source	pwn30:05236322-n .

<i64476>	a	<Concept> ;
	skos:definition	"a plexus of lymph nodes in the lower portion of the abdominal aorta"@en ;
	dc:source	pwn30:05236582-n .

<i64477>	a	<Concept> ;
	skos:definition	"a plexus of sympathetic and parasympathetic nerve fibers"@en ;
	dc:source	pwn30:05236709-n .

<i64478>	a	<Concept> ;
	skos:definition	"a network of intersecting nerves"@en ;
	dc:source	pwn30:05236848-n .

<i64479>	a	<Concept> ;
	skos:definition	"a group of physiologically or anatomically related organs or parts"@en ;
	dc:source	pwn30:05237227-n .

<i64480>	a	<Concept> ;
	skos:definition	"any covering for the body or a body part"@en ;
	dc:source	pwn30:05237755-n .

<i64481>	a	<Concept> ;
	skos:definition	"an enveloping structure or covering enclosing an animal or plant organ or part"@en ;
	dc:source	pwn30:05238036-n .

<i64482>	a	<Concept> ;
	skos:definition	"a natural protective body covering and site of the sense of touch"@en ;
	dc:source	pwn30:05238282-n .

<i64483>	a	<Concept> ;
	skos:definition	"an area on the skin that is highly sensitive to pressure"@en ;
	dc:source	pwn30:05239039-n .

<i64484>	a	<Concept> ;
	skos:definition	"an outer protective covering such as the skin of an animal or a cuticle or seed coat or rind or shell"@en ;
	dc:source	pwn30:05239243-n .

<i64485>	a	<Concept> ;
	skos:definition	"a piece of skin taken from a donor area and surgically grafted at the site of an injury or burn"@en ;
	dc:source	pwn30:05239437-n .

<i64486>	a	<Concept> ;
	skos:definition	"bare skin; naked"@en ;
	dc:source	pwn30:05239589-n .

<i64487>	a	<Concept> ;
	skos:definition	"a hanging fold of loose skin on an elderly person's neck"@en ;
	dc:source	pwn30:05239680-n .

<i64488>	a	<Concept> ;
	skos:definition	"membranous tissue covering internal organs and other internal surfaces of the body"@en ;
	dc:source	pwn30:05239808-n .

<i64489>	a	<Concept> ;
	skos:definition	"cast-off skins or coverings of various organisms during ecdysis"@en ;
	dc:source	pwn30:05240076-n .

<i64490>	a	<Concept> ;
	skos:definition	"the outer layer of the skin covering the exterior body surface of vertebrates"@en ;
	dc:source	pwn30:05240211-n .

<i64491>	a	<Concept> ;
	skos:definition	"an epithelium of mesoblastic origin; a thin layer of flattened cells that lines the inside of some body cavities"@en ;
	dc:source	pwn30:05240522-n .

<i64492>	a	<Concept> ;
	skos:definition	"epithelium originating in the embryonic mesoderm; lines the primordial body cavity"@en ;
	dc:source	pwn30:05240710-n .

<i64493>	a	<Concept> ;
	skos:definition	"epithelium associated with special sense organs and containing sensory nerve endings"@en ;
	dc:source	pwn30:05240850-n .

<i64494>	a	<Concept> ;
	skos:definition	"any of the cells making up the skin"@en ;
	dc:source	pwn30:05241072-n .

<i64495>	a	<Concept> ;
	skos:definition	"any of the cells making up the epidermis"@en ;
	dc:source	pwn30:05241218-n .

<i64496>	a	<Concept> ;
	skos:definition	"an epidermal cell that is a precursor of a melanocyte"@en ;
	dc:source	pwn30:05241374-n .

<i64497>	a	<Concept> ;
	skos:definition	"a cell in the basal layer of the epidermis that produces melanin under the control of the melanocyte-stimulating hormone"@en ;
	dc:source	pwn30:05241485-n .

<i64498>	a	<Concept> ;
	skos:definition	"a cell in the germinal layer of the skin (the prickle-cell layer); has many spines and radiating processes"@en ;
	dc:source	pwn30:05241662-n .

<i64499>	a	<Concept> ;
	skos:definition	"one of the closely packed cells forming the epithelium"@en ;
	dc:source	pwn30:05241827-n .

<i64500>	a	<Concept> ;
	skos:definition	"an epithelial cell that is shaped like a column; some have cilia"@en ;
	dc:source	pwn30:05242070-n .

<i64501>	a	<Concept> ;
	skos:definition	"any of various columnar epithelial cells in the central nervous system that develop into neuroglia"@en ;
	dc:source	pwn30:05242239-n .

<i64502>	a	<Concept> ;
	skos:definition	"an epithelial cell that shaped like a cube"@en ;
	dc:source	pwn30:05242396-n .

<i64503>	a	<Concept> ;
	skos:definition	"an epithelial cell that secretes mucous"@en ;
	dc:source	pwn30:05242525-n .

<i64504>	a	<Concept> ;
	skos:definition	"a sensory epithelial cell present in the organ of Corti"@en ;
	dc:source	pwn30:05242622-n .

<i64505>	a	<Concept> ;
	skos:definition	"specialized cells in the liver that destroy bacteria, foreign proteins, and worn-out blood cells"@en ;
	dc:source	pwn30:05242752-n .

<i64506>	a	<Concept> ;
	skos:definition	"an epithelial cell that is flat like a plate and form a single layer of epithelial tissue"@en ;
	dc:source	pwn30:05242928-n .

<i64507>	a	<Concept> ;
	skos:definition	"the outermost layer of the epidermis consisting of dead cells that slough off"@en ;
	dc:source	pwn30:05243077-n .

<i64508>	a	<Concept> ;
	skos:definition	"the layer of epidermis immediately under the stratum corneum in the skin of the palms and soles"@en ;
	dc:source	pwn30:05243259-n .

<i64509>	a	<Concept> ;
	skos:definition	"the layer of epidermis just under the stratum corneum or (on the palms and soles) just under the stratum lucidum; contains cells (with visible granules) that die and move to the surface"@en ;
	dc:source	pwn30:05243435-n .

<i64510>	a	<Concept> ;
	skos:definition	"the innermost layer of the epidermis"@en ;
	dc:source	pwn30:05243704-n .

<i64511>	a	<Concept> ;
	skos:definition	"the deep vascular inner layer of the skin"@en ;
	dc:source	pwn30:05243879-n .

<i64512>	a	<Concept> ;
	skos:definition	"(zoology) a protective layer of epidermis in mollusks or brachiopods that secretes a substance forming the shell"@en ;
	dc:source	pwn30:05244045-n .

<i64513>	a	<Concept> ;
	skos:definition	"(pathology) a small abnormal patch on or inside the body"@en ;
	dc:source	pwn30:05244239-n .

<i64514>	a	<Concept> ;
	skos:definition	"a plaque consisting of tangles of amyloid protein in nervous tissue (a pathological mark of Alzheimer's disease)"@en ;
	dc:source	pwn30:05244421-n .

<i64515>	a	<Concept> ;
	skos:definition	"a fatty deposit inside an arterial wall; characteristic of atherosclerosis"@en ;
	dc:source	pwn30:05244619-n .

<i64516>	a	<Concept> ;
	skos:definition	"a film of mucus and bacteria deposited on the teeth that encourages the development of dental caries"@en ;
	dc:source	pwn30:05244755-n .

<i64517>	a	<Concept> ;
	skos:definition	"a patch of skin that is discolored but not usually elevated; caused by various diseases"@en ;
	dc:source	pwn30:05244934-n .

<i64518>	a	<Concept> ;
	skos:definition	"a small brownish spot (of the pigment melanin) on the skin"@en ;
	dc:source	pwn30:05245192-n .

<i64519>	a	<Concept> ;
	skos:definition	"a type of skin disease that causes brown spots on the skin"@en ;
	dc:source	pwn30:05245387-n .

<i64520>	a	<Concept> ;
	skos:definition	"a spot on the skin characteristic of the plague"@en ;
	dc:source	pwn30:05245521-n .

<i64521>	a	<Concept> ;
	skos:definition	"a small whitish lump in the skin due to a clogged sebaceous gland"@en ;
	dc:source	pwn30:05245626-n .

<i64522>	a	<Concept> ;
	skos:definition	"a black-tipped plug clogging a pore of the skin"@en ;
	dc:source	pwn30:05245775-n .

<i64523>	a	<Concept> ;
	skos:definition	"any small opening in the skin or outer surface of an animal"@en ;
	dc:source	pwn30:05245906-n .

<i64524>	a	<Concept> ;
	skos:definition	"the orifice from the lower left chamber of the heart to the aorta"@en ;
	dc:source	pwn30:05246089-n .

<i64525>	a	<Concept> ;
	skos:definition	"a mouth or mouthlike opening (especially one created by surgery on the surface of the body to create an opening to an internal organ)"@en ;
	dc:source	pwn30:05246215-n .

<i64526>	a	<Concept> ;
	skos:definition	"(anatomy) any hollow cylindrical body structure"@en ;
	dc:source	pwn30:05246511-n .

<i64527>	a	<Concept> ;
	skos:definition	"a small tube"@en ;
	dc:source	pwn30:05246796-n .

<i64528>	a	<Concept> ;
	skos:definition	"a microscopically small tubule"@en ;
	dc:source	pwn30:05246969-n .

<i64529>	a	<Concept> ;
	skos:definition	"a tube in the uterus or the ear"@en ;
	dc:source	pwn30:05247057-n .

<i64530>	a	<Concept> ;
	skos:definition	"any of the small tubules that are the excretory units of the vertebrate kidney"@en ;
	dc:source	pwn30:05247178-n .

<i64531>	a	<Concept> ;
	skos:definition	"the capsule that contains Bowman's capsule and a glomerulus at the expanded end of a nephron"@en ;
	dc:source	pwn30:05247369-n .

<i64532>	a	<Concept> ;
	skos:definition	"thin double membrane surrounding the glomerulus of a nephron"@en ;
	dc:source	pwn30:05247621-n .

<i64533>	a	<Concept> ;
	skos:definition	"a small intertwined group of capillaries in the malpighian body; it filters the blood during urine formation"@en ;
	dc:source	pwn30:05247804-n .

<i64534>	a	<Concept> ;
	skos:definition	"a network of tiny blood vessels between the cerebral surface of the pia mater and the cerebral cortex"@en ;
	dc:source	pwn30:05248006-n .

<i64535>	a	<Concept> ;
	skos:definition	"a path or channel or duct through or along which something may pass"@en ;
	dc:source	pwn30:05248181-n .

<i64536>	a	<Concept> ;
	skos:definition	"a natural body passageway"@en ;
	dc:source	pwn30:05248553-n .

<i64537>	a	<Concept> ;
	skos:definition	"either of the passages in the outer ear from the auricle to the tympanic membrane"@en ;
	dc:source	pwn30:05248667-n .

<i64538>	a	<Concept> ;
	skos:definition	"a bump on the outside of the humerus where the deltoid muscle attaches"@en ;
	dc:source	pwn30:05248921-n .

<i64539>	a	<Concept> ;
	skos:definition	"the passages in the nasal cavity formed by the projections of the nasal conchae"@en ;
	dc:source	pwn30:05249094-n .

<i64540>	a	<Concept> ;
	skos:definition	"the canal in successive vertebrae through which the spinal cord passes"@en ;
	dc:source	pwn30:05249232-n .

