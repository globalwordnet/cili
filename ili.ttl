	skos:definition	"the philosophical study of causation"@en ;
	dc:source	pwn30:06161048-n .

<i68938>	a	<Concept> ;
	skos:definition	"(art) the branch of philosophy dealing with beauty and taste (emphasizing the evaluative criteria that are applied to art)"@en ;
