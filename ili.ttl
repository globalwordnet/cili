	dc:source	pwn30:05913538-n .

<i67916>	a	<Concept> ;
	skos:definition	"a fundamental principle or practice"@en ;
	dc:source	pwn30:05913842-n .

<i67917>	a	<Concept> ;
	skos:definition	"(Islam) one of the five religious obligations accepted by all Muslims"@en ;
	dc:source	pwn30:05913994-n .

<i67918>	a	<Concept> ;
	skos:definition	"the first pillar of Islam is an affirmation of faith"@en ;
	dc:source	pwn30:05914234-n .

<i67919>	a	<Concept> ;
	skos:definition	"the second pillar of Islam is prayer; a prescribed liturgy performed five times a day (preferably in a mosque) and oriented toward Mecca"@en ;
	dc:source	pwn30:05914359-n .

<i67920>	a	<Concept> ;
	skos:definition	"the third pillar of Islam is fasting (primarily during the month of Ramadan); Muslims abstain from food and drink and gambling and all sensuous pleasures from sunrise to sunset during Ramadan"@en ;
	dc:source	pwn30:05914591-n .

<i67921>	a	<Concept> ;
	skos:definition	"the fourth pillar of Islam is almsgiving as an act of worship"@en ;
	dc:source	pwn30:05914851-n .

<i67922>	a	<Concept> ;
	skos:definition	"the fifth pillar of Islam is a pilgrimage to Mecca during the month of Dhu al-Hijja; at least once in a lifetime a Muslim is expected to make a religious journey to Mecca and the Kaaba"@en ;
	dc:source	pwn30:05915034-n .

<i67923>	a	<Concept> ;
	skos:definition	"the bright positive masculine principle in Chinese dualistic cosmology"@en ;
	dc:source	pwn30:05915356-n .

<i67924>	a	<Concept> ;
	skos:definition	"the dark negative feminine principle in Chinese dualistic cosmology"@en ;
	dc:source	pwn30:05915584-n .

<i67925>	a	<Concept> ;
	skos:definition	"rules in Chinese philosophy that govern spatial arrangement and orientation in relation to patterns of yin and yang and the flow of energy (qi); the favorable or unfavorable effects are taken into consideration in designing and siting buildings and graves and furniture"@en ;
	dc:source	pwn30:05915811-n .

<i67926>	a	<Concept> ;
	skos:definition	"an idea that is suggested"@en ;
	dc:source	pwn30:05916155-n .

<i67927>	a	<Concept> ;
	skos:definition	"a slight suggestion or vague understanding"@en ;
	dc:source	pwn30:05916306-n .

<i67928>	a	<Concept> ;
	skos:definition	"a suggestion that is made to a person who is hypnotized that specifies an action he will perform (usually in response to a cue) after he has awakened"@en ;
	dc:source	pwn30:05916520-n .

<i67929>	a	<Concept> ;
	skos:definition	"a vague idea in which some confidence is placed"@en ;
	dc:source	pwn30:05916739-n .

<i67930>	a	<Concept> ;
	skos:definition	"the impression that something is present"@en ;
	dc:source	pwn30:05917174-n .

