	skos:definition	"government of a town by an assembly of the qualified voters"@en ;
	dc:source	pwn30:08312241-n .

<i80818>	a	<Concept> ;
	skos:definition	"a meeting of heads of governments"@en ;
	dc:source	pwn30:08312359-n .

