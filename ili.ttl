	skos:definition	"a body serving in an administrative capacity"@en ;
	dc:source	pwn30:08310949-n .

<i80811>	a	<Concept> ;
	skos:definition	"a municipal body that can pass ordinances and appropriate funds etc."@en ;
	dc:source	pwn30:08311282-n .

<i80812>	a	<Concept> ;
	skos:definition	"a council that shares the supreme executive power"@en ;
	dc:source	pwn30:08311409-n .

