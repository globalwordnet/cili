	dc:source	pwn30:06281959-n .

<i69524>	a	<Concept> ;
	skos:definition	"modulation of the time between successive pulses"@en ;
	dc:source	pwn30:06282093-n .

<i69525>	a	<Concept> ;
	skos:definition	"(electronics) the reception of a signal by extracting it from the carrier wave"@en ;
	dc:source	pwn30:06282209-n .

<i69526>	a	<Concept> ;
	skos:definition	"the communication of an attitude or emotional state among a number of people"@en ;
	dc:source	pwn30:06282383-n .

<i69527>	a	<Concept> ;
	skos:definition	"a systematic means of communicating by the use of sounds or conventional symbols"@en ;
	dc:source	pwn30:06282651-n .

<i69528>	a	<Concept> ;
	skos:definition	"the customary manner in which a language (or a form of a language) is spoken or written"@en ;
	dc:source	pwn30:06283459-n .

<i69529>	a	<Concept> ;
	skos:definition	"a language that is no longer learned as a native language"@en ;
	dc:source	pwn30:06283647-n .

<i69530>	a	<Concept> ;
	skos:definition	"language that is spoken or written"@en ;
	dc:source	pwn30:06283764-n .

<i69531>	a	<Concept> ;
	skos:definition	"a language that is to be translated into another language"@en ;
	dc:source	pwn30:06283912-n .

<i69532>	a	<Concept> ;
	skos:definition	"the language into which a text written in another language is to be translated"@en ;
	dc:source	pwn30:06284067-n .

<i69533>	a	<Concept> ;
	skos:definition	"one of the natural units into which linguistic messages can be analyzed"@en ;
	dc:source	pwn30:06284225-n .

<i69534>	a	<Concept> ;
	skos:definition	"a position in a grammatical linguistic construction in which a variety of alternative units are interchangeable"@en ;
	dc:source	pwn30:06284573-n .

<i69535>	a	<Concept> ;
	skos:definition	"extended verbal expression in speech or writing"@en ;
	dc:source	pwn30:06284777-n .

<i69536>	a	<Concept> ;
	skos:definition	"discourse that surrounds a language unit and helps to determine its interpretation"@en ;
	dc:source	pwn30:06284898-n .

<i69537>	a	<Concept> ;
	skos:definition	"a string of words satisfying the grammatical rules of a language"@en ;
	dc:source	pwn30:06285090-n .

<i69538>	a	<Concept> ;
	skos:definition	"a sentence having no coordinate clauses or subordinate clauses"@en ;
	dc:source	pwn30:06285435-n .

<i69539>	a	<Concept> ;
	skos:definition	"a sentence composed of at least one main clause and one subordinate clause"@en ;
	dc:source	pwn30:06285559-n .

<i69540>	a	<Concept> ;
	skos:definition	"a complex sentence in which the main clause comes first and the subordinate clause follows"@en ;
	dc:source	pwn30:06285789-n .

<i69541>	a	<Concept> ;
	skos:definition	"a complex sentence in which the main clause comes last and is preceded by the subordinate clause"@en ;
	dc:source	pwn30:06285940-n .

<i69542>	a	<Concept> ;
	skos:definition	"a sentence composed of at least two coordinate independent clauses"@en ;
	dc:source	pwn30:06286100-n .

<i69543>	a	<Concept> ;
	skos:definition	"formal expression containing variables; becomes a sentence when variables are replaced by constants"@en ;
	dc:source	pwn30:06286230-n .

<i69544>	a	<Concept> ;
	skos:definition	"a unit of language that native speakers can identify"@en ;
	dc:source	pwn30:06286395-n .

<i69545>	a	<Concept> ;
	skos:definition	"a word or phrase spelled by rearranging the letters of another word or phrase"@en ;
	dc:source	pwn30:06287620-n .

<i69546>	a	<Concept> ;
	skos:definition	"a word (such as a pronoun) used to avoid repetition; the referent of an anaphor is determined by its antecedent"@en ;
	dc:source	pwn30:06287859-n .

<i69547>	a	<Concept> ;
	skos:definition	"a word that expresses a meaning opposed to the meaning of another word, in which case the two words are antonyms of each other"@en ;
	dc:source	pwn30:06288024-n .

<i69548>	a	<Concept> ;
	skos:definition	"a word invented (usually unwittingly by subtracting an affix) on the assumption that a familiar word derives from it"@en ;
	dc:source	pwn30:06288350-n .

<i69549>	a	<Concept> ;
	skos:definition	"a new word formed by joining two others and combining their meanings"@en ;
	dc:source	pwn30:06288527-n .

<i69550>	a	<Concept> ;
	skos:definition	"a word acted out in an episode of the game of charades"@en ;
	dc:source	pwn30:06288947-n .

<i69551>	a	<Concept> ;
	skos:definition	"a word is cognate with another if both derive from the same word in an ancestral language"@en ;
	dc:source	pwn30:06289074-n .

<i69552>	a	<Concept> ;
	skos:definition	"a word to which an independent meaning can be assigned"@en ;
	dc:source	pwn30:06289250-n .

<i69553>	a	<Concept> ;
	skos:definition	"a word formed from two or more words by omitting or combining some sounds"@en ;
	dc:source	pwn30:06289472-n .

<i69554>	a	<Concept> ;
	skos:definition	"a word specifying identity or spatial or temporal location from the perspective of a speaker or hearer in the context in which the communication occurs"@en ;
	dc:source	pwn30:06289693-n .

<i69555>	a	<Concept> ;
	skos:definition	"(linguistics) a word that is derived from another word"@en ;
	dc:source	pwn30:06290051-n .

<i69556>	a	<Concept> ;
	skos:definition	"a word that is formed with a suffix (such as -let or -kin) to indicate smallness"@en ;
	dc:source	pwn30:06290246-n .

<i69557>	a	<Concept> ;
	skos:definition	"a word that is considered to be unmentionable"@en ;
	dc:source	pwn30:06290401-n .

<i69558>	a	<Concept> ;
	skos:definition	"a word having two syllables"@en ;
	dc:source	pwn30:06290539-n .

<i69559>	a	<Concept> ;
	skos:definition	"the phonological or orthographic sound or appearance of a word that can be used to describe or identify something"@en ;
	dc:source	pwn30:06290637-n .

<i69560>	a	<Concept> ;
	skos:definition	"any of several short English words (often having 4 letters) generally regarded as obscene or offensive"@en ;
	dc:source	pwn30:06291122-n .

<i69561>	a	<Concept> ;
	skos:definition	"a word that is uninflected and serves a grammatical function but has little identifiable meaning"@en ;
	dc:source	pwn30:06291318-n .

<i69562>	a	<Concept> ;
	skos:definition	"a word printed at the top of the page of a dictionary or other reference book to indicate the first or last item on that page"@en ;
	dc:source	pwn30:06291603-n .

<i69563>	a	<Concept> ;
	skos:definition	"(grammar) the word in a grammatical constituent that plays the same grammatical role as the whole constituent"@en ;
	dc:source	pwn30:06291809-n .

<i69564>	a	<Concept> ;
	skos:definition	"a word placed at the beginning of a line or paragraph (as in a dictionary entry)"@en ;
	dc:source	pwn30:06292000-n .

<i69565>	a	<Concept> ;
	skos:definition	"a content word that can be qualified by a modifier"@en ;
	dc:source	pwn30:06292154-n .

<i69566>	a	<Concept> ;
	skos:definition	"two words are heteronyms if they are spelled the same way but differ in pronunciation"@en ;
	dc:source	pwn30:06292290-n .

<i69567>	a	<Concept> ;
	skos:definition	"a word that names the whole of which a given word is a part"@en ;
	dc:source	pwn30:06292478-n .

<i69568>	a	<Concept> ;
	skos:definition	"two words are homonyms if they are pronounced or spelled the same way but have different meanings"@en ;
	dc:source	pwn30:06292649-n .

<i69569>	a	<Concept> ;
	skos:definition	"a word that is more generic than a given word"@en ;
	dc:source	pwn30:06292836-n .

<i69570>	a	<Concept> ;
	skos:definition	"a word that is more specific than a given word"@en ;
	dc:source	pwn30:06292973-n .

<i69571>	a	<Concept> ;
	skos:definition	"a significant word used in indexing or cataloging"@en ;
	dc:source	pwn30:06293106-n .

<i69572>	a	<Concept> ;
	skos:definition	"a word that is composed of parts from different languages (e.g., `monolingual' has a Greek prefix and a Latin root)"@en ;
	dc:source	pwn30:06293229-n .

<i69573>	a	<Concept> ;
	skos:definition	"a word borrowed from another language; e.g. `blitz' is a German word borrowed into modern English"@en ;
	dc:source	pwn30:06293460-n .

<i69574>	a	<Concept> ;
	skos:definition	"a word or phrase borrowed from Latin"@en ;
	dc:source	pwn30:06293655-n .

<i69575>	a	<Concept> ;
	skos:definition	"a word that names a part of a larger whole"@en ;
	dc:source	pwn30:06293746-n .

<i69576>	a	<Concept> ;
	skos:definition	"a word that denotes one thing but refers to a related thing"@en ;
	dc:source	pwn30:06293898-n .

<i69577>	a	<Concept> ;
	skos:definition	"an anagram that means the opposite of the original word or phrase"@en ;
	dc:source	pwn30:06294147-n .

<i69578>	a	<Concept> ;
	skos:definition	"a word or utterance of one syllable"@en ;
	dc:source	pwn30:06294309-n .

<i69579>	a	<Concept> ;
	skos:definition	"a newly invented word or phrase"@en ;
	dc:source	pwn30:06294441-n .

<i69580>	a	<Concept> ;
	skos:definition	"a word with a special meaning used for a special occasion"@en ;
	dc:source	pwn30:06294584-n .

<i69581>	a	<Concept> ;
	skos:definition	"word having stress or an acute accent on the last syllable"@en ;
	dc:source	pwn30:06294716-n .

<i69582>	a	<Concept> ;
	skos:definition	"a word or phrase that reads the same backward as forward"@en ;
	dc:source	pwn30:06294828-n .

<i69583>	a	<Concept> ;
	skos:definition	"a word serving as the basis for inflected or derived forms"@en ;
	dc:source	pwn30:06294941-n .

<i69584>	a	<Concept> ;
	skos:definition	"a mathematical expression from which another expression is derived"@en ;
	dc:source	pwn30:06295113-n .

<i69585>	a	<Concept> ;
	skos:definition	"the form of a word that is used to denote more than one"@en ;
	dc:source	pwn30:06295235-n .

<i69586>	a	<Concept> ;
	skos:definition	"the form of a word that is used to denote a singleton"@en ;
	dc:source	pwn30:06299916-n .

<i69587>	a	<Concept> ;
	skos:definition	"a word form that has entered the language through the perpetuation of an error"@en ;
	dc:source	pwn30:06300058-n .

<i69588>	a	<Concept> ;
	skos:definition	"(linguistics) the form of a word after all affixes are removed"@en ;
	dc:source	pwn30:06300193-n .

<i69589>	a	<Concept> ;
	skos:definition	"a simple form inferred as the common basis from which related words in several languages can be derived by linguistic processes"@en ;
	dc:source	pwn30:06300445-n .

<i69590>	a	<Concept> ;
	skos:definition	"the form of a word that heads a lexical entry and is alphabetized in a dictionary"@en ;
	dc:source	pwn30:06300632-n .

<i69591>	a	<Concept> ;
	skos:definition	"the entry in a dictionary of information about a word"@en ;
	dc:source	pwn30:06300823-n .

<i69592>	a	<Concept> ;
	skos:definition	"one of the eight sayings of Jesus at the beginning of the Sermon on the Mount; in Latin each saying begins with `beatus' (blessed)"@en ;
	dc:source	pwn30:06301012-n .

<i69593>	a	<Concept> ;
	skos:definition	"a saying of Jesus that is regarded as authentic although it is not recorded in the Gospels"@en ;
	dc:source	pwn30:06301302-n .

<i69594>	a	<Concept> ;
	skos:definition	"an expression introduced into one language by translating it from another language"@en ;
	dc:source	pwn30:06301445-n .

<i69595>	a	<Concept> ;
	skos:definition	"word having stress or acute accent on the next to last syllable"@en ;
	dc:source	pwn30:06301672-n .

<i69596>	a	<Concept> ;
	skos:definition	"word (such a `some' or `less') that is used to indicate a part as distinct from a whole"@en ;
	dc:source	pwn30:06301792-n .

<i69597>	a	<Concept> ;
	skos:definition	"a word having more than one meaning"@en ;
	dc:source	pwn30:06301953-n .

<i69598>	a	<Concept> ;
	skos:definition	"a word of more than three syllables"@en ;
	dc:source	pwn30:06302083-n .

<i69599>	a	<Concept> ;
	skos:definition	"word having stress or acute accent on the antepenult"@en ;
	dc:source	pwn30:06302269-n .

<i69600>	a	<Concept> ;
	skos:definition	"(grammar) a word that expresses a quantity (as `fifteen' or `many')"@en ;
	dc:source	pwn30:06302381-n .

<i69601>	a	<Concept> ;
	skos:definition	"(logic) a word (such as `some' or `all' or `no') that binds the variables in a logical proposition"@en ;
	dc:source	pwn30:06302542-n .

<i69602>	a	<Concept> ;
	skos:definition	"a logical quantifier of a proposition that asserts the existence of at least one thing for which the proposition is true"@en ;
	dc:source	pwn30:06302755-n .

<i69603>	a	<Concept> ;
	skos:definition	"a logical quantifier of a proposition that asserts that the proposition is true for all members of a class of things"@en ;
	dc:source	pwn30:06302967-n .

<i69604>	a	<Concept> ;
	skos:definition	"a word formed by or containing a repeated syllable or speech sound (usually at the beginning of the word)"@en ;
	dc:source	pwn30:06303150-n .

<i69605>	a	<Concept> ;
	skos:definition	"a word introduced because an existing term has become inadequate"@en ;
	dc:source	pwn30:06303315-n .

<i69606>	a	<Concept> ;
	skos:definition	"any word or group of words functioning as a noun"@en ;
	dc:source	pwn30:06303540-n .

<i69607>	a	<Concept> ;
	skos:definition	"two words that can be interchanged in a context are said to be synonymous relative to that context"@en ;
	dc:source	pwn30:06303682-n .

<i69608>	a	<Concept> ;
	skos:definition	"a word or expression used for some particular thing"@en ;
	dc:source	pwn30:06303888-n .

<i69609>	a	<Concept> ;
	skos:definition	"a system of words used to name things in a particular discipline"@en ;
	dc:source	pwn30:06304059-n .

<i69610>	a	<Concept> ;
	skos:definition	"a word having three syllables"@en ;
	dc:source	pwn30:06304338-n .

<i69611>	a	<Concept> ;
	skos:definition	"a word that denotes a manner of doing something"@en ;
	dc:source	pwn30:06304425-n .

<i69612>	a	<Concept> ;
	skos:definition	"a word that is spoken aloud"@en ;
	dc:source	pwn30:06304576-n .

<i69613>	a	<Concept> ;
	skos:definition	"a unit of spoken language larger than a phoneme"@en ;
	dc:source	pwn30:06304671-n .

<i69614>	a	<Concept> ;
	skos:definition	"the last syllable in a word"@en ;
	dc:source	pwn30:06305029-n .

<i69615>	a	<Concept> ;
	skos:definition	"the next to last syllable in a word"@en ;
	dc:source	pwn30:06305109-n .

<i69616>	a	<Concept> ;
	skos:definition	"the 3rd syllable of a word counting back from the end"@en ;
	dc:source	pwn30:06305223-n .

<i69617>	a	<Concept> ;
	skos:definition	"a word that is hard to pronounce"@en ;
	dc:source	pwn30:06305385-n .

<i69618>	a	<Concept> ;
	skos:definition	"a very long word (a foot and a half long)"@en ;
	dc:source	pwn30:06305474-n .

<i69619>	a	<Concept> ;
	skos:definition	"the syllable added in a reduplicated word form"@en ;
	dc:source	pwn30:06305610-n .

<i69620>	a	<Concept> ;
	skos:definition	"antonyms that are commonly associated (e.g., `wet' and `dry')"@en ;
	dc:source	pwn30:06305716-n .

<i69621>	a	<Concept> ;
	skos:definition	"antonyms whose opposition is mediated (e.g., the antonymy of `wet' and `parched' is mediated by the similarity of `parched' to `dry')"@en ;
	dc:source	pwn30:06305838-n .

<i69622>	a	<Concept> ;
	skos:definition	"a minimal unit (as a word or stem) in the lexicon of a language; `go' and `went' and `gone' and `going' are all members of the English lexeme `go'"@en ;
	dc:source	pwn30:06306034-n .

<i69623>	a	<Concept> ;
	skos:definition	"minimal meaningful language unit; it cannot be divided into smaller meaningful units"@en ;
	dc:source	pwn30:06306233-n .

<i69624>	a	<Concept> ;
	skos:definition	"minimal language unit that has a syntactic (or morphological) function"@en ;
	dc:source	pwn30:06306480-n .

<i69625>	a	<Concept> ;
	skos:definition	"a variant phonological representation of a morpheme"@en ;
	dc:source	pwn30:06306606-n .

<i69626>	a	<Concept> ;
	skos:definition	"a morpheme that can occur alone"@en ;
	dc:source	pwn30:06306842-n .

<i69627>	a	<Concept> ;
	skos:definition	"a morpheme that occurs only as part of a larger construction; eg an -s at the end of plural nouns"@en ;
	dc:source	pwn30:06306945-n .

<i69628>	a	<Concept> ;
	skos:definition	"a bound form used only in compounds"@en ;
	dc:source	pwn30:06307152-n .

<i69629>	a	<Concept> ;
	skos:definition	"a linguistic element added to a word to produce an inflected or derived form"@en ;
	dc:source	pwn30:06308049-n .

<i69630>	a	<Concept> ;
	skos:definition	"an affix that is added in front of the word"@en ;
	dc:source	pwn30:06308304-n .

<i69631>	a	<Concept> ;
	skos:definition	"a word or morpheme used in some languages in certain contexts (such as counting) to indicate the semantic class to which the counted item belongs"@en ;
	dc:source	pwn30:06308436-n .

<i69632>	a	<Concept> ;
	skos:definition	"the negative prefix a- or un-"@en ;
	dc:source	pwn30:06308674-n .

<i69633>	a	<Concept> ;
	skos:definition	"the end of a word (a suffix or inflectional ending or final morpheme)"@en ;
	dc:source	pwn30:06308765-n .

<i69634>	a	<Concept> ;
	skos:definition	"an affix that is added at the end of the word"@en ;
	dc:source	pwn30:06308987-n .

<i69635>	a	<Concept> ;
	skos:definition	"an inflection that is added at the end of a root word"@en ;
	dc:source	pwn30:06309131-n .

<i69636>	a	<Concept> ;
	skos:definition	"an affix that is inserted inside the word"@en ;
	dc:source	pwn30:06309272-n .

<i69637>	a	<Concept> ;
	skos:definition	"(grammar) a category of words having the same grammatical properties"@en ;
	dc:source	pwn30:06309383-n .

<i69638>	a	<Concept> ;
	skos:definition	"the class of all items that can be substituted into the same position (or slot) in a grammatical sentence (are in paradigmatic relation with one another)"@en ;
	dc:source	pwn30:06309684-n .

<i69639>	a	<Concept> ;
	skos:definition	"(grammar) one of the two main constituents of a sentence; the grammatical constituent about which something is predicated"@en ;
	dc:source	pwn30:06309931-n .

<i69640>	a	<Concept> ;
	skos:definition	"(logic) the first term of a proposition"@en ;
	dc:source	pwn30:06310125-n .

<i69641>	a	<Concept> ;
	skos:definition	"(grammar) a constituent that is acted upon"@en ;
	dc:source	pwn30:06310237-n .

<i69642>	a	<Concept> ;
	skos:definition	"the object governed by a preposition"@en ;
	dc:source	pwn30:06310449-n .

<i69643>	a	<Concept> ;
	skos:definition	"the object that receives the direct action of the verb"@en ;
	dc:source	pwn30:06310578-n .

<i69644>	a	<Concept> ;
	skos:definition	"the object that is the recipient or beneficiary of the action of the verb"@en ;
	dc:source	pwn30:06310713-n .

<i69645>	a	<Concept> ;
	skos:definition	"an object in a passive construction"@en ;
	dc:source	pwn30:06310848-n .

<i69646>	a	<Concept> ;
	skos:definition	"nouns or pronouns or adjectives (often marked by inflection) related in some way to other words in a sentence"@en ;
	dc:source	pwn30:06310945-n .

<i69647>	a	<Concept> ;
	skos:definition	"the category of nouns serving as the grammatical subject of a verb"@en ;
	dc:source	pwn30:06311160-n .

<i69648>	a	<Concept> ;
	skos:definition	"any grammatical case other than the nominative"@en ;
	dc:source	pwn30:06311334-n .

<i69649>	a	<Concept> ;
	skos:definition	"the case of nouns serving as the direct object of a verb"@en ;
	dc:source	pwn30:06311557-n .

<i69650>	a	<Concept> ;
	skos:definition	"the category of nouns serving as the indirect object of a verb"@en ;
	dc:source	pwn30:06311723-n .

<i69651>	a	<Concept> ;
	skos:definition	"the case expressing ownership"@en ;
	dc:source	pwn30:06311852-n .

<i69652>	a	<Concept> ;
	skos:definition	"a word in the genitive case that is used as an attributive adjective"@en ;
	dc:source	pwn30:06312001-n .

<i69653>	a	<Concept> ;
	skos:definition	"the case (in some inflected languages) used when the referent of the noun is being addressed"@en ;
	dc:source	pwn30:06312237-n .

<i69654>	a	<Concept> ;
	skos:definition	"the case indicating the agent in passive sentences or the instrument or manner or place of the action described by the verb"@en ;
	dc:source	pwn30:06312418-n .

<i69655>	a	<Concept> ;
	skos:definition	"a constituent in Latin grammar; a noun and its modifier can function as a sentence modifier"@en ;
	dc:source	pwn30:06312612-n .

<i69656>	a	<Concept> ;
	skos:definition	"a construction that can be used to extend the meaning of a word or phrase but is not one of the main constituents of a sentence"@en ;
	dc:source	pwn30:06312767-n .

<i69657>	a	<Concept> ;
	skos:definition	"(grammar) a word or phrase or clause forming part of a larger grammatical construction"@en ;
	dc:source	pwn30:06312966-n .

<i69658>	a	<Concept> ;
	skos:definition	"a constituent of a sentence at the first step in an analysis: e.g., subject and predicate"@en ;
	dc:source	pwn30:06313300-n .

<i69659>	a	<Concept> ;
	skos:definition	"a syntactic string of words that forms a part of some larger syntactic unit"@en ;
	dc:source	pwn30:06313457-n .

<i69660>	a	<Concept> ;
	skos:definition	"a group of words that form a constituent of a sentence and are considered as a single unit"@en ;
	dc:source	pwn30:06313651-n .

<i69661>	a	<Concept> ;
	skos:definition	"an ungrammatical constituent"@en ;
	dc:source	pwn30:06314036-n .

<i69662>	a	<Concept> ;
	skos:definition	"(grammar) an expression including a subject and predicate but not constituting a complete sentence"@en ;
	dc:source	pwn30:06314144-n .

<i69663>	a	<Concept> ;
	skos:definition	"a clause in a complex sentence that can stand alone as a complete sentence"@en ;
	dc:source	pwn30:06314423-n .

<i69664>	a	<Concept> ;
	skos:definition	"a clause in a complex sentence that is grammatically equivalent to the main clause and that performs the same grammatical function"@en ;
	dc:source	pwn30:06314595-n .

<i69665>	a	<Concept> ;
	skos:definition	"a clause in a complex sentence that cannot stand alone as a complete sentence and that functions within the sentence as a noun or adjective or adverb"@en ;
	dc:source	pwn30:06314808-n .

<i69666>	a	<Concept> ;
	skos:definition	"a clause introduced by a relative pronoun"@en ;
	dc:source	pwn30:06315096-n .

<i69667>	a	<Concept> ;
	skos:definition	"a subordinate clause that limits or restricts the meaning of the noun phrase it modifies"@en ;
	dc:source	pwn30:06315301-n .

<i69668>	a	<Concept> ;
	skos:definition	"a subordinate clause that does not limit or restrict the meaning of the noun phrase it modifies"@en ;
	dc:source	pwn30:06315454-n .

<i69669>	a	<Concept> ;
	skos:definition	"a word or phrase used to complete a grammatical construction"@en ;
	dc:source	pwn30:06315638-n .

<i69670>	a	<Concept> ;
	skos:definition	"a long and intricate and complicated grammatical construction"@en ;
	dc:source	pwn30:06315755-n .

<i69671>	a	<Concept> ;
	skos:definition	"an expression in parentheses"@en ;
	dc:source	pwn30:06315873-n .

<i69672>	a	<Concept> ;
	skos:definition	"an expression consisting of one or more words forming a grammatical constituent of a sentence"@en ;
	dc:source	pwn30:06316048-n .

<i69673>	a	<Concept> ;
	skos:definition	"an expression that predicates"@en ;
	dc:source	pwn30:06316376-n .

<i69674>	a	<Concept> ;
	skos:definition	"a phrase that can function as the subject or object of a verb"@en ;
	dc:source	pwn30:06316480-n .

<i69675>	a	<Concept> ;
	skos:definition	"one of the two main constituents of a sentence; the predicate contains the verb and its complements"@en ;
	dc:source	pwn30:06316626-n .

<i69676>	a	<Concept> ;
	skos:definition	"(logic) what is predicated of the subject of a proposition; the second term in a proposition is predicated of the first term by means of the copula"@en ;
	dc:source	pwn30:06316813-n .

<i69677>	a	<Concept> ;
	skos:definition	"an infinitive with an adverb between `to' and the verb (e.g., `to boldly go')"@en ;
	dc:source	pwn30:06317107-n .

<i69678>	a	<Concept> ;
	skos:definition	"a phrase beginning with a preposition"@en ;
	dc:source	pwn30:06317247-n .

<i69679>	a	<Concept> ;
	skos:definition	"a phrase that functions as a pronoun"@en ;
	dc:source	pwn30:06317351-n .

<i69680>	a	<Concept> ;
	skos:definition	"one of the traditional categories of words intended to reflect their functions in a grammatical context"@en ;
	dc:source	pwn30:06317464-n .

<i69681>	a	<Concept> ;
	skos:definition	"any of the major parts of speech of traditional grammar"@en ;
	dc:source	pwn30:06317672-n .

<i69682>	a	<Concept> ;
	skos:definition	"the word class that can serve as the subject or object of a verb, the object of a preposition, or in apposition"@en ;
	dc:source	pwn30:06317862-n .

<i69683>	a	<Concept> ;
	skos:definition	"the word class that serves as the predicate of a sentence"@en ;
	dc:source	pwn30:06318062-n .

<i69684>	a	<Concept> ;
	skos:definition	"a noun formed from a verb (such as the `-ing' form of an English verb when used as a noun)"@en ;
	dc:source	pwn30:06318352-n .

<i69685>	a	<Concept> ;
	skos:definition	"a verb that combines with another verb in a verb phrase to help form tense, mood, voice, or condition of the verb it combines with"@en ;
	dc:source	pwn30:06318513-n .

<i69686>	a	<Concept> ;
	skos:definition	"an auxiliary verb (such as `can' or `will') that is used to express modality"@en ;
	dc:source	pwn30:06318722-n .

<i69687>	a	<Concept> ;
	skos:definition	"the uninflected form of the verb"@en ;
	dc:source	pwn30:06318904-n .

<i69688>	a	<Concept> ;
	skos:definition	"the word class that qualifies nouns"@en ;
	dc:source	pwn30:06319029-n .

<i69689>	a	<Concept> ;
	skos:definition	"the word class that qualifies verbs or clauses"@en ;
	dc:source	pwn30:06319157-n .

<i69690>	a	<Concept> ;
	skos:definition	"a content word that can be used to refer to a person, place, thing, quality, or action"@en ;
	dc:source	pwn30:06319293-n .

<i69691>	a	<Concept> ;
	skos:definition	"a noun that is singular in form but refers to a group of people or things"@en ;
	dc:source	pwn30:06319575-n .

<i69692>	a	<Concept> ;
	skos:definition	"a noun that does not form plurals"@en ;
	dc:source	pwn30:06319710-n .

<i69693>	a	<Concept> ;
	skos:definition	"a noun that forms plurals"@en ;
	dc:source	pwn30:06319799-n .

<i69694>	a	<Concept> ;
	skos:definition	"a noun that does not specify either masculine or feminine gender"@en ;
	dc:source	pwn30:06319881-n .

<i69695>	a	<Concept> ;
	skos:definition	"a noun that denotes a particular thing; usually capitalized"@en ;
	dc:source	pwn30:06320004-n .

<i69696>	a	<Concept> ;
	skos:definition	"a noun that denotes any or all members of a class"@en ;
	dc:source	pwn30:06320153-n .

<i69697>	a	<Concept> ;
	skos:definition	"a noun that is derived from a verb"@en ;
	dc:source	pwn30:06320314-n .

<i69698>	a	<Concept> ;
	skos:definition	"an adjective used as a noun"@en ;
	dc:source	pwn30:06320440-n .

<i69699>	a	<Concept> ;
	skos:definition	"a content word that denotes an action, occurrence, or state of existence"@en ;
	dc:source	pwn30:06320569-n .

<i69700>	a	<Concept> ;
	skos:definition	"a content word that qualifies the meaning of a noun or verb"@en ;
	dc:source	pwn30:06320801-n .

<i69701>	a	<Concept> ;
	skos:definition	"a modifier that has little meaning except to intensify the meaning it modifies"@en ;
	dc:source	pwn30:06321054-n .

<i69702>	a	<Concept> ;
	skos:definition	"a word that expresses an attribute of something"@en ;
	dc:source	pwn30:06321702-n .

<i69703>	a	<Concept> ;
	skos:definition	"an adjective that ascribes to its noun the value of an attribute of that noun (e.g., `a nervous person' or `a musical speaking voice')"@en ;
	dc:source	pwn30:06321932-n .

<i69704>	a	<Concept> ;
	skos:definition	"an adjective that classifies its noun (e.g., `a nervous disease' or `a musical instrument')"@en ;
	dc:source	pwn30:06322157-n .

<i69705>	a	<Concept> ;
	skos:definition	"meaning relating to or pertaining to"@en ;
	dc:source	pwn30:06322357-n .

<i69706>	a	<Concept> ;
	skos:definition	"the primary form of an adjective or adverb; denotes a quality without qualification, comparison, or relation to increase or diminution"@en ;
	dc:source	pwn30:06322468-n .

<i69707>	a	<Concept> ;
	skos:definition	"the comparative form of an adjective or adverb"@en ;
	dc:source	pwn30:06322693-n .

<i69708>	a	<Concept> ;
	skos:definition	"the superlative form of an adjective or adverb"@en ;
	dc:source	pwn30:06323284-n .

<i69709>	a	<Concept> ;
	skos:definition	"a word that modifies something other than a noun"@en ;
	dc:source	pwn30:06323612-n .

<i69710>	a	<Concept> ;
	skos:definition	"a word or phrase apparently modifying an unintended word because of its placement in a sentence: e.g., `when young' in `when young, circuses appeal to all of us'"@en ;
	dc:source	pwn30:06323822-n .

<i69711>	a	<Concept> ;
	skos:definition	"a participle (usually at the beginning of a sentence) apparently modifying a word other than the word intended: e.g., `flying across the country' in `flying across the country the Rockies came into view'"@en ;
	dc:source	pwn30:06324086-n .

<i69712>	a	<Concept> ;
	skos:definition	"a word or group of words function as an adverb"@en ;
	dc:source	pwn30:06324355-n .

<i69713>	a	<Concept> ;
	skos:definition	"one of a limited class of noun modifiers that determine the referents of noun phrases"@en ;
	dc:source	pwn30:06324475-n .

<i69714>	a	<Concept> ;
	skos:definition	"(grammar) a determiner that may indicate the specificity of reference of a noun phrase"@en ;
	dc:source	pwn30:06324669-n .

<i69715>	a	<Concept> ;
	skos:definition	"a determiner (as `the' in English) that indicates specificity of reference"@en ;
	dc:source	pwn30:06324864-n .

<i69716>	a	<Concept> ;
	skos:definition	"a determiner (as `a' or `some' in English) that indicates nonspecific reference"@en ;
	dc:source	pwn30:06325001-n .

<i69717>	a	<Concept> ;
	skos:definition	"a function word that combines with a noun or pronoun or noun phrase to form a prepositional phrase that can have an adverbial or adjectival relation to some other word"@en ;
	dc:source	pwn30:06325145-n .

<i69718>	a	<Concept> ;
	skos:definition	"a function word that is used in place of a noun or noun phrase"@en ;
	dc:source	pwn30:06325370-n .

<i69719>	a	<Concept> ;
	skos:definition	"a pronoun that refers to an antecedent"@en ;
	dc:source	pwn30:06325576-n .

<i69720>	a	<Concept> ;
	skos:definition	"a pronoun that points out an intended referent"@en ;
	dc:source	pwn30:06325678-n .

<i69721>	a	<Concept> ;
	skos:definition	"an uninflected function word that serves to conjoin words or phrases or clauses or sentences"@en ;
	dc:source	pwn30:06325826-n .

<i69722>	a	<Concept> ;
	skos:definition	"a conjunction (like `and' or `or') that connects two identically constructed grammatical constituents"@en ;
	dc:source	pwn30:06326054-n .

<i69723>	a	<Concept> ;
	skos:definition	"a conjunction (like `since' or `that' or `who') that introduces a dependent clause"@en ;
	dc:source	pwn30:06326226-n .

<i69724>	a	<Concept> ;
	skos:definition	"a function word that can be used in English to form phrasal verbs"@en ;
	dc:source	pwn30:06326406-n .

<i69725>	a	<Concept> ;
	skos:definition	"the grammatical category for the forms of nouns and pronouns and verbs that are used depending on the number of entities involved (singular or dual or plural)"@en ;
	dc:source	pwn30:06326526-n .

<i69726>	a	<Concept> ;
	skos:definition	"a grammatical category used in the classification of pronouns, possessive determiners, and verb forms according to whether they indicate the speaker, the addressee, or a third party"@en ;
	dc:source	pwn30:06326797-n .

<i69727>	a	<Concept> ;
	skos:definition	"a pronoun expressing a distinction of person"@en ;
	dc:source	pwn30:06327136-n .

<i69728>	a	<Concept> ;
	skos:definition	"a pronoun or pronominal phrase (as `each other') that expresses a mutual action or relationship between the individuals indicated in the plural subject"@en ;
	dc:source	pwn30:06327261-n .

<i69729>	a	<Concept> ;
	skos:definition	"a pronoun (as `that' or `which' or `who') that introduces a relative clause referring to some antecedent"@en ;
	dc:source	pwn30:06327551-n .

<i69730>	a	<Concept> ;
	skos:definition	"pronouns and verbs used to refer to the speaker or writer of the language in which they occur"@en ;
	dc:source	pwn30:06327718-n .

<i69731>	a	<Concept> ;
	skos:definition	"pronouns and verbs used to refer to the person addressed by the language in which they occur"@en ;
	dc:source	pwn30:06327870-n .

<i69732>	a	<Concept> ;
	skos:definition	"pronouns and verbs that are used to refer to something other than the speaker or addressee of the language in which they occur"@en ;
	dc:source	pwn30:06328022-n .

<i69733>	a	<Concept> ;
	skos:definition	"a personal pronoun compounded with -self to show the agent's action affects the agent"@en ;
	dc:source	pwn30:06328207-n .

<i69734>	a	<Concept> ;
	skos:definition	"a verb whose agent performs an action that is directed at the agent"@en ;
	dc:source	pwn30:06328386-n .

<i69735>	a	<Concept> ;
	skos:definition	"a grammatical category in inflected languages governing the agreement between nouns and pronouns and adjectives; in some languages it is quite arbitrary but in Indo-European languages it is usually based on sex or animateness"@en ;
	dc:source	pwn30:06328643-n .

<i69736>	a	<Concept> ;
	skos:definition	"a gender that refers chiefly (but not exclusively) to females or to objects classified as female"@en ;
	dc:source	pwn30:06328996-n .

<i69737>	a	<Concept> ;
	skos:definition	"a gender that refers chiefly (but not exclusively) to males or to objects classified as male"@en ;
	dc:source	pwn30:06329165-n .

<i69738>	a	<Concept> ;
	skos:definition	"a gender that refers chiefly (but not exclusively) to inanimate objects (neither masculine nor feminine)"@en ;
	dc:source	pwn30:06329313-n .

<i69739>	a	<Concept> ;
	skos:definition	"a grammatical category of verbs used to express distinctions of time"@en ;
	dc:source	pwn30:06329506-n .

<i69740>	a	<Concept> ;
	skos:definition	"a verb tense that expresses actions or states at the time of speaking"@en ;
	dc:source	pwn30:06329734-n .

<i69741>	a	<Concept> ;
	skos:definition	"the use of the present tense to describe past actions or states"@en ;
	dc:source	pwn30:06329909-n .

<i69742>	a	<Concept> ;
	skos:definition	"a verb tense in some languages (classical Greek and Sanskrit) expressing action (especially past action) without indicating its completion or continuation"@en ;
	dc:source	pwn30:06330037-n .

<i69743>	a	<Concept> ;
	skos:definition	"a verb tense that expresses actions or states in the past"@en ;
	dc:source	pwn30:06330262-n .

<i69744>	a	<Concept> ;
	skos:definition	"a verb tense that expresses actions or states in the future"@en ;
	dc:source	pwn30:06330401-n .

<i69745>	a	<Concept> ;
	skos:definition	"a non-finite form of the verb; in English it is used adjectivally and to form compound tenses"@en ;
	dc:source	pwn30:06330528-n .

<i69746>	a	<Concept> ;
	skos:definition	"an English verb followed by one or more particles where the combination behaves as a syntactic and semantic unit"@en ;
	dc:source	pwn30:06330764-n .

<i69747>	a	<Concept> ;
	skos:definition	"a participle expressing present action; in English is formed by adding -ing"@en ;
	dc:source	pwn30:06331014-n .

<i69748>	a	<Concept> ;
	skos:definition	"a participle that expresses completed action"@en ;
	dc:source	pwn30:06331154-n .

<i69749>	a	<Concept> ;
	skos:definition	"a verb (or verb construction) that requires an object in order to be grammatical"@en ;
	dc:source	pwn30:06331281-n .

<i69750>	a	<Concept> ;
	skos:definition	"a transitive verb that takes both a direct and an indirect object"@en ;
	dc:source	pwn30:06331477-n .

<i69751>	a	<Concept> ;
	skos:definition	"a verb (or verb construction) that does not take an object"@en ;
	dc:source	pwn30:06331641-n .

<i69752>	a	<Concept> ;
	skos:definition	"(linguistics) the underlying relation that a constituent has with the main verb in a clause"@en ;
	dc:source	pwn30:06331803-n .

<i69753>	a	<Concept> ;
	skos:definition	"the semantic role of an entity that is not the agent but is directly involved in or affected by the happening denoted by the verb in the clause"@en ;
	dc:source	pwn30:06332136-n .

<i69754>	a	<Concept> ;
	skos:definition	"the semantic role of the animate entity that instigates or causes the happening denoted by the verb in the clause"@en ;
	dc:source	pwn30:06332364-n .

<i69755>	a	<Concept> ;
	skos:definition	"the semantic role of the intended recipient who benefits from the happening denoted by the verb in the clause"@en ;
	dc:source	pwn30:06332545-n .

<i69756>	a	<Concept> ;
	skos:definition	"the semantic role of the entity (usually inanimate) that the agent uses to perform an action or start a process"@en ;
	dc:source	pwn30:06332731-n .

<i69757>	a	<Concept> ;
	skos:definition	"the semantic role of the noun phrase that designates the place of the state or action denoted by the verb"@en ;
	dc:source	pwn30:06332919-n .

<i69758>	a	<Concept> ;
	skos:definition	"the semantic role of the animate entity that is passively involved in the happening denoted by the verb in the clause"@en ;
	dc:source	pwn30:06333095-n .

<i69759>	a	<Concept> ;
	skos:definition	"the semantic role of the noun phrase whose referent exists only by virtue of the activity denoted by the verb in the clause"@en ;
	dc:source	pwn30:06333285-n .

<i69760>	a	<Concept> ;
	skos:definition	"the semantic role of the noun phrase that designates the time of the state or action denoted by the verb"@en ;
	dc:source	pwn30:06333478-n .

<i69761>	a	<Concept> ;
	skos:definition	"a language unit by which a person or thing is known"@en ;
	dc:source	pwn30:06333653-n .

<i69762>	a	<Concept> ;
	skos:definition	"an additional name or an epithet appended to a name (as in `Ferdinand the Great')"@en ;
	dc:source	pwn30:06334377-n .

<i69763>	a	<Concept> ;
	skos:definition	"(law) a name under which a corporation conducts business that is not the legal name of the corporation as shown in its articles of incorporation"@en ;
	dc:source	pwn30:06334512-n .

<i69764>	a	<Concept> ;
	skos:definition	"the name derived from a person (real or imaginary)"@en ;
	dc:source	pwn30:06334778-n .

<i69765>	a	<Concept> ;
	skos:definition	"the person for whom something is named"@en ;
	dc:source	pwn30:06334985-n .

<i69766>	a	<Concept> ;
	skos:definition	"a string of characters beginning with a period and followed by one or more letters; the optional second part of a PC computer filename"@en ;
	dc:source	pwn30:06335162-n .

<i69767>	a	<Concept> ;
	skos:definition	"(computer science) the name given to a computer file in order to distinguish it from other files; may contain an extension that indicates the type of file"@en ;
	dc:source	pwn30:06335532-n .

<i69768>	a	<Concept> ;
	skos:definition	"a family name derived from name of your father or a paternal ancestor (especially with an affix (such as -son in English or O'- in Irish) added to the name of your father or a paternal ancestor)"@en ;
	dc:source	pwn30:06335832-n .

<i69769>	a	<Concept> ;
	skos:definition	"a name derived from the name of your mother or a maternal ancestor"@en ;
	dc:source	pwn30:06336149-n .

<i69770>	a	<Concept> ;
	skos:definition	"the name of a street"@en ;
	dc:source	pwn30:06336285-n .

<i69771>	a	<Concept> ;
	skos:definition	"the name of a brokerage firm in which stock is held on behalf of a customer"@en ;
	dc:source	pwn30:06336363-n .

<i69772>	a	<Concept> ;
	skos:definition	"slang for something (especially for an illegal drug)"@en ;
	dc:source	pwn30:06336537-n .

<i69773>	a	<Concept> ;
	skos:definition	"an alternative name that a person chooses or is given (especially in inner city neighborhoods)"@en ;
	dc:source	pwn30:06336723-n .

<i69774>	a	<Concept> ;
	skos:definition	"the name used to identify the members of a family (as distinguished from each member's given name)"@en ;
	dc:source	pwn30:06336904-n .

<i69775>	a	<Concept> ;
	skos:definition	"a woman's surname before marriage"@en ;
	dc:source	pwn30:06337111-n .

<i69776>	a	<Concept> ;
	skos:definition	"a name between your first name and your surname"@en ;
	dc:source	pwn30:06337202-n .

<i69777>	a	<Concept> ;
	skos:definition	"the name that precedes the surname"@en ;
	dc:source	pwn30:06337307-n .

<i69778>	a	<Concept> ;
	skos:definition	"the first name given to Christians at birth or christening"@en ;
	dc:source	pwn30:06337458-n .

<i69779>	a	<Concept> ;
	skos:definition	"the first name of a citizen of ancient Rome"@en ;
	dc:source	pwn30:06337594-n .

<i69780>	a	<Concept> ;
	skos:definition	"a familiar name for a person (often a shortened version of a person's given name)"@en ;
	dc:source	pwn30:06337693-n .

<i69781>	a	<Concept> ;
	skos:definition	"a descriptive name for a place or thing"@en ;
	dc:source	pwn30:06338003-n .

<i69782>	a	<Concept> ;
	skos:definition	"a name that has been assumed temporarily"@en ;
	dc:source	pwn30:06338158-n .

<i69783>	a	<Concept> ;
	skos:definition	"a fictitious name used when the person performs a particular social role"@en ;
	dc:source	pwn30:06338278-n .

<i69784>	a	<Concept> ;
	skos:definition	"an incorrect or unsuitable name"@en ;
	dc:source	pwn30:06338485-n .

<i69785>	a	<Concept> ;
	skos:definition	"the pseudonym of an actor"@en ;
	dc:source	pwn30:06338571-n .

<i69786>	a	<Concept> ;
	skos:definition	"an author's pseudonym"@en ;
	dc:source	pwn30:06338653-n .

<i69787>	a	<Concept> ;
	skos:definition	"the name that appears on the by-line to identify the author of a work"@en ;
	dc:source	pwn30:06338744-n .

<i69788>	a	<Concept> ;
	skos:definition	"identifying word or words by which someone or something is called and classified or distinguished from others"@en ;
	dc:source	pwn30:06338908-n .

<i69789>	a	<Concept> ;
	skos:definition	"a name of endearment (especially one using a diminutive suffix)"@en ;
	dc:source	pwn30:06339244-n .

<i69790>	a	<Concept> ;
	skos:definition	"an identifying appellation signifying status or function: e.g. `Mr.' or `General'"@en ;
	dc:source	pwn30:06339416-n .

<i69791>	a	<Concept> ;
	skos:definition	"title for a civil or military leader (especially in Turkey)"@en ;
	dc:source	pwn30:06340047-n .

<i69792>	a	<Concept> ;
	skos:definition	"a title that Leo X bestowed on Henry VIII and later withdrew; parliament restored the title and it has been used by English sovereigns ever since"@en ;
	dc:source	pwn30:06340182-n .

<i69793>	a	<Concept> ;
	skos:definition	"a Spanish courtesy title or form of address for men that is prefixed to the forename"@en ;
	dc:source	pwn30:06340395-n .

<i69794>	a	<Concept> ;
	skos:definition	"a Spanish courtesy title or form of address for a woman"@en ;
	dc:source	pwn30:06340563-n .

<i69795>	a	<Concept> ;
	skos:definition	"a German courtesy title or form of address for an adult woman"@en ;
	dc:source	pwn30:06340707-n .

<i69796>	a	<Concept> ;
	skos:definition	"a German courtesy title or form of address for an unmarried woman"@en ;
	dc:source	pwn30:06340838-n .

<i69797>	a	<Concept> ;
	skos:definition	"a Hebrew title of respect for a wise and highly educated man"@en ;
	dc:source	pwn30:06340977-n .

<i69798>	a	<Concept> ;
	skos:definition	"a German courtesy title or form of address for a man"@en ;
	dc:source	pwn30:06341127-n .

<i69799>	a	<Concept> ;
	skos:definition	"a form of address for an unmarried woman"@en ;
	dc:source	pwn30:06341249-n .

<i69800>	a	<Concept> ;
	skos:definition	"a form of address for a man"@en ;
	dc:source	pwn30:06341340-n .

<i69801>	a	<Concept> ;
	skos:definition	"a form of address for a married woman"@en ;
	dc:source	pwn30:06341431-n .

<i69802>	a	<Concept> ;
	skos:definition	"a form of address for a woman"@en ;
	dc:source	pwn30:06341525-n .

<i69803>	a	<Concept> ;
	skos:definition	"a Hebrew title of respect for a Jewish scholar or teacher"@en ;
	dc:source	pwn30:06341609-n .

<i69804>	a	<Concept> ;
	skos:definition	"a title of respect for a clergyman"@en ;
	dc:source	pwn30:06341773-n .

<i69805>	a	<Concept> ;
	skos:definition	"a Spanish title or form of address for a man; similar to the English `Mr' or `sir'"@en ;
	dc:source	pwn30:06341862-n .

<i69806>	a	<Concept> ;
	skos:definition	"a Spanish title or form of address for a married woman; similar to the English `Mrs' or `madam'"@en ;
	dc:source	pwn30:06342015-n .

<i69807>	a	<Concept> ;
	skos:definition	"a Spanish title or form of address used to or of an unmarried girl or woman; similar to the English `Miss'"@en ;
	dc:source	pwn30:06342182-n .

<i69808>	a	<Concept> ;
	skos:definition	"an Italian title or form of address for a married woman"@en ;
	dc:source	pwn30:06342362-n .

<i69809>	a	<Concept> ;
	skos:definition	"an Italian title or form of address for an unmarried woman"@en ;
	dc:source	pwn30:06342490-n .

<i69810>	a	<Concept> ;
	skos:definition	"a title of respect for various ecclesiastical officials (as cathedral deans and canons and others)"@en ;
	dc:source	pwn30:06342623-n .

<i69811>	a	<Concept> ;
	skos:definition	"a title used to address any British peer except a duke and extended to a bishop or a judge"@en ;
	dc:source	pwn30:06342781-n .

<i69812>	a	<Concept> ;
	skos:definition	"a title used to address any peeress except a duchess"@en ;
	dc:source	pwn30:06342977-n .

<i69813>	a	<Concept> ;
	skos:definition	"an appellation signifying nobility"@en ;
	dc:source	pwn30:06343117-n .

<i69814>	a	<Concept> ;
	skos:definition	"the title of a baron"@en ;
	dc:source	pwn30:06343364-n .

<i69815>	a	<Concept> ;
	skos:definition	"the title of a viscount"@en ;
	dc:source	pwn30:06343440-n .

<i69816>	a	<Concept> ;
	skos:definition	"the name of a work of art or literary composition etc."@en ;
	dc:source	pwn30:06343520-n .

<i69817>	a	<Concept> ;
	skos:definition	"the name by which a geographical place is known"@en ;
	dc:source	pwn30:06343838-n .

<i69818>	a	<Concept> ;
	skos:definition	"a line of text serving to indicate what the passage below it is about"@en ;
	dc:source	pwn30:06343971-n .

<i69819>	a	<Concept> ;
	skos:definition	"a heading of a subsection printed within the body of the text"@en ;
	dc:source	pwn30:06344329-n .

<i69820>	a	<Concept> ;
	skos:definition	"the heading or caption of a newspaper article"@en ;
	dc:source	pwn30:06344461-n .

<i69821>	a	<Concept> ;
	skos:definition	"the heading that indicates the subject of an annotation or a literary composition or a dictionary entry"@en ;
	dc:source	pwn30:06344691-n .

<i69822>	a	<Concept> ;
	skos:definition	"the title of a newspaper or magazine; usually printed on the front page and on the editorial page"@en ;
	dc:source	pwn30:06344846-n .

<i69823>	a	<Concept> ;
	skos:definition	"a title or heading that is printed in red or in a special type"@en ;
	dc:source	pwn30:06344998-n .

<i69824>	a	<Concept> ;
	skos:definition	"a heading printed at the top of every page (or every other page) of a book"@en ;
	dc:source	pwn30:06345131-n .

<i69825>	a	<Concept> ;
	skos:definition	"a heading of a subdivision of a text"@en ;
	dc:source	pwn30:06345320-n .

<i69826>	a	<Concept> ;
	skos:definition	"the title (or a shortened title) of a book used as a running head"@en ;
	dc:source	pwn30:06345441-n .

<i69827>	a	<Concept> ;
	skos:definition	"a headline with the top line flush left and succeeding lines indented to the right"@en ;
	dc:source	pwn30:06345566-n .

<i69828>	a	<Concept> ;
	skos:definition	"a sensational newspaper headline"@en ;
	dc:source	pwn30:06345773-n .

<i69829>	a	<Concept> ;
	skos:definition	"a newspaper headline that runs across the full page"@en ;
	dc:source	pwn30:06345878-n .

<i69830>	a	<Concept> ;
	skos:definition	"a heading that names a statute or legislative bill; may give a brief summary of the matters it deals with"@en ;
	dc:source	pwn30:06345993-n .

<i69831>	a	<Concept> ;
	skos:definition	"(usually plural) written material introduced into a movie or TV show to give credits or represent dialogue or explain an action"@en ;
	dc:source	pwn30:06346220-n .

<i69832>	a	<Concept> ;
	skos:definition	"a general or descriptive heading for a section of a written work"@en ;
	dc:source	pwn30:06346461-n .

<i69833>	a	<Concept> ;
	skos:definition	"an entry on a list of persons who contributed to a film or written work"@en ;
	dc:source	pwn30:06346681-n .

<i69834>	a	<Concept> ;
	skos:definition	"brief description accompanying an illustration"@en ;
	dc:source	pwn30:06346891-n .

<i69835>	a	<Concept> ;
	skos:definition	"secondary or explanatory title"@en ;
	dc:source	pwn30:06347037-n .

<i69836>	a	<Concept> ;
	skos:definition	"an incorrect translation"@en ;
	dc:source	pwn30:06347122-n .

<i69837>	a	<Concept> ;
	skos:definition	"a literal translation used in studying a foreign language (often used illicitly)"@en ;
	dc:source	pwn30:06347225-n .

<i69838>	a	<Concept> ;
	skos:definition	"translation back into the original language"@en ;
	dc:source	pwn30:06347388-n .

<i69839>	a	<Concept> ;
	skos:definition	"translation of foreign dialogue of a movie or TV program; usually displayed at the bottom of the screen"@en ;
	dc:source	pwn30:06347588-n .

<i69840>	a	<Concept> ;
	skos:definition	"translation of the words of a foreign opera (or choral work) projected on a screen above the stage"@en ;
	dc:source	pwn30:06347811-n .

<i69841>	a	<Concept> ;
	skos:definition	"a single line of words in a poem"@en ;
	dc:source	pwn30:06347996-n .

<i69842>	a	<Concept> ;
	skos:definition	"(prosody) a line of verse that has the full number of syllables"@en ;
	dc:source	pwn30:06348215-n .

<i69843>	a	<Concept> ;
	skos:definition	"(prosody) a line of verse that has six iambic feet"@en ;
	dc:source	pwn30:06348373-n .

<i69844>	a	<Concept> ;
	skos:definition	"(prosody) a line of verse that lacks a syllable in the last metrical foot"@en ;
	dc:source	pwn30:06348500-n .

<i69845>	a	<Concept> ;
	skos:definition	"(prosody) a line of poetry having an extra syllable or syllables at the end of the last metrical foot"@en ;
	dc:source	pwn30:06348685-n .

