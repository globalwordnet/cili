	dc:source	pwn30:05303402-n .

<i64829>	a	<Concept> ;
	skos:definition	"a natural cavity or hollow in a bone"@en ;
	dc:source	pwn30:05304252-n .

<i64830>	a	<Concept> ;
	skos:definition	"(zoology) the cavity (in birds, reptiles, amphibians, most fish, and monotremes but not mammals) at the end of the digestive tract into which the intestinal, genital, and urinary tracts open"@en ;
	dc:source	pwn30:05304341-n .

