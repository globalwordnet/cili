	skos:definition	"large genus of tropical American epiphytic orchids with persistent leathery leaves and single-flowered scapes"@en ;
	dc:source	pwn30:12073007-n .

<i100606>	a	<Concept> ;
	skos:definition	"any of numerous orchids of the genus Maxillaria often cultivated for their large brilliantly colored solitary flowers"@en ;
	dc:source	pwn30:12073217-n .

<i100607>	a	<Concept> ;
	skos:definition	"genus of tropical American orchids"@en ;
	dc:source	pwn30:12073410-n .

<i100608>	a	<Concept> ;
	skos:definition	"any of various orchids of the genus Miltonia having solitary or loosely racemose showy broadly spreading flowers"@en ;
	dc:source	pwn30:12073554-n .

