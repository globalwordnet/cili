	skos:definition	"a heavy brittle diamagnetic trivalent metallic element (resembles arsenic and antimony chemically); usually recovered as a by-product from ores of other metals"@en ;
	dc:source	pwn30:14631502-n .

<i113907>	a	<Concept> ;
	skos:definition	"a transuranic element"@en ;
	dc:source	pwn30:14631757-n .

<i113908>	a	<Concept> ;
