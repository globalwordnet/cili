	dc:source	pwn30:05586446-n .

<i66273>	a	<Concept> ;
	skos:definition	"the exterior protective or supporting structure or shell of many animals (especially invertebrates) including bony or horny parts such as nails or scales or hoofs"@en ;
	dc:source	pwn30:05586759-n .

<i66274>	a	<Concept> ;
	skos:definition	"the part of the skeleton that includes the pectoral girdle and the pelvic girdle and the upper and lower limbs"@en ;
	dc:source	pwn30:05587034-n .

<i66275>	a	<Concept> ;
	skos:definition	"the part of the skeleton that includes the skull and spinal column and sternum and ribs"@en ;
	dc:source	pwn30:05587288-n .

<i66276>	a	<Concept> ;
	skos:definition	"a skeletal muscle of the trunk or head"@en ;
	dc:source	pwn30:05587531-n .

<i66277>	a	<Concept> ;
	skos:definition	"one of two processes that extend from each vertebra and provide the point of articulation for the ribs"@en ;
	dc:source	pwn30:05587628-n .

<i66278>	a	<Concept> ;
	skos:definition	"a structure arising ventrally from a vertebral centrum and enclosing the caudal blood vessels"@en ;
	dc:source	pwn30:05587814-n .

<i66279>	a	<Concept> ;
	skos:definition	"a structure arising dorsally from a vertebral centrum and enclosing the spinal cord"@en ;
	dc:source	pwn30:05587997-n .

<i66280>	a	<Concept> ;
	skos:definition	"the series of vertebrae forming the axis of the skeleton and protecting the spinal cord"@en ;
	dc:source	pwn30:05588174-n .

<i66281>	a	<Concept> ;
	skos:definition	"one of 7 vertebrae in the human spine located in the neck region"@en ;
	dc:source	pwn30:05588551-n .

<i66282>	a	<Concept> ;
	skos:definition	"the 1st cervical vertebra"@en ;
	dc:source	pwn30:05588746-n .

<i66283>	a	<Concept> ;
	skos:definition	"the 2nd cervical vertebra; serves as a pivot for turning the head"@en ;
	dc:source	pwn30:05588840-n .

<i66284>	a	<Concept> ;
	skos:definition	"a toothlike process at the back of 2nd vertebra of the neck"@en ;
	dc:source	pwn30:05588991-n .

<i66285>	a	<Concept> ;
	skos:definition	"one of 12 vertebrae in the human vertebral column; thoracic vertebrae extend from the seventh cervical vertebra down to the first lumbar vertebra"@en ;
	dc:source	pwn30:05589132-n .

<i66286>	a	<Concept> ;
	skos:definition	"one of 5 vertebrae in the human vertebral column; lumbar vertebrae extend from the twelfth thoracic vertebra down to the sacral vertebrae"@en ;
	dc:source	pwn30:05589378-n .

<i66287>	a	<Concept> ;
	skos:definition	"one of 5 vertebrae in the human spine that fuse in the adult to form the sacrum"@en ;
	dc:source	pwn30:05589596-n .

<i66288>	a	<Concept> ;
	skos:definition	"one of 4 vertebrae in the human coccyx"@en ;
	dc:source	pwn30:05589756-n .

<i66289>	a	<Concept> ;
	skos:definition	"a muscle in the thigh that helps to rotate the leg into the sitting position assumed by a tailor; the longest muscle in the human body"@en ;
	dc:source	pwn30:05589896-n .

<i66290>	a	<Concept> ;
	skos:definition	"any of four pairs of muscles extending from the cervical vertebrae to the second rib; involved in moving the neck and in breathing"@en ;
	dc:source	pwn30:05590144-n .

<i66291>	a	<Concept> ;
	skos:definition	"one of two thick muscles running from the sternum and clavicle to the mastoid and occipital bone; turns head obliquely to the opposite side; when acting together they flex the neck and extend the head"@en ;
	dc:source	pwn30:05590366-n .

<i66292>	a	<Concept> ;
	skos:definition	"either of two muscles in the shoulder region that move the shoulders and arms"@en ;
	dc:source	pwn30:05590740-n .

<i66293>	a	<Concept> ;
	skos:definition	"teres muscle that moves the arm and rotates it medially"@en ;
	dc:source	pwn30:05590939-n .

<i66294>	a	<Concept> ;
	skos:definition	"teres muscle that adducts the arm and rotates it laterally"@en ;
	dc:source	pwn30:05591096-n .

<i66295>	a	<Concept> ;
	skos:definition	"either of two skeletal muscle in each leg arising from the tibia; provides for movement of the foot"@en ;
	dc:source	pwn30:05591256-n .

<i66296>	a	<Concept> ;
	skos:definition	"a muscle running from the tibia to the first metatarsal and cuneiform bones"@en ;
	dc:source	pwn30:05591503-n .

<i66297>	a	<Concept> ;
	skos:definition	"a deep muscle of the leg"@en ;
	dc:source	pwn30:05591661-n .

<i66298>	a	<Concept> ;
	skos:definition	"either of two flat triangular muscles of the shoulder and upper back that are involved in moving the shoulders and arms"@en ;
	dc:source	pwn30:05591770-n .

<i66299>	a	<Concept> ;
	skos:definition	"one of the first seven ribs in a human being which attach to the sternum"@en ;
	dc:source	pwn30:05591999-n .

<i66300>	a	<Concept> ;
	skos:definition	"a riblike part of a plant or animal (such as a middle rib of a leaf or a thickened vein of an insect wing)"@en ;
	dc:source	pwn30:05592126-n .

<i66301>	a	<Concept> ;
	skos:definition	"the cartilages that connect the sternum and the ends of the ribs; its elasticity allows the chest to move in respiration"@en ;
	dc:source	pwn30:05592302-n .

<i66302>	a	<Concept> ;
	skos:definition	"the end of a long bone; initially separated from the main bone by a layer of cartilage that eventually ossifies so the parts become fused"@en ;
	dc:source	pwn30:05592504-n .

<i66303>	a	<Concept> ;
	skos:definition	"the main (mid) section of a long bone"@en ;
	dc:source	pwn30:05592733-n .

<i66304>	a	<Concept> ;
	skos:definition	"the growing part of a long bone between the diaphysis and the epiphysis"@en ;
	dc:source	pwn30:05592870-n .

<i66305>	a	<Concept> ;
	skos:definition	"a bone in the arm"@en ;
	dc:source	pwn30:05593017-n .

<i66306>	a	<Concept> ;
	skos:definition	"bone extending from the shoulder to the elbow"@en ;
	dc:source	pwn30:05593181-n .

<i66307>	a	<Concept> ;
	skos:definition	"the outer and slightly shorter of the two bones of the human forearm"@en ;
	dc:source	pwn30:05593318-n .

<i66308>	a	<Concept> ;
	skos:definition	"the inner and longer of the two bones of the human forearm"@en ;
	dc:source	pwn30:05593476-n .

<i66309>	a	<Concept> ;
	skos:definition	"process of the ulna that forms the outer bump of the elbow and fits into the fossa of the humerus when the arm is extended"@en ;
	dc:source	pwn30:05593654-n .

<i66310>	a	<Concept> ;
	skos:definition	"the part of the hand between the carpus and phalanges"@en ;
	dc:source	pwn30:05593871-n .

<i66311>	a	<Concept> ;
	skos:definition	"a bone of the leg"@en ;
	dc:source	pwn30:05594037-n .

<i66312>	a	<Concept> ;
	skos:definition	"the outer and thinner of the two bones of the human leg between the knee and ankle"@en ;
	dc:source	pwn30:05594201-n .

<i66313>	a	<Concept> ;
	skos:definition	"the inner and thicker of the two bones of the human leg between the knee and ankle"@en ;
	dc:source	pwn30:05594367-n .

<i66314>	a	<Concept> ;
	skos:definition	"the skeleton of the human foot between the toes and the tarsus; the corresponding part of the foot in birds or of the hind foot in quadrupeds"@en ;
	dc:source	pwn30:05594568-n .

<i66315>	a	<Concept> ;
	skos:definition	"the part of the foot of a vertebrate between the metatarsus and the leg; in human beings the bones of the ankle and heel collectively"@en ;
	dc:source	pwn30:05594822-n .

<i66316>	a	<Concept> ;
	skos:definition	"(anatomy) the point of connection between two bones or elements of a skeleton (especially if it allows motion)"@en ;
	dc:source	pwn30:05595083-n .

<i66317>	a	<Concept> ;
	skos:definition	"a freely moving joint in which a sphere on the head of one bone fits into a rounded cavity in the other bone"@en ;
	dc:source	pwn30:05595531-n .

<i66318>	a	<Concept> ;
	skos:definition	"the rounded end of a bone that fits into a rounded cavity in another bone to form a joint"@en ;
	dc:source	pwn30:05595837-n .

<i66319>	a	<Concept> ;
	skos:definition	"the ball-and-socket joint between the head of the femur and the acetabulum"@en ;
	dc:source	pwn30:05596004-n .

<i66320>	a	<Concept> ;
	skos:definition	"the cup-shaped hollow in the hipbone into which the head of the femur fits to form a ball-and-socket joint"@en ;
	dc:source	pwn30:05596224-n .

<i66321>	a	<Concept> ;
	skos:definition	"a structure shaped like a funnel in the outlet of the kidney into which urine is discharged before passing into the ureter"@en ;
	dc:source	pwn30:05596442-n .

<i66322>	a	<Concept> ;
	skos:definition	"the structure of the vertebrate skeleton supporting the lower limbs in humans and the hind limbs or corresponding parts in other vertebrates"@en ;
	dc:source	pwn30:05596651-n .

<i66323>	a	<Concept> ;
	skos:definition	"the space bounded by the bones of the pelvis and containing the pelvic viscera"@en ;
	dc:source	pwn30:05597050-n .

<i66324>	a	<Concept> ;
	skos:definition	"a freely moving joint in which movement is limited to rotation"@en ;
	dc:source	pwn30:05597188-n .

<i66325>	a	<Concept> ;
	skos:definition	"the angle formed by the inner sides of the legs where they join the human trunk"@en ;
	dc:source	pwn30:05597436-n .

<i66326>	a	<Concept> ;
	skos:definition	"the region of the hips and groin and lower abdomen"@en ;
	dc:source	pwn30:05597594-n .

<i66327>	a	<Concept> ;
	skos:definition	"the crease at the junction of the inner part of the thigh with the trunk together with the adjacent region and often including the external genitals"@en ;
	dc:source	pwn30:05597734-n .

<i66328>	a	<Concept> ;
	skos:definition	"any area of the body that is highly sensitive to pain (as the flesh underneath the skin or a fingernail or toenail)"@en ;
	dc:source	pwn30:05597980-n .

<i66329>	a	<Concept> ;
	skos:definition	"the organ of smell and entrance to the respiratory tract; the prominent part of the face of man or other mammals"@en ;
	dc:source	pwn30:05598147-n .

<i66330>	a	<Concept> ;
	skos:definition	"informal terms for the nose"@en ;
	dc:source	pwn30:05598707-n .

<i66331>	a	<Concept> ;
	skos:definition	"informal term for the nose"@en ;
	dc:source	pwn30:05598868-n .

<i66332>	a	<Concept> ;
	skos:definition	"a nose curved downward like the beak of a hawk"@en ;
	dc:source	pwn30:05598982-n .

<i66333>	a	<Concept> ;
	skos:definition	"the human nose (especially when it is large)"@en ;
	dc:source	pwn30:05599084-n .

<i66334>	a	<Concept> ;
	skos:definition	"the hard ridge that forms the upper part of the nose"@en ;
	dc:source	pwn30:05599203-n .

<i66335>	a	<Concept> ;
	skos:definition	"a short nose; flattened and turned up at the end"@en ;
	dc:source	pwn30:05599398-n .

<i66336>	a	<Concept> ;
	skos:definition	"a nose with a prominent slightly aquiline bridge"@en ;
	dc:source	pwn30:05599501-n .

<i66337>	a	<Concept> ;
	skos:definition	"the protruding part of the lower jaw"@en ;
	dc:source	pwn30:05599617-n .

<i66338>	a	<Concept> ;
	skos:definition	"a fold of fatty tissue under the chin"@en ;
	dc:source	pwn30:05599769-n .

<i66339>	a	<Concept> ;
	skos:definition	"a small natural hollow in the cheek or chin"@en ;
	dc:source	pwn30:05599874-n .

<i66340>	a	<Concept> ;
	skos:definition	"a long thin lower jaw"@en ;
	dc:source	pwn30:05600030-n .

<i66341>	a	<Concept> ;
	skos:definition	"either one of the two external openings to the nasal cavity in the nose"@en ;
	dc:source	pwn30:05600109-n .

<i66342>	a	<Concept> ;
	skos:definition	"either one of the two posterior openings at the back of the nasal cavity leading to the nasopharynx"@en ;
	dc:source	pwn30:05600270-n .

<i66343>	a	<Concept> ;
	skos:definition	"any of the openings to the nasal cavities that allow air to flow through the cavities to the pharynx"@en ;
	dc:source	pwn30:05600431-n .

<i66344>	a	<Concept> ;
	skos:definition	"the front of the human head from the forehead to the chin and ear to ear"@en ;
	dc:source	pwn30:05600637-n .

<i66345>	a	<Concept> ;
	skos:definition	"the part of an animal corresponding to the human face"@en ;
	dc:source	pwn30:05601198-n .

<i66346>	a	<Concept> ;
	skos:definition	"the human face (`kisser' and `smiler' and `mug' are informal terms for `face' and `phiz' is British)"@en ;
	dc:source	pwn30:05601357-n .

<i66347>	a	<Concept> ;
	skos:definition	"a large fat human face"@en ;
	dc:source	pwn30:05601662-n .

<i66348>	a	<Concept> ;
	skos:definition	"the characteristic parts of a person's face: eyes and nose and mouth and chin"@en ;
	dc:source	pwn30:05601758-n .

<i66349>	a	<Concept> ;
	skos:definition	"any of the skeletal muscles of the face"@en ;
	dc:source	pwn30:05602132-n .

<i66350>	a	<Concept> ;
	skos:definition	"muscle extending from the temporal fossa to the coronoid process of the mandible; acts to raise the mandible and close the jaws"@en ;
	dc:source	pwn30:05602304-n .

<i66351>	a	<Concept> ;
	skos:definition	"the part of the face above the eyes"@en ;
	dc:source	pwn30:05602548-n .

<i66352>	a	<Concept> ;
	skos:definition	"the flat area on either side of the forehead"@en ;
	dc:source	pwn30:05602683-n .

<i66353>	a	<Concept> ;
	skos:definition	"either side of the face below the eyes"@en ;
	dc:source	pwn30:05602835-n .

<i66354>	a	<Concept> ;
	skos:definition	"a fullness and looseness of the flesh of the lower cheek and jaw (characteristic of aging)"@en ;
	dc:source	pwn30:05602982-n .

<i66355>	a	<Concept> ;
	skos:definition	"the bones of the skull that frame the mouth and serve to open it; the bones that hold the teeth"@en ;
	dc:source	pwn30:05603160-n .

<i66356>	a	<Concept> ;
	skos:definition	"any long raised border or margin of a bone or tooth or membrane"@en ;
	dc:source	pwn30:05603342-n .

<i66357>	a	<Concept> ;
	skos:definition	"a ridge on the frontal bone above the eye socket"@en ;
	dc:source	pwn30:05603475-n .

<i66358>	a	<Concept> ;
	skos:definition	"(pathology) an abnormal outgrowth or enlargement of some part of the body"@en ;
	dc:source	pwn30:05603650-n .

<i66359>	a	<Concept> ;
	skos:definition	"an abnormal growth or excrescence (especially a warty excrescence on the valves of the heart)"@en ;
	dc:source	pwn30:05603854-n .

<i66360>	a	<Concept> ;
	skos:definition	"the remains of a body part that was functional at an earlier stage of life"@en ;
	dc:source	pwn30:05604022-n .

<i66361>	a	<Concept> ;
	skos:definition	"(anatomy) a layer (a lining or membrane) that encloses a structure"@en ;
	dc:source	pwn30:05604254-n .

<i66362>	a	<Concept> ;
	skos:definition	"a wall of the abdomen"@en ;
	dc:source	pwn30:05604434-n .

<i66363>	a	<Concept> ;
	skos:definition	"(Middle Ages) one of the four fluids in the body whose balance was believed to determine your emotional and physical state"@en ;
	dc:source	pwn30:05604535-n .

<i66364>	a	<Concept> ;
	skos:definition	"the membrane surrounding the heart"@en ;
	dc:source	pwn30:05604854-n .

<i66365>	a	<Concept> ;
	skos:definition	"a supporting structure of the shoulder consisting of the muscles and tendons that attach the arm to the shoulder joint and enable the arm to move"@en ;
	dc:source	pwn30:05604950-n .

<i66366>	a	<Concept> ;
	skos:definition	"the center in the medulla oblongata and pons that integrates sensory information about the level of oxygen and carbon dioxide in the blood and determines the signals to be sent to the respiratory muscles"@en ;
	dc:source	pwn30:05605192-n .

<i66367>	a	<Concept> ;
	skos:definition	"(biology) tiny fibers that are seen in cell division; the fibers radiate from two poles and meet at the equator in the middle"@en ;
	dc:source	pwn30:05605498-n .

<i66368>	a	<Concept> ;
	skos:definition	"a mass of cytoplasm containing several nuclei and enclosed in a membrane but no internal cell boundaries (as in muscle fibers)"@en ;
	dc:source	pwn30:05605762-n .

<i66369>	a	<Concept> ;
	skos:definition	"a thin membrane lining the closed cavities of the body; has two layers with a space between that is filled with serous fluid"@en ;
	dc:source	pwn30:05605944-n .

<i66370>	a	<Concept> ;
	skos:definition	"a thin membrane in synovial (freely moving) joints that lines the joint capsule and secretes synovial fluid"@en ;
	dc:source	pwn30:05606247-n .

<i66371>	a	<Concept> ;
	skos:definition	"whitish cover of the testicle"@en ;
	dc:source	pwn30:05606429-n .

<i66372>	a	<Concept> ;
	skos:definition	"whitish tunic"@en ;
	dc:source	pwn30:05606528-n .

<i66373>	a	<Concept> ;
	skos:definition	"an enveloping or covering membrane or layer of body tissue"@en ;
	dc:source	pwn30:05606633-n .

<i66374>	a	<Concept> ;
	skos:definition	"a cavity in the mesoderm of an embryo that gives rise in humans to the pleural cavity and pericardial cavity and peritoneal cavity"@en ;
	dc:source	pwn30:05606801-n .

<i66375>	a	<Concept> ;
	skos:definition	"(anatomy) any structure that resembles a horn in shape"@en ;
	dc:source	pwn30:05607001-n .

<i66376>	a	<Concept> ;
	skos:definition	"(anatomy) any structure that resembles a crown in shape"@en ;
	dc:source	pwn30:05607126-n .

<i66377>	a	<Concept> ;
	skos:definition	"(anatomy) a fold or wrinkle or crease"@en ;
	dc:source	pwn30:05607271-n .

<i66378>	a	<Concept> ;
	skos:definition	"(anatomy) a fold of dura mater that covers the cerebellum and supports the occipital lobes of the cerebrum"@en ;
	dc:source	pwn30:05607402-n .

<i66379>	a	<Concept> ;
	skos:definition	"a large connective tissue cell that contains histamine and heparin and serotonin which are released in allergic reactions or in response to injury or inflammation"@en ;
	dc:source	pwn30:05607602-n .

<i66380>	a	<Concept> ;
	skos:definition	"an undifferentiated cell whose daughter cells may differentiate into other cell types (such as blood cells)"@en ;
	dc:source	pwn30:05607863-n .

<i66381>	a	<Concept> ;
	skos:definition	"blood forming stem cells in the bone marrow; T cells and B cells arise from these stem cells"@en ;
	dc:source	pwn30:05608044-n .

<i66382>	a	<Concept> ;
	skos:definition	"any cell that has a specific receptor for an antigen or antibody or hormone or drug, or is the focus of contact by a virus or phagocyte or nerve fiber etc."@en ;
	dc:source	pwn30:05608206-n .

<i66383>	a	<Concept> ;
	skos:definition	"a point one third of the way along a line drawn from the hip to the umbilicus; the point of maximum sensitivity in acute appendicitis"@en ;
	dc:source	pwn30:05608419-n .

<i66384>	a	<Concept> ;
	skos:definition	"thick membrane around the mammalian ovum; can be penetrated by one sperm in the fertilization process; usually remains around the fertilized egg until it is implanted in the wall of the uterus"@en ;
	dc:source	pwn30:05608615-n .

<i66385>	a	<Concept> ;
	skos:definition	"a cellular structure that is postulated to exist in order to mediate between a chemical agent that acts on nervous tissue and the physiological response"@en ;
	dc:source	pwn30:05608868-n .

<i66386>	a	<Concept> ;
	skos:definition	"receptors postulated to exist on nerve cell membranes of the sympathetic nervous system in order to explain the specificity of certain agents that affect only some sympathetic activities (such as vasoconstriction and relaxation of intestinal muscles and contraction of smooth muscles)"@en ;
	dc:source	pwn30:05609111-n .

<i66387>	a	<Concept> ;
	skos:definition	"receptors postulated to exist on nerve cell membranes of the sympathetic nervous system in order to explain the specificity of certain agents that affect only some sympathetic activities (such as vasodilation and increased heart beat)"@en ;
	dc:source	pwn30:05609524-n .

<i66388>	a	<Concept> ;
	skos:definition	"a small recess in the wall of the pharynx"@en ;
	dc:source	pwn30:05609884-n .

<i66389>	a	<Concept> ;
	skos:definition	"a narrow elongated opening or fissure between two symmetrical parts"@en ;
	dc:source	pwn30:05610008-n .

<i66390>	a	<Concept> ;
	skos:definition	"the space between the two true vocal folds"@en ;
	dc:source	pwn30:05610198-n .

<i66391>	a	<Concept> ;
	skos:definition	"the opening between the false vocal folds"@en ;
	dc:source	pwn30:05610365-n .

<i66392>	a	<Concept> ;
	skos:definition	"either (free) end of a eukaryotic chromosome"@en ;
	dc:source	pwn30:05610520-n .

<i66393>	a	<Concept> ;
	skos:definition	"thin trapezoidal bone of the skull forming the posterior and inferior parts of the nasal septum"@en ;
	dc:source	pwn30:05610734-n .

<i66394>	a	<Concept> ;
	skos:definition	"any of the tiny soft bones found in the sutures between cranial bones"@en ;
	dc:source	pwn30:05610919-n .

<i66395>	a	<Concept> ;
	skos:definition	"(anatomy) any encircling or beltlike structure"@en ;
	dc:source	pwn30:05611062-n .

<i66396>	a	<Concept> ;
	skos:definition	"small beltlike zone"@en ;
	dc:source	pwn30:05611221-n .

<i66397>	a	<Concept> ;
	skos:definition	"that which is responsible for one's thoughts and feelings; the seat of the faculty of reason"@en ;
	dc:source	pwn30:05611302-n .

<i66398>	a	<Concept> ;
	skos:definition	"an informal British expression for head or mind"@en ;
	dc:source	pwn30:05611684-n .

<i66399>	a	<Concept> ;
	skos:definition	"an abstract mental location"@en ;
	dc:source	pwn30:05611822-n .

<i66400>	a	<Concept> ;
	skos:definition	"knowledge that is available to anyone"@en ;
	dc:source	pwn30:05612067-n .

<i66401>	a	<Concept> ;
	skos:definition	"anything generally known to everyone"@en ;
	dc:source	pwn30:05612241-n .

<i66402>	a	<Concept> ;
	skos:definition	"the body of ideas that determine the knowledge that is intellectually certain at any particular time"@en ;
