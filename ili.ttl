<i97550>	a	<Concept> ;
	skos:definition	"all phenomena that are not artificial"@en ;
	dc:source	pwn30:11408559-n .

<i97551>	a	<Concept> ;
	skos:definition	"the phenomenon of a person or thing rising into the air by apparently supernatural means"@en ;
	dc:source	pwn30:11408733-n .

<i97552>	a	<Concept> ;
	skos:definition	"after death the soul begins a new cycle of existence in another human body"@en ;
	dc:source	pwn30:11408914-n .

<i97553>	a	<Concept> ;
	skos:definition	"any natural phenomenon involving chemistry (as changes to atoms or molecules)"@en ;
	dc:source	pwn30:11409059-n .

<i97554>	a	<Concept> ;
	skos:definition	"the phenomenon of an element existing in two or more physical forms"@en ;
	dc:source	pwn30:11409329-n .

<i97555>	a	<Concept> ;
	skos:definition	"chemical process in which one atom or ion or group changes places with another"@en ;
	dc:source	pwn30:11409538-n .

<i97556>	a	<Concept> ;
	skos:definition	"change in the electrical conductivity of a substance as a result of absorbing electromagnetic radiation"@en ;
	dc:source	pwn30:11409689-n .

<i97557>	a	<Concept> ;
	skos:definition	"the disappearance of electrical resistance at very low temperatures"@en ;
	dc:source	pwn30:11409892-n .

<i97558>	a	<Concept> ;
	skos:definition	"an exchange produced by the chemical action of radiant energy (especially light)"@en ;
	dc:source	pwn30:11410023-n .

<i97559>	a	<Concept> ;
	skos:definition	"an emission of photoelectrons (especially from a metallic surface)"@en ;
	dc:source	pwn30:11410172-n .

<i97560>	a	<Concept> ;
	skos:definition	"the formation of crystals"@en ;
	dc:source	pwn30:11410298-n .

<i97561>	a	<Concept> ;
	skos:definition	"a powdery deposit on a surface"@en ;
	dc:source	pwn30:11410527-n .

<i97562>	a	<Concept> ;
	skos:definition	"a phenomenon that follows and is caused by some previous phenomenon"@en ;
	dc:source	pwn30:11410625-n .

<i97563>	a	<Concept> ;
	skos:definition	"any result that follows its cause after an interval"@en ;
	dc:source	pwn30:11411501-n .

<i97564>	a	<Concept> ;
	skos:definition	"the consequences of an event (especially a catastrophic event)"@en ;
	dc:source	pwn30:11411610-n .

<i97565>	a	<Concept> ;
	skos:definition	"the phenomenon of a popular trend attracting even greater popularity"@en ;
	dc:source	pwn30:11411839-n .

<i97566>	a	<Concept> ;
	skos:definition	"the shattering or crushing effect of a sudden release of energy as in an explosion"@en ;
	dc:source	pwn30:11412179-n .

<i97567>	a	<Concept> ;
	skos:definition	"the phenomenon whereby a small change at one place in a complex system can have large effects elsewhere, e.g., a butterfly flapping its wings in Rio de Janeiro might change the weather in Chicago"@en ;
	dc:source	pwn30:11412334-n .

<i97568>	a	<Concept> ;
	skos:definition	"a secondary and sometimes unexpected consequence"@en ;
	dc:source	pwn30:11412592-n .

<i97569>	a	<Concept> ;
	skos:definition	"the result of alteration or modification"@en ;
	dc:source	pwn30:11412727-n .

<i97570>	a	<Concept> ;
	skos:definition	"(politics) the consequence of one popular candidate in an election drawing votes for other members of the same political party"@en ;
	dc:source	pwn30:11412993-n .

<i97571>	a	<Concept> ;
	skos:definition	"(physics) an effect whereby a body moving in a rotating frame of reference experiences the Coriolis force acting perpendicular to the direction of motion and to the axis of rotation; on Earth the Coriolis effect deflects moving bodies to the right in the northern hemisphere and to the left in the southern hemisphere"@en ;
	dc:source	pwn30:11413263-n .

<i97572>	a	<Concept> ;
	skos:definition	"an appreciable consequence (especially a lessening)"@en ;
	dc:source	pwn30:11413661-n .

<i97573>	a	<Concept> ;
	skos:definition	"the organic phenomenon in which one of a pair of alleles present in a genotype is expressed in the phenotype and the other allele of the pair is not"@en ;
	dc:source	pwn30:11413800-n .

<i97574>	a	<Concept> ;
	skos:definition	"the consequence of one event setting off a chain of similar events (like a falling domino causing a whole row of upended dominos to fall)"@en ;
	dc:source	pwn30:11414041-n .

<i97575>	a	<Concept> ;
	skos:definition	"the consequence of an effort or activity"@en ;
	dc:source	pwn30:11414257-n .

<i97576>	a	<Concept> ;
	skos:definition	"a forceful consequence; a strong effect"@en ;
	dc:source	pwn30:11414411-n .

<i97577>	a	<Concept> ;
	skos:definition	"the effect of one thing (or person) on another"@en ;
	dc:source	pwn30:11414608-n .

<i97578>	a	<Concept> ;
	skos:definition	"(physics) a secondary influence on a system that causes it to deviate slightly"@en ;
	dc:source	pwn30:11414874-n .

<i97579>	a	<Concept> ;
