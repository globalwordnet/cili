	dc:source	pwn30:06873139-n .

<i72613>	a	<Concept> ;
	skos:definition	"communication that relies on vision"@en ;
	dc:source	pwn30:06873252-n .

<i72614>	a	<Concept> ;
	skos:definition	"a signal that involves visual communication"@en ;
	dc:source	pwn30:06873571-n .

<i72615>	a	<Concept> ;
	skos:definition	"a fire lighted at night as a signal"@en ;
	dc:source	pwn30:06873927-n .

