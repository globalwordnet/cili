	dc:source	pwn30:06557827-n .

<i70924>	a	<Concept> ;
	skos:definition	"a court order prohibiting a party from doing a certain activity"@en ;
	dc:source	pwn30:06558088-n .

<i70925>	a	<Concept> ;
	skos:definition	"a summons that commands the appearance of a party at a proceeding"@en ;
	dc:source	pwn30:06558277-n .

<i70926>	a	<Concept> ;
