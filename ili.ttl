	dc:source	pwn30:01182312-n .

<i41595>	a	<Concept> ;
	skos:definition	"a comprehensive term for any proceeding in a court of law whereby an individual seeks a legal remedy"@en ;
	dc:source	pwn30:01182654-n .

<i41596>	a	<Concept> ;
	skos:definition	"a lawsuit alleging violations of civil law by the defendant"@en ;
	dc:source	pwn30:01183031-n .

<i41597>	a	<Concept> ;
	skos:definition	"a lawsuit brought by a representative member of a large group of people on behalf of all members of the group"@en ;
	dc:source	pwn30:01183166-n .

<i41598>	a	<Concept> ;
	skos:definition	"a suit brought against someone who has sued you"@en ;
	dc:source	pwn30:01183373-n .

<i41599>	a	<Concept> ;
	skos:definition	"a lawsuit alleging violations of criminal law by the defendant"@en ;
	dc:source	pwn30:01183497-n .

<i41600>	a	<Concept> ;
	skos:definition	"a hypothetical case that law students argue as an exercise"@en ;
	dc:source	pwn30:01183638-n .

<i41601>	a	<Concept> ;
	skos:definition	"a lawsuit filed to determine the father of a child born out of wedlock (and to provide for the support of the child once paternity is determined)"@en ;
	dc:source	pwn30:01183798-n .

<i41602>	a	<Concept> ;
	skos:definition	"a legal action brought against parties who are charged with limiting free competition in the market place"@en ;
	dc:source	pwn30:01184045-n .

<i41603>	a	<Concept> ;
	skos:definition	"legal action to protect a private civil right or to compel a civil remedy (as distinguished from criminal prosecution)"@en ;
	dc:source	pwn30:01184230-n .

<i41604>	a	<Concept> ;
	skos:definition	"a claim filed in opposition to another claim in a legal action"@en ;
	dc:source	pwn30:01184407-n .

<i41605>	a	<Concept> ;
	skos:definition	"a legal action to determine custody (usually of children following a divorce)"@en ;
	dc:source	pwn30:01184565-n .

<i41606>	a	<Concept> ;
	skos:definition	"a pending lawsuit"@en ;
	dc:source	pwn30:01184720-n .

<i41607>	a	<Concept> ;
	skos:definition	"(law) the institution of a sequence of steps by which legal judgments are invoked"@en ;
	dc:source	pwn30:01184814-n .

<i41608>	a	<Concept> ;
	skos:definition	"a legal proceeding that creates a parent-child relation between persons not related by blood; the adopted child is entitled to all privileges belonging to a natural child of the adoptive parents (including the right to inherit)"@en ;
	dc:source	pwn30:01185292-n .

<i41609>	a	<Concept> ;
	skos:definition	"(law) a legal proceeding in which the appellant resorts to a higher court for the purpose of obtaining a review of a lower court decision and a reversal of the lower court's judgment or the granting of a new trial"@en ;
	dc:source	pwn30:01185611-n .

<i41610>	a	<Concept> ;
	skos:definition	"a judgment by a higher court that the judgment of a lower court was incorrect and should be set aside"@en ;
	dc:source	pwn30:01185981-n .

<i41611>	a	<Concept> ;
	skos:definition	"a judgment by a higher court that the judgment of a lower court was correct and should stand"@en ;
	dc:source	pwn30:01186192-n .

<i41612>	a	<Concept> ;
	skos:definition	"a legal process intended to insure equality among the creditors of a corporation declared to be insolvent"@en ;
	dc:source	pwn30:01186397-n .

<i41613>	a	<Concept> ;
	skos:definition	"a court action that places property under the control of a receiver during litigation so that it can be preserved for the benefit of all"@en ;
	dc:source	pwn30:01186578-n .

<i41614>	a	<Concept> ;
	skos:definition	"a legal proceeding in a court; a judicial contest to determine and enforce legal rights"@en ;
	dc:source	pwn30:01186810-n .

<i41615>	a	<Concept> ;
	skos:definition	"litigation to settle custody of the children of a divorced couple"@en ;
	dc:source	pwn30:01187085-n .

<i41616>	a	<Concept> ;
	skos:definition	"litigation shown to have been instituted maliciously and without probable cause"@en ;
	dc:source	pwn30:01187230-n .

<i41617>	a	<Concept> ;
	skos:definition	"an accusation of crime made by a grand jury on its own initiative"@en ;
	dc:source	pwn30:01187463-n .

<i41618>	a	<Concept> ;
	skos:definition	"the proceeding whereby a foreigner is granted citizenship"@en ;
	dc:source	pwn30:01187620-n .

<i41619>	a	<Concept> ;
	skos:definition	"(law) the determination by a court of competent jurisdiction on matters submitted to it"@en ;
	dc:source	pwn30:01187810-n .

<i41620>	a	<Concept> ;
	skos:definition	"a judgment entered after a written confession by the debtor without the expense of ordinary legal proceedings"@en ;
	dc:source	pwn30:01188273-n .

<i41621>	a	<Concept> ;
	skos:definition	"a judgment entered in favor of the plaintiff when the defendant defaults (fails to appear in court)"@en ;
	dc:source	pwn30:01188537-n .

<i41622>	a	<Concept> ;
	skos:definition	"a judgment entered in favor of the defendant when the plaintiff has not continued his action (e.g., has not appeared in court)"@en ;
	dc:source	pwn30:01188783-n .

<i41623>	a	<Concept> ;
	skos:definition	"a judgment disposing of the case before the court; after the judgment (or an appeal from it) is rendered all that remains is to enforce the judgment"@en ;
	dc:source	pwn30:01189001-n .

<i41624>	a	<Concept> ;
	skos:definition	"(criminal law) a final judgment of guilty in a criminal case and the punishment that is imposed"@en ;
	dc:source	pwn30:01189282-n .

<i41625>	a	<Concept> ;
	skos:definition	"a judgment rendered against an individual (or corporation) for the payment of money damages"@en ;
	dc:source	pwn30:01189650-n .

<i41626>	a	<Concept> ;
	skos:definition	"a judgment pronounced on the status of some particular subject or property or thing (as opposed to one pronounced on persons)"@en ;
	dc:source	pwn30:01189929-n .

<i41627>	a	<Concept> ;
	skos:definition	"a judgment disposing of the matter without a trial"@en ;
	dc:source	pwn30:01190172-n .

<i41628>	a	<Concept> ;
	skos:definition	"judgment rendered through analysis and adjudication of the factual issues presented"@en ;
	dc:source	pwn30:01190364-n .

<i41629>	a	<Concept> ;
	skos:definition	"a judgment rendered by the court prior to a verdict because no material issue of fact exists and one party or the other is entitled to a judgment as a matter of law"@en ;
	dc:source	pwn30:01190561-n .

<i41630>	a	<Concept> ;
	skos:definition	"the act of deciding as an arbiter; giving authoritative judgment"@en ;
	dc:source	pwn30:01190884-n .

<i41631>	a	<Concept> ;
	skos:definition	"the reason for a court's judgment (as opposed to the decision itself)"@en ;
	dc:source	pwn30:01191158-n .

<i41632>	a	<Instance> ;
	skos:definition	"a ruling by the Supreme Court on affirmative action; the Court ruled in 1978 that medical schools are entitled to consider race as a factor in their admission policy"@en ;
	dc:source	pwn30:01191364-n .

<i41633>	a	<Concept> ;
	skos:definition	"a ruling on a point of Islamic law that is given by a recognized authority"@en ;
	dc:source	pwn30:01191610-n .

<i41634>	a	<Concept> ;
	skos:definition	"the act of umpiring"@en ;
	dc:source	pwn30:01191755-n .

<i41635>	a	<Concept> ;
	skos:definition	"the decision of a court on issues of fact or law"@en ;
	dc:source	pwn30:01191975-n .

<i41636>	a	<Concept> ;
	skos:definition	"(law) the findings of a jury on issues of fact submitted to it for decision; can be used in formulating a judgment"@en ;
	dc:source	pwn30:01192150-n .

<i41637>	a	<Concept> ;
	skos:definition	"a finding as to the applicability of a rule of law to particular facts"@en ;
	dc:source	pwn30:01192463-n .

<i41638>	a	<Concept> ;
	skos:definition	"a verdict resulting from improper compromises between jurors on material issues"@en ;
	dc:source	pwn30:01192633-n .

<i41639>	a	<Concept> ;
	skos:definition	"a verdict entered by the court in a jury trial without consideration by the jury"@en ;
	dc:source	pwn30:01192814-n .

<i41640>	a	<Concept> ;
