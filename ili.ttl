<i70387>	a	<Instance> ;
	skos:definition	"a prayer said 3 times a day by Roman Catholics in memory of the Annunciation"@en ;
	dc:source	pwn30:06456384-n .

<i70388>	a	<Instance> ;
	skos:definition	"a salutation to the Virgin Mary now used in prayers to her"@en ;
	dc:source	pwn30:06456515-n .

<i70389>	a	<Instance> ;
	skos:definition	"the prayer of Simeon (Luke 2:29-32)"@en ;
	dc:source	pwn30:06456642-n .

<i70390>	a	<Instance> ;
	skos:definition	"(Anglican Church) a daily evening service with prayers prescribed in the Book of Common Prayer"@en ;
	dc:source	pwn30:06456759-n .

<i70391>	a	<Instance> ;
	skos:definition	"the opening prayer on the eve of Yom Kippur"@en ;
	dc:source	pwn30:06456945-n .

<i70392>	a	<Concept> ;
	skos:definition	"a book setting forth the forms of church service"@en ;
	dc:source	pwn30:06457045-n .

<i70393>	a	<Instance> ;
	skos:definition	"the Anglican service book of the Church of England; has had several revisions since the Reformation and is widely admired for the dignity and beauty of its language"@en ;
	dc:source	pwn30:06457171-n .

<i70394>	a	<Instance> ;
	skos:definition	"a prayer consisting of a series of invocations by the priest with responses from the congregation"@en ;
	dc:source	pwn30:06457442-n .

<i70395>	a	<Instance> ;
	skos:definition	"the prayer that Christ gave his disciples in the Sermon on the Mount (Matthew 6:9-13)"@en ;
	dc:source	pwn30:06457612-n .

<i70396>	a	<Instance> ;
	skos:definition	"(Roman Catholic Church) the Lord's Prayer in Latin; translates as `our father'"@en ;
	dc:source	pwn30:06457796-n .

<i70397>	a	<Concept> ;
	skos:definition	"14 books of the Old Testament included in the Vulgate (except for II Esdras) but omitted in Jewish and Protestant versions of the Bible; eastern Christian churches (except the Coptic Church) accept all these books as canonical; the Russian Orthodox Church accepts these texts as divinely inspired but does not grant them the same status"@en ;
	dc:source	pwn30:06457952-n .

<i70398>	a	<Instance> ;
	skos:definition	"an Apocryphal book consisting of text added to the Book of Esther"@en ;
	dc:source	pwn30:06458685-n .

<i70399>	a	<Instance> ;
	skos:definition	"an Apocryphal book consisting of text added to the Book of Daniel"@en ;
	dc:source	pwn30:06458836-n .

<i70400>	a	<Instance> ;
	skos:definition	"an Apocryphal book consisting of text added to the Book of Daniel"@en ;
	dc:source	pwn30:06459016-n .

<i70401>	a	<Instance> ;
	skos:definition	"an Apocryphal book consisting of text added to the Book of Daniel"@en ;
	dc:source	pwn30:06459173-n .

<i70402>	a	<Instance> ;
	skos:definition	"an Apocryphal book ascribed to Baruch"@en ;
	dc:source	pwn30:06459323-n .

<i70403>	a	<Instance> ;
	skos:definition	"an Apocryphal book consisting of a letter ascribed to Jeremiah to the Jews in exile in Babylon warning them against idolatry"@en ;
	dc:source	pwn30:06459450-n .

<i70404>	a	<Instance> ;
	skos:definition	"an Apocryphal book that was a popular novel for several centuries"@en ;
	dc:source	pwn30:06459681-n .

<i70405>	a	<Instance> ;
	skos:definition	"an Apocryphal book telling how Judith saved her people"@en ;
	dc:source	pwn30:06459834-n .

<i70406>	a	<Instance> ;
	skos:definition	"an Apocryphal book consisting of a compilation from I Chronicles and II Chronicles and Ezra and Nehemiah"@en ;
	dc:source	pwn30:06459978-n .

<i70407>	a	<Instance> ;
	skos:definition	"an Apocryphal book of angelic revelations"@en ;
	dc:source	pwn30:06460167-n .

<i70408>	a	<Instance> ;
	skos:definition	"an Apocryphal book mainly of maxims (resembling Proverbs in that respect)"@en ;
	dc:source	pwn30:06460295-n .

<i70409>	a	<Instance> ;
	skos:definition	"an Apocryphal book consisting mainly of a meditation on wisdom; although ascribed to Solomon it was probably written in the first century BC"@en ;
	dc:source	pwn30:06460524-n .

<i70410>	a	<Instance> ;
	skos:definition	"an Apocryphal book describing the life of Judas Maccabaeus"@en ;
	dc:source	pwn30:06460776-n .

<i70411>	a	<Instance> ;
	skos:definition	"an Apocryphal book describing the life of Judas Maccabaeus"@en ;
	dc:source	pwn30:06460926-n .

<i70412>	a	<Concept> ;
	skos:definition	"any of the biblical books (Proverbs, Ecclesiastes, Song of Songs, Wisdom of Solomon, Ecclesiasticus) that are considered to contain wisdom"@en ;
	dc:source	pwn30:06461077-n .

<i70413>	a	<Concept> ;
	skos:definition	"52 texts written between 200 BC and AD 200 but ascribed to various prophets and kings in the Hebrew scriptures; many are apocalyptic in nature"@en ;
	dc:source	pwn30:06461406-n .

<i70414>	a	<Instance> ;
	skos:definition	"the sacred writings of Islam revealed by God to the prophet Muhammad during his life at Mecca and Medina"@en ;
	dc:source	pwn30:06461609-n .

<i70415>	a	<Concept> ;
	skos:definition	"one of the sections (or chapters) in the Koran"@en ;
	dc:source	pwn30:06461830-n .

<i70416>	a	<Instance> ;
	skos:definition	"the first or opening sura of the Quran which is the central prayer of Islam and is used on all special occasions as well as during the five daily prayers"@en ;
	dc:source	pwn30:06462002-n .

<i70417>	a	<Concept> ;
	skos:definition	"(Judaism) ancient rabbinical writings"@en ;
	dc:source	pwn30:06462219-n .

<i70418>	a	<Instance> ;
	skos:definition	"the collection of ancient rabbinic writings on Jewish law and tradition (the Mishna and the Gemara) that constitute the basis of religious authority in Orthodox Judaism"@en ;
	dc:source	pwn30:06462396-n .

<i70419>	a	<Instance> ;
	skos:definition	"the second part of the Talmud consisting primarily of commentary on the Mishna"@en ;
	dc:source	pwn30:06462656-n .

<i70420>	a	<Instance> ;
	skos:definition	"the first part of the Talmud; a collection of early oral interpretations of the scriptures that was compiled about AD 200"@en ;
	dc:source	pwn30:06462807-n .

<i70421>	a	<Concept> ;
	skos:definition	"Talmudic literature that does not deal with law but is still part of Jewish tradition"@en ;
	dc:source	pwn30:06463011-n .

<i70422>	a	<Concept> ;
	skos:definition	"Talmudic literature that deals with law and with the interpretation of the laws on the Hebrew Scriptures"@en ;
	dc:source	pwn30:06463170-n .

<i70423>	a	<Concept> ;
	skos:definition	"Hindu literature written in Sanskrit"@en ;
	dc:source	pwn30:06463347-n .

<i70424>	a	<Concept> ;
	skos:definition	"one of two classical Hindu epics; a great collection of poetry worked into and around a central heroic narrative (eight times as large as the Iliad and Odyssey combined)"@en ;
	dc:source	pwn30:06463559-n .

<i70425>	a	<Concept> ;
	skos:definition	"a body of 18 works written between the first and 11th centuries and incorporating legends and speculative histories of the universe and myths and customary observances"@en ;
	dc:source	pwn30:06463786-n .

<i70426>	a	<Instance> ;
	skos:definition	"one of two classical Hindu epics telling of the banishment of Rama from his kingdom and the abduction of his wife by a demon and Rama's restoration to the throne"@en ;
	dc:source	pwn30:06464024-n .

<i70427>	a	<Concept> ;
	skos:definition	"any of a fairly recent class of Hindu or Buddhist religious literature concerned with ritual acts of body and speech and mind"@en ;
	dc:source	pwn30:06464241-n .

<i70428>	a	<Concept> ;
	skos:definition	"(from the Sanskrit word for `knowledge') any of the most ancient sacred writings of Hinduism written in early Sanskrit; traditionally believed to comprise the Samhitas, the Brahmanas, the Aranyakas, and the Upanishads"@en ;
	dc:source	pwn30:06464419-n .

<i70429>	a	<Instance> ;
	skos:definition	"one of four collections of sacred texts"@en ;
	dc:source	pwn30:06464838-n .

<i70430>	a	<Instance> ;
	skos:definition	"a Veda consisting of a collection of Hindu poems dating from before 2000 BC"@en ;
	dc:source	pwn30:06465008-n .

<i70431>	a	<Instance> ;
	skos:definition	"a collection of mantras and tunes for use with the Rig-Veda"@en ;
	dc:source	pwn30:06465139-n .

<i70432>	a	<Instance> ;
	skos:definition	"a collection of mantras and formulas"@en ;
	dc:source	pwn30:06465255-n .

<i70433>	a	<Instance> ;
	skos:definition	"a collection of sacrificial formulas and prayers"@en ;
	dc:source	pwn30:06465351-n .

<i70434>	a	<Instance> ;
	skos:definition	"prose works attached to the Samhitas instructing the bahmins to perform the very elaborate sacrificial rituals"@en ;
	dc:source	pwn30:06465457-n .

<i70435>	a	<Instance> ;
	skos:definition	"a treatise resembling a Brahmana but to be read or expounded by anchorites in the quiet of the forest"@en ;
	dc:source	pwn30:06465623-n .

<i70436>	a	<Instance> ;
	skos:definition	"Vedic texts from the fifth and fourth centuries BC dealing with phonetics and ritual injunctions and linguistics and grammar and etymology and lexicography and prosody and astronomy and astrology"@en ;
	dc:source	pwn30:06465780-n .

<i70437>	a	<Instance> ;
	skos:definition	"(Sanskrit) an ancient medical treatise summarizing the Hindu art of healing and prolonging life; sometimes regarded as a 5th Veda"@en ;
	dc:source	pwn30:06466030-n .

<i70438>	a	<Instance> ;
	skos:definition	"a later sacred text of Hinduism of a mystical nature dealing with metaphysical questions"@en ;
	dc:source	pwn30:06466253-n .

<i70439>	a	<Concept> ;
	skos:definition	"(Sanskrit) literally a `sacred utterance' in Vedism; one of a collection of orally transmitted poetic hymns"@en ;
	dc:source	pwn30:06466479-n .

<i70440>	a	<Concept> ;
	skos:definition	"any sacred song used to praise the deity"@en ;
	dc:source	pwn30:06466677-n .

<i70441>	a	<Instance> ;
	skos:definition	"one of the 150 lyrical poems and prayers that comprise the Book of Psalms in the Old Testament; said to have been written by David"@en ;
	dc:source	pwn30:06466787-n .

<i70442>	a	<Concept> ;
	skos:definition	"a brief statement that presents the main points in a concise form"@en ;
	dc:source	pwn30:06467007-n .

<i70443>	a	<Concept> ;
