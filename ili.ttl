	skos:definition	"a village council in India or southern Pakistan"@en ;
	dc:source	pwn30:08311522-n .

<i80814>	a	<Concept> ;
	skos:definition	"an advisory council to a ruler (especially to the British Crown)"@en ;
	dc:source	pwn30:08311687-n .

<i80815>	a	<Concept> ;
	skos:definition	"a Muslim council of state"@en ;
	dc:source	pwn30:08311848-n .

<i80816>	a	<Concept> ;
	skos:definition	"(chiefly Brit) a council representing employer and employees of a plant or business to discuss working conditions etc; also: a committee representing the workers elected to negotiate with management about grievances and wages etc"@en ;
	dc:source	pwn30:08311933-n .

