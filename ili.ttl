	dc:source	pwn30:09484664-n .

<i86467>	a	<Instance> ;
	skos:definition	"(Greek mythology) the mythical Greek king who for 30 years did not clean his stables which contained his vast herd of cattle"@en ;
	dc:source	pwn30:09486424-n .

<i86468>	a	<Instance> ;
	skos:definition	"(Greek mythology) a woman who was turned into a kingfisher"@en ;
	dc:source	pwn30:09486639-n .

<i86469>	a	<Instance> ;
