<i70457>	a	<Concept> ;
	skos:definition	"a summary list; as in e.g. \"a news roundup\""@en ;
	dc:source	pwn30:06469597-n .

<i70458>	a	<Concept> ;
	skos:definition	"short descriptive summary (of events)"@en ;
	dc:source	pwn30:06469694-n .

<i70459>	a	<Concept> ;
	skos:definition	"a concluding summary (as in presenting a case before a law court)"@en ;
	dc:source	pwn30:06469874-n .

<i70460>	a	<Concept> ;
	skos:definition	"writing that provides information (especially information of an official nature)"@en ;
	dc:source	pwn30:06470073-n .

<i70461>	a	<Concept> ;
	skos:definition	"a legal document that creates a corporation; it is filed with a state by the founders of a corporation and is governed by the laws of the state"@en ;
	dc:source	pwn30:06470688-n .

<i70462>	a	<Concept> ;
