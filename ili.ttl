	skos:definition	"a small grey-brown fungus with an unpleasant odor of mothballs"@en ;
	dc:source	pwn30:13073380-n .

<i105419>	a	<Concept> ;
	skos:definition	"a genus of fungi belonging to the family Hygrophoraceae"@en ;
	dc:source	pwn30:13073526-n .

