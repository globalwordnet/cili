	dc:source	pwn30:11613219-n .

<i98408>	a	<Concept> ;
	skos:definition	"tall pine of western North America with stout blue-green needles; bark is grey-brown with rectangular plates when mature"@en ;
	dc:source	pwn30:11613459-n .

<i98409>	a	<Concept> ;
