	dc:source	pwn30:05467054-n .

<i65684>	a	<Concept> ;
	skos:definition	"a cell of the neuroglia"@en ;
	dc:source	pwn30:05467432-n .

<i65685>	a	<Concept> ;
	skos:definition	"tissue consisting of large stellate neuroglial cells"@en ;
	dc:source	pwn30:05467619-n .

<i65686>	a	<Concept> ;
	skos:definition	"comparatively large neuroglial cell"@en ;
	dc:source	pwn30:05467758-n .

<i65687>	a	<Concept> ;
	skos:definition	"star-shaped cells with long processes; found in the white matter of the brain and spinal cord"@en ;
	dc:source	pwn30:05467922-n .

<i65688>	a	<Concept> ;
	skos:definition	"a kind of astrocyte found in the grey matter"@en ;
	dc:source	pwn30:05468098-n .

<i65689>	a	<Concept> ;
	skos:definition	"neuroglial tissue of mesodermal origin that can become phagocytic"@en ;
	dc:source	pwn30:05468211-n .

<i65690>	a	<Concept> ;
	skos:definition	"a cell of the microglia that may become phagocytic and collect waste products of nerve tissue"@en ;
	dc:source	pwn30:05468351-n .

<i65691>	a	<Concept> ;
