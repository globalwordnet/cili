	dc:source	pwn30:14019296-n .

<i110607>	a	<Concept> ;
	skos:definition	"absence of the head (as in the development of some monsters)"@en ;
	dc:source	pwn30:14019441-n .

<i110608>	a	<Concept> ;
	skos:definition	"abnormally high acidity (excess hydrogen-ion concentration) of the blood and other body tissues"@en ;
	dc:source	pwn30:14019600-n .

<i110609>	a	<Concept> ;
	skos:definition	"acidosis with an accumulation of ketone bodies; occurs primarily in diabetes mellitus"@en ;
	dc:source	pwn30:14019840-n .

<i110610>	a	<Concept> ;
	skos:definition	"acidosis and bicarbonate concentration in the body fluids resulting either from the accumulation of acids or the abnormal loss of bases from the body (as in diarrhea or renal disease)"@en ;
	dc:source	pwn30:14020023-n .

<i110611>	a	<Concept> ;
	skos:definition	"acidosis resulting from reduced gas exchange in the lungs (as in emphysema or pneumonia); excess carbon dioxide combines with water to form carbonic acid which increases the acidity of the blood"@en ;
	dc:source	pwn30:14020271-n .

<i110612>	a	<Concept> ;
	skos:definition	"acidosis in which the acidity results from lack of food which leads to fat catabolism which in turn releases acidic ketone bodies"@en ;
	dc:source	pwn30:14020558-n .

<i110613>	a	<Concept> ;
	skos:definition	"a blood disorder characterized by an increased concentration of hydrogen ions in the blood (which falls below 7 on the pH scale)"@en ;
	dc:source	pwn30:14020753-n .

