	skos:definition	"infectious disease of birds"@en ;
	dc:source	pwn30:14274975-n .

<i111959>	a	<Concept> ;
	skos:definition	"a serious bacterial disease of young chickens"@en ;
	dc:source	pwn30:14275077-n .

