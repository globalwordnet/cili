	dc:source	pwn30:06468523-n .

<i70451>	a	<Concept> ;
	skos:definition	"a condensed written summary or abstract"@en ;
	dc:source	pwn30:06468640-n .

<i70452>	a	<Concept> ;
	skos:definition	"a short synopsis"@en ;
	dc:source	pwn30:06468749-n .

