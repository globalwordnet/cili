	dc:source	pwn30:00682738-n .

<i39011>	a	<Concept> ;
	skos:definition	"surgical incision into the abdominal wall; often done to examine abdominal organs"@en ;
	dc:source	pwn30:00682856-n .

<i39012>	a	<Concept> ;
	skos:definition	"laparotomy performed with a laparoscope that makes a small incision to examine the abdominal cavity (especially the ovaries and Fallopian tubes)"@en ;
	dc:source	pwn30:00683012-n .

<i39013>	a	<Concept> ;
	skos:definition	"surgical removal of part or all of the larynx (usually to treat cancer of the larynx)"@en ;
	dc:source	pwn30:00683214-n .

<i39014>	a	<Concept> ;
	skos:definition	"surgical removal of a stone (calculus)"@en ;
	dc:source	pwn30:00683358-n .

<i39015>	a	<Concept> ;
	skos:definition	"removal of gallstone through an incision in the gallbladder"@en ;
	dc:source	pwn30:00683470-n .

<i39016>	a	<Concept> ;
	skos:definition	"surgical removal of a lobe from any organ of the body (as the lung or brain)"@en ;
	dc:source	pwn30:00683590-n .

<i39017>	a	<Concept> ;
	skos:definition	"psychosurgery in which amygdaloid fibers that mediate limbic system activity are severed (in cases of extreme uncontrollable violence)"@en ;
	dc:source	pwn30:00683722-n .

<i39018>	a	<Concept> ;
	skos:definition	"severing the corpus callosum so that communication between the cerebral hemispheres is interrupted (in cases of severe intractable epilepsy)"@en ;
	dc:source	pwn30:00683915-n .

<i39019>	a	<Concept> ;
	skos:definition	"surgical interruption of nerve tracts to and from the frontal lobe of the brain; often results in marked cognitive and personality changes"@en ;
	dc:source	pwn30:00684128-n .

<i39020>	a	<Concept> ;
	skos:definition	"a method of performing prefrontal lobotomy in which the surgical knife is inserted above the eyeball and moved to cut brain fibers"@en ;
	dc:source	pwn30:00684450-n .

<i39021>	a	<Concept> ;
	skos:definition	"surgical removal of a tumor without removing much of the surrounding tissue or lymph nodes; performed in some cases of breast cancer"@en ;
	dc:source	pwn30:00684648-n .

