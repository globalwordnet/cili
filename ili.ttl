	skos:definition	"the document that spells out the belief system of a given church (especially the Reformation churches of the 16th century)"@en ;
	dc:source	pwn30:06472409-n .

<i70470>	a	<Instance> ;
	skos:definition	"the document drawn up in 1555 to defend the catholicity of Lutheran doctrine and to justify innovations in Lutheran practice; is still in effect today"@en ;
	dc:source	pwn30:06472607-n .

<i70471>	a	<Concept> ;
