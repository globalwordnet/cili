	dc:source	pwn30:09595957-n .

<i87093>	a	<Instance> ;
	skos:definition	"(Greek mythology) a prophetess in Troy during the Trojan War whose predictions were true but were never believed"@en ;
	dc:source	pwn30:09596186-n .

<i87094>	a	<Instance> ;
