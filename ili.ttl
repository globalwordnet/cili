	dc:source	pwn30:15117516-n .

<i116641>	a	<Concept> ;
	skos:definition	"a period of time when something (as a machine or factory) is not operating (especially as a result of malfunctions)"@en ;
	dc:source	pwn30:15117621-n .

<i116642>	a	<Concept> ;
	skos:definition	"a period of time when something (as a machine or factory) is functioning and available for use"@en ;
	dc:source	pwn30:15117809-n .

