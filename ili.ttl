	dc:source	pwn30:05343037-n .

<i65031>	a	<Concept> ;
	skos:definition	"an artery that serves the muscles of the shoulder and scapular area"@en ;
	dc:source	pwn30:05343218-n .

<i65032>	a	<Concept> ;
	skos:definition	"arteries that supply blood to the colon"@en ;
	dc:source	pwn30:05343408-n .

<i65033>	a	<Concept> ;
	skos:definition	"any of three arteries in the brain that make up the circle of Willis"@en ;
	dc:source	pwn30:05343542-n .

<i65034>	a	<Concept> ;
	skos:definition	"the artery that branches from the aorta to supply blood to the heart"@en ;
	dc:source	pwn30:05343718-n .

<i65035>	a	<Concept> ;
	skos:definition	"the branch of the coronary artery that supplies the muscles of the atria"@en ;
	dc:source	pwn30:05343941-n .

<i65036>	a	<Concept> ;
