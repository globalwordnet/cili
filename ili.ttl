	skos:definition	"a disease of raspberries"@en ;
	dc:source	pwn30:14218805-n .

<i111630>	a	<Concept> ;
	skos:definition	"a fungous blight attacking the stems of plants"@en ;
	dc:source	pwn30:14218887-n .

<i111631>	a	<Concept> ;
	skos:definition	"a disease of oats"@en ;
	dc:source	pwn30:14218991-n .

<i111632>	a	<Concept> ;
	skos:definition	"a disease of tropical woody plants (cacao or tea or citrus)"@en ;
	dc:source	pwn30:14219068-n .

<i111633>	a	<Concept> ;
	skos:definition	"a disease of tomato plants"@en ;
	dc:source	pwn30:14219187-n .

<i111634>	a	<Concept> ;
	skos:definition	"a disease of the ends of twigs of woody plants"@en ;
	dc:source	pwn30:14219290-n .

<i111635>	a	<Concept> ;
	skos:definition	"a disease of English walnut trees"@en ;
	dc:source	pwn30:14219394-n .

<i111636>	a	<Concept> ;
	skos:definition	"a mild viral disease transmitted by the bite of the sand fly Phlebotomus papatasii"@en ;
	dc:source	pwn30:14219487-n .

<i111637>	a	<Concept> ;
	skos:definition	"a disease affecting the skin"@en ;
	dc:source	pwn30:14219661-n .

<i111638>	a	<Concept> ;
	skos:definition	"tuberculosis of the skin; appears first on the face and heals slowly leaving deep scars"@en ;
	dc:source	pwn30:14220308-n .

<i111639>	a	<Concept> ;
	skos:definition	"a chronic form of spondylitis primarily in males and marked by impaired mobility of the spine; sometimes leads to ankylosis"@en ;
	dc:source	pwn30:14220474-n .

<i111640>	a	<Concept> ;
	skos:definition	"a chronic skin disease occurring primarily in women between the ages of 20 and 40; characterized by an eruption of red lesions over the cheeks and bridge of the nose"@en ;
	dc:source	pwn30:14220735-n .

<i111641>	a	<Concept> ;
	skos:definition	"autoimmune disorder of the thyroid gland; most common in middle-aged women"@en ;
	dc:source	pwn30:14220998-n .

<i111642>	a	<Concept> ;
	skos:definition	"a chronic inflammatory collagen disease affecting connective tissue (skin or joints)"@en ;
	dc:source	pwn30:14221138-n .

<i111643>	a	<Concept> ;
	skos:definition	"an inflammatory disease of connective tissue with variable features including fever and weakness and fatigability and joint pains and skin lesions on the face or neck or arms"@en ;
	dc:source	pwn30:14221311-n .

<i111644>	a	<Concept> ;
	skos:definition	"a breakdown of a cell layer in the epidermis (as in pemphigus)"@en ;
	dc:source	pwn30:14221601-n .

<i111645>	a	<Concept> ;
	skos:definition	"an abnormal but benign thickening of the prickle-cell layer of the skin (as in psoriasis)"@en ;
	dc:source	pwn30:14221741-n .

<i111646>	a	<Concept> ;
	skos:definition	"a skin disease characterized by dark wartlike patches in the body folds; can be benign or malignant"@en ;
	dc:source	pwn30:14221924-n .

<i111647>	a	<Concept> ;
	skos:definition	"an inflammatory disease involving the sebaceous glands of the skin; characterized by papules or pustules or comedones"@en ;
	dc:source	pwn30:14222112-n .

<i111648>	a	<Concept> ;
	skos:definition	"a skin disease of adults (more often women) in which blood vessels of the face enlarge resulting in a flushed appearance"@en ;
	dc:source	pwn30:14222352-n .

<i111649>	a	<Concept> ;
	skos:definition	"the most common form of acne; usually affects people from puberty to young adulthood"@en ;
	dc:source	pwn30:14222541-n .

<i111650>	a	<Concept> ;
	skos:definition	"dermatitis caused exposure to sunlight"@en ;
	dc:source	pwn30:14222685-n .

<i111651>	a	<Concept> ;
	skos:definition	"a severe form of dermatitis characterized by atopy"@en ;
	dc:source	pwn30:14222788-n .

<i111652>	a	<Concept> ;
	skos:definition	"an allergic contact dermatitis developed around the lips of children who chew bubble gum"@en ;
	dc:source	pwn30:14222918-n .

<i111653>	a	<Concept> ;
	skos:definition	"a delayed type of allergic reaction of the skin resulting from skin contact with a specific allergen (such as poison ivy)"@en ;
	dc:source	pwn30:14223074-n .

<i111654>	a	<Concept> ;
	skos:definition	"contact dermatitis resulting from contact with plants of the genus Toxicodendron"@en ;
	dc:source	pwn30:14223296-n .

<i111655>	a	<Concept> ;
	skos:definition	"dermatitis resulting from contact with the poison ivy plant"@en ;
	dc:source	pwn30:14223492-n .

<i111656>	a	<Concept> ;
	skos:definition	"dermatitis resulting from contact with a poison oak plant"@en ;
	dc:source	pwn30:14223638-n .

<i111657>	a	<Concept> ;
	skos:definition	"dermatitis resulting from contact with a poison sumac plant"@en ;
	dc:source	pwn30:14223752-n .

<i111658>	a	<Concept> ;
	skos:definition	"a dermatitis of the scalp that is common in infants"@en ;
	dc:source	pwn30:14223870-n .

<i111659>	a	<Concept> ;
	skos:definition	"dermatitis of the thighs and buttocks of infants; supposedly caused by ammonia in the urine in the child's diapers"@en ;
	dc:source	pwn30:14223978-n .

<i111660>	a	<Concept> ;
	skos:definition	"a severe dermatitis of herbivorous domestic animals attributable to photosensitivity from eating Saint John's wort"@en ;
	dc:source	pwn30:14224170-n .

<i111661>	a	<Concept> ;
	skos:definition	"dermatitis in which localized areas (especially the forearms or back of the neck or outer part of the ankle) itch persistently; cause is unknown"@en ;
	dc:source	pwn30:14224341-n .

<i111662>	a	<Concept> ;
	skos:definition	"a sensitization reaction to repeated invasion of the skin by cercariae of schistosomes"@en ;
	dc:source	pwn30:14224547-n .

<i111663>	a	<Concept> ;
	skos:definition	"inflammation of the skin; skin becomes itchy and may develop blisters"@en ;
	dc:source	pwn30:14224757-n .

<i111664>	a	<Concept> ;
	skos:definition	"disorder involving lesions or eruptions of the skin (in which there is usually no inflammation)"@en ;
	dc:source	pwn30:14225045-n .

<i111665>	a	<Concept> ;
	skos:definition	"allergic eczema caused by flour or other ingredients handled by bakers"@en ;
	dc:source	pwn30:14225215-n .

<i111666>	a	<Concept> ;
	skos:definition	"eczema caused by an allergic reaction"@en ;
	dc:source	pwn30:14225346-n .

<i111667>	a	<Concept> ;
	skos:definition	"eczema characterized by a feverish condition and widespread eruption of vesicles; most common in children"@en ;
	dc:source	pwn30:14225463-n .

<i111668>	a	<Concept> ;
	skos:definition	"a now rare complication of vaccinia superimposed on atopic dermatitis with high fever and generalized vesicles and papulovesicles"@en ;
	dc:source	pwn30:14225632-n .

<i111669>	a	<Concept> ;
	skos:definition	"eczema characterized by thickening of the skin with accentuated skin lines"@en ;
	dc:source	pwn30:14225877-n .

<i111670>	a	<Concept> ;
	skos:definition	"generic term for inflammatory conditions of the skin; particularly with vesiculation in the acute stages"@en ;
	dc:source	pwn30:14226056-n .

<i111671>	a	<Concept> ;
	skos:definition	"abnormal redness of the skin resulting from dilation of blood vessels (as in sunburn or inflammation)"@en ;
	dc:source	pwn30:14226303-n .

<i111672>	a	<Concept> ;
	skos:definition	"a red rash caused by hypersensitivity to a drug or disease or other allergen"@en ;
	dc:source	pwn30:14226567-n .

<i111673>	a	<Concept> ;
	skos:definition	"skin condition characterized by tender red nodules on the shins and legs"@en ;
	dc:source	pwn30:14226709-n .

<i111674>	a	<Concept> ;
	skos:definition	"a temporary red mark on a person's skin resulting from kissing or sucking by their lover"@en ;
	dc:source	pwn30:14226862-n .

<i111675>	a	<Concept> ;
	skos:definition	"an inflammatory complication of leprosy that results in painful skin lesions on the arms and legs and face"@en ;
	dc:source	pwn30:14227015-n .

<i111676>	a	<Concept> ;
	skos:definition	"any skin disorder involving abnormal redness"@en ;
	dc:source	pwn30:14227218-n .

<i111677>	a	<Concept> ;
	skos:definition	"reddening of the skin spreading outward from a focus of infection or irritation"@en ;
	dc:source	pwn30:14227357-n .

<i111678>	a	<Concept> ;
	skos:definition	"acute skin disease characterized by the presence of many furuncles"@en ;
	dc:source	pwn30:14227488-n .

<i111679>	a	<Concept> ;
	skos:definition	"a very contagious infection of the skin; common in children; localized redness develops into small blisters that gradually crust and erode"@en ;
	dc:source	pwn30:14227613-n .

<i111680>	a	<Concept> ;
	skos:definition	"skin disorder induced by a tropical climate"@en ;
	dc:source	pwn30:14227806-n .

<i111681>	a	<Concept> ;
	skos:definition	"any skin disorder consisting of a growth that appears horny"@en ;
	dc:source	pwn30:14227906-n .

<i111682>	a	<Concept> ;
	skos:definition	"any abnormal condition of the outer skin (epidermis)"@en ;
	dc:source	pwn30:14228038-n .

<i111683>	a	<Concept> ;
	skos:definition	"a skin condition marked by an overgrowth of layers of horny skin"@en ;
	dc:source	pwn30:14228148-n .

<i111684>	a	<Concept> ;
	skos:definition	"an overgrowth of skin layers resulting from extended exposure to the sun"@en ;
	dc:source	pwn30:14228376-n .

<i111685>	a	<Concept> ;
	skos:definition	"skin disease characterized by a scaly rash on the palms and soles; associated with Reiter's syndrome"@en ;
	dc:source	pwn30:14228512-n .

<i111686>	a	<Concept> ;
	skos:definition	"a rare hereditary condition marked by dark crusted patches (sometimes containing pus)"@en ;
	dc:source	pwn30:14228712-n .

<i111687>	a	<Concept> ;
	skos:definition	"keratosis characterized by hard conical elevations in the openings of sebaceous glands (especially of arms and thighs)"@en ;
	dc:source	pwn30:14228885-n .

<i111688>	a	<Concept> ;
	skos:definition	"a skin condition characterized by circumscribed wartlike lesions that can be itchy and covered with a greasy crust"@en ;
	dc:source	pwn30:14229067-n .

<i111689>	a	<Concept> ;
	skos:definition	"a congenital skin condition characterized by spots or bands of unpigmented skin"@en ;
	dc:source	pwn30:14229248-n .

<i111690>	a	<Concept> ;
	skos:definition	"any of several eruptive skin diseases characterized by hard thick lesions grouped together and resembling lichens growing on rocks"@en ;
	dc:source	pwn30:14229403-n .

<i111691>	a	<Concept> ;
	skos:definition	"an eruption of shiny flat-topped purplish (usually itchy) papules on the wrist and forearms and thighs"@en ;
	dc:source	pwn30:14229604-n .

<i111692>	a	<Concept> ;
	skos:definition	"skin disorder characterized by patchy bluish discolorations on the skin"@en ;
	dc:source	pwn30:14229788-n .

<i111693>	a	<Concept> ;
	skos:definition	"any of several forms of ulcerative skin disease"@en ;
	dc:source	pwn30:14229912-n .

<i111694>	a	<Concept> ;
	skos:definition	"a condition characterized by abnormal deposits of melanin (especially in the skin)"@en ;
	dc:source	pwn30:14230083-n .

<i111695>	a	<Concept> ;
	skos:definition	"any skin disease characterized by soft pulpy nodules"@en ;
	dc:source	pwn30:14230232-n .

<i111696>	a	<Concept> ;
	skos:definition	"a virus disease of the skin marked by round white swellings; transmitted from person to person (most often in children or in adults with impaired immune function)"@en ;
	dc:source	pwn30:14230358-n .

<i111697>	a	<Concept> ;
	skos:definition	"skin disease marked by thin shiny patches (especially on the legs); often associated with diabetes mellitus"@en ;
	dc:source	pwn30:14230588-n .

<i111698>	a	<Concept> ;
	skos:definition	"a skin disease characterized by large thin-walled blisters (bullae) arising from normal skin or mucous membrane"@en ;
	dc:source	pwn30:14230800-n .

<i111699>	a	<Concept> ;
	skos:definition	"any of several skin disorders characterized by shedding dry flakes of skin"@en ;
	dc:source	pwn30:14231022-n .

<i111700>	a	<Concept> ;
	skos:definition	"a condition in which white scales of dead skin are shed by the scalp"@en ;
	dc:source	pwn30:14231207-n .

<i111701>	a	<Concept> ;
	skos:definition	"common form of pityriasis (usually in children or young adults) characterized by round patches of depigmentation"@en ;
	dc:source	pwn30:14231330-n .

<i111702>	a	<Concept> ;
	skos:definition	"pityriasis in which an itchy rash develops over the trunk and extremities"@en ;
	dc:source	pwn30:14231504-n .

<i111703>	a	<Concept> ;
	skos:definition	"chronic inflammatory disease of the skin characterized by blister capped papules and intense itching"@en ;
	dc:source	pwn30:14231640-n .

<i111704>	a	<Concept> ;
	skos:definition	"a chronic skin disease characterized by dry red patches covered with scales; occurs especially on the scalp and ears and genitalia and the skin over bony prominences"@en ;
	dc:source	pwn30:14231794-n .

<i111705>	a	<Concept> ;
	skos:definition	"cracks or fissures in the skin (especially around the mouth or anus)"@en ;
	dc:source	pwn30:14232034-n .

<i111706>	a	<Concept> ;
	skos:definition	"any of several inflammatory or gangrenous skin conditions"@en ;
	dc:source	pwn30:14232157-n .

<i111707>	a	<Concept> ;
	skos:definition	"an acute streptococcal infection characterized by deep-red inflammation of the skin and mucous membranes"@en ;
	dc:source	pwn30:14232299-n .

<i111708>	a	<Concept> ;
	skos:definition	"a skin disease marked by hard edema of the tissue usually beginning in the face"@en ;
	dc:source	pwn30:14232460-n .

<i111709>	a	<Concept> ;
	skos:definition	"a condition in which overactivity of the sebaceous glands causes the skin to become oily"@en ;
	dc:source	pwn30:14232596-n .

<i111710>	a	<Concept> ;
	skos:definition	"a chronic skin disease associated with seborrhea and greasy scales on the scalp or eyelids or other parts of the skin"@en ;
	dc:source	pwn30:14232740-n .

<i111711>	a	<Concept> ;
	skos:definition	"an acquired skin disease characterized by patches of unpigmented skin (often surrounded by a heavily pigmented border)"@en ;
	dc:source	pwn30:14232945-n .

<i111712>	a	<Concept> ;
	skos:definition	"xanthoma of the eyelids; occurs chiefly in the elderly"@en ;
	dc:source	pwn30:14233155-n .

<i111713>	a	<Concept> ;
	skos:definition	"a skin problem marked by the development (on the eyelids and neck and back) of irregular yellow nodules; sometimes attributable to disturbances of cholesterol metabolism"@en ;
	dc:source	pwn30:14233267-n .

<i111714>	a	<Concept> ;
	skos:definition	"rare chronic xanthoma of adults in which orange or brownish papules develop on many surfaces of the body"@en ;
	dc:source	pwn30:14233545-n .

<i111715>	a	<Concept> ;
	skos:definition	"widespread xanthomas (especially on elbows and knees); often associated with a disorder of lipid metabolism"@en ;
	dc:source	pwn30:14233717-n .

<i111716>	a	<Concept> ;
	skos:definition	"an abnormal yellow discoloration of the skin"@en ;
	dc:source	pwn30:14233974-n .

<i111717>	a	<Concept> ;
	skos:definition	"(pathology) an abnormal proliferation of tissue (as in a tumor)"@en ;
	dc:source	pwn30:14234074-n .

<i111718>	a	<Concept> ;
	skos:definition	"a benign outgrowth from a bone (usually covered with cartilage)"@en ;
	dc:source	pwn30:14234317-n .

<i111719>	a	<Concept> ;
	skos:definition	"a small vascular growth on the surface of a mucous membrane"@en ;
	dc:source	pwn30:14234436-n .

<i111720>	a	<Concept> ;
	skos:definition	"a polyp that consists of benign neoplastic tissue derived from glandular epithelium"@en ;
	dc:source	pwn30:14234611-n .

<i111721>	a	<Concept> ;
	skos:definition	"a relatively flat polyp"@en ;
	dc:source	pwn30:14234867-n .

<i111722>	a	<Concept> ;
	skos:definition	"a polyp with a stalk or peduncle"@en ;
	dc:source	pwn30:14234950-n .

<i111723>	a	<Concept> ;
	skos:definition	"the thin process of tissue that attaches a polyp to the body"@en ;
	dc:source	pwn30:14235066-n .

<i111724>	a	<Concept> ;
	skos:definition	"an abnormal new mass of tissue that serves no purpose"@en ;
	dc:source	pwn30:14235200-n .

<i111725>	a	<Concept> ;
	skos:definition	"a neoplasm originating in the epidermis"@en ;
	dc:source	pwn30:14235667-n .

<i111726>	a	<Concept> ;
	skos:definition	"a benign epithelial tumor of glandular origin"@en ;
	dc:source	pwn30:14235793-n .

<i111727>	a	<Concept> ;
	skos:definition	"a tumor consisting of a mass of blood or lymphatic vessels"@en ;
	dc:source	pwn30:14235928-n .

<i111728>	a	<Concept> ;
	skos:definition	"a common benign tumor of cartilage cells"@en ;
	dc:source	pwn30:14236130-n .

<i111729>	a	<Concept> ;
	skos:definition	"a tumor that is not cancerous"@en ;
	dc:source	pwn30:14236226-n .

<i111730>	a	<Concept> ;
	skos:definition	"a tumor composed of immature undifferentiated cells"@en ;
	dc:source	pwn30:14236595-n .

<i111731>	a	<Concept> ;
	skos:definition	"a tumor in the brain"@en ;
	dc:source	pwn30:14236743-n .

<i111732>	a	<Concept> ;
	skos:definition	"a fast-growing malignant brain tumor composed of spongioblasts; nearly always fatal"@en ;
	dc:source	pwn30:14236872-n .

<i111733>	a	<Concept> ;
	skos:definition	"a tumor of the brain consisting of neuroglia"@en ;
	dc:source	pwn30:14237032-n .

<i111734>	a	<Concept> ;
	skos:definition	"a small tumor (benign or malignant) arising from the mucosa of the gastrointestinal tract; usually associated with excessive secretion of serotonin"@en ;
	dc:source	pwn30:14237148-n .

<i111735>	a	<Concept> ;
	skos:definition	"a malignant neoplasm composed of carcinoma and sarcoma extensively intermixed"@en ;
	dc:source	pwn30:14237351-n .

<i111736>	a	<Concept> ;
	skos:definition	"an abdominal tumor"@en ;
	dc:source	pwn30:14237489-n .

<i111737>	a	<Concept> ;
	skos:definition	"(medicine) a malignant state; progressive and resistant to treatment and tending to cause death"@en ;
	dc:source	pwn30:14237561-n .

<i111738>	a	<Concept> ;
	skos:definition	"new connective tissue and tiny blood vessels that form on the surfaces of a wound during the healing process"@en ;
	dc:source	pwn30:14237818-n .

<i111739>	a	<Concept> ;
	skos:definition	"benign slow-growing tumor of cartilaginous cells at the ends of tubular bones (especially in the hands and feet)"@en ;
	dc:source	pwn30:14238041-n .

<i111740>	a	<Concept> ;
	skos:definition	"benign and movable and firm and not tender tumor of the breast; common in young women and caused by high levels of estrogen"@en ;
	dc:source	pwn30:14238211-n .

<i111741>	a	<Concept> ;
	skos:definition	"benign tumor containing fibrous tissue (especially in the uterus)"@en ;
	dc:source	pwn30:14238393-n .

<i111742>	a	<Concept> ;
	skos:definition	"nonmalignant tumor of connective tissue"@en ;
	dc:source	pwn30:14238528-n .

<i111743>	a	<Concept> ;
	skos:definition	"a tumor composed of granulation tissue resulting from injury or inflammation or infection"@en ;
	dc:source	pwn30:14238639-n .

<i111744>	a	<Concept> ;
	skos:definition	"a small rubbery granuloma that is characteristic of an advanced stage of syphilis"@en ;
	dc:source	pwn30:14238820-n .

<i111745>	a	<Concept> ;
	skos:definition	"a focal growth that resembles a neoplasm but results from faulty development in an organ"@en ;
	dc:source	pwn30:14238953-n .

<i111746>	a	<Concept> ;
	skos:definition	"skin tumor that grows rapidly (especially in older people) and resembles a carcinoma but does not spread; it usually disappears spontaneously, often leaving a scar"@en ;
	dc:source	pwn30:14239097-n .

<i111747>	a	<Concept> ;
	skos:definition	"a tumor consisting of fatty tissue"@en ;
	dc:source	pwn30:14239322-n .

<i111748>	a	<Concept> ;
	skos:definition	"a tumor that is malignant and tends to spread to other parts of the body"@en ;
	dc:source	pwn30:14239425-n .

<i111749>	a	<Concept> ;
	skos:definition	"a tumor arising in the meninges which surround the brain and spinal cord; usually slow growing and sometimes malignant"@en ;
	dc:source	pwn30:14239743-n .

<i111750>	a	<Concept> ;
	skos:definition	"any malignant growth or tumor caused by abnormal and uncontrolled cell division; it may spread to other parts of the body through the lymphatic system or the blood stream"@en ;
	dc:source	pwn30:14239918-n .

<i111751>	a	<Concept> ;
	skos:definition	"a rare malignant neoplasm arising from vascular tissue; usually occurs in the breast and skin and is believed to originate from the endothelial cells of blood vessels"@en ;
	dc:source	pwn30:14240262-n .

<i111752>	a	<Concept> ;
	skos:definition	"a malignant neoplasm of cartilage cells"@en ;
	dc:source	pwn30:14240487-n .

<i111753>	a	<Concept> ;
	skos:definition	"malignant tumor in bone marrow (usually in the pelvis or in long bones)"@en ;
	dc:source	pwn30:14240587-n .

<i111754>	a	<Concept> ;
	skos:definition	"a sarcoma that starts with purplish spots on the feet and legs and spreads from the skin to lymph nodes and internal organs; a common manifestation of AIDS"@en ;
	dc:source	pwn30:14240775-n .

<i111755>	a	<Concept> ;
	skos:definition	"sarcoma of smooth muscle; occurs most often digestive tract or uterus or bladder or prostate"@en ;
	dc:source	pwn30:14241088-n .

<i111756>	a	<Concept> ;
	skos:definition	"sarcoma of fat cells"@en ;
	dc:source	pwn30:14241241-n .

<i111757>	a	<Concept> ;
	skos:definition	"sarcoma of muscle tissue"@en ;
	dc:source	pwn30:14241319-n .

<i111758>	a	<Concept> ;
	skos:definition	"a malignant neoplasm of nerve tissue and fibrous tissue and connective tissue"@en ;
	dc:source	pwn30:14241400-n .

<i111759>	a	<Concept> ;
	skos:definition	"malignant bone tumor; most common in children and young adults where it tends to affect the femur"@en ;
	dc:source	pwn30:14241556-n .

<i111760>	a	<Concept> ;
	skos:definition	"an abnormally enlarged lymph node"@en ;
	dc:source	pwn30:14241733-n .

<i111761>	a	<Concept> ;
	skos:definition	"chronic abnormal enlargement of the lymph nodes (usually associated with disease)"@en ;
	dc:source	pwn30:14241825-n .

<i111762>	a	<Concept> ;
	skos:definition	"a neoplasm of lymph tissue that is usually malignant; one of the four major types of cancer"@en ;
	dc:source	pwn30:14241968-n .

<i111763>	a	<Concept> ;
	skos:definition	"a malignant disorder in which there is progressive (but painless) enlargement of lymph tissue followed by enlargement of the spleen and liver"@en ;
	dc:source	pwn30:14242132-n .

<i111764>	a	<Concept> ;
	skos:definition	"any malignant tumor derived from epithelial tissue; one of the four major types of cancer"@en ;
	dc:source	pwn30:14242337-n .

<i111765>	a	<Concept> ;
	skos:definition	"the most common form of skin cancer"@en ;
	dc:source	pwn30:14242788-n .

<i111766>	a	<Concept> ;
	skos:definition	"malignant neoplasm of blood-forming tissues; characterized by abnormal proliferation of leukocytes; one of the four major types of cancer"@en ;
	dc:source	pwn30:14242922-n .

<i111767>	a	<Concept> ;
	skos:definition	"rapidly progressing leukemia"@en ;
	dc:source	pwn30:14243268-n .

<i111768>	a	<Concept> ;
	skos:definition	"acute leukemia characterized by proliferation of immature lymphoblast-like cells in bone marrow, lymph nodes, spleen, and blood; most common in children"@en ;
	dc:source	pwn30:14243393-n .

<i111769>	a	<Concept> ;
	skos:definition	"acute leukemia characterized by proliferation of granular leukocytes; most common in adolescents and young adults"@en ;
	dc:source	pwn30:14243649-n .

<i111770>	a	<Concept> ;
	skos:definition	"slowly progressing leukemia"@en ;
	dc:source	pwn30:14243877-n .

<i111771>	a	<Concept> ;
	skos:definition	"chronic leukemia characterized by lymphoblast-like cells; more common in older men"@en ;
	dc:source	pwn30:14244003-n .

<i111772>	a	<Concept> ;
	skos:definition	"chronic leukemia characterized by granular leukocytes; more common in older people"@en ;
	dc:source	pwn30:14244160-n .

<i111773>	a	<Concept> ;
	skos:definition	"leukemia characterized by enlargement of lymphoid tissues and lymphocytic cells in the circulating blood"@en ;
	dc:source	pwn30:14244353-n .

<i111774>	a	<Concept> ;
	skos:definition	"a form of lymphocytic leukemia in which the abnormal cells in the circulating blood are almost totally lymphoblasts"@en ;
	dc:source	pwn30:14244542-n .

<i111775>	a	<Concept> ;
	skos:definition	"leukemia characterized by the proliferation of monocytes and monoblasts in the blood"@en ;
	dc:source	pwn30:14244726-n .

<i111776>	a	<Concept> ;
	skos:definition	"a malignant neoplasm of blood-forming tissues; characterized by numerous myeloblasts in the blood stream"@en ;
	dc:source	pwn30:14244991-n .

<i111777>	a	<Concept> ;
	skos:definition	"a malignant neoplasm of blood-forming tissues; marked by proliferation of myelocytes and their presence in the blood"@en ;
	dc:source	pwn30:14245163-n .

<i111778>	a	<Concept> ;
	skos:definition	"a highly malignant neoplasm derived from striated muscle"@en ;
	dc:source	pwn30:14245405-n .

<i111779>	a	<Concept> ;
	skos:definition	"form of rhabdomyosarcoma occurring mainly in infants and children"@en ;
	dc:source	pwn30:14245594-n .

<i111780>	a	<Concept> ;
	skos:definition	"form of rhabdomyosarcoma occurring mainly in adolescents and young adults"@en ;
	dc:source	pwn30:14245758-n .

<i111781>	a	<Concept> ;
	skos:definition	"form of rhabdomyosarcoma that affects limb muscles of older adults"@en ;
	dc:source	pwn30:14245928-n .

<i111782>	a	<Concept> ;
	skos:definition	"malignant renal tumor of young children characterized by hypertension and blood in the urine and the presence of a palpable mass"@en ;
	dc:source	pwn30:14246097-n .

<i111783>	a	<Concept> ;
	skos:definition	"a usually malignant tumor arising from connective tissue (bone or muscle etc.); one of the four major types of cancer"@en ;
	dc:source	pwn30:14246359-n .

<i111784>	a	<Concept> ;
	skos:definition	"malignant tumor originating in glandular epithelium"@en ;
	dc:source	pwn30:14246710-n .

<i111785>	a	<Concept> ;
	skos:definition	"cancer of the breast; one of the most common malignancies in women in the US"@en ;
	dc:source	pwn30:14246899-n .

<i111786>	a	<Concept> ;
	skos:definition	"a cluster of malignant cells that has not yet invaded the deeper epithelial tissue or spread to other parts of the body"@en ;
	dc:source	pwn30:14247035-n .

<i111787>	a	<Concept> ;
	skos:definition	"a malignant tumor of the colon; early symptom is bloody stools"@en ;
	dc:source	pwn30:14247239-n .

<i111788>	a	<Concept> ;
	skos:definition	"malignant neoplasm of the testis"@en ;
	dc:source	pwn30:14247360-n .

<i111789>	a	<Concept> ;
	skos:definition	"cancer of the uterine lining"@en ;
	dc:source	pwn30:14247458-n .

<i111790>	a	<Concept> ;
	skos:definition	"benign angioma consisting of a mass of blood vessels; some appear as birthmarks"@en ;
	dc:source	pwn30:14247575-n .

<i111791>	a	<Concept> ;
	skos:definition	"a congenital bright red superficial vascular tumor resembling a strawberry; tends to decrease in size during childhood"@en ;
	dc:source	pwn30:14247743-n .

<i111792>	a	<Concept> ;
	skos:definition	"benign angioma consisting of a mass of lymphatic vessels"@en ;
	dc:source	pwn30:14247954-n .

<i111793>	a	<Concept> ;
	skos:definition	"a dilation of superficial capillaries with a central red dot from which blood vessels radiate"@en ;
	dc:source	pwn30:14248069-n .

<i111794>	a	<Concept> ;
	skos:definition	"a tumor of the bone marrow (usually malignant) composed of cells normally found in bone marrow"@en ;
	dc:source	pwn30:14248256-n .

<i111795>	a	<Concept> ;
	skos:definition	"myeloma that develops in several places at the same time"@en ;
	dc:source	pwn30:14248422-n .

<i111796>	a	<Concept> ;
	skos:definition	"a benign tumor composed of muscle tissue"@en ;
	dc:source	pwn30:14248541-n .

<i111797>	a	<Concept> ;
	skos:definition	"a benign tumor of connective tissue containing jellylike material"@en ;
	dc:source	pwn30:14248669-n .

<i111798>	a	<Concept> ;
	skos:definition	"tumor (usually benign) of the sheath surrounding a nerve"@en ;
	dc:source	pwn30:14248787-n .

<i111799>	a	<Concept> ;
	skos:definition	"malignant tumor containing embryonic nerve cells; usually metastasizes quickly"@en ;
	dc:source	pwn30:14248899-n .

<i111800>	a	<Concept> ;
	skos:definition	"malignant tumor of the neuroepithelium"@en ;
	dc:source	pwn30:14249037-n .

<i111801>	a	<Concept> ;
	skos:definition	"tumor of the fibrous covering of a peripheral nerve"@en ;
	dc:source	pwn30:14249138-n .

<i111802>	a	<Concept> ;
	skos:definition	"any tumor derived from cells of the nervous system"@en ;
	dc:source	pwn30:14249262-n .

<i111803>	a	<Concept> ;
	skos:definition	"benign tumor of smooth muscle (usually in the uterus or digestive tract)"@en ;
	dc:source	pwn30:14249384-n .

<i111804>	a	<Concept> ;
	skos:definition	"benign rumor of striated muscle"@en ;
	dc:source	pwn30:14249512-n .

<i111805>	a	<Concept> ;
	skos:definition	"benign tumor of bone and fibrous tissue; occurs in the vertebrae or femur or tibia or arm bones (especially in young adults)"@en ;
	dc:source	pwn30:14249601-n .

<i111806>	a	<Concept> ;
	skos:definition	"benign tumor containing both bone and cartilage; usually occurs near the end of a long bone"@en ;
	dc:source	pwn30:14249785-n .

<i111807>	a	<Concept> ;
	skos:definition	"a slow growing benign tumor of consisting of bone tissue; usually on the skull or mandible"@en ;
	dc:source	pwn30:14249937-n .

<i111808>	a	<Concept> ;
	skos:definition	"a benign epithelial tumor forming a rounded mass"@en ;
	dc:source	pwn30:14250081-n .

<i111809>	a	<Concept> ;
	skos:definition	"a vascular tumor of the adrenal gland; hypersecretion of epinephrine results in intermittent or sustained hypertension"@en ;
	dc:source	pwn30:14250232-n .

<i111810>	a	<Concept> ;
	skos:definition	"tumor of the pineal gland"@en ;
	dc:source	pwn30:14250433-n .

<i111811>	a	<Concept> ;
	skos:definition	"neoplasm of plasma cells (usually in bone marrow)"@en ;
	dc:source	pwn30:14250514-n .

<i111812>	a	<Concept> ;
	skos:definition	"a tumor derived from fibrous tissue of the meninges or choroid plexus or certain other structures associated with the brain; characterized by sandlike particles"@en ;
	dc:source	pwn30:14250622-n .

<i111813>	a	<Concept> ;
	skos:definition	"malignant ocular tumor of retinal cells; usually occurs before the third year of life; composed of primitive small round retinal cells"@en ;
	dc:source	pwn30:14250850-n .

<i111814>	a	<Concept> ;
	skos:definition	"a tumor consisting of a mixture of tissues not normally found at that site"@en ;
	dc:source	pwn30:14251045-n .

<i111815>	a	<Concept> ;
	skos:definition	"carcinoma of the liver"@en ;
	dc:source	pwn30:14251174-n .

<i111816>	a	<Concept> ;
	skos:definition	"carcinoma of the lungs; one of the commonest forms of cancer"@en ;
	dc:source	pwn30:14251317-n .

<i111817>	a	<Concept> ;
	skos:definition	"a form of carcinoma of the mesothelium lining lungs or abdomen or heart; usually associated with exposure to asbestos dust"@en ;
	dc:source	pwn30:14251435-n .

<i111818>	a	<Concept> ;
	skos:definition	"highly malignant carcinoma composed of small round or egg-shaped cells with little cytoplasm; lung cancers are frequently oat cell carcinomas"@en ;
	dc:source	pwn30:14251616-n .

<i111819>	a	<Concept> ;
	skos:definition	"malignant neoplasm of the lips of mouth; most common in men over the age of 60"@en ;
	dc:source	pwn30:14251845-n .

<i111820>	a	<Concept> ;
	skos:definition	"cancer of the pancreas"@en ;
	dc:source	pwn30:14251981-n .

<i111821>	a	<Concept> ;
	skos:definition	"cancer of the prostate gland"@en ;
	dc:source	pwn30:14252067-n .

<i111822>	a	<Concept> ;
	skos:definition	"malignant tumor of the testis; usually occurring in older men"@en ;
	dc:source	pwn30:14252184-n .

<i111823>	a	<Concept> ;
	skos:definition	"a malignant neoplasm of the skin"@en ;
	dc:source	pwn30:14252320-n .

<i111824>	a	<Concept> ;
	skos:definition	"a malignant tumor of the epithelial tissue"@en ;
	dc:source	pwn30:14252464-n .

<i111825>	a	<Concept> ;
	skos:definition	"any of several malignant neoplasms (usually of the skin) consisting of melanocytes"@en ;
	dc:source	pwn30:14252564-n .

<i111826>	a	<Concept> ;
	skos:definition	"malignant neoplasm of the uterus derived from the epithelium of the chorion"@en ;
	dc:source	pwn30:14252722-n .

<i111827>	a	<Concept> ;
	skos:definition	"any disease of the eye"@en ;
	dc:source	pwn30:14252864-n .

<i111828>	a	<Concept> ;
	skos:definition	"a disease that typically does not affect human beings"@en ;
	dc:source	pwn30:14253124-n .

<i111829>	a	<Concept> ;
	skos:definition	"disease of cattle that can be transmitted to humans; results from infection with actinomycetes; characterized by hard swellings that exude pus through long sinuses"@en ;
	dc:source	pwn30:14254102-n .

<i111830>	a	<Concept> ;
	skos:definition	"the commonest and least severe form of actinomycosis; affects the face and neck regions"@en ;
	dc:source	pwn30:14254397-n .

<i111831>	a	<Concept> ;
	skos:definition	"an eye disease that involves the clouding or opacification of the natural lens of the eye"@en ;
	dc:source	pwn30:14254570-n .

<i111832>	a	<Concept> ;
	skos:definition	"an eye disease caused by a swelling of the macula resulting from leakage and accumulation of fluid"@en ;
	dc:source	pwn30:14254768-n .

<i111833>	a	<Concept> ;
	skos:definition	"a specific pattern of swelling in the central retina"@en ;
	dc:source	pwn30:14254926-n .

<i111834>	a	<Concept> ;
	skos:definition	"(plural) an eye disease resulting from small accumulations of hyaline bodies underneath the retina"@en ;
	dc:source	pwn30:14255064-n .

<i111835>	a	<Concept> ;
	skos:definition	"an eye disease that damages the optic nerve and impairs vision (sometimes progressing to blindness)"@en ;
	dc:source	pwn30:14255234-n .

<i111836>	a	<Concept> ;
	skos:definition	"glaucoma in which the iris blocks the outflow of aqueous humor"@en ;
	dc:source	pwn30:14255536-n .

<i111837>	a	<Concept> ;
	skos:definition	"glaucoma that results from damage to the optic nerve although the intraocular pressure is normal"@en ;
	dc:source	pwn30:14255848-n .

<i111838>	a	<Concept> ;
	skos:definition	"a cataract that affects the lens cortex"@en ;
	dc:source	pwn30:14256014-n .

<i111839>	a	<Concept> ;
	skos:definition	"a cataract that affects the nucleus of the lens"@en ;
	dc:source	pwn30:14256117-n .

<i111840>	a	<Concept> ;
	skos:definition	"a cataract in the rear of the lens capsule"@en ;
	dc:source	pwn30:14256227-n .

<i111841>	a	<Concept> ;
	skos:definition	"glaucoma caused by blockage of the canal of Schlemm; produces gradual loss of peripheral vision"@en ;
	dc:source	pwn30:14256346-n .

<i111842>	a	<Concept> ;
	skos:definition	"any disease of the cornea"@en ;
	dc:source	pwn30:14256585-n .

<i111843>	a	<Concept> ;
	skos:definition	"eye disease caused by degeneration of the cells of the macula lutea and results in blurred vision; can cause blindness"@en ;
	dc:source	pwn30:14256668-n .

<i111844>	a	<Concept> ;
	skos:definition	"macular degeneration that is age-related"@en ;
	dc:source	pwn30:14256889-n .

<i111845>	a	<Concept> ;
	skos:definition	"a disease of the retina that can result in loss of vision"@en ;
	dc:source	pwn30:14257014-n .

<i111846>	a	<Concept> ;
	skos:definition	"retinopathy involving damage to the small blood vessels in the retina; results from chronically high blood glucose levels in people with poorly controlled diabetes"@en ;
	dc:source	pwn30:14257147-n .

<i111847>	a	<Concept> ;
	skos:definition	"a chronic contagious viral disease marked by inflammation of the conjunctiva and cornea of the eye and the formation of scar tissue"@en ;
	dc:source	pwn30:14257377-n .

<i111848>	a	<Concept> ;
	skos:definition	"eye disease consisting of an opaque white spot on the cornea"@en ;
	dc:source	pwn30:14257563-n .

<i111849>	a	<Concept> ;
	skos:definition	"inflammation of a gland or lymph node"@en ;
	dc:source	pwn30:14257687-n .

<i111850>	a	<Concept> ;
	skos:definition	"inflammation of the alveoli in the lungs caused by inhaling dust; with repeated exposure the condition may become chronic"@en ;
	dc:source	pwn30:14257779-n .

<i111851>	a	<Concept> ;
	skos:definition	"inflammation in the socket of a tooth; sometimes occurs after a tooth is extracted and a blood clot fails to form"@en ;
	dc:source	pwn30:14257993-n .

<i111852>	a	<Concept> ;
	skos:definition	"inflammation of a blood vessel or lymph duct"@en ;
	dc:source	pwn30:14258176-n .

<i111853>	a	<Concept> ;
	skos:definition	"inflammation of the aorta"@en ;
	dc:source	pwn30:14258293-n .

<i111854>	a	<Concept> ;
	skos:definition	"aortitis occurring in rheumatic fever"@en ;
	dc:source	pwn30:14258391-n .

<i111855>	a	<Concept> ;
	skos:definition	"inflammation of the vermiform appendix"@en ;
	dc:source	pwn30:14258512-n .

<i111856>	a	<Concept> ;
	skos:definition	"inflammation of an artery"@en ;
	dc:source	pwn30:14258609-n .

<i111857>	a	<Concept> ;
	skos:definition	"inflammation of the outer coat of an artery"@en ;
	dc:source	pwn30:14258762-n .

<i111858>	a	<Concept> ;
	skos:definition	"inflammation of several arteries"@en ;
	dc:source	pwn30:14258865-n .

<i111859>	a	<Concept> ;
	skos:definition	"disorder characterized by the absence of a pulse in both arms and in the carotid arteries"@en ;
	dc:source	pwn30:14258957-n .

<i111860>	a	<Concept> ;
	skos:definition	"inflammation of the temporal arteries; characterized by headaches and difficulty chewing and (sometimes) visual impairment"@en ;
	dc:source	pwn30:14259133-n .

<i111861>	a	<Concept> ;
	skos:definition	"severe conjunctivitis"@en ;
	dc:source	pwn30:14259320-n .

<i111862>	a	<Concept> ;
	skos:definition	"ophthalmia in newborns; contracted while passing through the birth canal; usually prevented with silver nitrate drops"@en ;
	dc:source	pwn30:14259431-n .

<i111863>	a	<Concept> ;
	skos:definition	"a serious form of actinomycosis that affects the chest"@en ;
	dc:source	pwn30:14259616-n .

<i111864>	a	<Concept> ;
	skos:definition	"a serious form of actinomycosis that affects the abdomen"@en ;
	dc:source	pwn30:14259739-n .

<i111865>	a	<Concept> ;
	skos:definition	"alveolitis caused by an allergic reaction to fungal spores in the dust that is inhaled from moldy hay"@en ;
	dc:source	pwn30:14259865-n .

<i111866>	a	<Concept> ;
	skos:definition	"a disease of cattle that is transmitted by cattle ticks; similar to Texas fever"@en ;
	dc:source	pwn30:14260044-n .

<i111867>	a	<Concept> ;
	skos:definition	"a highly infectious animal disease (especially cattle and sheep); it can be transmitted to people"@en ;
	dc:source	pwn30:14260182-n .

<i111868>	a	<Concept> ;
	skos:definition	"severe respiratory disease of birds that takes the form of an acute rapidly fatal pneumonia in young chickens and turkeys"@en ;
	dc:source	pwn30:14260349-n .

<i111869>	a	<Concept> ;
	skos:definition	"inflammation of the lungs caused by inhaling or choking on vomitus; may occur during unconsciousness (anesthesia or drunkenness or seizure or cardiac arrest)"@en ;
	dc:source	pwn30:14260550-n .

<i111870>	a	<Concept> ;
	skos:definition	"alveolitis caused by inhaling bagasse (sugarcane dust)"@en ;
	dc:source	pwn30:14260774-n .

<i111871>	a	<Concept> ;
	skos:definition	"inflammation of the head of the penis"@en ;
	dc:source	pwn30:14260898-n .

<i111872>	a	<Concept> ;
	skos:definition	"inflammation of both the head of the penis and the foreskin"@en ;
	dc:source	pwn30:14260991-n .

<i111873>	a	<Concept> ;
	skos:definition	"any of various diseases of animals characterized by edema of the head and neck"@en ;
	dc:source	pwn30:14261112-n .

<i111874>	a	<Concept> ;
	skos:definition	"inflammation of the eyelids characterized by redness and swelling and dried crusts"@en ;
	dc:source	pwn30:14261244-n .

<i111875>	a	<Concept> ;
	skos:definition	"inflammation of a bursa; frequently in the shoulder"@en ;
	dc:source	pwn30:14261384-n .

<i111876>	a	<Concept> ;
	skos:definition	"an infectious disease of domestic animals often resulting in spontaneous abortion; transmittable to human beings"@en ;
	dc:source	pwn30:14261508-n .

<i111877>	a	<Concept> ;
	skos:definition	"a viral disease of sheep and cattle that is transmitted by biting midges"@en ;
	dc:source	pwn30:14261717-n .

<i111878>	a	<Concept> ;
	skos:definition	"a fatal disease of cattle that affects the central nervous system; causes staggering and agitation"@en ;
	dc:source	pwn30:14261846-n .

<i111879>	a	<Concept> ;
	skos:definition	"a disease of pigs resulting in swelling of the snout"@en ;
	dc:source	pwn30:14262045-n .

<i111880>	a	<Concept> ;
	skos:definition	"a viral disease of camels closely related to smallpox"@en ;
	dc:source	pwn30:14262153-n .

<i111881>	a	<Concept> ;
	skos:definition	"chorea in dogs"@en ;
	dc:source	pwn30:14262336-n .

<i111882>	a	<Concept> ;
	skos:definition	"any of several disease of livestock marked by fever and edema of the respiratory tract"@en ;
	dc:source	pwn30:14262419-n .

<i111883>	a	<Concept> ;
	skos:definition	"a wildlife disease (akin to bovine spongiform encephalitis) that affects deer and elk"@en ;
	dc:source	pwn30:14262585-n .

<i111884>	a	<Concept> ;
	skos:definition	"a fatal disease of freshwater fish caused by a flagellated protozoan invading the skin"@en ;
	dc:source	pwn30:14262740-n .

<i111885>	a	<Concept> ;
	skos:definition	"a viral disease of cattle causing a mild skin disease affecting the udder; formerly used to inoculate humans against smallpox"@en ;
	dc:source	pwn30:14262882-n .

<i111886>	a	<Concept> ;
	skos:definition	"a disease of cattle and sheep attributed to a dietary deficiency; characterized by anemia and softening of the bones and a slow stiff gait"@en ;
	dc:source	pwn30:14263089-n .

<i111887>	a	<Concept> ;
	skos:definition	"an acute infectious disease characterized by pneumonia and blood infection"@en ;
	dc:source	pwn30:14263280-n .

<i111888>	a	<Concept> ;
	skos:definition	"a chronic inflammation of the withers of a horse"@en ;
	dc:source	pwn30:14263440-n .

<i111889>	a	<Concept> ;
	skos:definition	"an acute diarrheal disease (especially of chickens) caused by the microorganism that causes hemorrhagic septicemia"@en ;
	dc:source	pwn30:14263562-n .

<i111890>	a	<Concept> ;
	skos:definition	"either of two acute viral diseases of domestic fowl; characterized by refusal to eat and high temperature and discoloration of the comb"@en ;
	dc:source	pwn30:14263753-n .

<i111891>	a	<Concept> ;
	skos:definition	"highly infectious virus disease of swine"@en ;
	dc:source	pwn30:14263944-n .

<i111892>	a	<Concept> ;
	skos:definition	"any of various infectious viral diseases of animals"@en ;
	dc:source	pwn30:14264042-n .

<i111893>	a	<Concept> ;
	skos:definition	"a viral disease of young dogs characterized by high fever and respiratory inflammation"@en ;
	dc:source	pwn30:14264203-n .

<i111894>	a	<Concept> ;
	skos:definition	"an acute bacterial disease of horses characterized by inflammation of the mucous membranes"@en ;
	dc:source	pwn30:14264352-n .

<i111895>	a	<Concept> ;
	skos:definition	"a disease of cattle and sheep that is attributed to toxins absorbed from the intestines"@en ;
	dc:source	pwn30:14264517-n .

<i111896>	a	<Concept> ;
	skos:definition	"acute contagious disease of cloven-footed animals marked by ulcers in the mouth and around the hoofs"@en ;
	dc:source	pwn30:14264664-n .

<i111897>	a	<Concept> ;
	skos:definition	"contagious degenerative infection of the feet of hoofed animals (especially cattle and sheep)"@en ;
	dc:source	pwn30:14264858-n .

<i111898>	a	<Concept> ;
	skos:definition	"a disease of the liver (especially in sheep and cattle) caused by liver flukes and their by-products"@en ;
	dc:source	pwn30:14265006-n .

<i111899>	a	<Concept> ;
	skos:definition	"a destructive and contagious bacterial disease of horses that can be transmitted to humans"@en ;
	dc:source	pwn30:14265205-n .

<i111900>	a	<Concept> ;
	skos:definition	"a chronic emphysema of the horse that causes difficult expiration and heaving of the flanks"@en ;
	dc:source	pwn30:14265350-n .

<i111901>	a	<Concept> ;
	skos:definition	"an acute inflammatory disease characterized by a rash with joint swelling and fever; caused by bacteria carried by the bite of a deer tick"@en ;
	dc:source	pwn30:14265508-n .

<i111902>	a	<Concept> ;
	skos:definition	"a viral disease of green monkeys caused by the Marburg virus; when transmitted to humans it causes serious or fatal illness"@en ;
	dc:source	pwn30:14265722-n .

<i111903>	a	<Concept> ;
	skos:definition	"the presence of excessive protein (chiefly albumin but also globulin) in the urine; usually a symptom of kidney disorder"@en ;
	dc:source	pwn30:14265958-n .

<i111904>	a	<Concept> ;
	skos:definition	"abnormal presence of amino acids in the urine; usually a symptom of metabolic defects"@en ;
	dc:source	pwn30:14266168-n .

<i111905>	a	<Concept> ;
	skos:definition	"excessive ammonia in the urine"@en ;
	dc:source	pwn30:14266313-n .

<i111906>	a	<Concept> ;
	skos:definition	"the presence of red blood cells in the urine"@en ;
	dc:source	pwn30:14266400-n .

<i111907>	a	<Concept> ;
	skos:definition	"a purplish discoloration of the mucous membrane of the vagina that occurs early in pregnancy"@en ;
	dc:source	pwn30:14266521-n .

<i111908>	a	<Concept> ;
	skos:definition	"a pigmented ring at the outer edge of the cornea of the eye; a symptom of Wilson's disease"@en ;
	dc:source	pwn30:14266677-n .

<i111909>	a	<Concept> ;
	skos:definition	"softening and drying and ulceration of the cornea resulting from vitamin A deficiency; symptom of cystic fibrosis or sprue"@en ;
	dc:source	pwn30:14266835-n .

<i111910>	a	<Concept> ;
	skos:definition	"symptom of meningitis; patient cannot extend the leg at the knee when the thigh is flexed because of stiffness in the hamstrings"@en ;
	dc:source	pwn30:14267017-n .

<i111911>	a	<Concept> ;
	skos:definition	"an abnormal increase of ketone bodies in the blood as in diabetes mellitus"@en ;
	dc:source	pwn30:14267205-n .

<i111912>	a	<Concept> ;
	skos:definition	"small red spots with white centers found on the mucous membranes of the mouth and tongue; symptom of measles that appears one or two days before the measles rash appears"@en ;
	dc:source	pwn30:14267358-n .

<i111913>	a	<Concept> ;
	skos:definition	"the presence of levulose is the urine"@en ;
	dc:source	pwn30:14267588-n .

<i111914>	a	<Concept> ;
	skos:definition	"the presence of abnormally high levels of glucose in the urine"@en ;
	dc:source	pwn30:14267722-n .

<i111915>	a	<Concept> ;
	skos:definition	"the presence of abnormally high levels of sugar in the urine"@en ;
	dc:source	pwn30:14267841-n .

<i111916>	a	<Concept> ;
	skos:definition	"the presence of lymph in the urine"@en ;
	dc:source	pwn30:14267994-n .

<i111917>	a	<Concept> ;
	skos:definition	"increase in the number of monocytes in the blood; symptom of monocytic leukemia"@en ;
	dc:source	pwn30:14268084-n .

<i111918>	a	<Concept> ;
	skos:definition	"increase in the number of platelets in the blood which tends to cause clots to form; associated with many neoplasms and chronic infections and other diseases"@en ;
	dc:source	pwn30:14268221-n .

<i111919>	a	<Concept> ;
	skos:definition	"an accumulation of dark pigment in cartilage and other connective tissue; usually a symptom of alkaptonuria or phenol poisoning"@en ;
	dc:source	pwn30:14268439-n .

<i111920>	a	<Concept> ;
	skos:definition	"the presence of abnormally high levels of calcium in the blood; usually the result of excessive bone resorption in hyperparathyroidism or Paget's disease"@en ;
	dc:source	pwn30:14268623-n .

<i111921>	a	<Concept> ;
	skos:definition	"abnormally low level of calcium in the blood; associated with hypoparathyroidism or kidney malfunction or vitamin D deficiency"@en ;
	dc:source	pwn30:14268871-n .

<i111922>	a	<Concept> ;
	skos:definition	"the presence of abnormally high levels of calcium in the urine; usually the result of excessive bone resorption in hyperparathyroidism or osteoporosis"@en ;
	dc:source	pwn30:14269090-n .

<i111923>	a	<Concept> ;
	skos:definition	"the presence of an abnormal amount of cholesterol in the cells and plasma of the blood; associated with the risk of atherosclerosis"@en ;
	dc:source	pwn30:14269319-n .

<i111924>	a	<Concept> ;
	skos:definition	"higher than normal levels of potassium in the circulating blood; associated with kidney failure or sometimes with the use of diuretic drugs"@en ;
	dc:source	pwn30:14269556-n .

<i111925>	a	<Concept> ;
	skos:definition	"abnormally low level of potassium in the circulating blood leading to weakness and heart abnormalities; associated with adrenal tumors or starvation or taking diuretics"@en ;
	dc:source	pwn30:14269772-n .

<i111926>	a	<Concept> ;
	skos:definition	"the presence of excess potassium in the circulating blood"@en ;
	dc:source	pwn30:14270016-n .

<i111927>	a	<Concept> ;
	skos:definition	"the presence of excess potassium in the urine"@en ;
	dc:source	pwn30:14270127-n .

<i111928>	a	<Concept> ;
	skos:definition	"the presence of abnormally large amounts of sodium in the urine"@en ;
	dc:source	pwn30:14270241-n .

<i111929>	a	<Concept> ;
	skos:definition	"any of various disorders of lipoprotein and cholesterol metabolism that result in high levels of lipoprotein and cholesterol in the circulating blood"@en ;
	dc:source	pwn30:14270380-n .

<i111930>	a	<Concept> ;
	skos:definition	"any of various disorders of lipoprotein and cholesterol metabolism that result in low levels of lipoprotein and cholesterol in the circulating blood"@en ;
	dc:source	pwn30:14270614-n .

<i111931>	a	<Concept> ;
	skos:definition	"abnormally low level of protein in the blood; can indicate inadequate diet or intestinal or renal disorders"@en ;
	dc:source	pwn30:14270846-n .

<i111932>	a	<Concept> ;
	skos:definition	"excessive amounts of sodium in the blood; possibly indicating diabetes insipidus"@en ;
	dc:source	pwn30:14271015-n .

<i111933>	a	<Concept> ;
	skos:definition	"abnormally low level of sodium in the blood; associated with dehydration"@en ;
	dc:source	pwn30:14271173-n .

<i111934>	a	<Concept> ;
	skos:definition	"enlarged spleen and a decrease in one or more types of blood cells; associated with many disorders"@en ;
	dc:source	pwn30:14271322-n .

<i111935>	a	<Concept> ;
	skos:definition	"excessive amounts of ketone bodies in the urine as in diabetes mellitus or starvation"@en ;
	dc:source	pwn30:14271480-n .

<i111936>	a	<Concept> ;
	skos:definition	"an acute viral disease of the nervous system of warm-blooded animals (usually transmitted by the bite of a rabid animal); rabies is fatal if the virus reaches the brain"@en ;
	dc:source	pwn30:14271667-n .

<i111937>	a	<Concept> ;
	skos:definition	"a disease of cattle; characterized by hematuria"@en ;
	dc:source	pwn30:14271920-n .

<i111938>	a	<Concept> ;
	skos:definition	"a respiratory infection of the nose and throat in cattle"@en ;
	dc:source	pwn30:14272023-n .

<i111939>	a	<Concept> ;
	skos:definition	"an acute infectious viral disease of cattle (usually fatal); characterized by fever and diarrhea and inflammation of mucous membranes"@en ;
	dc:source	pwn30:14272141-n .

<i111940>	a	<Concept> ;
	skos:definition	"diarrhea in livestock"@en ;
	dc:source	pwn30:14272347-n .

<i111941>	a	<Concept> ;
	skos:definition	"a fatal disease of sheep characterized by chronic itching and loss of muscular control and progressive degeneration of the central nervous system"@en ;
	dc:source	pwn30:14272421-n .

<i111942>	a	<Concept> ;
