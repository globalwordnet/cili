	dc:source	pwn30:06554675-n .

<i70909>	a	<Concept> ;
	skos:definition	"a writ authorizing the seizure of property that may be needed for the payment of a judgment in a judicial proceeding"@en ;
	dc:source	pwn30:06554981-n .

<i70910>	a	<Concept> ;
