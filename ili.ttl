	skos:definition	"a fungus with a small brown convex cap with a depressed disc; waxy wine-colored gills and a brown stalk; fruits in or near melting snow banks in the western mountains of North America"@en ;
	dc:source	pwn30:13073703-n .

<i105421>	a	<Concept> ;
	skos:definition	"a cobwebby partial veil consisting of silky fibrils"@en ;
	dc:source	pwn30:13073979-n .

<i105422>	a	<Concept> ;
	skos:definition	"a family of fungi belonging to the order Agaricales"@en ;
