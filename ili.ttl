<i112022>	a	<Concept> ;
	skos:definition	"any of several fungous or viral diseases characterized by yellow spotting on the leaves"@en ;
	dc:source	pwn30:14285113-n .

<i112023>	a	<Concept> ;
	skos:definition	"an emotional wound or shock often having long-lasting effects"@en ;
	dc:source	pwn30:14285276-n .

<i112024>	a	<Concept> ;
	skos:definition	"emotional injury inflicted on an infant by events incident to birth that is alleged to appear in symbolic form in patients with mental illness"@en ;
	dc:source	pwn30:14285461-n .

<i112025>	a	<Concept> ;
	skos:definition	"any physical damage to the body caused by violence or accident or fracture etc."@en ;
	dc:source	pwn30:14285662-n .

<i112026>	a	<Concept> ;
	skos:definition	"a wound that exposes subcutaneous tissue"@en ;
	dc:source	pwn30:14286339-n .

<i112027>	a	<Concept> ;
	skos:definition	"marks resembling the wounds on the crucified body of Christ"@en ;
	dc:source	pwn30:14286435-n .

<i112028>	a	<Concept> ;
	skos:definition	"an abraded area where the skin is torn or worn off"@en ;
	dc:source	pwn30:14286549-n .

<i112029>	a	<Concept> ;
	skos:definition	"a superficial abrasion"@en ;
	dc:source	pwn30:14286885-n .

<i112030>	a	<Concept> ;
	skos:definition	"abrasion (usually on the hands) caused by friction from a rope"@en ;
	dc:source	pwn30:14286995-n .

<i112031>	a	<Concept> ;
	skos:definition	"a wound made by cutting"@en ;
	dc:source	pwn30:14287113-n .

<i112032>	a	<Concept> ;
	skos:definition	"a torn ragged wound"@en ;
	dc:source	pwn30:14287314-n .

<i112033>	a	<Concept> ;
	skos:definition	"a wound resulting from biting by an animal or a person"@en ;
	dc:source	pwn30:14287408-n .

<i112034>	a	<Concept> ;
	skos:definition	"a bite inflicted by a dog"@en ;
	dc:source	pwn30:14287567-n .

<i112035>	a	<Concept> ;
	skos:definition	"a bite inflicted by a (venomous) snake"@en ;
	dc:source	pwn30:14287647-n .

<i112036>	a	<Concept> ;
	skos:definition	"a sting inflicted by a bee"@en ;
	dc:source	pwn30:14287741-n .

<i112037>	a	<Concept> ;
	skos:definition	"sting inflicted by a flea"@en ;
	dc:source	pwn30:14287823-n .

<i112038>	a	<Concept> ;
	skos:definition	"a sting inflicted by a mosquito"@en ;
	dc:source	pwn30:14287904-n .

<i112039>	a	<Concept> ;
	skos:definition	"physical injury to an infant during the birth process"@en ;
	dc:source	pwn30:14287995-n .

<i112040>	a	<Concept> ;
	skos:definition	"injury caused the explosion of a bomb (especially in enclosed spaces)"@en ;
	dc:source	pwn30:14288107-n .

<i112041>	a	<Concept> ;
	skos:definition	"the flow of blood from a ruptured blood vessel"@en ;
	dc:source	pwn30:14288235-n .

<i112042>	a	<Concept> ;
	skos:definition	"stroke caused by the rupture of a blood vessel in the brain"@en ;
	dc:source	pwn30:14288561-n .

<i112043>	a	<Concept> ;
	skos:definition	"injury incurred when the human body hits or is hit by a large outside object (as a car)"@en ;
	dc:source	pwn30:14288725-n .

<i112044>	a	<Concept> ;
	skos:definition	"an injury that doesn't break the skin but results in some discoloration"@en ;
	dc:source	pwn30:14288871-n .

<i112045>	a	<Concept> ;
	skos:definition	"the purple or black-and-blue area resulting from a bruise"@en ;
	dc:source	pwn30:14289079-n .

<i112046>	a	<Concept> ;
	skos:definition	"a minute red or purple spot on the surface of the skin as the result of tiny hemorrhages of blood vessels in the skin (as in typhoid fever)"@en ;
	dc:source	pwn30:14289193-n .

<i112047>	a	<Concept> ;
	skos:definition	"a swollen bruise caused by a blow to the eye"@en ;
	dc:source	pwn30:14289387-n .

<i112048>	a	<Concept> ;
	skos:definition	"a lump on the body caused by a blow"@en ;
	dc:source	pwn30:14289504-n .

<i112049>	a	<Concept> ;
	skos:definition	"an injury caused by exposure to heat or chemicals or radiation"@en ;
	dc:source	pwn30:14289590-n .

<i112050>	a	<Concept> ;
	skos:definition	"a burn caused by heat produced by an electric current"@en ;
	dc:source	pwn30:14289829-n .

<i112051>	a	<Concept> ;
	skos:definition	"a surface burn"@en ;
	dc:source	pwn30:14289942-n .

<i112052>	a	<Concept> ;
	skos:definition	"a burn cause by hot liquid or steam"@en ;
	dc:source	pwn30:14290107-n .

<i112053>	a	<Concept> ;
	skos:definition	"a state of reduced excitement or anxiety that is induced by the administrative of a sedative agent"@en ;
	dc:source	pwn30:14290212-n .

<i112054>	a	<Concept> ;
	skos:definition	"redness of the skin caused by exposure to the rays of the sun"@en ;
	dc:source	pwn30:14290365-n .

<i112055>	a	<Concept> ;
	skos:definition	"a browning of the skin resulting from exposure to the rays of the sun"@en ;
	dc:source	pwn30:14290534-n .

<i112056>	a	<Concept> ;
	skos:definition	"redness and irritation of the skin caused by exposure to high-velocity wind"@en ;
	dc:source	pwn30:14290751-n .

<i112057>	a	<Concept> ;
	skos:definition	"unusual darkening of the skin"@en ;
	dc:source	pwn30:14290881-n .

<i112058>	a	<Concept> ;
	skos:definition	"unusual lack of skin color"@en ;
	dc:source	pwn30:14291010-n .

<i112059>	a	<Concept> ;
	skos:definition	"burn causing redness of the skin surface"@en ;
	dc:source	pwn30:14291173-n .

<i112060>	a	<Concept> ;
	skos:definition	"burn causing blisters on the skin and superficial destruction of the dermis"@en ;
	dc:source	pwn30:14291295-n .

<i112061>	a	<Concept> ;
	skos:definition	"burn characterized by destruction of both epidermis and dermis"@en ;
	dc:source	pwn30:14291435-n .

<i112062>	a	<Concept> ;
	skos:definition	"a displacement of a part (especially a bone) from its normal position (as in the shoulder or the vertebral column)"@en ;
	dc:source	pwn30:14291561-n .

<i112063>	a	<Concept> ;
	skos:definition	"trauma caused by the passage of electric current through the body (as from contact with high voltage lines or being struck by lightning); usually involves burns and abnormal heart rhythm and unconsciousness"@en ;
	dc:source	pwn30:14291823-n .

<i112064>	a	<Concept> ;
	skos:definition	"breaking of hard tissue such as bone"@en ;
	dc:source	pwn30:14292090-n .

<i112065>	a	<Concept> ;
	skos:definition	"fracture in which the bone is splintered or crushed"@en ;
	dc:source	pwn30:14292571-n .

<i112066>	a	<Concept> ;
	skos:definition	"break involving the entire width of the bone"@en ;
	dc:source	pwn30:14292688-n .

<i112067>	a	<Concept> ;
	skos:definition	"bone fracture associated with lacerated soft tissue or an open wound"@en ;
	dc:source	pwn30:14292796-n .

<i112068>	a	<Concept> ;
	skos:definition	"fracture in which the bone collapses (especially in short bones such as vertebrae)"@en ;
	dc:source	pwn30:14292944-n .

<i112069>	a	<Concept> ;
	skos:definition	"fracture of the skull where the bone is pushed in"@en ;
	dc:source	pwn30:14293093-n .

<i112070>	a	<Concept> ;
	skos:definition	"fracture in which the two ends of the broken bone are separated from one another"@en ;
	dc:source	pwn30:14293207-n .

<i112071>	a	<Concept> ;
	skos:definition	"fracture resulting from excessive activity rather than a specific injury"@en ;
	dc:source	pwn30:14293352-n .

<i112072>	a	<Concept> ;
	skos:definition	"a fracture without separation of the fragments and the line of the break being very thin"@en ;
	dc:source	pwn30:14293505-n .

<i112073>	a	<Concept> ;
	skos:definition	"a partial fracture of a bone (usually in children); the bone is bent but broken on only one side"@en ;
	dc:source	pwn30:14293678-n .

<i112074>	a	<Concept> ;
	skos:definition	"fracture that does not go across the entire width of the bone"@en ;
	dc:source	pwn30:14293840-n .

<i112075>	a	<Concept> ;
	skos:definition	"fracture in which one broken end is wedged into the other broken end"@en ;
	dc:source	pwn30:14293985-n .

<i112076>	a	<Concept> ;
	skos:definition	"an uncomplicated fracture in which the broken bones to not pierce the skin"@en ;
	dc:source	pwn30:14294117-n .

<i112077>	a	<Concept> ;
	skos:definition	"dislocation of a joint"@en ;
	dc:source	pwn30:14294271-n .

<i112078>	a	<Concept> ;
	skos:definition	"separation of an epiphysis from the long bone to which it is normally attached without fracture of the bone"@en ;
	dc:source	pwn30:14294354-n .

<i112079>	a	<Concept> ;
	skos:definition	"a forward dislocation of one vertebra over the one beneath it producing pressure on spinal nerves"@en ;
	dc:source	pwn30:14294517-n .

<i112080>	a	<Concept> ;
	skos:definition	"destruction of tissue by freezing and characterized by tingling, blistering and possibly gangrene"@en ;
	dc:source	pwn30:14294678-n .

<i112081>	a	<Concept> ;
	skos:definition	"entry of foreign matter into a blood vessel"@en ;
	dc:source	pwn30:14294861-n .

<i112082>	a	<Concept> ;
	skos:definition	"injury incurred when an object (as a knife or bullet or shrapnel) penetrates into the body"@en ;
	dc:source	pwn30:14294964-n .

<i112083>	a	<Concept> ;
	skos:definition	"an injury resulting from getting some body part squeezed"@en ;
	dc:source	pwn30:14295140-n .

<i112084>	a	<Concept> ;
	skos:definition	"state of being torn or burst open"@en ;
	dc:source	pwn30:14295248-n .

<i112085>	a	<Concept> ;
	skos:definition	"rupture in smooth muscle tissue through which a bodily structure protrudes"@en ;
	dc:source	pwn30:14295389-n .

<i112086>	a	<Concept> ;
	skos:definition	"hernia projecting into the vagina"@en ;
	dc:source	pwn30:14295691-n .

<i112087>	a	<Concept> ;
	skos:definition	"a herniation through the muscular wall of a tubular organ (especially the colon)"@en ;
	dc:source	pwn30:14295829-n .

<i112088>	a	<Concept> ;
	skos:definition	"a congenital diverticulum in the ileum resulting from incomplete closure of the yolk sac"@en ;
	dc:source	pwn30:14295986-n .

<i112089>	a	<Concept> ;
	skos:definition	"protrusion of the intestine through the abdominal wall"@en ;
	dc:source	pwn30:14296142-n .

<i112090>	a	<Concept> ;
	skos:definition	"an umbilical hernia at birth in which some abdominal organs push into the umbilical cord"@en ;
	dc:source	pwn30:14296254-n .

<i112091>	a	<Concept> ;
	skos:definition	"hernia resulting from the protrusion of part of the stomach through the diaphragm"@en ;
	dc:source	pwn30:14296399-n .

<i112092>	a	<Concept> ;
	skos:definition	"a painful rupture of the fibrocartilage of the disc between spinal vertebrae; occurs most often in the lumbar region"@en ;
	dc:source	pwn30:14296579-n .

<i112093>	a	<Concept> ;
	skos:definition	"hernia in which a loop of intestine enters the inguinal canal; the most common type of hernia in males"@en ;
	dc:source	pwn30:14296802-n .

<i112094>	a	<Concept> ;
	skos:definition	"hernia in which the urinary bladder protrudes through the wall of the vagina; sometimes occurs after childbirth"@en ;
	dc:source	pwn30:14296966-n .

<i112095>	a	<Concept> ;
	skos:definition	"protrusion or herniation of the rectum into the vagina; can occur if pelvic muscles are weakened by childbirth"@en ;
	dc:source	pwn30:14297150-n .

<i112096>	a	<Concept> ;
	skos:definition	"hernia of the cornea"@en ;
	dc:source	pwn30:14297329-n .

<i112097>	a	<Concept> ;
	skos:definition	"hernia through the abdomen"@en ;
	dc:source	pwn30:14297406-n .

<i112098>	a	<Concept> ;
	skos:definition	"protrusion of the intestine and omentum through a hernia in the abdominal wall near the navel; usually self correcting after birth"@en ;
	dc:source	pwn30:14297489-n .

<i112099>	a	<Concept> ;
	skos:definition	"a disturbance of the normal sleep pattern"@en ;
	dc:source	pwn30:14297696-n .

<i112100>	a	<Concept> ;
	skos:definition	"a painful wound caused by the thrust of an insect's stinger into skin"@en ;
	dc:source	pwn30:14297870-n .

<i112101>	a	<Concept> ;
	skos:definition	"injury to a muscle (often caused by overuse); results in swelling and pain"@en ;
	dc:source	pwn30:14298102-n .

<i112102>	a	<Concept> ;
	skos:definition	"the condition of having respiration stopped by compression of the air passage"@en ;
	dc:source	pwn30:14298247-n .

<i112103>	a	<Concept> ;
	skos:definition	"an injury to the neck (the cervical vertebrae) resulting from rapid acceleration or deceleration (as in an automobile accident)"@en ;
	dc:source	pwn30:14298420-n .

<i112104>	a	<Concept> ;
	skos:definition	"a raised mark on the skin (as produced by the blow of a whip); characteristic of many allergic reactions"@en ;
	dc:source	pwn30:14298620-n .

<i112105>	a	<Concept> ;
	skos:definition	"an injury to living tissue (especially an injury involving a cut or break in the skin)"@en ;
	dc:source	pwn30:14298815-n .

<i112106>	a	<Concept> ;
	skos:definition	"a sharp strain on muscles or ligaments"@en ;
	dc:source	pwn30:14299070-n .

<i112107>	a	<Concept> ;
	skos:definition	"a painful injury to a joint caused by a sudden wrenching of its ligaments"@en ;
	dc:source	pwn30:14299336-n .

<i112108>	a	<Concept> ;
	skos:definition	"resembling frostbite but without freezing; resulting from exposure to cold and wet"@en ;
	dc:source	pwn30:14299480-n .

<i112109>	a	<Concept> ;
	skos:definition	"(medicine) any sensation or change in bodily function that is experienced by a patient and is associated with a particular disease"@en ;
	dc:source	pwn30:14299637-n .

<i112110>	a	<Concept> ;
	skos:definition	"(medicine) any objective evidence of the presence of a disorder or disease"@en ;
	dc:source	pwn30:14301785-n .

<i112111>	a	<Concept> ;
	skos:definition	"sign of life; usually an indicator of a person's general physical condition"@en ;
	dc:source	pwn30:14302005-n .

<i112112>	a	<Concept> ;
	skos:definition	"absence or suppression of normal menstrual flow"@en ;
	dc:source	pwn30:14302261-n .

<i112113>	a	<Concept> ;
	skos:definition	"a sensation (as of a cold breeze or bright light) that precedes the onset of certain disorders such as a migraine attack or epileptic seizure"@en ;
	dc:source	pwn30:14302460-n .

<i112114>	a	<Concept> ;
	skos:definition	"a tan discoloration of a woman's face that is associated with pregnancy or with the use of oral contraceptives"@en ;
	dc:source	pwn30:14302652-n .

<i112115>	a	<Concept> ;
	skos:definition	"a condition in which the ends of toes and fingers become wide and thick; a symptom of heart or lung disease"@en ;
	dc:source	pwn30:14302847-n .

<i112116>	a	<Concept> ;
	skos:definition	"a bluish discoloration of the skin and mucous membranes; a sign that oxygen in the blood is dangerously diminished (as in carbon monoxide poisoning)"@en ;
	dc:source	pwn30:14303009-n .

<i112117>	a	<Concept> ;
	skos:definition	"increased secretion of urine; if not due to increased liquid intake or to the action of a diuretic drug it can be a symptom of diabetes mellitus"@en ;
	dc:source	pwn30:14303249-n .

<i112118>	a	<Concept> ;
	skos:definition	"cyanosis of the extremities; can occur when a spasm of the blood vessels is caused by exposure to cold or by strong emotion"@en ;
	dc:source	pwn30:14303448-n .

<i112119>	a	<Concept> ;
	skos:definition	"delay of menarche beyond age 18"@en ;
	dc:source	pwn30:14303647-n .

<i112120>	a	<Concept> ;
	skos:definition	"cessation of menstruation in a woman who had previously menstruated"@en ;
	dc:source	pwn30:14303743-n .

<i112121>	a	<Concept> ;
	skos:definition	"an early symptom that a disease is developing or that an attack is about to occur"@en ;
	dc:source	pwn30:14303877-n .

<i112122>	a	<Concept> ;
	skos:definition	"a pattern of symptoms indicative of some disease"@en ;
	dc:source	pwn30:14304060-n .

<i112123>	a	<Concept> ;
	skos:definition	"an abnormal condition resulting from compression of spinal nerve roots in the neck region; involves neck pains and muscular weakness and paresthesia"@en ;
	dc:source	pwn30:14304722-n .

<i112124>	a	<Concept> ;
	skos:definition	"headache and tingling or burning feelings and sweating caused by eating food that contains monosodium glutamate"@en ;
	dc:source	pwn30:14304964-n .

<i112125>	a	<Concept> ;
	skos:definition	"disturbances in saltwater balance and symptoms of weakness and muscular cramps and twitching and convulsions and sometimes paralysis; usually caused by a benign tumor of the cortex of the adrenal gland that leads to excess secretion of aldosterone"@en ;
	dc:source	pwn30:14305149-n .

<i112126>	a	<Concept> ;
	skos:definition	"a congenital medical condition in which body deformation occurs or facial development or mental ability is impaired because the mother drinks alcohol during pregnancy"@en ;
	dc:source	pwn30:14305458-n .

<i112127>	a	<Concept> ;
	skos:definition	"a medical condition of uncertain origin that affected many veterans of the 1991 Gulf War; characterized by fatigue and headache and dizziness and nausea and rashes and joint pain and respiratory disorders"@en ;
	dc:source	pwn30:14305699-n .

<i112128>	a	<Concept> ;
	skos:definition	"a serious chronic and progressive inflammation of the ileum producing frequent bouts of diarrhea with abdominal pain and nausea and fever and weight loss"@en ;
	dc:source	pwn30:14305990-n .

<i112129>	a	<Concept> ;
	skos:definition	"recurrent abdominal pain and diarrhea (often alternating with periods of constipation); often associated with emotional stress"@en ;
	dc:source	pwn30:14306245-n .

<i112130>	a	<Concept> ;
	skos:definition	"syndrome in males that is characterized by small testes and long legs and enlarged breasts and reduced sperm production and mental retardation; a genetic defect in which an extra X chromosome (XXY) is present in the male"@en ;
	dc:source	pwn30:14306475-n .

<i112131>	a	<Concept> ;
	skos:definition	"a serious chronic inflammatory disease of the large intestine and rectum characterized by recurrent episodes of abdominal pain and fever and chills and profuse diarrhea"@en ;
	dc:source	pwn30:14306802-n .

<i112132>	a	<Concept> ;
	skos:definition	"a pattern of symptoms including loss of appetite and bloating and weight loss and muscle pain and steatorrhea; associated with celiac disease and sprue and cystic fibrosis"@en ;
	dc:source	pwn30:14307035-n .

<i112133>	a	<Concept> ;
	skos:definition	"syndrome consisting of feigning acute and dramatic illness for which no clinical evidence is ever found"@en ;
	dc:source	pwn30:14307275-n .

<i112134>	a	<Concept> ;
	skos:definition	"a sleep disorder characterized by sudden and uncontrollable episodes of deep sleep"@en ;
	dc:source	pwn30:14307468-n .

<i112135>	a	<Concept> ;
	skos:definition	"a syndrome characterized by edema and large amounts of protein in the urine and usually increased blood cholesterol; usually associated with glomerulonephritis or with a complication of various systemic diseases"@en ;
	dc:source	pwn30:14307724-n .

<i112136>	a	<Concept> ;
	skos:definition	"syndrome seen only in males; marked by short stature and lowset ears and subnormal fertility"@en ;
	dc:source	pwn30:14308012-n .

<i112137>	a	<Concept> ;
	skos:definition	"syndrome consisting of discomfort or pain in a limb that has been amputated"@en ;
	dc:source	pwn30:14308168-n .

<i112138>	a	<Concept> ;
	skos:definition	"a syndrome that occurs in many women from 2 to 14 days before the onset of menstruation"@en ;
	dc:source	pwn30:14308311-n .

<i112139>	a	<Concept> ;
	skos:definition	"syndrome resulting from exposure to ionizing radiation (e.g., exposure to radioactive chemicals or to nuclear explosions); low doses cause diarrhea and nausea and vomiting and sometimes loss of hair; greater exposure can cause sterility and cataracts and some forms of cancer and other diseases; severe exposure can cause death within hours"@en ;
	dc:source	pwn30:14308472-n .

<i112140>	a	<Concept> ;
	skos:definition	"syndrome resulting from infection by the herpes varicella zoster virus; characterized by vertigo and pain in the ears and facial nerve paralysis and sometimes hearing loss"@en ;
	dc:source	pwn30:14308945-n .

<i112141>	a	<Concept> ;
	skos:definition	"an inflammatory syndrome (etiology unknown) predominantly in males; characterized by arthritis and conjunctivitis and urethritis"@en ;
	dc:source	pwn30:14309183-n .

<i112142>	a	<Concept> ;
	skos:definition	"feeling of uneasiness and restlessness in the legs after going to bed (sometimes causing insomnia); may be relieved temporarily by walking or moving the legs"@en ;
	dc:source	pwn30:14309394-n .

<i112143>	a	<Concept> ;
	skos:definition	"acquired encephalopathy following acute viral infections (especially influenza or chicken pox) in young children; characterized by fever, vomiting, disorientation, coma, and fatty infiltration of the liver"@en ;
	dc:source	pwn30:14309653-n .

<i112144>	a	<Concept> ;
	skos:definition	"discomfort and vascular symptoms and loss of sensation in a shoulder and arm; caused by a scalene muscle compressing the subclavian artery and part of the brachial plexus"@en ;
	dc:source	pwn30:14309938-n .

<i112145>	a	<Concept> ;
	skos:definition	"death of a liveborn infant within the first 28 days of life"@en ;
	dc:source	pwn30:14310172-n .

<i112146>	a	<Concept> ;
	skos:definition	"sudden and unexpected death of an apparently healthy infant during sleep"@en ;
	dc:source	pwn30:14310292-n .

<i112147>	a	<Concept> ;
	skos:definition	"clinical neurological syndrome characterized by muscular twitching and cramps and (when severe) seizures; associated with calcium deficiency (hypoparathyroidism) or vitamin D deficiency or alkalosis"@en ;
	dc:source	pwn30:14310504-n .

<i112148>	a	<Concept> ;
	skos:definition	"tingling sensations in the fingers; caused by compression on a nerve supplying the arm"@en ;
	dc:source	pwn30:14310830-n .

<i112149>	a	<Concept> ;
	skos:definition	"syndrome characterized by swelling of rib cartilage (causing pain)"@en ;
	dc:source	pwn30:14310987-n .

<i112150>	a	<Concept> ;
	skos:definition	"neurological disorder characterized by facial grimaces and tics and movements of the upper body and grunts and shouts and coprolalia"@en ;
	dc:source	pwn30:14311117-n .

<i112151>	a	<Concept> ;
	skos:definition	"a symptom caused by an illness or a drug"@en ;
	dc:source	pwn30:14311348-n .

