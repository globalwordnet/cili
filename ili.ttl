	skos:definition	"a terrorist group that has worked with Al Qaeda; claimed responsibility for attacks in Iraq and Turkey"@en ;
	dc:source	pwn30:08010364-n .

<i79390>	a	<Instance> ;
	skos:definition	"a small gang of terrorist thugs claiming to seek a separate Islamic state for the Muslim minority in the Philippines; uses bombing and assassination and extortion and kidnapping"@en ;
	dc:source	pwn30:08010559-n .

<i79391>	a	<Instance> ;
	skos:definition	"a militant offshoot of al-Fatah that is the newest and strongest and best equipped faction active in the West Bank; responsible for many deadly attacks in Israel in 2002"@en ;
	dc:source	pwn30:08010942-n .

<i79392>	a	<Instance> ;
	skos:definition	"an urban hit squad and guerrilla group of the Communist Party in the Philippines; formed in the 1980s"@en ;
	dc:source	pwn30:08011266-n .

<i79393>	a	<Instance> ;
	skos:definition	"a Palestinian political and military organization founded by Yasser Arafat in 1958 to work toward the creation of a Palestinian state; during the 1960s and 1970s trained terrorist and insurgent groups"@en ;
	dc:source	pwn30:08011523-n .

<i79394>	a	<Instance> ;
	skos:definition	"a terrorist organization of militant Islamists organized into tiny cells of extreme fundamentalists; emerged during the 1970s mainly in Egyptian jails"@en ;
	dc:source	pwn30:08012028-n .

<i79395>	a	<Instance> ;
	skos:definition	"a fundamentalist Islamic group in Somalia who initially did fundraising for al-Qaeda; responsible for ambushing United States Army Rangers and for terrorist bombings in Ethiopia; believed to have branches in several countries"@en ;
	dc:source	pwn30:08012384-n .

<i79396>	a	<Instance> ;
	skos:definition	"an Islamic extremist group active since the late 1970s; seeks to overthrow the Egyptian government and replace it with an Islamic state; works in small underground cells"@en ;
	dc:source	pwn30:08012765-n .

<i79397>	a	<Instance> ;
	skos:definition	"a radical insurgent Islamist group consisting of disaffected middle-class professionals in Malaysia who want to overthrow the government by violent means and set up an Islamic state"@en ;
	dc:source	pwn30:08013176-n .

<i79398>	a	<Instance> ;
	skos:definition	"a hard-line extremist Islamic group in Great Britain who support bin Laden and other terrorist groups"@en ;
	dc:source	pwn30:08013453-n .

<i79399>	a	<Instance> ;
	skos:definition	"a Palestinian terrorist organization formed in 2002 and linked to Fatah movement of Yasser Arafat"@en ;
	dc:source	pwn30:08013653-n .

<i79400>	a	<Instance> ;
	skos:definition	"a terrorist network intensely opposed to the United States that dispenses money and logistical support and training to a wide variety of radical Islamic terrorist groups; has cells in more than 50 countries"@en ;
	dc:source	pwn30:08013845-n .

<i79401>	a	<Instance> ;
	skos:definition	"a terrorist group organized in 1996 after the Taliban took over Afghanistan and part of Osama bin Laden's international system; provides financial support for the Taliban and al-Qaeda and Jaish-i-Mohammed and assists Muslim militants around the world; established a network of madrasas and mosques in Afghanistan"@en ;
	dc:source	pwn30:08014202-n .

<i79402>	a	<Instance> ;
	skos:definition	"a resurgent Islamic fundamentalist organization based in Nigeria that is thought to be planning terrorist attacks"@en ;
	dc:source	pwn30:08014615-n .

<i79403>	a	<Instance> ;
	skos:definition	"an Islamic terrorist cell that originated in Jordan but operates in Germany; goal is to attack Europe and Russia with chemical weapons"@en ;
	dc:source	pwn30:08014860-n .

<i79404>	a	<Instance> ;
	skos:definition	"a terrorist group formed in India in 1992; is believed to be responsible for bombings in southern India in 1998"@en ;
	dc:source	pwn30:08015116-n .

<i79405>	a	<Instance> ;
	skos:definition	"a radical Islamic group of terrorists in the Iraqi part of Kurdistan who oppose an independent secular nation as advocated by the United States; some members fought with the Taliban and al-Qaeda forces in Afghanistan; said to receive financial support from Saddam Hussein"@en ;
	dc:source	pwn30:08015321-n .

<i79406>	a	<Instance> ;
	skos:definition	"a terrorist organization founded in 1999 to oppose the link between nationalists and the Corsican mafia"@en ;
	dc:source	pwn30:08015731-n .

<i79407>	a	<Instance> ;
	skos:definition	"a terrorist organization of Islamic extremists whose violent activities began in 1992; aims to overthrow the secular Algerian regime and replace it with an Islamic state"@en ;
	dc:source	pwn30:08016035-n .

<i79408>	a	<Instance> ;
	skos:definition	"a militant Marxist-Leninist terrorist organization formed in 1975 to force Turkey to acknowledge killing more than a million Armenians and forcibly removing them from border areas in 1915; wants Turkey to pay reparations and cede territory to Armenia"@en ;
	dc:source	pwn30:08016385-n .

<i79409>	a	<Instance> ;
	skos:definition	"a terrorist organization that seeks to overthrow the government dominated by Tutsi and to institute Hutu control again"@en ;
	dc:source	pwn30:08016900-n .

<i79410>	a	<Instance> ;
	skos:definition	"an extremist Palestinian Sunni group active in Lebanon in the early 1990s that advocates Salafism; responsible for murders and bombings; seeks to overthrow the Lebanese government and control Palestinian refugee camps; funded by al-Qaeda"@en ;
	dc:source	pwn30:08017257-n .

<i79411>	a	<Instance> ;
	skos:definition	"a terrorist organization whose goal is to take over Japan and then the world; based on a religion founded in 1987 that combines elements of Buddhism with Christianity"@en ;
	dc:source	pwn30:08017614-n .

<i79412>	a	<Instance> ;
	skos:definition	"a radical left-wing revolutionary terrorist group active in Germany from 1968 until 1977"@en ;
	dc:source	pwn30:08017974-n .

<i79413>	a	<Instance> ;
	skos:definition	"a terrorist organization organized in 1959 by student activists who were dissatisfied with the moderate nationalism of the traditional Basque party; want to create an independent homeland in Spain's western Pyrenees"@en ;
	dc:source	pwn30:08018189-n .

<i79414>	a	<Instance> ;
	skos:definition	"a former Palestinian terrorist organization (now merged with Fatah Revolutionary Council) that assassinated the Prime Minister of Jordan and during the 1972 Olympic Games in Munich killed 11 Israeli athletes"@en ;
	dc:source	pwn30:08018666-n .

<i79415>	a	<Instance> ;
	skos:definition	"an ultra-leftist militant group founded in 1957 from the breakup of the Japanese Communist Party; includes a covert action wing"@en ;
	dc:source	pwn30:08018983-n .

<i79416>	a	<Instance> ;
	skos:definition	"a terrorist organization formed in Ireland in 1994 as a clandestine armed wing of Sinn Fein"@en ;
	dc:source	pwn30:08019281-n .

<i79417>	a	<Instance> ;
	skos:definition	"a Marxist-Leninist group that believes Palestinian goals can only be achieved by revolutionary change"@en ;
	dc:source	pwn30:08019523-n .

<i79418>	a	<Instance> ;
	skos:definition	"a group of Uighur Muslims fighting Chinese control of Xinjiang; declared by China in 2001 to be terrorists although there is a long history of cycles of insurgency and repression"@en ;
	dc:source	pwn30:08019913-n .

<i79419>	a	<Instance> ;
	skos:definition	"a Palestinian international terrorist organization that split from the PLO in 1974; has conducted terrorist attacks in 20 countries"@en ;
	dc:source	pwn30:08020242-n .

<i79420>	a	<Instance> ;
	skos:definition	"a terrorist group organized by Yasser Arafat in 1995 as the armed wing of al-Fatah; serves a dual function of violent confrontation with Israel and serves as Arafat's unofficial militia to prevent rival Islamists from usurping leadership"@en ;
	dc:source	pwn30:08020785-n .

<i79421>	a	<Instance> ;
	skos:definition	"an armed wing of the (illegal) Communist Party of Spain; seeks to overthrow the Spanish government and replace it with a Marxist-Leninist regime"@en ;
	dc:source	pwn30:08021129-n .

<i79422>	a	<Instance> ;
	skos:definition	"formed in 1972 as a personal security force for Arafat and other PLO leaders; became one of PLO's elite units; has built an extensive infrastructure of terrorist cells and weapon depots in Europe while attacking Israeli targets"@en ;
	dc:source	pwn30:08021464-n .

<i79423>	a	<Instance> ;
	skos:definition	"a little known Palestinian group responsible for bombings and for killing Israelis; seeks to defeat Israel and liberate southern Lebanon, Palestine, and Golan Heights"@en ;
	dc:source	pwn30:08021785-n .

<i79424>	a	<Instance> ;
	skos:definition	"an international organization that works for environmental conservation and the preservation of endangered species"@en ;
	dc:source	pwn30:08022087-n .

<i79425>	a	<Instance> ;
	skos:definition	"a militant Islamic fundamentalist political movement that opposes peace with Israel and uses terrorism as a weapon; seeks to create an Islamic state in place of Israel; is opposed to the PLO and has become a leading perpetrator of terrorist activity in Israel; pioneered suicide bombing"@en ;
	dc:source	pwn30:08022259-n .

<i79426>	a	<Instance> ;
	skos:definition	"an extremist militant group in Pakistan occupied Kashmir that seeks an Islamic government and that has had close links and fought with the Taliban in Afghanistan"@en ;
	dc:source	pwn30:08022666-n .

<i79427>	a	<Instance> ;
	skos:definition	"an Islamic fundamentalist group in Pakistan that fought the Soviet Union in Afghanistan in the 1980s; now operates as a terrorist organization primarily in Kashmir and seeks Kashmir's accession by Pakistan"@en ;
	dc:source	pwn30:08022972-n .

<i79428>	a	<Instance> ;
	skos:definition	"a Shiite terrorist organization with strong ties to Iran; seeks to create an Iranian fundamentalist Islamic state in Lebanon; car bombs are the signature weapon"@en ;
	dc:source	pwn30:08023374-n .

<i79429>	a	<Instance> ;
	skos:definition	"the most popular and feared Islamic extremist group in central Asia; advocates `pure' Islam and the creation of a worldwide Islamic state"@en ;
	dc:source	pwn30:08023843-n .

<i79430>	a	<Instance> ;
	skos:definition	"a terrorist group organized by Osama bin Laden in 1998 that provided an umbrella organization for al-Qaeda and other militant groups in Egypt and Algeria and Pakistan and Bangladesh"@en ;
	dc:source	pwn30:08024096-n .

<i79431>	a	<Instance> ;
	skos:definition	"a radical terrorist group dedicated to the removal of British forces from Northern Ireland and the unification of Ireland"@en ;
	dc:source	pwn30:08024408-n .

<i79432>	a	<Instance> ;
	skos:definition	"a militant organization of Irish nationalists who used terrorism and guerilla warfare in an effort to drive British forces from Northern Ireland and achieve a united independent Ireland"@en ;
	dc:source	pwn30:08024732-n .

<i79433>	a	<Instance> ;
	skos:definition	"Yemen-based terrorist group that supports al-Qaeda's goals; seeks to overthrow the Yemeni government and eliminate United States interests; responsible for bombings and kidnappings and killing western tourists in Yemen"@en ;
	dc:source	pwn30:08025112-n .

<i79434>	a	<Instance> ;
	skos:definition	"a Turkish terrorist organization that claimed responsibility for bombing a British consulate and bank in Istanbul; a violent opponent of Turkey's secular government and its ties to the European Union and NATO"@en ;
	dc:source	pwn30:08025497-n .

<i79435>	a	<Instance> ;
	skos:definition	"a terrorist group of Islamic militants formed in 1996; opposes Uzbekistan's secular regime and wants to establish an Islamic state in central Asia; is a conduit for drugs from Afghanistan to central Asian countries"@en ;
	dc:source	pwn30:08025835-n .

<i79436>	a	<Instance> ;
	skos:definition	"a terrorist organization founded in 2000; a militant Islamic group active in Kashmir and closely aligned with al-Rashid Trust; seeks to secure release of imprisoned fellow militants by kidnappings"@en ;
	dc:source	pwn30:08026197-n .

<i79437>	a	<Instance> ;
	skos:definition	"an Islamic terrorist group organized in the 1980s; seeks to purify Islam through violence; the cells in North America and the Caribbean insulate themselves from Western culture and will even attack other Muslims who they regard as heretics"@en ;
	dc:source	pwn30:08026539-n .

<i79438>	a	<Instance> ;
	skos:definition	"a terrorist group organized in 1970 to overthrow the Japanese government and monarchy and to foment world revolution; is said to have close ties with Palestinian terrorists"@en ;
	dc:source	pwn30:08026904-n .

<i79439>	a	<Instance> ;
	skos:definition	"an indigenous Islamic terrorist group in Azerbaijan that attempted to bomb the United States embassy in 1999"@en ;
	dc:source	pwn30:08027314-n .

<i79440>	a	<Instance> ;
	skos:definition	"a clandestine group of southeast Asian terrorists organized in 1993 and trained by al-Qaeda; supports militant Muslims in Indonesia and the Philippines and has cells in Singapore and Malaysia and Indonesia"@en ;
	dc:source	pwn30:08027518-n .

<i79441>	a	<Instance> ;
	skos:definition	"ethnic Turkish Sunni terrorists who are linked with the Turkish Hizballah; killed a United States Air Force sergeant in 1991"@en ;
	dc:source	pwn30:08027920-n .

<i79442>	a	<Instance> ;
	skos:definition	"an Islamic extremist group of Kurds who oppose secular control with bombings and assassinations; believed to have ties with al-Qaeda"@en ;
	dc:source	pwn30:08028148-n .

<i79443>	a	<Instance> ;
	skos:definition	"a terrorist organization founded for Jewish defense; fights antisemitism and hopes to restore the biblical state of Israel"@en ;
	dc:source	pwn30:08028397-n .

<i79444>	a	<Instance> ;
	skos:definition	"a Turkish terrorist group of fundamentalist Muslims with ties to al-Qaeda that operates in Germany; seeks the violent overthrow of the Turkish government and the establishment of an Islamic nation modeled on Iran"@en ;
	dc:source	pwn30:08028623-n .

<i79445>	a	<Instance> ;
	skos:definition	"a communist organization formed in Cambodia in 1970; became a terrorist organization in 1975 when it captured Phnom Penh and created a government that killed an estimated three million people; was defeated by Vietnamese troops but remained active until 1999"@en ;
	dc:source	pwn30:08028999-n .

<i79446>	a	<Instance> ;
	skos:definition	"a secret society of white Southerners in the United States; was formed in the 19th century to resist the emancipation of slaves; used terrorist tactics to suppress Black people"@en ;
	dc:source	pwn30:08029421-n .

<i79447>	a	<Concept> ;
	skos:definition	"a local unit of the Ku Klux Klan"@en ;
	dc:source	pwn30:08029784-n .

<i79448>	a	<Instance> ;
	skos:definition	"a Marxist-Leninist terrorist group of Kurds trying to establish an independent Kurdish state in eastern Turkey"@en ;
	dc:source	pwn30:08029908-n .

<i79449>	a	<Instance> ;
	skos:definition	"a Nicaraguan counterrevolutionary guerrilla force from 1979 to 1990; it opposed a left-wing government, with support from the United States"@en ;
	dc:source	pwn30:08030185-n .

<i79450>	a	<Instance> ;
	skos:definition	"a Kurdish guerrilla force in Iraqi Kurdistan"@en ;
	dc:source	pwn30:08030379-n .

<i79451>	a	<Instance> ;
	skos:definition	"a Sunni Muslim extremist group in Pakistan that collaborates with al-Qaeda; the armed wing of Sipah-e-Sahaba"@en ;
	dc:source	pwn30:08030481-n .

<i79452>	a	<Instance> ;
	skos:definition	"a terrorist organization formed in Pakistan in 2002 as a coalition of extremist Islamic militant groups including Lashkar-e-Taiba and Lashkar-e-Jhangvi and Jaish-e-Muhammad and elements of al-Qaeda"@en ;
	dc:source	pwn30:08030711-n .

<i79453>	a	<Instance> ;
	skos:definition	"a brutal terrorist group active in Kashmir; fights against India with the goal of restoring Islamic rule of India"@en ;
	dc:source	pwn30:08031020-n .

<i79454>	a	<Instance> ;
	skos:definition	"a paramilitary terrorist organization of militant Muslims in Indonesia; wages a jihad against Christians in Indonesia; subscribes to the Wahhabi creed of Islam"@en ;
	dc:source	pwn30:08031386-n .

<i79455>	a	<Instance> ;
	skos:definition	"a violent terrorist group organized in the 1980s and advocating the overthrow of the Chilean military government; leaders are mainly criminals or impoverished youths"@en ;
	dc:source	pwn30:08031663-n .

<i79456>	a	<Instance> ;
	skos:definition	"a terrorist organization in Sri Lanka that began in 1970 as a student protest over the limited university access for Tamil students; currently seeks to establish an independent Tamil state called Eelam; relies on guerilla strategy including terrorist tactics that target key government and military personnel"@en ;
	dc:source	pwn30:08032023-n .

<i79457>	a	<Instance> ;
	skos:definition	"a Libyan terrorist group organized in 1995 and aligned with al-Qaeda; seeks to radicalize the Libyan government; attempted to assassinate Qaddafi"@en ;
	dc:source	pwn30:08032594-n .

<i79458>	a	<Instance> ;
	skos:definition	"a quasi-religious rebel group in Uganda that terrorized and raped women and kidnapped children who were forced to serve in the army"@en ;
	dc:source	pwn30:08032955-n .

<i79459>	a	<Instance> ;
	skos:definition	"a terrorist group formed in 1996 in Northern Ireland; seeks to prevent the peace process; murders Catholics and any Protestant leaders who favor peace"@en ;
	dc:source	pwn30:08033194-n .

<i79460>	a	<Instance> ;
	skos:definition	"a terrorist organization founded by Osama bin Laden in the 1980s to provide money and recruit fighters around the world; enlisted and transported thousands of men to Afghanistan to fight the Russians; a split in the group led bin Laden and the extremist faction of MAK to form al-Qaeda"@en ;
	dc:source	pwn30:08033454-n .

<i79461>	a	<Instance> ;
	skos:definition	"a terrorist group formed in 1983 as the armed wing of the Chilean Communist Party"@en ;
	dc:source	pwn30:08033829-n .

<i79462>	a	<Instance> ;
	skos:definition	"a terrorist group of radical leftists formed in the late 1980s; seeks to prevent the United States from intervening in Honduran economic and political affairs"@en ;
	dc:source	pwn30:08034028-n .

<i79463>	a	<Instance> ;
	skos:definition	"a terrorist group in the southern Philippines formed in 1977 to establish an independent Islamic state for the Moros; have clashed with troops at United States bases"@en ;
	dc:source	pwn30:08034299-n .

<i79464>	a	<Instance> ;
	skos:definition	"a militant Islamic militia that was formed in 2005 by hardliners who split from Jemaah Islamiyah"@en ;
	dc:source	pwn30:08034579-n .

<i79465>	a	<Instance> ;
	skos:definition	"a terrorist organization formed in the 1960s by children of Iranian merchants; sought to counter the Shah of Iran's pro-western policies of modernization and opposition to communism; following a philosophy that mixes Marxism and Islam it now attacks the Islamic fundamentalists who deposed the Shah"@en ;
	dc:source	pwn30:08034778-n .

<i79466>	a	<Instance> ;
	skos:definition	"a terrorist organization in Bolivia that acts as an umbrella for numerous small indigenous subversive groups; a revival of a group with Marxist-Leninist ideologies originally established by Che Guevara in the 1960s"@en ;
	dc:source	pwn30:08035233-n .

<i79467>	a	<Instance> ;
	skos:definition	"a Marxist terrorist group formed in 1963 by Colombian intellectuals who were inspired by the Cuban Revolution; responsible for a campaign of mass kidnappings and resistance to the government's efforts to stop the drug trade"@en ;
	dc:source	pwn30:08035601-n .

<i79468>	a	<Instance> ;
	skos:definition	"a terrorist group formed in 1976 to work for Corsican independence; attacks on Corsica are aimed at sabotaging public infrastructure and symbols of colonialism"@en ;
	dc:source	pwn30:08036005-n .

<i79469>	a	<Instance> ;
	skos:definition	"a terrorist organization that is the militant wing of the Communist Party of the Philippines; a Maoist organization formed to overthrow the government; uses hit squads called Sparrow Units; opposes United States military presence in the Philippines"@en ;
	dc:source	pwn30:08036293-n .

<i79470>	a	<Instance> ;
	skos:definition	"a Protestant political organization in Northern Ireland"@en ;
	dc:source	pwn30:08036669-n .

<i79471>	a	<Instance> ;
	skos:definition	"a terrorist group of Protestants who oppose any political settlement with Irish nationalists; a paramilitary group that attacks Catholic interests in Northern Ireland"@en ;
	dc:source	pwn30:08036849-n .

<i79472>	a	<Instance> ;
	skos:definition	"a militant Palestinian terrorist group created in 1979 and committed to the creation of an Islamic state in Palestine and to the destruction of Israel; smaller and more exclusively militant that Hamas"@en ;
	dc:source	pwn30:08037118-n .

<i79473>	a	<Instance> ;
	skos:definition	"a terrorist group formed in 1977 as the result of a split with the Popular Front for the Liberation of Palestine; became a satellite of al-Fatah; made terrorist attacks on Israel across the Lebanese border"@en ;
	dc:source	pwn30:08037503-n .

<i79474>	a	<Instance> ;
	skos:definition	"a little known Palestinian group comprised of members of Hamas and Tanzim with suspected ties to the Lebanese Hizballah; responsible for suicide bombings in Israel"@en ;
	dc:source	pwn30:08037861-n .

<i79475>	a	<Instance> ;
	skos:definition	"a Filipino terrorist group that broke away from the Moro Islamic Liberation Front in 2001 in order to continue terrorism and kidnapping and extortion"@en ;
	dc:source	pwn30:08038131-n .

<i79476>	a	<Instance> ;
	skos:definition	"a terrorist group of limited popularity formed in 1967 after the Six-Day War; combined Marxist-Leninist ideology with Palestinian nationalism; used terrorism to gain attention for their cause; hoped to eliminate the state of Israel"@en ;
	dc:source	pwn30:08038379-n .

<i79477>	a	<Instance> ;
	skos:definition	"a Marxist-Leninist terrorist organization that conducted several attacks in western Europe"@en ;
	dc:source	pwn30:08038748-n .

<i79478>	a	<Instance> ;
	skos:definition	"a terrorist group of radical Palestinians who split with al-Fatah in 1967 but now have close relations with al-Fatah; staged terrorist attacks against Israel across the Lebanese border"@en ;
	dc:source	pwn30:08038995-n .

<i79479>	a	<Instance> ;
	skos:definition	"a terrorist organization formed in 1979 by a faction of the Popular Front for the Liberation of Palestine but disbanded in the 1980s when key members left to join a faction of al-Fatah"@en ;
	dc:source	pwn30:08039312-n .

<i79480>	a	<Instance> ;
	skos:definition	"a terrorist organization in South Africa formed in 1996 to fight drug lords; evolved into a vigilante group with anti-western views closely allied with Qibla; is believed to have ties to Islamic extremists in the Middle East; is suspected of conducting bouts of urban terrorism"@en ;
	dc:source	pwn30:08039601-n .

<i79481>	a	<Instance> ;
	skos:definition	"a small but violent terrorist organization formed in Ecuador in the early 1990s; responsible for bombing several government buildings"@en ;
	dc:source	pwn30:08040008-n .

<i79482>	a	<Instance> ;
	skos:definition	"the military arm of Hamas responsible for suicide bombings and other attacks on Israel"@en ;
	dc:source	pwn30:08040257-n .

<i79483>	a	<Instance> ;
	skos:definition	"a small terrorist group of Muslims in South Africa formed in the 1980s; was inspired by Ayatollah Khomeini to create an Islamic state in South Africa"@en ;
	dc:source	pwn30:08040522-n .

<i79484>	a	<Instance> ;
	skos:definition	"a radical terrorist group that broke away in 1997 when the mainstream Provisional IRA proposed a cease-fire; has continued terrorist activities in opposition to any peace agreement"@en ;
	dc:source	pwn30:08040762-n .

<i79485>	a	<Instance> ;
	skos:definition	"a Marxist and Maoist terrorist organization in Germany; a network of underground guerillas who committed acts of violence in the service of the class struggle; a successor to the Baader-Meinhof Gang; became one of Europe's most feared terrorist groups; disbanded in 1998"@en ;
	dc:source	pwn30:08041106-n .

<i79486>	a	<Instance> ;
	skos:definition	"a Marxist-Leninist terrorist organization that arose out of a student protest movement in the late 1960s; wants to separate Italy from NATO and advocates violence in the service of class warfare and revolution; mostly inactive since 1989"@en ;
	dc:source	pwn30:08041484-n .

<i79487>	a	<Instance> ;
	skos:definition	"a paramilitary group of Protestants in Northern Ireland that tries to prevent any political settlement with the Irish Republic; attacks interests of Catholic civilians in Northern Ireland; responsible for arson and bombing and murder"@en ;
	dc:source	pwn30:08041840-n .

<i79488>	a	<Instance> ;
	skos:definition	"a powerful and wealthy terrorist organization formed in 1957 as the guerilla arm of the Colombian communist party; opposed to the United States; has strong ties to drug dealers"@en ;
	dc:source	pwn30:08042183-n .

<i79489>	a	<Instance> ;
	skos:definition	"a Marxist-Leninist terrorist organization in Greece that is violently opposed to imperialism and capitalism and NATO and the United States; an active terrorist group during the 1980s"@en ;
	dc:source	pwn30:08042536-n .

<i79490>	a	<Instance> ;
	skos:definition	"an extreme Marxist terrorist organization in Turkey that is opposed to NATO and the United States; attacks Turkish security and military officials"@en ;
	dc:source	pwn30:08042856-n .

<i79491>	a	<Instance> ;
	skos:definition	"an extreme leftist terrorist group formed in Greece in 1971 to oppose the military junta that ruled Greece from 1967 to 1974; a revolutionary group opposed to capitalism and imperialism and the United States"@en ;
	dc:source	pwn30:08043169-n .

<i79492>	a	<Instance> ;
	skos:definition	"a clandestine group of leftist extremists who oppose Italy's labor policies and foreign policy; responsible for bombing building in the historic center of Rome from 2000 to 2002"@en ;
	dc:source	pwn30:08043499-n .

<i79493>	a	<Instance> ;
	skos:definition	"a terrorist group formed in the 1980s in Sierra Leone; seeks to overthrow the government and gain control of the diamond producing regions; responsible for attacks on civilians and children, widespread torture and murder and using children to commit atrocities; sponsored by the president of Liberia"@en ;
	dc:source	pwn30:08043848-n .

<i79494>	a	<Instance> ;
	skos:definition	"an Algerian extremist Islamic offshoot of the Armed Islamic Group; now the largest and most active armed terrorist group in Algeria that seeks to overthrow the government; a major source of support and recruitment for al-Qaeda operations in Europe and northern Africa"@en ;
	dc:source	pwn30:08044265-n .

<i79495>	a	<Instance> ;
	skos:definition	"a terrorist group formed in Peru in the late 1960s as a splinter group from the communist party of Peru; is among the most ruthless guerilla organizations in the world; seeks to destroy Peruvian institutions and replace them with a Maoist peasant regime; is involved in the cocaine trade"@en ;
	dc:source	pwn30:08044676-n .

<i79496>	a	<Instance> ;
	skos:definition	"a vicious sectarian organization in Pakistan that persecutes Shiite Muslims and collaborates with al-Qaeda to attack foreigners and to disrupt the government of Pakistan"@en ;
	dc:source	pwn30:08045140-n .

<i79497>	a	<Instance> ;
	skos:definition	"an organization of Muslims in India who killed Hindus in September 2002; believed to have ties with Muslim terrorists in Pakistan"@en ;
	dc:source	pwn30:08045428-n .

<i79498>	a	<Instance> ;
	skos:definition	"a Marxist-Leninist terrorist organization in Peru; was formed in 1983 to overthrow the Peruvian government and replace it with a Marxist regime; has connections with the ELN in Bolivia"@en ;
	dc:source	pwn30:08045681-n .

<i79499>	a	<Instance> ;
	skos:definition	"a terrorist group that is the remnants of the original Bolivian insurgents trained by Che Guevara; attacks small unprotected targets such as power pylons or oil pipelines or government buildings"@en ;
	dc:source	pwn30:08046032-n .

<i79500>	a	<Instance> ;
	skos:definition	"an ethnic Kurdish group of Sunni extremists formed in the late 1980s in southeastern Turkey; seeks to replace Turkey's secular regime with an Islamic state and strict shariah law; responsible for bombings and the torture and murder of Turkish and Kurdish journalists and businessmen; receives support from Iran"@en ;
	dc:source	pwn30:08046346-n .

<i79501>	a	<Instance> ;
	skos:definition	"the major Protestant paramilitary group in Northern Ireland; responsible for bombing the homes of Catholics and for criminal racketeering and selling drugs"@en ;
	dc:source	pwn30:08046759-n .

<i79502>	a	<Instance> ;
	skos:definition	"a terrorist organization in Colombia formed in 1997 as an umbrella for local and regional paramilitary groups; is financed by earnings from narcotics and serves to protect the economic interests of its members"@en ;
	dc:source	pwn30:08047032-n .

<i79503>	a	<Instance> ;
	skos:definition	"a Sunni organization formed in 1989 and based in Pakistan; opposes missionary groups from the United States; has Lashkar-e-Tayyiba as its armed wing"@en ;
	dc:source	pwn30:08047501-n .

<i79504>	a	<Concept> ;
	skos:definition	"an international organization that cares for the sick or wounded or homeless in wartime"@en ;
	dc:source	pwn30:08047747-n .

<i79505>	a	<Concept> ;
	skos:definition	"a charitable and religious organization to evangelize and to care for the poor and homeless"@en ;
	dc:source	pwn30:08047890-n .

<i79506>	a	<Concept> ;
	skos:definition	"a political organization within the Democratic Party in New York City (late 1800's and early 1900's) seeking political control by corruption and bossism"@en ;
	dc:source	pwn30:08048042-n .

<i79507>	a	<Concept> ;
	skos:definition	"a nongovernmental organization of Pakistani scientists that has been a supporter of terrorism; has provided information about chemical and biological and nuclear warfare to Osama bin Laden and al-Qaeda and the Taliban"@en ;
	dc:source	pwn30:08048300-n .

<i79508>	a	<Concept> ;
	skos:definition	"an organization that is controlled by a dominant person or group"@en ;
	dc:source	pwn30:08048625-n .

<i79509>	a	<Concept> ;
	skos:definition	"any organization whose responsibility it is to defend against something"@en ;
	dc:source	pwn30:08048743-n .

<i79510>	a	<Concept> ;
	skos:definition	"the organizational structure of activities contributing directly to the organization's output"@en ;
	dc:source	pwn30:08048948-n .

<i79511>	a	<Concept> ;
	skos:definition	"an organization concerned to preserve historic monuments and buildings and places of historical interest or natural beauty; founded in 1895 and supported by endowment and private subscription"@en ;
	dc:source	pwn30:08049125-n .

<i79512>	a	<Concept> ;
	skos:definition	"a formal organization of people or groups of people"@en ;
	dc:source	pwn30:08049401-n .

<i79513>	a	<Concept> ;
	skos:definition	"an association of nations consisting of the United Kingdom and several former British colonies that are now sovereign states but still pay allegiance to the British Crown"@en ;
	dc:source	pwn30:08049989-n .

<i79514>	a	<Concept> ;
	skos:definition	"a politically organized unit"@en ;
	dc:source	pwn30:08050385-n .

<i79515>	a	<Concept> ;
	skos:definition	"a quasi nongovernmental organization; an organization that is financed by the government yet acts independently of the government"@en ;
	dc:source	pwn30:08050484-n .

<i79516>	a	<Concept> ;
	skos:definition	"the organization that is the governing authority of a political unit"@en ;
	dc:source	pwn30:08050678-n .

<i79517>	a	<Concept> ;
	skos:definition	"a government that concentrates political power in an authority not responsible to the people"@en ;
	dc:source	pwn30:08051384-n .

<i79518>	a	<Concept> ;
	skos:definition	"a government that is administered primarily by bureaus that are staffed with nonelective officials"@en ;
	dc:source	pwn30:08051565-n .

<i79519>	a	<Concept> ;
	skos:definition	"a political and social system that no longer governs (especially the system that existed in France before the French Revolution)"@en ;
	dc:source	pwn30:08051739-n .

<i79520>	a	<Concept> ;
	skos:definition	"the sovereign and his advisers who are the governing power of a state"@en ;
	dc:source	pwn30:08051946-n .

<i79521>	a	<Concept> ;
	skos:definition	"the British royal court"@en ;
	dc:source	pwn30:08052135-n .

<i79522>	a	<Concept> ;
	skos:definition	"the Ottoman court in Constantinople"@en ;
	dc:source	pwn30:08052227-n .

<i79523>	a	<Concept> ;
	skos:definition	"the British government"@en ;
	dc:source	pwn30:08052330-n .

<i79524>	a	<Concept> ;
	skos:definition	"a group of countries under a single authority"@en ;
	dc:source	pwn30:08052413-n .

<i79525>	a	<Concept> ;
	skos:definition	"a government with strong central powers"@en ;
	dc:source	pwn30:08052549-n .

<i79526>	a	<Concept> ;
	skos:definition	"a temporary government moved to or formed in a foreign land by exiles who hope to rule when their country is liberated"@en ;
	dc:source	pwn30:08052690-n .

<i79527>	a	<Concept> ;
	skos:definition	"the government of a local area"@en ;
	dc:source	pwn30:08052874-n .

<i79528>	a	<Concept> ;
	skos:definition	"government by the military and an army"@en ;
	dc:source	pwn30:08053003-n .

<i79529>	a	<Concept> ;
	skos:definition	"the governing group of a kingdom"@en ;
	dc:source	pwn30:08053121-n .

<i79530>	a	<Concept> ;
	skos:definition	"the government of the Roman Catholic Church"@en ;
	dc:source	pwn30:08053260-n .

<i79531>	a	<Concept> ;
	skos:definition	"the government of the Soviet Union"@en ;
	dc:source	pwn30:08053407-n .

<i79532>	a	<Concept> ;
	skos:definition	"an organization founded and united for a specific purpose"@en ;
	dc:source	pwn30:08053576-n .

<i79533>	a	<Concept> ;
	skos:definition	"an institution created for the practice of medicine"@en ;
	dc:source	pwn30:08053905-n .

<i79534>	a	<Concept> ;
	skos:definition	"a medical establishment run by a group of medical specialists"@en ;
	dc:source	pwn30:08054076-n .

<i79535>	a	<Concept> ;
	skos:definition	"a medical institution that provides prolonged care (as in cases of prolonged illness or rehabilitation from acute illness)"@en ;
	dc:source	pwn30:08054226-n .

<i79536>	a	<Concept> ;
	skos:definition	"a medical institution where sick or injured people are given medical or surgical care"@en ;
