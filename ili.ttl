	skos:definition	"the study of the origins and genealogy of the gods"@en ;
	dc:source	pwn30:06248863-n .

<i69347>	a	<Concept> ;
	skos:definition	"the branch of military science dealing with detailed maneuvers to achieve objectives set by strategy"@en ;
	dc:source	pwn30:06248968-n .

<i69348>	a	<Concept> ;
	skos:definition	"the branch of military science dealing with military command and the planning and conduct of a war"@en ;
	dc:source	pwn30:06249177-n .

<i69349>	a	<Concept> ;
	skos:definition	"a Gestalt principle of organization holding that there is an innate tendency to perceive incomplete objects as complete and to close or fill gaps and to perceive asymmetric stimuli as symmetric"@en ;
	dc:source	pwn30:06249421-n .

<i69350>	a	<Concept> ;
	skos:definition	"a Gestalt principle of organization holding that aspects of perceptual field that move or function in a similar manner will be perceived as a unit"@en ;
	dc:source	pwn30:06249685-n .

<i69351>	a	<Concept> ;
	skos:definition	"(linguistics) a doctrine supporting or promoting descriptive linguistics"@en ;
	dc:source	pwn30:06249910-n .

<i69352>	a	<Concept> ;
	skos:definition	"(ethics) a doctrine holding that moral statements have a truth value"@en ;
	dc:source	pwn30:06250061-n .

<i69353>	a	<Concept> ;
	skos:definition	"a Gestalt principle of organization holding that there is an innate tendency to perceive a line as continuing its established direction"@en ;
	dc:source	pwn30:06250208-n .

<i69354>	a	<Concept> ;
	skos:definition	"(linguistics) a doctrine supporting or promoting prescriptive linguistics"@en ;
	dc:source	pwn30:06250444-n .

<i69355>	a	<Concept> ;
	skos:definition	"(ethics) a doctrine holding that moral statements prescribe appropriate attitudes and behavior"@en ;
	dc:source	pwn30:06250597-n .

<i69356>	a	<Concept> ;
	skos:definition	"a Gestalt principle of organization holding that (other things being equal) objects or events that are near to one another (in space or time) are perceived as belonging together as a unit"@en ;
	dc:source	pwn30:06250771-n .

<i69357>	a	<Concept> ;
	skos:definition	"a Gestalt principle of organization holding that (other things being equal) parts of a stimulus field that are similar to each other tend to be perceived as belonging together as a unit"@en ;
	dc:source	pwn30:06251033-n .

