	dc:source	pwn30:05345038-n .

<i65043>	a	<Concept> ;
	skos:definition	"the chief artery of the thigh; a continuation of the external iliac artery"@en ;
	dc:source	pwn30:05345247-n .

<i65044>	a	<Concept> ;
	skos:definition	"a continuation of the femoral artery that branches to supply the legs and feet"@en ;
	dc:source	pwn30:05345421-n .

<i65045>	a	<Concept> ;
	skos:definition	"the arteries that supply the walls of the stomach"@en ;
	dc:source	pwn30:05345581-n .

