	dc:source	pwn30:05344073-n .

<i65037>	a	<Concept> ;
	skos:definition	"arises from the left aortic sinus; supplies the left side of the heart"@en ;
	dc:source	pwn30:05344213-n .

<i65038>	a	<Concept> ;
	skos:definition	"a branch of the hepatic artery; supplies the gall bladder and the surface of the liver"@en ;
	dc:source	pwn30:05344350-n .

<i65039>	a	<Concept> ;
	skos:definition	"arteries in the hand and foot that supply the fingers and toes"@en ;
	dc:source	pwn30:05344514-n .

