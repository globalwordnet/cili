	dc:source	pwn30:15116095-n .

<i116635>	a	<Concept> ;
	skos:definition	"the time of the physical formation and development of the earth (especially prior to human history)"@en ;
	dc:source	pwn30:15116283-n .

<i116636>	a	<Concept> ;
	skos:definition	"the time of various biological processes"@en ;
	dc:source	pwn30:15116532-n .

<i116637>	a	<Concept> ;
