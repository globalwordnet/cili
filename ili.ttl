	dc:source	pwn30:05326060-n .

<i64950>	a	<Concept> ;
	skos:definition	"a tenuous mesoblastic membrane surrounding the lens of the eye"@en ;
	dc:source	pwn30:05326200-n .

<i64951>	a	<Concept> ;
	skos:definition	"the ossicle between the malleus and the stapes"@en ;
	dc:source	pwn30:05326340-n .

<i64952>	a	<Concept> ;
	skos:definition	"the stirrup-shaped ossicle that transmits sound from the incus to the cochlea"@en ;
	dc:source	pwn30:05326465-n .

<i64953>	a	<Concept> ;
	skos:definition	"the snail-shaped tube (in the inner ear coiled around the modiolus) where sound vibrations are converted into nerve impulses by the organ of Corti"@en ;
	dc:source	pwn30:05326624-n .

<i64954>	a	<Concept> ;
	skos:definition	"a membrane (one of 3) that envelops the brain and spinal cord"@en ;
	dc:source	pwn30:05326900-n .

<i64955>	a	<Concept> ;
	skos:definition	"mucus-secreting membrane lining all body cavities or passages that communicate with the exterior"@en ;
	dc:source	pwn30:05327134-n .

<i64956>	a	<Concept> ;
	skos:definition	"a dense fibrous membrane covering the surface of bones (except at their extremities) and serving as an attachment for tendons and muscles; contains nerves and blood vessels that nourish the enclosed bone"@en ;
	dc:source	pwn30:05327373-n .

<i64957>	a	<Concept> ;
	skos:definition	"tissue layer around small blood vessels"@en ;
	dc:source	pwn30:05327652-n .

<i64958>	a	<Concept> ;
	skos:definition	"any of various organs that synthesize substances needed by the body and release it through ducts or directly into the bloodstream"@en ;
	dc:source	pwn30:05327767-n .

<i64959>	a	<Concept> ;
	skos:definition	"a gland that secretes oil"@en ;
	dc:source	pwn30:05328115-n .

<i64960>	a	<Concept> ;
	skos:definition	"a cutaneous gland that secretes sebum (usually into a hair follicle) for lubricating hair and skin"@en ;
	dc:source	pwn30:05328232-n .

<i64961>	a	<Concept> ;
	skos:definition	"a long sebaceous gland that lubricates the eyelids"@en ;
	dc:source	pwn30:05328508-n .

<i64962>	a	<Concept> ;
	skos:definition	"one of the sebaceous glands on the areolae of the breast that lubricate the breast during breast-feeding"@en ;
	dc:source	pwn30:05328695-n .

<i64963>	a	<Concept> ;
	skos:definition	"a gland that secretes externally through a duct"@en ;
	dc:source	pwn30:05328867-n .

<i64964>	a	<Concept> ;
	skos:definition	"the system that makes food absorbable into the body"@en ;
	dc:source	pwn30:05329215-n .

<i64965>	a	<Concept> ;
	skos:definition	"the system of glands that produce endocrine secretions that help to control bodily metabolic activity"@en ;
	dc:source	pwn30:05329533-n .

<i64966>	a	<Concept> ;
	skos:definition	"any of the glands of the endocrine system that secrete hormones directly into the bloodstream"@en ;
	dc:source	pwn30:05329735-n .

<i64967>	a	<Concept> ;
	skos:definition	"located near the base of the neck"@en ;
	dc:source	pwn30:05330244-n .

<i64968>	a	<Concept> ;
	skos:definition	"any one of four endocrine glands situated above or within the thyroid gland"@en ;
	dc:source	pwn30:05330365-n .

<i64969>	a	<Concept> ;
	skos:definition	"a small duct that conveys sweat from a sudoriferous gland to the surface of the skin"@en ;
	dc:source	pwn30:05330518-n .

<i64970>	a	<Concept> ;
	skos:definition	"any of the glands in the skin that secrete perspiration"@en ;
	dc:source	pwn30:05330659-n .

<i64971>	a	<Concept> ;
	skos:definition	"a large sweat gland that produces both a fluid and an apocrine secretion; in human beings located in hairy regions of the body"@en ;
	dc:source	pwn30:05330848-n .

<i64972>	a	<Concept> ;
	skos:definition	"a small sweat gland that produces only a fluid; restricted to the human skin"@en ;
	dc:source	pwn30:05331035-n .

<i64973>	a	<Concept> ;
	skos:definition	"either of a pair of complex endocrine glands situated near the kidney"@en ;
	dc:source	pwn30:05331171-n .

<i64974>	a	<Concept> ;
	skos:definition	"a firm partly muscular chestnut sized gland in males at the neck of the urethra; produces a viscid secretion that is the fluid part of semen"@en ;
	dc:source	pwn30:05331404-n .

<i64975>	a	<Concept> ;
	skos:definition	"any of the glands in the eyes that secrete tears"@en ;
	dc:source	pwn30:05331653-n .

<i64976>	a	<Concept> ;
	skos:definition	"any of several small ducts that carry tears from the lacrimal glands"@en ;
	dc:source	pwn30:05331812-n .

<i64977>	a	<Concept> ;
	skos:definition	"either of the two dilated ends of the lacrimal ducts at the nasal ends of the eyes that fill with tears secreted by the lacrimal glands"@en ;
	dc:source	pwn30:05331988-n .

<i64978>	a	<Concept> ;
	skos:definition	"small fragile bone making up part of the front inner walls of each eye socket and providing room for the passage of the lacrimal ducts"@en ;
	dc:source	pwn30:05332225-n .

<i64979>	a	<Concept> ;
	skos:definition	"a duct that carries tears from the lacrimal sac to the nasal cavity"@en ;
	dc:source	pwn30:05332438-n .

<i64980>	a	<Concept> ;
	skos:definition	"a ductless glandular organ at the base of the neck that produces lymphocytes and aids in producing immunity; atrophies with age"@en ;
	dc:source	pwn30:05332569-n .

<i64981>	a	<Concept> ;
	skos:definition	"either of two bean-shaped excretory organs that filter wastes (especially urea) from the blood and excrete them and water in urine"@en ;
	dc:source	pwn30:05332802-n .

<i64982>	a	<Concept> ;
	skos:definition	"an organ that separates waste substances from the blood and discharges them"@en ;
	dc:source	pwn30:05333259-n .

<i64983>	a	<Concept> ;
	skos:definition	"a large dark-red oval organ on the left side of the body between the stomach and the diaphragm; produces cells involved in immune responses"@en ;
	dc:source	pwn30:05333467-n .

<i64984>	a	<Concept> ;
	skos:definition	"a blood vessel that carries blood from the heart to the body"@en ;
	dc:source	pwn30:05333777-n .

<i64985>	a	<Concept> ;
	skos:definition	"a branch of the maxillary artery that supplies the alveolar process"@en ;
	dc:source	pwn30:05335310-n .

<i64986>	a	<Concept> ;
	skos:definition	"the alveolar artery that goes through the mandibular canal to supply the lower teeth"@en ;
	dc:source	pwn30:05335515-n .

<i64987>	a	<Concept> ;
	skos:definition	"the alveolar artery that supplies the upper teeth"@en ;
	dc:source	pwn30:05335700-n .

<i64988>	a	<Concept> ;
	skos:definition	"the terminal branch of the facial artery"@en ;
	dc:source	pwn30:05335850-n .

<i64989>	a	<Concept> ;
	skos:definition	"the large trunk artery that carries blood from the left ventricle of the heart to branch arteries"@en ;
	dc:source	pwn30:05335971-n .

<i64990>	a	<Concept> ;
