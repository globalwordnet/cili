	dc:source	pwn30:05336748-n .

<i64995>	a	<Concept> ;
	skos:definition	"the branch of the ileocolic artery that supplies the vermiform appendix"@en ;
	dc:source	pwn30:05336893-n .

<i64996>	a	<Concept> ;
	skos:definition	"curved artery in the foot"@en ;
	dc:source	pwn30:05337055-n .

<i64997>	a	<Concept> ;
	skos:definition	"curved arteries of the kidney"@en ;
	dc:source	pwn30:05337178-n .

<i64998>	a	<Concept> ;
	skos:definition	"one of the small thin-walled arteries that end in capillaries"@en ;
	dc:source	pwn30:05337301-n .

<i64999>	a	<Concept> ;
