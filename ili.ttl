	dc:source	pwn30:07059962-n .

<i73787>	a	<Concept> ;
	skos:definition	"the traditional and typically anonymous music that is an expression of the life of people in a community"@en ;
	dc:source	pwn30:07060167-n .

<i73788>	a	<Concept> ;
	skos:definition	"a simple style of folk music heard mostly in the southern United States; usually played on stringed instruments"@en ;
	dc:source	pwn30:07060440-n .

<i73789>	a	<Concept> ;
	skos:definition	"a genre of popular music composed for ballroom dancing"@en ;
	dc:source	pwn30:07060697-n .

<i73790>	a	<Concept> ;
	skos:definition	"music with a syncopated melody (usually for the piano)"@en ;
	dc:source	pwn30:07060844-n .

<i73791>	a	<Concept> ;
	skos:definition	"a style of dance music popular in the 1920s; similar to New Orleans jazz but played by large bands"@en ;
	dc:source	pwn30:07060976-n .

<i73792>	a	<Concept> ;
	skos:definition	"a kind of danceable music popular among black South Africans; includes a whistle among its instruments"@en ;
	dc:source	pwn30:07061180-n .

<i73793>	a	<Concept> ;
	skos:definition	"folk music consisting of a genre of a cappella music originating with Black slaves in the United States and featuring call and response; influential on the development of other genres of popular music (especially soul)"@en ;
	dc:source	pwn30:07061334-n .

<i73794>	a	<Concept> ;
	skos:definition	"a genre (usually a cappella) of Black vocal-harmony music of the 1950s that evolved in New York City from gospel singing; characterized by close four-part harmonies; the name derived from some of the nonsense syllables sung by the backup"@en ;
	dc:source	pwn30:07061677-n .

<i73795>	a	<Concept> ;
	skos:definition	"a secular form of gospel that was a major Black musical genre in the 1960s and 1970s"@en ;
	dc:source	pwn30:07061968-n .

<i73796>	a	<Concept> ;
	skos:definition	"a type of country music played at a rapid tempo on banjos and guitars"@en ;
	dc:source	pwn30:07062190-n .

<i73797>	a	<Concept> ;
	skos:definition	"country music originating in mountainous regions of southern United States"@en ;
	dc:source	pwn30:07062315-n .

<i73798>	a	<Concept> ;
	skos:definition	"music performed for square dancing"@en ;
	dc:source	pwn30:07062451-n .

<i73799>	a	<Concept> ;
	skos:definition	"music of southern Louisiana that combines French dance melodies with Caribbean music and blues"@en ;
	dc:source	pwn30:07062550-n .

<i73800>	a	<Concept> ;
	skos:definition	"a genre of popular music that originated in New Orleans around 1900 and developed through increasingly complex styles"@en ;
	dc:source	pwn30:07062697-n .

<i73801>	a	<Concept> ;
	skos:definition	"an early form of modern jazz (originating around 1940)"@en ;
	dc:source	pwn30:07063101-n .

<i73802>	a	<Concept> ;
	skos:definition	"an instrumental version of the blues (especially for piano)"@en ;
	dc:source	pwn30:07063249-n .

<i73803>	a	<Concept> ;
	skos:definition	"jazz that is restrained and fluid and marked by intricate harmonic structures often lagging slightly behind the beat"@en ;
	dc:source	pwn30:07063413-n .

<i73804>	a	<Concept> ;
	skos:definition	"an earthy type of jazz combining it with blues and soul; has a heavy bass line that accentuates the first beat in the bar"@en ;
	dc:source	pwn30:07063585-n .

<i73805>	a	<Concept> ;
	skos:definition	"jazz that is emotionally charged and intense and marked by strong rhythms and improvisation"@en ;
	dc:source	pwn30:07063775-n .

<i73806>	a	<Concept> ;
	skos:definition	"any of various styles of jazz that appeared after 1940"@en ;
	dc:source	pwn30:07063921-n .

<i73807>	a	<Concept> ;
	skos:definition	"genre of African-American music of the 1980s and 1990s in which rhyming lyrics are chanted to a musical accompaniment; several forms of rap have emerged"@en ;
	dc:source	pwn30:07064055-n .

<i73808>	a	<Concept> ;
	skos:definition	"a combination of blues and jazz that was developed in the United States by Black musicians; an important precursor of rock 'n' roll"@en ;
	dc:source	pwn30:07064315-n .

<i73809>	a	<Concept> ;
	skos:definition	"a fusion of black music and country music that was popular in the 1950s; sometimes described as blues with a country beat"@en ;
	dc:source	pwn30:07064537-n .

<i73810>	a	<Concept> ;
	skos:definition	"a genre of popular music originating in the 1950s; a blend of black rhythm-and-blues with white country-and-western"@en ;
	dc:source	pwn30:07064715-n .

<i73811>	a	<Concept> ;
	skos:definition	"loud and harsh sounding rock music with a strong beat; lyrics usually involve violent or fantastic imagery"@en ;
	dc:source	pwn30:07065149-n .

<i73812>	a	<Concept> ;
	skos:definition	"a style of rock music that emerged in the 1970s; associated with attempts to combine rock with jazz and other forms; intended for listening and not dancing"@en ;
	dc:source	pwn30:07065333-n .

<i73813>	a	<Concept> ;
	skos:definition	"a musical style that emerged in the 1960s; rock music inspired by or related to drug-induced experience"@en ;
	dc:source	pwn30:07065562-n .

<i73814>	a	<Concept> ;
	skos:definition	"rock music with deliberately offensive lyrics expressing anger and social alienation; in part a reaction against progressive rock"@en ;
	dc:source	pwn30:07065740-n .

<i73815>	a	<Concept> ;
	skos:definition	"traditional jazz as revived in the 1950s"@en ;
	dc:source	pwn30:07065932-n .

<i73816>	a	<Concept> ;
	skos:definition	"a style of jazz played by big bands popular in the 1930s; flowing rhythms but less complex than later styles of jazz"@en ;
	dc:source	pwn30:07066042-n .

<i73817>	a	<Concept> ;
	skos:definition	"popular music originating in the West Indies; repetitive bass riffs and regular chords played on the off beat by a guitar"@en ;
	dc:source	pwn30:07066285-n .

<i73818>	a	<Concept> ;
