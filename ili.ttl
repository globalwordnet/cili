	dc:source	pwn30:07083958-n .

<i73876>	a	<Concept> ;
	skos:definition	"rise and fall of the voice pitch"@en ;
	dc:source	pwn30:07084166-n .

<i73877>	a	<Concept> ;
	skos:definition	"intonations characteristic of questions and requests and statements"@en ;
	dc:source	pwn30:07084428-n .

<i73878>	a	<Concept> ;
	skos:definition	"an unchanging intonation"@en ;
	dc:source	pwn30:07084560-n .

<i73879>	a	<Concept> ;
	skos:definition	"a single tone repeated with different words or different rhythms (especially in rendering liturgical texts)"@en ;
	dc:source	pwn30:07084747-n .

<i73880>	a	<Concept> ;
	skos:definition	"a regular and monotonous rising and falling intonation"@en ;
	dc:source	pwn30:07084927-n .

<i73881>	a	<Concept> ;
	skos:definition	"a break or pause (usually for sense) in the middle of a verse line"@en ;
	dc:source	pwn30:07085072-n .

<i73882>	a	<Concept> ;
	skos:definition	"the continuation of a syntactic unit from one line of verse into the next line without a pause"@en ;
	dc:source	pwn30:07085210-n .

<i73883>	a	<Concept> ;
	skos:definition	"the relative prominence of a syllable or musical note (especially with regard to stress or pitch)"@en ;
	dc:source	pwn30:07085375-n .

<i73884>	a	<Concept> ;
	skos:definition	"the use or application of an accent; the relative prominence of syllables in a phrase or utterance"@en ;
	dc:source	pwn30:07085786-n .

<i73885>	a	<Concept> ;
	skos:definition	"emphasis that results from pitch rather than loudness"@en ;
	dc:source	pwn30:07085961-n .

<i73886>	a	<Concept> ;
	skos:definition	"the distribution of stresses within a polysyllabic word"@en ;
	dc:source	pwn30:07086088-n .

<i73887>	a	<Concept> ;
	skos:definition	"the distribution of stresses within a sentence"@en ;
	dc:source	pwn30:07086215-n .

<i73888>	a	<Concept> ;
	skos:definition	"the arrangement of spoken words alternating stressed and unstressed elements"@en ;
	dc:source	pwn30:07086323-n .

<i73889>	a	<Concept> ;
	skos:definition	"the basic rhythmic unit in a piece of music"@en ;
	dc:source	pwn30:07086518-n .

<i73890>	a	<Concept> ;
	skos:definition	"a loud steady beat"@en ;
	dc:source	pwn30:07086861-n .

<i73891>	a	<Concept> ;
	skos:definition	"the first beat of a musical measure (as the conductor's arm moves downward)"@en ;
	dc:source	pwn30:07086972-n .

<i73892>	a	<Concept> ;
	skos:definition	"an unaccented beat (especially the last beat of a measure)"@en ;
	dc:source	pwn30:07087102-n .

<i73893>	a	<Concept> ;
	skos:definition	"a musical rhythm accenting a normally weak beat"@en ;
	dc:source	pwn30:07087223-n .

<i73894>	a	<Concept> ;
	skos:definition	"a vocal passage of narrative text that a singer delivers with natural rhythms of speech"@en ;
	dc:source	pwn30:07087346-n .

<i73895>	a	<Concept> ;
	skos:definition	"(music) a short recitative that is melodic but is not an aria"@en ;
	dc:source	pwn30:07087508-n .

<i73896>	a	<Concept> ;
	skos:definition	"a musical passage moving from one key to another"@en ;
	dc:source	pwn30:07087641-n .

<i73897>	a	<Concept> ;
	skos:definition	"pompous or pretentious talk or writing"@en ;
	dc:source	pwn30:07087777-n .

<i73898>	a	<Concept> ;
	skos:definition	"using long words"@en ;
	dc:source	pwn30:07087940-n .

<i73899>	a	<Concept> ;
	skos:definition	"the journalistic use of subject matter that appeals to vulgar tastes"@en ;
	dc:source	pwn30:07088053-n .

<i73900>	a	<Concept> ;
	skos:definition	"technical jargon from computing and other high-tech subjects"@en ;
	dc:source	pwn30:07088319-n .

<i73901>	a	<Concept> ;
	skos:definition	"a neatly short and concise expressive style"@en ;
	dc:source	pwn30:07088438-n .

<i73902>	a	<Concept> ;
	skos:definition	"a distinctive spoken or written expression"@en ;
	dc:source	pwn30:07088645-n .

<i73903>	a	<Concept> ;
	skos:definition	"a witty or ingenious turn of phrase"@en ;
	dc:source	pwn30:07088868-n .

<i73904>	a	<Concept> ;
	skos:definition	"terseness and economy in writing and speaking achieved by expressing a great deal in just a few words"@en ;
	dc:source	pwn30:07089024-n .

<i73905>	a	<Concept> ;
	skos:definition	"an expressive style that is direct and to the point"@en ;
	dc:source	pwn30:07089276-n .

<i73906>	a	<Concept> ;
	skos:definition	"the use of brief expressions"@en ;
	dc:source	pwn30:07089431-n .

<i73907>	a	<Concept> ;
	skos:definition	"terseness of expression"@en ;
	dc:source	pwn30:07089531-n .

<i73908>	a	<Concept> ;
	skos:definition	"a distinctive style or manner"@en ;
	dc:source	pwn30:07089622-n .

<i73909>	a	<Concept> ;
	skos:definition	"an expressive style that uses excessive or empty words"@en ;
	dc:source	pwn30:07089751-n .

<i73910>	a	<Concept> ;
	skos:definition	"overabundance of words"@en ;
	dc:source	pwn30:07090019-n .

<i73911>	a	<Concept> ;
	skos:definition	"boring verbosity"@en ;
	dc:source	pwn30:07090108-n .

<i73912>	a	<Concept> ;
	skos:definition	"a style that involves indirect ways of expressing things"@en ;
	dc:source	pwn30:07090379-n .

<i73913>	a	<Concept> ;
	skos:definition	"pompously embellished language"@en ;
	dc:source	pwn30:07090573-n .

<i73914>	a	<Concept> ;
	skos:definition	"verboseness resulting from excessive repetitions"@en ;
	dc:source	pwn30:07090721-n .

<i73915>	a	<Concept> ;
	skos:definition	"repetition of messages to reduce the probability of errors in transmission"@en ;
	dc:source	pwn30:07090938-n .

<i73916>	a	<Concept> ;
	skos:definition	"using more words than necessary"@en ;
	dc:source	pwn30:07091087-n .

<i73917>	a	<Concept> ;
	skos:definition	"useless repetition"@en ;
	dc:source	pwn30:07091214-n .

<i73918>	a	<Concept> ;
	skos:definition	"(logic) a statement that is necessarily true"@en ;
	dc:source	pwn30:07091385-n .

<i73919>	a	<Concept> ;
	skos:definition	"a shortened form of a word or phrase"@en ;
	dc:source	pwn30:07091587-n .

<i73920>	a	<Concept> ;
	skos:definition	"abbreviation of a word by omitting the final sound or sounds"@en ;
	dc:source	pwn30:07091737-n .

<i73921>	a	<Concept> ;
	skos:definition	"a word formed from the initial letters of the several words in the name"@en ;
	dc:source	pwn30:07091902-n .

<i73922>	a	<Concept> ;
	skos:definition	"a style of expressing yourself in writing"@en ;
	dc:source	pwn30:07092158-n .

<i73923>	a	<Concept> ;
	skos:definition	"an arrangement of the elements in a composition or discourse"@en ;
	dc:source	pwn30:07092356-n .

<i73924>	a	<Concept> ;
	skos:definition	"literature in metrical form"@en ;
	dc:source	pwn30:07092592-n .

<i73925>	a	<Concept> ;
	skos:definition	"poetry celebrating the deeds of some hero"@en ;
	dc:source	pwn30:07093158-n .

<i73926>	a	<Concept> ;
	skos:definition	"any communication resembling poetry in beauty or the evocation of feeling"@en ;
	dc:source	pwn30:07093273-n .

<i73927>	a	<Concept> ;
	skos:definition	"the art or practice of writing verse"@en ;
	dc:source	pwn30:07093489-n .

<i73928>	a	<Concept> ;
	skos:definition	"the form or metrical composition of a poem"@en ;
	dc:source	pwn30:07093603-n .

<i73929>	a	<Concept> ;
	skos:definition	"a metrical adaptation of something (e.g., of a prose text)"@en ;
	dc:source	pwn30:07093759-n .

<i73930>	a	<Concept> ;
	skos:definition	"(prosody) a system of versification"@en ;
	dc:source	pwn30:07093895-n .

<i73931>	a	<Concept> ;
	skos:definition	"(prosody) the accent in a metrical foot of verse"@en ;
	dc:source	pwn30:07094093-n .

<i73932>	a	<Concept> ;
	skos:definition	"the absence of a syllable in the last foot of a line or verse"@en ;
	dc:source	pwn30:07094355-n .

<i73933>	a	<Concept> ;
	skos:definition	"analysis of verse into metrical patterns"@en ;
	dc:source	pwn30:07094508-n .

<i73934>	a	<Concept> ;
	skos:definition	"a poetic rhythm that imitates the rhythm of speech"@en ;
	dc:source	pwn30:07094621-n .

<i73935>	a	<Concept> ;
	skos:definition	"the usual (iambic) meter of a ballad"@en ;
	dc:source	pwn30:07094731-n .

<i73936>	a	<Concept> ;
	skos:definition	"(prosody) a group of 2 or 3 syllables forming the basic unit of poetic rhythm"@en ;
	dc:source	pwn30:07094843-n .

<i73937>	a	<Concept> ;
	skos:definition	"a metrical unit with stressed-unstressed-unstressed syllables"@en ;
	dc:source	pwn30:07095148-n .

<i73938>	a	<Concept> ;
	skos:definition	"a metrical unit with unstressed-stressed syllables"@en ;
	dc:source	pwn30:07095280-n .

<i73939>	a	<Concept> ;
	skos:definition	"a metrical unit with unstressed-unstressed-stressed syllables"@en ;
	dc:source	pwn30:07095390-n .

<i73940>	a	<Concept> ;
	skos:definition	"a metrical unit with unstressed-stressed-unstressed syllables (e.g., `remember')"@en ;
	dc:source	pwn30:07095516-n .

<i73941>	a	<Concept> ;
	skos:definition	"a metrical unit with stressed-unstressed syllables"@en ;
	dc:source	pwn30:07095653-n .

<i73942>	a	<Concept> ;
	skos:definition	"a metrical unit with stressed-stressed syllables"@en ;
	dc:source	pwn30:07095775-n .

<i73943>	a	<Concept> ;
	skos:definition	"a metrical unit with unstressed-unstressed syllables"@en ;
	dc:source	pwn30:07095895-n .

<i73944>	a	<Concept> ;
	skos:definition	"a verse line having four metrical feet"@en ;
	dc:source	pwn30:07096029-n .

<i73945>	a	<Concept> ;
	skos:definition	"a verse line having five metrical feet"@en ;
	dc:source	pwn30:07096142-n .

<i73946>	a	<Concept> ;
	skos:definition	"a verse line having six metrical feet"@en ;
	dc:source	pwn30:07096237-n .

<i73947>	a	<Concept> ;
	skos:definition	"a verse line having eight metrical feet"@en ;
	dc:source	pwn30:07096330-n .

<i73948>	a	<Concept> ;
	skos:definition	"a verse line having eight syllables or a poem of octosyllabic lines"@en ;
	dc:source	pwn30:07096425-n .

<i73949>	a	<Concept> ;
	skos:definition	"a verse line having ten syllables"@en ;
	dc:source	pwn30:07096569-n .

<i73950>	a	<Concept> ;
	skos:definition	"correspondence in the sounds of two or more lines (especially final sounds)"@en ;
	dc:source	pwn30:07096661-n .

<i73951>	a	<Concept> ;
	skos:definition	"a rhyme between words in the same line"@en ;
	dc:source	pwn30:07096995-n .

<i73952>	a	<Concept> ;
	skos:definition	"use of the same consonant at the beginning of each stressed syllable in a line of verse"@en ;
	dc:source	pwn30:07097094-n .

<i73953>	a	<Concept> ;
	skos:definition	"the repetition of similar vowels in the stressed syllables of successive words"@en ;
	dc:source	pwn30:07097346-n .

<i73954>	a	<Concept> ;
	skos:definition	"the repetition of consonants (or consonant patterns) especially at the ends of words"@en ;
	dc:source	pwn30:07097548-n .

<i73955>	a	<Concept> ;
	skos:definition	"a two-syllable rhyme"@en ;
	dc:source	pwn30:07097707-n .

<i73956>	a	<Concept> ;
	skos:definition	"a stanza form having seven lines of iambic pentameter; introduced by Chaucer"@en ;
	dc:source	pwn30:07097831-n .

<i73957>	a	<Concept> ;
	skos:definition	"a stanza of eight lines of heroic verse with the rhyme scheme abababcc"@en ;
	dc:source	pwn30:07097965-n .

<i73958>	a	<Concept> ;
	skos:definition	"an imperfect rhyme (e.g., `love' and `move')"@en ;
	dc:source	pwn30:07098093-n .

<i73959>	a	<Concept> ;
	skos:definition	"a use of language that creates a literary effect (but often without regard for literal significance)"@en ;
	dc:source	pwn30:07098193-n .

<i73960>	a	<Concept> ;
	skos:definition	"an abrupt change within a sentence from one syntactic structure to another"@en ;
	dc:source	pwn30:07098989-n .

<i73961>	a	<Concept> ;
	skos:definition	"the omission of conjunctions where they would normally be used"@en ;
	dc:source	pwn30:07099135-n .

<i73962>	a	<Concept> ;
	skos:definition	"the repeated use of the same word or word pattern as a rhetorical device"@en ;
	dc:source	pwn30:07099271-n .

<i73963>	a	<Concept> ;
	skos:definition	"repetition of the final words of a sentence or line at the beginning of the next"@en ;
	dc:source	pwn30:07099598-n .

<i73964>	a	<Concept> ;
	skos:definition	"repetition after intervening words"@en ;
	dc:source	pwn30:07099752-n .

<i73965>	a	<Concept> ;
	skos:definition	"repetition of a group of words in reverse order"@en ;
	dc:source	pwn30:07099844-n .

<i73966>	a	<Concept> ;
	skos:definition	"recapitulation of the main ideas of a speech (especially in reverse order)"@en ;
	dc:source	pwn30:07099965-n .

<i73967>	a	<Concept> ;
	skos:definition	"repetition of the ends of two or more successive sentences, verses, etc."@en ;
	dc:source	pwn30:07100113-n .

<i73968>	a	<Concept> ;
	skos:definition	"the doubling of a word or phrase (as for rhetorical effect)"@en ;
	dc:source	pwn30:07100253-n .

<i73969>	a	<Concept> ;
	skos:definition	"(rhetoric) repetition to gain special emphasis or extend meaning"@en ;
	dc:source	pwn30:07100387-n .

<i73970>	a	<Concept> ;
	skos:definition	"repetition of a word in a different case or inflection in the same sentence"@en ;
	dc:source	pwn30:07100522-n .

<i73971>	a	<Concept> ;
	skos:definition	"repetition of a word or phrase at the beginning of successive clauses"@en ;
	dc:source	pwn30:07100678-n .

<i73972>	a	<Concept> ;
	skos:definition	"using a pronoun or similar word instead of repeating a word used earlier"@en ;
	dc:source	pwn30:07100815-n .

<i73973>	a	<Concept> ;
	skos:definition	"repetition of a word or phrase at the beginning and another at the end of successive clauses, i.e., simultaneous use of anaphora and epistrophe"@en ;
	dc:source	pwn30:07100942-n .

<i73974>	a	<Concept> ;
	skos:definition	"the reversal of the normal order of words"@en ;
	dc:source	pwn30:07101140-n .

<i73975>	a	<Concept> ;
	skos:definition	"the use of a word in a sense opposite to its normal sense (especially in irony)"@en ;
	dc:source	pwn30:07101250-n .

<i73976>	a	<Concept> ;
	skos:definition	"the juxtaposition of contrasting words or ideas to give a feeling of balance"@en ;
	dc:source	pwn30:07101406-n .

<i73977>	a	<Concept> ;
	skos:definition	"substitution of a title for a name"@en ;
	dc:source	pwn30:07101557-n .

<i73978>	a	<Concept> ;
	skos:definition	"mentioning something by saying it will not be mentioned"@en ;
	dc:source	pwn30:07101649-n .

<i73979>	a	<Concept> ;
	skos:definition	"breaking off in the middle of a sentence (as by writers of realistic conversations)"@en ;
	dc:source	pwn30:07101778-n .

<i73980>	a	<Concept> ;
	skos:definition	"address to an absent or imaginary person"@en ;
	dc:source	pwn30:07101937-n .

<i73981>	a	<Concept> ;
	skos:definition	"strained or paradoxical use of words either in error (as `blatant' to mean `flagrant') or deliberately (as in a mixed metaphor: `blind mouths')"@en ;
	dc:source	pwn30:07102034-n .

<i73982>	a	<Concept> ;
	skos:definition	"inversion in the second of two parallel phrases"@en ;
	dc:source	pwn30:07102271-n .

<i73983>	a	<Concept> ;
	skos:definition	"arrangement of clauses in ascending order of forcefulness"@en ;
	dc:source	pwn30:07102373-n .

<i73984>	a	<Concept> ;
	skos:definition	"interchange of subject and predicate of a proposition"@en ;
	dc:source	pwn30:07102483-n .

<i73985>	a	<Concept> ;
	skos:definition	"(theater) irony that occurs when the meaning of the situation is understood by the audience but not by the characters in the play"@en ;
	dc:source	pwn30:07102593-n .

<i73986>	a	<Concept> ;
	skos:definition	"an exclamatory rhetorical device"@en ;
	dc:source	pwn30:07102802-n .

<i73987>	a	<Concept> ;
	skos:definition	"special and significant stress by means of position or repetition e.g."@en ;
	dc:source	pwn30:07102945-n .

<i73988>	a	<Concept> ;
	skos:definition	"a substitution of part of speech or gender or number or tense etc. (e.g., editorial `we' for `I')"@en ;
	dc:source	pwn30:07103106-n .

<i73989>	a	<Concept> ;
	skos:definition	"immediate rephrasing for intensification or justification"@en ;
	dc:source	pwn30:07103258-n .

<i73990>	a	<Concept> ;
	skos:definition	"a rhetorical device in which the speaker reproaches the audience in order to incite or convince them"@en ;
	dc:source	pwn30:07103402-n .

<i73991>	a	<Concept> ;
	skos:definition	"use of two conjoined nouns instead of a noun and modifier"@en ;
	dc:source	pwn30:07103558-n .

<i73992>	a	<Concept> ;
	skos:definition	"reversal of the syntactic relation of two words (as in `her beauty's face')"@en ;
	dc:source	pwn30:07103671-n .

<i73993>	a	<Concept> ;
	skos:definition	"reversal of normal word order (as in `cheese I love')"@en ;
	dc:source	pwn30:07103802-n .

<i73994>	a	<Concept> ;
	skos:definition	"use of a series of subjects with a single predicate"@en ;
	dc:source	pwn30:07103912-n .

<i73995>	a	<Concept> ;
	skos:definition	"use of a series of parallel clauses (as in `I came, I saw, I conquered')"@en ;
	dc:source	pwn30:07104020-n .

<i73996>	a	<Concept> ;
	skos:definition	"reversal of normal order of two words or sentences etc. (as in `bred and born')"@en ;
	dc:source	pwn30:07104149-n .

<i73997>	a	<Concept> ;
	skos:definition	"understatement for rhetorical effect (especially when expressing an affirmative by negating its contrary)"@en ;
	dc:source	pwn30:07104292-n .

<i73998>	a	<Concept> ;
	skos:definition	"using words that imitate the sound they denote"@en ;
	dc:source	pwn30:07104574-n .

<i73999>	a	<Concept> ;
	skos:definition	"suggesting by deliberately concise treatment that much of significance is omitted"@en ;
	dc:source	pwn30:07104733-n .

<i74000>	a	<Concept> ;
	skos:definition	"juxtaposing words having a common derivation (as in `sense and sensibility')"@en ;
	dc:source	pwn30:07104912-n .

<i74001>	a	<Concept> ;
	skos:definition	"using several conjunctions in close succession, especially where some might be omitted (as in `he ran and jumped and laughed for joy')"@en ;
	dc:source	pwn30:07105045-n .

<i74002>	a	<Concept> ;
	skos:definition	"anticipating and answering objections in advance"@en ;
	dc:source	pwn30:07105238-n .

<i74003>	a	<Concept> ;
	skos:definition	"a comparison comprising a well-known quotation followed by a facetious sequel"@en ;
	dc:source	pwn30:07105342-n .

<i74004>	a	<Concept> ;
	skos:definition	"language used in a figurative or nonliteral sense"@en ;
	dc:source	pwn30:07105475-n .

<i74005>	a	<Concept> ;
	skos:definition	"an elaborate poetic image or a far-fetched comparison of very dissimilar things"@en ;
	dc:source	pwn30:07106113-n .

<i74006>	a	<Concept> ;
	skos:definition	"a trope that involves incongruity between what is expected and what occurs"@en ;
	dc:source	pwn30:07106246-n .

<i74007>	a	<Concept> ;
	skos:definition	"extravagant exaggeration"@en ;
	dc:source	pwn30:07106502-n .

<i74008>	a	<Concept> ;
	skos:definition	"conventional metaphoric name for something, used especially in Old English and Old Norse poetry"@en ;
	dc:source	pwn30:07106651-n .

<i74009>	a	<Concept> ;
	skos:definition	"a figure of speech in which an expression is used to refer to something that it does not literally denote in order to suggest a similarity"@en ;
	dc:source	pwn30:07106800-n .

<i74010>	a	<Concept> ;
	skos:definition	"a metaphor that has occurred so often that it has become a new meaning of the expression (e.g., `he is a snake' may once have been a metaphor but after years of use it has died and become a new sense of the word `snake')"@en ;
	dc:source	pwn30:07107083-n .

<i74011>	a	<Concept> ;
	skos:definition	"a combination of two or more metaphors that together produce a ridiculous effect"@en ;
	dc:source	pwn30:07107381-n .

<i74012>	a	<Concept> ;
	skos:definition	"a metaphor that exploits a similarity between experiences in different sense modalities"@en ;
	dc:source	pwn30:07107522-n .

<i74013>	a	<Concept> ;
	skos:definition	"substituting the name of an attribute or feature for the name of the thing itself (as in `they counted heads')"@en ;
	dc:source	pwn30:07107676-n .

<i74014>	a	<Concept> ;
	skos:definition	"substituting metonymy of one figurative sense for another"@en ;
	dc:source	pwn30:07107896-n .

<i74015>	a	<Concept> ;
	skos:definition	"conjoining contradictory terms (as in `deafening silence')"@en ;
	dc:source	pwn30:07108010-n .

<i74016>	a	<Concept> ;
	skos:definition	"representing an abstract quality or idea as a person or creature"@en ;
	dc:source	pwn30:07108123-n .

<i74017>	a	<Concept> ;
	skos:definition	"a figure of speech that expresses a resemblance between things of different kinds (usually formed with `like' or `as')"@en ;
	dc:source	pwn30:07108282-n .

<i74018>	a	<Concept> ;
	skos:definition	"substituting a more inclusive term for a less inclusive one or vice versa"@en ;
	dc:source	pwn30:07108453-n .

<i74019>	a	<Concept> ;
	skos:definition	"use of a word to govern two or more words though agreeing in number or case etc. with only one"@en ;
	dc:source	pwn30:07108657-n .

<i74020>	a	<Concept> ;
	skos:definition	"use of a word to govern two or more words though appropriate to only one"@en ;
	dc:source	pwn30:07108807-n .

<i74021>	a	<Concept> ;
	skos:definition	"communication that relies on hearing"@en ;
	dc:source	pwn30:07109019-n .

<i74022>	a	<Concept> ;
	skos:definition	"(language) communication by word of mouth"@en ;
	dc:source	pwn30:07109196-n .

<i74023>	a	<Concept> ;
	skos:definition	"the words that are spoken"@en ;
	dc:source	pwn30:07109730-n .

<i74024>	a	<Concept> ;
	skos:definition	"the use of uttered sounds for auditory communication"@en ;
	dc:source	pwn30:07109847-n .

<i74025>	a	<Concept> ;
	skos:definition	"the exchange of spoken words"@en ;
	dc:source	pwn30:07110457-n .

<i74026>	a	<Concept> ;
	skos:definition	"the sound made by the vibration of vocal folds modified by the resonance of the vocal tract"@en ;
	dc:source	pwn30:07110615-n .

<i74027>	a	<Concept> ;
	skos:definition	"(phonetics) an individual sound unit of speech without concern as to whether or not it is a phoneme of some language"@en ;
	dc:source	pwn30:07111047-n .

<i74028>	a	<Concept> ;
	skos:definition	"(linguistics) the phonemes (or strings of phonemes) that constitute the various allomorphs of a morpheme"@en ;
	dc:source	pwn30:07111510-n .

<i74029>	a	<Concept> ;
	skos:definition	"(linguistics) one of a small set of speech sounds that are distinguished by the speakers of a particular language"@en ;
	dc:source	pwn30:07111711-n .

<i74030>	a	<Concept> ;
	skos:definition	"(linguistics) any of various acoustically different forms of the same phoneme"@en ;
	dc:source	pwn30:07111933-n .

<i74031>	a	<Concept> ;
	skos:definition	"a vowel whose quality or length is changed to indicate linguistic distinctions (such as sing sang sung song)"@en ;
	dc:source	pwn30:07112103-n .

<i74032>	a	<Concept> ;
	skos:definition	"a degree of ablaut"@en ;
	dc:source	pwn30:07112282-n .

<i74033>	a	<Concept> ;
	skos:definition	"a vowel sound that starts near the articulatory position for one vowel and moves toward the position for another"@en ;
	dc:source	pwn30:07112364-n .

<i74034>	a	<Concept> ;
	skos:definition	"a speech sound made with the vocal tract open"@en ;
	dc:source	pwn30:07112550-n .

<i74035>	a	<Concept> ;
	skos:definition	"the system of accentuation used in a particular language"@en ;
	dc:source	pwn30:07112805-n .

<i74036>	a	<Concept> ;
	skos:definition	"the system of consonants used in a particular language"@en ;
	dc:source	pwn30:07112942-n .

<i74037>	a	<Concept> ;
	skos:definition	"the morphophonemics of a particular language"@en ;
	dc:source	pwn30:07113080-n .

<i74038>	a	<Concept> ;
	skos:definition	"the system of phonemes recognized in a language"@en ;
	dc:source	pwn30:07113192-n .

<i74039>	a	<Concept> ;
	skos:definition	"the system of phones used in a particular language"@en ;
	dc:source	pwn30:07113337-n .

<i74040>	a	<Concept> ;
	skos:definition	"the pattern of syllable formation in a particular language"@en ;
	dc:source	pwn30:07113491-n .

<i74041>	a	<Concept> ;
	skos:definition	"a system of tenses used in a particular language"@en ;
	dc:source	pwn30:07113625-n .

<i74042>	a	<Concept> ;
	skos:definition	"the system of tones used in a particular language or dialect of a tone language"@en ;
	dc:source	pwn30:07113732-n .

<i74043>	a	<Concept> ;
	skos:definition	"the system of vowels used in a particular language"@en ;
	dc:source	pwn30:07113903-n .

<i74044>	a	<Concept> ;
	skos:definition	"a neutral middle vowel; occurs in unstressed syllables"@en ;
	dc:source	pwn30:07114023-n .

<i74045>	a	<Concept> ;
	skos:definition	"a schwa that is incidental to the pronunciation of a consonant"@en ;
	dc:source	pwn30:07114154-n .

<i74046>	a	<Concept> ;
	skos:definition	"a vowel that ends a stem and precedes an inflection"@en ;
	dc:source	pwn30:07114284-n .

<i74047>	a	<Concept> ;
	skos:definition	"a vowellike sound that serves as a consonant"@en ;
	dc:source	pwn30:07114409-n .

<i74048>	a	<Concept> ;
	skos:definition	"a semivowel produced with the tongue near the palate (like the initial sound in the English word `yeast')"@en ;
	dc:source	pwn30:07114535-n .

<i74049>	a	<Concept> ;
	skos:definition	"a letter of the alphabet standing for a spoken vowel"@en ;
	dc:source	pwn30:07114712-n .

<i74050>	a	<Concept> ;
	skos:definition	"a mark placed below or near a consonant (as in Hebrew or Arabic) to indicate the spoken vowel"@en ;
	dc:source	pwn30:07114870-n .

<i74051>	a	<Concept> ;
	skos:definition	"a speech sound that is not a vowel"@en ;
	dc:source	pwn30:07115021-n .

<i74052>	a	<Concept> ;
	skos:definition	"a letter of the alphabet standing for a spoken consonant"@en ;
	dc:source	pwn30:07115381-n .

<i74053>	a	<Concept> ;
	skos:definition	"a consonant articulated with the tip of the tongue near the gum ridge"@en ;
	dc:source	pwn30:07115493-n .

<i74054>	a	<Concept> ;
	skos:definition	"a consonant that is produced with a partial or complete blockage of the airflow from the lungs through the nose or mouth"@en ;
	dc:source	pwn30:07115684-n .

<i74055>	a	<Concept> ;
	skos:definition	"a consonant produced by stopping the flow of air at some point and suddenly releasing it"@en ;
	dc:source	pwn30:07115914-n .

<i74056>	a	<Concept> ;
	skos:definition	"the initial occluded phase of a stop consonant"@en ;
	dc:source	pwn30:07116304-n .

<i74057>	a	<Concept> ;
	skos:definition	"the terminal forced release of pressure built up during the occlusive phase of a stop consonant"@en ;
	dc:source	pwn30:07116443-n .

<i74058>	a	<Concept> ;
	skos:definition	"the conversion of a simple stop consonant into an affricate"@en ;
	dc:source	pwn30:07116641-n .

<i74059>	a	<Concept> ;
	skos:definition	"a consonant pronounced with aspiration"@en ;
	dc:source	pwn30:07116758-n .

<i74060>	a	<Concept> ;
	skos:definition	"a manner of articulation involving an audible release of breath"@en ;
	dc:source	pwn30:07116869-n .

<i74061>	a	<Concept> ;
	skos:definition	"a consonant whose articulation involves movement of the lips"@en ;
	dc:source	pwn30:07117007-n .

<i74062>	a	<Concept> ;
	skos:definition	"a consonant whose articulation involves the lips and teeth"@en ;
	dc:source	pwn30:07117193-n .

<i74063>	a	<Concept> ;
	skos:definition	"a consonant that is articulated using both lips; /p/ or /b/ or /w/"@en ;
	dc:source	pwn30:07117333-n .

<i74064>	a	<Concept> ;
	skos:definition	"a stop consonant that is produced with the lips"@en ;
	dc:source	pwn30:07117472-n .

<i74065>	a	<Concept> ;
	skos:definition	"a stop consonant articulated by releasing pressure at the glottis; as in the sudden onset of a vowel"@en ;
	dc:source	pwn30:07117595-n .

<i74066>	a	<Concept> ;
	skos:definition	"the insertion of a vowel or consonant into a word to make its pronunciation easier"@en ;
	dc:source	pwn30:07117788-n .

<i74067>	a	<Concept> ;
	skos:definition	"the act of nasalizing; the utterance of sounds modulated by the nasal resonators"@en ;
	dc:source	pwn30:07118002-n .

<i74068>	a	<Concept> ;
	skos:definition	"a stop consonant made by the suction of air into the mouth (as in Bantu)"@en ;
	dc:source	pwn30:07118210-n .

<i74069>	a	<Concept> ;
	skos:definition	"consonant articulated by constricting (but not closing) the vocal tract"@en ;
	dc:source	pwn30:07118367-n .

<i74070>	a	<Concept> ;
	skos:definition	"a continuant consonant produced by breath moving against a narrowing of the vocal tract"@en ;
	dc:source	pwn30:07118554-n .

<i74071>	a	<Concept> ;
	skos:definition	"a consonant characterized by a hissing sound (like s or sh)"@en ;
	dc:source	pwn30:07118747-n .

<i74072>	a	<Concept> ;
	skos:definition	"a composite speech sound consisting of a stop and a fricative articulated at the same point (as `ch' in `chair' and `j' in `joy')"@en ;
	dc:source	pwn30:07118990-n .

<i74073>	a	<Concept> ;
	skos:definition	"a consonant produced through the nose with the mouth closed"@en ;
	dc:source	pwn30:07119211-n .

<i74074>	a	<Concept> ;
	skos:definition	"a speech sound produced with both the oral and nasal passages open (as French nasal vowels)"@en ;
	dc:source	pwn30:07119358-n .

<i74075>	a	<Concept> ;
	skos:definition	"a consonant that is produced with the tongue and other speech organs"@en ;
	dc:source	pwn30:07119521-n .

<i74076>	a	<Concept> ;
	skos:definition	"a frictionless continuant that is not a nasal consonant (especially `l' and `r')"@en ;
	dc:source	pwn30:07119643-n .

<i74077>	a	<Concept> ;
	skos:definition	"a doubled or long consonant"@en ;
	dc:source	pwn30:07119776-n .

<i74078>	a	<Concept> ;
	skos:definition	"a consonant produced without sound from the vocal cords"@en ;
	dc:source	pwn30:07119897-n .

<i74079>	a	<Concept> ;
	skos:definition	"a consonant produced with the back of the tongue touching or near the soft palate"@en ;
	dc:source	pwn30:07120025-n .

<i74080>	a	<Concept> ;
	skos:definition	"a consonant articulated in the back of the mouth or throat"@en ;
	dc:source	pwn30:07120176-n .

<i74081>	a	<Concept> ;
	skos:definition	"a speech sound accompanied by sound from the vocal cords"@en ;
	dc:source	pwn30:07120364-n .

<i74082>	a	<Concept> ;
	skos:definition	"a loud utterance; often in protest or opposition"@en ;
	dc:source	pwn30:07120524-n .

<i74083>	a	<Concept> ;
	skos:definition	"a loud utterance of emotion (especially when inarticulate)"@en ;
	dc:source	pwn30:07121157-n .

<i74084>	a	<Concept> ;
	skos:definition	"a very loud utterance (like the sound of an animal)"@en ;
	dc:source	pwn30:07121361-n .

<i74085>	a	<Concept> ;
	skos:definition	"an extravagantly loud outcry"@en ;
	dc:source	pwn30:07121904-n .

<i74086>	a	<Concept> ;
	skos:definition	"a cry expressing disapproval"@en ;
	dc:source	pwn30:07122018-n .

<i74087>	a	<Concept> ;
	skos:definition	"loud and persistent outcry from many people"@en ;
	dc:source	pwn30:07122118-n .

<i74088>	a	<Concept> ;
	skos:definition	"a shout to attract attention"@en ;
	dc:source	pwn30:07122409-n .

<i74089>	a	<Concept> ;
	skos:definition	"a loud raucous cry (as of an owl)"@en ;
	dc:source	pwn30:07122555-n .

<i74090>	a	<Concept> ;
	skos:definition	"a cry of praise or adoration (to God)"@en ;
	dc:source	pwn30:07122639-n .

<i74091>	a	<Concept> ;
	skos:definition	"a loud outcry of protest or complaint"@en ;
	dc:source	pwn30:07122730-n .

<i74092>	a	<Concept> ;
	skos:definition	"sharp piercing cry"@en ;
	dc:source	pwn30:07123012-n .

<i74093>	a	<Concept> ;
	skos:definition	"a loud hooting cry of exultation or excitement"@en ;
	dc:source	pwn30:07123288-n .

<i74094>	a	<Concept> ;
	skos:definition	"a yell intended to rally a group of soldiers in battle"@en ;
	dc:source	pwn30:07123404-n .

<i74095>	a	<Concept> ;
	skos:definition	"uttering a loud inarticulate cry as of pain or excitement"@en ;
	dc:source	pwn30:07123552-n .

<i74096>	a	<Concept> ;
	skos:definition	"a songlike cry in which the voice fluctuates rapidly between the normal voice and falsetto"@en ;
	dc:source	pwn30:07123710-n .

<i74097>	a	<Concept> ;
	skos:definition	"a cry or noise made to express displeasure or contempt"@en ;
	dc:source	pwn30:07123870-n .

<i74098>	a	<Concept> ;
	skos:definition	"blasphemous language (expressing disrespect for God or for something sacred)"@en ;
	dc:source	pwn30:07124172-n .

<i74099>	a	<Concept> ;
	skos:definition	"an offensive or indecent word or phrase"@en ;
	dc:source	pwn30:07124340-n .

<i74100>	a	<Concept> ;
	skos:definition	"lewd or obscene talk or writing"@en ;
	dc:source	pwn30:07124736-n .

<i74101>	a	<Concept> ;
	skos:definition	"a preoccupation with obscenity (especially that dealing with excrement or excretory functions)"@en ;
	dc:source	pwn30:07124928-n .

<i74102>	a	<Concept> ;
	skos:definition	"profane or obscene expression usually of surprise or anger"@en ;
	dc:source	pwn30:07125096-n .

<i74103>	a	<Concept> ;
	skos:definition	"a harsh hoarse utterance (as of a frog)"@en ;
	dc:source	pwn30:07125367-n .

<i74104>	a	<Concept> ;
	skos:definition	"an abrupt excited utterance"@en ;
	dc:source	pwn30:07125523-n .

<i74105>	a	<Concept> ;
	skos:definition	"a word used in exclamations of confusion"@en ;
	dc:source	pwn30:07125786-n .

<i74106>	a	<Concept> ;
	skos:definition	"an abrupt emphatic exclamation expressing emotion"@en ;
	dc:source	pwn30:07125958-n .

<i74107>	a	<Concept> ;
	skos:definition	"an exclamation of protest or remonstrance or reproof"@en ;
	dc:source	pwn30:07126116-n .

<i74108>	a	<Concept> ;
	skos:definition	"a word or phrase conveying no independent meaning but added to fill out a sentence or metrical line"@en ;
	dc:source	pwn30:07126228-n .

<i74109>	a	<Concept> ;
	skos:definition	"an utterance expressing pain or disapproval"@en ;
	dc:source	pwn30:07126383-n .

<i74110>	a	<Concept> ;
	skos:definition	"the utterance of a sound similar to clearing the throat; intended to get attention, express hesitancy, fill a pause, hide embarrassment, warn a friend, etc."@en ;
	dc:source	pwn30:07126521-n .

<i74111>	a	<Concept> ;
	skos:definition	"a long loud emotional utterance"@en ;
	dc:source	pwn30:07126734-n .

<i74112>	a	<Concept> ;
	skos:definition	"the sound of laughing"@en ;
	dc:source	pwn30:07127006-n .

<i74113>	a	<Concept> ;
	skos:definition	"a soft indistinct utterance"@en ;
	dc:source	pwn30:07127252-n .

<i74114>	a	<Concept> ;
	skos:definition	"loud convulsive laughter"@en ;
	dc:source	pwn30:07127350-n .

<i74115>	a	<Concept> ;
	skos:definition	"a loud laugh suggestive of a hen's cackle"@en ;
	dc:source	pwn30:07127451-n .

<i74116>	a	<Concept> ;
	skos:definition	"a soft partly suppressed laugh"@en ;
	dc:source	pwn30:07127563-n .

<i74117>	a	<Concept> ;
	skos:definition	"a foolish or nervous laugh"@en ;
	dc:source	pwn30:07127693-n .

<i74118>	a	<Concept> ;
	skos:definition	"a burst of deep loud hearty laughter"@en ;
	dc:source	pwn30:07127790-n .

<i74119>	a	<Concept> ;
	skos:definition	"a loud laugh that sounds like a horse neighing"@en ;
	dc:source	pwn30:07127911-n .

<i74120>	a	<Concept> ;
	skos:definition	"a disrespectful laugh"@en ;
	dc:source	pwn30:07128060-n .

<i74121>	a	<Concept> ;
	skos:definition	"a nervous restrained laugh"@en ;
	dc:source	pwn30:07128225-n .

<i74122>	a	<Concept> ;
	skos:definition	"calling out the name of a person (especially by a loudspeaker system)"@en ;
	dc:source	pwn30:07128322-n .

<i74123>	a	<Concept> ;
	skos:definition	"vulgar or irreverent speech or action"@en ;
	dc:source	pwn30:07128527-n .

<i74124>	a	<Concept> ;
	skos:definition	"the way a word or a language is customarily spoken"@en ;
	dc:source	pwn30:07128692-n .

<i74125>	a	<Concept> ;
	skos:definition	"the manner in which someone utters a word"@en ;
	dc:source	pwn30:07128946-n .

<i74126>	a	<Concept> ;
	skos:definition	"pronunciation with a sibilant (hissing or whistling) sound"@en ;
	dc:source	pwn30:07129202-n .

<i74127>	a	<Concept> ;
	skos:definition	"the utterance of sounds expressing great joy"@en ;
	dc:source	pwn30:07129422-n .

<i74128>	a	<Concept> ;
	skos:definition	"an utterance made by exhaling audibly"@en ;
	dc:source	pwn30:07129602-n .

<i74129>	a	<Concept> ;
	skos:definition	"a vicious angry growl"@en ;
	dc:source	pwn30:07129758-n .

<i74130>	a	<Concept> ;
	skos:definition	"the utterance of intelligible speech"@en ;
	dc:source	pwn30:07129867-n .

<i74131>	a	<Concept> ;
	skos:definition	"something spoken"@en ;
	dc:source	pwn30:07130050-n .

<i74132>	a	<Concept> ;
	skos:definition	"an utterance (of words) with spitting sounds (as in rage)"@en ;
	dc:source	pwn30:07130183-n .

<i74133>	a	<Concept> ;
	skos:definition	"speaking softly without vibration of the vocal cords"@en ;
	dc:source	pwn30:07130341-n .

<i74134>	a	<Concept> ;
	skos:definition	"a loud whisper that can be overheard; on the stage it is heard by the audience but it supposed to be inaudible to the rest of the cast"@en ;
	dc:source	pwn30:07130580-n .

<i74135>	a	<Concept> ;
	skos:definition	"uttering in an irritated tone"@en ;
	dc:source	pwn30:07130774-n .

<i74136>	a	<Concept> ;
	skos:definition	"incorrect pronunciation"@en ;
	dc:source	pwn30:07130918-n .

<i74137>	a	<Concept> ;
	skos:definition	"two words are homographs if they are spelled the same way but differ in meaning (e.g. fair)"@en ;
	dc:source	pwn30:07131022-n .

<i74138>	a	<Concept> ;
	skos:definition	"two words are homophones if they are pronounced the same way but differ in meaning or spelling or both (e.g. bare and bear)"@en ;
	dc:source	pwn30:07131169-n .

<i74139>	a	<Concept> ;
	skos:definition	"the same pronunciation for words of different origins"@en ;
	dc:source	pwn30:07131366-n .

<i74140>	a	<Concept> ;
	skos:definition	"distinctive manner of oral expression"@en ;
	dc:source	pwn30:07131511-n .

<i74141>	a	<Concept> ;
	skos:definition	"a slow speech pattern with prolonged vowels"@en ;
	dc:source	pwn30:07131741-n .

<i74142>	a	<Concept> ;
	skos:definition	"the aspect of pronunciation that involves bringing articulatory organs together so as to shape the sounds of speech"@en ;
	dc:source	pwn30:07131854-n .

<i74143>	a	<Concept> ;
	skos:definition	"an articulatory gesture made by turning the tip of the tongue back against the roof of the mouth"@en ;
	dc:source	pwn30:07132226-n .

<i74144>	a	<Concept> ;
	skos:definition	"the articulation of speech regarded from the point of view of its intelligibility to the audience"@en ;
	dc:source	pwn30:07132415-n .

<i74145>	a	<Concept> ;
	skos:definition	"indistinct enunciation"@en ;
	dc:source	pwn30:07132634-n .

<i74146>	a	<Concept> ;
	skos:definition	"(phonology) the loss of sounds from within a word (as in `fo'c'sle' for `forecastle')"@en ;
	dc:source	pwn30:07132729-n .

<i74147>	a	<Concept> ;
	skos:definition	"the articulatory process whereby the pronunciation of a word or morpheme changes when it is followed immediately by another (especially in fluent speech)"@en ;
	dc:source	pwn30:07132937-n .

<i74148>	a	<Concept> ;
	skos:definition	"indistinct articulation"@en ;
	dc:source	pwn30:07133143-n .

