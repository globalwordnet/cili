	dc:source	pwn30:14740915-n .

<i114460>	a	<Concept> ;
	skos:definition	"a fatty acid that has been produced by hydrogenating an unsaturated fatty acid (and so changing its shape); found in processed foods such as margarine and fried foods and puddings and commercially baked goods and partially hydrogenated vegetable oils"@en ;
	dc:source	pwn30:14741124-n .

<i114461>	a	<Concept> ;
	skos:definition	"an unsaturated fatty acid whose carbon chain has one double or triple valence bond per molecule; found chiefly in olive oil and chicken and almonds"@en ;
	dc:source	pwn30:14741474-n .

<i114462>	a	<Concept> ;
	skos:definition	"an unsaturated fatty acid whose carbon chain has more than one double or triple valence bond per molecule; found chiefly in fish and corn and soybean oil and safflower oil"@en ;
	dc:source	pwn30:14741730-n .

<i114463>	a	<Concept> ;
	skos:definition	"a polyunsaturated fatty acid whose carbon chain has its first double valence bond three carbons from the beginning"@en ;
	dc:source	pwn30:14742028-n .

<i114464>	a	<Concept> ;
	skos:definition	"a polyunsaturated fatty acid whose carbon chain has its first double valence bond six carbons from the beginning"@en ;
	dc:source	pwn30:14742271-n .

<i114465>	a	<Concept> ;
	skos:definition	"a colorless crystalline synthetic fatty acid"@en ;
	dc:source	pwn30:14742476-n .

<i114466>	a	<Concept> ;
	skos:definition	"an oily fatty acid found in castor oil and used in soap"@en ;
	dc:source	pwn30:14742601-n .

<i114467>	a	<Concept> ;
	skos:definition	"peptide released from the amino end of fibrinogen by the action of thrombin to form fibrin during clotting of the blood"@en ;
	dc:source	pwn30:14742737-n .

<i114468>	a	<Concept> ;
	skos:definition	"a peptide containing 10 to more than 100 amino acids"@en ;
	dc:source	pwn30:14742917-n .

<i114469>	a	<Concept> ;
	skos:definition	"amide combining the amino group of one amino acid with the carboxyl group of another; usually obtained by partial hydrolysis of protein"@en ;
	dc:source	pwn30:14743046-n .

<i114470>	a	<Concept> ;
	skos:definition	"a derivative of benzoic acid"@en ;
	dc:source	pwn30:14743289-n .

<i114471>	a	<Concept> ;
	skos:definition	"a plastic (synthetic resin) made from amino compounds; used as an adhesive and as a coating for paper and textiles"@en ;
	dc:source	pwn30:14743381-n .

<i114472>	a	<Concept> ;
	skos:definition	"a pungent gas compounded of nitrogen and hydrogen (NH3)"@en ;
	dc:source	pwn30:14743582-n .

<i114473>	a	<Concept> ;
	skos:definition	"a complex inorganic compound that contains ammonia molecules"@en ;
	dc:source	pwn30:14743727-n .

<i114474>	a	<Concept> ;
	skos:definition	"a water solution of ammonia"@en ;
	dc:source	pwn30:14743840-n .

<i114475>	a	<Concept> ;
	skos:definition	"the aromatic gum of the ammoniac plant"@en ;
	dc:source	pwn30:14743976-n .

<i114476>	a	<Concept> ;
	skos:definition	"the ion NH4 derived from ammonia; behaves in many respects like an alkali metal ion"@en ;
	dc:source	pwn30:14744120-n .

<i114477>	a	<Concept> ;
	skos:definition	"a salt of carbamic acid that is used as a nitrogen fertilizer"@en ;
	dc:source	pwn30:14744291-n .

<i114478>	a	<Concept> ;
	skos:definition	"a carbonate of ammonium; used in the manufacture of smelling salts and baking powder and ammonium compounds"@en ;
	dc:source	pwn30:14744417-n .

<i114479>	a	<Concept> ;
	skos:definition	"a white salt used in dry cells"@en ;
	dc:source	pwn30:14744589-n .

<i114480>	a	<Concept> ;
	skos:definition	"a mixture of 2 or more isomeric alcohols; used as a solvent and in organic synthesis"@en ;
	dc:source	pwn30:14744698-n .

<i114481>	a	<Concept> ;
	skos:definition	"(botany) a plant product that acts like a hormone"@en ;
	dc:source	pwn30:14744841-n .

<i114482>	a	<Concept> ;
	skos:definition	"a plant hormone that promotes root formation and bud growth"@en ;
	dc:source	pwn30:14745057-n .

<i114483>	a	<Concept> ;
	skos:definition	"a plant hormone isolated from a fungus; used in promoting plant growth"@en ;
	dc:source	pwn30:14745222-n .

<i114484>	a	<Concept> ;
	skos:definition	"a crystalline acid associated with gibberellin"@en ;
	dc:source	pwn30:14745368-n .

<i114485>	a	<Concept> ;
	skos:definition	"any of a class of plant hormones that promote cell division and delay the senescence of leaves"@en ;
	dc:source	pwn30:14745477-n .

<i114486>	a	<Concept> ;
	skos:definition	"any hormone affecting the development and growth of sex organs"@en ;
	dc:source	pwn30:14745635-n .

<i114487>	a	<Concept> ;
	skos:definition	"secreted by the adrenal cortex; involved in regulating water and electrolyte balance in the body"@en ;
	dc:source	pwn30:14745891-n .

<i114488>	a	<Concept> ;
	skos:definition	"a steroid hormone (trade name Lipo-Lutin) produced in the ovary; prepares and maintains the uterus for pregnancy"@en ;
	dc:source	pwn30:14746048-n .

<i114489>	a	<Concept> ;
	skos:definition	"a synthetic progestational compound used to treat endometrial carcinoma"@en ;
	dc:source	pwn30:14746270-n .

<i114490>	a	<Concept> ;
	skos:definition	"a synthetic progestational hormone (trade name Norlutin) used in oral contraceptives and to treat endometriosis"@en ;
	dc:source	pwn30:14746417-n .

<i114491>	a	<Concept> ;
	skos:definition	"a progesterone derivative used in oral contraceptives and in the control of menstruation and the treatment of abnormal uterine bleeding"@en ;
	dc:source	pwn30:14746793-n .

<i114492>	a	<Concept> ;
	skos:definition	"synthetic progestin used in oral contraceptives"@en ;
	dc:source	pwn30:14747007-n .

<i114493>	a	<Concept> ;
	skos:definition	"a progestin compound (trade name Provera) used to treat menstrual disorders"@en ;
	dc:source	pwn30:14747168-n .

<i114494>	a	<Concept> ;
	skos:definition	"any of a group of steroid hormones that have the effect of progesterone"@en ;
	dc:source	pwn30:14747338-n .

<i114495>	a	<Concept> ;
	skos:definition	"male sex hormone that is produced in the testes and responsible for typical male sexual characteristics"@en ;
	dc:source	pwn30:14747587-n .

<i114496>	a	<Concept> ;
	skos:definition	"a steroid having androgenic activity; obtained from the cortex of the adrenal gland"@en ;
	dc:source	pwn30:14747838-n .

<i114497>	a	<Concept> ;
	skos:definition	"an androgenic hormone that is less active than testosterone"@en ;
	dc:source	pwn30:14747981-n .

<i114498>	a	<Concept> ;
	skos:definition	"an androgenic compound contained in drugs that are used to treat testosterone deficiency and female breast cancer and to stimulate growth and weight gain"@en ;
	dc:source	pwn30:14748117-n .

<i114499>	a	<Concept> ;
	skos:definition	"an androgen (trade names Durabolin or Kabolin) that is used to treat testosterone deficiency or breast cancer or osteoporosis"@en ;
	dc:source	pwn30:14748335-n .

<i114500>	a	<Concept> ;
	skos:definition	"a potent androgenic hormone produced chiefly by the testes; responsible for the development of male secondary sex characteristics"@en ;
	dc:source	pwn30:14748577-n .

<i114501>	a	<Concept> ;
	skos:definition	"a gonadotropic hormone that is secreted by the anterior pituitary and stimulates growth of Graafian follicles in female mammals, and activates the cells in male mammals that form sperm"@en ;
	dc:source	pwn30:14748765-n .

<i114502>	a	<Concept> ;
	skos:definition	"hormone produced early in pregnancy by the placenta; detection in the urine and serum is the basis for one kind of pregnancy test"@en ;
	dc:source	pwn30:14749030-n .

<i114503>	a	<Concept> ;
	skos:definition	"a gonadotropic hormone that is secreted by the anterior pituitary; stimulates ovulation in female mammals and stimulates androgen release in male mammals"@en ;
	dc:source	pwn30:14749272-n .

<i114504>	a	<Concept> ;
	skos:definition	"gonadotropic hormone secreted by the anterior pituitary; in females it stimulates growth of the mammary glands and lactation after parturition"@en ;
	dc:source	pwn30:14749543-n .

<i114505>	a	<Concept> ;
	skos:definition	"a general term for female steroid sex hormones that are secreted by the ovary and responsible for typical female sexual characteristics"@en ;
	dc:source	pwn30:14749794-n .

<i114506>	a	<Concept> ;
	skos:definition	"a potent estrogen used in medicine and in feed for livestock and poultry"@en ;
	dc:source	pwn30:14750122-n .

<i114507>	a	<Concept> ;
	skos:definition	"the most powerful female hormone that occurs naturally; synthesized and used to treat estrogen deficiency and breast cancer"@en ;
	dc:source	pwn30:14750316-n .

<i114508>	a	<Concept> ;
	skos:definition	"a naturally occurring estrogenic hormone; a synthetic form is used to treat estrogen deficiency"@en ;
	dc:source	pwn30:14750622-n .

<i114509>	a	<Concept> ;
	skos:definition	"a naturally occurring weak estrogenic hormone secreted by the mammalian ovary; synthesized (trade name Estronol) and used to treat estrogen deficiency"@en ;
	dc:source	pwn30:14750782-n .

<i114510>	a	<Concept> ;
	skos:definition	"estrogen compound used to treat menstrual irregularities and menopausal symptoms and to prevent pregnancy"@en ;
	dc:source	pwn30:14751055-n .

<i114511>	a	<Concept> ;
	skos:definition	"a synthetic form of estrogen used in combination with a progestin in oral contraceptives"@en ;
	dc:source	pwn30:14751216-n .

<i114512>	a	<Concept> ;
	skos:definition	"a steroid hormone produced by the adrenal cortex or synthesized; administered as drugs they reduce swelling and decrease the body's immune response"@en ;
	dc:source	pwn30:14751417-n .

<i114513>	a	<Concept> ;
	skos:definition	"hormone that is one of the steroids of the adrenal cortex that influences the metabolism of sodium and potassium"@en ;
	dc:source	pwn30:14751863-n .

<i114514>	a	<Concept> ;
	skos:definition	"a steroid hormone that is produced by the adrenal cortex of animals; affects functioning of gonads and has anti-inflammatory activity"@en ;
	dc:source	pwn30:14752057-n .

<i114515>	a	<Concept> ;
	skos:definition	"an amino derivative of glucose that is a component of many polysaccharides"@en ;
	dc:source	pwn30:14752323-n .

<i114516>	a	<Concept> ;
	skos:definition	"a corticosteroid hormone that is secreted by the cortex of the adrenal gland; regulates salt (sodium and potassium) and water balance"@en ;
	dc:source	pwn30:14752511-n .

<i114517>	a	<Concept> ;
	skos:definition	"an adrenal-cortex hormone (trade names Hydrocortone or Cortef) that is active in carbohydrate and protein metabolism"@en ;
	dc:source	pwn30:14752702-n .

<i114518>	a	<Concept> ;
	skos:definition	"a corticosteroid hormone (trade name Cortone Acetate) normally produced by the adrenal cortex; is converted to hydrocortisone"@en ;
	dc:source	pwn30:14752952-n .

<i114519>	a	<Concept> ;
	skos:definition	"a glucocorticoid (trade names Pediapred or Prelone) used to treat inflammatory conditions"@en ;
	dc:source	pwn30:14753188-n .

<i114520>	a	<Concept> ;
	skos:definition	"a dehydrogenated analogue of cortisol (trade names Orasone or Deltasone or Liquid Pred or Meticorten); used as an anti-inflammatory drug in the treatment of arthritis and as an immunosuppressant"@en ;
	dc:source	pwn30:14753414-n .

<i114521>	a	<Concept> ;
	skos:definition	"a corticosteroid drug (trade names Decadron or Dexamethasone Intensol or Dexone or Hexadrol or Oradexon) used to treat allergies or inflammation"@en ;
	dc:source	pwn30:14753808-n .

<i114522>	a	<Concept> ;
	skos:definition	"a synthetic corticosteroid (trade name Aldactone) used to treat hypertension"@en ;
	dc:source	pwn30:14754192-n .

<i114523>	a	<Concept> ;
	skos:definition	"dye in which the chromophore is part of a negative ion"@en ;
	dc:source	pwn30:14754378-n .

<i114524>	a	<Concept> ;
	skos:definition	"oily poisonous liquid amine obtained from nitrobenzene and used to make dyes and plastics and medicines"@en ;
	dc:source	pwn30:14754505-n .

<i114525>	a	<Concept> ;
	skos:definition	"any of various yellow dyes; not related chemically to alizarin but applied in the same manner"@en ;
	dc:source	pwn30:14754705-n .

<i114526>	a	<Concept> ;
	skos:definition	"a blue dye obtained from plants or made synthetically"@en ;
	dc:source	pwn30:14754860-n .

<i114527>	a	<Concept> ;
	skos:definition	"any of many dyes made from aniline"@en ;
	dc:source	pwn30:14754985-n .

<i114528>	a	<Concept> ;
	skos:definition	"any oil obtained from animal substances"@en ;
	dc:source	pwn30:14755077-n .

<i114529>	a	<Concept> ;
	skos:definition	"an oil that hardens in air due to oxidation and is often used as a paint or varnish base"@en ;
	dc:source	pwn30:14755641-n .

<i114530>	a	<Concept> ;
	skos:definition	"material derived from animals"@en ;
	dc:source	pwn30:14755804-n .

<i114531>	a	<Concept> ;
	skos:definition	"pigment occurring in animals"@en ;
	dc:source	pwn30:14756039-n .

<i114532>	a	<Concept> ;
	skos:definition	"a poisonous colorless flammable gas used in organic synthesis and to dope transistors and as a poison gas in warfare"@en ;
	dc:source	pwn30:14756200-n .

<i114533>	a	<Concept> ;
	skos:definition	"an orange-yellow pigment in the bile that forms as a product of hemoglobin; excess amounts in the blood produce the yellow appearance observed in jaundice"@en ;
	dc:source	pwn30:14756369-n .

<i114534>	a	<Concept> ;
	skos:definition	"brown bile pigment formed from urobilinogens and found in feces and in small amounts in urine"@en ;
	dc:source	pwn30:14756606-n .

<i114535>	a	<Concept> ;
	skos:definition	"a chromogen formed in the intestine from the breakdown of bilirubin; yields urobilins on oxidation; some is excreted in the feces and some is resorbed and excreted in bile or urine"@en ;
	dc:source	pwn30:14756754-n .

<i114536>	a	<Concept> ;
	skos:definition	"pigment occurring in luminescent organisms (as fireflies); emits heatless light when undergoing oxidation"@en ;
	dc:source	pwn30:14757011-n .

<i114537>	a	<Concept> ;
	skos:definition	"insoluble pigments that account for the color of e.g. skin and scales and feathers"@en ;
	dc:source	pwn30:14757172-n .

<i114538>	a	<Concept> ;
	skos:definition	"a calcareous material harder and denser than bone that comprises the bulk of a tooth"@en ;
	dc:source	pwn30:14757382-n .

<i114539>	a	<Concept> ;
	skos:definition	"a hard smooth ivory colored dentine that makes up most of the tusks of elephants and walruses"@en ;
	dc:source	pwn30:14757547-n .

<i114540>	a	<Concept> ;
	skos:definition	"any light downy material"@en ;
	dc:source	pwn30:14757754-n .

<i114541>	a	<Concept> ;
	skos:definition	"the porous calcified substance from which bones are made"@en ;
	dc:source	pwn30:14757848-n .

<i114542>	a	<Concept> ;
	skos:definition	"the material (mostly keratin) that covers the horns of ungulates and forms hooves and claws and nails"@en ;
	dc:source	pwn30:14758027-n .

<i114543>	a	<Concept> ;
	skos:definition	"a horny material from the upper jaws of certain whales; used as the ribs of fans or as stays in corsets"@en ;
	dc:source	pwn30:14758252-n .

<i114544>	a	<Concept> ;
	skos:definition	"the mottled horny substance of the shell of some turtles"@en ;
	dc:source	pwn30:14758420-n .

<i114545>	a	<Concept> ;
	skos:definition	"the material that forms the hard outer covering of many animals"@en ;
	dc:source	pwn30:14758536-n .

<i114546>	a	<Concept> ;
	skos:definition	"the iridescent internal layer of a mollusk shell"@en ;
	dc:source	pwn30:14758706-n .

<i114547>	a	<Concept> ;
	skos:definition	"the outer covering of an animal"@en ;
	dc:source	pwn30:14758842-n .

<i114548>	a	<Concept> ;
	skos:definition	"skin of a sheep or goat prepared for writing on"@en ;
	dc:source	pwn30:14759003-n .

<i114549>	a	<Concept> ;
	skos:definition	"fine parchment prepared from the skin of a young animal e.g. a calf or lamb"@en ;
	dc:source	pwn30:14759147-n .

<i114550>	a	<Concept> ;
	skos:definition	"the dressed skin of an animal (especially a large animal)"@en ;
	dc:source	pwn30:14759275-n .

<i114551>	a	<Concept> ;
	skos:definition	"the hide of a cow"@en ;
	dc:source	pwn30:14759444-n .

<i114552>	a	<Concept> ;
	skos:definition	"the hide of a goat"@en ;
	dc:source	pwn30:14759515-n .

<i114553>	a	<Concept> ;
	skos:definition	"untanned hide especially of cattle; cut in strips it is used for whips and ropes"@en ;
	dc:source	pwn30:14759588-n .

<i114554>	a	<Concept> ;
	skos:definition	"an animal skin made smooth and flexible by removing the hair and then tanning"@en ;
	dc:source	pwn30:14759722-n .

<i114555>	a	<Concept> ;
	skos:definition	"the side of leather from which the hair has been removed"@en ;
	dc:source	pwn30:14760339-n .

<i114556>	a	<Concept> ;
	skos:definition	"leather made from alligator's hide"@en ;
	dc:source	pwn30:14760447-n .

<i114557>	a	<Concept> ;
	skos:definition	"a soft yellowish suede leather originally from deerskin but now usually from sheepskin"@en ;
	dc:source	pwn30:14760555-n .

<i114558>	a	<Concept> ;
	skos:definition	"a soft thick undyed leather from the skins of e.g. buffalo or oxen"@en ;
	dc:source	pwn30:14760696-n .

<i114559>	a	<Concept> ;
	skos:definition	"a very soft leather made from the skins of calves and having a suede finish on the flesh side"@en ;
	dc:source	pwn30:14760813-n .

<i114560>	a	<Concept> ;
	skos:definition	"a smooth leather tanned with willow, birch, or oak, and scented on the flesh side with birch oil"@en ;
	dc:source	pwn30:14760965-n .

<i114561>	a	<Concept> ;
	skos:definition	"a bitter alkaloid found in coffee and tea that is responsible for their stimulating effects"@en ;
	dc:source	pwn30:14761122-n .

<i114562>	a	<Concept> ;
	skos:definition	"fine leather from the skin of a calf"@en ;
	dc:source	pwn30:14761334-n .

<i114563>	a	<Concept> ;
	skos:definition	"a leather that has been treated with alum and/or salt"@en ;
	dc:source	pwn30:14761450-n .

<i114564>	a	<Concept> ;
	skos:definition	"a starch made by leaching and drying the root of the cassava plant; the source of tapioca; a staple food in the tropics"@en ;
	dc:source	pwn30:14761578-n .

<i114565>	a	<Concept> ;
	skos:definition	"a soft suede leather formerly from the skin of the chamois antelope but now from sheepskin"@en ;
	dc:source	pwn30:14761806-n .

<i114566>	a	<Concept> ;
	skos:definition	"piece of chamois used for cleaning and polishing"@en ;
	dc:source	pwn30:14762038-n .

<i114567>	a	<Concept> ;
	skos:definition	"a fine leather originally made in Cordoba, Spain"@en ;
	dc:source	pwn30:14762145-n .

<i114568>	a	<Concept> ;
	skos:definition	"leather made from the hide of a cow"@en ;
	dc:source	pwn30:14762248-n .

<i114569>	a	<Concept> ;
	skos:definition	"leather that has had its grain pattern accentuated"@en ;
	dc:source	pwn30:14762366-n .

<i114570>	a	<Concept> ;
	skos:definition	"leather from the hide of a deer"@en ;
	dc:source	pwn30:14762486-n .

<i114571>	a	<Concept> ;
	skos:definition	"soft leather from deerskin or lambskin"@en ;
	dc:source	pwn30:14762572-n .

<i114572>	a	<Concept> ;
	skos:definition	"leather suitable for making gloves"@en ;
	dc:source	pwn30:14762664-n .

<i114573>	a	<Concept> ;
	skos:definition	"leather from the hide of a horse"@en ;
	dc:source	pwn30:14762758-n .

<i114574>	a	<Concept> ;
	skos:definition	"soft smooth leather from the hide of a young goat"@en ;
	dc:source	pwn30:14762846-n .

<i114575>	a	<Concept> ;
	skos:definition	"soft suede glove leather from goatskin"@en ;
	dc:source	pwn30:14762969-n .

<i114576>	a	<Concept> ;
	skos:definition	"a soft pebble-grained leather made from goatskin; used for shoes and book bindings etc."@en ;
	dc:source	pwn30:14763059-n .

<i114577>	a	<Concept> ;
	skos:definition	"a heavy morocco often used in bookbinding"@en ;
	dc:source	pwn30:14763218-n .

<i114578>	a	<Concept> ;
	skos:definition	"leather with a hard glossy surface"@en ;
	dc:source	pwn30:14763329-n .

<i114579>	a	<Concept> ;
	skos:definition	"leather from the skin of swine"@en ;
	dc:source	pwn30:14763424-n .

<i114580>	a	<Concept> ;
	skos:definition	"tanned skin of a sheep with the fleece left on; used for clothing"@en ;
	dc:source	pwn30:14763508-n .

<i114581>	a	<Concept> ;
	skos:definition	"in Greek mythology, a fleece of gold owned by the king of Colchis and guarded in a sacred grove by a dragon; recovered by Jason and the Argonauts"@en ;
	dc:source	pwn30:14763674-n .

<i114582>	a	<Concept> ;
	skos:definition	"leather used to make shoes"@en ;
	dc:source	pwn30:14763879-n .

<i114583>	a	<Concept> ;
	skos:definition	"leather with a napped surface"@en ;
	dc:source	pwn30:14763964-n .

<i114584>	a	<Concept> ;
	skos:definition	"the dressed hairy coat of a mammal"@en ;
	dc:source	pwn30:14764061-n .

<i114585>	a	<Concept> ;
	skos:definition	"the fur of young lambs"@en ;
	dc:source	pwn30:14764440-n .

<i114586>	a	<Concept> ;
	skos:definition	"the pelt of a bear (sometimes used as a rug)"@en ;
	dc:source	pwn30:14764518-n .

<i114587>	a	<Concept> ;
	skos:definition	"the soft brown fur of the beaver"@en ;
	dc:source	pwn30:14764617-n .

<i114588>	a	<Concept> ;
	skos:definition	"the expensive silvery grey fur of the chinchilla"@en ;
	dc:source	pwn30:14764715-n .

