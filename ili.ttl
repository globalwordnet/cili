	skos:definition	"leaf in ferns and mosses that bears the sporangia"@en ;
	dc:source	pwn30:13091620-n .

<i105509>	a	<Concept> ;
	skos:definition	"organ containing or producing spores"@en ;
	dc:source	pwn30:13091774-n .

<i105510>	a	<Concept> ;
	skos:definition	"stalk bearing one or more sporangia"@en ;
	dc:source	pwn30:13091982-n .

<i105511>	a	<Concept> ;
	skos:definition	"saclike structure in which ascospores are formed through sexual reproduction of ascomycetes"@en ;
	dc:source	pwn30:13092078-n .

<i105512>	a	<Concept> ;
	skos:definition	"sexually produced fungal spore formed within an ascus"@en ;
	dc:source	pwn30:13092240-n .

<i105513>	a	<Concept> ;
	skos:definition	"one of a string of thick walled vegetative resting cells formed by some algae and fungi"@en ;
	dc:source	pwn30:13092385-n .

<i105514>	a	<Concept> ;
	skos:definition	"a body that resembles a spore but is not an endospore; produced by some bacteria"@en ;
	dc:source	pwn30:13092548-n .

<i105515>	a	<Concept> ;
	skos:definition	"a case or sheath especially a pollen sac or moss capsule"@en ;
	dc:source	pwn30:13092722-n .

<i105516>	a	<Concept> ;
	skos:definition	"a sterile simple or branched filament or hair borne among sporangia; may be pointed or clubbed"@en ;
	dc:source	pwn30:13092836-n .

<i105517>	a	<Concept> ;
	skos:definition	"a sporangium that arises from a group of epidermal cells"@en ;
	dc:source	pwn30:13092987-n .

<i105518>	a	<Concept> ;
	skos:definition	"a sporangium formed from a single epidermal cell; characteristic of the Filicales or of almost all modern ferns"@en ;
	dc:source	pwn30:13093102-n .

<i105519>	a	<Concept> ;
	skos:definition	"a sporangium containing four asexual spores"@en ;
	dc:source	pwn30:13093275-n .

<i105520>	a	<Concept> ;
	skos:definition	"a spore-bearing branch or organ: the part of the thallus of a sporophyte that develops spores; in ferns and mosses and liverworts is practically equivalent to the sporophyte"@en ;
	dc:source	pwn30:13093380-n .

<i105521>	a	<Concept> ;
	skos:definition	"cell or organ in which gametes develop"@en ;
	dc:source	pwn30:13093629-n .

<i105522>	a	<Concept> ;
	skos:definition	"gametangia and surrounding bracts"@en ;
	dc:source	pwn30:13093725-n .

<i105523>	a	<Concept> ;
	skos:definition	"a female gametoecium"@en ;
	dc:source	pwn30:13093852-n .

<i105524>	a	<Concept> ;
	skos:definition	"a male gametoecium"@en ;
	dc:source	pwn30:13093928-n .

<i105525>	a	<Concept> ;
	skos:definition	"a modified branch bearing gametangia as in the thalloid liverworts"@en ;
	dc:source	pwn30:13094003-n .

<i105526>	a	<Concept> ;
	skos:definition	"cluster of sporangia usually on underside of a fern frond"@en ;
	dc:source	pwn30:13094145-n .

<i105527>	a	<Concept> ;
	skos:definition	"a spore-producing structure in certain lichens and fungi"@en ;
	dc:source	pwn30:13094273-n .

<i105528>	a	<Concept> ;
	skos:definition	"a membrane enclosing and protecting the developing spores especially that covering the sori of a fern"@en ;
	dc:source	pwn30:13094381-n .

<i105529>	a	<Concept> ;
	skos:definition	"a membranous covering attached to the immature fruiting body of certain mushrooms"@en ;
	dc:source	pwn30:13094556-n .

<i105530>	a	<Concept> ;
	skos:definition	"membrane initially completely investing the young sporophore of various mushrooms that is ruptured by growth; represented in the mature mushroom by a volva around lower part of stem and scales on upper surface of the cap"@en ;
	dc:source	pwn30:13094732-n .

<i105531>	a	<Concept> ;
	skos:definition	"membrane of the young sporophore of various mushrooms extending from the margin of the cap to the stem and is ruptured by growth; represented in mature mushroom by an annulus around the stem and sometimes a cortina on the margin of the cap"@en ;
	dc:source	pwn30:13095013-n .

<i105532>	a	<Concept> ;
	skos:definition	"(Fungi) a remnant of the partial veil that in mature mushrooms surrounds the stem like a collar"@en ;
	dc:source	pwn30:13095348-n .

<i105533>	a	<Concept> ;
	skos:definition	"a motile male gamete of a plant such as an alga or fern or gymnosperm"@en ;
	dc:source	pwn30:13095543-n .

<i105534>	a	<Concept> ;
	skos:definition	"the tissue of a plant"@en ;
	dc:source	pwn30:13095685-n .

<i105535>	a	<Concept> ;
	skos:definition	"a soft moist part of a fruit"@en ;
	dc:source	pwn30:13096035-n .

<i105536>	a	<Concept> ;
	skos:definition	"soft spongelike central cylinder of the stems of most flowering plants"@en ;
	dc:source	pwn30:13096159-n .

<i105537>	a	<Concept> ;
	skos:definition	"the primary tissue of higher plants composed of thin-walled cells that remain capable of cell division even when mature; constitutes the greater part of leaves, roots, the pulp of fruits, and the pith of stems"@en ;
	dc:source	pwn30:13096317-n .

<i105538>	a	<Concept> ;
	skos:definition	"parenchyma whose cells contain chloroplasts"@en ;
	dc:source	pwn30:13096677-n .

<i105539>	a	<Concept> ;
	skos:definition	"woody tissue"@en ;
	dc:source	pwn30:13096779-n .

<i105540>	a	<Concept> ;
	skos:definition	"tissue that conducts water and nutrients through the plant body in higher plants"@en ;
	dc:source	pwn30:13096863-n .

<i105541>	a	<Concept> ;
	skos:definition	"the usually cylindrical central vascular portion of the axis of a vascular plant"@en ;
	dc:source	pwn30:13097187-n .

<i105542>	a	<Concept> ;
	skos:definition	"a formative one-cell layer of tissue between xylem and phloem in most vascular plants that is responsible for secondary growth"@en ;
	dc:source	pwn30:13097338-n .

<i105543>	a	<Concept> ;
	skos:definition	"newly formed outer wood lying between the cambium and the heartwood of a tree or woody plant; usually light colored; active in water conduction"@en ;
	dc:source	pwn30:13097536-n .

<i105544>	a	<Concept> ;
	skos:definition	"the older inactive central wood of a tree or woody plant; usually darker and denser than the surrounding sapwood"@en ;
	dc:source	pwn30:13097752-n .

<i105545>	a	<Concept> ;
	skos:definition	"a unit strand of the vascular system in stems and leaves of higher plants consisting essentially of xylem and phloem"@en ;
	dc:source	pwn30:13097949-n .

<i105546>	a	<Concept> ;
	skos:definition	"any of the vascular bundles or ribs that form the branching framework of conducting and supporting tissues in a leaf or other plant organ"@en ;
	dc:source	pwn30:13098186-n .

<i105547>	a	<Concept> ;
	skos:definition	"the vein in the center of a leaf"@en ;
	dc:source	pwn30:13098420-n .

<i105548>	a	<Concept> ;
	skos:definition	"a sheet of vascular tissue separating the vascular bundles"@en ;
	dc:source	pwn30:13098515-n .

<i105549>	a	<Concept> ;
	skos:definition	"the woody part of plants: the supporting and water-conducting tissue, consisting primarily of tracheids and vessels"@en ;
	dc:source	pwn30:13098648-n .

<i105550>	a	<Concept> ;
	skos:definition	"long tubular cell peculiar to xylem"@en ;
	dc:source	pwn30:13098853-n .

<i105551>	a	<Concept> ;
	skos:definition	"(botany) tissue that conducts synthesized food substances (e.g., from leaves) to parts where needed; consists primarily of sieve tubes"@en ;
	dc:source	pwn30:13098962-n .

<i105552>	a	<Concept> ;
	skos:definition	"tube formed by cells joined end-to-end through which nutrients flow in flowering plants and brown algae"@en ;
	dc:source	pwn30:13099194-n .

<i105553>	a	<Concept> ;
	skos:definition	"false phloem"@en ;
	dc:source	pwn30:13099373-n .

<i105554>	a	<Concept> ;
	skos:definition	"strong woody fibers obtained especially from the phloem of from various plants"@en ;
	dc:source	pwn30:13099444-n .

<i105555>	a	<Concept> ;
	skos:definition	"abnormal swelling of plant tissue caused by insects or microorganisms or injury"@en ;
	dc:source	pwn30:13099586-n .

<i105556>	a	<Concept> ;
	skos:definition	"oak gall caused by larvae of a cynipid wasp"@en ;
	dc:source	pwn30:13099734-n .

<i105557>	a	<Concept> ;
	skos:definition	"a plant having foliage that persists and remains green throughout the year"@en ;
	dc:source	pwn30:13099833-n .

<i105558>	a	<Concept> ;
	skos:definition	"a plant having foliage that is shed annually at the end of the growing season"@en ;
	dc:source	pwn30:13099999-n .

<i105559>	a	<Concept> ;
	skos:definition	"a plant that when touched or ingested in sufficient quantity can be harmful or fatal to an organism"@en ;
	dc:source	pwn30:13100156-n .

<i105560>	a	<Concept> ;
	skos:definition	"a plant with a weak stem that derives support from climbing, twining, or creeping along a surface"@en ;
	dc:source	pwn30:13100677-n .

<i105561>	a	<Concept> ;
	skos:definition	"a vine or climbing plant that readily grows up a support or over other plants"@en ;
	dc:source	pwn30:13102409-n .

<i105562>	a	<Concept> ;
	skos:definition	"any plant (as ivy or periwinkle) that grows by creeping"@en ;
	dc:source	pwn30:13102648-n .

<i105563>	a	<Concept> ;
	skos:definition	"slender stem-like structure by which some twining plants attach themselves to an object for support"@en ;
	dc:source	pwn30:13102775-n .

<i105564>	a	<Concept> ;
	skos:definition	"usually coiled"@en ;
	dc:source	pwn30:13102946-n .

<i105565>	a	<Concept> ;
	skos:definition	"a plant that climbs by its adventitious roots e.g. ivy"@en ;
	dc:source	pwn30:13103023-n .

<i105566>	a	<Concept> ;
	skos:definition	"a plant having hard lignified tissues or woody parts especially stems"@en ;
	dc:source	pwn30:13103136-n .

<i105567>	a	<Concept> ;
	skos:definition	"a category in some early taxonomies"@en ;
	dc:source	pwn30:13103660-n .

<i105568>	a	<Concept> ;
	skos:definition	"having the shape or characteristics of a tree"@en ;
	dc:source	pwn30:13103750-n .

<i105569>	a	<Concept> ;
	skos:definition	"a dead tree that is still standing, usually in an undisturbed forest"@en ;
	dc:source	pwn30:13103877-n .

<i105570>	a	<Concept> ;
	skos:definition	"a tall perennial woody plant having a main trunk and branches forming a distinct elevated crown; includes both gymnosperms and angiosperms"@en ;
	dc:source	pwn30:13104059-n .

<i105571>	a	<Concept> ;
	skos:definition	"any tree that is valued as a source of lumber or timber"@en ;
	dc:source	pwn30:13107694-n .

<i105572>	a	<Concept> ;
	skos:definition	"a small tree"@en ;
	dc:source	pwn30:13107807-n .

<i105573>	a	<Concept> ;
	skos:definition	"tree (as opposed to shrub)"@en ;
	dc:source	pwn30:13107891-n .

<i105574>	a	<Concept> ;
	skos:definition	"any of several trees having seedpods as fruits"@en ;
	dc:source	pwn30:13108131-n .

<i105575>	a	<Concept> ;
	skos:definition	"a tree with limbs cut back to promote a more bushy growth of foliage"@en ;
	dc:source	pwn30:13108323-n .

<i105576>	a	<Concept> ;
	skos:definition	"young tree"@en ;
	dc:source	pwn30:13108481-n .

<i105577>	a	<Concept> ;
	skos:definition	"a tree planted or valued chiefly for its shade from sunlight"@en ;
	dc:source	pwn30:13108545-n .

<i105578>	a	<Concept> ;
	skos:definition	"any tree of the division Gymnospermophyta"@en ;
	dc:source	pwn30:13108662-n .

<i105579>	a	<Concept> ;
	skos:definition	"any gymnospermous tree or shrub bearing cones"@en ;
	dc:source	pwn30:13108841-n .

<i105580>	a	<Concept> ;
	skos:definition	"any tree having seeds and ovules contained in the ovary"@en ;
	dc:source	pwn30:13109733-n .

<i105581>	a	<Concept> ;
	skos:definition	"tree bearing edible nuts"@en ;
	dc:source	pwn30:13110915-n .

<i105582>	a	<Concept> ;
	skos:definition	"tree bearing aromatic bark or berries"@en ;
	dc:source	pwn30:13111174-n .

<i105583>	a	<Concept> ;
	skos:definition	"any of several trees having leaves or bark used to allay fever or thought to indicate regions free of fever"@en ;
	dc:source	pwn30:13111340-n .

<i105584>	a	<Concept> ;
	skos:definition	"the base part of a tree that remains standing after the tree has been felled"@en ;
	dc:source	pwn30:13111504-n .

<i105585>	a	<Concept> ;
	skos:definition	"(forestry) the stump of a tree that has been felled or headed for the production of saplings"@en ;
	dc:source	pwn30:13111700-n .

<i105586>	a	<Concept> ;
	skos:definition	"a dwarfed ornamental tree or shrub grown in a tray or shallow pot"@en ;
	dc:source	pwn30:13111881-n .

<i105587>	a	<Concept> ;
	skos:definition	"a dwarfed evergreen conifer or shrub shaped to have flat-topped asymmetrical branches and grown in a container"@en ;
	dc:source	pwn30:13112035-n .

<i105588>	a	<Concept> ;
	skos:definition	"an artificial plant resembling a bonsai"@en ;
	dc:source	pwn30:13112201-n .

<i105589>	a	<Concept> ;
	skos:definition	"small plants other than saplings growing on a forest floor"@en ;
	dc:source	pwn30:13112296-n .

<i105590>	a	<Concept> ;
	skos:definition	"low-growing plants planted in deep shade or on a steep slope where turf is difficult to grow"@en ;
	dc:source	pwn30:13112427-n .

<i105591>	a	<Concept> ;
	skos:definition	"a low woody perennial plant usually having several major stems"@en ;
	dc:source	pwn30:13112664-n .

<i105592>	a	<Concept> ;
	skos:definition	"a low shrub"@en ;
	dc:source	pwn30:13118330-n .

<i105593>	a	<Concept> ;
	skos:definition	"(Old Testament) the bush that burned without being consumed and from which God spoke to Moses"@en ;
	dc:source	pwn30:13118398-n .

<i105594>	a	<Concept> ;
	skos:definition	"dwarf shrub"@en ;
	dc:source	pwn30:13118569-n .

<i105595>	a	<Concept> ;
	skos:definition	"low-growing woody shrub or perennial with woody base"@en ;
	dc:source	pwn30:13118707-n .

<i105596>	a	<Concept> ;
	skos:definition	"any of various rough thorny shrubs or vines"@en ;
	dc:source	pwn30:13119870-n .

<i105597>	a	<Concept> ;
	skos:definition	"shrub noted primarily for its flowers"@en ;
	dc:source	pwn30:13120003-n .

<i105598>	a	<Concept> ;
	skos:definition	"a woody climbing usually tropical plant"@en ;
	dc:source	pwn30:13120211-n .

<i105599>	a	<Concept> ;
	skos:definition	"plant living on another plant and obtaining organic nutriment from it"@en ;
	dc:source	pwn30:13120446-n .

<i105600>	a	<Concept> ;
	skos:definition	"a parasitic plant that contains some chlorophyll and therefore is capable of photosynthesis"@en ;
	dc:source	pwn30:13120775-n .

<i105601>	a	<Concept> ;
	skos:definition	"a perennial plant that propagates by underground bulbs or tubers or corms"@en ;
	dc:source	pwn30:13120958-n .

<i105602>	a	<Concept> ;
	skos:definition	"plant adapted for life with a limited supply of water; compare hydrophyte and mesophyte"@en ;
	dc:source	pwn30:13121104-n .

<i105603>	a	<Concept> ;
	skos:definition	"land plant growing in surroundings having an average supply of water; compare xerophyte and hydrophyte"@en ;
	dc:source	pwn30:13121349-n .

<i105604>	a	<Concept> ;
	skos:definition	"a plant that grows partly or wholly in water whether rooted in the mud, as a lotus, or floating without anchorage, as the water hyacinth"@en ;
	dc:source	pwn30:13121544-n .

<i105605>	a	<Concept> ;
	skos:definition	"a semiaquatic plant that grows in soft wet land; most are monocots: sedge, sphagnum, grasses, cattails, etc; possibly heath"@en ;
	dc:source	pwn30:13122364-n .

<i105606>	a	<Concept> ;
	skos:definition	"plant that derives moisture and nutrients from the air and rain; usually grows on another plant but not parasitic on it"@en ;
	dc:source	pwn30:13122985-n .

<i105607>	a	<Concept> ;
	skos:definition	"a plant that is an epiphyte for part of its life"@en ;
	dc:source	pwn30:13123309-n .

<i105608>	a	<Concept> ;
	skos:definition	"an epiphytic vine or tree whose aerial roots extend down the trunk of a supporting tree and coalesce around it eventually strangling the tree"@en ;
	dc:source	pwn30:13123431-n .

<i105609>	a	<Concept> ;
	skos:definition	"plant that grows on or among rocks or is suitable for a rock garden"@en ;
	dc:source	pwn30:13123681-n .

<i105610>	a	<Concept> ;
	skos:definition	"plant that grows on rocks or stony soil and derives nourishment from the atmosphere"@en ;
	dc:source	pwn30:13123841-n .

<i105611>	a	<Concept> ;
	skos:definition	"plants growing among rocks"@en ;
	dc:source	pwn30:13124019-n .

<i105612>	a	<Concept> ;
	skos:definition	"an organism that feeds on dead organic matter especially a fungus or bacterium"@en ;
	dc:source	pwn30:13124164-n .

<i105613>	a	<Concept> ;
	skos:definition	"an organism that lives in and derives its nourishment from organic matter in stagnant or foul water"@en ;
	dc:source	pwn30:13124358-n .

<i105614>	a	<Concept> ;
	skos:definition	"an organism that lives in an oxygenated medium lacking organic matter"@en ;
	dc:source	pwn30:13124529-n .

<i105615>	a	<Concept> ;
	skos:definition	"plant capable of synthesizing its own food from simple organic substances"@en ;
	dc:source	pwn30:13124654-n .

<i105616>	a	<Concept> ;
	skos:definition	"the part of a plant from which the roots spring or the part of a stalk or trunk nearest the roots"@en ;
	dc:source	pwn30:13124855-n .

<i105617>	a	<Concept> ;
	skos:definition	"a developed system of roots"@en ;
	dc:source	pwn30:13125003-n .

<i105618>	a	<Concept> ;
	skos:definition	"(botany) the usually underground organ that lacks buds or leaves or nodes; absorbs water and mineral salts; usually it anchors the plant to the ground"@en ;
	dc:source	pwn30:13125117-n .

<i105619>	a	<Concept> ;
	skos:definition	"an air-filled root (submerged or exposed) that can function as a respiratory organ of a marsh or swamp plant"@en ;
	dc:source	pwn30:13125882-n .

<i105620>	a	<Concept> ;
	skos:definition	"(botany) main root of a plant growing straight downward from the stem"@en ;
	dc:source	pwn30:13126050-n .

<i105621>	a	<Concept> ;
	skos:definition	"root growing in an unusual location e.g. from a stem"@en ;
	dc:source	pwn30:13126192-n .

<i105622>	a	<Concept> ;
	skos:definition	"crop grown for its enlarged roots: e.g. beets; potatoes; turnips"@en ;
	dc:source	pwn30:13126308-n .

<i105623>	a	<Concept> ;
	skos:definition	"thimble-shaped mass of cells covering and protecting the growing tip of a root"@en ;
	dc:source	pwn30:13126428-n .

<i105624>	a	<Concept> ;
	skos:definition	"small root or division of a root"@en ;
	dc:source	pwn30:13126580-n .

<i105625>	a	<Concept> ;
	skos:definition	"thin hairlike outgrowth of an epidermal cell just behind the tip; absorbs nutrients from the soil"@en ;
	dc:source	pwn30:13126684-n .

<i105626>	a	<Concept> ;
	skos:definition	"a root that grows from and supports the stem above the ground in plants such as mangroves"@en ;
	dc:source	pwn30:13126856-n .

<i105627>	a	<Concept> ;
	skos:definition	"a plant structure resembling a leaf"@en ;
	dc:source	pwn30:13127001-n .

<i105628>	a	<Concept> ;
	skos:definition	"a plant or stem onto which a graft is made; especially a plant grown specifically to provide the root part of grafted plants"@en ;
	dc:source	pwn30:13127091-n .

<i105629>	a	<Concept> ;
	skos:definition	"root or part of a root used for plant propagation; especially that part of a grafted plant that supplies the roots"@en ;
	dc:source	pwn30:13127303-n .

<i105630>	a	<Concept> ;
	skos:definition	"a part (sometimes a root or leaf or bud) removed from a plant to propagate a new plant through rooting or grafting"@en ;
	dc:source	pwn30:13127473-n .

<i105631>	a	<Concept> ;
	skos:definition	"cuttings of plants set in the ground to grow as hawthorn for hedges or vines"@en ;
	dc:source	pwn30:13127666-n .

<i105632>	a	<Concept> ;
	skos:definition	"a horizontal branch from the base of plant that produces new plants from buds at its tips"@en ;
	dc:source	pwn30:13127843-n .

<i105633>	a	<Concept> ;
	skos:definition	"the upper branches and leaves of a tree or other plant"@en ;
	dc:source	pwn30:13128003-n .

<i105634>	a	<Concept> ;
	skos:definition	"an arrangement of leafy branches forming the top or head of a tree"@en ;
	dc:source	pwn30:13128156-n .

<i105635>	a	<Concept> ;
	skos:definition	"plant growing from a tuber"@en ;
	dc:source	pwn30:13128278-n .

<i105636>	a	<Concept> ;
	skos:definition	"a fleshy underground stem or root serving for reproductive and food storage"@en ;
	dc:source	pwn30:13128365-n .

<i105637>	a	<Concept> ;
	skos:definition	"a horizontal plant stem with shoots above and roots below serving as a reproductive structure"@en ;
	dc:source	pwn30:13128582-n .

<i105638>	a	<Concept> ;
	skos:definition	"the main stem or central part about which plant organs or plant parts such as branches are arranged"@en ;
	dc:source	pwn30:13128771-n .

<i105639>	a	<Concept> ;
	skos:definition	"axis of a compound leaf or compound inflorescence"@en ;
	dc:source	pwn30:13128976-n .

<i105640>	a	<Concept> ;
