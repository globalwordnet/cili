<i72480>	a	<Concept> ;
	skos:definition	"a punctuation mark (!) used after an exclamation"@en ;
	dc:source	pwn30:06843017-n .

<i72481>	a	<Concept> ;
	skos:definition	"a punctuation mark (-) used between parts of a compound word or between the syllables of a word when the word is divided at the end of a line of text"@en ;
	dc:source	pwn30:06843148-n .

<i72482>	a	<Concept> ;
	skos:definition	"either of two punctuation marks (or) used to enclose textual material"@en ;
	dc:source	pwn30:06843393-n .

<i72483>	a	<Concept> ;
	skos:definition	"a punctuation mark (.) placed at the end of a declarative sentence to indicate a full stop or after abbreviations"@en ;
	dc:source	pwn30:06843520-n .

<i72484>	a	<Concept> ;
	skos:definition	"(usually plural) one of a series of points indicating that something has been omitted or that the sentence is incomplete"@en ;
	dc:source	pwn30:06843838-n .

<i72485>	a	<Concept> ;
	skos:definition	"a punctuation mark (?) placed at the end of a sentence to indicate a question"@en ;
	dc:source	pwn30:06844040-n .

<i72486>	a	<Concept> ;
	skos:definition	"a punctuation mark used to attribute the enclosed text to someone else"@en ;
	dc:source	pwn30:06844199-n .

<i72487>	a	<Concept> ;
	skos:definition	"a single quotation mark"@en ;
	dc:source	pwn30:06844427-n .

<i72488>	a	<Concept> ;
	skos:definition	"a pair of quotation marks"@en ;
	dc:source	pwn30:06844509-n .

<i72489>	a	<Concept> ;
	skos:definition	"the use of quotation marks to indicate that it is not the authors preferred terminology"@en ;
	dc:source	pwn30:06844594-n .

<i72490>	a	<Concept> ;
	skos:definition	"a punctuation mark (`; ') used to connect independent clauses; indicates a closer relation than does a period"@en ;
	dc:source	pwn30:06844739-n .

<i72491>	a	<Concept> ;
	skos:definition	"a punctuation mark (/) used to separate related items of information"@en ;
	dc:source	pwn30:06844903-n .

<i72492>	a	<Concept> ;
	skos:definition	"a punctuation mark used in text to indicate the omission of a word"@en ;
	dc:source	pwn30:06845076-n .

<i72493>	a	<Concept> ;
	skos:definition	"the name by which a corporation is identified"@en ;
	dc:source	pwn30:06845199-n .

<i72494>	a	<Concept> ;
	skos:definition	"strings of letters and numbers (separated by periods) that are used to name organizations and computers and addresses on the internet"@en ;
	dc:source	pwn30:06845303-n .

<i72495>	a	<Concept> ;
	skos:definition	"a name given to a product or service"@en ;
	dc:source	pwn30:06845599-n .

<i72496>	a	<Concept> ;
	skos:definition	"trade name of a company that produces musical recordings"@en ;
	dc:source	pwn30:06851516-n .

<i72497>	a	<Concept> ;
	skos:definition	"a formally registered symbol identifying the manufacturer or distributor of a product"@en ;
	dc:source	pwn30:06851742-n .

<i72498>	a	<Concept> ;
	skos:definition	"a mark on an article of trade to indicate its origin and authenticity"@en ;
	dc:source	pwn30:06855035-n .

<i72499>	a	<Concept> ;
	skos:definition	"a symbol that is the result of printing or engraving"@en ;
	dc:source	pwn30:06855207-n .

<i72500>	a	<Concept> ;
	skos:definition	"an impression produced by pressure or printing"@en ;
	dc:source	pwn30:06855432-n .

<i72501>	a	<Concept> ;
	skos:definition	"an identification of a publisher; a publisher's name along with the date and address and edition that is printed at the bottom of the title page"@en ;
	dc:source	pwn30:06855563-n .

<i72502>	a	<Concept> ;
	skos:definition	"a small piece of adhesive paper that is put on an object to show that a government tax has been paid"@en ;
	dc:source	pwn30:06855817-n .

<i72503>	a	<Concept> ;
	skos:definition	"a stamp affixed to a document (as to attest to its authenticity or to seal it)"@en ;
	dc:source	pwn30:06855985-n .

<i72504>	a	<Concept> ;
	skos:definition	"(Judaism) either of two small leather cases containing texts from the Hebrew Scriptures (known collectively as tefillin); traditionally worn (on the forehead and the left arm) by Jewish men during morning prayer"@en ;
	dc:source	pwn30:06856189-n .

<i72505>	a	<Concept> ;
	skos:definition	"a symbol of cowardice"@en ;
	dc:source	pwn30:06856487-n .

<i72506>	a	<Concept> ;
	skos:definition	"(music) a series of notes differing in pitch according to a specific scheme (usually within an octave)"@en ;
	dc:source	pwn30:06856568-n .

<i72507>	a	<Concept> ;
	skos:definition	"(music) a short lively tune played on brass instruments"@en ;
	dc:source	pwn30:06856884-n .

<i72508>	a	<Concept> ;
	skos:definition	"a rapid series of ascending or descending notes on the musical scale"@en ;
	dc:source	pwn30:06857122-n .

<i72509>	a	<Concept> ;
	skos:definition	"(music) rapid sliding up or down the musical scale"@en ;
	dc:source	pwn30:06857264-n .

<i72510>	a	<Concept> ;
	skos:definition	"the entire scale of musical notes"@en ;
	dc:source	pwn30:06857487-n .

<i72511>	a	<Concept> ;
	skos:definition	"(music) an elaborate run of several notes sung to one syllable"@en ;
	dc:source	pwn30:06857591-n .

<i72512>	a	<Concept> ;
	skos:definition	"(music) the first note of a diatonic scale"@en ;
	dc:source	pwn30:06857726-n .

<i72513>	a	<Concept> ;
	skos:definition	"(music) the second note of a diatonic scale"@en ;
	dc:source	pwn30:06857867-n .

<i72514>	a	<Concept> ;
	skos:definition	"(music) the third note of a diatonic scale; midway between the tonic and the dominant"@en ;
	dc:source	pwn30:06857986-n .

<i72515>	a	<Concept> ;
	skos:definition	"(music) the fourth note of the diatonic scale"@en ;
	dc:source	pwn30:06858144-n .

<i72516>	a	<Concept> ;
	skos:definition	"(music) the fifth note of the diatonic scale"@en ;
	dc:source	pwn30:06858266-n .

<i72517>	a	<Concept> ;
	skos:definition	"(music) the sixth note of a major or minor scale (or the third below the tonic)"@en ;
	dc:source	pwn30:06858384-n .

<i72518>	a	<Concept> ;
	skos:definition	"(music) the seventh note of the diatonic scale"@en ;
	dc:source	pwn30:06858539-n .

<i72519>	a	<Concept> ;
	skos:definition	"a sustained bass note"@en ;
	dc:source	pwn30:06858674-n .

<i72520>	a	<Concept> ;
	skos:definition	"the difference in pitch between two notes"@en ;
	dc:source	pwn30:06858779-n .

<i72521>	a	<Concept> ;
	skos:definition	"a musical interval of two semitones"@en ;
	dc:source	pwn30:06859056-n .

<i72522>	a	<Concept> ;
	skos:definition	"the musical interval between adjacent keys on a keyboard instrument"@en ;
	dc:source	pwn30:06859175-n .

<i72523>	a	<Concept> ;
	skos:definition	"half of a semitone"@en ;
	dc:source	pwn30:06859309-n .

<i72524>	a	<Concept> ;
	skos:definition	"a musical interval of eight tones"@en ;
	dc:source	pwn30:06859401-n .

<i72525>	a	<Concept> ;
	skos:definition	"the musical interval between one note and another three notes away from it"@en ;
	dc:source	pwn30:06859504-n .

<i72526>	a	<Concept> ;
	skos:definition	"the musical interval between one note and another four notes away from it"@en ;
	dc:source	pwn30:06859674-n .

<i72527>	a	<Concept> ;
	skos:definition	"the musical interval between one note and another five notes away from it"@en ;
	dc:source	pwn30:06859800-n .

<i72528>	a	<Concept> ;
	skos:definition	"the musical interval between one note and another six notes away from it"@en ;
	dc:source	pwn30:06859925-n .

<i72529>	a	<Concept> ;
	skos:definition	"the musical interval between one note and another seven notes away from it"@en ;
	dc:source	pwn30:06860049-n .

<i72530>	a	<Concept> ;
	skos:definition	"a note that alternates rapidly with another note a semitone above it"@en ;
	dc:source	pwn30:06860177-n .

<i72531>	a	<Concept> ;
	skos:definition	"a scale with eight notes in an octave; all but two are separated by whole tones"@en ;
	dc:source	pwn30:06860323-n .

<i72532>	a	<Concept> ;
	skos:definition	"any of a system of modes used in Gregorian chants up until 1600; derived historically from the Greek mode"@en ;
	dc:source	pwn30:06860481-n .

<i72533>	a	<Concept> ;
	skos:definition	"any of the descending diatonic scales in the music of classical Greece"@en ;
	dc:source	pwn30:06860699-n .

<i72534>	a	<Concept> ;
	skos:definition	"a diatonic scale with notes separated by whole tones except for the 3rd and 4th and 7th and 8th"@en ;
	dc:source	pwn30:06860826-n .

<i72535>	a	<Concept> ;
	skos:definition	"a diatonic scale with notes separated by whole tones except for the 2nd and 3rd and 5th and 6th"@en ;
	dc:source	pwn30:06861020-n .

<i72536>	a	<Concept> ;
	skos:definition	"a 12-note scale including all the semitones of the octave"@en ;
	dc:source	pwn30:06861196-n .

<i72537>	a	<Concept> ;
	skos:definition	"a musical scale with fewer than seven notes"@en ;
	dc:source	pwn30:06861315-n .

<i72538>	a	<Concept> ;
	skos:definition	"a gapped scale with five notes; usually the fourth and seventh notes of the diatonic scale are omitted"@en ;
	dc:source	pwn30:06861435-n .

<i72539>	a	<Concept> ;
	skos:definition	"any of various fixed orders of the various diatonic notes within an octave"@en ;
	dc:source	pwn30:06861630-n .

<i72540>	a	<Concept> ;
	skos:definition	"(music) the system of five horizontal lines on which the musical notes are written"@en ;
	dc:source	pwn30:06861860-n .

<i72541>	a	<Concept> ;
	skos:definition	"any of the 5 horizontal marks comprising a staff"@en ;
	dc:source	pwn30:06862059-n .

<i72542>	a	<Concept> ;
	skos:definition	"one of the areas between or below or above the lines of a musical staff"@en ;
	dc:source	pwn30:06862202-n .

<i72543>	a	<Concept> ;
	skos:definition	"a short line; a notation for extending the range above or below the staff"@en ;
	dc:source	pwn30:06862399-n .

<i72544>	a	<Concept> ;
	skos:definition	"a musical notation written on a staff indicating the pitch of the notes following it"@en ;
	dc:source	pwn30:06862562-n .

<i72545>	a	<Concept> ;
	skos:definition	"a clef that puts the G above middle C on the second line of a staff"@en ;
	dc:source	pwn30:06862805-n .

<i72546>	a	<Concept> ;
	skos:definition	"a clef that puts the F below middle C on the fourth line of a staff"@en ;
	dc:source	pwn30:06862954-n .

<i72547>	a	<Concept> ;
	skos:definition	"a clef that puts middle C on the third line of a staff"@en ;
	dc:source	pwn30:06863086-n .

<i72548>	a	<Concept> ;
	skos:definition	"a movable clef that puts middle C on one of the lines of a staff"@en ;
	dc:source	pwn30:06863209-n .

<i72549>	a	<Concept> ;
	skos:definition	"a clef that puts middle C on the bottom line of the staff"@en ;
	dc:source	pwn30:06863326-n .

<i72550>	a	<Concept> ;
	skos:definition	"a clef that puts middle C on the fourth line of the staff; used for writing music for bassoons or cellos or tenor horns"@en ;
	dc:source	pwn30:06863442-n .

<i72551>	a	<Concept> ;
	skos:definition	"the sharps or flats that follow the clef and indicate the key"@en ;
	dc:source	pwn30:06863618-n .

<i72552>	a	<Concept> ;
	skos:definition	"any of 24 major or minor diatonic scales that provide the tonal framework for a piece of music"@en ;
	dc:source	pwn30:06863751-n .

<i72553>	a	<Concept> ;
	skos:definition	"the absence of a key; alternative to the diatonic system"@en ;
	dc:source	pwn30:06864014-n .

<i72554>	a	<Concept> ;
	skos:definition	"a key whose harmony is based on the major scale"@en ;
	dc:source	pwn30:06864192-n .

<i72555>	a	<Concept> ;
	skos:definition	"a key based on the minor scale"@en ;
	dc:source	pwn30:06864308-n .

<i72556>	a	<Concept> ;
	skos:definition	"the basic key in which a piece of music is written"@en ;
	dc:source	pwn30:06864407-n .

<i72557>	a	<Concept> ;
	skos:definition	"a musical notation indicating the number of beats to a measure and kind of note that takes a beat"@en ;
	dc:source	pwn30:06864524-n .

<i72558>	a	<Concept> ;
	skos:definition	"musical notation for a repeating pattern of musical beats"@en ;
	dc:source	pwn30:06864725-n .

<i72559>	a	<Concept> ;
	skos:definition	"notation marking the end of principal parts of a musical composition; two adjacent bar lines"@en ;
	dc:source	pwn30:06864900-n .

<i72560>	a	<Concept> ;
	skos:definition	"a musical time signature indicating two or four half notes to a measure"@en ;
	dc:source	pwn30:06865049-n .

<i72561>	a	<Concept> ;
	skos:definition	"a musical notation indicating a silence of a specified duration"@en ;
	dc:source	pwn30:06865177-n .

<i72562>	a	<Concept> ;
	skos:definition	"a notation representing the pitch and duration of a musical sound"@en ;
	dc:source	pwn30:06865345-n .

<i72563>	a	<Concept> ;
	skos:definition	"(music) a curved line spanning notes that are to be played legato"@en ;
	dc:source	pwn30:06865953-n .

<i72564>	a	<Concept> ;
	skos:definition	"(music) a slur over two notes of the same pitch; indicates that the note is to be sustained for their combined time value"@en ;
	dc:source	pwn30:06866124-n .

<i72565>	a	<Concept> ;
	skos:definition	"(music) the keynote of the scale of C major"@en ;
	dc:source	pwn30:06866332-n .

<i72566>	a	<Concept> ;
	skos:definition	"(music) the major scale having no sharps or flats"@en ;
	dc:source	pwn30:06866442-n .

<i72567>	a	<Concept> ;
	skos:definition	"a musical notation indicating one half step higher than the note named"@en ;
	dc:source	pwn30:06866599-n .

<i72568>	a	<Concept> ;
	skos:definition	"a musical notation of two sharps in front of a note indicating that it is to be raised by two semitones"@en ;
	dc:source	pwn30:06866757-n .

<i72569>	a	<Concept> ;
	skos:definition	"a musical notation indicating one half step lower than the note named"@en ;
	dc:source	pwn30:06866919-n .

<i72570>	a	<Concept> ;
	skos:definition	"a musical notation of two flats in front of a note indicating that it is to be lowered by two semitones"@en ;
	dc:source	pwn30:06867057-n .

<i72571>	a	<Concept> ;
	skos:definition	"a notation cancelling a previous sharp or flat"@en ;
	dc:source	pwn30:06867218-n .

<i72572>	a	<Concept> ;
	skos:definition	"a musical notation that makes a note sharp or flat or natural although that is not part of the key signature"@en ;
	dc:source	pwn30:06867345-n .

<i72573>	a	<Concept> ;
	skos:definition	"a musical notation (over a note or chord or rest) that indicates it is to be prolonged by an unspecified amount"@en ;
	dc:source	pwn30:06867510-n .

<i72574>	a	<Concept> ;
	skos:definition	"a system of naming the notes of a musical scale by syllables instead of letters"@en ;
	dc:source	pwn30:06867675-n .

<i72575>	a	<Concept> ;
	skos:definition	"a system of solmization using the solfa syllables: do, re, mi, fa, sol, la, ti"@en ;
	dc:source	pwn30:06867880-n .

<i72576>	a	<Concept> ;
	skos:definition	"one of the names for notes of a musical scale in solmization"@en ;
	dc:source	pwn30:06868043-n .

<i72577>	a	<Concept> ;
	skos:definition	"the syllable naming the first (tonic) note of any major scale in solmization"@en ;
	dc:source	pwn30:06868309-n .

<i72578>	a	<Concept> ;
	skos:definition	"the syllable naming the second (supertonic) note of any major scale in solmization"@en ;
	dc:source	pwn30:06868445-n .

<i72579>	a	<Concept> ;
	skos:definition	"the syllable naming the third (mediant) note of any major scale in solmization"@en ;
	dc:source	pwn30:06868582-n .

<i72580>	a	<Concept> ;
	skos:definition	"the syllable naming the fourth (subdominant) note of the diatonic scale in solmization"@en ;
	dc:source	pwn30:06868709-n .

<i72581>	a	<Concept> ;
	skos:definition	"the syllable naming the fifth (dominant) note of any musical scale in solmization"@en ;
	dc:source	pwn30:06868844-n .

<i72582>	a	<Concept> ;
	skos:definition	"the syllable naming the sixth (submediant) note of a major or minor scale in solmization"@en ;
	dc:source	pwn30:06868986-n .

<i72583>	a	<Concept> ;
	skos:definition	"the syllable naming the seventh (subtonic) note of any musical scale in solmization"@en ;
	dc:source	pwn30:06869129-n .

<i72584>	a	<Concept> ;
	skos:definition	"(music) a notation written at the beginning or end of a passage that is to be repeated"@en ;
	dc:source	pwn30:06869271-n .

<i72585>	a	<Concept> ;
	skos:definition	"(music) a notation written above a note and indicating that it is to be played with a strong initial attack"@en ;
	dc:source	pwn30:06869428-n .

<i72586>	a	<Concept> ;
	skos:definition	"a chord whose notes are played in rapid succession rather than simultaneously"@en ;
	dc:source	pwn30:06869610-n .

<i72587>	a	<Concept> ;
	skos:definition	"an accented chord"@en ;
	dc:source	pwn30:06869742-n .

<i72588>	a	<Concept> ;
	skos:definition	"the note designated by the first ledger line below the treble staff; 261.63 hertz"@en ;
	dc:source	pwn30:06869815-n .

<i72589>	a	<Concept> ;
	skos:definition	"a combination of three or more notes that blend harmoniously when sounded together"@en ;
	dc:source	pwn30:06869951-n .

<i72590>	a	<Concept> ;
	skos:definition	"a three-note major or minor chord; a note and its third and fifth tones"@en ;
	dc:source	pwn30:06870211-n .

<i72591>	a	<Concept> ;
	skos:definition	"a triad with a seventh added"@en ;
	dc:source	pwn30:06870349-n .

<i72592>	a	<Concept> ;
	skos:definition	"a nonharmonic note inserted for transition between harmonic notes"@en ;
	dc:source	pwn30:06870437-n .

<i72593>	a	<Concept> ;
	skos:definition	"a musical note having the longest time value (equal to four beats in common time)"@en ;
	dc:source	pwn30:06870576-n .

<i72594>	a	<Concept> ;
	skos:definition	"a musical rest equal in duration to four beats in common time"@en ;
	dc:source	pwn30:06870726-n .

<i72595>	a	<Concept> ;
	skos:definition	"a musical note having the time value of half a whole note"@en ;
	dc:source	pwn30:06870844-n .

<i72596>	a	<Concept> ;
	skos:definition	"a musical rest having the time value of half a whole rest or equal in duration to two beats in common time"@en ;
	dc:source	pwn30:06870965-n .

<i72597>	a	<Concept> ;
	skos:definition	"a musical note having the time value of a quarter of a whole note"@en ;
	dc:source	pwn30:06871127-n .

<i72598>	a	<Concept> ;
	skos:definition	"a musical rest having one-fourth the time value of a whole rest"@en ;
	dc:source	pwn30:06871262-n .

<i72599>	a	<Concept> ;
	skos:definition	"a musical note having the time value of an eighth of a whole note"@en ;
	dc:source	pwn30:06871384-n .

<i72600>	a	<Concept> ;
	skos:definition	"a musical note having the time value of a sixteenth of a whole note"@en ;
	dc:source	pwn30:06871534-n .

<i72601>	a	<Concept> ;
	skos:definition	"a musical note having the time value of a thirty-second of a whole note"@en ;
	dc:source	pwn30:06871675-n .

<i72602>	a	<Concept> ;
	skos:definition	"a musical note having the time value of a sixty-fourth of a whole note"@en ;
	dc:source	pwn30:06871828-n .

<i72603>	a	<Concept> ;
	skos:definition	"an embellishing note usually written in smaller size"@en ;
	dc:source	pwn30:06871983-n .

<i72604>	a	<Concept> ;
	skos:definition	"the musical quality of the voice while singing"@en ;
	dc:source	pwn30:06872122-n .

<i72605>	a	<Concept> ;
	skos:definition	"the lowest adult male singing voice"@en ;
	dc:source	pwn30:06872354-n .

<i72606>	a	<Concept> ;
	skos:definition	"a very deep bass voice"@en ;
	dc:source	pwn30:06872479-n .

<i72607>	a	<Concept> ;
	skos:definition	"the second lowest adult male singing voice"@en ;
	dc:source	pwn30:06872562-n .

<i72608>	a	<Concept> ;
	skos:definition	"the adult male singing voice above baritone"@en ;
	dc:source	pwn30:06872676-n .

<i72609>	a	<Concept> ;
	skos:definition	"the highest adult male singing voice"@en ;
	dc:source	pwn30:06872785-n .

<i72610>	a	<Concept> ;
	skos:definition	"the lowest female singing voice"@en ;
	dc:source	pwn30:06872905-n .

<i72611>	a	<Concept> ;
	skos:definition	"the female singing voice between contralto and soprano"@en ;
