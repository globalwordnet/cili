	dc:source	pwn30:05369092-n .

<i65178>	a	<Concept> ;
	skos:definition	"a vein that drains the liver; empties into the vena cava"@en ;
	dc:source	pwn30:05369254-n .

<i65179>	a	<Concept> ;
