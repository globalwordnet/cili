	dc:source	pwn30:09500398-n .

<i86547>	a	<Instance> ;
	skos:definition	"(Greek mythology) the immortal winged horse that sprang from the blood of the slain Medusa; was tamed by Bellerophon with the help of a bridle given him by Athena; as the flying horse of the Muses it is a symbol of highflying imagination"@en ;
	dc:source	pwn30:09500625-n .

<i86548>	a	<Concept> ;
