	skos:definition	"a blood disorder characterized by a lower concentration of hydrogen ions in the blood (which rises above 7.45 on the pH scale)"@en ;
	dc:source	pwn30:14020936-n .

<i110615>	a	<Concept> ;
	skos:definition	"a condition in which the urine (which is normally slightly acidic) is alkaline"@en ;
	dc:source	pwn30:14021118-n .

<i110616>	a	<Concept> ;
	skos:definition	"abnormally high alkalinity (low hydrogen-ion concentration) of the blood and other body tissues"@en ;
