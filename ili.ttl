	dc:source	pwn30:15111609-n .

<i116623>	a	<Concept> ;
	skos:definition	"a sterile liquid containing a purified protein derivative of the tuberculosis bacterium; used in the diagnosis of tuberculosis"@en ;
	dc:source	pwn30:15111903-n .

