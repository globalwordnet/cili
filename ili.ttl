	dc:source	pwn30:15108897-n .

<i116608>	a	<Concept> ;
	skos:definition	"a mica containing iron and lithium"@en ;
	dc:source	pwn30:15109016-n .

<i116609>	a	<Concept> ;
	skos:definition	"a common mineral occurring in small crystals; chief source of zirconium; used as a refractory when opaque and as a gem when transparent"@en ;
	dc:source	pwn30:15109127-n .

