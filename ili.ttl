	skos:definition	"the act of making lawful"@en ;
	dc:source	pwn30:01195380-n .

<i41655>	a	<Concept> ;
	skos:definition	"the act of rendering a person legitimate"@en ;
	dc:source	pwn30:01195584-n .

<i41656>	a	<Concept> ;
	skos:definition	"(law) the determination of a person's innocence or guilt by due process of law"@en ;
	dc:source	pwn30:01195867-n .

<i41657>	a	<Concept> ;
	skos:definition	"a trial that is conducted by a military court"@en ;
	dc:source	pwn30:01196316-n .

<i41658>	a	<Concept> ;
