	dc:source	pwn30:14633037-n .

<i113913>	a	<Concept> ;
	skos:definition	"an abundant nonmetallic tetravalent element occurring in three allotropic forms: amorphous carbon and graphite and diamond; occurs in all organic compounds"@en ;
