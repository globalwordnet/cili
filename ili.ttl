	skos:definition	"an affected elegance of style that was introduced into Spanish literature by the poet Gongora"@en ;
	dc:source	pwn30:07068324-n .

<i73826>	a	<Concept> ;
	skos:definition	"an artistic device or effect"@en ;
	dc:source	pwn30:07068473-n .

