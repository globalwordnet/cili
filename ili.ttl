	dc:source	pwn30:15106867-n .

<i116598>	a	<Concept> ;
	skos:definition	"a group of minerals of the zeolite family consisting of a hydrous silicate of calcium and aluminum"@en ;
	dc:source	pwn30:15107196-n .

<i116599>	a	<Concept> ;
	skos:definition	"a group of minerals of the zeolite family consisting of a hydrous aluminum silicate of sodium and calcium"@en ;
	dc:source	pwn30:15107362-n .

<i116600>	a	<Concept> ;
	skos:definition	"a group of minerals of the zeolite family consisting of a hydrous silicate of sodium and aluminum"@en ;
	dc:source	pwn30:15107524-n .

<i116601>	a	<Concept> ;
	skos:definition	"a group of white or reddish crystalline minerals of the zeolite family consisting of a hydrous silicate of calcium and potassium and aluminum"@en ;
	dc:source	pwn30:15107677-n .

<i116602>	a	<Concept> ;
	skos:definition	"an ore that is the chief source of zinc; consists largely of zinc sulfide in crystalline form"@en ;
	dc:source	pwn30:15107876-n .

<i116603>	a	<Concept> ;
	skos:definition	"oxide of zinc; a white powder used as a pigment or in cosmetics or glass or inks and in zinc ointment"@en ;
	dc:source	pwn30:15108087-n .

<i116604>	a	<Concept> ;
