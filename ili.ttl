<i110624>	a	<Concept> ;
	skos:definition	"abnormal adhesion and rigidity of the bones of a joint"@en ;
	dc:source	pwn30:14022520-n .

<i110625>	a	<Concept> ;
	skos:definition	"an abnormality involving a chromosome number that is not an exact multiple of the haploid number (one chromosome set is incomplete)"@en ;
