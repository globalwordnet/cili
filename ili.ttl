<i113024>	a	<Concept> ;
	skos:definition	"an imperfection in someone or something that is suggestive of a wart (especially in smallness or unattractiveness)"@en ;
	dc:source	pwn30:14464883-n .

<i113025>	a	<Concept> ;
	skos:definition	"a defect that is present at birth"@en ;
	dc:source	pwn30:14465048-n .

<i113026>	a	<Concept> ;
	skos:definition	"an abnormal condition in which cerebrospinal fluid collects in the ventricles of the brain; in infants it can cause abnormally rapid growth of the head and bulging fontanelles and a small face; in adults the symptoms are primarily neurological"@en ;
	dc:source	pwn30:14465768-n .

<i113027>	a	<Concept> ;
	skos:definition	"accumulation of urine in the kidney because of an obstruction in the ureter"@en ;
	dc:source	pwn30:14466122-n .

<i113028>	a	<Concept> ;
	skos:definition	"the condition of having no arms"@en ;
	dc:source	pwn30:14466258-n .

<i113029>	a	<Concept> ;
	skos:definition	"congenital absence of an arm or leg"@en ;
	dc:source	pwn30:14466344-n .

<i113030>	a	<Concept> ;
	skos:definition	"congenital absence of part of an arm or leg"@en ;
	dc:source	pwn30:14466432-n .

<i113031>	a	<Concept> ;
	skos:definition	"an abnormality of development in which the upper part of an arm or leg is missing so the hands or feet are attached to the body like stumps; rare condition that results from taking thalidomide during pregnancy"@en ;
	dc:source	pwn30:14466567-n .

<i113032>	a	<Concept> ;
	skos:definition	"protrusion of brain tissue through a congenital fissure in the skull"@en ;
	dc:source	pwn30:14466846-n .

<i113033>	a	<Concept> ;
	skos:definition	"congenital disorder characterized by high levels of cholesterol and early development of atherosclerosis"@en ;
	dc:source	pwn30:14466974-n .

<i113034>	a	<Concept> ;
	skos:definition	"a congenital anomaly of the central nervous system in which a sac protruding from the brain or the spinal meninges contains cerebrospinal fluid (but no nerve tissue)"@en ;
	dc:source	pwn30:14467172-n .

<i113035>	a	<Concept> ;
	skos:definition	"a congenital defect of the central nervous system in which a sac containing part of the spinal cord and its meninges protrude through a gap in the vertebral column; frequently accompanied by hydrocephalus and mental retardation"@en ;
	dc:source	pwn30:14467395-n .

<i113036>	a	<Concept> ;
	skos:definition	"congenital malformation of the skull in which the main axis of the skull is oblique"@en ;
	dc:source	pwn30:14467685-n .

<i113037>	a	<Concept> ;
	skos:definition	"congenital defect of having one or more extra chromosomes in somatic cells"@en ;
	dc:source	pwn30:14467846-n .

<i113038>	a	<Concept> ;
	skos:definition	"congenital condition in which external genitalia and internal sex organs have both male and female characteristics"@en ;
	dc:source	pwn30:14467975-n .

<i113039>	a	<Concept> ;
	skos:definition	"congenital condition in which a person has external genitalia of one sex and internal sex organs of the other sex"@en ;
	dc:source	pwn30:14468167-n .

<i113040>	a	<Concept> ;
	skos:definition	"a rare abnormality marked by premature aging (grey hair and wrinkled skin and stooped posture) in a child"@en ;
	dc:source	pwn30:14468348-n .

<i113041>	a	<Concept> ;
	skos:definition	"congenital malformation of the skull which is long and narrow; frequently accompanied by mental retardation"@en ;
	dc:source	pwn30:14468508-n .

<i113042>	a	<Concept> ;
	skos:definition	"a deformity in which there is an abnormal displacement of part of a limb away from the midline of the body"@en ;
	dc:source	pwn30:14468693-n .

<i113043>	a	<Concept> ;
	skos:definition	"a deformity in which part of a limb is turned inward to an abnormal degree"@en ;
	dc:source	pwn30:14468870-n .

<i113044>	a	<Concept> ;
	skos:definition	"a birth defect involving the heart"@en ;
	dc:source	pwn30:14469014-n .

<i113045>	a	<Concept> ;
	skos:definition	"a congenital abnormality in the septum between the left and right sides of the heart"@en ;
	dc:source	pwn30:14469154-n .

<i113046>	a	<Concept> ;
	skos:definition	"an abnormal opening between the left and right atria of the heart"@en ;
	dc:source	pwn30:14469334-n .

<i113047>	a	<Concept> ;
	skos:definition	"a common congenital heart defect; an abnormal opening in the septum dividing the ventricles allows blood to pass directly from the left to the right ventricle; large openings may cause congestive heart failure"@en ;
	dc:source	pwn30:14469466-n .

<i113048>	a	<Concept> ;
	skos:definition	"a congenital heart defect producing cyanosis; characterized by four symptoms: pulmonary stenosis and ventricular septal defect and malposition of the aorta over both ventricles and hypertrophy of the right ventricle"@en ;
	dc:source	pwn30:14469766-n .

<i113049>	a	<Concept> ;
	skos:definition	"syndrome resulting from a serious acute (sometimes fatal) infection associated with the presence of staphylococcus; characterized by fever and diarrhea and nausea and diffuse erythema and shock; occurs especially in menstruating women using highly absorbent tampons"@en ;
	dc:source	pwn30:14470144-n .

<i113050>	a	<Concept> ;
	skos:definition	"syndrome associated with bacterial meningitis; marked by sudden high fever and skin discoloration and petechiae with hemorrhage into the adrenal glands and cardiovascular collapse"@en ;
	dc:source	pwn30:14470496-n .

<i113051>	a	<Concept> ;
	skos:definition	"a rare congenital disorder associated with deletion of genetic material in chromosome 7; characterized by mental deficiency and some growth deficiency and elfin faces but an overly social personality and a remarkable gift for vocabulary"@en ;
	dc:source	pwn30:14470754-n .

<i113052>	a	<Concept> ;
	skos:definition	"syndrome consisting of intractable peptic ulceration with gastric hypersecretion and hyperacidity"@en ;
	dc:source	pwn30:14471054-n .

<i113053>	a	<Concept> ;
	skos:definition	"a not uncommon congenital defect in which a vertebra is malformed; unless several vertebrae are affected or there is myelomeningocele there are few symptoms; can be diagnosed by amniocentesis"@en ;
	dc:source	pwn30:14471224-n .

<i113054>	a	<Concept> ;
	skos:definition	"any of several congenital disorders marked by degeneration of the cerebellum and spinal cord resulting in spasticity and ataxia"@en ;
	dc:source	pwn30:14471507-n .

<i113055>	a	<Concept> ;
	skos:definition	"birth defect characterized by the presence of more than the normal number of fingers or toes"@en ;
	dc:source	pwn30:14471724-n .

<i113056>	a	<Concept> ;
	skos:definition	"birth defect in which there is partial or total webbing connecting two or more fingers or toes"@en ;
	dc:source	pwn30:14471926-n .

