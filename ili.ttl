<i67694>	a	<Concept> ;
	skos:definition	"a variable quantity that cannot be resolved into components"@en ;
	dc:source	pwn30:05864351-n .

<i67695>	a	<Concept> ;
	skos:definition	"a generalization of the concept of a vector"@en ;
	dc:source	pwn30:05864481-n .

<i67696>	a	<Concept> ;
	skos:definition	"a variable quantity that can be resolved into components"@en ;
	dc:source	pwn30:05864577-n .

<i67697>	a	<Concept> ;
	skos:definition	"a vector that is the product of two other vectors"@en ;
	dc:source	pwn30:05864758-n .

<i67698>	a	<Concept> ;
	skos:definition	"a real number (a scalar) that is the product of two vectors"@en ;
	dc:source	pwn30:05864884-n .

<i67699>	a	<Concept> ;
	skos:definition	"a vector that is the sum of two or more other vectors"@en ;
	dc:source	pwn30:05865034-n .

<i67700>	a	<Concept> ;
	skos:definition	"a line connecting a point in space to the origin of a polar coordinate system"@en ;
	dc:source	pwn30:05865174-n .

<i67701>	a	<Concept> ;
	skos:definition	"a line connecting a satellite to the center of the body around which it is rotating"@en ;
	dc:source	pwn30:05865311-n .

<i67702>	a	<Concept> ;
	skos:definition	"the essential factor; the all-important element; the supreme aim"@en ;
	dc:source	pwn30:05865454-n .

<i67703>	a	<Concept> ;
	skos:definition	"a component or element of the plot of a story"@en ;
	dc:source	pwn30:05865652-n .

<i67704>	a	<Concept> ;
	skos:definition	"(film) a plot element that catches the viewers' attention or drives the plot"@en ;
	dc:source	pwn30:05865774-n .

<i67705>	a	<Concept> ;
	skos:definition	"a geometric element that has position but no extension"@en ;
	dc:source	pwn30:05865998-n .

<i67706>	a	<Concept> ;
	skos:definition	"(physics) a point in the ideal multidimensional phase space that is used to describe a system toward which the system tends to evolve regardless of the starting conditions of the system"@en ;
	dc:source	pwn30:05866199-n .

<i67707>	a	<Concept> ;
	skos:definition	"an attractor for which the approach to its final point in phase space is chaotic"@en ;
	dc:source	pwn30:05866489-n .

<i67708>	a	<Concept> ;
	skos:definition	"a point where lines intersect"@en ;
	dc:source	pwn30:05866653-n .

<i67709>	a	<Concept> ;
	skos:definition	"(shipbuilding) the point of intersection between two vertical lines, one line through the center of buoyancy of the hull of a ship in equilibrium and the other line through the center of buoyancy of the hull when the ship is inclined to one side; the distance of this intersection above the center of gravity is an indication of the stability of the ship"@en ;
	dc:source	pwn30:05866822-n .

<i67710>	a	<Concept> ;
	skos:definition	"the point of intersection of lines or the point opposite the base of a figure"@en ;
	dc:source	pwn30:05867283-n .

<i67711>	a	<Concept> ;
	skos:definition	"one of the portions into which something is regarded as divided and which together constitute a whole"@en ;
	dc:source	pwn30:05867413-n .

<i67712>	a	<Concept> ;
	skos:definition	"the first part or section of something"@en ;
	dc:source	pwn30:05868051-n .

<i67713>	a	<Concept> ;
	skos:definition	"an intermediate part or section"@en ;
	dc:source	pwn30:05868272-n .

<i67714>	a	<Concept> ;
	skos:definition	"a final part or section"@en ;
	dc:source	pwn30:05868477-n .

<i67715>	a	<Concept> ;
	skos:definition	"the most enjoyable part of a given experience"@en ;
	dc:source	pwn30:05868779-n .

<i67716>	a	<Concept> ;
	skos:definition	"an abstract part of something"@en ;
	dc:source	pwn30:05868954-n .

<i67717>	a	<Concept> ;
	skos:definition	"an influence that works subtly to lighten or modify something"@en ;
	dc:source	pwn30:05869407-n .

<i67718>	a	<Concept> ;
	skos:definition	"all of something including all its component elements or parts"@en ;
	dc:source	pwn30:05869584-n .

<i67719>	a	<Concept> ;
	skos:definition	"a single undivided whole"@en ;
	dc:source	pwn30:05869857-n .

<i67720>	a	<Concept> ;
	skos:definition	"a single person or thing"@en ;
	dc:source	pwn30:05870055-n .

<i67721>	a	<Concept> ;
	skos:definition	"a whole formed by a union of two or more elements or parts"@en ;
	dc:source	pwn30:05870180-n .

<i67722>	a	<Concept> ;
	skos:definition	"a conceptual whole made up of complicated and related parts"@en ;
	dc:source	pwn30:05870365-n .

<i67723>	a	<Concept> ;
	skos:definition	"a composite of mixed origin"@en ;
	dc:source	pwn30:05870615-n .

<i67724>	a	<Concept> ;
	skos:definition	"a complex of concurrent things"@en ;
	dc:source	pwn30:05870790-n .

<i67725>	a	<Concept> ;
	skos:definition	"a rule or body of rules of conduct inherent in human nature and essential to or binding upon human society"@en ;
	dc:source	pwn30:05870916-n .

<i67726>	a	<Concept> ;
	skos:definition	"a law that is believed to come directly from God"@en ;
	dc:source	pwn30:05871140-n .

<i67727>	a	<Concept> ;
	skos:definition	"a guiding principle"@en ;
	dc:source	pwn30:05871245-n .

<i67728>	a	<Concept> ;
	skos:definition	"principles from which other truths can be derived"@en ;
	dc:source	pwn30:05871362-n .

<i67729>	a	<Concept> ;
	skos:definition	"the principles that guide reasoning within a given field or situation"@en ;
	dc:source	pwn30:05871618-n .

<i67730>	a	<Concept> ;
	skos:definition	"(psychoanalysis) the governing principle of the id; the principle that an infant seeks gratification and fails to distinguish fantasy from reality"@en ;
	dc:source	pwn30:05871792-n .

<i67731>	a	<Concept> ;
	skos:definition	"(psychoanalysis) the governing principle of the ego; the principle that as a child grows it becomes aware of the real environment and the need to accommodate to it"@en ;
	dc:source	pwn30:05872098-n .

<i67732>	a	<Concept> ;
	skos:definition	"the principle of revolt against constituted authority"@en ;
	dc:source	pwn30:05872362-n .

<i67733>	a	<Concept> ;
	skos:definition	"a basic truth or law or assumption"@en ;
	dc:source	pwn30:05872477-n .

<i67734>	a	<Concept> ;
	skos:definition	"the elementary stages of any subject (usually plural)"@en ;
	dc:source	pwn30:05872742-n .

<i67735>	a	<Concept> ;
	skos:definition	"a generalization that describes recurring facts or events in nature"@en ;
	dc:source	pwn30:05872982-n .

<i67736>	a	<Concept> ;
	skos:definition	"a concept that is expressed by a word (in some particular language)"@en ;
	dc:source	pwn30:05873884-n .

<i67737>	a	<Concept> ;
	skos:definition	"(neurophysiology) a nerve impulse resulting from a weak stimulus is just as strong as a nerve impulse resulting from a strong stimulus"@en ;
	dc:source	pwn30:05874017-n .

<i67738>	a	<Concept> ;
	skos:definition	"a rule or law concerning a natural phenomenon or the function of a complex system"@en ;
	dc:source	pwn30:05874232-n .

<i67739>	a	<Concept> ;
	skos:definition	"(hydrostatics) the apparent loss in weight of a body immersed in a fluid is equal to the weight of the displaced fluid"@en ;
	dc:source	pwn30:05874716-n .

<i67740>	a	<Concept> ;
	skos:definition	"the principle that equal volumes of all gases (given the same temperature and pressure) contain equal numbers of molecules"@en ;
	dc:source	pwn30:05874941-n .

<i67741>	a	<Concept> ;
	skos:definition	"(statistics) law stating that a large number of items taken at random from a population will (on the average) have the population statistics"@en ;
	dc:source	pwn30:05875148-n .

<i67742>	a	<Concept> ;
	skos:definition	"a law used by auditors to identify fictitious populations of numbers; applies to any population of numbers derived from other numbers"@en ;
	dc:source	pwn30:05875392-n .

<i67743>	a	<Concept> ;
	skos:definition	"(physics) statistical law obeyed by a system of particles whose wave function is not changed when two particles are interchanged (the Pauli exclusion principle does not apply)"@en ;
	dc:source	pwn30:05875723-n .

<i67744>	a	<Concept> ;
	skos:definition	"the pressure of an ideal gas at constant temperature varies inversely with the volume"@en ;
	dc:source	pwn30:05875988-n .

<i67745>	a	<Concept> ;
	skos:definition	"a fundamental principle of electrostatics; the force of attraction or repulsion between two charged particles is directly proportional to the product of the charges and inversely proportional to the distance between them; principle also holds for magnetic poles"@en ;
	dc:source	pwn30:05876148-n .

<i67746>	a	<Concept> ;
	skos:definition	"(chemistry and physics) law stating that the pressure exerted by a mixture of gases equals the sum of the partial pressures of the gases in the mixture; the pressure of a gas in a mixture equals the pressure it would exert if it occupied the same volume alone at the same temperature"@en ;
	dc:source	pwn30:05876469-n .

<i67747>	a	<Concept> ;
	skos:definition	"(chemistry) the total energy in an assembly of molecules is not distributed equally but is distributed around an average value according to a statistical distribution"@en ;
	dc:source	pwn30:05876912-n .

<i67748>	a	<Concept> ;
	skos:definition	"(physics) a law expressing the distribution of energy among the molecules of a gas in thermal equilibrium"@en ;
	dc:source	pwn30:05877178-n .

<i67749>	a	<Concept> ;
	skos:definition	"(chemistry) the principle that (at chemical equilibrium) in a reversible reaction the ratio of the rate of the forward reaction to the rate of the reverse reaction is a constant for that reaction"@en ;
	dc:source	pwn30:05877412-n .

<i67750>	a	<Concept> ;
	skos:definition	"(psychophysics) the concept that the magnitude of a subjective sensation increases proportional to the logarithm of the stimulus intensity; based on early work by E. H. Weber"@en ;
	dc:source	pwn30:05877718-n .

<i67751>	a	<Concept> ;
	skos:definition	"(physics) law obeyed by a systems of particles whose wave function changes when two particles are interchanged (the Pauli exclusion principle applies)"@en ;
	dc:source	pwn30:05877991-n .

<i67752>	a	<Concept> ;
	skos:definition	"(physics) the density of an ideal gas at constant pressure varies inversely with the temperature"@en ;
	dc:source	pwn30:05878229-n .

<i67753>	a	<Concept> ;
	skos:definition	"a principle of Gestalt psychology that identifies factors leading to particular forms of perceptual organization"@en ;
	dc:source	pwn30:05878440-n .

<i67754>	a	<Concept> ;
	skos:definition	"(chemistry) law formulated by the English chemist William Henry; the amount of a gas that will be absorbed by water increases as the gas pressure increases"@en ;
	dc:source	pwn30:05878771-n .

<i67755>	a	<Concept> ;
	skos:definition	"(physics) the principle that (within the elastic limit) the stress applied to a solid is proportional to the strain produced"@en ;
	dc:source	pwn30:05879003-n .

<i67756>	a	<Concept> ;
	skos:definition	"(astronomy) the generalization that the speed of recession of distant galaxies (the red shift) is proportional to their distance from the observer"@en ;
	dc:source	pwn30:05879204-n .

<i67757>	a	<Concept> ;
	skos:definition	"(astronomy) one of three empirical laws of planetary motion stated by Johannes Kepler"@en ;
	dc:source	pwn30:05879441-n .

<i67758>	a	<Concept> ;
	skos:definition	"a law stating that the orbit of each planet is an ellipse with the sun at one focus of the ellipse"@en ;
	dc:source	pwn30:05879693-n .

<i67759>	a	<Concept> ;
	skos:definition	"a law concerning the speed at which planets travel; a line connecting a planet to the sun will sweep out equal areas in equal times"@en ;
	dc:source	pwn30:05879856-n .

<i67760>	a	<Concept> ;
	skos:definition	"a law stating that the ratio of the square of the revolutionary period (in years) to the cube of the orbital axis (in astronomical units) is the same for all planets"@en ;
	dc:source	pwn30:05880187-n .

<i67761>	a	<Concept> ;
	skos:definition	"(physics) two laws governing electric networks in which steady currents flow: the sum of all the currents at a point is zero and the sum of the voltage gains and drops around any closed circuit is zero"@en ;
	dc:source	pwn30:05880432-n .

<i67762>	a	<Concept> ;
	skos:definition	"a law affirming that in the long run probabilities will determine performance"@en ;
	dc:source	pwn30:05880715-n .

<i67763>	a	<Concept> ;
	skos:definition	"(chemistry) law stating that every pure substance always contains the same elements combined in the same proportions by weight"@en ;
	dc:source	pwn30:05880854-n .

<i67764>	a	<Concept> ;
	skos:definition	"a law affirming that to continue after a certain level of performance has been reached will result in a decline in effectiveness"@en ;
	dc:source	pwn30:05881102-n .

<i67765>	a	<Concept> ;
	skos:definition	"(psychology) the principle that behaviors are selected by their consequences; behavior having good consequences tends to be repeated whereas behavior that leads to bad consequences is not repeated"@en ;
	dc:source	pwn30:05881303-n .

<i67766>	a	<Concept> ;
	skos:definition	"(chemistry) law stating that the proportions in which two elements separately combine with a third element are also the proportions in which they combine together"@en ;
	dc:source	pwn30:05881578-n .

<i67767>	a	<Concept> ;
	skos:definition	"(physics) the law that states any two bodies attract each other with a force that is directly proportional to the product of their masses and inversely proportional to the square of the distance between them"@en ;
	dc:source	pwn30:05881867-n .

<i67768>	a	<Concept> ;
	skos:definition	"(chemistry) law stating that when two elements can combine to form more than one compound the amounts of one of them that combines with a fixed amount of the other will exhibit a simple multiple relation"@en ;
	dc:source	pwn30:05882226-n .

<i67769>	a	<Concept> ;
	skos:definition	"(chemistry) the law that states the following principle: the rate of a chemical reaction is directly proportional to the molecular concentrations of the reacting substances"@en ;
	dc:source	pwn30:05882537-n .

<i67770>	a	<Concept> ;
	skos:definition	"(physics) a law governing the relations between states of energy in a closed system"@en ;
	dc:source	pwn30:05882793-n .

<i67771>	a	<Concept> ;
	skos:definition	"a law stating that mechanical work can be derived from a body only when that body interacts with another at a lower temperature; any spontaneous process results in an increase of entropy"@en ;
	dc:source	pwn30:05883035-n .

<i67772>	a	<Concept> ;
	skos:definition	"law stating that the entropy of a substance approaches zero as its temperature approaches absolute zero"@en ;
	dc:source	pwn30:05883296-n .

<i67773>	a	<Concept> ;
	skos:definition	"the law that if two bodies are in thermal equilibrium with a third body then the first two bodies are in thermal equilibrium with each other"@en ;
	dc:source	pwn30:05883473-n .

<i67774>	a	<Concept> ;
	skos:definition	"the principle that if any change is imposed on a system that is in equilibrium then the system tends to adjust to a new equilibrium counteracting the change"@en ;
	dc:source	pwn30:05883688-n .

<i67775>	a	<Concept> ;
	skos:definition	"(economics) the principle that when two kinds of money having the same denominational value are in circulation the intrinsically more valuable money will be hoarded and the money of lower intrinsic value will circulate more freely until the intrinsically more valuable money is driven out of circulation; bad money drives out good; credited to Sir Thomas Gresham"@en ;
	dc:source	pwn30:05883992-n .

<i67776>	a	<Concept> ;
	skos:definition	"(genetics) one of two principles of heredity formulated by Gregor Mendel on the basis of his experiments with plants; the principles were limited and modified by subsequent genetic research"@en ;
	dc:source	pwn30:05884433-n .

<i67777>	a	<Concept> ;
	skos:definition	"members of a pair of homologous chromosomes separate during the formation of gametes and are distributed to different gametes so that every gamete receives only one member of the pair"@en ;
	dc:source	pwn30:05884736-n .

<i67778>	a	<Concept> ;
	skos:definition	"each member of a pair of homologous chromosomes separates independently of the members of other pairs so the results are random"@en ;
	dc:source	pwn30:05884984-n .

<i67779>	a	<Concept> ;
	skos:definition	"(physics) the principle that a measured quantity of mass is equivalent (according to relativity theory) to a measured quantity of energy"@en ;
	dc:source	pwn30:05885187-n .

<i67780>	a	<Concept> ;
	skos:definition	"rule for calculating an expected delivery date; subtract three months from the first day of the last menstrual period and add seven days to that date"@en ;
	dc:source	pwn30:05885412-n .

<i67781>	a	<Concept> ;
	skos:definition	"one of three basic laws of classical mechanics"@en ;
	dc:source	pwn30:05885622-n .

<i67782>	a	<Concept> ;
	skos:definition	"a body remains at rest or in motion with a constant velocity unless acted upon by an external force"@en ;
	dc:source	pwn30:05885822-n .

<i67783>	a	<Concept> ;
	skos:definition	"the rate of change of momentum is proportional to the imposed force and goes in the direction of the force"@en ;
	dc:source	pwn30:05886039-n .

<i67784>	a	<Concept> ;
	skos:definition	"action and reaction are equal and opposite"@en ;
	dc:source	pwn30:05886266-n .

<i67785>	a	<Concept> ;
	skos:definition	"electric current is directly proportional to voltage and inversely proportional to resistance; I = E/R"@en ;
	dc:source	pwn30:05886455-n .

<i67786>	a	<Concept> ;
	skos:definition	"pressure applied anywhere to a body of fluid causes a force to be transmitted equally in all directions; the force acts at right angles to any surface in contact with the fluid"@en ;
	dc:source	pwn30:05886613-n .

<i67787>	a	<Concept> ;
	skos:definition	"no two electrons or protons or neutrons in a given system can be in states characterized by the same set of quantum numbers"@en ;
	dc:source	pwn30:05886939-n .

<i67788>	a	<Concept> ;
	skos:definition	"(chemistry) the principle that chemical properties of the elements are periodic functions of their atomic numbers"@en ;
	dc:source	pwn30:05887156-n .

<i67789>	a	<Concept> ;
	skos:definition	"(physics) the basis of quantum theory; the energy of electromagnetic waves is contained in indivisible quanta that have to be radiated or absorbed as a whole; the magnitude is proportional to frequency where the constant of proportionality is given by Planck's constant"@en ;
	dc:source	pwn30:05887365-n .

<i67790>	a	<Concept> ;
	skos:definition	"(physics) an equation that expresses the distribution of energy in the radiated spectrum of an ideal black body"@en ;
	dc:source	pwn30:05887712-n .

<i67791>	a	<Concept> ;
	skos:definition	"(cosmology) the theory that the universe originated sometime between 10 billion and 20 billion years ago from the cataclysmic explosion of a small volume of matter at extremely high density and temperature"@en ;
	dc:source	pwn30:05887911-n .

<i67792>	a	<Concept> ;
	skos:definition	"(cosmology) the theory that the solar system evolved from a hot gaseous nebula"@en ;
	dc:source	pwn30:05888215-n .

<i67793>	a	<Concept> ;
	skos:definition	"(cosmology) the theory that the solar system was formed by the gravitational accumulation of planetesimals"@en ;
	dc:source	pwn30:05888377-n .

<i67794>	a	<Concept> ;
	skos:definition	"(cosmology) the theory that the universe maintains a constant average density with matter created to fill the void left by galaxies that are receding from each other"@en ;
	dc:source	pwn30:05888572-n .

<i67795>	a	<Concept> ;
	skos:definition	"a tentative insight into the natural world; a concept that is not yet verified but that if true would explain certain facts or phenomena"@en ;
	dc:source	pwn30:05888929-n .

<i67796>	a	<Concept> ;
	skos:definition	"a hypothetical possibility, circumstance, statement, proposal, situation, etc."@en ;
	dc:source	pwn30:05889575-n .

<i67797>	a	<Concept> ;
	skos:definition	"the physically discrete element that Darwin proposed as responsible for heredity"@en ;
	dc:source	pwn30:05889762-n .

<i67798>	a	<Concept> ;
	skos:definition	"a concept whose truth can be proved"@en ;
	dc:source	pwn30:05889896-n .

<i67799>	a	<Concept> ;
	skos:definition	"a theoretical sun that moves along the celestial equator at a constant speed and completes its annual course in the same amount of time the real sun takes at variable speeds"@en ;
	dc:source	pwn30:05890021-n .

<i67800>	a	<Concept> ;
	skos:definition	"a hypothetical description of a complex entity or process"@en ;
	dc:source	pwn30:05890249-n .

<i67801>	a	<Concept> ;
	skos:definition	"(astronomy) Copernicus' astronomical model in which the Earth rotates around the sun"@en ;
	dc:source	pwn30:05890642-n .

<i67802>	a	<Concept> ;
	skos:definition	"(astronomy) Ptolemy's model of the universe with the Earth at the center"@en ;
	dc:source	pwn30:05890809-n .

<i67803>	a	<Concept> ;
	skos:definition	"(particle physics) a theory that involves an eleven-dimensional universe in which the weak and strong forces and gravity are unified and to which all the string theories belong"@en ;
	dc:source	pwn30:05890963-n .

<i67804>	a	<Concept> ;
	skos:definition	"(particle physics) a theory that postulates that subatomic particles are one-dimensional strings"@en ;
	dc:source	pwn30:05891232-n .

<i67805>	a	<Concept> ;
	skos:definition	"a listing of audit procedures to be performed in completing an audit"@en ;
	dc:source	pwn30:05891426-n .

<i67806>	a	<Concept> ;
	skos:definition	"a schematic or preliminary plan"@en ;
	dc:source	pwn30:05891572-n .

<i67807>	a	<Concept> ;
	skos:definition	"a hypothesis that has been formed by speculating or conjecturing (usually with little hard evidence)"@en ;
	dc:source	pwn30:05891783-n .

<i67808>	a	<Concept> ;
	skos:definition	"a hypothesis that is taken for granted"@en ;
	dc:source	pwn30:05892096-n .

<i67809>	a	<Concept> ;
	skos:definition	"something that is required in advance"@en ;
	dc:source	pwn30:05892427-n .

<i67810>	a	<Concept> ;
	skos:definition	"required activity"@en ;
	dc:source	pwn30:05892651-n .

<i67811>	a	<Concept> ;
	skos:definition	"a condition that is a prerequisite"@en ;
	dc:source	pwn30:05892880-n .

<i67812>	a	<Concept> ;
	skos:definition	"a requirement for admission to or completion of an academic program"@en ;
	dc:source	pwn30:05892991-n .

<i67813>	a	<Concept> ;
	skos:definition	"a requirement that a student know certain languages"@en ;
	dc:source	pwn30:05893143-n .

<i67814>	a	<Concept> ;
	skos:definition	"a prerequisite"@en ;
	dc:source	pwn30:05893261-n .

<i67815>	a	<Concept> ;
	skos:definition	"an assumption that is taken for granted"@en ;
	dc:source	pwn30:05893356-n .

<i67816>	a	<Concept> ;
	skos:definition	"an assumption that is basic to an argument"@en ;
	dc:source	pwn30:05893512-n .

<i67817>	a	<Concept> ;
	skos:definition	"an incorrect conception"@en ;
	dc:source	pwn30:05893653-n .

<i67818>	a	<Concept> ;
	skos:definition	"a misconception resulting from incorrect reasoning"@en ;
	dc:source	pwn30:05893916-n .

<i67819>	a	<Concept> ;
	skos:definition	"a fallacy in logical argumentation"@en ;
	dc:source	pwn30:05894143-n .

<i67820>	a	<Concept> ;
	skos:definition	"the logical fallacy of using as a true premise a proposition that is yet to be proved"@en ;
	dc:source	pwn30:05894311-n .

<i67821>	a	<Concept> ;
	skos:definition	"the logical fallacy of supposing that an argument proving an irrelevant point has proved the point at issue"@en ;
	dc:source	pwn30:05894460-n .

<i67822>	a	<Concept> ;
	skos:definition	"the fallacy of attributing human feelings to inanimate objects; `the friendly sun' is an example of the pathetic fallacy"@en ;
	dc:source	pwn30:05894631-n .

<i67823>	a	<Concept> ;
	skos:definition	"the logical fallacy of assuming the conclusion in the premises; begging the question"@en ;
	dc:source	pwn30:05894814-n .

<i67824>	a	<Concept> ;
	skos:definition	"the logical fallacy of believing that temporal succession implies a causal relation"@en ;
	dc:source	pwn30:05894972-n .

<i67825>	a	<Concept> ;
