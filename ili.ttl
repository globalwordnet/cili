	dc:source	pwn30:01315330-n .

<i42257>	a	<Concept> ;
	skos:definition	"an animal whose body temperature varies with the temperature of its surroundings; any animal except birds and mammals"@en ;
	dc:source	pwn30:01315581-n .

<i42258>	a	<Concept> ;
	skos:definition	"any animal that lives and grazes in the grassy open land of western North America (especially horses, cattle, sheep)"@en ;
	dc:source	pwn30:01315805-n .

<i42259>	a	<Concept> ;
	skos:definition	"any of various small animals or insects that are pests; e.g. cockroaches or rats"@en ;
	dc:source	pwn30:01315980-n .

<i42260>	a	<Concept> ;
	skos:definition	"any usually predatory wild animal considered undesirable; e.g., coyote"@en ;
	dc:source	pwn30:01316288-n .

<i42261>	a	<Concept> ;
	skos:definition	"any animal that feeds on refuse and other decaying organic matter"@en ;
	dc:source	pwn30:01316422-n .

<i42262>	a	<Concept> ;
	skos:definition	"a fish that lives and feeds on the bottom of a body of water"@en ;
	dc:source	pwn30:01316579-n .

<i42263>	a	<Concept> ;
	skos:definition	"a scavenger that feeds low on the food chain"@en ;
	dc:source	pwn30:01316734-n .

<i42264>	a	<Concept> ;
	skos:definition	"a fish that lurks on the bottom of a body of water"@en ;
	dc:source	pwn30:01316838-n .

<i42265>	a	<Concept> ;
	skos:definition	"an animal trained for and used for heavy labor"@en ;
	dc:source	pwn30:01316949-n .

<i42266>	a	<Concept> ;
	skos:definition	"an animal such as a donkey or ox or elephant used for transporting loads or doing other heavy work"@en ;
	dc:source	pwn30:01317089-n .

<i42267>	a	<Concept> ;
	skos:definition	"an animal used for pulling heavy loads"@en ;
	dc:source	pwn30:01317294-n .

<i42268>	a	<Concept> ;
	skos:definition	"an animal (such as a mule or burro or horse) used to carry loads"@en ;
	dc:source	pwn30:01317391-n .

<i42269>	a	<Concept> ;
	skos:definition	"any of various animals that have been tamed and made fit for a human environment"@en ;
	dc:source	pwn30:01317541-n .

<i42270>	a	<Concept> ;
	skos:definition	"an animal being fattened or suitable for fattening"@en ;
	dc:source	pwn30:01317813-n .

<i42271>	a	<Concept> ;
	skos:definition	"an animal that feeds on a particular source of food"@en ;
	dc:source	pwn30:01317916-n .

<i42272>	a	<Concept> ;
	skos:definition	"a domestic animal (especially a young steer or heifer) kept as stock until fattened or matured and suitable for a breeding establishment"@en ;
	dc:source	pwn30:01318053-n .

<i42273>	a	<Concept> ;
	skos:definition	"any recently hatched animal (especially birds)"@en ;
	dc:source	pwn30:01318279-n .

<i42274>	a	<Concept> ;
	skos:definition	"a single domestic animal"@en ;
	dc:source	pwn30:01318381-n .

<i42275>	a	<Concept> ;
	skos:definition	"an animal (especially birds and fish) that travels between different habitats at particular times of the year"@en ;
	dc:source	pwn30:01318478-n .

<i42276>	a	<Concept> ;
	skos:definition	"an animal (especially birds and arthropods and reptiles) that periodically shed their outer layer (feathers or cuticle or skin or hair)"@en ;
	dc:source	pwn30:01318660-n .

<i42277>	a	<Concept> ;
	skos:definition	"a domesticated animal kept for companionship or amusement"@en ;
	dc:source	pwn30:01318894-n .

<i42278>	a	<Concept> ;
	skos:definition	"a person or other animal having powers of endurance or perseverance"@en ;
	dc:source	pwn30:01319001-n .

<i42279>	a	<Concept> ;
	skos:definition	"a creature (especially a whale) that has been prevented from attaining full growth"@en ;
	dc:source	pwn30:01319187-n .

<i42280>	a	<Concept> ;
	skos:definition	"a usually horned animal that has either shed its horns or had them removed"@en ;
	dc:source	pwn30:01319339-n .

<i42281>	a	<Concept> ;
	skos:definition	"any of numerous animals inhabiting the sea including e.g. fishes and molluscs and many mammals"@en ;
	dc:source	pwn30:01319467-n .

<i42282>	a	<Concept> ;
	skos:definition	"unwanted marine creatures that are caught in the nets while fishing for another species"@en ;
	dc:source	pwn30:01319685-n .

<i42283>	a	<Concept> ;
	skos:definition	"(genetics) an organism or cell having a diploid set of chromosomes from each parent"@en ;
	dc:source	pwn30:01319932-n .

<i42284>	a	<Concept> ;
	skos:definition	"(genetics) an organism or cell having the normal amount of DNA per cell; i.e., two sets of chromosomes or twice the haploid number"@en ;
	dc:source	pwn30:01320093-n .

<i42285>	a	<Concept> ;
	skos:definition	"(genetics) an organism or cell having only one complete set of chromosomes"@en ;
	dc:source	pwn30:01320314-n .

<i42286>	a	<Concept> ;
	skos:definition	"(genetics) an organism or cell having a chromosome number that is not an even multiple of the haploid chromosome number for that species"@en ;
	dc:source	pwn30:01320479-n .

<i42287>	a	<Concept> ;
	skos:definition	"(genetics) an organism or cell having more than twice the haploid number of chromosomes"@en ;
	dc:source	pwn30:01320692-n .

<i42288>	a	<Concept> ;
	skos:definition	"an animal that produces gametes (ova) that can be fertilized by male gametes (spermatozoa)"@en ;
	dc:source	pwn30:01320872-n .

<i42289>	a	<Concept> ;
	skos:definition	"female of certain aquatic animals e.g. octopus or lobster"@en ;
	dc:source	pwn30:01321123-n .

<i42290>	a	<Concept> ;
	skos:definition	"an animal that produces gametes (spermatozoa) that can fertilize female gametes (ova)"@en ;
	dc:source	pwn30:01321230-n .

<i42291>	a	<Concept> ;
	skos:definition	"any mature animal"@en ;
	dc:source	pwn30:01321456-n .

<i42292>	a	<Concept> ;
	skos:definition	"any immature animal"@en ;
	dc:source	pwn30:01321579-n .

<i42293>	a	<Concept> ;
	skos:definition	"a young animal without a mother"@en ;
	dc:source	pwn30:01321770-n .

<i42294>	a	<Concept> ;
	skos:definition	"any immature mammal"@en ;
	dc:source	pwn30:01321854-n .

<i42295>	a	<Concept> ;
	skos:definition	"a very young mammal"@en ;
	dc:source	pwn30:01322221-n .

<i42296>	a	<Concept> ;
	skos:definition	"young of any of various canines such as a dog or wolf"@en ;
	dc:source	pwn30:01322343-n .

<i42297>	a	<Concept> ;
	skos:definition	"a young wolf"@en ;
	dc:source	pwn30:01322508-n .

<i42298>	a	<Concept> ;
	skos:definition	"a young dog"@en ;
	dc:source	pwn30:01322604-n .

<i42299>	a	<Concept> ;
	skos:definition	"the young of certain carnivorous mammals such as the bear or wolf or lion"@en ;
	dc:source	pwn30:01322685-n .

<i42300>	a	<Concept> ;
	skos:definition	"a young lion"@en ;
	dc:source	pwn30:01322898-n .

<i42301>	a	<Concept> ;
	skos:definition	"a young bear"@en ;
	dc:source	pwn30:01322983-n .

<i42302>	a	<Concept> ;
	skos:definition	"a young tiger"@en ;
	dc:source	pwn30:01323068-n .

<i42303>	a	<Concept> ;
	skos:definition	"young of any of various fur-bearing animals"@en ;
	dc:source	pwn30:01323155-n .

<i42304>	a	<Concept> ;
	skos:definition	"a young mammal that has not been weaned"@en ;
	dc:source	pwn30:01323261-n .

<i42305>	a	<Concept> ;
	skos:definition	"male parent of an animal especially a domestic animal such as a horse"@en ;
	dc:source	pwn30:01323355-n .

<i42306>	a	<Concept> ;
	skos:definition	"female parent of an animal especially domestic livestock"@en ;
	dc:source	pwn30:01323493-n .

<i42307>	a	<Concept> ;
	skos:definition	"a pedigreed animal of unmixed lineage; used especially of horses"@en ;
	dc:source	pwn30:01323599-n .

<i42308>	a	<Concept> ;
	skos:definition	"any creature of exceptional size"@en ;
	dc:source	pwn30:01323781-n .

<i42309>	a	<Concept> ;
	skos:definition	"external opening of urinary or genital system of a lower vertebrate"@en ;
	dc:source	pwn30:01323901-n .

<i42310>	a	<Concept> ;
	skos:definition	"microscopic organism such as an amoeba or paramecium"@en ;
	dc:source	pwn30:01324019-n .

<i42311>	a	<Concept> ;
	skos:definition	"an animal that survives in spite of adversity"@en ;
	dc:source	pwn30:01324142-n .

<i42312>	a	<Concept> ;
	skos:definition	"an animal that has undergone mutation"@en ;
	dc:source	pwn30:01324305-n .

<i42313>	a	<Concept> ;
	skos:definition	"any animal that feeds on flesh"@en ;
	dc:source	pwn30:01324431-n .

<i42314>	a	<Concept> ;
	skos:definition	"any animal that feeds chiefly on grass and other plants"@en ;
	dc:source	pwn30:01324610-n .

<i42315>	a	<Concept> ;
	skos:definition	"any organism that feeds mainly on insects"@en ;
	dc:source	pwn30:01324799-n .

<i42316>	a	<Concept> ;
	skos:definition	"an animal having teeth consolidated with the summit of the alveolar ridge without sockets"@en ;
	dc:source	pwn30:01324916-n .

<i42317>	a	<Concept> ;
	skos:definition	"an animal having teeth fused with the inner surface of the alveolar ridge without sockets"@en ;
	dc:source	pwn30:01325060-n .

<i42318>	a	<Concept> ;
	skos:definition	"an artificial taxonomic category established on the basis of morphological resemblance for organisms of obscure true relationships especially fossil forms"@en ;
	dc:source	pwn30:01325206-n .

<i42319>	a	<Concept> ;
	skos:definition	"one of the bony outgrowths on the heads of certain ungulates"@en ;
	dc:source	pwn30:01325417-n .

<i42320>	a	<Concept> ;
	skos:definition	"deciduous horn of a member of the deer family"@en ;
	dc:source	pwn30:01325658-n .

<i42321>	a	<Concept> ;
	skos:definition	"a bunch of feathers or hair"@en ;
	dc:source	pwn30:01325775-n .

<i42322>	a	<Concept> ;
	skos:definition	"any hard protuberance from the head of an organism that is similar to or suggestive of a horn"@en ;
	dc:source	pwn30:01325853-n .

<i42323>	a	<Concept> ;
	skos:definition	"a showy growth of e.g. feathers or skin on the head of a bird or other animal"@en ;
	dc:source	pwn30:01326015-n .

<i42324>	a	<Concept> ;
	skos:definition	"showy crest or knot of hair or feathers"@en ;
	dc:source	pwn30:01326198-n .

<i42325>	a	<Concept> ;
	skos:definition	"any organism of microscopic size"@en ;
	dc:source	pwn30:01326291-n .

<i42326>	a	<Concept> ;
	skos:definition	"(biology) a single-celled microorganism (especially a flagellate protozoan)"@en ;
	dc:source	pwn30:01326751-n .

<i42327>	a	<Concept> ;
	skos:definition	"an organism (especially a bacterium) that requires air or free oxygen for life"@en ;
	dc:source	pwn30:01326897-n .

<i42328>	a	<Concept> ;
	skos:definition	"an organism (especially a bacterium) that does not require air or free oxygen to live"@en ;
	dc:source	pwn30:01327028-n .

<i42329>	a	<Concept> ;
	skos:definition	"an organism that cannot grow in the presence of oxygen"@en ;
	dc:source	pwn30:01327204-n .

<i42330>	a	<Concept> ;
	skos:definition	"(genetics) an organism that is the offspring of genetically dissimilar parents or stock; especially offspring produced by breeding plants or animals of different varieties or breeds or species"@en ;
	dc:source	pwn30:01327322-n .

<i42331>	a	<Concept> ;
	skos:definition	"a hybrid produced by parents that differ only at two gene loci that have two alleles each"@en ;
	dc:source	pwn30:01327765-n .

<i42332>	a	<Concept> ;
	skos:definition	"a hybrid produced by crossing parents that are homozygous except for a single gene locus that has two alleles (as in Mendel's experiments with garden peas)"@en ;
	dc:source	pwn30:01327909-n .

<i42333>	a	<Concept> ;
	skos:definition	"an organism that can assume more than one adult form as in the castes of ants or termites"@en ;
	dc:source	pwn30:01328121-n .

<i42334>	a	<Concept> ;
	skos:definition	"an animal or plant that bears a relationship to another (as related by common descent or by membership in the same genus)"@en ;
	dc:source	pwn30:01328302-n .

<i42335>	a	<Concept> ;
	skos:definition	"harmless microorganisms (as Escherichia coli) that inhabit the intestinal tract and are essential for its normal functioning"@en ;
	dc:source	pwn30:01328515-n .

<i42336>	a	<Concept> ;
	skos:definition	"(virology) ultramicroscopic infectious agent that replicates itself only within cells of living hosts; many are pathogenic; a piece of nucleic acid (DNA or RNA) wrapped in a thin coat of protein"@en ;
	dc:source	pwn30:01328702-n .

<i42337>	a	<Concept> ;
	skos:definition	"a large heterogeneous group of RNA viruses divisible into groups on the basis of the virions; they have been recovered from arthropods, bats, and rodents; most are borne by arthropods; they are linked by the epidemiologic concept of transmission between vertebrate hosts by arthropod vectors (mosquitoes, ticks, sandflies, midges, etc.) that feed on blood; they can cause mild fevers, hepatitis, hemorrhagic fever, and encephalitis"@en ;
	dc:source	pwn30:01329186-n .

<i42338>	a	<Concept> ;
	skos:definition	"the outer covering of protein surrounding the nucleic acid of a virus"@en ;
	dc:source	pwn30:01329794-n .

<i42339>	a	<Concept> ;
	skos:definition	"(virology) a complete viral particle; nucleic acid and capsid (and a lipid envelope in some viruses)"@en ;
	dc:source	pwn30:01329935-n .

<i42340>	a	<Concept> ;
	skos:definition	"any of a group of viruses including those that in humans cause upper respiratory infections or infectious pinkeye"@en ;
	dc:source	pwn30:01330126-n .

<i42341>	a	<Concept> ;
	skos:definition	"a virus that causes upper respiratory infection (including the common cold and bronchiolitis); most often in children"@en ;
	dc:source	pwn30:01330314-n .

<i42342>	a	<Concept> ;
	skos:definition	"animal viruses belonging to the family Arenaviridae"@en ;
	dc:source	pwn30:01330497-n .

<i42343>	a	<Concept> ;
	skos:definition	"the RNA virus that causes Argentine hemorrhagic fever; carried by rats and mice"@en ;
	dc:source	pwn30:01330696-n .

<i42344>	a	<Concept> ;
	skos:definition	"the RNA virus that causes Lassa fever"@en ;
	dc:source	pwn30:01330852-n .

<i42345>	a	<Concept> ;
	skos:definition	"the RNA virus that causes lymphocytic choriomeningitis; infects mice and monkeys and dogs and guinea pigs and human beings"@en ;
	dc:source	pwn30:01330966-n .

<i42346>	a	<Concept> ;
	skos:definition	"the RNA virus that causes Bolivian hemorrhagic fever; carried by rats and mice"@en ;
	dc:source	pwn30:01331188-n .

<i42347>	a	<Concept> ;
	skos:definition	"a large family of arboviruses that affect a wide range of hosts (mainly vertebrates and arthropods)"@en ;
	dc:source	pwn30:01331345-n .

<i42348>	a	<Concept> ;
	skos:definition	"an animal virus belonging to the family Bunyaviridae; can be used as a bioweapon"@en ;
	dc:source	pwn30:01331522-n .

<i42349>	a	<Concept> ;
	skos:definition	"a family of threadlike RNA viruses that cause diseases in humans and nonhuman primates (monkeys and chimpanzees)"@en ;
	dc:source	pwn30:01331659-n .

<i42350>	a	<Concept> ;
	skos:definition	"animal viruses belonging to the family Filoviridae"@en ;
	dc:source	pwn30:01331867-n .

<i42351>	a	<Concept> ;
	skos:definition	"a filovirus that causes Ebola hemorrhagic fever; carried by animals; can be used as a bioweapon"@en ;
	dc:source	pwn30:01332009-n .

<i42352>	a	<Concept> ;
	skos:definition	"a filovirus that causes Marburg disease; carried by animals; can be used as a bioweapon"@en ;
	dc:source	pwn30:01332181-n .

<i42353>	a	<Concept> ;
	skos:definition	"a family of arboviruses carried by arthropods"@en ;
	dc:source	pwn30:01332347-n .

<i42354>	a	<Concept> ;
	skos:definition	"an arbovirus of the family Togaviridae that can cause a variety of encephalitis in horses"@en ;
	dc:source	pwn30:01332488-n .

<i42355>	a	<Concept> ;
	skos:definition	"a family of arboviruses carried by arthropods"@en ;
	dc:source	pwn30:01332653-n .

<i42356>	a	<Concept> ;
	skos:definition	"animal viruses belonging to the family Flaviviridae"@en ;
	dc:source	pwn30:01332795-n .

<i42357>	a	<Concept> ;
	skos:definition	"the flavivirus that causes West Nile encephalitis"@en ;
	dc:source	pwn30:01332940-n .

<i42358>	a	<Concept> ;
	skos:definition	"a family of arborviruses carried by arthropods"@en ;
	dc:source	pwn30:01333082-n .

<i42359>	a	<Concept> ;
	skos:definition	"a family of arborviruses carried by arthropods"@en ;
	dc:source	pwn30:01333301-n .

<i42360>	a	<Concept> ;
	skos:definition	"an animal virus that causes vesicular stomatitis"@en ;
	dc:source	pwn30:01333483-n .

<i42361>	a	<Concept> ;
	skos:definition	"a family of arboviruses carried by arthropods"@en ;
	dc:source	pwn30:01333610-n .

<i42362>	a	<Concept> ;
	skos:definition	"any of a group of viruses that can cause pox diseases in vertebrates"@en ;
	dc:source	pwn30:01333731-n .

<i42363>	a	<Concept> ;
	skos:definition	"a poxvirus closely related to smallpox virus; causes benign gelatinous tumors in humans"@en ;
	dc:source	pwn30:01333890-n .

<i42364>	a	<Concept> ;
	skos:definition	"the virus that causes smallpox in humans; can be used as a bioweapon"@en ;
	dc:source	pwn30:01334036-n .

<i42365>	a	<Concept> ;
	skos:definition	"a type of smallpox virus that has a fatality rate of up to 25 percent"@en ;
	dc:source	pwn30:01334217-n .

<i42366>	a	<Concept> ;
	skos:definition	"a type of smallpox virus that has a fatality rate of about 1 percent"@en ;
	dc:source	pwn30:01334368-n .

<i42367>	a	<Concept> ;
	skos:definition	"the widely studied plant virus that causes tobacco mosaic; it was the first virus discovered (1892)"@en ;
	dc:source	pwn30:01334518-n .

<i42368>	a	<Concept> ;
	skos:definition	"the smallest of viruses; a plant virus with its RNA arranged in a circular chromosome without a protein coat"@en ;
	dc:source	pwn30:01334690-n .

<i42369>	a	<Concept> ;
	skos:definition	"a virus that is parasitic (reproduces itself) in bacteria"@en ;
	dc:source	pwn30:01334862-n .

<i42370>	a	<Concept> ;
	skos:definition	"a bacteriophage that infects the bacterium Escherichia coli"@en ;
	dc:source	pwn30:01335218-n .

<i42371>	a	<Concept> ;
	skos:definition	"a bacteriophage specific for the bacterium Salmonella typhi"@en ;
	dc:source	pwn30:01335333-n .

<i42372>	a	<Concept> ;
	skos:definition	"a plant pathogen that is a virus consisting of a single strand of RNA"@en ;
	dc:source	pwn30:01335460-n .

<i42373>	a	<Concept> ;
	skos:definition	"an animal pathogen that is a virus"@en ;
	dc:source	pwn30:01335659-n .

<i42374>	a	<Concept> ;
	skos:definition	"a group of animal DNA viruses including viruses of ducks and woodchucks and squirrels and others as well as the virus causing hepatitis B in humans"@en ;
	dc:source	pwn30:01336076-n .

<i42375>	a	<Concept> ;
	skos:definition	"any of a group of viruses that contain two single-strand linear RNA molecules per virion and reverse transcriptase (RNA to DNA); the virus transcribes its RNA into a cDNA provirus that is then incorporated into the host cell"@en ;
	dc:source	pwn30:01336282-n .

<i42376>	a	<Concept> ;
	skos:definition	"retrovirus causing T-cell leukemia"@en ;
	dc:source	pwn30:01336599-n .

<i42377>	a	<Concept> ;
	skos:definition	"the virus that causes acquired immune deficiency syndrome (AIDS); it replicates in and kills the helper T cells"@en ;
	dc:source	pwn30:01336718-n .

<i42378>	a	<Concept> ;
	skos:definition	"any of a group of RNA viruses including those that cause influenza and mumps"@en ;
	dc:source	pwn30:01336910-n .

<i42379>	a	<Concept> ;
	skos:definition	"a group of viruses including those causing influenza"@en ;
	dc:source	pwn30:01337078-n .

<i42380>	a	<Concept> ;
	skos:definition	"a group of viruses including those causing mumps and measles"@en ;
	dc:source	pwn30:01337191-n .

<i42381>	a	<Concept> ;
	skos:definition	"a paramyxovirus that forms syncytia in tissue culture and that is responsible for severe respiratory diseases such as bronchiolitis and bronchial pneumonia (especially in children)"@en ;
	dc:source	pwn30:01337329-n .

<i42382>	a	<Concept> ;
	skos:definition	"a group of single-strand RNA viruses with a protein coat"@en ;
	dc:source	pwn30:01337583-n .

<i42383>	a	<Concept> ;
	skos:definition	"the virus causing poliomyelitis"@en ;
	dc:source	pwn30:01337734-n .

<i42384>	a	<Concept> ;
	skos:definition	"the virus causing hepatitis A"@en ;
	dc:source	pwn30:01337822-n .

<i42385>	a	<Concept> ;
	skos:definition	"any of a group of picornaviruses that infect the gastrointestinal tract and can spread to other areas (especially the nervous system)"@en ;
	dc:source	pwn30:01337915-n .

<i42386>	a	<Concept> ;
	skos:definition	"enterovirus causing a disease resembling poliomyelitis but without paralysis"@en ;
	dc:source	pwn30:01338178-n .

<i42387>	a	<Concept> ;
	skos:definition	"any of a group of viruses associated with various diseases including viral meningitis and mild respiratory disorders and diarrhea in newborn infants"@en ;
	dc:source	pwn30:01338333-n .

<i42388>	a	<Concept> ;
	skos:definition	"any of a group of picornaviruses that are responsible for many upper respiratory infections"@en ;
	dc:source	pwn30:01338537-n .

<i42389>	a	<Concept> ;
	skos:definition	"any of the animal viruses that cause painful blisters on the skin"@en ;
	dc:source	pwn30:01338685-n .

<i42390>	a	<Concept> ;
	skos:definition	"a herpes virus that affects the skin and nervous system"@en ;
	dc:source	pwn30:01338908-n .

