	dc:source	pwn30:06471242-n .

<i70465>	a	<Concept> ;
	skos:definition	"a document attesting to the truth of certain stated facts"@en ;
	dc:source	pwn30:06471345-n .

<i70466>	a	<Concept> ;
	skos:definition	"a document incorporating an institution and specifying its rights; includes the articles of incorporation and the certificate of incorporation"@en ;
	dc:source	pwn30:06471737-n .

<i70467>	a	<Concept> ;
