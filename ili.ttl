	dc:source	pwn30:13816521-n .

<i109511>	a	<Concept> ;
	skos:definition	"a quantity or amount or measure considered as a proportion of another quantity or amount or measure"@en ;
	dc:source	pwn30:13816649-n .

<i109512>	a	<Concept> ;
	skos:definition	"the ratio between the size of something and a representation of it"@en ;
	dc:source	pwn30:13816862-n .

<i109513>	a	<Concept> ;
