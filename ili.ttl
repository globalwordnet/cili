	dc:source	pwn30:05556204-n .

<i66118>	a	<Concept> ;
	skos:definition	"either side of the body below the waist and above the thigh"@en ;
	dc:source	pwn30:05556325-n .

<i66119>	a	<Concept> ;
	skos:definition	"the hip and buttock and upper thigh in human beings"@en ;
	dc:source	pwn30:05556472-n .

<i66120>	a	<Concept> ;
	skos:definition	"a scar where the umbilical cord was attached"@en ;
	dc:source	pwn30:05556595-n .

<i66121>	a	<Concept> ;
	skos:definition	"the region of the body of a vertebrate between the thorax and the pelvis"@en ;
	dc:source	pwn30:05556943-n .

<i66122>	a	<Concept> ;
	skos:definition	"the muscles of the abdomen"@en ;
	dc:source	pwn30:05557339-n .

<i66123>	a	<Concept> ;
	skos:definition	"the back of the body of a vertebrate or any analogous surface (as the upper or outer surface of an organ or appendage or part)"@en ;
	dc:source	pwn30:05557500-n .

<i66124>	a	<Concept> ;
	skos:definition	"the soft belly or underside of an animal's body"@en ;
	dc:source	pwn30:05557723-n .

<i66125>	a	<Concept> ;
	skos:definition	"a diagonally arranged abdominal muscle on either side of the torso"@en ;
	dc:source	pwn30:05557839-n .

<i66126>	a	<Concept> ;
