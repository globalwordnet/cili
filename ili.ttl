<i68370>	a	<Concept> ;
	skos:definition	"one-half the major axis of an ellipse; the distance from the center of an ellipse to one end"@en ;
	dc:source	pwn30:06009685-n .

<i68371>	a	<Concept> ;
	skos:definition	"the shorter or shortest axis of an ellipse or ellipsoid"@en ;
	dc:source	pwn30:06009857-n .

<i68372>	a	<Concept> ;
	skos:definition	"one-half the minor axis of an ellipse"@en ;
	dc:source	pwn30:06009988-n .

<i68373>	a	<Concept> ;
	skos:definition	"a line that passes through the center of curvature of a lens so that light is neither reflected nor refracted"@en ;
	dc:source	pwn30:06010105-n .

<i68374>	a	<Concept> ;
	skos:definition	"in a doubly refracting crystal, the line in the direction of which no double refraction occurs"@en ;
	dc:source	pwn30:06010381-n .

<i68375>	a	<Concept> ;
	skos:definition	"a coordinate system in which Newton's first law of motion is valid"@en ;
	dc:source	pwn30:06010583-n .

<i68376>	a	<Concept> ;
	skos:definition	"the four-dimensional coordinate system (3 dimensions of space and 1 of time) in which physical events are located"@en ;
	dc:source	pwn30:06010737-n .

<i68377>	a	<Concept> ;
	skos:definition	"a number that identifies a position relative to an axis"@en ;
	dc:source	pwn30:06010930-n .

<i68378>	a	<Concept> ;
	skos:definition	"one of the coordinates in a system of coordinates that locates a point on a plane or in space by its distance from two lines or three planes respectively; the two lines or the intersections of the three planes are the coordinate axes"@en ;
	dc:source	pwn30:06011092-n .

<i68379>	a	<Concept> ;
	skos:definition	"one of three Cartesian coordinates that determine a position in space"@en ;
	dc:source	pwn30:06011446-n .

<i68380>	a	<Concept> ;
	skos:definition	"the value of a coordinate on the horizontal axis"@en ;
	dc:source	pwn30:06011589-n .

<i68381>	a	<Concept> ;
	skos:definition	"the value of a coordinate on the vertical axis"@en ;
	dc:source	pwn30:06011692-n .

<i68382>	a	<Concept> ;
	skos:definition	"the point at which a line intersects a coordinate axis"@en ;
	dc:source	pwn30:06011793-n .

<i68383>	a	<Concept> ;
	skos:definition	"either of two values that locate a point on a plane by its distance from a fixed pole and its angle from a fixed line passing through the pole"@en ;
	dc:source	pwn30:06011903-n .

<i68384>	a	<Concept> ;
	skos:definition	"the geometry of 2-dimensional figures"@en ;
	dc:source	pwn30:06012108-n .

<i68385>	a	<Concept> ;
	skos:definition	"the geometry of 3-dimensional space"@en ;
	dc:source	pwn30:06012225-n .

<i68386>	a	<Concept> ;
	skos:definition	"the geometry of properties that remain invariant under projection"@en ;
	dc:source	pwn30:06012340-n .

<i68387>	a	<Concept> ;
	skos:definition	"the mathematics of triangles and trigonometric functions"@en ;
	dc:source	pwn30:06012513-n .

<i68388>	a	<Concept> ;
	skos:definition	"the mathematics of generalized arithmetical operations"@en ;
	dc:source	pwn30:06012726-n .

<i68389>	a	<Concept> ;
	skos:definition	"a branch of algebra dealing with quadratic equations"@en ;
	dc:source	pwn30:06012998-n .

<i68390>	a	<Concept> ;
	skos:definition	"the part of algebra that deals with the theory of linear equations and linear transformation"@en ;
	dc:source	pwn30:06013126-n .

<i68391>	a	<Concept> ;
	skos:definition	"the part of algebra that deals with the theory of vectors and vector spaces"@en ;
	dc:source	pwn30:06013298-n .

<i68392>	a	<Concept> ;
	skos:definition	"the analysis of a vector field"@en ;
	dc:source	pwn30:06013471-n .

<i68393>	a	<Concept> ;
	skos:definition	"the part of algebra that deals with the theory of matrices"@en ;
	dc:source	pwn30:06013584-n .

<i68394>	a	<Concept> ;
	skos:definition	"the branch of mathematics that is concerned with limits and with the differentiation and integration of functions"@en ;
	dc:source	pwn30:06013741-n .

<i68395>	a	<Concept> ;
	skos:definition	"a branch of mathematics involving calculus and the theory of limits; sequences and series and integration and differentiation"@en ;
	dc:source	pwn30:06014043-n .

<i68396>	a	<Concept> ;
	skos:definition	"analysis of a periodic function into a sum of simple sinusoidal components"@en ;
	dc:source	pwn30:06014278-n .

<i68397>	a	<Concept> ;
	skos:definition	"the part of calculus that deals with the variation of a function with respect to changes in the independent variable (or variables) by means of the concepts of derivative and differential"@en ;
	dc:source	pwn30:06014435-n .

<i68398>	a	<Concept> ;
	skos:definition	"the result of mathematical differentiation; the instantaneous change of one quantity relative to another; df(x)/dx"@en ;
	dc:source	pwn30:06014730-n .

<i68399>	a	<Concept> ;
	skos:definition	"the derivative of a function of two or more variables with respect to a single variable while the other variables are considered to be constant"@en ;
	dc:source	pwn30:06015053-n .

<i68400>	a	<Concept> ;
	skos:definition	"the part of calculus that deals with integration and its application in the solution of differential equations and in determining areas or volumes etc."@en ;
	dc:source	pwn30:06015271-n .

<i68401>	a	<Concept> ;
	skos:definition	"the result of a mathematical integration; F(x) is the integral of f(x) if dF/dx = f(x)"@en ;
	dc:source	pwn30:06015505-n .

<i68402>	a	<Concept> ;
	skos:definition	"the set of functions F(x) + C, where C is any real number, such that F(x) is the integral of f(x)"@en ;
	dc:source	pwn30:06015700-n .

<i68403>	a	<Concept> ;
	skos:definition	"the integral of a function over a definite interval"@en ;
	dc:source	pwn30:06015863-n .

<i68404>	a	<Concept> ;
	skos:definition	"the calculus of maxima and minima of definite integrals"@en ;
	dc:source	pwn30:06015978-n .

<i68405>	a	<Concept> ;
	skos:definition	"the branch of pure mathematics that deals with the nature and relations of sets"@en ;
	dc:source	pwn30:06016121-n .

<i68406>	a	<Concept> ;
	skos:definition	"a set containing all points (or all real numbers) between two given endpoints"@en ;
	dc:source	pwn30:06016276-n .

<i68407>	a	<Concept> ;
	skos:definition	"an interval that includes its endpoints"@en ;
	dc:source	pwn30:06016462-n .

<i68408>	a	<Concept> ;
	skos:definition	"an interval that does not include its endpoints"@en ;
	dc:source	pwn30:06016600-n .

<i68409>	a	<Concept> ;
	skos:definition	"an interval that is included in another interval"@en ;
	dc:source	pwn30:06016746-n .

<i68410>	a	<Concept> ;
	skos:definition	"a set that is closed, associative, has an identity element and every element has an inverse"@en ;
	dc:source	pwn30:06016853-n .

<i68411>	a	<Concept> ;
	skos:definition	"(mathematics) a subset (that is not empty) of a mathematical group"@en ;
	dc:source	pwn30:06017053-n .

<i68412>	a	<Concept> ;
	skos:definition	"the branch of mathematics dealing with groups"@en ;
	dc:source	pwn30:06017193-n .

<i68413>	a	<Concept> ;
	skos:definition	"group theory applied to the solution of algebraic equations"@en ;
	dc:source	pwn30:06017334-n .

<i68414>	a	<Concept> ;
	skos:definition	"a group that satisfies the commutative law"@en ;
	dc:source	pwn30:06017472-n .

<i68415>	a	<Concept> ;
	skos:definition	"the branch of pure mathematics that deals only with the properties of a figure X that hold for every figure into which X can be transformed with a one-to-one correspondence that is continuous in both directions"@en ;
	dc:source	pwn30:06017594-n .

<i68416>	a	<Concept> ;
	skos:definition	"the logical analysis of mathematical reasoning"@en ;
	dc:source	pwn30:06017895-n .

<i68417>	a	<Concept> ;
	skos:definition	"the branches of mathematics that are involved in the study of the physical or biological or sociological world"@en ;
	dc:source	pwn30:06018022-n .

<i68418>	a	<Concept> ;
	skos:definition	"a mathematical technique used in economics; finds the maximum or minimum of linear functions in many variables subject to constraints"@en ;
	dc:source	pwn30:06018267-n .

<i68419>	a	<Concept> ;
	skos:definition	"a branch of applied mathematics concerned with the collection and interpretation of quantitative data and the use of probability theory to estimate population parameters"@en ;
	dc:source	pwn30:06018465-n .

<i68420>	a	<Concept> ;
	skos:definition	"a method of analyzing or representing statistical data; a procedure for calculating a statistic"@en ;
	dc:source	pwn30:06020737-n .

<i68421>	a	<Concept> ;
	skos:definition	"a method of fitting a curve to data points so as to minimize the sum of the squares of the distances of the points from the curve"@en ;
	dc:source	pwn30:06021013-n .

<i68422>	a	<Concept> ;
	skos:definition	"a generic term for any statistical technique used to analyze data from more than one variable"@en ;
	dc:source	pwn30:06021247-n .

<i68423>	a	<Concept> ;
	skos:definition	"a datum that can be represented numerically"@en ;
	dc:source	pwn30:06021499-n .

<i68424>	a	<Concept> ;
	skos:definition	"a statistic describing the location of a distribution"@en ;
	dc:source	pwn30:06021761-n .

<i68425>	a	<Concept> ;
	skos:definition	"a statistic characterizing human populations (or segments of human populations broken down by age or sex or income etc.)"@en ;
	dc:source	pwn30:06022076-n .

<i68426>	a	<Concept> ;
	skos:definition	"the difference between an observed value and the expected value of a variable or function"@en ;
	dc:source	pwn30:06022291-n .

<i68427>	a	<Concept> ;
	skos:definition	"the n-th moment of a distribution is the expected value of the n-th power of the deviations from a fixed value"@en ;
	dc:source	pwn30:06022509-n .

<i68428>	a	<Concept> ;
	skos:definition	"a statistic computed without knowledge of the form or the parameters of the distribution from which observations are drawn"@en ;
	dc:source	pwn30:06022727-n .

<i68429>	a	<Concept> ;
	skos:definition	"any statistic computed by procedures that assume the data were drawn from a particular distribution"@en ;
	dc:source	pwn30:06023022-n .

<i68430>	a	<Concept> ;
	skos:definition	"the average age at which particular performances are expected to appear"@en ;
	dc:source	pwn30:06023243-n .

<i68431>	a	<Concept> ;
	skos:definition	"an extreme deviation from the mean"@en ;
	dc:source	pwn30:06023369-n .

<i68432>	a	<Concept> ;
	skos:definition	"the arithmetic mean of the absolute values of deviations from the mean of a distribution"@en ;
	dc:source	pwn30:06023476-n .

<i68433>	a	<Concept> ;
	skos:definition	"the most frequent value of a random variable"@en ;
	dc:source	pwn30:06023675-n .

<i68434>	a	<Concept> ;
	skos:definition	"the value below which 50% of the cases fall"@en ;
	dc:source	pwn30:06023821-n .

<i68435>	a	<Concept> ;
	skos:definition	"an average of n numbers computed by adding some function of the numbers and dividing by some function of n"@en ;
	dc:source	pwn30:06023969-n .

<i68436>	a	<Concept> ;
	skos:definition	"the sum of the values of a random variable divided by the number of values"@en ;
	dc:source	pwn30:06024230-n .

<i68437>	a	<Concept> ;
	skos:definition	"the mean of n numbers expressed as the n-th root of their product"@en ;
	dc:source	pwn30:06024431-n .

<i68438>	a	<Concept> ;
	skos:definition	"the mean of n numbers expressed as the reciprocal of the arithmetic mean of the reciprocals of the numbers"@en ;
	dc:source	pwn30:06024576-n .

<i68439>	a	<Concept> ;
	skos:definition	"the expected value of the square of the deviations of a random variable from the point of origin"@en ;
	dc:source	pwn30:06024761-n .

<i68440>	a	<Concept> ;
	skos:definition	"the second moment around the mean; the expected value of the square of the deviations of a random variable from its mean value"@en ;
	dc:source	pwn30:06024936-n .

<i68441>	a	<Concept> ;
	skos:definition	"the square root of the variance"@en ;
	dc:source	pwn30:06025172-n .

<i68442>	a	<Concept> ;
	skos:definition	"(statistics) the mean value of the product of the deviations of two variates from their respective means"@en ;
	dc:source	pwn30:06025287-n .

<i68443>	a	<Concept> ;
	skos:definition	"a distribution of observed frequencies of occurrence of the values of a variable"@en ;
	dc:source	pwn30:06025521-n .

<i68444>	a	<Concept> ;
	skos:definition	"a theoretical distribution with finite mean and variance"@en ;
	dc:source	pwn30:06025689-n .

<i68445>	a	<Concept> ;
	skos:definition	"a theoretical distribution that is a good approximation to the binomial distribution when the probability is small and the number of trials is large"@en ;
	dc:source	pwn30:06025854-n .

<i68446>	a	<Concept> ;
	skos:definition	"a symmetrical curve representing the normal distribution"@en ;
	dc:source	pwn30:06026088-n .

<i68447>	a	<Concept> ;
	skos:definition	"(statistics) the entire aggregation of items from which samples can be drawn"@en ;
	dc:source	pwn30:06026276-n .

<i68448>	a	<Concept> ;
	skos:definition	"a population that is part of a larger population"@en ;
	dc:source	pwn30:06026508-n .

<i68449>	a	<Concept> ;
	skos:definition	"items selected at random from a population and used to test hypotheses about the population"@en ;
	dc:source	pwn30:06026635-n .

<i68450>	a	<Concept> ;
	skos:definition	"a sample in which every element in the population has an equal chance of being selected"@en ;
	dc:source	pwn30:06026885-n .

<i68451>	a	<Concept> ;
	skos:definition	"the population is divided into strata and a random sample is taken from each stratum"@en ;
	dc:source	pwn30:06027051-n .

<i68452>	a	<Concept> ;
	skos:definition	"the relation between selected values of x and observed values of y (from which the most probable value of y can be predicted for any value of x)"@en ;
	dc:source	pwn30:06027264-n .

<i68453>	a	<Concept> ;
	skos:definition	"a statistical technique that predicts values of one variable on the basis of two or more other variables"@en ;
	dc:source	pwn30:06027613-n .

<i68454>	a	<Concept> ;
	skos:definition	"a case of multiple regression in which the predictor variables are themselves highly correlated"@en ;
	dc:source	pwn30:06027843-n .

<i68455>	a	<Concept> ;
	skos:definition	"the use of regression to make quantitative predictions of one variable from the values of another"@en ;
	dc:source	pwn30:06028021-n .

<i68456>	a	<Concept> ;
	skos:definition	"the equation representing the relation between selected values of one variable (x) and observed values of the other (y); it permits the prediction of the most probable values of y"@en ;
	dc:source	pwn30:06028260-n .

<i68457>	a	<Concept> ;
	skos:definition	"when the regression line is linear (y = ax + b) the regression coefficient is the constant (a) that represents the rate of change of one variable (y) as a function of changes in the other (x); it is the slope of the regression line"@en ;
	dc:source	pwn30:06028566-n .

<i68458>	a	<Concept> ;
	skos:definition	"the relation between variables when the regression equation is linear: e.g., y = ax + b"@en ;
	dc:source	pwn30:06028904-n .

<i68459>	a	<Concept> ;
	skos:definition	"the relation between variables when the regression equation is nonlinear (quadratic or higher order)"@en ;
	dc:source	pwn30:06029118-n .

<i68460>	a	<Concept> ;
	skos:definition	"a smooth curve fitted to the set of paired data in regression analysis; for linear regression the curve is a straight line"@en ;
	dc:source	pwn30:06029306-n .

<i68461>	a	<Concept> ;
	skos:definition	"a series of values of a variable at successive times"@en ;
	dc:source	pwn30:06029547-n .

<i68462>	a	<Concept> ;
	skos:definition	"data relating to births and deaths and health and diseases and marriages"@en ;
	dc:source	pwn30:06029676-n .

<i68463>	a	<Concept> ;
	skos:definition	"the use of statistical correlation to evaluate the strength of the relations between variables"@en ;
	dc:source	pwn30:06029830-n .

<i68464>	a	<Concept> ;
	skos:definition	"a matrix giving the correlations between all pairs of data sets"@en ;
	dc:source	pwn30:06030049-n .

<i68465>	a	<Concept> ;
	skos:definition	"any of several methods for reducing correlational data to a smaller number of dimensions or factors; beginning with a correlation matrix a small number of components or factors are extracted that are regarded as the basic variables that account for the interrelations observed in the data"@en ;
	dc:source	pwn30:06030196-n .

<i68466>	a	<Concept> ;
	skos:definition	"a statistical method for making simultaneous comparisons between two or more means; a statistical method that yields values that can be tested to determine whether a significant relation exists between variables"@en ;
	dc:source	pwn30:06030601-n .

<i68467>	a	<Concept> ;
	skos:definition	"a two-way tabulation of the relations between correlates; row headings are the scores on one variable and column headings are the scores on the second variables and a cell shows how many times the score on that row was associated with the score in that column"@en ;
	dc:source	pwn30:06030906-n .

<i68468>	a	<Concept> ;
	skos:definition	"a statistical relation between two or more variables such that systematic changes in the value of one variable are accompanied by systematic changes in the other"@en ;
	dc:source	pwn30:06031248-n .

<i68469>	a	<Concept> ;
	skos:definition	"any correlation in which the rates of change of the variables is not constant"@en ;
	dc:source	pwn30:06031657-n .

<i68470>	a	<Concept> ;
	skos:definition	"a correlation between two variables when the effects of one or more related variables are removed"@en ;
	dc:source	pwn30:06031866-n .

<i68471>	a	<Concept> ;
	skos:definition	"a partial correlation in which the effects of only one variable are removed (held constant)"@en ;
	dc:source	pwn30:06032066-n .

<i68472>	a	<Concept> ;
	skos:definition	"a statistic representing how closely two variables co-vary; it can vary from -1 (perfect negative correlation) through 0 (no correlation) to +1 (perfect positive correlation)"@en ;
	dc:source	pwn30:06032246-n .

<i68473>	a	<Concept> ;
	skos:definition	"(statistics) correlated variation"@en ;
	dc:source	pwn30:06032752-n .

<i68474>	a	<Concept> ;
	skos:definition	"a correlation in which large values of one variable are associated with large values of the other and small with small; the correlation coefficient is between 0 and +1"@en ;
	dc:source	pwn30:06032898-n .

<i68475>	a	<Concept> ;
	skos:definition	"a correlation in which large values of one variable are associated with small values of the other; the correlation coefficient is between 0 and -1"@en ;
	dc:source	pwn30:06033172-n .

<i68476>	a	<Concept> ;
	skos:definition	"the most commonly used method of computing a correlation coefficient between variables that are linearly related"@en ;
	dc:source	pwn30:06033427-n .

<i68477>	a	<Concept> ;
	skos:definition	"an estimate of the combined influence of two or more variables on the observed (dependent) variable"@en ;
	dc:source	pwn30:06033692-n .

<i68478>	a	<Concept> ;
	skos:definition	"a correlation coefficient in which one variable is many-valued and the other is dichotomous"@en ;
	dc:source	pwn30:06033889-n .

<i68479>	a	<Concept> ;
	skos:definition	"the branch of statistics dealing with variables without making assumptions about the form or the parameters of their distribution"@en ;
	dc:source	pwn30:06034101-n .

<i68480>	a	<Concept> ;
	skos:definition	"the most commonly used method of computing a correlation coefficient between the ranks of scores on two variables"@en ;
	dc:source	pwn30:06034301-n .

<i68481>	a	<Concept> ;
	skos:definition	"any of several nonparametric measures of correlation (used when the assumptions of standard correlational analysis are not met)"@en ;
	dc:source	pwn30:06034611-n .

<i68482>	a	<Concept> ;
	skos:definition	"a nonparametric measure of partial correlation"@en ;
	dc:source	pwn30:06034870-n .

<i68483>	a	<Concept> ;
	skos:definition	"a coefficient of agreement (concordance) between different sets of rank orderings of the same set of things"@en ;
	dc:source	pwn30:06035014-n .

<i68484>	a	<Concept> ;
	skos:definition	"a nonparametric measure of the agreement between two rankings"@en ;
	dc:source	pwn30:06035213-n .

<i68485>	a	<Concept> ;
	skos:definition	"an index of the relation between any two sets of scores that can both be represented on ordered binary dimensions (e.g., male-female)"@en ;
	dc:source	pwn30:06035413-n .

<i68486>	a	<Concept> ;
	skos:definition	"a correlation coefficient calculated between scores on two halves of a test; taken as an indication of the reliability of the test"@en ;
	dc:source	pwn30:06035674-n .

<i68487>	a	<Concept> ;
	skos:definition	"a correlation coefficient computed for two normally distributed variables that are both expressed as a dichotomy"@en ;
	dc:source	pwn30:06035918-n .

<i68488>	a	<Concept> ;
	skos:definition	"a correlation between two variables (e.g., between the number of electric motors in the home and grades at school) that does not result from any direct relation between them (buying electric motors will not raise grades) but from their relation to other variables"@en ;
	dc:source	pwn30:06036157-n .

<i68489>	a	<Concept> ;
	skos:definition	"(mathematics) a quantity expressed as a sum or difference of two terms; a polynomial with two terms"@en ;
	dc:source	pwn30:06036506-n .

<i68490>	a	<Concept> ;
	skos:definition	"a theoretical distribution of the number of successes in a finite set of independent trials with a constant probability of success"@en ;
	dc:source	pwn30:06036697-n .

<i68491>	a	<Concept> ;
	skos:definition	"a theorem giving the expansion of a binomial raised to a given power"@en ;
	dc:source	pwn30:06036939-n .

<i68492>	a	<Concept> ;
	skos:definition	"the branch of applied mathematics that deals with probabilities"@en ;
	dc:source	pwn30:06037108-n .

<i68493>	a	<Concept> ;
	skos:definition	"any of the branches of natural science dealing with the structure and behavior of living organisms"@en ;
	dc:source	pwn30:06037298-n .

<i68494>	a	<Concept> ;
	skos:definition	"the science that studies living organisms"@en ;
	dc:source	pwn30:06037666-n .

<i68495>	a	<Concept> ;
	skos:definition	"the application of the principles of the natural sciences to medicine"@en ;
	dc:source	pwn30:06041466-n .

<i68496>	a	<Concept> ;
	skos:definition	"a branch of biology that studies biological phenomena and observations by means of statistical analysis"@en ;
	dc:source	pwn30:06041600-n .

<i68497>	a	<Concept> ;
	skos:definition	"the scientific study of the skulls of various human races"@en ;
	dc:source	pwn30:06041805-n .

<i68498>	a	<Concept> ;
	skos:definition	"the study of the whorls and loops and arches in the fingertips and on the palms of the hand and the soles of the feet"@en ;
	dc:source	pwn30:06041955-n .

<i68499>	a	<Concept> ;
	skos:definition	"the scientific study of food preparation and intake"@en ;
