<i112431>	a	<Concept> ;
	skos:definition	"inflammation of the mucous membrane of the mouth"@en ;
	dc:source	pwn30:14356044-n .

<i112432>	a	<Concept> ;
	skos:definition	"a disease of horses, cattle, swine, and occasionally human beings; caused by the vesiculovirus"@en ;
	dc:source	pwn30:14356167-n .

<i112433>	a	<Concept> ;
	skos:definition	"inflammation of the synovial membrane that lines a synovial joint; results in pain and swelling"@en ;
	dc:source	pwn30:14356328-n .

<i112434>	a	<Concept> ;
	skos:definition	"inflammation of the eyelid"@en ;
	dc:source	pwn30:14356497-n .

<i112435>	a	<Concept> ;
	skos:definition	"inflammation of a tendon"@en ;
	dc:source	pwn30:14356578-n .

<i112436>	a	<Concept> ;
	skos:definition	"painful inflammation of the tendon at the outer border of the elbow resulting from overuse of lower arm muscles (as in twisting of the hand)"@en ;
	dc:source	pwn30:14356720-n .

<i112437>	a	<Concept> ;
	skos:definition	"inflammation of a tendon and its enveloping sheath"@en ;
	dc:source	pwn30:14356993-n .

<i112438>	a	<Concept> ;
	skos:definition	"inflammation of the thyroid gland"@en ;
	dc:source	pwn30:14357160-n .

<i112439>	a	<Concept> ;
	skos:definition	"inflammation of the tonsils (especially the palatine tonsils)"@en ;
	dc:source	pwn30:14357251-n .

<i112440>	a	<Concept> ;
	skos:definition	"inflammation of the trachea"@en ;
	dc:source	pwn30:14357370-n .

<i112441>	a	<Concept> ;
	skos:definition	"common respiratory infection characterized by inflammation of the trachea and the bronchi"@en ;
	dc:source	pwn30:14357454-n .

<i112442>	a	<Concept> ;
	skos:definition	"inflammation of the inner ear"@en ;
	dc:source	pwn30:14357607-n .

<i112443>	a	<Concept> ;
	skos:definition	"inflammation of the gums"@en ;
	dc:source	pwn30:14357693-n .

<i112444>	a	<Concept> ;
	skos:definition	"inflammation of the ureter"@en ;
	dc:source	pwn30:14357770-n .

<i112445>	a	<Concept> ;
	skos:definition	"inflammation of the uvea of the eye"@en ;
	dc:source	pwn30:14357853-n .

<i112446>	a	<Concept> ;
	skos:definition	"inflammation of the uvula"@en ;
	dc:source	pwn30:14357942-n .

<i112447>	a	<Concept> ;
	skos:definition	"a local infection induced in humans by inoculation with the virus causing cowpox in order to confer resistance to smallpox; normally lasts three weeks and leaves a pitted scar"@en ;
	dc:source	pwn30:14358022-n .

<i112448>	a	<Concept> ;
	skos:definition	"inflammation of the vagina (usually associated with candidiasis)"@en ;
	dc:source	pwn30:14358335-n .

<i112449>	a	<Concept> ;
	skos:definition	"inflammation of a valve (especially of a cardiac valve as a consequence of rheumatic fever)"@en ;
	dc:source	pwn30:14358474-n .

<i112450>	a	<Concept> ;
	skos:definition	"inflammation of a blood vessel"@en ;
	dc:source	pwn30:14358622-n .

<i112451>	a	<Concept> ;
	skos:definition	"inflammation of the vas deferens and seminal vesicles; usually occurring with prostatitis"@en ;
	dc:source	pwn30:14358709-n .

<i112452>	a	<Concept> ;
	skos:definition	"inflammation of a seminal vesicle (usually in conjunction with prostatitis)"@en ;
	dc:source	pwn30:14358860-n .

<i112453>	a	<Concept> ;
	skos:definition	"inflammation of the vulva"@en ;
	dc:source	pwn30:14358993-n .

<i112454>	a	<Concept> ;
	skos:definition	"inflammation of the vulva and the vagina"@en ;
	dc:source	pwn30:14359073-n .

<i112455>	a	<Concept> ;
	skos:definition	"a sudden noisy expulsion of air from the lungs that clears the air passages; a common symptom of upper respiratory infection or bronchitis or pneumonia or tuberculosis"@en ;
	dc:source	pwn30:14359174-n .

<i112456>	a	<Concept> ;
	skos:definition	"(usually plural) the state of having reflex spasms of the diaphragm accompanied by a rapid closure of the glottis producing an audible sound; sometimes a symptom of indigestion"@en ;
	dc:source	pwn30:14359459-n .

<i112457>	a	<Concept> ;
	skos:definition	"symptoms that mimic those of meningitis but without inflammation of the meninges"@en ;
	dc:source	pwn30:14359816-n .

<i112458>	a	<Concept> ;
	skos:definition	"the state that precedes vomiting"@en ;
	dc:source	pwn30:14359952-n .

<i112459>	a	<Concept> ;
	skos:definition	"nausea early in the day; a characteristic symptom in the early months of pregnancy"@en ;
	dc:source	pwn30:14360156-n .

<i112460>	a	<Concept> ;
	skos:definition	"a mild state of nausea"@en ;
	dc:source	pwn30:14360320-n .

<i112461>	a	<Concept> ;
	skos:definition	"a painful and involuntary muscular contraction"@en ;
	dc:source	pwn30:14360459-n .

<i112462>	a	<Concept> ;
	skos:definition	"a muscular cramp (especially in the thigh or calf) following vigorous exercise"@en ;
	dc:source	pwn30:14360742-n .

<i112463>	a	<Concept> ;
	skos:definition	"muscular spasms of thumb and forefinger while writing with a pen or pencil"@en ;
	dc:source	pwn30:14360915-n .

<i112464>	a	<Concept> ;
	skos:definition	"spasm of the eyelid muscle resulting in closure of the eye"@en ;
	dc:source	pwn30:14361064-n .

<i112465>	a	<Concept> ;
	skos:definition	"a painful muscle spasm especially in the neck or back (`rick' and `wrick' are British)"@en ;
	dc:source	pwn30:14361182-n .

<i112466>	a	<Concept> ;
	skos:definition	"a clonic spasm of a muscle or muscle group"@en ;
	dc:source	pwn30:14361415-n .

<i112467>	a	<Concept> ;
	skos:definition	"severe spasm in which the back arches and the head bends back and heels flex toward the back"@en ;
	dc:source	pwn30:14361513-n .

<i112468>	a	<Concept> ;
	skos:definition	"a sudden muscle spasm; especially one caused by a nervous condition"@en ;
	dc:source	pwn30:14361664-n .

<i112469>	a	<Concept> ;
	skos:definition	"a local and habitual twitching especially in the face"@en ;
	dc:source	pwn30:14361972-n .

<i112470>	a	<Concept> ;
	skos:definition	"condition in which a person blinks continuously"@en ;
	dc:source	pwn30:14362075-n .

<i112471>	a	<Concept> ;
	skos:definition	"muscular twitching involving individual muscle fibers acting without coordination"@en ;
	dc:source	pwn30:14362179-n .

<i112472>	a	<Concept> ;
	skos:definition	"fibrillation of the muscles of the atria of the heart"@en ;
	dc:source	pwn30:14362373-n .

<i112473>	a	<Concept> ;
	skos:definition	"abnormally slow heartbeat"@en ;
	dc:source	pwn30:14362510-n .

<i112474>	a	<Concept> ;
	skos:definition	"recurrent sudden attacks of unconsciousness caused by impaired conduction of the impulse that regulates the heartbeat"@en ;
	dc:source	pwn30:14362593-n .

<i112475>	a	<Concept> ;
	skos:definition	"irregularity of cardiac rhythm; recurrent occurrences can be a precursor of ventricular fibrillation"@en ;
	dc:source	pwn30:14362841-n .

<i112476>	a	<Concept> ;
	skos:definition	"abnormally rapid heartbeat (over 100 beats per minute)"@en ;
	dc:source	pwn30:14363027-n .

<i112477>	a	<Concept> ;
	skos:definition	"fibrillation of heart muscles resulting in interference with rhythmic contractions of the ventricles and possibly leading to cardiac arrest"@en ;
	dc:source	pwn30:14363139-n .

<i112478>	a	<Concept> ;
	skos:definition	"muscular twitching of contiguous groups of muscle fibers"@en ;
	dc:source	pwn30:14363367-n .

<i112479>	a	<Concept> ;
	skos:definition	"a mark left (usually on the skin) by the healing of injured tissue"@en ;
	dc:source	pwn30:14363483-n .

<i112480>	a	<Concept> ;
	skos:definition	"bony tissue formed during the healing of a fractured bone"@en ;
	dc:source	pwn30:14363785-n .

<i112481>	a	<Concept> ;
	skos:definition	"raised pinkish scar tissue at the site of an injury; results from excessive tissue repair"@en ;
	dc:source	pwn30:14363913-n .

<i112482>	a	<Concept> ;
	skos:definition	"a scar or pit on the skin that is left by a pustule of smallpox or acne or other eruptive disease"@en ;
	dc:source	pwn30:14364065-n .

<i112483>	a	<Concept> ;
	skos:definition	"a scar from a cut made by a sword"@en ;
	dc:source	pwn30:14364217-n .

<i112484>	a	<Concept> ;
	skos:definition	"the scar left following inoculation with a vaccine"@en ;
	dc:source	pwn30:14364306-n .

<i112485>	a	<Concept> ;
	skos:definition	"abnormal hardening or thickening of tissue"@en ;
	dc:source	pwn30:14364432-n .

<i112486>	a	<Concept> ;
	skos:definition	"an area of skin that is thick or hard from continual pressure or friction (as the sole of the foot)"@en ;
	dc:source	pwn30:14364566-n .

<i112487>	a	<Concept> ;
	skos:definition	"a hard thickening of the skin (especially on the top or sides of the toes) caused by the pressure of ill-fitting shoes"@en ;
	dc:source	pwn30:14364802-n .

<i112488>	a	<Concept> ;
	skos:definition	"tissue hardened by deposition of lime salts"@en ;
	dc:source	pwn30:14364980-n .

<i112489>	a	<Concept> ;
	skos:definition	"spots before the eyes caused by opaque cell fragments in the vitreous humor and lens"@en ;
	dc:source	pwn30:14365119-n .

<i112490>	a	<Concept> ;
	skos:definition	"a rise in the temperature of the body; frequently a symptom of infection"@en ;
	dc:source	pwn30:14365356-n .

<i112491>	a	<Concept> ;
	skos:definition	"extremely high fever (especially in children)"@en ;
	dc:source	pwn30:14365619-n .

<i112492>	a	<Concept> ;
	skos:definition	"a decrease in size of an organ caused by disease or disuse"@en ;
	dc:source	pwn30:14365741-n .

<i112493>	a	<Concept> ;
	skos:definition	"abnormal development (of organs or cells) or an abnormal structure resulting from such growth"@en ;
	dc:source	pwn30:14365950-n .

<i112494>	a	<Concept> ;
	skos:definition	"a disturbance in which bone that is undergoing lysis is replaced by an abnormal proliferation of fibrous tissue resulting in bone lesions or skin lesions"@en ;
	dc:source	pwn30:14366225-n .

<i112495>	a	<Concept> ;
	skos:definition	"fibrous dysplasia of bone affecting multiple bones"@en ;
	dc:source	pwn30:14366486-n .

<i112496>	a	<Concept> ;
	skos:definition	"fibrous dysplasia of bone confined to a single bone"@en ;
	dc:source	pwn30:14366633-n .

<i112497>	a	<Concept> ;
	skos:definition	"abnormal enlargement of a body part or organ"@en ;
	dc:source	pwn30:14366759-n .

<i112498>	a	<Concept> ;
	skos:definition	"gland enlargement"@en ;
	dc:source	pwn30:14367005-n .

<i112499>	a	<Concept> ;
	skos:definition	"enlargement of the right ventricle of the heart due to disease of the lungs or of the pulmonary blood vessels"@en ;
	dc:source	pwn30:14367080-n .

<i112500>	a	<Concept> ;
	skos:definition	"abnormally large fingers or toes"@en ;
	dc:source	pwn30:14367249-n .

<i112501>	a	<Concept> ;
	skos:definition	"hypertrophy of certain body parts (usually legs and scrotum); the end state of the disease filariasis"@en ;
	dc:source	pwn30:14367341-n .

<i112502>	a	<Concept> ;
	skos:definition	"hypertrophy of a limb"@en ;
	dc:source	pwn30:14367556-n .

<i112503>	a	<Concept> ;
	skos:definition	"swelling of the scrotum resulting from chronic lymphatic obstruction"@en ;
	dc:source	pwn30:14367649-n .

<i112504>	a	<Concept> ;
	skos:definition	"thickening of the skin (usually unilateral on an extremity) caused by congenital enlargement of lymph vessel and lymph vessel obstruction"@en ;
	dc:source	pwn30:14367797-n .

<i112505>	a	<Concept> ;
	skos:definition	"a disease caused by nematodes in the blood or tissues of the body causing blockage of lymphatic vessels"@en ;
	dc:source	pwn30:14368032-n .

<i112506>	a	<Concept> ;
	skos:definition	"an abnormal enlargement of the spleen"@en ;
	dc:source	pwn30:14368192-n .

<i112507>	a	<Concept> ;
	skos:definition	"excessive size; usually caused by excessive secretion of growth hormone from the pituitary gland"@en ;
	dc:source	pwn30:14368288-n .

<i112508>	a	<Concept> ;
	skos:definition	"enlargement of bones of hands and feet and face; often accompanied by headache and muscle pain and emotional disturbances; caused by overproduction of growth hormone by the anterior pituitary gland (due to a tumor)"@en ;
	dc:source	pwn30:14368483-n .

<i112509>	a	<Concept> ;
	skos:definition	"abnormal increase in number of cells"@en ;
	dc:source	pwn30:14368805-n .

<i112510>	a	<Concept> ;
	skos:definition	"enlarged prostate; appears to be part of the natural aging process"@en ;
	dc:source	pwn30:14368917-n .

<i112511>	a	<Concept> ;
	skos:definition	"underdevelopment of an organ because of a decrease in the number of cells"@en ;
	dc:source	pwn30:14369064-n .

<i112512>	a	<Concept> ;
	skos:definition	"loss of structural differentiation within a cell or group of cells often with increased capacity for multiplication, as in a malignant tumor"@en ;
	dc:source	pwn30:14369194-n .

<i112513>	a	<Concept> ;
	skos:definition	"transient cessation of respiration"@en ;
	dc:source	pwn30:14369408-n .

<i112514>	a	<Concept> ;
	skos:definition	"irregular breathing of newborns; periods of rapid breathing followed by apnea; believed to be associated with sudden infant death syndrome"@en ;
	dc:source	pwn30:14369530-n .

<i112515>	a	<Concept> ;
	skos:definition	"difficult or labored respiration"@en ;
	dc:source	pwn30:14369744-n .

<i112516>	a	<Concept> ;
	skos:definition	"form of dyspnea in which the person can breathe comfortably only when standing or sitting erect; associated with asthma and emphysema and angina pectoris"@en ;
	dc:source	pwn30:14369913-n .

<i112517>	a	<Concept> ;
	skos:definition	"a dyspneic condition"@en ;
	dc:source	pwn30:14370122-n .

<i112518>	a	<Concept> ;
	skos:definition	"apnea that occurs during sleep"@en ;
	dc:source	pwn30:14370267-n .

<i112519>	a	<Concept> ;
	skos:definition	"bleeding from a ruptured blood vessel in the brain"@en ;
	dc:source	pwn30:14370391-n .

<i112520>	a	<Concept> ;
	skos:definition	"the leakage of blood from a vessel into tissues surrounding it; can occur in injuries or burns or allergic reactions"@en ;
	dc:source	pwn30:14370526-n .

<i112521>	a	<Concept> ;
	skos:definition	"bleeding into the interior chamber of the eye"@en ;
	dc:source	pwn30:14370726-n .

<i112522>	a	<Concept> ;
	skos:definition	"bleeding from the uterus that is not due to menstruation; usually indicative of disease (as cervical cancer)"@en ;
	dc:source	pwn30:14370825-n .

<i112523>	a	<Concept> ;
	skos:definition	"bleeding from the nose"@en ;
	dc:source	pwn30:14370992-n .

<i112524>	a	<Concept> ;
	skos:definition	"bleeding of the gums"@en ;
	dc:source	pwn30:14371082-n .

<i112525>	a	<Concept> ;
	skos:definition	"irregular and infrequent or difficult evacuation of the bowels; can be a symptom of intestinal obstruction or diverticulitis"@en ;
	dc:source	pwn30:14371161-n .

<i112526>	a	<Concept> ;
	skos:definition	"difficulty in defecating (usually as a consequence of long continued voluntary suppression of the urge to defecate)"@en ;
	dc:source	pwn30:14371449-n .

<i112527>	a	<Concept> ;
	skos:definition	"accumulation of hardened feces in the rectum or lower colon which the person cannot move"@en ;
	dc:source	pwn30:14371620-n .

<i112528>	a	<Concept> ;
	skos:definition	"severe constipation resulting from an obstruction in the intestines"@en ;
	dc:source	pwn30:14371770-n .

<i112529>	a	<Concept> ;
	skos:definition	"frequent and watery bowel movements; can be a symptom of infection or food poisoning or colitis or a gastrointestinal tumor"@en ;
	dc:source	pwn30:14371913-n .

<i112530>	a	<Concept> ;
	skos:definition	"obscene terms for diarrhea"@en ;
	dc:source	pwn30:14372286-n .

<i112531>	a	<Concept> ;
	skos:definition	"diarrhea contracted in Mexico or Central America"@en ;
	dc:source	pwn30:14372399-n .

<i112532>	a	<Concept> ;
	skos:definition	"a reeling sensation; a feeling that you are about to fall"@en ;
	dc:source	pwn30:14372513-n .

<i112533>	a	<Concept> ;
	skos:definition	"a lack of vitality"@en ;
	dc:source	pwn30:14372738-n .

<i112534>	a	<Concept> ;
	skos:definition	"presence of abnormal high-pitched sound heard with a stethoscope when an airway is blocked (as in asthma or chronic bronchitis)"@en ;
	dc:source	pwn30:14372855-n .

<i112535>	a	<Concept> ;
	skos:definition	"any physical or psychological disturbance (as sweating or depression) experienced by a drug addict when deprived of the drug"@en ;
	dc:source	pwn30:14373057-n .

<i112536>	a	<Concept> ;
	skos:definition	"a blood clot formed within a blood vessel and remaining attached to its place of origin"@en ;
	dc:source	pwn30:14373246-n .

<i112537>	a	<Concept> ;
	skos:definition	"an abnormal particle (e.g. an air bubble or part of a clot) circulating in the blood"@en ;
	dc:source	pwn30:14373407-n .

<i112538>	a	<Concept> ;
	skos:definition	"(psychology) a mental condition in which the qualities of a state are relatively constant even though the state itself may be dynamic"@en ;
	dc:source	pwn30:14373582-n .

<i112539>	a	<Concept> ;
	skos:definition	"a state of individual psychological well-being based upon a sense of confidence and usefulness and purpose"@en ;
	dc:source	pwn30:14374273-n .

<i112540>	a	<Concept> ;
	skos:definition	"(psychiatry) a relatively permanent state of worry and nervousness occurring in a variety of mental disorders, usually accompanied by compulsive behavior or attacks of panic"@en ;
	dc:source	pwn30:14374432-n .

<i112541>	a	<Concept> ;
	skos:definition	"(psychoanalysis) anxiety resulting from real or imagined threats to your sexual functions; originally applied only to men but can in principle apply to women"@en ;
	dc:source	pwn30:14374764-n .

<i112542>	a	<Concept> ;
	skos:definition	"chronic and abnormal anxiety about imaginary symptoms and ailments"@en ;
	dc:source	pwn30:14375005-n .

<i112543>	a	<Concept> ;
	skos:definition	"excessive anxiety"@en ;
	dc:source	pwn30:14375166-n .

<i112544>	a	<Concept> ;
	skos:definition	"a mental state in which the person has continual hallucinations"@en ;
	dc:source	pwn30:14375241-n .

<i112545>	a	<Concept> ;
	skos:definition	"distress and disorientation (especially in adolescence) resulting from conflicting pressures and uncertainty about one's self and one's role in society"@en ;
	dc:source	pwn30:14375363-n .

<i112546>	a	<Concept> ;
	skos:definition	"an uneasy psychological state"@en ;
	dc:source	pwn30:14375576-n .

<i112547>	a	<Concept> ;
	skos:definition	"extreme nervousness"@en ;
	dc:source	pwn30:14375761-n .

<i112548>	a	<Concept> ;
	skos:definition	"(psychology) nervousness resulting from mental stress"@en ;
	dc:source	pwn30:14375890-n .

<i112549>	a	<Concept> ;
	skos:definition	"(psychology) a state of mental or emotional strain or suspense"@en ;
	dc:source	pwn30:14376188-n .

<i112550>	a	<Concept> ;
	skos:definition	"nervous tension that causes an athlete to fail (especially causes golfers to miss short putts)"@en ;
	dc:source	pwn30:14376497-n .

<i112551>	a	<Concept> ;
	skos:definition	"(psychology) stress at which a person breaks down or a situation becomes crucial"@en ;
	dc:source	pwn30:14376695-n .

<i112552>	a	<Concept> ;
	skos:definition	"(psychology) an erroneous belief that is held in the face of evidence to the contrary"@en ;
	dc:source	pwn30:14376855-n .

<i112553>	a	<Concept> ;
	skos:definition	"a delusion (common in paranoia) that you are much greater and more powerful and influential than you really are"@en ;
	dc:source	pwn30:14377177-n .

<i112554>	a	<Concept> ;
	skos:definition	"a delusion (common in paranoia) that others are out to get you and frustrate and embarrass you or inflict suffering on you; a complicated conspiracy is frequently imagined"@en ;
	dc:source	pwn30:14377375-n .

<i112555>	a	<Concept> ;
	skos:definition	"illusory perception; a common symptom of severe mental disorder"@en ;
	dc:source	pwn30:14377617-n .

<i112556>	a	<Concept> ;
	skos:definition	"illusory auditory perception of strange nonverbal sounds"@en ;
	dc:source	pwn30:14377830-n .

<i112557>	a	<Concept> ;
	skos:definition	"hallucinatory perception of colored lights"@en ;
	dc:source	pwn30:14377965-n .

<i112558>	a	<Concept> ;
	skos:definition	"any visual hallucination arising from heavy drinking"@en ;
	dc:source	pwn30:14378064-n .

<i112559>	a	<Concept> ;
	skos:definition	"an image vivid enough to be a hallucination but recognized as unreal"@en ;
	dc:source	pwn30:14378177-n .

<i112560>	a	<Concept> ;
	skos:definition	"a hallucinatory experience induced by drugs"@en ;
	dc:source	pwn30:14378311-n .

<i112561>	a	<Concept> ;
	skos:definition	"illusory visual perception"@en ;
	dc:source	pwn30:14378439-n .

<i112562>	a	<Concept> ;
	skos:definition	"visual hallucination of animals; sometimes occurring in delirium tremens"@en ;
	dc:source	pwn30:14378586-n .

<i112563>	a	<Concept> ;
	skos:definition	"the delusion that things (or everything, including the self) do not exist; a sense that everything is unreal"@en ;
	dc:source	pwn30:14378712-n .

<i112564>	a	<Concept> ;
	skos:definition	"a delusion concerning the body image or parts of the body"@en ;
	dc:source	pwn30:14378897-n .

<i112565>	a	<Concept> ;
	skos:definition	"the delusion that you have assumed the form of an animal"@en ;
	dc:source	pwn30:14379017-n .

<i112566>	a	<Concept> ;
	skos:definition	"the psychological state of someone who is functioning at a satisfactory level of emotional and behavioral adjustment"@en ;
	dc:source	pwn30:14379130-n .

<i112567>	a	<Concept> ;
	skos:definition	"the healthy psychological state of someone with good judgment"@en ;
	dc:source	pwn30:14379360-n .

<i112568>	a	<Concept> ;
	skos:definition	"normal or sound powers of mind"@en ;
	dc:source	pwn30:14379501-n .

<i112569>	a	<Concept> ;
	skos:definition	"a lucid state of mind; not confused"@en ;
	dc:source	pwn30:14379703-n .

<i112570>	a	<Concept> ;
	skos:definition	"the state of having good sense and sound judgment"@en ;
	dc:source	pwn30:14379829-n .

<i112571>	a	<Concept> ;
	skos:definition	"any disease of the mind; the psychological state of someone who has emotional or behavioral problems serious enough to require psychiatric intervention"@en ;
	dc:source	pwn30:14380140-n .

<i112572>	a	<Concept> ;
	skos:definition	"a cover term for a variety of mental disorders in which severe anxiety is a salient symptom"@en ;
	dc:source	pwn30:14380473-n .

<i112573>	a	<Concept> ;
	skos:definition	"an anxiety disorder characterized by chronic free-floating anxiety and such symptoms as tension or sweating or trembling or lightheadedness or irritability etc that has lasted for more than six months"@en ;
	dc:source	pwn30:14380717-n .

<i112574>	a	<Concept> ;
	skos:definition	"an anxiety disorder characterized by recurrent and persistent thoughts and feelings and repetitive, ritualized behaviors"@en ;
	dc:source	pwn30:14381017-n .

<i112575>	a	<Concept> ;
	skos:definition	"an anxiety disorder characterized by unpredictable panic attacks; the attacks are usually severe but brief"@en ;
	dc:source	pwn30:14381249-n .

<i112576>	a	<Concept> ;
	skos:definition	"an anxiety disorder characterized by extreme and irrational fear of simple things or social situations"@en ;
	dc:source	pwn30:14381416-n .

<i112577>	a	<Concept> ;
	skos:definition	"a morbid fear of small insects and mites and worms"@en ;
	dc:source	pwn30:14381732-n .

<i112578>	a	<Concept> ;
	skos:definition	"a morbid fear of open spaces (as fear of being caught alone in some public place)"@en ;
	dc:source	pwn30:14381840-n .

<i112579>	a	<Concept> ;
	skos:definition	"a morbid fear of men"@en ;
	dc:source	pwn30:14381997-n .

<i112580>	a	<Concept> ;
	skos:definition	"a morbid fear of spiders"@en ;
	dc:source	pwn30:14382075-n .

<i112581>	a	<Concept> ;
	skos:definition	"a morbid fear of women"@en ;
	dc:source	pwn30:14382159-n .

<i112582>	a	<Concept> ;
	skos:definition	"any phobia (other than agoraphobia) associated with relatively simple well-defined stimuli"@en ;
	dc:source	pwn30:14382238-n .

<i112583>	a	<Concept> ;
	skos:definition	"a morbid fear of great heights"@en ;
	dc:source	pwn30:14382766-n .

<i112584>	a	<Concept> ;
	skos:definition	"a morbid fear of pain"@en ;
	dc:source	pwn30:14382871-n .

<i112585>	a	<Concept> ;
	skos:definition	"a morbid fear of drowning"@en ;
	dc:source	pwn30:14382967-n .

<i112586>	a	<Concept> ;
	skos:definition	"a morbid fear of thunder and lightning"@en ;
	dc:source	pwn30:14383067-n .

<i112587>	a	<Concept> ;
	skos:definition	"a morbid fear of being dirty"@en ;
	dc:source	pwn30:14383163-n .

<i112588>	a	<Concept> ;
	skos:definition	"a morbid fear of being closed in a confined space"@en ;
	dc:source	pwn30:14383252-n .

<i112589>	a	<Concept> ;
	skos:definition	"a morbid fear of freezing"@en ;
	dc:source	pwn30:14383362-n .

<i112590>	a	<Concept> ;
	skos:definition	"irrational fear of computers or technology"@en ;
	dc:source	pwn30:14383444-n .

<i112591>	a	<Concept> ;
	skos:definition	"a morbid fear of water"@en ;
	dc:source	pwn30:14383544-n .

<i112592>	a	<Concept> ;
	skos:definition	"a symptom of rabies in humans consisting of an aversion to swallowing liquids"@en ;
	dc:source	pwn30:14383624-n .

<i112593>	a	<Concept> ;
	skos:definition	"a morbid fear of falling asleep"@en ;
	dc:source	pwn30:14383759-n .

<i112594>	a	<Concept> ;
	skos:definition	"a morbid fear of dirt or contamination"@en ;
	dc:source	pwn30:14383848-n .

<i112595>	a	<Concept> ;
	skos:definition	"a morbid fear of novelty"@en ;
	dc:source	pwn30:14383961-n .

<i112596>	a	<Concept> ;
	skos:definition	"a morbid fear of night or darkness"@en ;
	dc:source	pwn30:14384041-n .

<i112597>	a	<Concept> ;
	skos:definition	"a morbid fear of developing a phobia"@en ;
	dc:source	pwn30:14384133-n .

<i112598>	a	<Concept> ;
	skos:definition	"a morbid fear of sounds including your own voice"@en ;
	dc:source	pwn30:14384227-n .

<i112599>	a	<Concept> ;
	skos:definition	"a morbid fear of light"@en ;
	dc:source	pwn30:14384351-n .

<i112600>	a	<Concept> ;
	skos:definition	"a morbid fear of fire"@en ;
	dc:source	pwn30:14384431-n .

<i112601>	a	<Concept> ;
	skos:definition	"a morbid fear of being buried alive"@en ;
	dc:source	pwn30:14384509-n .

<i112602>	a	<Concept> ;
	skos:definition	"a morbid fear of death"@en ;
	dc:source	pwn30:14384602-n .

<i112603>	a	<Concept> ;
	skos:definition	"a morbid fear of the number 13"@en ;
	dc:source	pwn30:14384684-n .

<i112604>	a	<Concept> ;
	skos:definition	"a morbid fear of animals"@en ;
	dc:source	pwn30:14384796-n .

<i112605>	a	<Concept> ;
	skos:definition	"a morbid fear of cats"@en ;
	dc:source	pwn30:14385002-n .

<i112606>	a	<Concept> ;
	skos:definition	"a morbid fear of dogs"@en ;
	dc:source	pwn30:14385082-n .

<i112607>	a	<Concept> ;
	skos:definition	"a morbid fear of insects"@en ;
	dc:source	pwn30:14385160-n .

<i112608>	a	<Concept> ;
	skos:definition	"a morbid fear of snakes"@en ;
	dc:source	pwn30:14385243-n .

<i112609>	a	<Concept> ;
	skos:definition	"a morbid fear of mice"@en ;
	dc:source	pwn30:14385325-n .

<i112610>	a	<Concept> ;
	skos:definition	"any phobia (other than agoraphobia) associated with situations in which you are subject to criticism by others (as fear of eating in public or public speaking etc)"@en ;
	dc:source	pwn30:14385403-n .

<i112611>	a	<Concept> ;
	skos:definition	"an abnormal fear of Satan"@en ;
	dc:source	pwn30:14385734-n .

<i112612>	a	<Concept> ;
	skos:definition	"a child's sudden fear of attending school"@en ;
	dc:source	pwn30:14385818-n .

<i112613>	a	<Concept> ;
	skos:definition	"a morbid fear of battle or physical injury"@en ;
	dc:source	pwn30:14385919-n .

<i112614>	a	<Concept> ;
	skos:definition	"a fear of foreigners or strangers"@en ;
	dc:source	pwn30:14386022-n .

<i112615>	a	<Concept> ;
	skos:definition	"an anxiety disorder associated with serious traumatic events and characterized by such symptoms as survivor guilt, reliving the trauma in dreams, numbness and lack of involvement with reality, or recurrent thoughts and images"@en ;
	dc:source	pwn30:14386130-n .

<i112616>	a	<Concept> ;
	skos:definition	"a mental disorder that causes somatic symptoms"@en ;
	dc:source	pwn30:14386475-n .

<i112617>	a	<Concept> ;
	skos:definition	"a disorder in one's mental state"@en ;
	dc:source	pwn30:14386590-n .

<i112618>	a	<Concept> ;
	skos:definition	"a mental disorder characterized by the conversion of mental conflict into somatic forms (into paralysis or anesthesia having no apparent cause)"@en ;
	dc:source	pwn30:14386697-n .

<i112619>	a	<Concept> ;
	skos:definition	"a mental disorder involving loss of sensitivity in the hand and wrist"@en ;
	dc:source	pwn30:14386968-n .

<i112620>	a	<Concept> ;
	skos:definition	"a usually brief state of excitement and mental confusion often accompanied by hallucinations"@en ;
	dc:source	pwn30:14387202-n .

<i112621>	a	<Concept> ;
	skos:definition	"any mental disorder in which delusions play a significant role"@en ;
	dc:source	pwn30:14387349-n .

<i112622>	a	<Concept> ;
	skos:definition	"involuntary defecation not attributable to physical defects or illness"@en ;
	dc:source	pwn30:14387477-n .

<i112623>	a	<Concept> ;
	skos:definition	"the simultaneous occurrence of symptoms of a mental disorder (as delusions) in two persons who are closely related (as siblings or man and wife)"@en ;
	dc:source	pwn30:14387604-n .

<i112624>	a	<Concept> ;
	skos:definition	"inflexible and maladaptive patterns of behavior"@en ;
	dc:source	pwn30:14387807-n .

<i112625>	a	<Concept> ;
	skos:definition	"the condition of being unable to adapt properly to your environment with resulting emotional instability"@en ;
	dc:source	pwn30:14387975-n .

<i112626>	a	<Concept> ;
	skos:definition	"a personality disorder characterized by amorality and lack of affect; capable of violent acts without guilt feelings (`psychopathic personality' was once widely used but was superseded by `sociopathic personality' to indicate the social aspects of the disorder, but now `antisocial personality disorder' is the preferred term)"@en ;
	dc:source	pwn30:14388139-n .

<i112627>	a	<Concept> ;
	skos:definition	"a mental disorder caused by stress of active warfare"@en ;
	dc:source	pwn30:14388596-n .

<i112628>	a	<Concept> ;
	skos:definition	"characterized by symptoms similar to but less severe than schizophrenia"@en ;
	dc:source	pwn30:14388758-n .

<i112629>	a	<Concept> ;
	skos:definition	"any mental disorder not caused by detectable organic abnormalities of the brain and in which a major disturbance of emotions is predominant"@en ;
	dc:source	pwn30:14388910-n .

<i112630>	a	<Concept> ;
	skos:definition	"a state of depression and anhedonia so severe as to require clinical intervention"@en ;
	dc:source	pwn30:14389240-n .

<i112631>	a	<Concept> ;
	skos:definition	"a state of clinical depression in which the person exhibits irritability and restlessness"@en ;
	dc:source	pwn30:14389584-n .

<i112632>	a	<Concept> ;
	skos:definition	"severe and progressive depression in infants who lose their mother and do not get a suitable substitute"@en ;
	dc:source	pwn30:14389739-n .

<i112633>	a	<Concept> ;
	skos:definition	"mild chronic depression"@en ;
	dc:source	pwn30:14389909-n .

<i112634>	a	<Concept> ;
	skos:definition	"a state of depression for which there is no apparent precipitating cause"@en ;
	dc:source	pwn30:14390109-n .

<i112635>	a	<Concept> ;
	skos:definition	"an inappropriate state of depression that is precipitated by events in the person's life (to be distinguished from normal grief)"@en ;
	dc:source	pwn30:14390249-n .

<i112636>	a	<Concept> ;
	skos:definition	"(psychiatry) a state of depression with all the classic symptoms (anhedonia and lethargy and sleep disturbance and despondency and morbid thoughts and feelings of worthlessness and sometimes attempted suicide) but with no known organic dysfunction"@en ;
	dc:source	pwn30:14390466-n .

<i112637>	a	<Concept> ;
	skos:definition	"a major depressive episode associated with the climacteric"@en ;
	dc:source	pwn30:14390839-n .

<i112638>	a	<Concept> ;
	skos:definition	"a term used for any state of depression that is not psychotic"@en ;
	dc:source	pwn30:14390967-n .

<i112639>	a	<Concept> ;
	skos:definition	"a state of depression so severe that the person loses contact with reality and suffers a variety of functional impairments"@en ;
	dc:source	pwn30:14391112-n .

<i112640>	a	<Concept> ;
	skos:definition	"a state of clinical depression in which the individual is lethargic and slow to initiate action"@en ;
	dc:source	pwn30:14391319-n .

<i112641>	a	<Concept> ;
	skos:definition	"a major depressive episode that occurs without the manic phase that occurs in the classic form of bipolar disorder"@en ;
	dc:source	pwn30:14391480-n .

<i112642>	a	<Concept> ;
	skos:definition	"a mood disorder; an affective disorder in which the victim tends to respond excessively and sometimes violently"@en ;
	dc:source	pwn30:14391660-n .

<i112643>	a	<Concept> ;
	skos:definition	"state of violent mental agitation"@en ;
	dc:source	pwn30:14391876-n .

<i112644>	a	<Concept> ;
	skos:definition	"a condition in which a large group of people exhibit the same state of violent mental agitation"@en ;
	dc:source	pwn30:14392143-n .

<i112645>	a	<Concept> ;
	skos:definition	"a psychological state characterized by delusions of grandeur"@en ;
	dc:source	pwn30:14392318-n .

<i112646>	a	<Concept> ;
	skos:definition	"extreme depression characterized by tearful sadness and irrational fears"@en ;
	dc:source	pwn30:14392491-n .

<i112647>	a	<Concept> ;
	skos:definition	"a mental disorder characterized by episodes of mania and depression"@en ;
	dc:source	pwn30:14392639-n .

<i112648>	a	<Concept> ;
	skos:definition	"a mild bipolar disorder that persists over a long time"@en ;
	dc:source	pwn30:14392862-n .

<i112649>	a	<Concept> ;
	skos:definition	"resembling schizophrenia but remaining within the bounds of normality"@en ;
	dc:source	pwn30:14393033-n .

<i112650>	a	<Concept> ;
	skos:definition	"a mental or personality disturbance not attributable to any known neurological or organic dysfunction"@en ;
	dc:source	pwn30:14393161-n .

<i112651>	a	<Concept> ;
	skos:definition	"neurotic disorder characterized by violent emotional outbreaks and disturbances of sensory and motor functions"@en ;
	dc:source	pwn30:14393438-n .

<i112652>	a	<Concept> ;
	skos:definition	"a form of hysteria having features of both conversion disorder and anxiety neurosis"@en ;
	dc:source	pwn30:14393716-n .

<i112653>	a	<Concept> ;
	skos:definition	"hysteria with cataleptic symptoms"@en ;
	dc:source	pwn30:14393862-n .

<i112654>	a	<Concept> ;
	skos:definition	"characterized by diffuse anxiety and often somatic manifestations of fear"@en ;
	dc:source	pwn30:14393958-n .

<i112655>	a	<Concept> ;
	skos:definition	"emotional dissociative disorder in which there is loss of contact with your own personal reality accompanied by feelings of unreality and strangeness"@en ;
	dc:source	pwn30:14394094-n .

<i112656>	a	<Concept> ;
	skos:definition	"dissociative disorder in which a person forgets who they are and leaves home to creates a new life; during the fugue there is no memory of the former life; after recovering there is no memory for events during the dissociative state"@en ;
	dc:source	pwn30:14394479-n .

<i112657>	a	<Concept> ;
	skos:definition	"a relatively rare dissociative disorder in which the usual integrity of the personality breaks down and two or more independent personalities emerge"@en ;
	dc:source	pwn30:14394783-n .

<i112658>	a	<Concept> ;
	skos:definition	"relatively permanent disorder of the mind"@en ;
	dc:source	pwn30:14395018-n .

<i112659>	a	<Concept> ;
	skos:definition	"obsolete terms for legal insanity"@en ;
	dc:source	pwn30:14395240-n .

<i112660>	a	<Concept> ;
	skos:definition	"mental deterioration of organic or functional origin"@en ;
	dc:source	pwn30:14395403-n .

<i112661>	a	<Concept> ;
	skos:definition	"dementia observed during the last stages of severe chronic alcoholism; involves loss of memory for recent events although long term memory is intact"@en ;
	dc:source	pwn30:14395597-n .

<i112662>	a	<Concept> ;
	skos:definition	"dementia with onset before the age of 65"@en ;
	dc:source	pwn30:14395955-n .

<i112663>	a	<Concept> ;
	skos:definition	"a progressive form of presenile dementia that is similar to senile dementia except that it usually starts in the 40s or 50s; first symptoms are impaired memory which is followed by impaired thought and speech and finally complete helplessness"@en ;
	dc:source	pwn30:14396096-n .

<i112664>	a	<Concept> ;
	skos:definition	"a progressive form of presenile dementia found most often in middle-aged and elderly women and characterized by degeneration of the frontal and temporal lobes with loss of intellectual ability and transitory aphasia"@en ;
	dc:source	pwn30:14396431-n .

<i112665>	a	<Concept> ;
	skos:definition	"dementia of the aged; results from degeneration of the brain in the absence of cerebrovascular disease"@en ;
	dc:source	pwn30:14396707-n .

<i112666>	a	<Concept> ;
	skos:definition	"any disease or malformation of the nose"@en ;
	dc:source	pwn30:14396890-n .

<i112667>	a	<Concept> ;
	skos:definition	"enlargement of the nose with dilation of follicles and redness and prominent vascularity of the skin; often associated with excessive consumption of alcohol"@en ;
	dc:source	pwn30:14397040-n .

<i112668>	a	<Concept> ;
	skos:definition	"inflammatory degenerative disease of the brain caused by thiamine deficiency that is usually associated with alcoholism"@en ;
	dc:source	pwn30:14397372-n .

<i112669>	a	<Concept> ;
	skos:definition	"the state of being irrational; lacking powers of understanding"@en ;
	dc:source	pwn30:14397563-n .

<i112670>	a	<Concept> ;
	skos:definition	"a state of mental disturbance and disorientation"@en ;
	dc:source	pwn30:14397714-n .

<i112671>	a	<Concept> ;
	skos:definition	"informal terms for insanity"@en ;
	dc:source	pwn30:14397889-n .

<i112672>	a	<Concept> ;
	skos:definition	"any severe mental disorder in which contact with reality is lost or highly distorted"@en ;
	dc:source	pwn30:14398067-n .

<i112673>	a	<Concept> ;
	skos:definition	"acute delirium caused by alcohol poisoning"@en ;
	dc:source	pwn30:14398279-n .

<i112674>	a	<Concept> ;
	skos:definition	"a psychological disorder characterized by delusions of persecution or grandeur"@en ;
	dc:source	pwn30:14398390-n .

<i112675>	a	<Concept> ;
	skos:definition	"any of several psychotic disorders characterized by distortions of reality and disturbances of thought and language and withdrawal from social contact"@en ;
	dc:source	pwn30:14398523-n .

<i112676>	a	<Concept> ;
	skos:definition	"schizophrenia characterized by mild symptoms or by some preexisting tendency to schizophrenia"@en ;
	dc:source	pwn30:14398929-n .

<i112677>	a	<Concept> ;
	skos:definition	"a form of schizophrenia characterized by a tendency to remain in a fixed stuporous state for long periods; the catatonia may give way to short periods of extreme excitement"@en ;
	dc:source	pwn30:14399116-n .

<i112678>	a	<Concept> ;
	skos:definition	"a form of schizophrenia characterized by severe disintegration of personality including erratic speech and childish mannerisms and bizarre behavior; usually becomes evident during puberty; the most common diagnostic category in mental institutions"@en ;
	dc:source	pwn30:14399438-n .

<i112679>	a	<Concept> ;
	skos:definition	"a form of schizophrenia characterized by delusions (of persecution or grandeur or jealousy); symptoms may include anger and anxiety and aloofness and doubts about gender identity; unlike other types of schizophrenia the patients are usually presentable and (if delusions are not acted on) may function in an apparently normal manner"@en ;
	dc:source	pwn30:14399852-n .

<i112680>	a	<Concept> ;
	skos:definition	"schizophrenia of abrupt onset and relatively short duration (a few weeks or months)"@en ;
	dc:source	pwn30:14400325-n .

<i112681>	a	<Concept> ;
	skos:definition	"a disorder of the vocal organs that results in the loss of voice"@en ;
	dc:source	pwn30:14400507-n .

<i112682>	a	<Concept> ;
	skos:definition	"a disorder of oral speech"@en ;
	dc:source	pwn30:14400677-n .

<i112683>	a	<Concept> ;
	skos:definition	"a chronic disorder that occurs in tropical and non-tropical forms and in both children and adults; nutrients are not absorbed; symptoms include foul-smelling diarrhea and emaciation"@en ;
	dc:source	pwn30:14400979-n .

<i112684>	a	<Concept> ;
	skos:definition	"a urinary bladder disorder resulting from interruption of the reflex arc normally associated with voiding urine; absence of bladder sensation and over-filling of the bladder and inability to urinate voluntarily"@en ;
	dc:source	pwn30:14401240-n .

<i112685>	a	<Concept> ;
	skos:definition	"a urinary bladder disorder caused by a lesion in the nervous system"@en ;
	dc:source	pwn30:14401512-n .

<i112686>	a	<Concept> ;
	skos:definition	"a urinary bladder disorder resulting from spinal cord lesion or multiple sclerosis or trauma; absence of bladder sensation and incontinence and interrupted voiding of urine"@en ;
	dc:source	pwn30:14401644-n .

<i112687>	a	<Concept> ;
	skos:definition	"a speech disorder in which the same word is repeated several times in succession"@en ;
	dc:source	pwn30:14401878-n .

<i112688>	a	<Concept> ;
	skos:definition	"impaired articulatory ability resulting from defects in the peripheral motor nerves or in the speech musculature"@en ;
	dc:source	pwn30:14402015-n .

<i112689>	a	<Concept> ;
	skos:definition	"impaired ability to express ideas verbally; usually resulting from difficulties of reasoning (as in feeblemindedness or certain psychoses)"@en ;
	dc:source	pwn30:14402184-n .

<i112690>	a	<Concept> ;
	skos:definition	"speech disorder attributable to a disorder of phonation"@en ;
	dc:source	pwn30:14402377-n .

<i112691>	a	<Concept> ;
	skos:definition	"defective articulation of the `l' phoneme or the phoneme `r' is pronounced as `l'"@en ;
	dc:source	pwn30:14402488-n .

<i112692>	a	<Concept> ;
	skos:definition	"speech defect involving excessive use or unusual pronunciation of the phoneme `l'"@en ;
	dc:source	pwn30:14402625-n .

<i112693>	a	<Concept> ;
	skos:definition	"a speech defect that involves pronouncing `s' like voiceless `th' and `z' like voiced `th'"@en ;
	dc:source	pwn30:14402763-n .

<i112694>	a	<Concept> ;
	skos:definition	"a speech disorder involving hesitations and involuntary repetitions of certain sounds"@en ;
	dc:source	pwn30:14402922-n .

<i112695>	a	<Concept> ;
	skos:definition	"a mental state of extreme emotional disturbance"@en ;
	dc:source	pwn30:14403107-n .

<i112696>	a	<Concept> ;
	skos:definition	"an unhappy and worried mental state"@en ;
	dc:source	pwn30:14403282-n .

<i112697>	a	<Concept> ;
	skos:definition	"agitation resulting from active worry"@en ;
	dc:source	pwn30:14403560-n .

<i112698>	a	<Concept> ;
	skos:definition	"an excited state of agitation"@en ;
	dc:source	pwn30:14403772-n .

<i112699>	a	<Concept> ;
	skos:definition	"loss of emotional control often resulting in emotional collapse"@en ;
	dc:source	pwn30:14404042-n .

<i112700>	a	<Concept> ;
