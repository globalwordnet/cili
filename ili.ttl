<i116649>	a	<Concept> ;
	skos:definition	"a period of illness"@en ;
	dc:source	pwn30:15119072-n .

<i116650>	a	<Concept> ;
	skos:definition	"a period of time when you are confined to a hospital"@en ;
	dc:source	pwn30:15119185-n .

<i116651>	a	<Concept> ;
	skos:definition	"a period of time spent traveling"@en ;
	dc:source	pwn30:15119374-n .

<i116652>	a	<Concept> ;
	skos:definition	"the period of time that is happening now; any continuous stretch of time including the moment of speech"@en ;
	dc:source	pwn30:15119536-n .

