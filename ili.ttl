	dc:source	pwn30:06553846-n .

<i70905>	a	<Concept> ;
	skos:definition	"(law) the completion of a legal instrument (such as a contract or deed) by signing it (and perhaps sealing and delivering it) so that it becomes legally binding and enforceable"@en ;
	dc:source	pwn30:06554078-n .

<i70906>	a	<Concept> ;
	skos:definition	"a writ ordering a prisoner to be brought before a judge"@en ;
	dc:source	pwn30:06554373-n .

<i70907>	a	<Concept> ;
	skos:definition	"a judicial writ ordering a sheriff to summon people for jury duty"@en ;
	dc:source	pwn30:06554531-n .

<i70908>	a	<Concept> ;
