	skos:definition	"illness caused by poisonous or contaminated food"@en ;
	dc:source	pwn30:14068685-n .

<i110865>	a	<Concept> ;
	skos:definition	"food poisoning from ingesting botulin; not infectious; affects the CNS; can be fatal if not treated promptly"@en ;
	dc:source	pwn30:14068894-n .

<i110866>	a	<Concept> ;
	skos:definition	"toxic condition caused by eating certain species of mushrooms (especially Amanita species)"@en ;
	dc:source	pwn30:14069057-n .

<i110867>	a	<Concept> ;
	skos:definition	"a disturbance in the synthesis of immunoglobulins; proteins having antibody activity increase greatly in the blood"@en ;
	dc:source	pwn30:14069212-n .

<i110868>	a	<Concept> ;
	skos:definition	"repetitive nonmeaningful speech (especially that associated with a trance state or religious fervor)"@en ;
	dc:source	pwn30:14069383-n .

<i110869>	a	<Concept> ;
	skos:definition	"a term for food poisoning that is no longer in scientific use; food poisoning was once thought to be caused by ingesting ptomaines"@en ;
	dc:source	pwn30:14069541-n .

<i110870>	a	<Concept> ;
	skos:definition	"a kind of food poisoning caused by eating foods contaminated with Salmonella typhimurium"@en ;
	dc:source	pwn30:14069747-n .

<i110871>	a	<Concept> ;
	skos:definition	"toxic condition produced by the absorption of excessive lead into the system"@en ;
	dc:source	pwn30:14069895-n .

<i110872>	a	<Concept> ;
	skos:definition	"symptom of chronic lead poisoning and associated with obstinate constipation"@en ;
	dc:source	pwn30:14070055-n .

<i110873>	a	<Concept> ;
	skos:definition	"a trancelike state with loss of voluntary motion and failure to react to stimuli"@en ;
	dc:source	pwn30:14070206-n .

<i110874>	a	<Concept> ;
	skos:definition	"an impairment of health or a condition of abnormal functioning"@en ;
	dc:source	pwn30:14070360-n .

<i110875>	a	<Concept> ;
	skos:definition	"a disease characterized by impairment of neuromuscular junctions"@en ;
	dc:source	pwn30:14071235-n .

<i110876>	a	<Concept> ;
	skos:definition	"any disease of the blood vessels or lymph ducts"@en ;
	dc:source	pwn30:14071419-n .

<i110877>	a	<Concept> ;
	skos:definition	"disease especially in agricultural workers caused by inhalation of Aspergillus spores causing lumps in skin and ears and respiratory organs"@en ;
	dc:source	pwn30:14071559-n .

<i110878>	a	<Concept> ;
	skos:definition	"the presence of acanthocytes in the blood stream (as in abetalipoproteinemia)"@en ;
	dc:source	pwn30:14071758-n .

<i110879>	a	<Concept> ;
	skos:definition	"an acute blood disorder (often caused by radiation or drug therapy) characterized by severe reduction in granulocytes"@en ;
	dc:source	pwn30:14071896-n .

<i110880>	a	<Concept> ;
	skos:definition	"an abnormally low level of albumin in the blood serum"@en ;
	dc:source	pwn30:14072126-n .

<i110881>	a	<Concept> ;
	skos:definition	"a disease characterized by congestion and enlargement of the spleen; accompanied by anemia or cirrhosis"@en ;
	dc:source	pwn30:14072239-n .

<i110882>	a	<Concept> ;
	skos:definition	"a disease of humans that is not communicable; caused by infection with Bacillus anthracis followed by septicemia"@en ;
	dc:source	pwn30:14072423-n .

<i110883>	a	<Concept> ;
	skos:definition	"a form of anthrax infection that begins as papule that becomes a vesicle and breaks with a discharge of toxins; symptoms of septicemia are severe with vomiting and high fever and profuse sweating; the infection is often fatal"@en ;
	dc:source	pwn30:14072625-n .

<i110884>	a	<Concept> ;
	skos:definition	"a form of anthrax infection acquired by inhalation of dust containing Bacillus anthracis; initial symptoms (chill and cough and dyspnea and rapid pulse) are followed by extreme cardiovascular collapse"@en ;
	dc:source	pwn30:14072934-n .

<i110885>	a	<Concept> ;
	skos:definition	"any of several human or animal diseases characterized by dark urine resulting from rapid breakdown of red blood cells"@en ;
	dc:source	pwn30:14073331-n .

<i110886>	a	<Concept> ;
	skos:definition	"hemorrhagic fever with neurological signs; caused by the Junin virus"@en ;
	dc:source	pwn30:14073505-n .

<i110887>	a	<Concept> ;
	skos:definition	"severe and often fatal malaria characterized by kidney damage resulting in dark urine"@en ;
	dc:source	pwn30:14073647-n .

<i110888>	a	<Concept> ;
	skos:definition	"severe form of malaria occurring in tropical regions"@en ;
	dc:source	pwn30:14073795-n .

<i110889>	a	<Concept> ;
	skos:definition	"a disease thought to be transmitted to humans by a scratch from a cat"@en ;
	dc:source	pwn30:14073906-n .

<i110890>	a	<Concept> ;
	skos:definition	"any disease or disorder that occurs during the course of (or because of) another disease"@en ;
	dc:source	pwn30:14074041-n .

<i110891>	a	<Concept> ;
	skos:definition	"an ill-defined bodily ailment"@en ;
	dc:source	pwn30:14074267-n .

<i110892>	a	<Concept> ;
	skos:definition	"a disease that is constantly present to a greater or lesser degree in people of a certain class or in people living in a particular location"@en ;
	dc:source	pwn30:14074394-n .

<i110893>	a	<Concept> ;
	skos:definition	"a disease of the intestinal tract"@en ;
	dc:source	pwn30:14074606-n .

<i110894>	a	<Concept> ;
	skos:definition	"any disease arising from internal dysfunctions of unknown cause"@en ;
	dc:source	pwn30:14074715-n .

<i110895>	a	<Concept> ;
	skos:definition	"an inherited disease controlled by a single pair of genes"@en ;
	dc:source	pwn30:14074877-n .

<i110896>	a	<Concept> ;
	skos:definition	"an inherited disease controlled by several genes at once"@en ;
	dc:source	pwn30:14075199-n .

<i110897>	a	<Concept> ;
	skos:definition	"incompetence of the gonads (especially in the male with low testosterone); results in deficient development of secondary sex characteristics and (in prepubertal males) a body with long legs and a short trunk"@en ;
	dc:source	pwn30:14075358-n .

<i110898>	a	<Concept> ;
	skos:definition	"the state of being a eunuch (either because of lacking testicles or because they failed to develop)"@en ;
	dc:source	pwn30:14075660-n .

<i110899>	a	<Concept> ;
	skos:definition	"hypogonadism with anosmia; a congenital sexual disorder that prevents the testicles from maturing at puberty"@en ;
	dc:source	pwn30:14075838-n .

<i110900>	a	<Concept> ;
	skos:definition	"inability of a bodily valve to close completely"@en ;
	dc:source	pwn30:14076011-n .

<i110901>	a	<Concept> ;
	skos:definition	"inability of a part or organ to function properly"@en ;
	dc:source	pwn30:14076126-n .

<i110902>	a	<Concept> ;
	skos:definition	"an acute disease of young children characterized by a rash and swollen lymph nodes and fever; of unknown cause"@en ;
	dc:source	pwn30:14076270-n .

<i110903>	a	<Concept> ;
	skos:definition	"any epidemic disease with a high death rate"@en ;
	dc:source	pwn30:14076479-n .

<i110904>	a	<Concept> ;
	skos:definition	"a degenerative state of the cell nucleus"@en ;
	dc:source	pwn30:14076667-n .

<i110905>	a	<Concept> ;
	skos:definition	"the state of being hyaline or having become hyaline"@en ;
	dc:source	pwn30:14076809-n .

<i110906>	a	<Concept> ;
	skos:definition	"excessive secretion of parathyroid hormone resulting in abnormally high levels of calcium in the blood; can affect many systems of the body (especially causing bone resorption and osteoporosis)"@en ;
	dc:source	pwn30:14076992-n .

<i110907>	a	<Concept> ;
	skos:definition	"inadequate secretion of parathyroid hormone resulting in abnormally low levels of calcium in the blood"@en ;
	dc:source	pwn30:14077269-n .

<i110908>	a	<Concept> ;
	skos:definition	"excessive activity of the pituitary gland (especially overactivity of the anterior lobe which leads to excess secretion of growth hormone)"@en ;
	dc:source	pwn30:14077454-n .

<i110909>	a	<Concept> ;
	skos:definition	"the state of having become filled with vacuoles"@en ;
	dc:source	pwn30:14077693-n .

<i110910>	a	<Concept> ;
	skos:definition	"an infective disease caused by sporozoan parasites that are transmitted through the bite of an infected Anopheles mosquito; marked by paroxysms of chills and fever"@en ;
	dc:source	pwn30:14077830-n .

<i110911>	a	<Concept> ;
	skos:definition	"a disease (common in India and around the Mediterranean area) caused by a rickettsia that is transmitted to humans by a reddish brown tick (ixodid) that lives on dogs and other mammals"@en ;
	dc:source	pwn30:14078120-n .

<i110912>	a	<Concept> ;
	skos:definition	"a disease of the inner ear characterized by episodes of dizziness and tinnitus and progressive hearing loss (usually unilateral)"@en ;
	dc:source	pwn30:14078421-n .

<i110913>	a	<Concept> ;
	skos:definition	"caused by consuming milk from cattle suffering from trembles"@en ;
	dc:source	pwn30:14078613-n .

<i110914>	a	<Concept> ;
	skos:definition	"any disease that shows symptoms characteristic of another disease"@en ;
	dc:source	pwn30:14078733-n .

<i110915>	a	<Concept> ;
	skos:definition	"a chronic progressive disease characterized by chronic fatigue and muscular weakness (especially in the face and neck); caused by a deficiency of acetylcholine at the neuromuscular junctions"@en ;
	dc:source	pwn30:14078871-n .

<i110916>	a	<Concept> ;
	skos:definition	"a disease seen in patients with lung cancer and characterized by weakness and fatigue of hip and thigh muscles and an aching back; caused by antibodies directed against the neuromuscular junctions"@en ;
	dc:source	pwn30:14079156-n .

<i110917>	a	<Concept> ;
	skos:definition	"disease or disability resulting from conditions of employment (usually from long exposure to a noxious substance or from continuous repetition of certain acts)"@en ;
	dc:source	pwn30:14079493-n .

<i110918>	a	<Concept> ;
	skos:definition	"separation of a nail from its normal attachment to the nail bed"@en ;
	dc:source	pwn30:14079740-n .

<i110919>	a	<Concept> ;
	skos:definition	"any disease or disorder of the nails"@en ;
	dc:source	pwn30:14079861-n .

<i110920>	a	<Concept> ;
	skos:definition	"a disease of bone occurring in the middle aged and elderly; excessive bone destruction sometimes leading to bone pain and fractures and skeletal deformities"@en ;
	dc:source	pwn30:14079971-n .

<i110921>	a	<Concept> ;
	skos:definition	"any painful disorder of the joints or muscles or connective tissues"@en ;
	dc:source	pwn30:14080210-n .

<i110922>	a	<Concept> ;
	skos:definition	"a progressive disease of connective tissue that is characterized by nodules along arteries; nodules may block the artery and result in inadequate circulation to the particular area"@en ;
	dc:source	pwn30:14080352-n .

<i110923>	a	<Concept> ;
	skos:definition	"a disease that attacks the gum and bone and around the teeth"@en ;
	dc:source	pwn30:14080622-n .

<i110924>	a	<Concept> ;
	skos:definition	"chronic periodontitis; purulent inflammation of the teeth sockets"@en ;
	dc:source	pwn30:14080836-n .

<i110925>	a	<Concept> ;
	skos:definition	"pus pocket formation around a tooth"@en ;
	dc:source	pwn30:14081025-n .

<i110926>	a	<Concept> ;
	skos:definition	"wasting of the bony socket"@en ;
	dc:source	pwn30:14081124-n .

<i110927>	a	<Concept> ;
	skos:definition	"inflammation of the gums"@en ;
	dc:source	pwn30:14081216-n .

<i110928>	a	<Concept> ;
	skos:definition	"recession of the gums"@en ;
	dc:source	pwn30:14081297-n .

<i110929>	a	<Concept> ;
	skos:definition	"a sudden occurrence of an uncontrollable condition"@en ;
	dc:source	pwn30:14081375-n .

<i110930>	a	<Concept> ;
	skos:definition	"a sudden acute episode of intense anxiety and feelings of panic"@en ;
	dc:source	pwn30:14081665-n .

<i110931>	a	<Concept> ;
	skos:definition	"a sudden recurrence or worsening of symptoms"@en ;
	dc:source	pwn30:14081789-n .

<i110932>	a	<Concept> ;
	skos:definition	"a sudden occurrence (or recurrence) of a disease"@en ;
	dc:source	pwn30:14081941-n .

<i110933>	a	<Concept> ;
	skos:definition	"a slight attack of illness"@en ;
	dc:source	pwn30:14082186-n .

<i110934>	a	<Concept> ;
	skos:definition	"a sudden loss of consciousness resulting when the rupture or occlusion of a blood vessel leads to oxygen lack in the brain"@en ;
	dc:source	pwn30:14082303-n .

<i110935>	a	<Concept> ;
	skos:definition	"violent uncontrollable contractions of muscles"@en ;
	dc:source	pwn30:14082595-n .

<i110936>	a	<Concept> ;
	skos:definition	"a sudden uncontrollable attack"@en ;
	dc:source	pwn30:14082788-n .

<i110937>	a	<Concept> ;
	skos:definition	"an attack of hysteria"@en ;
	dc:source	pwn30:14082984-n .

<i110938>	a	<Concept> ;
	skos:definition	"convulsion characterized by alternating contractions and relaxations"@en ;
	dc:source	pwn30:14083061-n .

<i110939>	a	<Concept> ;
	skos:definition	"convulsions accompanied by impaired consciousness"@en ;
	dc:source	pwn30:14083200-n .

<i110940>	a	<Concept> ;
	skos:definition	"a seizure during which the patient becomes unconscious and has convulsions over the entire body"@en ;
	dc:source	pwn30:14083368-n .

<i110941>	a	<Concept> ;
	skos:definition	"a seizure of short duration characterized by momentary unconsciousness and local muscle spasms or twitching"@en ;
	dc:source	pwn30:14083559-n .

<i110942>	a	<Concept> ;
	skos:definition	"(psychiatry) a psychological disorder of thought or emotion; a more neutral term than mental illness"@en ;
	dc:source	pwn30:14083790-n .

<i110943>	a	<Concept> ;
	skos:definition	"a psychiatric disorder usually noted during early school years; characterized by impaired social relations and by repetitive patterns of behavior"@en ;
	dc:source	pwn30:14084291-n .

<i110944>	a	<Concept> ;
	skos:definition	"a disorder or defect of metabolism"@en ;
	dc:source	pwn30:14084502-n .

<i110945>	a	<Concept> ;
	skos:definition	"a rare recessive metabolic anomaly marked by ochronosis and the presence of alkapton in the urine"@en ;
	dc:source	pwn30:14084709-n .

<i110946>	a	<Concept> ;
	skos:definition	"a disorder of the nervous system"@en ;
	dc:source	pwn30:14084880-n .

<i110947>	a	<Concept> ;
	skos:definition	"injury to the brain that impairs its functions (especially permanently); can be caused by trauma to the head, infection, hemorrhage, inadequate oxygen, genetic abnormality, etc."@en ;
	dc:source	pwn30:14085220-n .

<i110948>	a	<Concept> ;
	skos:definition	"motionlessness attributable to a temporary paralysis"@en ;
	dc:source	pwn30:14085474-n .

<i110949>	a	<Concept> ;
	skos:definition	"paralysis of the vocal cords resulting in an inability to speak"@en ;
	dc:source	pwn30:14085592-n .

<i110950>	a	<Concept> ;
	skos:definition	"any disorder or disease of the brain"@en ;
	dc:source	pwn30:14085708-n .

<i110951>	a	<Concept> ;
	skos:definition	"paralysis of the urinary bladder"@en ;
	dc:source	pwn30:14086036-n .

<i110952>	a	<Concept> ;
	skos:definition	"a disorder of the central nervous system characterized by loss of consciousness and convulsions"@en ;
	dc:source	pwn30:14086143-n .

<i110953>	a	<Concept> ;
	skos:definition	"epilepsy characterized by akinesia"@en ;
	dc:source	pwn30:14086528-n .

<i110954>	a	<Concept> ;
	skos:definition	"epilepsy in which the attacks begins with an isolated disturbance of cerebral function (as a twitching of a limb or an illusory sensation or a mental disturbance)"@en ;
	dc:source	pwn30:14086626-n .

<i110955>	a	<Concept> ;
	skos:definition	"transitory disturbance in motor or sensory function resulting from abnormal cortical activity"@en ;
	dc:source	pwn30:14086924-n .

<i110956>	a	<Concept> ;
	skos:definition	"seizure caused by a sudden profuse hemorrhage"@en ;
	dc:source	pwn30:14087096-n .

<i110957>	a	<Concept> ;
	skos:definition	"paralysis of corresponding parts on both sides of the body"@en ;
	dc:source	pwn30:14087208-n .

<i110958>	a	<Concept> ;
	skos:definition	"the condition of being protuberant; the condition of bulging out"@en ;
	dc:source	pwn30:14087321-n .

<i110959>	a	<Concept> ;
	skos:definition	"epilepsy in which the attacks involve loss of consciousness and tonic spasms of the musculature followed by generalized jerking"@en ;
	dc:source	pwn30:14087513-n .

<i110960>	a	<Concept> ;
	skos:definition	"focal epilepsy in which the attack usually moves from distal to proximal limb muscles on the same side of the body"@en ;
	dc:source	pwn30:14087758-n .

<i110961>	a	<Concept> ;
	skos:definition	"epilepsy characterized by clonus of muscle groups and progressive mental deterioration and genetic origin"@en ;
	dc:source	pwn30:14087938-n .

<i110962>	a	<Concept> ;
	skos:definition	"epilepsy characterized by paroxysmal attacks of brief clouding of consciousness (and possibly other abnormalities)"@en ;
	dc:source	pwn30:14088127-n .

<i110963>	a	<Concept> ;
	skos:definition	"the occurrence of an abrupt, transient loss or impairment of consciousness (which is not subsequently remembered), sometimes with light twitching, fluttering eyelids, etc.; common in petit mal epilepsy"@en ;
	dc:source	pwn30:14088412-n .

<i110964>	a	<Concept> ;
	skos:definition	"an absence seizure accompanied by other abnormalities (atonia or automatisms or vasomotor changes)"@en ;
	dc:source	pwn30:14088758-n .

<i110965>	a	<Concept> ;
	skos:definition	"an absence seizure without other complications; followed by 3-per-sec brainwave spikes"@en ;
	dc:source	pwn30:14088918-n .

<i110966>	a	<Concept> ;
	skos:definition	"a transient impairment of cortical function demonstrable only by 3-per-second brainwave spikes"@en ;
	dc:source	pwn30:14089080-n .

<i110967>	a	<Concept> ;
	skos:definition	"reflex epilepsy induced by music"@en ;
	dc:source	pwn30:14089240-n .

<i110968>	a	<Concept> ;
	skos:definition	"reflex epilepsy induced by a flickering light"@en ;
	dc:source	pwn30:14089339-n .

<i110969>	a	<Concept> ;
	skos:definition	"a convulsive epileptic state caused by a head injury"@en ;
	dc:source	pwn30:14089450-n .

<i110970>	a	<Concept> ;
	skos:definition	"epilepsy in which a seizure is induced by whirling or running"@en ;
	dc:source	pwn30:14089592-n .

<i110971>	a	<Concept> ;
	skos:definition	"a severe or even fatal form of vaccinia that occurs mainly in persons with an immunological deficiency; characterized by progressive enlargement of the initial lesion"@en ;
	dc:source	pwn30:14089719-n .

<i110972>	a	<Concept> ;
	skos:definition	"epilepsy characterized clinically by impairment of consciousness and amnesia for the episode; often involves purposeful movements of the arms and legs and sometimes hallucinations"@en ;
	dc:source	pwn30:14089974-n .

<i110973>	a	<Concept> ;
	skos:definition	"a form of epilepsy in which attacks are induced by peripheral stimulation"@en ;
	dc:source	pwn30:14090245-n .

<i110974>	a	<Concept> ;
	skos:definition	"focal epilepsy initiated by somatosensory phenomena"@en ;
	dc:source	pwn30:14090416-n .

<i110975>	a	<Concept> ;
	skos:definition	"a condition in which there are continuing attacks of epilepsy without intervals of consciousness; can lead to brain damage and death"@en ;
	dc:source	pwn30:14090530-n .

<i110976>	a	<Concept> ;
	skos:definition	"epilepsy in which the body is rigid during the seizure"@en ;
	dc:source	pwn30:14090727-n .

<i110977>	a	<Concept> ;
	skos:definition	"paralysis of the arm resulting from injury to the brachial plexus (usually during childbirth)"@en ;
	dc:source	pwn30:14090842-n .

<i110978>	a	<Concept> ;
	skos:definition	"a frenzy of emotion; as for something unattainable"@en ;
	dc:source	pwn30:14091018-n .

<i110979>	a	<Concept> ;
	skos:definition	"inability to make purposeful movements"@en ;
	dc:source	pwn30:14091126-n .

<i110980>	a	<Concept> ;
	skos:definition	"inability to coordinate voluntary muscle movements; unsteady movements and staggering gait"@en ;
	dc:source	pwn30:14091254-n .

<i110981>	a	<Concept> ;
	skos:definition	"sclerosis of the posterior and lateral columns of the spinal cord; characterized by muscular weakness and abnormal gait; occurs in children"@en ;
	dc:source	pwn30:14091525-n .

<i110982>	a	<Concept> ;
	skos:definition	"nervous disorder of late childhood and early adulthood; characterized by ataxic gait and hesitating or explosive speech and nystagmus"@en ;
	dc:source	pwn30:14091757-n .

<i110983>	a	<Concept> ;
	skos:definition	"absence or loss of topognosia; inability to locate correctly a point of touch"@en ;
	dc:source	pwn30:14091965-n .

<i110984>	a	<Concept> ;
	skos:definition	"abnormal shortness of fingers and toes"@en ;
	dc:source	pwn30:14092114-n .

<i110985>	a	<Concept> ;
	skos:definition	"failure of one or both testes to move into the scrotum as the male fetus develops"@en ;
	dc:source	pwn30:14092247-n .

<i110986>	a	<Concept> ;
	skos:definition	"failure of one testes to descend into the scrotum"@en ;
	dc:source	pwn30:14092456-n .

<i110987>	a	<Concept> ;
	skos:definition	"abnormality in performing voluntary muscle movements"@en ;
	dc:source	pwn30:14092577-n .

<i110988>	a	<Concept> ;
	skos:definition	"involuntary rolling of the tongue and twitching of the face or trunk or limbs; often occurs in patients with Parkinsonism who are treated with phenothiazine"@en ;
	dc:source	pwn30:14092704-n .

<i110989>	a	<Concept> ;
	skos:definition	"abnormal displacement of any wall that separates two chambers (usually in the nasal cavity)"@en ;
	dc:source	pwn30:14092925-n .

<i110990>	a	<Concept> ;
	skos:definition	"abnormal shift in location of the nasal septum; a common condition causing obstruction of the nasal passages and difficulty in breathing and recurrent nosebleeds"@en ;
	dc:source	pwn30:14093096-n .

<i110991>	a	<Concept> ;
	skos:definition	"abnormal condition where the heart is located toward the right side of the chest"@en ;
	dc:source	pwn30:14093325-n .

<i110992>	a	<Concept> ;
	skos:definition	"congenital abnormality involving the absence of some fingers or toes"@en ;
	dc:source	pwn30:14093464-n .

<i110993>	a	<Concept> ;
	skos:definition	"an abnormally downward position of the intestines in the abdominal cavity"@en ;
	dc:source	pwn30:14093591-n .

<i110994>	a	<Concept> ;
	skos:definition	"an abnormally high degree of irritability or sensitivity to stimulation of an organ or body part"@en ;
	dc:source	pwn30:14093723-n .

<i110995>	a	<Concept> ;
	skos:definition	"an abnormal condition of a fetus; usually discovered during pregnancy and characterized by an abnormal heart rhythm"@en ;
	dc:source	pwn30:14093874-n .

<i110996>	a	<Concept> ;
	skos:definition	"a chronic progressive nervous disorder involving loss of myelin sheath around certain nerve fibers"@en ;
	dc:source	pwn30:14094068-n .

<i110997>	a	<Concept> ;
	skos:definition	"a degenerative disorder of the central nervous system characterized by tremor and impaired muscular coordination"@en ;
	dc:source	pwn30:14094350-n .

<i110998>	a	<Concept> ;
	skos:definition	"a loss or deficiency of motor control with involuntary spasms caused by permanent brain damage present at birth"@en ;
	dc:source	pwn30:14094653-n .

<i110999>	a	<Concept> ;
	skos:definition	"any of several degenerative nervous disorders characterized by spasmodic movements of the body and limbs"@en ;
	dc:source	pwn30:14094881-n .

<i111000>	a	<Concept> ;
	skos:definition	"a cerebral meningitis with cellular infiltration of the meninges"@en ;
	dc:source	pwn30:14095128-n .

<i111001>	a	<Concept> ;
	skos:definition	"weakness or loss of muscle tone resulting from injury or disease of the nerves innervating the muscles"@en ;
	dc:source	pwn30:14095273-n .

<i111002>	a	<Concept> ;
	skos:definition	"a form of chorea in which spasms occur mainly when the patient is erect"@en ;
	dc:source	pwn30:14095439-n .

<i111003>	a	<Concept> ;
	skos:definition	"chorea occurring chiefly in children and associated with rheumatic fever"@en ;
	dc:source	pwn30:14095568-n .

<i111004>	a	<Concept> ;
	skos:definition	"a nervous disorder characterized by an uncontrollable impulse to dance; popularly attributed to bite of the southern European tarantula or wolf spider"@en ;
	dc:source	pwn30:14095742-n .

<i111005>	a	<Concept> ;
	skos:definition	"a loss of the ability to write or to express thoughts in writing because of a brain lesion"@en ;
	dc:source	pwn30:14095948-n .

<i111006>	a	<Concept> ;
	skos:definition	"a disorder in which a lesion to the central nervous system leaves you unable to formulate a statement or to express yourself in an organized manner"@en ;
	dc:source	pwn30:14096123-n .

<i111007>	a	<Concept> ;
	skos:definition	"loss of the ability to swallow"@en ;
	dc:source	pwn30:14096328-n .

<i111008>	a	<Concept> ;
	skos:definition	"partial or total loss of sight without pathology of the eye; caused by disease of optic nerve or retina or brain"@en ;
	dc:source	pwn30:14096412-n .

<i111009>	a	<Concept> ;
	skos:definition	"visual impairment without apparent organic pathology"@en ;
	dc:source	pwn30:14096598-n .

<i111010>	a	<Concept> ;
	skos:definition	"(ophthalmology) faulty refraction of light rays in the eye as in astigmatism or myopia"@en ;
	dc:source	pwn30:14096724-n .

<i111011>	a	<Concept> ;
	skos:definition	"(ophthalmology) the normal refractive condition of the eye in which there is clear focus of light on the retina"@en ;
	dc:source	pwn30:14096957-n .

<i111012>	a	<Concept> ;
	skos:definition	"visual defect in which the shape and size of an ocular image differ in the two eyes"@en ;
	dc:source	pwn30:14097162-n .

<i111013>	a	<Concept> ;
	skos:definition	"distorted vision in which straight lines appear curved"@en ;
	dc:source	pwn30:14097321-n .

<i111014>	a	<Concept> ;
	skos:definition	"absence of the natural lens of the eye (usually resulting from the removal of cataracts)"@en ;
	dc:source	pwn30:14097432-n .

<i111015>	a	<Concept> ;
	skos:definition	"inability to use or understand language (spoken or written) because of a brain lesion"@en ;
	dc:source	pwn30:14097574-n .

<i111016>	a	<Concept> ;
	skos:definition	"an impairment in understanding spoken language that is not attributable to hearing loss"@en ;
	dc:source	pwn30:14097893-n .

<i111017>	a	<Concept> ;
	skos:definition	"aphasia in which the lesion is assumed to be in the association tracts connecting the various language centers in the brain; patient's have difficulty repeating a sentence just heard"@en ;
	dc:source	pwn30:14098078-n .

<i111018>	a	<Concept> ;
	skos:definition	"loss of all ability to communicate"@en ;
	dc:source	pwn30:14098347-n .

<i111019>	a	<Concept> ;
	skos:definition	"aphasia in which expression by speech or writing is severely impaired"@en ;
	dc:source	pwn30:14098458-n .

<i111020>	a	<Concept> ;
	skos:definition	"inability to name objects or to recognize written or spoken names of objects"@en ;
	dc:source	pwn30:14098663-n .

<i111021>	a	<Concept> ;
	skos:definition	"a general term for aphasia that results from lesions outside of Broca's area or Wernicke's area of the cerebral cortex"@en ;
	dc:source	pwn30:14098864-n .

<i111022>	a	<Concept> ;
	skos:definition	"inability to perceive written words"@en ;
	dc:source	pwn30:14099050-n .

<i111023>	a	<Concept> ;
	skos:definition	"aphasia characterized by fluent but meaningless speech and severe impairment of the ability understand spoken or written words"@en ;
	dc:source	pwn30:14099172-n .

<i111024>	a	<Concept> ;
	skos:definition	"impaired ability to learn grade-appropriate mathematics"@en ;
	dc:source	pwn30:14099439-n .

<i111025>	a	<Concept> ;
	skos:definition	"impaired ability to learn to write"@en ;
	dc:source	pwn30:14099552-n .

<i111026>	a	<Concept> ;
	skos:definition	"impaired ability to learn to read"@en ;
	dc:source	pwn30:14099643-n .

<i111027>	a	<Concept> ;
	skos:definition	"an impairment of language (especially speech production) that is usually due to brain damage"@en ;
	dc:source	pwn30:14099785-n .

<i111028>	a	<Concept> ;
	skos:definition	"inability to recognize objects by use of the senses"@en ;
	dc:source	pwn30:14099933-n .

<i111029>	a	<Concept> ;
	skos:definition	"partial or total loss of articulate speech resulting from lesions of the central nervous system"@en ;
	dc:source	pwn30:14100092-n .

<i111030>	a	<Concept> ;
	skos:definition	"inability to recognize or understand the meaning of spoken words"@en ;
	dc:source	pwn30:14100243-n .

<i111031>	a	<Concept> ;
	skos:definition	"inability to recognize or interpret objects in the visual field"@en ;
	dc:source	pwn30:14100370-n .

<i111032>	a	<Concept> ;
	skos:definition	"rare (usually fatal) brain disease (usually in middle age) caused by an unidentified slow virus; characterized by progressive dementia and gradual loss of muscle control"@en ;
	dc:source	pwn30:14100494-n .

<i111033>	a	<Concept> ;
	skos:definition	"closure or blockage (as of a blood vessel)"@en ;
	dc:source	pwn30:14100769-n .

<i111034>	a	<Concept> ;
	skos:definition	"a closure of the larynx that blocks the passage of air to the lungs"@en ;
	dc:source	pwn30:14100957-n .

<i111035>	a	<Concept> ;
	skos:definition	"occlusion of a blood vessel by an embolus (a loose clot or air bubble or other particle)"@en ;
	dc:source	pwn30:14101083-n .

<i111036>	a	<Concept> ;
	skos:definition	"obstruction of the circulatory system caused by an air bubble as, e.g., accidentally during surgery or hypodermic injection or as a complication from scuba diving"@en ;
	dc:source	pwn30:14101317-n .

<i111037>	a	<Concept> ;
	skos:definition	"serious condition in which fat blocks an artery; fat can enter the blood stream after a long bone is fractured or if adipose tissue is injured or as a result of a fatty liver"@en ;
	dc:source	pwn30:14101568-n .

<i111038>	a	<Concept> ;
	skos:definition	"blockage of the pulmonary artery by foreign matter or by a blood clot"@en ;
	dc:source	pwn30:14101801-n .

<i111039>	a	<Concept> ;
	skos:definition	"occlusion of a blood vessel by an embolus that has broken away from a thrombus"@en ;
	dc:source	pwn30:14101935-n .

<i111040>	a	<Concept> ;
	skos:definition	"the formation or presence of a thrombus (a clot of coagulated blood attached at the site of its formation) in a blood vessel"@en ;
	dc:source	pwn30:14102075-n .

<i111041>	a	<Concept> ;
	skos:definition	"a blood clot in a cerebral artery or vein"@en ;
	dc:source	pwn30:14102347-n .

<i111042>	a	<Concept> ;
	skos:definition	"occlusion of a coronary artery caused either by progressive atherosclerosis or by a blood clot"@en ;
	dc:source	pwn30:14102454-n .

<i111043>	a	<Concept> ;
	skos:definition	"a heart disease due to an abnormality of the arteries that supply blood and oxygen to the heart"@en ;
	dc:source	pwn30:14102631-n .

<i111044>	a	<Concept> ;
	skos:definition	"obstruction of blood flow in a coronary artery by a blood clot (thrombus)"@en ;
	dc:source	pwn30:14102831-n .

<i111045>	a	<Concept> ;
	skos:definition	"painful thrombosis of the femoral vein in the leg following childbirth"@en ;
	dc:source	pwn30:14103018-n .

<i111046>	a	<Concept> ;
	skos:definition	"abnormal enlargement of the liver"@en ;
	dc:source	pwn30:14103180-n .

<i111047>	a	<Concept> ;
	skos:definition	"a disease of the heart"@en ;
	dc:source	pwn30:14103288-n .

<i111048>	a	<Concept> ;
	skos:definition	"a common disorder in which blood pressure remains abnormally high (a reading of 140/90 mm Hg or greater)"@en ;
	dc:source	pwn30:14103510-n .

<i111049>	a	<Concept> ;
	skos:definition	"abnormal condition in which an organ is turned inward or inside out (as when the upper part of the uterus is pulled into the cervical canal after childbirth)"@en ;
	dc:source	pwn30:14103785-n .

<i111050>	a	<Concept> ;
	skos:definition	"any abnormal position of the organs of the body"@en ;
	dc:source	pwn30:14103998-n .

<i111051>	a	<Concept> ;
	skos:definition	"abnormal bulging of the cornea of the eye"@en ;
	dc:source	pwn30:14104118-n .

<i111052>	a	<Concept> ;
	skos:definition	"abnormal cone-shaped protrusion of the cornea of the eye; can be treated by epikeratophakia"@en ;
	dc:source	pwn30:14104218-n .

<i111053>	a	<Concept> ;
	skos:definition	"low blood pressure occurring in some people when they stand up"@en ;
	dc:source	pwn30:14104367-n .

<i111054>	a	<Concept> ;
	skos:definition	"abnormally low blood pressure"@en ;
	dc:source	pwn30:14104522-n .

<i111055>	a	<Concept> ;
	skos:definition	"persistent and pathological high blood pressure for which no specific cause can be found"@en ;
	dc:source	pwn30:14104645-n .

<i111056>	a	<Concept> ;
	skos:definition	"increase in blood pressure in the veins of the portal system caused by obstruction in the liver (often associated with alcoholic cirrhosis), causing enlargement of the spleen and collateral veins"@en ;
	dc:source	pwn30:14104830-n .

<i111057>	a	<Concept> ;
	skos:definition	"severe hypertension that runs a rapid course and damages the inner linings of the blood vessels and the heart and spleen and kidneys and brain"@en ;
	dc:source	pwn30:14105091-n .

<i111058>	a	<Concept> ;
	skos:definition	"hypertension that is secondary to another disease"@en ;
	dc:source	pwn30:14105386-n .

<i111059>	a	<Concept> ;
	skos:definition	"temporary rise in blood pressure in the doctor's office"@en ;
	dc:source	pwn30:14105504-n .

<i111060>	a	<Concept> ;
	skos:definition	"progressive wasting of muscle tissues"@en ;
	dc:source	pwn30:14105629-n .

<i111061>	a	<Concept> ;
	skos:definition	"thickening of tissue in the motor tracts of the lateral columns and anterior horns of the spinal cord; results in progressive muscle atrophy that starts in the limbs"@en ;
	dc:source	pwn30:14105737-n .

<i111062>	a	<Concept> ;
	skos:definition	"a cardiovascular disease characterized by a saclike widening of an artery resulting from weakening of the artery wall"@en ;
	dc:source	pwn30:14106025-n .

<i111063>	a	<Concept> ;
	skos:definition	"an aneurysm of the aorta"@en ;
	dc:source	pwn30:14106352-n .

<i111064>	a	<Concept> ;
	skos:definition	"an aneurysm of the abdominal aorta associated with old age and hypertension"@en ;
	dc:source	pwn30:14106456-n .

<i111065>	a	<Concept> ;
	skos:definition	"abnormal narrowing of the aortic valve"@en ;
	dc:source	pwn30:14106609-n .

<i111066>	a	<Concept> ;
	skos:definition	"abnormal narrowing of the intestine"@en ;
	dc:source	pwn30:14106727-n .

<i111067>	a	<Concept> ;
	skos:definition	"abnormal narrowing of the larynx"@en ;
	dc:source	pwn30:14106823-n .

<i111068>	a	<Concept> ;
	skos:definition	"abnormal narrowing of the opening into the pulmonary artery from the right ventricle"@en ;
	dc:source	pwn30:14106917-n .

<i111069>	a	<Concept> ;
	skos:definition	"narrowing of the pyloric sphincter that blocks the passage of food from the stomach into the duodenum"@en ;
	dc:source	pwn30:14107085-n .

<i111070>	a	<Concept> ;
	skos:definition	"narrowing of the passages in the nasal cavities"@en ;
	dc:source	pwn30:14107249-n .

<i111071>	a	<Concept> ;
	skos:definition	"abnormal narrowing of a bodily canal or passageway"@en ;
	dc:source	pwn30:14107374-n .

<i111072>	a	<Concept> ;
	skos:definition	"an aneurysm of the carotid artery"@en ;
	dc:source	pwn30:14107653-n .

<i111073>	a	<Concept> ;
	skos:definition	"an aneurysm of a cranial artery"@en ;
	dc:source	pwn30:14107750-n .

<i111074>	a	<Concept> ;
	skos:definition	"a localized dilation or protrusion on the wall of the left ventricle of the heart (occurring after a myocardial infarction)"@en ;
	dc:source	pwn30:14107849-n .

<i111075>	a	<Concept> ;
	skos:definition	"a heart condition marked by paroxysms of chest pain due to reduced oxygen to the heart"@en ;
	dc:source	pwn30:14108039-n .

<i111076>	a	<Concept> ;
	skos:definition	"sclerosis of the arterioles"@en ;
	dc:source	pwn30:14108232-n .

<i111077>	a	<Concept> ;
	skos:definition	"sclerosis of the arterial walls"@en ;
	dc:source	pwn30:14108324-n .

<i111078>	a	<Concept> ;
	skos:definition	"the formation of atheromas on the walls of the arteries as in atherosclerosis"@en ;
	dc:source	pwn30:14108576-n .

<i111079>	a	<Concept> ;
	skos:definition	"a stage of arteriosclerosis involving fatty deposits (atheromas) inside the arterial walls, thus narrowing the arteries"@en ;
	dc:source	pwn30:14108713-n .

<i111080>	a	<Concept> ;
	skos:definition	"a continuous succession of slow, writhing, involuntary movements of the hands and feet and other body parts"@en ;
	dc:source	pwn30:14108938-n .

<i111081>	a	<Concept> ;
	skos:definition	"a progressive disease of the central nervous system marked by increasing lack of coordination and advancing to paralysis and death within a year of the appearance of symptoms; thought to have been transmitted by cannibalistic consumption of diseased brain tissue since the disease virtually disappeared when cannibalism was abandoned"@en ;
	dc:source	pwn30:14109101-n .

<i111082>	a	<Concept> ;
	skos:definition	"harmful pressure on a nerve (especially in nerves that pass over rigid prominences); causes nerve damage and muscle weakness"@en ;
	dc:source	pwn30:14109485-n .

<i111083>	a	<Concept> ;
	skos:definition	"repeated and long-term nerve compression (usually in nerves near joints that are subject to inflammation or swelling)"@en ;
	dc:source	pwn30:14109691-n .

<i111084>	a	<Concept> ;
	skos:definition	"a stage of arteriosclerosis involving closure of blood vessels"@en ;
	dc:source	pwn30:14109889-n .

<i111085>	a	<Concept> ;
	skos:definition	"accumulation of serous fluid in peritoneal cavity"@en ;
	dc:source	pwn30:14110025-n .

<i111086>	a	<Concept> ;
	skos:definition	"absence of an enzyme"@en ;
	dc:source	pwn30:14110146-n .

<i111087>	a	<Concept> ;
	skos:definition	"transient presence of bacteria (or other microorganisms) in the blood"@en ;
	dc:source	pwn30:14110219-n .

<i111088>	a	<Concept> ;
	skos:definition	"any pathological hardening or thickening of tissue"@en ;
	dc:source	pwn30:14110411-n .

<i111089>	a	<Concept> ;
	skos:definition	"an abnormal rate of muscle contractions in the heart"@en ;
	dc:source	pwn30:14110674-n .

<i111090>	a	<Concept> ;
	skos:definition	"a disorder (usually of unknown origin) of the heart muscle (myocardium)"@en ;
	dc:source	pwn30:14110966-n .

<i111091>	a	<Concept> ;
	skos:definition	"a disorder in which the heart muscle is so strong that it does not relax enough to fill with the heart with blood and so has reduced pumping ability"@en ;
	dc:source	pwn30:14111133-n .

<i111092>	a	<Concept> ;
	skos:definition	"abnormally rapid beating of the auricles of the heart (especially in a regular rhythm); can result in heart block"@en ;
	dc:source	pwn30:14111355-n .

<i111093>	a	<Concept> ;
	skos:definition	"cardiac rhythm characterized by the presence of an extra sound; can indicate a heart abnormality"@en ;
	dc:source	pwn30:14111540-n .

<i111094>	a	<Concept> ;
	skos:definition	"cardiopathy resulting from the mitral valve not regulating the flow of blood between the left atrium and left ventricle of the heart"@en ;
	dc:source	pwn30:14111715-n .

<i111095>	a	<Concept> ;
	skos:definition	"obstruction or narrowing of the mitral valve (as by scarring from rheumatic fever)"@en ;
	dc:source	pwn30:14111915-n .

<i111096>	a	<Concept> ;
	skos:definition	"failure of the cardiovascular system to supply adequate amounts of blood to body tissues"@en ;
	dc:source	pwn30:14112101-n .

<i111097>	a	<Concept> ;
	skos:definition	"inability of the heart to pump enough blood to sustain normal bodily functions"@en ;
	dc:source	pwn30:14112255-n .

<i111098>	a	<Concept> ;
	skos:definition	"heart disease caused by stenosis of the cardiac valves and obstructed blood flow or caused by degeneration and blood regurgitation"@en ;
	dc:source	pwn30:14112466-n .

<i111099>	a	<Concept> ;
	skos:definition	"inability to pump enough blood to avoid congestion in the tissues"@en ;
	dc:source	pwn30:14112719-n .

<i111100>	a	<Concept> ;
	skos:definition	"a sudden severe instance of abnormal heart function"@en ;
	dc:source	pwn30:14112855-n .

<i111101>	a	<Concept> ;
	skos:definition	"destruction of heart tissue resulting from obstruction of the blood supply to the heart muscle"@en ;
	dc:source	pwn30:14113021-n .

<i111102>	a	<Concept> ;
	skos:definition	"a disease affecting the kidneys"@en ;
	dc:source	pwn30:14113228-n .

<i111103>	a	<Concept> ;
	skos:definition	"(pathology) inability of a bodily part or organ to function normally"@en ;
	dc:source	pwn30:14113471-n .

<i111104>	a	<Concept> ;
	skos:definition	"inadequate blood flow to the heart muscles; can cause angina pectoris"@en ;
	dc:source	pwn30:14113636-n .

<i111105>	a	<Concept> ;
	skos:definition	"an inflammation of the kidney"@en ;
	dc:source	pwn30:14113798-n .

<i111106>	a	<Concept> ;
	skos:definition	"kidney disease that is usually associated with hypertension; sclerosis of the renal arterioles reduces blood flow that can lead to kidney failure and heart failure"@en ;
	dc:source	pwn30:14113938-n .

<i111107>	a	<Concept> ;
	skos:definition	"kidney disease characterized by enlarged kidneys containing many cysts; often leads to kidney failure"@en ;
	dc:source	pwn30:14114186-n .

<i111108>	a	<Concept> ;
	skos:definition	"renal disorder characterized by the production of large volumes of pale dilute urine; often associated with diabetes"@en ;
	dc:source	pwn30:14114365-n .

<i111109>	a	<Concept> ;
	skos:definition	"inability of the kidneys to excrete wastes and to help maintain the electrolyte balance"@en ;
	dc:source	pwn30:14114555-n .

<i111110>	a	<Concept> ;
	skos:definition	"insufficient excretion of wastes by the kidneys"@en ;
	dc:source	pwn30:14114773-n .

<i111111>	a	<Concept> ;
	skos:definition	"renal failure associated with burns or other trauma or with acute infection or obstruction of the urinary tract"@en ;
	dc:source	pwn30:14114886-n .

<i111112>	a	<Concept> ;
	skos:definition	"renal failure that can result from a variety of systemic disorders"@en ;
	dc:source	pwn30:14115086-n .

<i111113>	a	<Concept> ;
	skos:definition	"the presence of gallstones in the gallbladder"@en ;
	dc:source	pwn30:14115245-n .

<i111114>	a	<Concept> ;
	skos:definition	"the presence of calculi in the intestines"@en ;
	dc:source	pwn30:14115351-n .

<i111115>	a	<Concept> ;
	skos:definition	"renal lithiasis in which calcium deposits form in the renal parenchyma and result in reduced kidney function and blood in the urine"@en ;
	dc:source	pwn30:14115454-n .

<i111116>	a	<Concept> ;
	skos:definition	"the presence of kidney stones (calculi) in the kidney"@en ;
	dc:source	pwn30:14115648-n .

<i111117>	a	<Concept> ;
	skos:definition	"pathology in which fat accumulates in lipomas in the body"@en ;
	dc:source	pwn30:14115799-n .

<i111118>	a	<Concept> ;
	skos:definition	"the formation of stones (calculi) in an internal organ"@en ;
	dc:source	pwn30:14115914-n .

<i111119>	a	<Concept> ;
	skos:definition	"nephritis marked by inflammation of the glomeruli of the kidney; characterized by decreased production of urine and by the presence of blood and protein in the urine and by edema"@en ;
	dc:source	pwn30:14116078-n .

<i111120>	a	<Concept> ;
	skos:definition	"a disease affecting the liver"@en ;
	dc:source	pwn30:14116321-n .

<i111121>	a	<Concept> ;
	skos:definition	"a chronic disease interfering with the normal functioning of the liver; the major cause is chronic alcoholism"@en ;
	dc:source	pwn30:14116482-n .

<i111122>	a	<Concept> ;
	skos:definition	"yellow discoloration as a result of the accumulation of certain fats (triglycerides) in the liver; can be caused by alcoholic cirrhosis or pregnancy or exposure to certain toxins"@en ;
	dc:source	pwn30:14116672-n .

<i111123>	a	<Concept> ;
	skos:definition	"a glandular disorder caused by failure of function of the cortex of the adrenal gland and marked by anemia and prostration with brownish skin"@en ;
	dc:source	pwn30:14116908-n .

<i111124>	a	<Concept> ;
	skos:definition	"a glandular disease or enlargement of glandular tissue (especially of the lymph glands)"@en ;
	dc:source	pwn30:14117173-n .

<i111125>	a	<Concept> ;
	skos:definition	"a condition caused by overproduction of aldosterone"@en ;
	dc:source	pwn30:14117317-n .

<i111126>	a	<Concept> ;
	skos:definition	"a glandular disorder caused by excessive ACTH resulting in greater than normal functioning of the adrenal gland; characterized by obesity"@en ;
	dc:source	pwn30:14117449-n .

<i111127>	a	<Concept> ;
	skos:definition	"a glandular disorder caused by excessive cortisol"@en ;
	dc:source	pwn30:14117668-n .

<i111128>	a	<Concept> ;
	skos:definition	"a polygenic disease characterized by abnormally high glucose levels in the blood; any of several metabolic disorders marked by excessive urination and persistent thirst"@en ;
	dc:source	pwn30:14117805-n .

<i111129>	a	<Concept> ;
	skos:definition	"diabetes caused by a relative or absolute deficiency of insulin and characterized by polyuria"@en ;
	dc:source	pwn30:14118138-n .

<i111130>	a	<Concept> ;
	skos:definition	"severe diabetes mellitus with an early onset; characterized by polyuria and excessive thirst and increased appetite and weight loss and episodic ketoacidosis; diet and insulin injections are required to control the disease"@en ;
	dc:source	pwn30:14118423-n .

<i111131>	a	<Concept> ;
	skos:definition	"mild form of diabetes mellitus that develops gradually in adults; can be precipitated by obesity or severe stress or menopause or other factors; can usually be controlled by diet and hypoglycemic agents without injections of insulin"@en ;
	dc:source	pwn30:14118936-n .

<i111132>	a	<Concept> ;
	skos:definition	"diabetes insipidus caused by a failure of the kidney to respond to normal levels of vasopressin"@en ;
	dc:source	pwn30:14119598-n .

<i111133>	a	<Concept> ;
	skos:definition	"a rare form of diabetes resulting from a deficiency of vasopressin (the pituitary hormone that regulates the kidneys); characterized by the chronic excretion of large amounts of pale dilute urine which results in dehydration and extreme thirst"@en ;
	dc:source	pwn30:14119770-n .

<i111134>	a	<Concept> ;
	skos:definition	"a mild form of diabetes mellitus in which there are no overt symptoms but there are abnormal responses to some diagnostic procedures"@en ;
	dc:source	pwn30:14120096-n .

<i111135>	a	<Concept> ;
	skos:definition	"recurrent large circumscribed areas of subcutaneous edema; onset is sudden and it disappears within 24 hours; seen mainly in young women, often as an allergic reaction to food or drugs"@en ;
	dc:source	pwn30:14120310-n .

<i111136>	a	<Concept> ;
	skos:definition	"swelling (usually in the legs) caused by lymph accumulating in the tissues in the affected areas"@en ;
	dc:source	pwn30:14120614-n .

<i111137>	a	<Concept> ;
	skos:definition	"an overactive thyroid gland; pathologically excessive production of thyroid hormones or the condition resulting from excessive production of thyroid hormones"@en ;
	dc:source	pwn30:14120767-n .

<i111138>	a	<Concept> ;
	skos:definition	"exophthalmos occurring in association with goiter; hyperthyroidism with protrusion of the eyeballs"@en ;
	dc:source	pwn30:14121058-n .

<i111139>	a	<Concept> ;
	skos:definition	"an underactive thyroid gland; a glandular disorder resulting from insufficient production of thyroid hormones"@en ;
	dc:source	pwn30:14121276-n .

<i111140>	a	<Concept> ;
	skos:definition	"hypothyroidism marked by dry skin and swellings around lips and nose as well as mental deterioration"@en ;
	dc:source	pwn30:14121500-n .

<i111141>	a	<Concept> ;
	skos:definition	"severe hypothyroidism resulting in physical and mental stunting"@en ;
	dc:source	pwn30:14121667-n .

<i111142>	a	<Concept> ;
	skos:definition	"an inherited skeletal disorder beginning before birth; cartilage is converted to bone resulting in dwarfism"@en ;
	dc:source	pwn30:14121804-n .

<i111143>	a	<Concept> ;
	skos:definition	"a disease that can be communicated from one person to another"@en ;
	dc:source	pwn30:14122053-n .

<i111144>	a	<Concept> ;
	skos:definition	"any disease easily transmitted by contact"@en ;
	dc:source	pwn30:14122235-n .

<i111145>	a	<Concept> ;
	skos:definition	"an acute febrile highly contagious viral disease"@en ;
	dc:source	pwn30:14122497-n .

<i111146>	a	<Concept> ;
	skos:definition	"influenza caused by the Asian virus that was first isolated in 1957"@en ;
	dc:source	pwn30:14122670-n .

<i111147>	a	<Concept> ;
	skos:definition	"an acute and highly contagious respiratory disease of swine caused by the orthomyxovirus thought to be the same virus that caused the 1918 influenza pandemic"@en ;
	dc:source	pwn30:14122813-n .

<i111148>	a	<Concept> ;
	skos:definition	"an acute and highly contagious viral disease marked by distinct red spots followed by a rash; occurs primarily in children"@en ;
	dc:source	pwn30:14123044-n .

<i111149>	a	<Concept> ;
	skos:definition	"a contagious viral disease that is a milder form of measles lasting three or four days; can be damaging to a fetus during the first trimester"@en ;
	dc:source	pwn30:14123259-n .

<i111150>	a	<Concept> ;
	skos:definition	"acute contagious infection caused by the bacterium Corynebacterium diphtheriae; marked by the formation of a false membrane in the throat and other air passages causing difficulty in breathing"@en ;
	dc:source	pwn30:14123510-n .

<i111151>	a	<Concept> ;
	skos:definition	"a viral disease of infants and young children; characterized by abrupt high fever and mild sore throat; a few days later there is a faint pinkish rash that lasts for a few hours to a few days"@en ;
	dc:source	pwn30:14123759-n .

<i111152>	a	<Concept> ;
	skos:definition	"an acute communicable disease (usually in children) characterized by fever and a red rash"@en ;
	dc:source	pwn30:14124070-n .

<i111153>	a	<Concept> ;
	skos:definition	"a contagious disease characterized by purulent skin eruptions that may leave pock marks"@en ;
	dc:source	pwn30:14124232-n .

<i111154>	a	<Concept> ;
	skos:definition	"a highly contagious viral disease characterized by fever and weakness and skin eruption with pustules that form scabs that slough off leaving scars"@en ;
	dc:source	pwn30:14124423-n .

<i111155>	a	<Concept> ;
	skos:definition	"a mild form of smallpox caused by a less virulent form of the virus"@en ;
	dc:source	pwn30:14124688-n .

<i111156>	a	<Concept> ;
	skos:definition	"an acute communicable infection of the respiratory tract and mouth marked by ulceration of the mucous membrane"@en ;
	dc:source	pwn30:14124931-n .

<i111157>	a	<Concept> ;
	skos:definition	"any of several infections of the skin or mucous membrane caused by Blastomyces"@en ;
	dc:source	pwn30:14125159-n .

<i111158>	a	<Concept> ;
	skos:definition	"a fungal infection characterized by itchy warty nodules on the skin"@en ;
	dc:source	pwn30:14125333-n .

<i111159>	a	<Concept> ;
	skos:definition	"infections of the skin or nails caused by fungi and appearing as itching circular patches"@en ;
	dc:source	pwn30:14125466-n .

<i111160>	a	<Concept> ;
	skos:definition	"fungal infection attacking moist parts of the body"@en ;
	dc:source	pwn30:14125774-n .

<i111161>	a	<Concept> ;
	skos:definition	"ringworm infection of the hair follicles of the scalp and beard that usually results in a swelling that is covered with pustules and oozes fluid"@en ;
	dc:source	pwn30:14125881-n .

<i111162>	a	<Concept> ;
	skos:definition	"fungal infection of the feet"@en ;
	dc:source	pwn30:14126078-n .

<i111163>	a	<Concept> ;
	skos:definition	"fungal infection of the face and neck"@en ;
	dc:source	pwn30:14126181-n .

<i111164>	a	<Concept> ;
	skos:definition	"fungal infection of the scalp characterized by bald patches"@en ;
	dc:source	pwn30:14126293-n .

<i111165>	a	<Concept> ;
	skos:definition	"fungal infection of nonhairy parts of the skin"@en ;
	dc:source	pwn30:14126412-n .

<i111166>	a	<Concept> ;
	skos:definition	"fungal infection of the groin (most common in men)"@en ;
	dc:source	pwn30:14126519-n .

<i111167>	a	<Concept> ;
	skos:definition	"the state of being blind or lacking sight"@en ;
	dc:source	pwn30:14126660-n .

<i111168>	a	<Concept> ;
	skos:definition	"vision that is 20/200 or worse in both eyes (20/200 vision is the ability to see at 20 feet what a normal eye can see at 200 feet)"@en ;
	dc:source	pwn30:14126908-n .

<i111169>	a	<Concept> ;
	skos:definition	"fungal infection of the nails (especially toenails)"@en ;
	dc:source	pwn30:14127100-n .

<i111170>	a	<Concept> ;
	skos:definition	"a disease transmitted only by a specific kind of contact"@en ;
	dc:source	pwn30:14127211-n .

<i111171>	a	<Concept> ;
	skos:definition	"a serious (often fatal) disease of the immune system transmitted through blood products especially by sexual contact or contaminated needles"@en ;
	dc:source	pwn30:14127782-n .

<i111172>	a	<Concept> ;
	skos:definition	"infectious bacterial disease of human beings transmitted by contact with infected animals or infected meat or milk products; characterized by fever and headache"@en ;
	dc:source	pwn30:14128029-n .

<i111173>	a	<Concept> ;
	skos:definition	"a rare immunological disorder characterized by the virtual absence of gamma globulin in the blood and consequent susceptibility to infection"@en ;
	dc:source	pwn30:14128331-n .

<i111174>	a	<Concept> ;
	skos:definition	"reduction or lack of an immune response to a specific antigen"@en ;
	dc:source	pwn30:14128536-n .

<i111175>	a	<Concept> ;
	skos:definition	"an abnormally low concentration of gamma globulin in the blood and increased risk of infection"@en ;
	dc:source	pwn30:14128650-n .

<i111176>	a	<Concept> ;
	skos:definition	"a congenital disease affecting T cells that can result from a mutation in any one of several different genes; children with it are susceptible to infectious disease; if untreated it is lethal within the first year or two of life"@en ;
	dc:source	pwn30:14128812-n .

<i111177>	a	<Concept> ;
	skos:definition	"SCID resulting from mutation of a gene that codes for adenosine deaminase"@en ;
	dc:source	pwn30:14129223-n .

<i111178>	a	<Concept> ;
	skos:definition	"SCID in male children resulting from mutation of a gene that codes for a protein on the surface of T cells that allows them to develop a growth factor receptor"@en ;
	dc:source	pwn30:14129351-n .

<i111179>	a	<Concept> ;
	skos:definition	"an acute intestinal infection caused by ingestion of contaminated water or food"@en ;
	dc:source	pwn30:14129579-n .

<i111180>	a	<Concept> ;
	skos:definition	"an infectious disease of the tropics transmitted by mosquitoes and characterized by rash and aching head and joints"@en ;
	dc:source	pwn30:14129784-n .

<i111181>	a	<Concept> ;
	skos:definition	"an infection of the intestines marked by severe diarrhea"@en ;
	dc:source	pwn30:14129999-n .

<i111182>	a	<Concept> ;
	skos:definition	"any infectious disease that develops and spreads rapidly to many people"@en ;
	dc:source	pwn30:14130166-n .

<i111183>	a	<Concept> ;
	skos:definition	"inflammation of the liver caused by a virus or a toxin"@en ;
	dc:source	pwn30:14130354-n .

<i111184>	a	<Concept> ;
	skos:definition	"hepatitis caused by a virus"@en ;
	dc:source	pwn30:14130518-n .

<i111185>	a	<Concept> ;
	skos:definition	"an acute but benign form of viral hepatitis caused by an RNA virus that does not persist in the blood serum and is usually transmitted by ingesting food or drink that is contaminated with fecal matter"@en ;
	dc:source	pwn30:14130661-n .

<i111186>	a	<Concept> ;
	skos:definition	"an acute (sometimes fatal) form of viral hepatitis caused by a DNA virus that tends to persist in the blood serum and is transmitted by sexual contact or by transfusion or by ingestion of contaminated blood or other bodily fluids"@en ;
	dc:source	pwn30:14130942-n .

<i111187>	a	<Concept> ;
	skos:definition	"a severe form of hepatitis"@en ;
	dc:source	pwn30:14131247-n .

<i111188>	a	<Concept> ;
	skos:definition	"a viral hepatitis clinically indistinguishable from hepatitis B but caused by a single-stranded RNA virus; usually transmitted by parenteral means (as injection of an illicit drug or blood transfusion or exposure to blood or blood products)"@en ;
	dc:source	pwn30:14131353-n .

<i111189>	a	<Concept> ;
	skos:definition	"malignant neoplastic disease of the liver usually occurring as a metastasis from another cancer; symptoms include loss of appetite and weakness and bloating and jaundice and upper abdominal discomfort"@en ;
	dc:source	pwn30:14131651-n .

<i111190>	a	<Concept> ;
	skos:definition	"viral diseases causing eruptions of the skin or mucous membrane"@en ;
	dc:source	pwn30:14131950-n .

<i111191>	a	<Concept> ;
	skos:definition	"an infection caused by the herpes simplex virus; affects the skin and nervous system; produces small temporary (but sometimes painful) blisters on the skin and mucous membranes"@en ;
	dc:source	pwn30:14132102-n .

<i111192>	a	<Concept> ;
	skos:definition	"caused by herpes simplex virus type 1 (HSV-1)"@en ;
	dc:source	pwn30:14132375-n .

<i111193>	a	<Concept> ;
	skos:definition	"an infection caused by herpes simplex virus type 2 (HSV-2) that is usually transmitted by sexual contact; marked by recurrent attacks of painful eruptions on the skin and mucous membranes of the genital area"@en ;
	dc:source	pwn30:14132524-n .

<i111194>	a	<Concept> ;
	skos:definition	"eruptions along a nerve path often accompanied by severe neuralgia"@en ;
	dc:source	pwn30:14132829-n .

<i111195>	a	<Concept> ;
	skos:definition	"an acute contagious disease caused by herpes varicella zoster virus; causes a rash of vesicles on the face and body"@en ;
	dc:source	pwn30:14132975-n .

<i111196>	a	<Concept> ;
	skos:definition	"a communicable infection transmitted by sexual intercourse or genital contact"@en ;
	dc:source	pwn30:14133159-n .

<i111197>	a	<Concept> ;
	skos:definition	"a common venereal disease caused by the bacterium Neisseria gonorrhoeae; symptoms are painful urination and pain around the urethra"@en ;
	dc:source	pwn30:14133543-n .

<i111198>	a	<Concept> ;
	skos:definition	"a venereal disease caused by a bacterium of the genus Calymmatobacterium; characterized by a pimply rash of the skin in the genital and groin region"@en ;
	dc:source	pwn30:14133750-n .

<i111199>	a	<Concept> ;
	skos:definition	"a common venereal disease caused by the treponema pallidum spirochete; symptoms change through progressive stages; can be congenital (transmitted through the placenta)"@en ;
	dc:source	pwn30:14133985-n .

<i111200>	a	<Concept> ;
	skos:definition	"the first stage; characterized by a chancre at the site of infection"@en ;
	dc:source	pwn30:14134351-n .

<i111201>	a	<Concept> ;
	skos:definition	"the second stage; characterized by eruptions of the skin and mucous membrane"@en ;
	dc:source	pwn30:14134482-n .

<i111202>	a	<Concept> ;
	skos:definition	"the third stage; characterized by involvement of internal organs especially the brain and spinal cord as well as the heart and liver"@en ;
	dc:source	pwn30:14134623-n .

<i111203>	a	<Concept> ;
	skos:definition	"syphilis of the spinal cord characterized by degeneration of sensory neurons and stabbing pains in the trunk and legs and unsteady gait and incontinence and impotence"@en ;
	dc:source	pwn30:14134819-n .

<i111204>	a	<Concept> ;
	skos:definition	"syphilis of the central nervous system"@en ;
	dc:source	pwn30:14135065-n .

<i111205>	a	<Concept> ;
	skos:definition	"wasting of the body during a chronic disease"@en ;
	dc:source	pwn30:14135181-n .

<i111206>	a	<Concept> ;
	skos:definition	"an acute disease characterized by fever and swollen lymph nodes and an abnormal increase of mononuclear leucocytes or monocytes in the bloodstream; not highly contagious; some believe it can be transmitted by kissing"@en ;
	dc:source	pwn30:14135277-n .

<i111207>	a	<Concept> ;
	skos:definition	"a severe and often fatal disease in humans and nonhuman primates (monkeys and chimpanzees) caused by the Ebola virus; characterized by high fever and severe internal bleeding; can be spread from person to person; is largely limited to Africa"@en ;
	dc:source	pwn30:14135623-n .

<i111208>	a	<Concept> ;
	skos:definition	"an acute contagious viral disease of central western Africa; characterized by fever and inflammation and muscular pains and difficulty swallowing; can be used as a bioweapon"@en ;
	dc:source	pwn30:14135956-n .

<i111209>	a	<Concept> ;
	skos:definition	"chronic granulomatous communicable disease occurring in tropical and subtropical regions; characterized by inflamed nodules beneath the skin and wasting of body parts; caused by the bacillus Mycobacterium leprae"@en ;
	dc:source	pwn30:14136187-n .

<i111210>	a	<Concept> ;
	skos:definition	"leprosy characterized by tumors in the skin and cutaneous nerves"@en ;
	dc:source	pwn30:14136544-n .

<i111211>	a	<Concept> ;
	skos:definition	"a very serious form of leprosy characterized by lesions that spread over much of the body and affecting many systems of the body"@en ;
	dc:source	pwn30:14136674-n .

<i111212>	a	<Concept> ;
	skos:definition	"an acute inflammatory disease occurring in the intestines of premature infants; necrosis of intestinal tissue may follow"@en ;
	dc:source	pwn30:14136868-n .

<i111213>	a	<Concept> ;
	skos:definition	"an infectious disease of animals and humans (especially newborn or immunosuppressed persons) caused by the bacterium Listeria monocytogenes; in sheep and cattle the infection frequently involves the central nervous system and causes various neurological symptoms"@en ;
	dc:source	pwn30:14137066-n .

<i111214>	a	<Concept> ;
	skos:definition	"a form of viral meningitis caused by a virus carried by the common house mouse"@en ;
	dc:source	pwn30:14137408-n .

<i111215>	a	<Concept> ;
	skos:definition	"infectious disease caused by a species of chlamydia bacterium; transmitted by sexual contact; characterized by genital lesions and swelling of lymph nodes in the groin"@en ;
	dc:source	pwn30:14137561-n .

<i111216>	a	<Concept> ;
	skos:definition	"infectious disease characterized by inflammation of the meninges (the tissues that surround the brain or spinal cord) usually caused by a bacterial infection; symptoms include headache and stiff neck and fever and nausea"@en ;
	dc:source	pwn30:14137829-n .

<i111217>	a	<Concept> ;
	skos:definition	"an acute contagious viral disease characterized by fever and by swelling of the parotid glands"@en ;
	dc:source	pwn30:14138178-n .

<i111218>	a	<Concept> ;
	skos:definition	"meningitis caused by bacteria and often fatal"@en ;
	dc:source	pwn30:14138364-n .

<i111219>	a	<Concept> ;
	skos:definition	"any of a variety of infectious intestinal diseases resembling typhoid fever"@en ;
	dc:source	pwn30:14138538-n .

<i111220>	a	<Concept> ;
	skos:definition	"a serious (sometimes fatal) infection of rodents caused by Yersinia pestis and accidentally transmitted to humans by the bite of a flea that has bitten an infected animal"@en ;
	dc:source	pwn30:14138691-n .

<i111221>	a	<Concept> ;
	skos:definition	"the most common form of the plague in humans; characterized by chills, prostration, delirium and the formation of buboes in the armpits and groin; does not spread from person to person"@en ;
	dc:source	pwn30:14139015-n .

<i111222>	a	<Concept> ;
	skos:definition	"a mild form of bubonic plague"@en ;
	dc:source	pwn30:14139333-n .

<i111223>	a	<Concept> ;
	skos:definition	"the epidemic form of bubonic plague experienced during the Middle Ages when it killed nearly half the people of western Europe"@en ;
	dc:source	pwn30:14139462-n .

<i111224>	a	<Concept> ;
	skos:definition	"a rapidly progressive and frequently fatal form of the plague that can spread through the air from person to person; characterized by lung involvement with chill, bloody expectoration and high fever"@en ;
	dc:source	pwn30:14139661-n .

<i111225>	a	<Concept> ;
	skos:definition	"an especially dangerous and generally fatal form of the plague in which infecting organisms invade the bloodstream; does not spread from person to person"@en ;
	dc:source	pwn30:14139959-n .

<i111226>	a	<Concept> ;
	skos:definition	"an acute viral disease marked by inflammation of nerve cells of the brain stem and spinal cord"@en ;
	dc:source	pwn30:14140176-n .

<i111227>	a	<Concept> ;
	skos:definition	"TB of the spine with destruction of vertebrae resulting in curvature of the spine"@en ;
	dc:source	pwn30:14140391-n .

<i111228>	a	<Concept> ;
	skos:definition	"either of two infectious diseases transmitted to humans by the bite of a rat or mouse; characterized by fever and headache and nausea and skin eruptions"@en ;
	dc:source	pwn30:14140533-n .

<i111229>	a	<Concept> ;
	skos:definition	"infectious disease caused by ticks or mites or body lice infected with rickettsial bacteria"@en ;
	dc:source	pwn30:14140781-n .

<i111230>	a	<Concept> ;
	skos:definition	"rickettsial disease transmitted by body lice and characterized by skin rash and high fever"@en ;
	dc:source	pwn30:14141062-n .

<i111231>	a	<Concept> ;
	skos:definition	"acute infection caused by rickettsia and transmitted by the bite of an infected flea; characterized by fever and chills and muscle aches and a rash"@en ;
	dc:source	pwn30:14141238-n .

<i111232>	a	<Concept> ;
	skos:definition	"any of several severe febrile diseases characterized by skin rashes or spots on the skin"@en ;
	dc:source	pwn30:14141490-n .

<i111233>	a	<Concept> ;
	skos:definition	"caused by rickettsial bacteria and transmitted by wood ticks"@en ;
	dc:source	pwn30:14141656-n .

<i111234>	a	<Concept> ;
	skos:definition	"an acute disease resembling influenza"@en ;
	dc:source	pwn30:14141821-n .

<i111235>	a	<Concept> ;
	skos:definition	"mild infectious rickettsial disease caused by a bacterium of the genus Rickettsia transmitted to humans by the bite a mite that lives on rodents; characterized by chills and fever and headache and skin lesions that resemble chickenpox"@en ;
	dc:source	pwn30:14141912-n .

<i111236>	a	<Concept> ;
	skos:definition	"marked by pain in muscles and joints and transmitted by lice"@en ;
	dc:source	pwn30:14142207-n .

<i111237>	a	<Concept> ;
	skos:definition	"transmitted by larval mites and widespread in Asia"@en ;
	dc:source	pwn30:14142326-n .

<i111238>	a	<Concept> ;
	skos:definition	"marked by recurring high fever and transmitted by the bite of infected lice or ticks; characterized by episodes of high fever and chills and headache and muscle pain and nausea that recur every week or ten days for several months"@en ;
	dc:source	pwn30:14142459-n .

<i111239>	a	<Concept> ;
	skos:definition	"a severe disease chiefly of children and characterized by painful inflammation of the joints and frequently damage to the heart valves"@en ;
	dc:source	pwn30:14142768-n .

<i111240>	a	<Concept> ;
	skos:definition	"heart disease caused by recurrent episodes of rheumatic fever; characterized by changes in the myocardium or scarring of the heart valves that reduce the power of the heart to pump blood"@en ;
	dc:source	pwn30:14142983-n .

<i111241>	a	<Concept> ;
	skos:definition	"epidemic in the 15th and 16th centuries and characterized by profuse sweating and high mortality"@en ;
	dc:source	pwn30:14143239-n .

<i111242>	a	<Concept> ;
	skos:definition	"infection transmitted by inhalation or ingestion of tubercle bacilli and manifested in fever and small lesions (usually in the lungs but in various other parts of the body in acute stages)"@en ;
	dc:source	pwn30:14143415-n .

<i111243>	a	<Concept> ;
	skos:definition	"acute tuberculosis characterized by the appearance of tiny tubercles on one or more organs of the body (presumably resulting from tubercle bacilli being spread in the bloodstream)"@en ;
	dc:source	pwn30:14143818-n .

<i111244>	a	<Concept> ;
	skos:definition	"involving the lungs with progressive wasting of the body"@en ;
	dc:source	pwn30:14144064-n .

<i111245>	a	<Concept> ;
	skos:definition	"a form of tuberculosis characterized by swellings of the lymphatic glands"@en ;
	dc:source	pwn30:14144247-n .

<i111246>	a	<Concept> ;
	skos:definition	"serious infection marked by intestinal inflammation and ulceration; caused by Salmonella typhosa ingested with food or water"@en ;
	dc:source	pwn30:14144416-n .

<i111247>	a	<Concept> ;
	skos:definition	"a disease of the respiratory mucous membrane"@en ;
	dc:source	pwn30:14144626-n .

<i111248>	a	<Concept> ;
	skos:definition	"an infectious tropical disease resembling syphilis in its early stages; marked by red skin eruptions and ulcerating lesions"@en ;
	dc:source	pwn30:14144761-n .

<i111249>	a	<Concept> ;
	skos:definition	"caused by a flavivirus transmitted by a mosquito"@en ;
	dc:source	pwn30:14144960-n .

<i111250>	a	<Concept> ;
	skos:definition	"a disease affecting the respiratory system"@en ;
	dc:source	pwn30:14145095-n .

<i111251>	a	<Concept> ;
	skos:definition	"a mild viral infection involving the nose and respiratory passages (but not the lungs)"@en ;
	dc:source	pwn30:14145501-n .

<i111252>	a	<Concept> ;
	skos:definition	"a common cold affecting the nasal passages and resulting in congestion and sneezing and headache"@en ;
	dc:source	pwn30:14145759-n .

<i111253>	a	<Concept> ;
	skos:definition	"respiratory disorder characterized by wheezing; usually of allergic origin"@en ;
	dc:source	pwn30:14145911-n .

<i111254>	a	<Concept> ;
	skos:definition	"a prolonged and severe asthma attack that does not respond to standard treatment"@en ;
	dc:source	pwn30:14146128-n .

<i111255>	a	<Concept> ;
	skos:definition	"inflammation of the membranes lining the bronchial tubes"@en ;
	dc:source	pwn30:14146273-n .

<i111256>	a	<Concept> ;
	skos:definition	"inflammation of the membranes lining the bronchioles"@en ;
	dc:source	pwn30:14146459-n .

<i111257>	a	<Concept> ;
	skos:definition	"a form of bronchitis characterized by excess production of sputum leading to a chronic cough and obstruction of air flow"@en ;
	dc:source	pwn30:14146571-n .

<i111258>	a	<Concept> ;
	skos:definition	"a nonreversible lung disease that is a combination of emphysema and chronic bronchitis; usually patients have been heavy cigarette smokers"@en ;
	dc:source	pwn30:14146774-n .

<i111259>	a	<Concept> ;
	skos:definition	"an infection of the lungs and skin characterized by excessive sputum and nodules"@en ;
	dc:source	pwn30:14147014-n .

<i111260>	a	<Concept> ;
	skos:definition	"a fungal infection characterized by nodular lesions--first in the lungs and spreading to the nervous system"@en ;
	dc:source	pwn30:14147212-n .

<i111261>	a	<Concept> ;
	skos:definition	"an abnormal condition of the lungs marked by decreased respiratory function; associated with smoking or chronic bronchitis or old age"@en ;
	dc:source	pwn30:14147380-n .

<i111262>	a	<Concept> ;
	skos:definition	"respiratory disease characterized by inflammation of the lung parenchyma (excluding the bronchi) with congestion caused by viruses or bacteria or irritants"@en ;
	dc:source	pwn30:14147627-n .

<i111263>	a	<Concept> ;
	skos:definition	"an acute respiratory disease marked by high fever and coughing; caused by mycoplasma; primarily affecting children and young adults"@en ;
	dc:source	pwn30:14147964-n .

<i111264>	a	<Concept> ;
	skos:definition	"pneumonia characterized by acute inflammation of the walls of the bronchioles"@en ;
	dc:source	pwn30:14148231-n .

<i111265>	a	<Concept> ;
	skos:definition	"lobar pneumonia involving both lungs"@en ;
	dc:source	pwn30:14148411-n .

<i111266>	a	<Concept> ;
	skos:definition	"chronic lung disease affecting the interstitial tissue of the lungs"@en ;
	dc:source	pwn30:14148510-n .

<i111267>	a	<Concept> ;
	skos:definition	"pneumonia affecting one or more lobes of the lung; commonly due to streptococcal infection"@en ;
	dc:source	pwn30:14148646-n .

<i111268>	a	<Concept> ;
	skos:definition	"acute (sometimes fatal) lobar pneumonia caused by bacteria of a kind first recognized after an outbreak of the disease at an American Legion convention in Philadelphia in 1976; characterized by fever and muscle and chest pain and headache and chills and a dry cough"@en ;
	dc:source	pwn30:14148834-n .

<i111269>	a	<Concept> ;
	skos:definition	"pneumonia caused by bacteria of the genus pneumococcus"@en ;
	dc:source	pwn30:14149167-n .

<i111270>	a	<Concept> ;
	skos:definition	"pneumonia occurring in infants or in persons with impaired immune systems (as AIDS victims)"@en ;
	dc:source	pwn30:14149290-n .

<i111271>	a	<Concept> ;
	skos:definition	"abnormal presence of air in the pleural cavity resulting in the collapse of the lung; may be spontaneous (due to injury to the chest) or induced (as a treatment for tuberculosis)"@en ;
	dc:source	pwn30:14149536-n .

<i111272>	a	<Concept> ;
	skos:definition	"an atypical pneumonia caused by a rickettsia microorganism and transmitted to humans from infected birds"@en ;
	dc:source	pwn30:14149773-n .

<i111273>	a	<Concept> ;
	skos:definition	"chronic respiratory disease caused by inhaling metallic or mineral particles"@en ;
	dc:source	pwn30:14149963-n .

<i111274>	a	<Concept> ;
	skos:definition	"lung disease caused by inhaling coal dust"@en ;
	dc:source	pwn30:14150210-n .

<i111275>	a	<Concept> ;
	skos:definition	"lung disease caused by inhaling asbestos particles"@en ;
	dc:source	pwn30:14150363-n .

<i111276>	a	<Concept> ;
	skos:definition	"fibrosis of the lung caused by iron dust; occurs among welders and other metal workers"@en ;
	dc:source	pwn30:14150470-n .

<i111277>	a	<Concept> ;
	skos:definition	"a lung disease caused by inhaling particles of silica or quartz or slate"@en ;
	dc:source	pwn30:14150612-n .

<i111278>	a	<Concept> ;
	skos:definition	"an acute lung disease of the newborn (especially the premature newborn); lungs cannot expand because of a wetting agent is lacking; characterized by rapid shallow breathing and cyanosis and the formation of a glassy hyaline membrane over the alveoli"@en ;
	dc:source	pwn30:14150740-n .

<i111279>	a	<Concept> ;
	skos:definition	"a disease or disorder that is inherited genetically"@en ;
	dc:source	pwn30:14151139-n .

<i111280>	a	<Concept> ;
	skos:definition	"a rare inherited disorder of fat metabolism; characterized by severe deficiency of beta-lipoproteins and abnormal red blood cells (acanthocytes) and abnormally low cholesterol levels"@en ;
	dc:source	pwn30:14151884-n .

<i111281>	a	<Concept> ;
	skos:definition	"a congenital absence of eyelids (partial or complete)"@en ;
	dc:source	pwn30:14152169-n .

<i111282>	a	<Concept> ;
	skos:definition	"the congenital absence of pigmentation in the eyes and skin and hair"@en ;
	dc:source	pwn30:14152279-n .

<i111283>	a	<Concept> ;
	skos:definition	"an abnormally large braincase"@en ;
	dc:source	pwn30:14152492-n .

<i111284>	a	<Concept> ;
	skos:definition	"a defect in brain development resulting in small or missing brain hemispheres"@en ;
	dc:source	pwn30:14152617-n .

<i111285>	a	<Concept> ;
	skos:definition	"congenital absence of fingers and/or toes"@en ;
	dc:source	pwn30:14152803-n .

<i111286>	a	<Concept> ;
	skos:definition	"congenital absence of the uterus"@en ;
	dc:source	pwn30:14152924-n .

<i111287>	a	<Concept> ;
	skos:definition	"genetic inability to distinguish differences in hue"@en ;
	dc:source	pwn30:14153010-n .

<i111288>	a	<Concept> ;
	skos:definition	"visual impairment in which an object is seen as two objects"@en ;
	dc:source	pwn30:14153285-n .

<i111289>	a	<Concept> ;
	skos:definition	"a congenital abnormality in males in which the urethra is on the upper surface of the penis"@en ;
	dc:source	pwn30:14153468-n .

<i111290>	a	<Concept> ;
	skos:definition	"a deficiency of color vision in which the person can match any given hue by mixing only two other wavelengths of light (as opposed to the three wavelengths needed by people with normal color vision)"@en ;
	dc:source	pwn30:14153616-n .

<i111291>	a	<Concept> ;
	skos:definition	"confusion of red and green"@en ;
	dc:source	pwn30:14153982-n .

<i111292>	a	<Concept> ;
	skos:definition	"dichromacy characterized by a lowered sensitivity to green light resulting in an inability to distinguish green and purplish-red"@en ;
	dc:source	pwn30:14154168-n .

<i111293>	a	<Concept> ;
	skos:definition	"dichromacy characterized by lowered sensitivity to long wavelengths of light resulting in an inability to distinguish red and purplish blue"@en ;
	dc:source	pwn30:14154421-n .

<i111294>	a	<Concept> ;
	skos:definition	"confusion of yellow and blue"@en ;
	dc:source	pwn30:14154669-n .

<i111295>	a	<Concept> ;
	skos:definition	"a form of dichromacy characterized by lowered sensitivity to yellow light; so rare that its existence has been questioned"@en ;
	dc:source	pwn30:14154832-n .

<i111296>	a	<Concept> ;
	skos:definition	"rare form of dichromacy characterized by a lowered sensitivity to blue light resulting in an inability to distinguish blue and yellow"@en ;
	dc:source	pwn30:14155031-n .

<i111297>	a	<Concept> ;
	skos:definition	"complete color blindness; colors can be differentiated only on the basis of brightness"@en ;
	dc:source	pwn30:14155274-n .

<i111298>	a	<Concept> ;
	skos:definition	"the most common congenital disease; the child's lungs and intestines and pancreas become clogged with thick mucus; caused by defect in a single gene; no cure is known"@en ;
	dc:source	pwn30:14155506-n .

<i111299>	a	<Concept> ;
	skos:definition	"any of a number of diseases in which an inherited defect (usually a missing or inadequate enzyme) results in an abnormality of metabolism"@en ;
	dc:source	pwn30:14155834-n .

<i111300>	a	<Concept> ;
	skos:definition	"a genetic disease (autosomal recessive) in which an enzyme needed to metabolize galactose is deficient or absent; typically develops shortly after birth"@en ;
	dc:source	pwn30:14156134-n .

<i111301>	a	<Concept> ;
	skos:definition	"a rare chronic disorder of lipid metabolism of genetic origin"@en ;
	dc:source	pwn30:14156345-n .

<i111302>	a	<Concept> ;
	skos:definition	"congenital condition in which the colon does not have the normal network of nerves; there is little urge to defecate so the feces accumulate and cause megacolon"@en ;
	dc:source	pwn30:14156488-n .

<i111303>	a	<Concept> ;
	skos:definition	"a pattern of symptoms occurring as a result of damage to nerves in the cervical region of the spine (drooping eyelids and constricted pupils and absence of facial sweating)"@en ;
	dc:source	pwn30:14156740-n .

<i111304>	a	<Concept> ;
	skos:definition	"hereditary disease; develops in adulthood and ends in dementia"@en ;
	dc:source	pwn30:14156976-n .

<i111305>	a	<Concept> ;
	skos:definition	"hereditary disease (autosomal recessive) consisting of an error is mucopolysaccharide metabolism; characterized by severe abnormalities in development of skeletal cartilage and bone and mental retardation"@en ;
	dc:source	pwn30:14157163-n .

<i111306>	a	<Concept> ;
	skos:definition	"any of a group of genetic disorders involving a defect in the metabolism of mucopolysaccharides resulting in greater than normal levels of mucopolysaccharides in tissues"@en ;
	dc:source	pwn30:14157527-n .

<i111307>	a	<Concept> ;
	skos:definition	"hereditary condition in which certain anesthetics (e.g., halothane) cause high body temperatures and muscle rigidity"@en ;
	dc:source	pwn30:14157782-n .

<i111308>	a	<Concept> ;
	skos:definition	"an autosomal dominant disease characterized by elongated bones (especially of limbs and digits) and abnormalities of the eyes and circulatory system"@en ;
	dc:source	pwn30:14157967-n .

<i111309>	a	<Concept> ;
	skos:definition	"autosomal dominant disease characterized by numerous neurofibromas and by spots on the skin and often by developmental abnormalities"@en ;
	dc:source	pwn30:14158179-n .

<i111310>	a	<Concept> ;
	skos:definition	"autosomal dominant disorder of connective tissue characterized by brittle bones that fracture easily"@en ;
	dc:source	pwn30:14158424-n .

<i111311>	a	<Concept> ;
	skos:definition	"a genetic disorder characterized by high levels of beta-lipoproteins and cholesterol; can lead to atherosclerosis at an early age"@en ;
	dc:source	pwn30:14158594-n .

<i111312>	a	<Concept> ;
	skos:definition	"a hereditary disorder characterized by low levels of beta-lipoproteins and lipids and cholesterol"@en ;
	dc:source	pwn30:14158812-n .

<i111313>	a	<Concept> ;
	skos:definition	"any of several congenital diseases in which the skin is dry and scaly like a fish"@en ;
	dc:source	pwn30:14158997-n .

<i111314>	a	<Concept> ;
	skos:definition	"a congenital defect in which the top of the head is depressed (concave instead of convex)"@en ;
	dc:source	pwn30:14159153-n .

<i111315>	a	<Concept> ;
	skos:definition	"a congenital defect in which one or more toes or fingers are abnormally positioned"@en ;
	dc:source	pwn30:14159318-n .

<i111316>	a	<Concept> ;
	skos:definition	"a congenital disorder characterized by an abnormally large tongue; often seen in cases of Down's syndrome"@en ;
	dc:source	pwn30:14159459-n .

<i111317>	a	<Concept> ;
	skos:definition	"a congenital disorder caused by having an extra 21st chromosome; results in a flat face and short stature and mental retardation"@en ;
	dc:source	pwn30:14159623-n .

<i111318>	a	<Concept> ;
	skos:definition	"an inherited disorder of metabolism in which the urine has a odor characteristic of maple syrup; if untreated it can lead to mental retardation and death in early childhood"@en ;
	dc:source	pwn30:14159887-n .

<i111319>	a	<Concept> ;
	skos:definition	"an inherited disease in which abnormal amounts of glycogen accumulate in skeletal muscle; results in weakness and cramping"@en ;
	dc:source	pwn30:14160179-n .

<i111320>	a	<Concept> ;
	skos:definition	"any of several hereditary diseases of the muscular system characterized by weakness and wasting of skeletal muscles"@en ;
	dc:source	pwn30:14160365-n .

<i111321>	a	<Concept> ;
	skos:definition	"congenital condition in which some fingers or toes are missing"@en ;
	dc:source	pwn30:14160665-n .

<i111322>	a	<Concept> ;
	skos:definition	"congenital condition in which some of the teeth are missing"@en ;
	dc:source	pwn30:14160786-n .

<i111323>	a	<Concept> ;
	skos:definition	"hereditary disorder in which ossification of the labyrinth of the inner ear causes tinnitus and eventual deafness"@en ;
	dc:source	pwn30:14160903-n .

<i111324>	a	<Concept> ;
	skos:definition	"a form of muscular dystrophy that sets in in adolescence or adulthood and progresses slowly but will affect all voluntary muscles; characterized by generalized weakness and muscle wasting that affects limb and trunk muscles first; similar to Duchenne's muscular dystrophy but less severe; inheritance is X-linked recessive (carried by females but affecting only males)"@en ;
	dc:source	pwn30:14161075-n .

<i111325>	a	<Concept> ;
	skos:definition	"a form of muscular dystrophy that sets in between 40 and 60 years of age and is characterized by weakness and wasting of the muscles of the hands and forearms and lower legs; inheritance is autosomal dominant"@en ;
	dc:source	pwn30:14161515-n .

<i111326>	a	<Concept> ;
	skos:definition	"the most common form of muscular dystrophy; inheritance is X-linked recessive (carried by females but affecting only males)"@en ;
	dc:source	pwn30:14161795-n .

<i111327>	a	<Concept> ;
	skos:definition	"a disease caused by a dominant mutant gene on an autosome"@en ;
	dc:source	pwn30:14162025-n .

<i111328>	a	<Concept> ;
	skos:definition	"a disease caused by the presence of two recessive mutant genes on an autosome"@en ;
	dc:source	pwn30:14162275-n .

<i111329>	a	<Concept> ;
	skos:definition	"an autosomal recessive form of muscular dystrophy that appears anywhere from late childhood to middle age; characterized by progressive muscular weakness beginning either in the shoulder or pelvic girdle; usually progresses slowly with cardiopulmonary complications in the later stages"@en ;
	dc:source	pwn30:14162563-n .

<i111330>	a	<Concept> ;
	skos:definition	"an inborn error of metabolism in which the lack of certain enzymes leads to an inability to metabolize the amino acid lysine; characterized by muscular weakness and mental retardation"@en ;
	dc:source	pwn30:14162943-n .

<i111331>	a	<Concept> ;
	skos:definition	"a severe form of muscular dystrophy marked by generalized weakness and muscular wasting that affects the face and feet and hands and neck; difficult speech and difficulty with the hands that spreads to the arms and shoulders and legs and hips; the onset can be any time from birth to middle age and the progression is slow; inheritance is autosomal dominant"@en ;
	dc:source	pwn30:14163182-n .

<i111332>	a	<Concept> ;
	skos:definition	"a form of muscular dystrophy that usually begins between early adulthood and middle age and first affects muscles of the eyelid and throat; progresses slowly with swallowing problems common as the disease progresses; inheritance is autosomal dominant"@en ;
	dc:source	pwn30:14163676-n .

<i111333>	a	<Concept> ;
	skos:definition	"a disorder of lipid metabolism that is inherited as an autosomal recessive trait"@en ;
	dc:source	pwn30:14164007-n .

<i111334>	a	<Concept> ;
	skos:definition	"a congenital abnormality of the skull; the top of the skull assumes a cone shape"@en ;
	dc:source	pwn30:14164190-n .

<i111335>	a	<Concept> ;
	skos:definition	"anemia characterized by pancytopenia resulting from failure of the bone marrow; can be caused by neoplasm or by toxic exposure"@en ;
	dc:source	pwn30:14164341-n .

<i111336>	a	<Concept> ;
	skos:definition	"severe anemia in newborn babies; the result of Rh incompatibility between maternal and fetal blood; typically occurs when the child of an Rh-negative mother inherits Rh-positive blood from the father; can be diagnosed before birth by amniocentesis"@en ;
	dc:source	pwn30:14164548-n .

<i111337>	a	<Concept> ;
	skos:definition	"a rare congenital anemia characterized by pancytopenia and hypoplasia of the bone marrow"@en ;
	dc:source	pwn30:14164866-n .

<i111338>	a	<Concept> ;
	skos:definition	"anemia resulting from eating fava beans; victims have an inherited blood abnormality and enzyme deficiency"@en ;
	dc:source	pwn30:14165081-n .

<i111339>	a	<Concept> ;
	skos:definition	"anemia resulting from destruction of erythrocytes"@en ;
	dc:source	pwn30:14165240-n .

<i111340>	a	<Concept> ;
	skos:definition	"anemia characterized by an increase in the concentration of corpuscular hemoglobin"@en ;
	dc:source	pwn30:14165373-n .

<i111341>	a	<Concept> ;
	skos:definition	"anemia characterized by a decrease in the concentration of corpuscular hemoglobin"@en ;
	dc:source	pwn30:14165544-n .

<i111342>	a	<Concept> ;
	skos:definition	"anemia resulting from inadequately functioning bone marrow; can develop into aplastic anemia"@en ;
	dc:source	pwn30:14165730-n .

<i111343>	a	<Concept> ;
	skos:definition	"a form of anemia due to lack of iron in the diet or to iron loss as a result of chronic bleeding"@en ;
	dc:source	pwn30:14165909-n .

<i111344>	a	<Concept> ;
	skos:definition	"local anemia in a given body part sometimes resulting from vasoconstriction or thrombosis or embolism"@en ;
	dc:source	pwn30:14166118-n .

<i111345>	a	<Concept> ;
	skos:definition	"the most common kind of stroke; caused by an interruption in the flow of blood to the brain (as from a clot blocking a blood vessel)"@en ;
	dc:source	pwn30:14166358-n .

<i111346>	a	<Concept> ;
	skos:definition	"brief episode in which the brain gets insufficient blood supply; symptoms depend on the site of the blockage"@en ;
	dc:source	pwn30:14166589-n .

<i111347>	a	<Concept> ;
	skos:definition	"iron deficiency anemia in young women; characterized by weakness and menstrual disturbances and a green color to the skin"@en ;
	dc:source	pwn30:14166775-n .

<i111348>	a	<Concept> ;
	skos:definition	"anemia in which the average size of erythrocytes is larger than normal"@en ;
	dc:source	pwn30:14166968-n .

<i111349>	a	<Concept> ;
	skos:definition	"anemia in which the average size of erythrocytes is smaller than normal"@en ;
	dc:source	pwn30:14167123-n .

<i111350>	a	<Concept> ;
	skos:definition	"a condition in which parasites are present in the blood"@en ;
	dc:source	pwn30:14167298-n .

<i111351>	a	<Concept> ;
	skos:definition	"a chronic progressive anemia of older adults; thought to result from a lack of intrinsic factor (a substance secreted by the stomach that is responsible for the absorption of vitamin B12)"@en ;
	dc:source	pwn30:14167426-n .

<i111352>	a	<Concept> ;
	skos:definition	"anemia characterized by many large immature and dysfunctional red blood cells (megaloblasts) in the bone marrow; associated with pernicious anemia"@en ;
	dc:source	pwn30:14167773-n .

<i111353>	a	<Concept> ;
	skos:definition	"pernicious anemia in which the various formed elements in the blood are changed"@en ;
	dc:source	pwn30:14168010-n .

<i111354>	a	<Concept> ;
	skos:definition	"any of various anemic conditions that are not successfully treated by any means other than blood transfusions (and that are not associated with another primary disease)"@en ;
	dc:source	pwn30:14168176-n .

<i111355>	a	<Concept> ;
	skos:definition	"refractory anemia characterized by sideroblasts in the bone marrow"@en ;
	dc:source	pwn30:14168447-n .

<i111356>	a	<Concept> ;
	skos:definition	"a deficiency of iron; results from inadequate iron in the diet or from hemorrhage"@en ;
	dc:source	pwn30:14168653-n .

<i111357>	a	<Concept> ;
	skos:definition	"a congenital form of anemia occurring mostly in blacks; characterized by abnormal blood cells having a crescent shape"@en ;
	dc:source	pwn30:14168792-n .

<i111358>	a	<Concept> ;
	skos:definition	"a congenital progressive disorder of lipid metabolism having an onset at age 5 and characterized by blindness and dementia and early death"@en ;
	dc:source	pwn30:14169128-n .

<i111359>	a	<Concept> ;
	skos:definition	"a hereditary disorder of lipid metabolism occurring most frequently in individuals of Jewish descent in eastern Europe; accumulation of lipids in nervous tissue results in death in early childhood"@en ;
	dc:source	pwn30:14169364-n .

<i111360>	a	<Concept> ;
	skos:definition	"a rare autosomal recessive disease in which the platelets do not produce clots in the normal way and hemorrhage results"@en ;
	dc:source	pwn30:14169717-n .

<i111361>	a	<Concept> ;
	skos:definition	"autosomal recessive defect in tyrosine metabolism resulting in liver and kidney disturbances and mental retardation"@en ;
	dc:source	pwn30:14169897-n .

<i111362>	a	<Concept> ;
	skos:definition	"autosomal recessive disease in which the degeneration of spinal nerve cells and brain nerve cells leads to atrophy of skeletal muscles and flaccid paralysis; death usually occurs in early childhood"@en ;
	dc:source	pwn30:14170070-n .

<i111363>	a	<Concept> ;
	skos:definition	"congenital tendency to uncontrolled bleeding; usually affects males and is transmitted from mother to son"@en ;
	dc:source	pwn30:14170337-n .

<i111364>	a	<Concept> ;
	skos:definition	"the absence of fibrinogen in the plasma leading to prolonged bleeding"@en ;
	dc:source	pwn30:14170623-n .

<i111365>	a	<Concept> ;
	skos:definition	"hemophilia caused by a congenital deficiency of factor VIII; occurs almost exclusively in men"@en ;
	dc:source	pwn30:14170772-n .

<i111366>	a	<Concept> ;
	skos:definition	"a clotting disorder similar to hemophilia A but caused by a congenital deficiency of factor IX"@en ;
	dc:source	pwn30:14170987-n .

<i111367>	a	<Concept> ;
	skos:definition	"a form of hemophilia discovered by Erik von Willebrand; a genetic disorder that is inherited as an autosomal recessive trait; characterized by a deficiency of the coagulation factor and by mucosal bleeding"@en ;
	dc:source	pwn30:14171176-n .

<i111368>	a	<Concept> ;
	skos:definition	"a rare congenital disorder of blood coagulation in which no fibrinogen is found in the blood plasma"@en ;
	dc:source	pwn30:14171492-n .

<i111369>	a	<Concept> ;
	skos:definition	"a disease characterized by inflammation"@en ;
	dc:source	pwn30:14171682-n .

<i111370>	a	<Concept> ;
	skos:definition	"inflammation of the stomach and intestines; can be caused by Salmonella enteritidis"@en ;
	dc:source	pwn30:14172005-n .

<i111371>	a	<Concept> ;
	skos:definition	"often fatal form of gastroenteritis occurring in children; not true cholera but having similar symptoms"@en ;
	dc:source	pwn30:14172217-n .

<i111372>	a	<Concept> ;
	skos:definition	"severe gastroenteritis of unknown etiology; characterized by severe colic and vomiting and diarrhea"@en ;
	dc:source	pwn30:14172383-n .

<i111373>	a	<Concept> ;
	skos:definition	"inflammation of the female pelvic organs (especially the Fallopian tubes) caused by infection by any of several microorganisms (chiefly gonococci and chlamydia); symptoms are abdominal pain and fever and foul-smelling vaginal discharge"@en ;
	dc:source	pwn30:14172558-n .

<i111374>	a	<Concept> ;
	skos:definition	"a collection of pus in a body cavity (especially in the lung cavity)"@en ;
	dc:source	pwn30:14172873-n .

<i111375>	a	<Concept> ;
	skos:definition	"inflammation of the pleura of the lungs (especially the parietal layer)"@en ;
	dc:source	pwn30:14173013-n .

<i111376>	a	<Concept> ;
	skos:definition	"a collection of pus in the lung cavity"@en ;
	dc:source	pwn30:14173175-n .

<i111377>	a	<Concept> ;
	skos:definition	"pleurisy and pneumonia"@en ;
	dc:source	pwn30:14173295-n .

<i111378>	a	<Concept> ;
	skos:definition	"inflammation of the renal pelvis"@en ;
	dc:source	pwn30:14173397-n .

<i111379>	a	<Concept> ;
	skos:definition	"inflammation of the fauces and pharynx"@en ;
	dc:source	pwn30:14173484-n .

<i111380>	a	<Concept> ;
	skos:definition	"any disease of the throat or fauces marked by spasmodic attacks of intense suffocative pain"@en ;
	dc:source	pwn30:14173625-n .

<i111381>	a	<Concept> ;
	skos:definition	"a painful pus filled inflammation of the tonsils and surrounding tissues; usually a complication of tonsillitis"@en ;
	dc:source	pwn30:14173823-n .

<i111382>	a	<Concept> ;
	skos:definition	"a disease of infants and young children; harsh coughing and hoarseness and fever and difficult breathing"@en ;
	dc:source	pwn30:14174011-n .

<i111383>	a	<Concept> ;
	skos:definition	"abnormal downward or back placement of the tongue"@en ;
	dc:source	pwn30:14174208-n .

<i111384>	a	<Concept> ;
	skos:definition	"excessive movement; especially excessive motility of the gastrointestinal tract"@en ;
	dc:source	pwn30:14174316-n .

<i111385>	a	<Concept> ;
	skos:definition	"a slight illness"@en ;
	dc:source	pwn30:14174455-n .

<i111386>	a	<Concept> ;
	skos:definition	"the pathological state resulting from the invasion of the body by pathogenic microorganisms"@en ;
	dc:source	pwn30:14174549-n .

<i111387>	a	<Concept> ;
	skos:definition	"infection by a disease-causing ameba"@en ;
	dc:source	pwn30:14175165-n .

<i111388>	a	<Concept> ;
	skos:definition	"inflammation of the intestines caused by Endamoeba histolytica; usually acquired by ingesting food or water contaminated with feces; characterized by severe diarrhea"@en ;
	dc:source	pwn30:14175313-n .

<i111389>	a	<Concept> ;
	skos:definition	"a sexually transmitted infection caused by bacteria of the genus Chlamydia"@en ;
	dc:source	pwn30:14175579-n .

<i111390>	a	<Concept> ;
	skos:definition	"infestation with the liver fluke Fasciola hepatica; liver damage sometimes occurs; related to liver rot"@en ;
	dc:source	pwn30:14175727-n .

<i111391>	a	<Concept> ;
	skos:definition	"infestation with the large intestinal fluke Fasciolopsis buski; common in eastern Asia"@en ;
	dc:source	pwn30:14175903-n .

<i111392>	a	<Concept> ;
	skos:definition	"a painful and debilitating infestation contracted by drinking stagnant water contaminated with Guinea worm larvae that can mature inside a human's abdomen until the worm emerges through a painful blister in the person's skin"@en ;
	dc:source	pwn30:14176051-n .

<i111393>	a	<Concept> ;
	skos:definition	"an infestation with or a resulting infection caused by the pinworm Enterobius vermicularis; occurs especially in children"@en ;
	dc:source	pwn30:14176372-n .

<i111394>	a	<Concept> ;
	skos:definition	"a purulent infection at the end of a finger or toe in the area surrounding the nail"@en ;
	dc:source	pwn30:14176570-n .

<i111395>	a	<Concept> ;
	skos:definition	"bacterial infection limited to a specific organ or region especially one causing symptoms elsewhere"@en ;
	dc:source	pwn30:14176715-n .

<i111396>	a	<Concept> ;
	skos:definition	"an inflammatory condition caused by a fungus"@en ;
	dc:source	pwn30:14176895-n .

<i111397>	a	<Concept> ;
	skos:definition	"infection of the intestines with protozoa found in contaminated food and water; characterized by diarrhea and nausea and flatulence and abdominal discomfort"@en ;
	dc:source	pwn30:14177210-n .

<i111398>	a	<Concept> ;
	skos:definition	"a group of illnesses caused by a viral infection (usually restricted to a specific geographic area); fever and gastrointestinal symptoms are followed by capillary hemorrhage"@en ;
	dc:source	pwn30:14177423-n .

<i111399>	a	<Concept> ;
	skos:definition	"a viral infection (usually in children) marked by sore throat and fever and papules in the mouth and throat and headache and abdominal pain; usually subsides in a short time"@en ;
	dc:source	pwn30:14177848-n .

<i111400>	a	<Concept> ;
	skos:definition	"sores resulting from a tropical infection by protozoa of the genus Leishmania which are spread by sandflies"@en ;
	dc:source	pwn30:14178077-n .

<i111401>	a	<Concept> ;
	skos:definition	"an infection that is acquired at a hospital or other healthcare facility"@en ;
	dc:source	pwn30:14178326-n .

<i111402>	a	<Concept> ;
	skos:definition	"any infection caused by a microorganism that does not normally cause disease in humans; occurs in persons with abnormally functioning immune systems (as AIDS patients or transplant patients receiving immunosuppressive drugs)"@en ;
	dc:source	pwn30:14178482-n .

<i111403>	a	<Concept> ;
	skos:definition	"infection in the tissues adjacent to a nail on a finger or toe"@en ;
	dc:source	pwn30:14178794-n .

<i111404>	a	<Concept> ;
	skos:definition	"any infection caused by a protozoan"@en ;
	dc:source	pwn30:14178913-n .

<i111405>	a	<Concept> ;
	skos:definition	"any infection of the respiratory tract"@en ;
	dc:source	pwn30:14179104-n .

<i111406>	a	<Concept> ;
	skos:definition	"infection of the lower respiratory tract"@en ;
	dc:source	pwn30:14179276-n .

<i111407>	a	<Concept> ;
	skos:definition	"an infection common in Arab states caused by a bunyavirus; transmitted by a tick that thrives on sheep"@en ;
	dc:source	pwn30:14179390-n .

<i111408>	a	<Concept> ;
	skos:definition	"an infection common in Africa caused by a bunyavirus; transmitted by mosquitoes or by handling infected animals"@en ;
	dc:source	pwn30:14179569-n .

<i111409>	a	<Concept> ;
	skos:definition	"infection by the human immunodeficiency virus"@en ;
	dc:source	pwn30:14179744-n .

<i111410>	a	<Concept> ;
	skos:definition	"pneumonia caused by a virus"@en ;
	dc:source	pwn30:14179839-n .

<i111411>	a	<Concept> ;
	skos:definition	"a respiratory disease of unknown etiology that apparently originated in mainland China in 2003; characterized by fever and coughing or difficulty breathing or hypoxia; can be fatal"@en ;
	dc:source	pwn30:14179946-n .

<i111412>	a	<Concept> ;
	skos:definition	"infection of the upper respiratory tract"@en ;
	dc:source	pwn30:14180213-n .

<i111413>	a	<Concept> ;
	skos:definition	"a contagious skin infection caused by the itch mite; characterized by persistent itching and skin irritation"@en ;
	dc:source	pwn30:14180327-n .

<i111414>	a	<Concept> ;
	skos:definition	"an infestation with or a resulting infection caused by a parasite of the genus Schistosoma; common in the tropics and Far East; symptoms depend on the part of the body infected"@en ;
	dc:source	pwn30:14180565-n .

<i111415>	a	<Concept> ;
	skos:definition	"the presence of pus-forming bacteria or their toxins in the blood or tissues"@en ;
	dc:source	pwn30:14180848-n .

<i111416>	a	<Concept> ;
	skos:definition	"leishmaniasis of the viscera"@en ;
	dc:source	pwn30:14181049-n .

<i111417>	a	<Concept> ;
	skos:definition	"leishmaniasis of the skin; characterized by ulcerative skin lesions"@en ;
	dc:source	pwn30:14181187-n .

<i111418>	a	<Concept> ;
	skos:definition	"a form of leishmaniasis endemic in Mexico and Central American and South America; sores are limited to the skin and mucosa"@en ;
	dc:source	pwn30:14181409-n .

<i111419>	a	<Concept> ;
	skos:definition	"an infection caused by fungi of the genus Monilia or Candida (especially Candida albicans)"@en ;
	dc:source	pwn30:14181713-n .

<i111420>	a	<Concept> ;
	skos:definition	"fungal infection of the skin (especially of moist parts covered by clothing)"@en ;
	dc:source	pwn30:14181948-n .

<i111421>	a	<Concept> ;
	skos:definition	"a contagious fungal infection of the scalp; occurs mainly in Africa and the Middle East"@en ;
	dc:source	pwn30:14182103-n .

<i111422>	a	<Concept> ;
	skos:definition	"fungal infection of the cornea"@en ;
	dc:source	pwn30:14182242-n .

<i111423>	a	<Concept> ;
	skos:definition	"any fungal infection caused by fungi of the Phycomycetes group"@en ;
	dc:source	pwn30:14182332-n .

<i111424>	a	<Concept> ;
	skos:definition	"a chronic fungal infection of the skin and lymph nodes"@en ;
	dc:source	pwn30:14182453-n .

<i111425>	a	<Concept> ;
	skos:definition	"candidiasis of the oral cavity; seen mostly in infants or debilitated adults"@en ;
	dc:source	pwn30:14182568-n .

<i111426>	a	<Concept> ;
	skos:definition	"a central point or locus of an infection in an organism"@en ;
	dc:source	pwn30:14182697-n .

<i111427>	a	<Concept> ;
	skos:definition	"an opportunistic infection by a fungus of the genus Aspergillus; characterized by inflammation and lesions of the ear and other organs"@en ;
	dc:source	pwn30:14182871-n .

<i111428>	a	<Concept> ;
	skos:definition	"an open skin infection"@en ;
	dc:source	pwn30:14183065-n .

<i111429>	a	<Concept> ;
	skos:definition	"a painful sore with a hard core filled with pus"@en ;
	dc:source	pwn30:14183210-n .

<i111430>	a	<Concept> ;
	skos:definition	"a boil or abscess on the gums"@en ;
	dc:source	pwn30:14183337-n .

<i111431>	a	<Concept> ;
	skos:definition	"an inflammatory swelling or sore"@en ;
	dc:source	pwn30:14183420-n .

<i111432>	a	<Concept> ;
	skos:definition	"inflammation of the hands and feet caused by exposure to cold and moisture"@en ;
	dc:source	pwn30:14183522-n .

<i111433>	a	<Concept> ;
	skos:definition	"ulcerated chilblain on the heel"@en ;
	dc:source	pwn30:14183692-n .

<i111434>	a	<Concept> ;
	skos:definition	"an infection larger than a boil and with several openings for discharge of pus"@en ;
	dc:source	pwn30:14183774-n .

<i111435>	a	<Concept> ;
	skos:definition	"abnormal formation of cartilage from other tissues; observed in some Asians"@en ;
	dc:source	pwn30:14183926-n .

<i111436>	a	<Concept> ;
	skos:definition	"a small hard painless nodule at the site of entry of a pathogen (as syphilis)"@en ;
	dc:source	pwn30:14184067-n .

<i111437>	a	<Concept> ;
	skos:definition	"a sore that has become inflamed and formed pus"@en ;
	dc:source	pwn30:14184254-n .

<i111438>	a	<Concept> ;
	skos:definition	"a skin sore caused by chafing"@en ;
	dc:source	pwn30:14184390-n .

<i111439>	a	<Concept> ;
	skos:definition	"sore on a horseback rider chafed by a saddle"@en ;
	dc:source	pwn30:14184506-n .

<i111440>	a	<Concept> ;
	skos:definition	"an acute infection of the intestine by shigella bacteria; characterized by diarrhea and fever and abdominal pains"@en ;
	dc:source	pwn30:14184608-n .

<i111441>	a	<Concept> ;
	skos:definition	"an infection with staphylococcus bacteria; usually marked by abscess formation"@en ;
	dc:source	pwn30:14184801-n .

<i111442>	a	<Concept> ;
	skos:definition	"an infection of the oral pharynx and tonsils by streptococcus"@en ;
	dc:source	pwn30:14184986-n .

<i111443>	a	<Concept> ;
	skos:definition	"an infection of the sebaceous gland of the eyelid"@en ;
	dc:source	pwn30:14185219-n .

<i111444>	a	<Concept> ;
	skos:definition	"infection that occurs while you are being treated for another infection"@en ;
	dc:source	pwn30:14185353-n .

<i111445>	a	<Concept> ;
	skos:definition	"secondary infection caused by an opportunistic infection"@en ;
	dc:source	pwn30:14185503-n .

<i111446>	a	<Concept> ;
	skos:definition	"intestinal infection by a species of parasitic tapeworm; usually the result of eating inadequately cooked meat or fish"@en ;
	dc:source	pwn30:14185620-n .

<i111447>	a	<Concept> ;
	skos:definition	"an acute and serious infection of the central nervous system caused by bacterial infection of open wounds; spasms of the jaw and laryngeal muscles may occur during the late stages"@en ;
	dc:source	pwn30:14185803-n .

<i111448>	a	<Concept> ;
	skos:definition	"infection caused by parasites transmitted to humans from infected cats; if contracted by a pregnant woman it can result in serious damage to the fetus"@en ;
	dc:source	pwn30:14186046-n .

<i111449>	a	<Concept> ;
	skos:definition	"infection of the vagina"@en ;
	dc:source	pwn30:14186256-n .

<i111450>	a	<Concept> ;
	skos:definition	"infection by a virus that is pathogenic to humans"@en ;
	dc:source	pwn30:14186340-n .

<i111451>	a	<Concept> ;
	skos:definition	"inflammation of a joint or joints"@en ;
	dc:source	pwn30:14186541-n .

<i111452>	a	<Concept> ;
	skos:definition	"a chronic autoimmune disease with inflammation of the joints and marked deformities; something (possibly a virus) triggers an attack on the synovium by the immune system, which releases cytokines that stimulate an inflammatory reaction that can lead to the destruction of all components of the joint"@en ;
	dc:source	pwn30:14186738-n .

<i111453>	a	<Concept> ;
	skos:definition	"autoantibody that is usually present in the serum of people with rheumatoid arthritis"@en ;
	dc:source	pwn30:14187229-n .

<i111454>	a	<Concept> ;
	skos:definition	"any of a large group of diseases characterized by abnormal functioning of the immune system that causes your immune system to produce antibodies against your own tissues"@en ;
	dc:source	pwn30:14187378-n .

<i111455>	a	<Concept> ;
	skos:definition	"a form of rheumatoid arthritis usually affecting fingers and toes and associated with psoriasis"@en ;
	dc:source	pwn30:14187869-n .

<i111456>	a	<Concept> ;
	skos:definition	"a form of rheumatoid arthritis that affects children; large joints become inflamed and bone growth may be retarded"@en ;
	dc:source	pwn30:14188030-n .

<i111457>	a	<Concept> ;
	skos:definition	"chronic breakdown of cartilage in the joints; the most common form of arthritis occurring usually after middle age"@en ;
	dc:source	pwn30:14188238-n .

<i111458>	a	<Concept> ;
	skos:definition	"abnormal hardening or eburnation of bone"@en ;
	dc:source	pwn30:14188467-n .

<i111459>	a	<Concept> ;
	skos:definition	"swelling of the bursa in the knee (due to trauma or excessive kneeling)"@en ;
	dc:source	pwn30:14188568-n .

<i111460>	a	<Concept> ;
	skos:definition	"inflammation of the urinary bladder and ureters"@en ;
	dc:source	pwn30:14188702-n .

<i111461>	a	<Concept> ;
	skos:definition	"a painful inflammation of the big toe and foot caused by defects in uric acid metabolism resulting in deposits of the acid and its salts in the blood and joints"@en ;
	dc:source	pwn30:14188804-n .

<i111462>	a	<Concept> ;
	skos:definition	"arthritis that affects one or more of the intervertebral joints in the spine"@en ;
	dc:source	pwn30:14189065-n .

<i111463>	a	<Concept> ;
	skos:definition	"a disease or disorder of the blood"@en ;
	dc:source	pwn30:14189204-n .

<i111464>	a	<Concept> ;
	skos:definition	"invasion of the bloodstream by virulent microorganisms from a focus of infection"@en ;
	dc:source	pwn30:14189837-n .

<i111465>	a	<Concept> ;
	skos:definition	"blood poisoning caused by putrefactive bacteria; results from eating putrefied matter"@en ;
	dc:source	pwn30:14190132-n .

<i111466>	a	<Concept> ;
	skos:definition	"illness that can occur to persons exposed to ozone in high-altitude aircraft; characterized by sleepiness and headache and chest pains and itchiness"@en ;
	dc:source	pwn30:14190284-n .

<i111467>	a	<Concept> ;
	skos:definition	"serious form of septicemia contracted by a woman during childbirth or abortion (usually attributable to unsanitary conditions); formerly widespread but now uncommon"@en ;
	dc:source	pwn30:14190493-n .

<i111468>	a	<Concept> ;
	skos:definition	"septicemia caused by pus-forming bacteria being released from an abscess"@en ;
	dc:source	pwn30:14190736-n .

<i111469>	a	<Concept> ;
	skos:definition	"blood poisoning caused by bacterial toxic substances in the blood"@en ;
	dc:source	pwn30:14190907-n .

<i111470>	a	<Concept> ;
	skos:definition	"an abnormal condition of pregnancy characterized by hypertension and edema and protein in the urine"@en ;
	dc:source	pwn30:14191037-n .

<i111471>	a	<Concept> ;
	skos:definition	"a toxic condition characterized by convulsions and possibly coma during or immediately after pregnancy"@en ;
	dc:source	pwn30:14191284-n .

<i111472>	a	<Concept> ;
	skos:definition	"abnormal state of pregnancy characterized by hypertension and fluid retention and albuminuria; can lead to eclampsia if untreated"@en ;
	dc:source	pwn30:14191442-n .

<i111473>	a	<Concept> ;
	skos:definition	"a decrease in the number of eosinophils in the blood"@en ;
	dc:source	pwn30:14191646-n .

<i111474>	a	<Concept> ;
	skos:definition	"a blood disease characterized by the abnormal presence of erythroblasts in the blood"@en ;
	dc:source	pwn30:14191756-n .

<i111475>	a	<Concept> ;
	skos:definition	"presence of excessive hemoglobin in the blood plasma"@en ;
	dc:source	pwn30:14191903-n .

<i111476>	a	<Concept> ;
	skos:definition	"a blood disease characterized by the presence of abnormal hemoglobins in the blood"@en ;
	dc:source	pwn30:14192034-n .

<i111477>	a	<Concept> ;
	skos:definition	"coughing up blood from the respiratory tract; usually indicates a severe infection of the bronchi or lungs"@en ;
	dc:source	pwn30:14192199-n .

<i111478>	a	<Concept> ;
	skos:definition	"inflammatory histiocytosis associated with disturbance of cholesterol metabolism; occurs chiefly in young children and is characterized by cystic defects of the skull and diabetes insipidus"@en ;
	dc:source	pwn30:14192376-n .

<i111479>	a	<Concept> ;
	skos:definition	"the form of ratbite fever occurring in the United States"@en ;
	dc:source	pwn30:14192672-n .

<i111480>	a	<Concept> ;
	skos:definition	"a blood disease characterized by an abnormal multiplication of macrophages"@en ;
	dc:source	pwn30:14192790-n .

<i111481>	a	<Concept> ;
	skos:definition	"an abnormality during pregnancy; chorionic villi around the fetus degenerate and form clusters of fluid-filled sacs; usually associated with the death of the fetus"@en ;
	dc:source	pwn30:14192942-n .

<i111482>	a	<Concept> ;
	skos:definition	"an abnormality of pregnancy; accumulation of excess amniotic fluid"@en ;
	dc:source	pwn30:14193202-n .

<i111483>	a	<Concept> ;
	skos:definition	"hydrarthrosis affecting the knee"@en ;
	dc:source	pwn30:14193325-n .

<i111484>	a	<Concept> ;
	skos:definition	"blood disorder in which there is excess fluid volume compared with the cell volume of the blood"@en ;
	dc:source	pwn30:14193421-n .

<i111485>	a	<Concept> ;
	skos:definition	"disorder in which serous fluid accumulates in a body sac (especially in the scrotum)"@en ;
	dc:source	pwn30:14193571-n .

<i111486>	a	<Concept> ;
	skos:definition	"a disorder of lipid metabolism; abnormal levels of certain fats accumulate in the body"@en ;
	dc:source	pwn30:14193711-n .

<i111487>	a	<Concept> ;
	skos:definition	"presence of excess lipids in the blood"@en ;
	dc:source	pwn30:14193925-n .

<i111488>	a	<Concept> ;
	skos:definition	"a disorder in which a lack of certain enzymes makes it impossible to digest the amino acid lysine"@en ;
	dc:source	pwn30:14194183-n .

<i111489>	a	<Concept> ;
	skos:definition	"the condition of a host bacterium that has incorporated a phage into its own genetic material"@en ;
	dc:source	pwn30:14194345-n .

<i111490>	a	<Concept> ;
	skos:definition	"a low level of prothrombin (factor II) in the circulating blood; results in long clotting time and poor clot formation and sometimes excessive bleeding; can result from vitamin K deficiency"@en ;
	dc:source	pwn30:14194690-n .

<i111491>	a	<Concept> ;
	skos:definition	"a blood disorder consisting of an increase in the volume of circulating blood"@en ;
	dc:source	pwn30:14194942-n .

<i111492>	a	<Concept> ;
	skos:definition	"a blood disorder consisting of a decrease in the volume of circulating blood"@en ;
	dc:source	pwn30:14195112-n .

<i111493>	a	<Concept> ;
	skos:definition	"a deficiency of red blood cells"@en ;
	dc:source	pwn30:14195315-n .

<i111494>	a	<Concept> ;
	skos:definition	"an inherited form of anemia caused by faulty synthesis of hemoglobin"@en ;
	dc:source	pwn30:14195715-n .

<i111495>	a	<Concept> ;
	skos:definition	"a fatal form of homozygous thalassemia (inherited from both parents) in which there is no hemoglobin; skeletal deformations; heart and spleen and liver enlarged"@en ;
	dc:source	pwn30:14195939-n .

<i111496>	a	<Concept> ;
	skos:definition	"an abnormal increase in the number of white blood cells in the blood as a result of infection (as in leukemia)"@en ;
	dc:source	pwn30:14196221-n .

<i111497>	a	<Concept> ;
	skos:definition	"an abnormal lowering of the white blood cell count"@en ;
	dc:source	pwn30:14196405-n .

<i111498>	a	<Concept> ;
