	dc:source	pwn30:05558717-n .

<i66130>	a	<Concept> ;
	skos:definition	"the slender part of the back"@en ;
	dc:source	pwn30:05559023-n .

<i66131>	a	<Concept> ;
	skos:definition	"a broad flat muscle on either side of the back"@en ;
	dc:source	pwn30:05559122-n .

<i66132>	a	<Concept> ;
	skos:definition	"the fleshy part of the human body that you sit on"@en ;
	dc:source	pwn30:05559256-n .

<i66133>	a	<Concept> ;
