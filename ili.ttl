	dc:source	pwn30:14023901-n .

<i110633>	a	<Concept> ;
	skos:definition	"a state of heightened physiological activity"@en ;
	dc:source	pwn30:14023997-n .

<i110634>	a	<Concept> ;
	skos:definition	"an abnormal distension of an artery"@en ;
	dc:source	pwn30:14024185-n .

<i110635>	a	<Concept> ;
	skos:definition	"a pathology or abnormality of a joint"@en ;
	dc:source	pwn30:14024296-n .

<i110636>	a	<Concept> ;
	skos:definition	"absence of coordination of organs or body parts that usually work together harmoniously"@en ;
	dc:source	pwn30:14024391-n .

<i110637>	a	<Concept> ;
	skos:definition	"absence of systole; failure of the ventricles of the heart to contract (usually caused by ventricular fibrillation) with consequent absence of the heart beat leading to oxygen lack and eventually to death"@en ;
	dc:source	pwn30:14024581-n .

<i110638>	a	<Concept> ;
	skos:definition	"a natural and periodic state of rest during which consciousness of the world is suspended"@en ;
	dc:source	pwn30:14024882-n .

<i110639>	a	<Concept> ;
	skos:definition	"a disorder of sleep characterized by a dream of terrifying dimensions far worse than a typical nightmare; they occur during NREM sleep"@en ;
	dc:source	pwn30:14025258-n .

<i110640>	a	<Concept> ;
	skos:definition	"a recurring sleep state during which rapid eye movements do not occur and dreaming does not occur; accounts for about 75% of normal sleep time"@en ;
	dc:source	pwn30:14025478-n .

<i110641>	a	<Concept> ;
	skos:definition	"a recurring sleep state during which dreaming occurs; a state of rapidly shifting eye movements during sleep"@en ;
	dc:source	pwn30:14025755-n .

<i110642>	a	<Concept> ;
	skos:definition	"a torpid state resembling deep sleep"@en ;
