	dc:source	pwn30:05466244-n .

<i65679>	a	<Concept> ;
	skos:definition	"the flattened end of a motor neuron that transmits neural impulses to a muscle"@en ;
	dc:source	pwn30:05466393-n .

<i65680>	a	<Concept> ;
	skos:definition	"sensory end organ that responds to changes in osmotic pressure"@en ;
	dc:source	pwn30:05466575-n .

<i65681>	a	<Concept> ;
	skos:definition	"a neuron conducting impulses outwards from the brain or spinal cord"@en ;
	dc:source	pwn30:05466696-n .

<i65682>	a	<Concept> ;
	skos:definition	"a neuron conducting impulses inwards to the brain or spinal cord"@en ;
	dc:source	pwn30:05466892-n .

<i65683>	a	<Concept> ;
