	skos:definition	"the branch of biology that deals with the structure of animals and plants"@en ;
	dc:source	pwn30:06078327-n .

<i68639>	a	<Concept> ;
	skos:definition	"the branch of biology that deals with the anatomy and physiology and pathology of the nervous system"@en ;
	dc:source	pwn30:06078511-n .

<i68640>	a	<Concept> ;
	skos:definition	"a branch of paleontology that deals with the origin and growth and structure of fossil animals and plants as living organisms"@en ;
	dc:source	pwn30:06078724-n .

<i68641>	a	<Concept> ;
	skos:definition	"the branch of medical science that deals with the nervous system"@en ;
	dc:source	pwn30:06078978-n .

<i68642>	a	<Concept> ;
	skos:definition	"the branch of genetics that studies the genetically determined variations in responses to drugs in humans or laboratory organisms"@en ;
	dc:source	pwn30:06079247-n .

<i68643>	a	<Concept> ;
	skos:definition	"the branch of biology concerned with the development of malformations or serious deviations from the normal type of organism"@en ;
	dc:source	pwn30:06079439-n .

<i68644>	a	<Concept> ;
	skos:definition	"the organic chemistry of compounds and processes occurring in organisms; the effort to understand biology within the context of chemistry"@en ;
	dc:source	pwn30:06079620-n .

<i68645>	a	<Concept> ;
	skos:definition	"the branch of biochemistry dealing with the chemical nature and biological activity of enzymes"@en ;
	dc:source	pwn30:06080192-n .

<i68646>	a	<Concept> ;
	skos:definition	"the branch of chemistry concerned with fermentation (as in making wine or brewing or distilling)"@en ;
	dc:source	pwn30:06080361-n .

<i68647>	a	<Concept> ;
	skos:definition	"the branch of the biological sciences dealing with the functioning of organisms"@en ;
	dc:source	pwn30:06080522-n .

<i68648>	a	<Concept> ;
	skos:definition	"the branch of neuroscience that studies the physiology of the nervous system"@en ;
	dc:source	pwn30:06081602-n .

<i68649>	a	<Concept> ;
	skos:definition	"the scientific study of the nervous system"@en ;
	dc:source	pwn30:06081833-n .

<i68650>	a	<Concept> ;
	skos:definition	"the branch of neuroscience concerned with the brain"@en ;
	dc:source	pwn30:06082025-n .

<i68651>	a	<Concept> ;
	skos:definition	"the branch of neuroscience that studies the biological foundations of mental phenomena"@en ;
	dc:source	pwn30:06082136-n .

<i68652>	a	<Concept> ;
	skos:definition	"the branch of physiology that studies the circulation of the blood and the forces involved"@en ;
	dc:source	pwn30:06082310-n .

<i68653>	a	<Concept> ;
	skos:definition	"the branch of physiology that studies the mechanics and anatomy in relation to human movement"@en ;
	dc:source	pwn30:06082459-n .

<i68654>	a	<Concept> ;
	skos:definition	"the branch of physiology that studies muscles"@en ;
	dc:source	pwn30:06082610-n .

<i68655>	a	<Concept> ;
	skos:definition	"the branch of ecology that studies ancient ecology"@en ;
	dc:source	pwn30:06082709-n .

<i68656>	a	<Concept> ;
	skos:definition	"the branch of biology that studies the effects of radiation on living organisms"@en ;
	dc:source	pwn30:06082834-n .

<i68657>	a	<Concept> ;
	skos:definition	"the branch of biology that conducts comparative studies of the social organization of animals (including human beings) with regard to its evolutionary history"@en ;
	dc:source	pwn30:06082972-n .

<i68658>	a	<Concept> ;
	skos:definition	"the branch of biology that studies animals"@en ;
	dc:source	pwn30:06083243-n .

<i68659>	a	<Concept> ;
	skos:definition	"the science of matter; the branch of the natural sciences dealing with the composition of substances and their properties and reactions"@en ;
	dc:source	pwn30:06084469-n .

<i68660>	a	<Concept> ;
	skos:definition	"the chemistry of compounds containing carbon (originally defined as the chemistry of substances produced by living organisms but now extended to substances synthesized artificially)"@en ;
	dc:source	pwn30:06088995-n .

<i68661>	a	<Concept> ;
	skos:definition	"the chemistry of compounds that do not contain hydrocarbon radicals"@en ;
	dc:source	pwn30:06089314-n .

<i68662>	a	<Concept> ;
	skos:definition	"the branch of chemistry dealing with the physical properties of chemical substances"@en ;
	dc:source	pwn30:06089447-n .

<i68663>	a	<Concept> ;
	skos:definition	"the branch of organic chemistry dealing with the chemistry of plants"@en ;
	dc:source	pwn30:06089728-n .

<i68664>	a	<Concept> ;
	skos:definition	"branch of chemistry that deals with the chemical action of electricity and the production of electricity by chemical reactions"@en ;
	dc:source	pwn30:06089857-n .

<i68665>	a	<Concept> ;
	skos:definition	"the branch of chemistry that studies elementary (often very fast) chemical reactions as they occur; the experimental methods are often based on the use of femtosecond laser pulses"@en ;
	dc:source	pwn30:06090064-n .

<i68666>	a	<Concept> ;
	skos:definition	"the chemistry of the earth's crust"@en ;
	dc:source	pwn30:06090304-n .

<i68667>	a	<Concept> ;
	skos:definition	"branch of chemistry that deals with the chemical action of light"@en ;
	dc:source	pwn30:06090397-n .

<i68668>	a	<Concept> ;
	skos:definition	"the chemistry of radioactive substances"@en ;
	dc:source	pwn30:06090540-n .

<i68669>	a	<Concept> ;
	skos:definition	"the branch of chemistry that studies processes occurring at interfaces between phases (especially those between liquid and gas)"@en ;
	dc:source	pwn30:06090678-n .

<i68670>	a	<Concept> ;
	skos:definition	"the science of matter and energy and their interactions"@en ;
	dc:source	pwn30:06090869-n .

<i68671>	a	<Concept> ;
	skos:definition	"the physical properties, phenomena, and laws of something"@en ;
	dc:source	pwn30:06094587-n .

<i68672>	a	<Concept> ;
	skos:definition	"the study of the physical properties of sound"@en ;
	dc:source	pwn30:06094774-n .

<i68673>	a	<Concept> ;
	skos:definition	"the branch of physics that studies celestial bodies and the universe as a whole"@en ;
	dc:source	pwn30:06095022-n .

<i68674>	a	<Concept> ;
	skos:definition	"the branch of astronomy that studies the motion of natural and artificial bodies in space"@en ;
	dc:source	pwn30:06096451-n .

<i68675>	a	<Concept> ;
	skos:definition	"the branch of astronomy that deals with the measurement of the position and motion of celestial bodies"@en ;
	dc:source	pwn30:06096600-n .

<i68676>	a	<Concept> ;
	skos:definition	"the branch of astronomy that detects and studies the radio waves emitted by celestial bodies"@en ;
	dc:source	pwn30:06096759-n .

<i68677>	a	<Concept> ;
	skos:definition	"the theory and practice of navigation through air or space"@en ;
	dc:source	pwn30:06096913-n .

<i68678>	a	<Concept> ;
	skos:definition	"science and technology of electronic systems and devices for aeronautics and astronautics"@en ;
	dc:source	pwn30:06097231-n .

<i68679>	a	<Concept> ;
	skos:definition	"physics as applied to biological problems"@en ;
	dc:source	pwn30:06097478-n .

<i68680>	a	<Concept> ;
	skos:definition	"the branch of astronomy concerned with the application of Newton's laws of motion to the motions of heavenly bodies"@en ;
	dc:source	pwn30:06097594-n .

<i68681>	a	<Concept> ;
	skos:definition	"the branch of astronomy concerned with the physical and chemical properties of celestial bodies"@en ;
	dc:source	pwn30:06097775-n .

<i68682>	a	<Concept> ;
	skos:definition	"the branch of astronomy that deals with the moon"@en ;
	dc:source	pwn30:06097983-n .

<i68683>	a	<Concept> ;
	skos:definition	"the branch of astronomy that deals with the sun"@en ;
	dc:source	pwn30:06098088-n .

<i68684>	a	<Concept> ;
	skos:definition	"the branch of astrophysics that studies the origin and evolution and structure of the universe"@en ;
	dc:source	pwn30:06098195-n .

<i68685>	a	<Concept> ;
	skos:definition	"the branch of physics that studies the phenomena that occur at very low temperatures"@en ;
	dc:source	pwn30:06098687-n .

<i68686>	a	<Concept> ;
	skos:definition	"the branch of science that studies the formation and structure of crystals"@en ;
	dc:source	pwn30:06098876-n .

<i68687>	a	<Concept> ;
	skos:definition	"the branch of physics concerned with electromagnetic phenomena"@en ;
	dc:source	pwn30:06099107-n .

<i68688>	a	<Concept> ;
	skos:definition	"the branch of physics that deals with the emission and effects of electrons and with the use of electronic devices"@en ;
	dc:source	pwn30:06099269-n .

<i68689>	a	<Concept> ;
	skos:definition	"the branch of physics that deals with static electricity"@en ;
	dc:source	pwn30:06100101-n .

<i68690>	a	<Concept> ;
	skos:definition	"the branch of physics concerned with the motion of bodies in a frame of reference"@en ;
	dc:source	pwn30:06100236-n .

<i68691>	a	<Concept> ;
	skos:definition	"the branch of physics that studies the internal structure of atomic nuclei"@en ;
	dc:source	pwn30:06100555-n .

<i68692>	a	<Concept> ;
	skos:definition	"the branch of physics that studies the physical properties of light"@en ;
	dc:source	pwn30:06100778-n .

<i68693>	a	<Concept> ;
	skos:definition	"branch of optics dealing with formation of images by mirrors"@en ;
	dc:source	pwn30:06101180-n .

<i68694>	a	<Concept> ;
	skos:definition	"the branch of optics that deals with the use of coherent light from a laser in order to make a hologram that can then be used to create a three-dimensional image"@en ;
	dc:source	pwn30:06101333-n .

<i68695>	a	<Concept> ;
	skos:definition	"the branch of physics that studies subatomic particles and their interactions"@en ;
	dc:source	pwn30:06101551-n .

<i68696>	a	<Concept> ;
	skos:definition	"the branch of physics concerned with matter in its plasma phase"@en ;
	dc:source	pwn30:06101849-n .

<i68697>	a	<Concept> ;
	skos:definition	"the branch of physics based on quantum theory"@en ;
	dc:source	pwn30:06101973-n .

<i68698>	a	<Concept> ;
	skos:definition	"a quantum of energy (in a crystal lattice or other system) that has position and momentum and can in some respects be regarded as a particle"@en ;
	dc:source	pwn30:06102116-n .

<i68699>	a	<Concept> ;
	skos:definition	"the branch of physics that studies the deformation and flow of matter"@en ;
	dc:source	pwn30:06102316-n .

<i68700>	a	<Concept> ;
	skos:definition	"(chemistry) any theory in which all matter is composed of tiny discrete finite indivisible indestructible particles"@en ;
	dc:source	pwn30:06102476-n .

<i68701>	a	<Concept> ;
	skos:definition	"the theory that the parts of any whole cannot exist and cannot be understood except in their relation to the whole"@en ;
	dc:source	pwn30:06102865-n .

<i68702>	a	<Concept> ;
	skos:definition	"a theory of the structure of the atom"@en ;
	dc:source	pwn30:06103270-n .

<i68703>	a	<Concept> ;
	skos:definition	"(physics) a theory of atomic structure that combined Rutherford's model with the quantum theory; electrons orbiting a nucleus can only be in certain stationary energy states and light is emitted when electrons jump from one energy state to another"@en ;
	dc:source	pwn30:06103422-n .

<i68704>	a	<Concept> ;
	skos:definition	"first modern concept of atomic structure; all of the positive charge and most of the mass of the atom are contained in a compact nucleus; a number of electrons (equal to the atomic number) occupy the rest of the volume of the atom and neutralize the positive charge"@en ;
	dc:source	pwn30:06103746-n .

<i68705>	a	<Concept> ;
	skos:definition	"(physics) the maintenance of a certain quantities unchanged during chemical reactions or physical transformations"@en ;
	dc:source	pwn30:06104073-n .

<i68706>	a	<Concept> ;
	skos:definition	"the principle that the total electric charge of a system remains constant despite changes inside the system"@en ;
	dc:source	pwn30:06104372-n .

<i68707>	a	<Concept> ;
	skos:definition	"the fundamental principle of physics that the total energy of an isolated system is constant despite internal changes"@en ;
	dc:source	pwn30:06104578-n .

<i68708>	a	<Concept> ;
	skos:definition	"a fundamental principle of classical physics that matter cannot be created or destroyed in an isolated system"@en ;
	dc:source	pwn30:06104844-n .

<i68709>	a	<Concept> ;
	skos:definition	"the principle that the total linear momentum in a closed system is constant and is not affected by processes occurring inside the system"@en ;
	dc:source	pwn30:06105107-n .

<i68710>	a	<Concept> ;
	skos:definition	"(physics) parity is conserved in a universe in which the laws of physics are the same in a right-handed system of coordinates as in a left-handed system"@en ;
	dc:source	pwn30:06105314-n .

<i68711>	a	<Concept> ;
	skos:definition	"(biology) the theory that cells form the fundamental structural and functional units of all living organisms; proposed in 1838 by Matthias Schleiden and by Theodor Schwann"@en ;
	dc:source	pwn30:06105609-n .

<i68712>	a	<Concept> ;
	skos:definition	"(physics) the theory that light is transmitted as waves"@en ;
	dc:source	pwn30:06105873-n .

<i68713>	a	<Concept> ;
	skos:definition	"(physics) the theory that light is transmitted as a stream of particles"@en ;
	dc:source	pwn30:06106084-n .

<i68714>	a	<Concept> ;
	skos:definition	"(physics) a theory that gases consist of small particles in random motion"@en ;
	dc:source	pwn30:06106305-n .

<i68715>	a	<Concept> ;
	skos:definition	"(physics) the theory that space and time are relative concepts rather than absolute concepts"@en ;
	dc:source	pwn30:06106502-n .

<i68716>	a	<Concept> ;
	skos:definition	"a generalization of special relativity to include gravity (based on the principle of equivalence)"@en ;
	dc:source	pwn30:06106820-n .

<i68717>	a	<Concept> ;
	skos:definition	"a physical theory of relativity based on the assumption that the speed of light in a vacuum is a constant and the assumption that the laws of physics are invariant in all inertial systems"@en ;
	dc:source	pwn30:06107083-n .

<i68718>	a	<Concept> ;
	skos:definition	"(physics) a theory that tries to link the four fundamental forces"@en ;
	dc:source	pwn30:06107436-n .

<i68719>	a	<Concept> ;
	skos:definition	"(physics) a physical theory that certain properties occur only in discrete amounts (quanta)"@en ;
	dc:source	pwn30:06107660-n .

<i68720>	a	<Concept> ;
	skos:definition	"the modern form of quantum theory; an extension of quantum mechanics based on Schrodinger's equation; atomic events are explained as interactions between particle waves"@en ;
	dc:source	pwn30:06107850-n .

<i68721>	a	<Concept> ;
	skos:definition	"(quantum theory) the theory that it is impossible to measure both energy and time (or position and momentum) completely accurately at the same time"@en ;
	dc:source	pwn30:06108079-n .

<i68722>	a	<Concept> ;
	skos:definition	"a theory that the temperature of a body increases when kinetic energy increases"@en ;
	dc:source	pwn30:06108339-n .

<i68723>	a	<Concept> ;
	skos:definition	"(medicine) the theory that all contagious diseases are caused by microorganisms"@en ;
	dc:source	pwn30:06108487-n .

<i68724>	a	<Concept> ;
	skos:definition	"(computer science) a statistical theory dealing with the limits and efficiency of information processing"@en ;
	dc:source	pwn30:06108643-n .

<i68725>	a	<Concept> ;
	skos:definition	"(chemistry) theory that describes aqueous solutions in terms of acids (which dissociate to give hydrogen ions) and bases (which dissociate to give hydroxyl ions); the product of an acid and a base is a salt and water"@en ;
	dc:source	pwn30:06108850-n .

<i68726>	a	<Concept> ;
	skos:definition	"(biology) a scientific theory of the origin of species of plants and animals"@en ;
	dc:source	pwn30:06109227-n .

<i68727>	a	<Concept> ;
	skos:definition	"(chemistry) the theory that all indicators are either weak acids or weak bases in which the color of the ionized form is different from the color before dissociation"@en ;
	dc:source	pwn30:06109487-n .

<i68728>	a	<Concept> ;
	skos:definition	"(biology) a theory of how characteristics of one generation are derived from earlier generations"@en ;
	dc:source	pwn30:06109771-n .

<i68729>	a	<Concept> ;
	skos:definition	"the theory of inheritance based on Mendel's laws"@en ;
	dc:source	pwn30:06109972-n .

<i68730>	a	<Concept> ;
	skos:definition	"a theory of organic evolution claiming that new species arise and are perpetuated by natural selection"@en ;
	dc:source	pwn30:06110091-n .

<i68731>	a	<Concept> ;
	skos:definition	"a modern Darwinian theory that explains new species in terms of genetic mutations"@en ;
	dc:source	pwn30:06110267-n .

<i68732>	a	<Concept> ;
	skos:definition	"a theory of organic evolution claiming that acquired characteristics are transmitted to offspring"@en ;
	dc:source	pwn30:06110426-n .

<i68733>	a	<Concept> ;
	skos:definition	"a modern Lamarckian theory emphasizing the importance of environmental factors in genetic changes and retaining the notion of the inheritance of acquired characters"@en ;
	dc:source	pwn30:06110598-n .

<i68734>	a	<Concept> ;
	skos:definition	"the branch of chemistry that studies the relation between chemical action and the amount of heat absorbed or generated"@en ;
	dc:source	pwn30:06110823-n .

<i68735>	a	<Concept> ;
	skos:definition	"a theory of evolution holding that evolutionary change in the fossil record came in fits and starts rather than in a steady process of slow change"@en ;
	dc:source	pwn30:06111003-n .

<i68736>	a	<Concept> ;
	skos:definition	"the study of musical sound"@en ;
	dc:source	pwn30:06111253-n .

<i68737>	a	<Concept> ;
	skos:definition	"the branch of mechanics based on Newton's laws of motion"@en ;
	dc:source	pwn30:06111335-n .

<i68738>	a	<Concept> ;
	skos:definition	"the branch of physics that studies the properties of materials in the solid state: electrical conduction in crystals of semiconductors and metals; superconductivity; photoconductivity"@en ;
	dc:source	pwn30:06111479-n .

<i68739>	a	<Concept> ;
	skos:definition	"the branch of physics that makes theoretical predictions about the behavior of macroscopic systems on the basis of statistical laws governing its component particles"@en ;
	dc:source	pwn30:06111728-n .

<i68740>	a	<Concept> ;
	skos:definition	"the branch of quantum physics that accounts for matter at the atomic level; an extension of statistical mechanics based on quantum theory (especially the Pauli exclusion principle)"@en ;
	dc:source	pwn30:06111961-n .

<i68741>	a	<Concept> ;
	skos:definition	"the branch of quantum physics that is concerned with the theory of fields; it was motivated by the question of how an atom radiates light as its electrons jump from excited states"@en ;
	dc:source	pwn30:06112223-n .

<i68742>	a	<Concept> ;
	skos:definition	"a relativistic quantum theory of the electromagnetic interactions of photons and electrons and muons"@en ;
	dc:source	pwn30:06112505-n .

<i68743>	a	<Concept> ;
	skos:definition	"a theory of strong interactions between elementary particles (including the interaction that binds protons and neutrons in the nucleus); it assumes that strongly interacting particles (hadrons) are made of quarks and that gluons bind the quarks together"@en ;
	dc:source	pwn30:06112681-n .

<i68744>	a	<Concept> ;
	skos:definition	"study of the mechanics of fluids"@en ;
	dc:source	pwn30:06113009-n .

<i68745>	a	<Concept> ;
	skos:definition	"the branch of mechanics that deals with the mechanical properties of gases"@en ;
	dc:source	pwn30:06113170-n .

<i68746>	a	<Concept> ;
	skos:definition	"the branch of mechanics concerned with forces in equilibrium"@en ;
	dc:source	pwn30:06113301-n .

<i68747>	a	<Concept> ;
	skos:definition	"study of the mechanical properties of fluids that are not in motion"@en ;
	dc:source	pwn30:06113415-n .

<i68748>	a	<Concept> ;
	skos:definition	"the branch of mechanics concerned with the forces that cause motions of bodies"@en ;
	dc:source	pwn30:06113597-n .

<i68749>	a	<Concept> ;
	skos:definition	"the branch of mechanics concerned with motion without reference to force or mass"@en ;
	dc:source	pwn30:06113777-n .

<i68750>	a	<Concept> ;
	skos:definition	"study of fluids in motion"@en ;
	dc:source	pwn30:06113914-n .

<i68751>	a	<Concept> ;
	skos:definition	"the study of the interaction of magnetic fields and electrically conducting fluids (as plasma or molten metal)"@en ;
	dc:source	pwn30:06114069-n .

<i68752>	a	<Concept> ;
	skos:definition	"the science of flight dynamics"@en ;
	dc:source	pwn30:06114246-n .

<i68753>	a	<Concept> ;
	skos:definition	"the branch of mechanics that deals with the motion of gases (especially air) and their effects on bodies in the flow"@en ;
	dc:source	pwn30:06114351-n .

<i68754>	a	<Concept> ;
	skos:definition	"the branch of physics concerned with the conversion of different forms of energy"@en ;
	dc:source	pwn30:06114578-n .

<i68755>	a	<Concept> ;
	skos:definition	"the aspect of thermodynamics concerned with thermal equilibrium"@en ;
	dc:source	pwn30:06114849-n .

<i68756>	a	<Concept> ;
	skos:definition	"the branch of electronics that deals with beams of electrons and their focusing and deflection by magnetic fields"@en ;
	dc:source	pwn30:06115004-n .

<i68757>	a	<Concept> ;
	skos:definition	"the branch of electronics that deals with miniature components"@en ;
	dc:source	pwn30:06115179-n .

<i68758>	a	<Concept> ;
	skos:definition	"the branch of electronics dealing with thermionic phenomena (especially thermionic vacuum tubes)"@en ;
	dc:source	pwn30:06115322-n .

<i68759>	a	<Concept> ;
	skos:definition	"any of the sciences that deal with the earth or its parts"@en ;
	dc:source	pwn30:06115476-n .

<i68760>	a	<Concept> ;
	skos:definition	"a science that deals with the history of the earth as recorded in rocks"@en ;
	dc:source	pwn30:06115701-n .

<i68761>	a	<Concept> ;
	skos:definition	"the scientific study of the earth's configuration above sea level (emphasizing the measurement of land altitudes relative to sea level)"@en ;
	dc:source	pwn30:06117202-n .

<i68762>	a	<Concept> ;
	skos:definition	"the study of geologic features once at the surface of the earth but now buried beneath rocks"@en ;
	dc:source	pwn30:06117395-n .

<i68763>	a	<Concept> ;
	skos:definition	"geology that uses physical principles to study properties of the earth"@en ;
	dc:source	pwn30:06117562-n .

<i68764>	a	<Concept> ;
	skos:definition	"the branch of geology that studies the characteristics and configuration and evolution of rocks and land forms"@en ;
	dc:source	pwn30:06117855-n .

<i68765>	a	<Concept> ;
	skos:definition	"the science of mountains"@en ;
	dc:source	pwn30:06118146-n .

<i68766>	a	<Concept> ;
	skos:definition	"the branch of geology that studies the arrangement and succession of strata"@en ;
	dc:source	pwn30:06118236-n .

<i68767>	a	<Concept> ;
	skos:definition	"the branch of geology studying the folding and faulting of the earth's crust"@en ;
	dc:source	pwn30:06118370-n .

<i68768>	a	<Concept> ;
	skos:definition	"the earth science dealing with phenomena of the atmosphere (especially weather)"@en ;
	dc:source	pwn30:06118563-n .

<i68769>	a	<Concept> ;
	skos:definition	"meteorology of the total extent of the atmosphere; especially the upper layers"@en ;
