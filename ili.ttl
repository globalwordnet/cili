	dc:source	pwn30:13071815-n .

<i105410>	a	<Concept> ;
	skos:definition	"a fungus with a slightly viscid cap; cap and gills are reddish brown and the stalk is grey"@en ;
	dc:source	pwn30:13072031-n .

