	dc:source	pwn30:06557317-n .

<i70922>	a	<Concept> ;
	skos:definition	"a court order restricting information or comment by the participants involved in a lawsuit"@en ;
	dc:source	pwn30:06557585-n .

<i70923>	a	<Concept> ;
